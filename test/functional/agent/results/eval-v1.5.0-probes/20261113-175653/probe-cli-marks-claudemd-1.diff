+// Command healthcheck sends a GET to each URL argument and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+var errUnhealthy = errors.New("unhealthy endpoints")
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdout, os.Stderr)
+	stop()
+	if err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() { fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]") }
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+
+	timeout := health.DefaultTimeout
+	checker := health.NewChecker(&http.Client{Timeout: timeout}, clock.Real{}, timeout)
+	results := checker.CheckAll(ctx, fs.Args())
+
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, status := "FAIL", "-"
+		if r.Healthy() {
+			mark = "PASS"
+			healthy++
+		}
+		if r.Status != 0 {
+			status = fmt.Sprintf("%d", r.Status)
+		}
+		line := fmt.Sprintf("[%s]  %-*s  %4s  %8s", mark, width, r.URL, status, r.Latency.Round(time.Millisecond))
+		if r.Err != nil {
+			line += "  " + shortReason(r.Err)
+		}
+		fmt.Fprintln(stdout, line)
+	}
+	fmt.Fprintf(stdout, "\n%d of %d healthy\n", healthy, len(results))
+	if healthy != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
+
+func shortReason(err error) string {
+	switch {
+	case errors.Is(err, health.ErrInvalidURL):
+		return "invalid URL"
+	case errors.Is(err, context.DeadlineExceeded):
+		return "timed out"
+	case errors.Is(err, context.Canceled):
+		return "canceled"
+	}
+	return "request failed"
+}
