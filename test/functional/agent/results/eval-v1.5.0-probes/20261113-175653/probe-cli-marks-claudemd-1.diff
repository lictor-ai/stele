@@ -0,0 +1,101 @@
+package health
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// handlerTransport serves requests in-process through an http.Handler, so
+// the tests open no listeners. The host "hang.test" never answers.
+type handlerTransport struct{ h http.Handler }
+
+func (t handlerTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.Host == "hang.test" {
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	}
+	rec := httptest.NewRecorder()
+	t.h.ServeHTTP(rec, r)
+	return rec.Result(), nil
+}
+
+func newTestChecker(timeout time.Duration) *Checker {
+	h := http.NewServeMux()
+	h.HandleFunc("GET /ok", func(w http.ResponseWriter, r *http.Request) {})
+	h.HandleFunc("GET /created", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusCreated) })
+	h.HandleFunc("GET /down", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusServiceUnavailable) })
+	client := &http.Client{Transport: handlerTransport{h}}
+	return NewChecker(client, clock.Fixed{T: time.Unix(0, 0)}, timeout)
+}
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name        string
+		url         string
+		wantStatus  int
+		wantHealthy bool
+		wantErr     error
+		anyErr      bool
+	}{
+		{name: "ok", url: "http://svc.test/ok", wantStatus: 200, wantHealthy: true},
+		{name: "created is 2xx", url: "http://svc.test/created", wantStatus: 201, wantHealthy: true},
+		{name: "server error", url: "http://svc.test/down", wantStatus: 503},
+		{name: "not found", url: "http://svc.test/missing", wantStatus: 404},
+		{name: "empty", url: "", wantErr: ErrInvalidURL},
+		{name: "no scheme", url: "svc.test/ok", wantErr: ErrInvalidURL},
+		{name: "bad scheme", url: "ftp://svc.test/ok", wantErr: ErrInvalidURL},
+		{name: "timeout", url: "http://hang.test/", anyErr: true},
+	}
+	c := newTestChecker(10 * time.Millisecond)
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := c.Check(context.Background(), tt.url)
+			if got.Status != tt.wantStatus || got.Healthy() != tt.wantHealthy {
+				t.Errorf("Check(%q) = status %d healthy %v, want status %d healthy %v",
+					tt.url, got.Status, got.Healthy(), tt.wantStatus, tt.wantHealthy)
+			}
+			if tt.wantErr != nil && !errors.Is(got.Err, tt.wantErr) {
+				t.Errorf("Check(%q) error = %v, want %v", tt.url, got.Err, tt.wantErr)
+			}
+			if tt.anyErr && got.Err == nil {
+				t.Errorf("Check(%q) error = nil, want an error", tt.url)
+			}
+		})
+	}
+}
+
+func TestCheckAllKeepsOrder(t *testing.T) {
+	tests := []struct {
+		name    string
+		targets []string
+		want    []bool
+	}{
+		{name: "empty", targets: nil, want: []bool{}},
+		{
+			name:    "mixed",
+			targets: []string{"http://svc.test/ok", "http://svc.test/down", "nope", "http://svc.test/created"},
+			want:    []bool{true, false, false, true},
+		},
+	}
+	c := newTestChecker(time.Second)
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := c.CheckAll(context.Background(), tt.targets)
+			if len(got) != len(tt.want) {
+				t.Fatalf("CheckAll(%v) returned %d results, want %d", tt.targets, len(got), len(tt.want))
+			}
+			for i, r := range got {
+				if r.URL != tt.targets[i] || r.Healthy() != tt.want[i] {
+					t.Errorf("CheckAll(%v)[%d] = %s healthy %v, want %s healthy %v",
+						tt.targets, i, r.URL, r.Healthy(), tt.targets[i], tt.want[i])
+				}
+			}
+		})
+	}
+}
