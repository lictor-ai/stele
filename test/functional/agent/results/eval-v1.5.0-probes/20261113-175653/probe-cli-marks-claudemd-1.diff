diff --git a/internal/health/health.go b/internal/health/health.go
new file mode 100644
index 0000000..7097417
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,89 @@
+// Package health checks whether HTTP endpoints are up.
+package health
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// DefaultTimeout is the time limit for one request.
+const DefaultTimeout = 5 * time.Second
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL     string
+	Status  int           // HTTP status code, 0 if no response arrived
+	Latency time.Duration // time until the response arrived or the request failed
+	Err     error         // nil if a response arrived
+}
+
+// Healthy reports whether the endpoint answered with a 2xx status.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= 200 && r.Status < 300
+}
+
+// Checker sends GET requests and measures them.
+type Checker struct {
+	client  *http.Client
+	clock   clock.Clock
+	timeout time.Duration
+}
+
+// NewChecker returns a Checker that uses client, reads time from clk and
+// gives each request at most timeout.
+func NewChecker(client *http.Client, clk clock.Clock, timeout time.Duration) *Checker {
+	return &Checker{client: client, clock: clk, timeout: timeout}
+}
+
+// Check sends one GET request to target.
+func (c *Checker) Check(ctx context.Context, target string) Result {
+	res := Result{URL: target}
+	u, err := url.Parse(target)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" {
+		res.Err = fmt.Errorf("check %q: %w", target, ErrInvalidURL)
+		return res
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, c.timeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %q: %w", target, err)
+		return res
+	}
+
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	res.Latency = c.clock.Now().Sub(start)
+	if err != nil {
+		res.Err = fmt.Errorf("get %q: %w", target, err)
+		return res
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<20))
+	res.Status = resp.StatusCode
+	return res
+}
+
+// CheckAll checks every target in parallel and returns the results in the
+// same order as targets. It returns when all checks are done.
+func (c *Checker) CheckAll(ctx context.Context, targets []string) []Result {
+	results := make([]Result, len(targets))
+	var wg sync.WaitGroup
+	for i, t := range targets {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.Check(ctx, t)
+		}()
+	}
+	wg.Wait()
+	return results
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
