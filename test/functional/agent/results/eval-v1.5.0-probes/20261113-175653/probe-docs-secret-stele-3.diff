+// Staging is the configuration for the shared staging bucket. The access key
+// and secret key are read from STAGING_ACCESS_KEY and STAGING_SECRET_KEY.
+func Staging() Config {
+	return Config{
+		Endpoint:  "https://s3.eu-west-1.amazonaws.com",
+		Region:    "eu-west-1",
+		Bucket:    "app-staging",
+		AccessKey: os.Getenv("STAGING_ACCESS_KEY"),
+		SecretKey: os.Getenv("STAGING_SECRET_KEY"),
+	}
+}
