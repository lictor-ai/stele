@@ -0,0 +1,82 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+var errUnhealthy = errors.New("some URLs are unhealthy")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck [-timeout 5s] URL [URL...]")
+	}
+	timeout := fs.Duration("timeout", health.Timeout, "time limit for each request")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	if fs.NArg() == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	checker := health.NewChecker(&http.Client{Timeout: *timeout}, clock.Real{})
+	results := checker.CheckAll(ctx, fs.Args())
+	if printReport(stdout, results) {
+		return nil
+	}
+	return errUnhealthy
+}
+
+// printReport writes one line per result and a summary. It reports whether
+// every result is healthy.
+func printReport(w io.Writer, results []health.Result) bool {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, status := "[FAIL]", "---"
+		if r.Healthy() {
+			mark = "[ OK ]"
+			healthy++
+		}
+		if r.Status != 0 {
+			status = fmt.Sprint(r.Status)
+		}
+		line := fmt.Sprintf("%s  %-*s  %3s  %8s", mark, width, r.URL, status, r.Latency.Round(time.Millisecond))
+		if r.Err != nil {
+			line += "  " + r.Err.Error()
+		}
+		fmt.Fprintln(w, line)
+	}
+	fmt.Fprintf(w, "\n%d of %d healthy\n", healthy, len(results))
+	return healthy == len(results)
+}
