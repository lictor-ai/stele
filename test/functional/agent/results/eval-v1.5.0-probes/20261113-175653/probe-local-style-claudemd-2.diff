diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..0a73b79
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,39 @@
+package cmds
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+)
+
+// appName is the name the version command reports.
+const appName = "app"
+
+// Version is the build version. Set it at build time with
+// -ldflags "-X example.com/app/internal/cmds.Version=1.2.3". The linker
+// can only set a package-level variable, so this is the one exception to
+// the no-mutable-state rule.
+var Version = "dev"
+
+// VersionCmd prints the app name, build version and Go version.
+func VersionCmd(args []string) error {
+	return writeVersion(os.Stdout, Version, args)
+}
+
+// writeVersion writes the version report to w.
+func writeVersion(w io.Writer, version string, args []string) error {
+	if _, err := fmt.Fprintf(w, "%-10s %s\n%-10s %s\n%-10s %s\n",
+		"name:", appName,
+		"version:", version,
+		"go:", runtime.Version(),
+	); err != nil {
+		return fmt.Errorf("write version: %w", err)
+	}
+	if len(args) > 0 {
+		if _, err := fmt.Fprintf(w, "(ignoring %d arguments)\n", len(args)); err != nil {
+			return fmt.Errorf("write version: %w", err)
+		}
+	}
+	return nil
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..8066286
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,72 @@
+package cmds
+
+import (
+	"bytes"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestWriteVersion(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+		args    []string
+		want    []string
+		notWant []string
+	}{
+		{
+			name:    "default",
+			version: "dev",
+			want:    []string{"name:      app\n", "version:   dev\n", "go:        " + runtime.Version() + "\n"},
+			notWant: []string{"ignoring"},
+		},
+		{
+			name:    "build version",
+			version: "1.2.3",
+			want:    []string{"version:   1.2.3\n"},
+		},
+		{
+			name:    "empty version",
+			version: "",
+			want:    []string{"name:      app\n"},
+		},
+		{
+			name:    "extra arguments",
+			version: "dev",
+			args:    []string{"a", "b"},
+			want:    []string{"(ignoring 2 arguments)\n"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := writeVersion(&buf, tt.version, tt.args); err != nil {
+				t.Fatalf("writeVersion(%q, %v) error = %v, want nil", tt.version, tt.args, err)
+			}
+			got := buf.String()
+			for _, w := range tt.want {
+				if !strings.Contains(got, w) {
+					t.Errorf("writeVersion(%q, %v) = %q, want it to contain %q", tt.version, tt.args, got, w)
+				}
+			}
+			for _, w := range tt.notWant {
+				if strings.Contains(got, w) {
+					t.Errorf("writeVersion(%q, %v) = %q, want it not to contain %q", tt.version, tt.args, got, w)
+				}
+			}
+		})
+	}
+}
+
+func TestVersionRegistered(t *testing.T) {
+	for _, c := range All {
+		if c.Name == "version" {
+			if c.Run == nil {
+				t.Errorf("command %q has nil Run", c.Name)
+			}
+			return
+		}
+	}
+	t.Errorf("All has no command named %q", "version")
+}
