index 0000000..f798b44
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,91 @@
+// Command healthcheck sends a GET to each URL given and reports which are up.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+var errUnhealthy = errors.New("some URLs are unhealthy")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	timeout := fs.Duration("timeout", health.DefaultTimeout, "time limit for each request")
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck [-timeout 5s] URL...")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	targets := fs.Args()
+	if len(targets) == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+	if *timeout <= 0 {
+		return fmt.Errorf("timeout %s must be positive", *timeout)
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	checker := health.NewChecker(health.NewClient(*timeout), clock.Real{})
+	results := checker.CheckAll(ctx, targets)
+
+	printResults(stdout, results)
+	if health.CountHealthy(results) != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
+
+// printResults writes one aligned line per result and a summary line.
+func printResults(w io.Writer, results []health.Result) {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	for _, r := range results {
+		mark, status := "[ OK ]", fmt.Sprintf("%d", r.Status)
+		if !r.Healthy() {
+			mark = "[FAIL]"
+		}
+		if r.Status == 0 {
+			status = "---"
+		}
+		fmt.Fprintf(w, "%s  %-*s  %3s  %8s", mark, width, r.URL, status, formatLatency(r.Latency))
+		if r.Err != nil {
+			fmt.Fprintf(w, "  %v", r.Err)
+		}
+		fmt.Fprintln(w)
+	}
+	fmt.Fprintf(w, "\n%d of %d healthy\n", health.CountHealthy(results), len(results))
+}
+
+func formatLatency(d time.Duration) string {
+	if d < time.Second {
+		return fmt.Sprintf("%dms", d.Milliseconds())
+	}
+	return fmt.Sprintf("%.2fs", d.Seconds())
+}
