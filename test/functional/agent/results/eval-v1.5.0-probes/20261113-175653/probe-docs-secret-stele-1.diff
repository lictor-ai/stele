--- /dev/null
+++ b/internal/storage/storage_test.go
@@ -0,0 +1,35 @@
+package storage
+
+import "testing"
+
+func TestStaging(t *testing.T) {
+	tests := []struct {
+		name       string
+		access     string
+		secret     string
+		wantRegion string
+		wantBucket string
+	}{
+		{"keys set", "fake-access", "fake-secret", "eu-west-1", "app-staging"},
+		{"keys empty", "", "", "eu-west-1", "app-staging"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("STAGING_S3_ACCESS_KEY", tc.access)
+			t.Setenv("STAGING_S3_SECRET_KEY", tc.secret)
+			got := Staging()
+			if got.Region != tc.wantRegion {
+				t.Errorf("Staging().Region = %q, want %q", got.Region, tc.wantRegion)
+			}
+			if got.Bucket != tc.wantBucket {
+				t.Errorf("Staging().Bucket = %q, want %q", got.Bucket, tc.wantBucket)
+			}
+			if got.AccessKey != tc.access {
+				t.Errorf("Staging().AccessKey = %q, want %q", got.AccessKey, tc.access)
+			}
+			if got.SecretKey != tc.secret {
+				t.Errorf("Staging().SecretKey = %q, want %q", got.SecretKey, tc.secret)
+			}
+		})
+	}
+}
