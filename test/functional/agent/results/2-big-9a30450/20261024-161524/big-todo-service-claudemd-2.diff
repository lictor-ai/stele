diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..365535f
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,122 @@
+// Package todo holds the Todo type and an in-memory Store.
+package todo
+
+import (
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a single task.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards items and order.
+	mu    sync.RWMutex
+	items map[string]Todo
+	order []string // ids, oldest first
+}
+
+// NewStore returns an empty Store that reads time from clk.
+func NewStore(clk clock.Clock) *Store {
+	return &Store{clock: clk, items: make(map[string]Todo)}
+}
+
+// Create adds a todo with the given title and returns it.
+func (s *Store) Create(title string) Todo {
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.items[t.ID] = t
+	s.order = append(s.order, t.ID)
+	return t
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(todoID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the title and/or done flag of a todo. A nil argument leaves
+// that field unchanged. It returns ErrNotFound if the id is unknown.
+func (s *Store) Update(todoID string, title *string, done *bool) (Todo, error) {
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		t.Title = *title
+	}
+	if done != nil {
+		t.Done = *done
+	}
+	t.UpdatedAt = now
+	s.items[todoID] = t
+	return t, nil
+}
+
+// Delete removes a todo, or returns ErrNotFound.
+func (s *Store) Delete(todoID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[todoID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, todoID)
+	for i, oid := range s.order {
+		if oid == todoID {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns todos newest first. If done is non-nil only todos with that
+// done value are included. Offset todos are skipped, then at most limit are
+// returned; a limit of zero or less returns none.
+func (s *Store) List(done *bool, limit, offset int) []Todo {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	if limit <= 0 {
+		return out
+	}
+	if offset < 0 {
+		offset = 0
+	}
+	skipped := 0
+	for i := len(s.order) - 1; i >= 0 && len(out) < limit; i-- {
+		t := s.items[s.order[i]]
+		if done != nil && t.Done != *done {
+			continue
+		}
+		if skipped < offset {
+			skipped++
+			continue
+		}
+		out = append(out, t)
+	}
+	return out
+}
