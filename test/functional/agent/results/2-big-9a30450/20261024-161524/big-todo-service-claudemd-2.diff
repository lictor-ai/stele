+package todo
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var fixedTime = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newTestStore() *Store { return NewStore(clock.Fixed{T: fixedTime}) }
+
+func ptr[T any](v T) *T { return &v }
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func equal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestCreateGet(t *testing.T) {
+	s := newTestStore()
+	c := s.Create("write tests")
+	if c.ID == "" || c.Title != "write tests" || c.Done {
+		t.Errorf("Create(%q) = %+v, want new undone todo with id", "write tests", c)
+	}
+	if !c.CreatedAt.Equal(fixedTime) || !c.UpdatedAt.Equal(fixedTime) {
+		t.Errorf("Create timestamps = %v, %v, want %v", c.CreatedAt, c.UpdatedAt, fixedTime)
+	}
+	got, err := s.Get(c.ID)
+	if err != nil || got != c {
+		t.Errorf("Get(%q) = %+v, %v, want %+v, nil", c.ID, got, err, c)
+	}
+	if _, err := s.Get("missing"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(missing) error = %v, want ErrNotFound", err)
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	later := fixedTime.Add(time.Hour)
+	tests := []struct {
+		name      string
+		title     *string
+		done      *bool
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title only", ptr("new"), nil, "new", false},
+		{"done only", nil, ptr(true), "old", true},
+		{"both", ptr("new"), ptr(true), "new", true},
+		{"neither", nil, nil, "old", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			c := s.Create("old")
+			s.clock = clock.Fixed{T: later}
+			got, err := s.Update(c.ID, tc.title, tc.done)
+			if err != nil {
+				t.Fatalf("Update(%q) error = %v", c.ID, err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%q) = title %q done %v, want %q %v", c.ID, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			if !got.UpdatedAt.Equal(later) || !got.CreatedAt.Equal(fixedTime) {
+				t.Errorf("Update(%q) timestamps = %v, %v, want %v, %v", c.ID, got.CreatedAt, got.UpdatedAt, fixedTime, later)
+			}
+			stored, _ := s.Get(c.ID)
+			if stored != got {
+				t.Errorf("Get after Update = %+v, want %+v", stored, got)
+			}
+		})
+	}
+	t.Run("missing", func(t *testing.T) {
+		if _, err := newTestStore().Update("missing", ptr("x"), nil); !errors.Is(err, ErrNotFound) {
+			t.Errorf("Update(missing) error = %v, want ErrNotFound", err)
+		}
+	})
+}
+
+func TestDelete(t *testing.T) {
+	s := newTestStore()
+	a, b := s.Create("a"), s.Create("b")
+	if err := s.Delete(a.ID); err != nil {
+		t.Fatalf("Delete(%q) = %v, want nil", a.ID, err)
+	}
+	if err := s.Delete(a.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("second Delete(%q) = %v, want ErrNotFound", a.ID, err)
+	}
+	if _, err := s.Get(a.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get after Delete error = %v, want ErrNotFound", err)
+	}
+	if got := titles(s.List(nil, 10, 0)); !equal(got, []string{"b"}) {
+		t.Errorf("List after Delete = %v, want [b] (kept %q)", got, b.ID)
+	}
+}
+
+func TestList(t *testing.T) {
+	s := newTestStore()
+	for i := 1; i <= 5; i++ {
+		c := s.Create(fmt.Sprintf("t%d", i))
+		if i%2 == 0 {
+			s.Update(c.ID, nil, ptr(true))
+		}
+	}
+	tests := []struct {
+		name          string
+		done          *bool
+		limit, offset int
+		want          []string
+	}{
+		{"all newest first", nil, 10, 0, []string{"t5", "t4", "t3", "t2", "t1"}},
+		{"done only", ptr(true), 10, 0, []string{"t4", "t2"}},
+		{"not done", ptr(false), 10, 0, []string{"t5", "t3", "t1"}},
+		{"limit", nil, 2, 0, []string{"t5", "t4"}},
+		{"offset", nil, 2, 2, []string{"t3", "t2"}},
+		{"offset with filter", ptr(false), 2, 1, []string{"t3", "t1"}},
+		{"offset past end", nil, 10, 5, []string{}},
+		{"zero limit", nil, 0, 0, []string{}},
+		{"negative offset", nil, 1, -3, []string{"t5"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := titles(s.List(tc.done, tc.limit, tc.offset))
+			if !equal(got, tc.want) {
+				t.Errorf("List(%v, %d, %d) = %v, want %v", tc.done, tc.limit, tc.offset, got, tc.want)
+			}
+		})
+	}
+	if got := newTestStore().List(nil, 10, 0); got == nil {
+		t.Errorf("List on empty store = nil, want empty slice")
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	s := newTestStore()
+	const workers, perWorker = 16, 50
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < perWorker; i++ {
+				c := s.Create("x")
+				s.Update(c.ID, nil, ptr(true))
+				s.Get(c.ID)
+				s.List(nil, 10, 0)
+				if i%2 == 0 {
+					if err := s.Delete(c.ID); err != nil {
+						t.Errorf("Delete(%q) = %v, want nil", c.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	want := workers * perWorker / 2
+	if got := len(s.List(nil, want+1, 0)); got != want {
+		t.Errorf("remaining todos = %d, want %d", got, want)
+	}
+}
