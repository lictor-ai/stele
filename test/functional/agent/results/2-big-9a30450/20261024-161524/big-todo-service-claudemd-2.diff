diff --git a/cmd/server/main.go b/cmd/server/main.go
new file mode 100644
index 0000000..f2f1e9f
--- /dev/null
+++ b/cmd/server/main.go
@@ -0,0 +1,72 @@
+// Command server serves the to-do list API.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const shutdownTimeout = 10 * time.Second
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdout, os.Stderr)
+	stop()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("server", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	addr := fs.String("addr", ":8080", "address to listen on")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	store := todo.NewStore(clock.Real{})
+	srv := &http.Server{
+		Addr:              *addr,
+		Handler:           api.NewHandler(store),
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       10 * time.Second,
+		WriteTimeout:      10 * time.Second,
+		IdleTimeout:       60 * time.Second,
+	}
+
+	errc := make(chan error, 1)
+	go func() { errc <- srv.ListenAndServe() }()
+	log.Info("listening", "addr", *addr)
+
+	select {
+	case err := <-errc:
+		return fmt.Errorf("serve %s: %w", *addr, err)
+	case <-ctx.Done():
+	}
+
+	log.Info("shutting down")
+	shutCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), shutdownTimeout)
+	defer cancel()
+	if err := srv.Shutdown(shutCtx); err != nil {
+		return fmt.Errorf("shutdown: %w", err)
+	}
+	if err := <-errc; err != nil && !errors.Is(err, http.ErrServerClosed) {
+		return fmt.Errorf("serve %s: %w", *addr, err)
+	}
+	return nil
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..17ea4b9
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,177 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const (
+	maxBodyBytes = 1 << 20
+	maxTitleLen  = 200
+	defaultLimit = 20
+	maxLimit     = 100
+)
+
+// Handler serves the todo API.
+type Handler struct {
+	store *todo.Store
+	mux   *http.ServeMux
+}
+
+// NewHandler returns a Handler backed by store.
+func NewHandler(store *todo.Store) *Handler {
+	h := &Handler{store: store, mux: http.NewServeMux()}
+	h.mux.HandleFunc("POST /todos", h.create)
+	h.mux.HandleFunc("GET /todos", h.list)
+	h.mux.HandleFunc("GET /todos/{id}", h.get)
+	h.mux.HandleFunc("PATCH /todos/{id}", h.update)
+	h.mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return h
+}
+
+// ServeHTTP dispatches the request to the matching route.
+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	h.mux.ServeHTTP(w, r)
+}
+
+type createRequest struct {
+	Title *string `json:"title"`
+}
+
+type updateRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+// decode reads a single JSON object from the limited body into v.
+func decode(w http.ResponseWriter, r *http.Request, v any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, maxBodyBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(v); err != nil {
+		log.Warn("decode request body", "err", err)
+		Error(w, http.StatusBadRequest, "request body must be a valid JSON object with known fields")
+		return false
+	}
+	if dec.More() {
+		Error(w, http.StatusBadRequest, "request body must contain a single JSON object")
+		return false
+	}
+	return true
+}
+
+// cleanTitle trims title and checks its length in characters.
+func cleanTitle(title string) (string, bool) {
+	title = strings.TrimSpace(title)
+	n := utf8.RuneCountInString(title)
+	return title, n >= 1 && n <= maxTitleLen
+}
+
+func (h *Handler) create(w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	if !decode(w, r, &req) {
+		return
+	}
+	if req.Title == nil {
+		Error(w, http.StatusBadRequest, "title is required")
+		return
+	}
+	title, ok := cleanTitle(*req.Title)
+	if !ok {
+		Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+		return
+	}
+	JSON(w, http.StatusCreated, h.store.Create(title))
+}
+
+func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	var done *bool
+	if v := q.Get("done"); v != "" {
+		switch v {
+		case "true", "false":
+			b := v == "true"
+			done = &b
+		default:
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+	}
+	limit := defaultLimit
+	if v := q.Get("limit"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 1 || n > maxLimit {
+			Error(w, http.StatusBadRequest, "limit must be an integer from 1 to 100")
+			return
+		}
+		limit = n
+	}
+	offset := 0
+	if v := q.Get("offset"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be an integer of 0 or more")
+			return
+		}
+		offset = n
+	}
+	JSON(w, http.StatusOK, h.store.List(done, limit, offset))
+}
+
+func (h *Handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.PathValue("id"))
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *Handler) update(w http.ResponseWriter, r *http.Request) {
+	var req updateRequest
+	if !decode(w, r, &req) {
+		return
+	}
+	if req.Title == nil && req.Done == nil {
+		Error(w, http.StatusBadRequest, "provide title and/or done")
+		return
+	}
+	if req.Title != nil {
+		title, ok := cleanTitle(*req.Title)
+		if !ok {
+			Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+			return
+		}
+		req.Title = &title
+	}
+	t, err := h.store.Update(r.PathValue("id"), req.Title, req.Done)
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *Handler) delete(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.PathValue("id")); err != nil {
+		h.storeError(w, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (h *Handler) storeError(w http.ResponseWriter, err error) {
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	log.Error("store operation failed", "err", err)
+	Error(w, http.StatusInternalServerError, "internal error, try again later")
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..38f9392
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,248 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func newHandler() (*Handler, *todo.Store) {
+	s := todo.NewStore(clock.Fixed{T: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)})
+	return NewHandler(s), s
+}
+
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	var r *http.Request
+	if body == "" {
+		r = httptest.NewRequest(method, target, nil)
+	} else {
+		r = httptest.NewRequest(method, target, strings.NewReader(body))
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func wantError(t *testing.T, w *httptest.ResponseRecorder, status int) {
+	t.Helper()
+	if w.Code != status {
+		t.Errorf("status = %d, want %d (body %s)", w.Code, status, w.Body)
+	}
+	var env map[string]string
+	if err := json.Unmarshal(w.Body.Bytes(), &env); err != nil || env["error"] == "" {
+		t.Errorf("body = %q, want {\"error\": ...}", w.Body)
+	}
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name      string
+		body      string
+		status    int
+		wantTitle string
+	}{
+		{"ok", `{"title":"buy milk"}`, http.StatusCreated, "buy milk"},
+		{"trimmed", `{"title":"  buy milk  "}`, http.StatusCreated, "buy milk"},
+		{"200 chars", `{"title":"` + strings.Repeat("a", 200) + `"}`, http.StatusCreated, strings.Repeat("a", 200)},
+		{"200 multibyte chars", `{"title":"` + strings.Repeat("é", 200) + `"}`, http.StatusCreated, strings.Repeat("é", 200)},
+		{"201 chars", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, ""},
+		{"empty", `{"title":""}`, http.StatusBadRequest, ""},
+		{"blank", `{"title":"   "}`, http.StatusBadRequest, ""},
+		{"missing title", `{}`, http.StatusBadRequest, ""},
+		{"wrong type", `{"title":5}`, http.StatusBadRequest, ""},
+		{"unknown field", `{"title":"x","extra":1}`, http.StatusBadRequest, ""},
+		{"invalid json", `{"title":`, http.StatusBadRequest, ""},
+		{"empty body", ``, http.StatusBadRequest, ""},
+		{"trailing data", `{"title":"x"}{"title":"y"}`, http.StatusBadRequest, ""},
+		{"too large", `{"title":"` + strings.Repeat("a", 1<<20) + `"}`, http.StatusBadRequest, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, _ := newHandler()
+			w := do(h, "POST", "/todos", tc.body)
+			if tc.status != http.StatusCreated {
+				wantError(t, w, tc.status)
+				return
+			}
+			if w.Code != tc.status {
+				t.Fatalf("POST /todos status = %d, want %d", w.Code, tc.status)
+			}
+			var got map[string]any
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatalf("decode body %q: %v", w.Body, err)
+			}
+			if got["title"] != tc.wantTitle || got["done"] != false || got["id"] == "" {
+				t.Errorf("POST /todos body = %v, want title %q done false", got, tc.wantTitle)
+			}
+			for _, k := range []string{"created_at", "updated_at"} {
+				if _, ok := got[k]; !ok {
+					t.Errorf("POST /todos body missing %q: %v", k, got)
+				}
+			}
+			if ct := w.Header().Get("Content-Type"); ct != "application/json" {
+				t.Errorf("Content-Type = %q, want application/json", ct)
+			}
+		})
+	}
+}
+
+func TestGet(t *testing.T) {
+	h, s := newHandler()
+	c := s.Create("a")
+	tests := []struct {
+		name   string
+		target string
+		status int
+	}{
+		{"found", "/todos/" + c.ID, http.StatusOK},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "GET", tc.target, "")
+			if tc.status != http.StatusOK {
+				wantError(t, w, tc.status)
+				return
+			}
+			var got todo.Todo
+			if w.Code != tc.status || json.Unmarshal(w.Body.Bytes(), &got) != nil || got.ID != c.ID {
+				t.Errorf("GET %s = %d %s, want %d with id %s", tc.target, w.Code, w.Body, tc.status, c.ID)
+			}
+		})
+	}
+}
+
+func TestList(t *testing.T) {
+	h, s := newHandler()
+	for _, title := range []string{"a", "b", "c"} {
+		c := s.Create(title)
+		if title == "b" {
+			s.Update(c.ID, nil, func() *bool { b := true; return &b }())
+		}
+	}
+	tests := []struct {
+		name   string
+		query  string
+		status int
+		want   string
+	}{
+		{"default", "", http.StatusOK, "c,b,a"},
+		{"done true", "?done=true", http.StatusOK, "b"},
+		{"done false", "?done=false", http.StatusOK, "c,a"},
+		{"limit", "?limit=1", http.StatusOK, "c"},
+		{"offset", "?limit=2&offset=1", http.StatusOK, "b,a"},
+		{"offset past end", "?offset=10", http.StatusOK, ""},
+		{"limit 100", "?limit=100", http.StatusOK, "c,b,a"},
+		{"limit 0", "?limit=0", http.StatusBadRequest, ""},
+		{"limit 101", "?limit=101", http.StatusBadRequest, ""},
+		{"limit text", "?limit=abc", http.StatusBadRequest, ""},
+		{"negative offset", "?offset=-1", http.StatusBadRequest, ""},
+		{"offset text", "?offset=x", http.StatusBadRequest, ""},
+		{"bad done", "?done=maybe", http.StatusBadRequest, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "GET", "/todos"+tc.query, "")
+			if tc.status != http.StatusOK {
+				wantError(t, w, tc.status)
+				return
+			}
+			var got []todo.Todo
+			if w.Code != tc.status || json.Unmarshal(w.Body.Bytes(), &got) != nil {
+				t.Fatalf("GET /todos%s = %d %s, want 200 list", tc.query, w.Code, w.Body)
+			}
+			titles := make([]string, len(got))
+			for i, x := range got {
+				titles[i] = x.Title
+			}
+			if g := strings.Join(titles, ","); g != tc.want {
+				t.Errorf("GET /todos%s titles = %q, want %q", tc.query, g, tc.want)
+			}
+			if !strings.HasPrefix(w.Body.String(), "[") {
+				t.Errorf("GET /todos%s body = %q, want JSON array", tc.query, w.Body)
+			}
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		idSuffix  string
+		body      string
+		status    int
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title", "", `{"title":" new "}`, http.StatusOK, "new", false},
+		{"done", "", `{"done":true}`, http.StatusOK, "old", true},
+		{"both", "", `{"title":"new","done":true}`, http.StatusOK, "new", true},
+		{"empty object", "", `{}`, http.StatusBadRequest, "", false},
+		{"blank title", "", `{"title":" "}`, http.StatusBadRequest, "", false},
+		{"long title", "", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, "", false},
+		{"wrong done type", "", `{"done":"yes"}`, http.StatusBadRequest, "", false},
+		{"unknown field", "", `{"id":"z"}`, http.StatusBadRequest, "", false},
+		{"invalid json", "", `nope`, http.StatusBadRequest, "", false},
+		{"missing todo", "-missing", `{"done":true}`, http.StatusNotFound, "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, s := newHandler()
+			c := s.Create("old")
+			w := do(h, "PATCH", "/todos/"+c.ID+tc.idSuffix, tc.body)
+			if tc.status != http.StatusOK {
+				wantError(t, w, tc.status)
+				if got, _ := s.Get(c.ID); got != c {
+					t.Errorf("todo changed by failed PATCH: %+v, want %+v", got, c)
+				}
+				return
+			}
+			var got todo.Todo
+			if w.Code != tc.status || json.Unmarshal(w.Body.Bytes(), &got) != nil {
+				t.Fatalf("PATCH = %d %s, want 200", w.Code, w.Body)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("PATCH %s = title %q done %v, want %q %v", tc.body, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	h, s := newHandler()
+	c := s.Create("a")
+	tests := []struct {
+		name   string
+		target string
+		status int
+	}{
+		{"found", "/todos/" + c.ID, http.StatusNoContent},
+		{"again", "/todos/" + c.ID, http.StatusNotFound},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "DELETE", tc.target, "")
+			if tc.status == http.StatusNoContent {
+				if w.Code != tc.status || w.Body.Len() != 0 {
+					t.Errorf("DELETE %s = %d %q, want 204 empty", tc.target, w.Code, w.Body)
+				}
+				return
+			}
+			wantError(t, w, tc.status)
+		})
+	}
+}
+
+func TestUnsupportedMethod(t *testing.T) {
+	h, _ := newHandler()
+	if w := do(h, "PUT", "/todos", ""); w.Code != http.StatusMethodNotAllowed {
+		t.Errorf("PUT /todos = %d, want %d", w.Code, http.StatusMethodNotAllowed)
+	}
+}
