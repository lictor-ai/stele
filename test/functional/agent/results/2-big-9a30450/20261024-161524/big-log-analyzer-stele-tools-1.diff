diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..46dfa41
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,131 @@
+// Command loga summarises nginx access logs.
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// usageError marks bad command-line flags (exit code 2). The message has
+// already been written to stderr by the time it is returned.
+type usageError struct{ err error }
+
+func (e usageError) Error() string { return e.err.Error() }
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	err := run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	if err == nil {
+		return
+	}
+	var u usageError
+	if errors.As(err, &u) {
+		os.Exit(2)
+	}
+	fmt.Fprintln(os.Stderr, "loga:", err)
+	os.Exit(1)
+}
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: loga [-top N] [-json] [file ...]")
+		fs.PrintDefaults()
+	}
+	top := fs.Int("top", 10, "number of top paths to list")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return usageError{err}
+	}
+	if *top < 0 {
+		fmt.Fprintf(stderr, "invalid value %d for flag -top: must not be negative\n", *top)
+		return usageError{errors.New("negative -top")}
+	}
+
+	col := stats.NewCollector()
+	malformed := 0
+	if fs.NArg() == 0 {
+		n, err := logparse.Read(stdin, col.Add)
+		if err != nil {
+			return err
+		}
+		malformed += n
+	}
+	for _, name := range fs.Args() {
+		n, err := readFile(name, col)
+		if err != nil {
+			return err
+		}
+		malformed += n
+	}
+
+	rep := col.Report(*top, malformed)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		return enc.Encode(rep)
+	}
+	return writeText(stdout, rep)
+}
+
+func readFile(name string, col *stats.Collector) (int, error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return 0, err
+	}
+	defer f.Close()
+	n, err := logparse.Read(f, col.Add)
+	if err != nil {
+		return n, fmt.Errorf("%s: %w", name, err)
+	}
+	return n, nil
+}
+
+func writeText(w io.Writer, r stats.Report) error {
+	ew := &errWriter{w: w}
+	fmt.Fprintf(ew, "Total requests:  %d\n", r.TotalRequests)
+	fmt.Fprintf(ew, "Malformed lines: %d\n", r.MalformedLines)
+	fmt.Fprintf(ew, "\nTop paths\n")
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(ew, "  %8d  %s\n", p.Count, p.Path)
+	}
+	fmt.Fprintf(ew, "\nStatus classes\n")
+	fmt.Fprintf(ew, "  2xx  %d\n  3xx  %d\n  4xx  %d\n  5xx  %d\n",
+		r.StatusClasses.C2xx, r.StatusClasses.C3xx, r.StatusClasses.C4xx, r.StatusClasses.C5xx)
+	fmt.Fprintf(ew, "\nRequest time (ms)\n")
+	fmt.Fprintf(ew, "  p50  %.3f\n  p95  %.3f\n  p99  %.3f\n", r.LatencyMS.P50, r.LatencyMS.P95, r.LatencyMS.P99)
+	fmt.Fprintf(ew, "\n5xx errors per hour (UTC)\n")
+	if len(r.Errors5xxHour) == 0 {
+		fmt.Fprintf(ew, "  none\n")
+	}
+	for _, h := range r.Errors5xxHour {
+		fmt.Fprintf(ew, "  %s  %d\n", h.Hour, h.Count)
+	}
+	return ew.err
+}
+
+// errWriter remembers the first write error so callers can check once.
+type errWriter struct {
+	w   io.Writer
+	err error
+}
+
+func (e *errWriter) Write(p []byte) (int, error) {
+	if e.err != nil {
+		return 0, e.err
+	}
+	n, err := e.w.Write(p)
+	e.err = err
+	return n, err
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..aa2e53c
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,153 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/stats"
+)
+
+const logData = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 200 512 "-" "curl/8.0" 0.010
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "GET /login HTTP/1.1" 502 0 "-" "curl/8.0" 1.000
+not a log line
+203.0.113.9 - - [10/Oct/2026:14:02:00 +0000] "GET /missing HTTP/1.1" 404 9 "-" "curl/8.0" 0.005
+`
+
+func writeLog(t *testing.T, content string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "access.log")
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+	return p
+}
+
+func TestRunJSON(t *testing.T) {
+	p := writeLog(t, logData)
+	var out, errb bytes.Buffer
+	if err := run([]string{"-json", "-top", "2", p}, strings.NewReader(""), &out, &errb); err != nil {
+		t.Fatalf("run(-json) error = %v, want nil", err)
+	}
+	var rep stats.Report
+	if err := json.Unmarshal(out.Bytes(), &rep); err != nil {
+		t.Fatalf("run(-json) output is not JSON: %v\n%s", err, out.String())
+	}
+	if rep.TotalRequests != 4 || rep.MalformedLines != 1 {
+		t.Errorf("run(-json) totals = %d, %d; want 4, 1", rep.TotalRequests, rep.MalformedLines)
+	}
+	if len(rep.TopPaths) != 2 || rep.TopPaths[0].Path != "/api/items" || rep.TopPaths[0].Count != 2 {
+		t.Errorf("run(-json) top paths = %+v, want /api/items first with 2", rep.TopPaths)
+	}
+	if rep.StatusClasses.C2xx != 2 || rep.StatusClasses.C4xx != 1 || rep.StatusClasses.C5xx != 1 {
+		t.Errorf("run(-json) status classes = %+v", rep.StatusClasses)
+	}
+	if len(rep.Errors5xxHour) != 1 || rep.Errors5xxHour[0].Hour != "2026-10-10T14:00:00Z" {
+		t.Errorf("run(-json) hourly errors = %+v, want one entry at 14:00Z", rep.Errors5xxHour)
+	}
+	for _, key := range []string{`"total_requests"`, `"latency_ms"`, `"errors_5xx_per_hour"`, `"2xx"`} {
+		if !strings.Contains(out.String(), key) {
+			t.Errorf("run(-json) output missing %s", key)
+		}
+	}
+}
+
+func TestRunText(t *testing.T) {
+	tests := []struct {
+		name  string
+		args  []string
+		stdin string
+		want  []string
+	}{
+		{
+			name: "file",
+			args: []string{writeLog(t, logData)},
+			want: []string{"Total requests:  4", "Malformed lines: 1", "/api/items", "p99", "2026-10-10T14:00:00Z  1"},
+		},
+		{
+			name:  "stdin",
+			stdin: logData,
+			want:  []string{"Total requests:  4", "Malformed lines: 1"},
+		},
+		{
+			name:  "empty stdin",
+			stdin: "",
+			want:  []string{"Total requests:  0", "Malformed lines: 0", "none"},
+		},
+		{
+			name: "two files",
+			args: []string{writeLog(t, logData), writeLog(t, logData)},
+			want: []string{"Total requests:  8", "Malformed lines: 2"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errb bytes.Buffer
+			if err := run(tt.args, strings.NewReader(tt.stdin), &out, &errb); err != nil {
+				t.Fatalf("run(%v) error = %v, want nil", tt.args, err)
+			}
+			for _, w := range tt.want {
+				if !strings.Contains(out.String(), w) {
+					t.Errorf("run(%v) output lacks %q:\n%s", tt.args, w, out.String())
+				}
+			}
+		})
+	}
+}
+
+func TestRunTopLimit(t *testing.T) {
+	var out, errb bytes.Buffer
+	if err := run([]string{"-top", "1", writeLog(t, logData)}, strings.NewReader(""), &out, &errb); err != nil {
+		t.Fatalf("run(-top 1) error = %v", err)
+	}
+	if strings.Contains(out.String(), "/login") {
+		t.Errorf("run(-top 1) listed more than one path:\n%s", out.String())
+	}
+}
+
+func TestRunErrors(t *testing.T) {
+	tests := []struct {
+		name      string
+		args      []string
+		wantUsage bool
+	}{
+		{"missing file", []string{filepath.Join(t.TempDir(), "nope.log")}, false},
+		{"unknown flag", []string{"-bogus"}, true},
+		{"bad top value", []string{"-top", "abc"}, true},
+		{"negative top", []string{"-top", "-1"}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errb bytes.Buffer
+			err := run(tt.args, strings.NewReader(""), &out, &errb)
+			if err == nil {
+				t.Fatalf("run(%v) error = nil, want error", tt.args)
+			}
+			var u usageError
+			if got := errors.As(err, &u); got != tt.wantUsage {
+				t.Errorf("run(%v) usage error = %v, want %v (err %v)", tt.args, got, tt.wantUsage, err)
+			}
+			if tt.wantUsage && errb.Len() == 0 {
+				t.Errorf("run(%v) wrote nothing to stderr for a usage error", tt.args)
+			}
+			if out.Len() != 0 {
+				t.Errorf("run(%v) wrote to stdout on failure: %q", tt.args, out.String())
+			}
+		})
+	}
+}
+
+func TestRunHelp(t *testing.T) {
+	var out, errb bytes.Buffer
+	if err := run([]string{"-h"}, strings.NewReader(""), &out, &errb); err != nil {
+		t.Errorf("run(-h) error = %v, want nil", err)
+	}
+	if !strings.Contains(errb.String(), "usage: loga") {
+		t.Errorf("run(-h) stderr = %q, want usage text", errb.String())
+	}
+}
