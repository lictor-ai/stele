+func TestTopN(t *testing.T) {
+	m := map[string]int{"/b": 2, "/a": 2, "/c": 5, "/d": 1}
+	tests := []struct {
+		n    int
+		want []PathCount
+	}{
+		{0, []PathCount{}},
+		{-1, []PathCount{}},
+		{1, []PathCount{{"/c", 5}}},
+		{3, []PathCount{{"/c", 5}, {"/a", 2}, {"/b", 2}}},
