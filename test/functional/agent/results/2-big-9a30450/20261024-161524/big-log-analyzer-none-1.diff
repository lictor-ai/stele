+	if want := []PathCount{{"/a", 2}, {"/b", 2}}; !reflect.DeepEqual(r.TopPaths, want) {
+		t.Errorf("top = %v, want %v", r.TopPaths, want)
+	}
+	// sorted times 10..70: p50 -> rank 4 = 40, p95/p99 -> rank 7 = 70
+	if want := (Percentiles{40, 70, 70}); r.RequestTimeMS != want {
+		t.Errorf("percentiles = %+v", r.RequestTimeMS)
+	}
+	want := []HourErrors{{"2026-10-10T13:00:00Z", 2}, {"2026-10-10T14:00:00Z", 1}}
+	if !reflect.DeepEqual(r.Errors5xxHour, want) {
