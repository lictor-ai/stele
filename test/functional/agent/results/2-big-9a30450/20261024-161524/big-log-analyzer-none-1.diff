+func seq(n int) []float64 {
+	s := make([]float64, n)
+	for i := range s {
+		s[i] = float64(i + 1)
+	}
+	return s
+}
+
+func TestPercentile(t *testing.T) {
+	ten := seq(10)
+	tests := []struct {
+		name string
+		in   []float64
+		p    float64
+		want float64
+	}{
+		{"empty", nil, 50, 0},
+		{"single p50", []float64{7}, 50, 7},
+		{"single p99", []float64{7}, 99, 7},
+		{"single p0", []float64{7}, 0, 7},
+		{"p0 is min", ten, 0, 1},
+		{"p100 is max", ten, 100, 10},
+		{"p50 of ten", ten, 50, 5},
+		{"p95 of ten", ten, 95, 10},
+		{"p90 of ten", ten, 90, 9},
+		{"p10 of ten", ten, 10, 1},
+		{"p11 of ten", ten, 11, 2},
+		{"p50 of two", []float64{1, 2}, 50, 1},
+		{"p99 of hundred", seq(100), 99, 99},
+		{"p95 of hundred", seq(100), 95, 95},
+		{"below range clamps", ten, -5, 1},
+		{"above range clamps", ten, 250, 10},
+		{"duplicates", []float64{3, 3, 3, 3}, 95, 3},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := Percentile(tc.in, tc.p); got != tc.want {
+				t.Errorf("Percentile(%v, %v) = %v, want %v", tc.in, tc.p, got, tc.want)
+			}
+		})
+	}
+}
+
+func entry(path string, status int, ts string, ms int) logparse.Entry {
+	tm, err := time.Parse(time.RFC3339, ts)
+	if err != nil {
+		panic(err)
+	}
+	return logparse.Entry{Path: path, Status: status, Time: tm, RequestTime: time.Duration(ms) * time.Millisecond}
+}
+
+func TestEmptyReport(t *testing.T) {
+	r := NewCollector().Report(10)
+	if r.Total != 0 || r.Malformed != 0 || r.RequestTimeMS != (Percentiles{}) {
+		t.Errorf("unexpected %+v", r)
+	}
+	if r.TopPaths == nil || r.Errors5xxHour == nil {
+		t.Error("slices must be non-nil so JSON renders []")
+	}
+	b, _ := json.Marshal(r)
+	if !strings.Contains(string(b), `"top_paths":[]`) || !strings.Contains(string(b), `"errors_5xx_per_hour":[]`) {
+		t.Errorf("json = %s", b)
+	}
+	for _, k := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if v, ok := r.StatusClasses[k]; !ok || v != 0 {
+			t.Errorf("class %s = %d, %v", k, v, ok)
+		}
+	}
+}
+
+func TestSingleRequest(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/a", 200, "2026-10-10T13:55:36Z", 42))
+	r := c.Report(10)
+	if r.Total != 1 {
+		t.Errorf("total = %d", r.Total)
+	}
+	if want := (Percentiles{42, 42, 42}); r.RequestTimeMS != want {
+		t.Errorf("percentiles = %+v", r.RequestTimeMS)
+	}
+	if !reflect.DeepEqual(r.TopPaths, []PathCount{{"/a", 1}}) {
+		t.Errorf("top = %+v", r.TopPaths)
+	}
+	if len(r.Errors5xxHour) != 0 {
+		t.Errorf("errors = %+v", r.Errors5xxHour)
+	}
+}
+
+func TestReport(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/a", 200, "2026-10-10T13:05:00Z", 10))
+	c.Add(entry("/a", 301, "2026-10-10T13:06:00Z", 20))
+	c.Add(entry("/b", 404, "2026-10-10T13:07:00Z", 30))
+	c.Add(entry("/b", 500, "2026-10-10T13:59:59Z", 40))
+	c.Add(entry("/c", 503, "2026-10-10T14:00:00Z", 50))
+	c.Add(entry("/c", 502, "2026-10-10T13:10:00Z", 60))
+	c.Add(entry("/d", 100, "2026-10-10T13:10:00Z", 70)) // 1xx: in no class
+	c.AddMalformed()
+	c.AddMalformed()
+	r := c.Report(2)
+
+	if r.Total != 7 || r.Malformed != 2 {
+		t.Errorf("total/malformed = %d/%d", r.Total, r.Malformed)
+	}
+	wantClasses := map[string]int{"2xx": 1, "3xx": 1, "4xx": 1, "5xx": 3}
+	if !reflect.DeepEqual(r.StatusClasses, wantClasses) {
