+package stats
+
+import (
+	"slices"
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestPercentile(t *testing.T) {
+	tests := []struct {
+		name string
+		in   []float64
+		p    float64
+		want float64
+	}{
+		{"empty", nil, 50, 0},
+		{"single p50", []float64{7}, 50, 7},
+		{"single p99", []float64{7}, 99, 7},
+		{"p0 is min", []float64{3, 1, 2}, 0, 1},
+		{"negative p is min", []float64{3, 1, 2}, -5, 1},
+		{"p100 is max", []float64{3, 1, 2}, 100, 3},
+		{"p over 100 is max", []float64{3, 1, 2}, 150, 3},
+		{"p50 of four", []float64{4, 1, 3, 2}, 50, 2},
+		{"p50 of five", []float64{5, 1, 4, 2, 3}, 50, 3},
+		{"p95 of twenty", seq(20), 95, 19},
+		{"p99 of hundred", seq(100), 99, 99},
+		{"p99 of ten is max", seq(10), 99, 10},
+		{"tiny p picks first", seq(10), 0.001, 1},
+		{"duplicates", []float64{5, 5, 5}, 95, 5},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			orig := slices.Clone(tt.in)
+			if got := Percentile(tt.in, tt.p); got != tt.want {
+				t.Errorf("Percentile(%v, %v) = %v, want %v", tt.in, tt.p, got, tt.want)
+			}
+			if !slices.Equal(orig, tt.in) {
+				t.Errorf("Percentile modified its input: %v, want %v", tt.in, orig)
+			}
+		})
+	}
+}
+
+func seq(n int) []float64 {
+	out := make([]float64, n)
+	for i := range out {
+		out[i] = float64(i + 1)
+	}
+	return out
+}
+
+func TestTopPaths(t *testing.T) {
+	counts := map[string]int{"/a": 3, "/b": 5, "/c": 3, "/d": 1}
+	tests := []struct {
+		name string
+		in   map[string]int
+		n    int
+		want []PathCount
+	}{
+		{"empty map", map[string]int{}, 10, []PathCount{}},
+		{"zero", counts, 0, []PathCount{}},
+		{"negative", counts, -1, []PathCount{}},
+		{"limit", counts, 2, []PathCount{{"/b", 5}, {"/a", 3}}},
+		{"ties by path", counts, 3, []PathCount{{"/b", 5}, {"/a", 3}, {"/c", 3}}},
+		{"n larger than paths", counts, 99, []PathCount{{"/b", 5}, {"/a", 3}, {"/c", 3}, {"/d", 1}}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := TopPaths(tt.in, tt.n); !slices.Equal(got, tt.want) {
+				t.Errorf("TopPaths(%v, %d) = %v, want %v", tt.in, tt.n, got, tt.want)
+			}
+		})
+	}
+}
+
+func entry(path string, status int, ms float64, at time.Time) logparse.Entry {
+	return logparse.Entry{Path: path, Status: status, RequestTimeMs: ms, Time: at}
+}
+
+func TestCollectorEmpty(t *testing.T) {
+	r := NewCollector().Report(10, 0)
+	if r.Total != 0 || r.Status != (StatusClasses{}) || r.RequestTimeMs != (Percentiles{}) {
+		t.Errorf("empty Report() = %+v, want zero values", r)
+	}
+	if r.TopPaths == nil || r.Errors5xxHour == nil {
+		t.Errorf("empty Report() slices are nil, want non-nil: %+v", r)
+	}
+}
+
+func TestCollectorSingle(t *testing.T) {
+	at := time.Date(2026, 10, 10, 13, 55, 0, 0, time.UTC)
+	c := NewCollector()
+	c.Add(entry("/x", 200, 42, at))
+	r := c.Report(10, 2)
+	if r.Total != 1 || r.Malformed != 2 {
+		t.Errorf("Report() total, malformed = %d, %d, want 1, 2", r.Total, r.Malformed)
+	}
+	if r.Status.C2xx != 1 {
+		t.Errorf("Report().Status = %+v, want one 2xx", r.Status)
+	}
+	if want := (Percentiles{42, 42, 42}); r.RequestTimeMs != want {
+		t.Errorf("Report().RequestTimeMs = %+v, want %+v", r.RequestTimeMs, want)
+	}
+	if len(r.Errors5xxHour) != 0 {
+		t.Errorf("Report().Errors5xxHour = %v, want none", r.Errors5xxHour)
+	}
+}
+
+func TestCollectorReport(t *testing.T) {
+	h13 := time.Date(2026, 10, 10, 13, 59, 59, 0, time.UTC)
+	h14 := time.Date(2026, 10, 10, 14, 0, 0, 0, time.UTC)
+	// 15:30 at +0200 is 13:30 UTC and must land in the 13:00 bucket.
+	h13off := time.Date(2026, 10, 10, 15, 30, 0, 0, time.FixedZone("x", 2*3600))
+	c := NewCollector()
+	for _, e := range []logparse.Entry{
+		entry("/a", 200, 10, h13),
+		entry("/a", 301, 20, h13),
+		entry("/b", 404, 30, h13),
+		entry("/b", 500, 40, h14),
+		entry("/b", 503, 50, h14),
+		entry("/c", 502, 60, h13off),
+		entry("/c", 100, 70, h13), // 1xx is counted in no class
+	} {
+		c.Add(e)
+	}
+	r := c.Report(2, 0)
+	if want := (StatusClasses{C2xx: 1, C3xx: 1, C4xx: 1, C5xx: 3}); r.Status != want {
+		t.Errorf("Status = %+v, want %+v", r.Status, want)
+	}
+	if want := []PathCount{{"/b", 3}, {"/a", 2}}; !slices.Equal(r.TopPaths, want) {
+		t.Errorf("TopPaths = %v, want %v", r.TopPaths, want)
+	}
+	if want := []HourCount{{"2026-10-10T13:00Z", 1}, {"2026-10-10T14:00Z", 2}}; !slices.Equal(r.Errors5xxHour, want) {
+		t.Errorf("Errors5xxHour = %v, want %v", r.Errors5xxHour, want)
+	}
+	if want := (Percentiles{P50: 40, P95: 70, P99: 70}); r.RequestTimeMs != want {
+		t.Errorf("RequestTimeMs = %+v, want %+v", r.RequestTimeMs, want)
+	}
+}
