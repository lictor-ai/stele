diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..b8c935e
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,122 @@
+// Command loga prints a report for nginx access logs.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// usageError marks bad command line flags, which exit with code 2.
+type usageError struct{ err error }
+
+func (e usageError) Error() string { return e.err.Error() }
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	err := run(ctx, os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	var ue usageError
+	switch {
+	case err == nil, errors.Is(err, flag.ErrHelp):
+		return
+	case errors.As(err, &ue):
+		os.Exit(2)
+	default:
+		fmt.Fprintln(os.Stderr, "loga:", err)
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of top paths to show")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return err
+		}
+		return usageError{err}
+	}
+	if *top < 0 {
+		err := fmt.Errorf("invalid -top %d: must not be negative", *top)
+		fmt.Fprintln(stderr, err)
+		return usageError{err}
+	}
+
+	col := stats.NewCollector()
+	malformed := 0
+	if fs.NArg() == 0 {
+		n, err := logparse.Read(ctx, stdin, col.Add)
+		if err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+		malformed += n
+	}
+	for _, name := range fs.Args() {
+		n, err := readFile(ctx, name, col)
+		if err != nil {
+			return err
+		}
+		malformed += n
+	}
+
+	rep := col.Report(*top, malformed)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(rep); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+		return nil
+	}
+	return writeText(stdout, rep)
+}
+
+func readFile(ctx context.Context, name string, col *stats.Collector) (int, error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return 0, fmt.Errorf("open %s: %w", name, err)
+	}
+	defer f.Close()
+	n, err := logparse.Read(ctx, f, col.Add)
+	if err != nil {
+		return n, fmt.Errorf("read %s: %w", name, err)
+	}
+	return n, nil
+}
+
+func writeText(w io.Writer, r stats.Report) error {
+	var err error
+	p := func(format string, a ...any) {
+		if err == nil {
+			_, err = fmt.Fprintf(w, format, a...)
+		}
+	}
+	p("Total requests:   %d\n", r.Total)
+	p("Malformed lines:  %d\n\n", r.Malformed)
+	p("Top paths\n")
+	for _, pc := range r.TopPaths {
+		p("  %8d  %s\n", pc.Count, pc.Path)
+	}
+	p("\nStatus classes\n")
+	p("  2xx  %d\n  3xx  %d\n  4xx  %d\n  5xx  %d\n", r.Status.C2xx, r.Status.C3xx, r.Status.C4xx, r.Status.C5xx)
+	p("\nRequest time (ms)\n")
+	p("  p50  %.3f\n  p95  %.3f\n  p99  %.3f\n", r.RequestTimeMs.P50, r.RequestTimeMs.P95, r.RequestTimeMs.P99)
+	p("\n5xx per hour\n")
+	for _, h := range r.Errors5xxHour {
+		p("  %s  %d\n", h.Hour, h.Count)
+	}
+	return err
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..bb2aea1
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,122 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const logData = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 200 512 "-" "curl/8.0" 0.100
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "POST /api/orders HTTP/1.1" 502 10 "-" "curl/8.0" 0.300
+broken line
+`
+
+func TestRun(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "access.log")
+	if err := os.WriteFile(file, []byte(logData), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name       string
+		args       []string
+		stdin      string
+		wantErr    bool
+		wantUsage  bool
+		wantHelp   bool
+		wantStdout []string
+	}{
+		{
+			name:       "text from file",
+			args:       []string{file},
+			wantStdout: []string{"Total requests:   3", "Malformed lines:  1", "/api/items", "5xx  1", "p50", "2026-10-10T14:00Z  1"},
+		},
+		{
+			name:       "text from stdin",
+			stdin:      logData,
+			wantStdout: []string{"Total requests:   3"},
+		},
+		{
+			name:       "empty stdin",
+			stdin:      "",
+			wantStdout: []string{"Total requests:   0", "Malformed lines:  0"},
+		},
+		{name: "missing file", args: []string{filepath.Join(dir, "nope.log")}, wantErr: true},
+		{name: "unknown flag", args: []string{"-bogus"}, wantErr: true, wantUsage: true},
+		{name: "bad top value", args: []string{"-top", "x"}, wantErr: true, wantUsage: true},
+		{name: "negative top", args: []string{"-top", "-1"}, wantErr: true, wantUsage: true},
+		{name: "help", args: []string{"-h"}, wantErr: true, wantHelp: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(context.Background(), tt.args, strings.NewReader(tt.stdin), &out, &errOut)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("run(%v) error = %v, wantErr %v", tt.args, err, tt.wantErr)
+			}
+			var ue usageError
+			if got := errors.As(err, &ue); got != tt.wantUsage {
+				t.Errorf("run(%v) usage error = %v, want %v", tt.args, got, tt.wantUsage)
+			}
+			if got := errors.Is(err, flag.ErrHelp); got != tt.wantHelp {
+				t.Errorf("run(%v) help = %v, want %v", tt.args, got, tt.wantHelp)
+			}
+			for _, s := range tt.wantStdout {
+				if !strings.Contains(out.String(), s) {
+					t.Errorf("run(%v) stdout = %q, want it to contain %q", tt.args, out.String(), s)
+				}
+			}
+		})
+	}
+}
+
+func TestRunTop(t *testing.T) {
+	var out bytes.Buffer
+	err := run(context.Background(), []string{"-top", "1", "-json"}, strings.NewReader(logData), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run(-top 1 -json) error = %v", err)
+	}
+	var rep struct {
+		TopPaths []struct {
+			Path  string `json:"path"`
+			Count int    `json:"count"`
+		} `json:"top_paths"`
+	}
+	if err := json.Unmarshal(out.Bytes(), &rep); err != nil {
+		t.Fatalf("output is not JSON: %v", err)
+	}
+	if len(rep.TopPaths) != 1 || rep.TopPaths[0].Path != "/api/items" || rep.TopPaths[0].Count != 2 {
+		t.Errorf("run(-top 1) top_paths = %+v, want one entry /api/items x2", rep.TopPaths)
+	}
+}
+
+func TestRunJSON(t *testing.T) {
+	var out bytes.Buffer
+	err := run(context.Background(), []string{"-json"}, strings.NewReader(logData), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run(-json) error = %v", err)
+	}
+	var rep map[string]any
+	if err := json.Unmarshal(out.Bytes(), &rep); err != nil {
+		t.Fatalf("run(-json) output is not JSON: %v\n%s", err, out.String())
+	}
+	if got := rep["total_requests"]; got != float64(3) {
+		t.Errorf("run(-json) total_requests = %v, want 3", got)
+	}
+	if got := rep["malformed_lines"]; got != float64(1) {
+		t.Errorf("run(-json) malformed_lines = %v, want 1", got)
+	}
+	for _, k := range []string{"top_paths", "status_classes", "request_time_ms", "errors_5xx_per_hour"} {
+		if _, ok := rep[k]; !ok {
+			t.Errorf("run(-json) output lacks key %q", k)
+		}
+	}
+}
