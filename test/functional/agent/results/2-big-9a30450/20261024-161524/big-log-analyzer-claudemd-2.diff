+// Package stats aggregates parsed access log entries into a report.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// HourCount is the number of 5xx responses in one UTC hour.
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// StatusClasses counts requests per status class.
+type StatusClasses struct {
+	C2xx int `json:"2xx"`
+	C3xx int `json:"3xx"`
+	C4xx int `json:"4xx"`
+	C5xx int `json:"5xx"`
+}
+
+// Percentiles holds request time percentiles in milliseconds.
+type Percentiles struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// Report is the summary of a set of log entries.
+type Report struct {
+	Total         int           `json:"total_requests"`
+	Malformed     int           `json:"malformed_lines"`
+	TopPaths      []PathCount   `json:"top_paths"`
+	Status        StatusClasses `json:"status_classes"`
+	RequestTimeMs Percentiles   `json:"request_time_ms"`
+	Errors5xxHour []HourCount   `json:"errors_5xx_per_hour"`
+}
+
+// Collector accumulates entries. Use NewCollector to create one.
+type Collector struct {
+	total  int
+	paths  map[string]int
+	status StatusClasses
+	times  []float64
+	hours  map[time.Time]int
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{paths: map[string]int{}, hours: map[time.Time]int{}}
+}
+
+// Add records one entry.
+func (c *Collector) Add(e logparse.Entry) {
+	c.total++
+	c.paths[e.Path]++
+	c.times = append(c.times, e.RequestTimeMs)
+	switch {
+	case e.Status >= 200 && e.Status < 300:
+		c.status.C2xx++
+	case e.Status >= 300 && e.Status < 400:
+		c.status.C3xx++
+	case e.Status >= 400 && e.Status < 500:
+		c.status.C4xx++
+	case e.Status >= 500 && e.Status < 600:
+		c.status.C5xx++
+		c.hours[e.Time.UTC().Truncate(time.Hour)]++
+	}
+}
+
+// Report builds the report with the top n paths and the given malformed count.
+// A negative n is treated as zero.
+func (c *Collector) Report(n, malformed int) Report {
+	return Report{
+		Total:         c.total,
+		Malformed:     malformed,
+		TopPaths:      TopPaths(c.paths, n),
+		Status:        c.status,
+		RequestTimeMs: Percentiles{P50: Percentile(c.times, 50), P95: Percentile(c.times, 95), P99: Percentile(c.times, 99)},
+		Errors5xxHour: hourly(c.hours),
+	}
+}
+
+// TopPaths returns up to n paths ordered by count descending, then path ascending.
+func TopPaths(counts map[string]int, n int) []PathCount {
+	out := make([]PathCount, 0, len(counts))
+	for p, k := range counts {
+		out = append(out, PathCount{Path: p, Count: k})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Count != out[j].Count {
+			return out[i].Count > out[j].Count
+		}
+		return out[i].Path < out[j].Path
+	})
+	if n < 0 {
+		n = 0
+	}
+	if len(out) > n {
+		out = out[:n]
+	}
+	return out
+}
+
+func hourly(m map[time.Time]int) []HourCount {
+	keys := make([]time.Time, 0, len(m))
+	for t := range m {
+		keys = append(keys, t)
+	}
+	sort.Slice(keys, func(i, j int) bool { return keys[i].Before(keys[j]) })
+	out := make([]HourCount, 0, len(keys))
+	for _, t := range keys {
+		out = append(out, HourCount{Hour: t.Format("2006-01-02T15:00Z"), Count: m[t]})
+	}
+	return out
+}
+
+// Percentile returns the p-th percentile (0 to 100) of values using the
+// nearest-rank method. It returns 0 for empty input. p is clamped to [0, 100].
+// The input is not modified.
+func Percentile(values []float64, p float64) float64 {
+	if len(values) == 0 {
+		return 0
+	}
+	s := append([]float64(nil), values...)
+	sort.Float64s(s)
+	if p <= 0 {
+		return s[0]
+	}
+	if p > 100 {
+		p = 100
+	}
+	rank := int(math.Ceil(p / 100 * float64(len(s))))
+	if rank < 1 {
+		rank = 1
+	}
+	return s[rank-1]
+}
