+package logparse
+
+import "errors"
+
+// ErrMalformed is returned when a line is not a valid access log record.
+var ErrMalformed = errors.New("malformed log line")
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..72a2356
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,160 @@
+// Package logparse parses nginx access log lines in the combined format with
+// the request time (in seconds) appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// Entry is one parsed access log record.
+type Entry struct {
+	Remote string
+	Time   time.Time
+	Method string
+	// Path is the request path with the query string removed.
+	Path   string
+	Status int
+	Bytes  int64
+	// RequestTimeMs is the request time in milliseconds.
+	RequestTimeMs float64
+}
+
+// Parse parses a single log line. It returns an error wrapping ErrMalformed
+// when the line does not match the format.
+func Parse(line string) (Entry, error) {
+	f, err := fields(line)
+	if err != nil {
+		return Entry{}, err
+	}
+	if len(f) != 10 {
+		return Entry{}, fmt.Errorf("parse %q: want 10 fields, got %d: %w", line, len(f), ErrMalformed)
+	}
+	t, err := time.Parse(timeLayout, f[3])
+	if err != nil {
+		return Entry{}, fmt.Errorf("parse %q: bad time: %w", line, ErrMalformed)
+	}
+	req := strings.Fields(f[4])
+	if len(req) != 3 {
+		return Entry{}, fmt.Errorf("parse %q: bad request line: %w", line, ErrMalformed)
+	}
+	status, err := strconv.Atoi(f[5])
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, fmt.Errorf("parse %q: bad status %q: %w", line, f[5], ErrMalformed)
+	}
+	var size int64
+	if f[6] != "-" {
+		size, err = strconv.ParseInt(f[6], 10, 64)
+		if err != nil || size < 0 {
+			return Entry{}, fmt.Errorf("parse %q: bad size %q: %w", line, f[6], ErrMalformed)
+		}
+	}
+	secs, err := strconv.ParseFloat(f[9], 64)
+	if err != nil || math.IsNaN(secs) || math.IsInf(secs, 0) || secs < 0 {
+		return Entry{}, fmt.Errorf("parse %q: bad request time %q: %w", line, f[9], ErrMalformed)
+	}
+	return Entry{
+		Remote:        f[0],
+		Time:          t,
+		Method:        req[0],
+		Path:          stripQuery(req[1]),
+		Status:        status,
+		Bytes:         size,
+		RequestTimeMs: secs * 1000,
+	}, nil
+}
+
+func stripQuery(target string) string {
+	if i := strings.IndexAny(target, "?#"); i >= 0 {
+		target = target[:i]
+	}
+	return target
+}
+
+// fields splits a line on spaces, keeping "quoted" and [bracketed] groups as
+// single fields without their delimiters. Inside quotes a backslash escapes
+// the next character.
+func fields(line string) ([]string, error) {
+	var out []string
+	i := 0
+	for i < len(line) {
+		switch line[i] {
+		case ' ':
+			i++
+		case '"':
+			var b strings.Builder
+			i++
+			closed := false
+			for i < len(line) {
+				ch := line[i]
+				if ch == '\\' && i+1 < len(line) {
+					b.WriteByte(line[i+1])
+					i += 2
+					continue
+				}
+				i++
+				if ch == '"' {
+					closed = true
+					break
+				}
+				b.WriteByte(ch)
+			}
+			if !closed {
+				return nil, fmt.Errorf("parse %q: unterminated quote: %w", line, ErrMalformed)
+			}
+			out = append(out, b.String())
+		case '[':
+			end := strings.IndexByte(line[i:], ']')
+			if end < 0 {
+				return nil, fmt.Errorf("parse %q: unterminated bracket: %w", line, ErrMalformed)
+			}
+			out = append(out, line[i+1:i+end])
+			i += end + 1
+		default:
+			end := strings.IndexByte(line[i:], ' ')
+			if end < 0 {
+				end = len(line) - i
+			}
+			out = append(out, line[i:i+end])
+			i += end
+		}
+	}
+	return out, nil
+}
+
+// Read parses every line of r and calls handle for each valid entry. Blank
+// lines are ignored. It returns the number of malformed lines, which are
+// skipped. It stops early with the context error if ctx is cancelled.
+func Read(ctx context.Context, r io.Reader, handle func(Entry)) (int, error) {
+	br := bufio.NewReader(r)
+	malformed := 0
+	for {
+		if err := ctx.Err(); err != nil {
+			return malformed, fmt.Errorf("read log: %w", err)
+		}
+		line, err := br.ReadString('\n')
+		if err != nil && !errors.Is(err, io.EOF) {
+			return malformed, fmt.Errorf("read log: %w", err)
+		}
+		line = strings.TrimRight(line, "\r\n")
+		if strings.TrimSpace(line) != "" {
+			if e, perr := Parse(line); perr != nil {
+				malformed++
+			} else {
+				handle(e)
+			}
+		}
+		if err != nil {
+			return malformed, nil
+		}
+	}
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..b072ac5
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,126 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+const goodLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	tests := []struct {
+		name string
+		in   string
+		want Entry
+	}{
+		{
+			name: "example line",
+			in:   goodLine,
+			want: Entry{Remote: "203.0.113.9", Time: time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC), Method: "GET", Path: "/api/items", Status: 200, Bytes: 512, RequestTimeMs: 42},
+		},
+		{
+			name: "dash size",
+			in:   `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 304 - "-" "ua" 0.001`,
+			want: Entry{Remote: "1.2.3.4", Time: time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC), Method: "GET", Path: "/", Status: 304, RequestTimeMs: 1},
+		},
+		{
+			name: "escaped quote in user agent and spaces",
+			in:   `1.2.3.4 - bob [10/Oct/2026:13:55:36 +0000] "POST /a/b?x=1 HTTP/2.0" 500 0 "http://r/" "a \"quoted\" ua" 1.5`,
+			want: Entry{Remote: "1.2.3.4", Time: time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC), Method: "POST", Path: "/a/b", Status: 500, RequestTimeMs: 1500},
+		},
+		{
+			name: "non utc offset",
+			in:   `1.2.3.4 - - [10/Oct/2026:13:55:36 +0200] "GET /x HTTP/1.1" 200 1 "-" "-" 0`,
+			want: Entry{Remote: "1.2.3.4", Time: time.Date(2026, 10, 10, 11, 55, 36, 0, time.UTC), Method: "GET", Path: "/x", Status: 200, Bytes: 1},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Parse(tt.in)
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v, want nil", tt.in, err)
+			}
+			if !got.Time.Equal(tt.want.Time) {
+				t.Errorf("Parse(%q).Time = %v, want %v", tt.in, got.Time, tt.want.Time)
+			}
+			got.Time, tt.want.Time = time.Time{}, time.Time{}
+			if got != tt.want {
+				t.Errorf("Parse(%q) = %+v, want %+v", tt.in, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestParseMalformed(t *testing.T) {
+	tests := []struct {
+		name string
+		in   string
+	}{
+		{"empty", ""},
+		{"garbage", "hello world"},
+		{"missing request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "ua"`},
+		{"extra field", goodLine + " extra"},
+		{"unterminated quote", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 200 512 "-" "ua" 0.1`},
+		{"unterminated bracket", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 512 "-" "ua" 0.1`},
+		{"bad time", `1.2.3.4 - - [yesterday] "GET / HTTP/1.1" 200 512 "-" "ua" 0.1`},
+		{"bad request line", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "-" 400 0 "-" "-" 0.0`},
+		{"non numeric status", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" abc 512 "-" "ua" 0.1`},
+		{"status out of range", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 999 512 "-" "ua" 0.1`},
+		{"bad size", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 big "-" "ua" 0.1`},
+		{"negative size", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 -5 "-" "ua" 0.1`},
+		{"bad request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "ua" fast`},
+		{"negative request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "ua" -1`},
+		{"NaN request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "ua" NaN`},
+		{"infinite request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "ua" Inf`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := Parse(tt.in)
+			if !errors.Is(err, ErrMalformed) {
+				t.Errorf("Parse(%q) error = %v, want ErrMalformed", tt.in, err)
+			}
+		})
+	}
+}
+
+func TestRead(t *testing.T) {
+	tests := []struct {
+		name          string
+		in            string
+		wantEntries   int
+		wantMalformed int
+	}{
+		{"empty input", "", 0, 0},
+		{"only blank lines", "\n\n  \n", 0, 0},
+		{"single request", goodLine + "\n", 1, 0},
+		{"no trailing newline", goodLine, 1, 0},
+		{"crlf", goodLine + "\r\n" + goodLine + "\r\n", 2, 0},
+		{"malformed skipped", goodLine + "\nnot a log line\n" + goodLine + "\n", 2, 1},
+		{"all malformed", "a\nb\nc\n", 0, 3},
+		{"very long line", strings.Repeat("x", 1<<20) + "\n" + goodLine + "\n", 1, 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			n := 0
+			bad, err := Read(context.Background(), strings.NewReader(tt.in), func(Entry) { n++ })
+			if err != nil {
+				t.Fatalf("Read() error = %v, want nil", err)
+			}
+			if n != tt.wantEntries || bad != tt.wantMalformed {
+				t.Errorf("Read() = %d entries, %d malformed, want %d, %d", n, bad, tt.wantEntries, tt.wantMalformed)
+			}
+		})
+	}
+}
+
+func TestReadCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := Read(ctx, strings.NewReader(goodLine+"\n"), func(Entry) {})
+	if !errors.Is(err, context.Canceled) {
+		t.Errorf("Read(cancelled ctx) error = %v, want context.Canceled", err)
+	}
+}
