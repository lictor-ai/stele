+package todo
+
+import "errors"
+
+// ErrNotFound is returned when no item has the requested id.
+var ErrNotFound = errors.New("todo not found")
+
+// ErrInvalidTitle is returned when a title is empty or too long after trimming.
+var ErrInvalidTitle = errors.New("title must be 1 to 200 characters")
diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..4b228fa
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,163 @@
+// Package todo holds the Todo type and an in-memory store for it.
+package todo
+
+import (
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// MaxTitleLength is the longest allowed title, in characters.
+const MaxTitleLength = 200
+
+// Todo is a single item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// UpdateParams lists the fields to change. A nil field is left as it is.
+type UpdateParams struct {
+	Title *string
+	Done  *bool
+}
+
+// ListFilter selects and pages the items returned by List.
+type ListFilter struct {
+	// Done, when not nil, keeps only items with that done value.
+	Done *bool
+	// Limit is the most items to return. Zero or less means no limit.
+	Limit int
+	// Offset is the number of matching items to skip. Less than zero means zero.
+	Offset int
+}
+
+// ValidateTitle trims title and checks that it has 1 to MaxTitleLength
+// characters. It returns the trimmed title.
+func ValidateTitle(title string) (string, error) {
+	title = strings.TrimSpace(title)
+	n := utf8.RuneCountInString(title)
+	if n < 1 || n > MaxTitleLength {
+		return "", ErrInvalidTitle
+	}
+	return title, nil
+}
+
+// Store keeps todos in memory. It is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards items and order.
+	mu    sync.RWMutex
+	items map[string]*Todo
+	order []string // ids, oldest first
+}
+
+// NewStore returns an empty Store that reads time from c.
+func NewStore(c clock.Clock) *Store {
+	return &Store{clock: c, items: make(map[string]*Todo)}
+}
+
+// Create adds a todo with the given title and returns it.
+func (s *Store) Create(title string) (Todo, error) {
+	title, err := ValidateTitle(title)
+	if err != nil {
+		return Todo{}, err
+	}
+	now := s.clock.Now()
+	t := &Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.items[t.ID] = t
+	s.order = append(s.order, t.ID)
+	return *t, nil
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(todoID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return *t, nil
+}
+
+// Update changes the fields set in p and returns the updated todo. It returns
+// ErrNotFound for an unknown id and ErrInvalidTitle for a bad title; in both
+// cases nothing changes.
+func (s *Store) Update(todoID string, p UpdateParams) (Todo, error) {
+	var title string
+	if p.Title != nil {
+		var err error
+		if title, err = ValidateTitle(*p.Title); err != nil {
+			return Todo{}, err
+		}
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if p.Title != nil {
+		t.Title = title
+	}
+	if p.Done != nil {
+		t.Done = *p.Done
+	}
+	t.UpdatedAt = s.clock.Now()
+	return *t, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(todoID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[todoID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, todoID)
+	for i, oid := range s.order {
+		if oid == todoID {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns the todos matching f, newest first. It never returns nil.
+func (s *Store) List(f ListFilter) []Todo {
+	offset := max(f.Offset, 0)
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	skipped := 0
+	for i := len(s.order) - 1; i >= 0; i-- {
+		t := s.items[s.order[i]]
+		if f.Done != nil && t.Done != *f.Done {
+			continue
+		}
+		if skipped < offset {
+			skipped++
+			continue
+		}
+		if f.Limit > 0 && len(out) >= f.Limit {
+			break
+		}
+		out = append(out, *t)
+	}
+	return out
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..29b7cb0
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,331 @@
+package todo
+
+import (
+	"errors"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var epoch = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+// stepClock moves forward one second on every call.
+type stepClock struct {
+	mu sync.RWMutex
+	t  time.Time
+}
+
+func (c *stepClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.t = c.t.Add(time.Second)
+	return c.t
+}
+
+func boolPtr(b bool) *bool    { return &b }
+func strPtr(s string) *string { return &s }
+func newTestStore() *Store    { return NewStore(clock.Fixed{T: epoch}) }
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name    string
+		title   string
+		want    string
+		wantErr error
+	}{
+		{"plain", "buy milk", "buy milk", nil},
+		{"trimmed", "  buy milk \n", "buy milk", nil},
+		{"one char", "a", "a", nil},
+		{"max length", strings.Repeat("a", 200), strings.Repeat("a", 200), nil},
+		{"max length multibyte", strings.Repeat("é", 200), strings.Repeat("é", 200), nil},
+		{"padding does not count", " " + strings.Repeat("a", 200) + " ", strings.Repeat("a", 200), nil},
+		{"empty", "", "", ErrInvalidTitle},
+		{"blank", " \t\n", "", ErrInvalidTitle},
+		{"too long", strings.Repeat("a", 201), "", ErrInvalidTitle},
+		{"too long multibyte", strings.Repeat("é", 201), "", ErrInvalidTitle},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := newTestStore()
+			got, err := s.Create(tt.title)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tt.title, err, tt.wantErr)
+			}
+			if err != nil {
+				if n := len(s.List(ListFilter{})); n != 0 {
+					t.Errorf("after failed Create(%q), List has %d items, want 0", tt.title, n)
+				}
+				return
+			}
+			if got.Title != tt.want {
+				t.Errorf("Create(%q).Title = %q, want %q", tt.title, got.Title, tt.want)
+			}
+			if got.ID == "" {
+				t.Errorf("Create(%q).ID is empty", tt.title)
+			}
+			if got.Done {
+				t.Errorf("Create(%q).Done = true, want false", tt.title)
+			}
+			if !got.CreatedAt.Equal(epoch) || !got.UpdatedAt.Equal(epoch) {
+				t.Errorf("Create(%q) times = %v, %v, want both %v", tt.title, got.CreatedAt, got.UpdatedAt, epoch)
+			}
+		})
+	}
+}
+
+func TestGet(t *testing.T) {
+	s := newTestStore()
+	created, err := s.Create("one")
+	if err != nil {
+		t.Fatalf("Create(one) error = %v", err)
+	}
+	tests := []struct {
+		name    string
+		id      string
+		wantErr error
+	}{
+		{"existing", created.ID, nil},
+		{"unknown", "nope", ErrNotFound},
+		{"empty", "", ErrNotFound},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := s.Get(tt.id)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Get(%q) error = %v, want %v", tt.id, err, tt.wantErr)
+			}
+			if err == nil && got != created {
+				t.Errorf("Get(%q) = %+v, want %+v", tt.id, got, created)
+			}
+		})
+	}
+}
+
+func TestGetReturnsCopy(t *testing.T) {
+	s := newTestStore()
+	created, _ := s.Create("one")
+	created.Title = "changed outside"
+	got, _ := s.Get(created.ID)
+	if got.Title != "one" {
+		t.Errorf("Get(%q).Title = %q after caller edit, want %q", created.ID, got.Title, "one")
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		params    UpdateParams
+		wantTitle string
+		wantDone  bool
+		wantErr   error
+	}{
+		{"title only", UpdateParams{Title: strPtr(" new ")}, "new", false, nil},
+		{"done only", UpdateParams{Done: boolPtr(true)}, "old", true, nil},
+		{"both", UpdateParams{Title: strPtr("new"), Done: boolPtr(true)}, "new", true, nil},
+		{"done false", UpdateParams{Done: boolPtr(false)}, "old", false, nil},
+		{"empty title", UpdateParams{Title: strPtr("  ")}, "old", false, ErrInvalidTitle},
+		{"long title", UpdateParams{Title: strPtr(strings.Repeat("a", 201))}, "old", false, ErrInvalidTitle},
+		{"bad title keeps done", UpdateParams{Title: strPtr(""), Done: boolPtr(true)}, "old", false, ErrInvalidTitle},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := NewStore(&stepClock{t: epoch})
+			created, _ := s.Create("old")
+			got, err := s.Update(created.ID, tt.params)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Update(%q, %s) error = %v, want %v", created.ID, tt.name, err, tt.wantErr)
+			}
+			stored, _ := s.Get(created.ID)
+			if stored.Title != tt.wantTitle || stored.Done != tt.wantDone {
+				t.Errorf("after Update(%s): title %q done %v, want %q %v", tt.name, stored.Title, stored.Done, tt.wantTitle, tt.wantDone)
+			}
+			if err != nil {
+				if !stored.UpdatedAt.Equal(created.UpdatedAt) {
+					t.Errorf("failed Update(%s) changed UpdatedAt to %v", tt.name, stored.UpdatedAt)
+				}
+				return
+			}
+			if got != stored {
+				t.Errorf("Update(%s) = %+v, want %+v", tt.name, got, stored)
+			}
+			if !got.UpdatedAt.After(created.UpdatedAt) {
+				t.Errorf("Update(%s).UpdatedAt = %v, want after %v", tt.name, got.UpdatedAt, created.UpdatedAt)
+			}
+			if !got.CreatedAt.Equal(created.CreatedAt) {
+				t.Errorf("Update(%s).CreatedAt = %v, want %v", tt.name, got.CreatedAt, created.CreatedAt)
+			}
+		})
+	}
+
+	t.Run("unknown id", func(t *testing.T) {
+		s := newTestStore()
+		_, err := s.Update("nope", UpdateParams{Done: boolPtr(true)})
+		if !errors.Is(err, ErrNotFound) {
+			t.Errorf("Update(nope) error = %v, want %v", err, ErrNotFound)
+		}
+	})
+}
+
+func TestDelete(t *testing.T) {
+	s := newTestStore()
+	a, _ := s.Create("a")
+	b, _ := s.Create("b")
+	c, _ := s.Create("c")
+
+	tests := []struct {
+		name     string
+		id       string
+		wantErr  error
+		wantLeft []string
+	}{
+		{"middle", b.ID, nil, []string{"c", "a"}},
+		{"again", b.ID, ErrNotFound, []string{"c", "a"}},
+		{"unknown", "nope", ErrNotFound, []string{"c", "a"}},
+		{"newest", c.ID, nil, []string{"a"}},
+		{"last", a.ID, nil, []string{}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := s.Delete(tt.id)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Delete(%q) error = %v, want %v", tt.id, err, tt.wantErr)
+			}
+			if got := titles(s.List(ListFilter{})); !slices.Equal(got, tt.wantLeft) {
+				t.Errorf("List after Delete(%q) = %v, want %v", tt.id, got, tt.wantLeft)
+			}
+			if _, err := s.Get(tt.id); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Get(%q) after Delete error = %v, want %v", tt.id, err, ErrNotFound)
+			}
+		})
+	}
+}
+
+func TestList(t *testing.T) {
+	s := newTestStore()
+	for _, title := range []string{"a", "b", "c", "d", "e"} {
+		created, err := s.Create(title)
+		if err != nil {
+			t.Fatalf("Create(%q) error = %v", title, err)
+		}
+		if title == "b" || title == "d" {
+			if _, err := s.Update(created.ID, UpdateParams{Done: boolPtr(true)}); err != nil {
+				t.Fatalf("Update(%q) error = %v", title, err)
+			}
+		}
+	}
+
+	tests := []struct {
+		name string
+		f    ListFilter
+		want []string
+	}{
+		{"all newest first", ListFilter{}, []string{"e", "d", "c", "b", "a"}},
+		{"done", ListFilter{Done: boolPtr(true)}, []string{"d", "b"}},
+		{"not done", ListFilter{Done: boolPtr(false)}, []string{"e", "c", "a"}},
+		{"limit", ListFilter{Limit: 2}, []string{"e", "d"}},
+		{"offset", ListFilter{Offset: 3}, []string{"b", "a"}},
+		{"limit and offset", ListFilter{Limit: 2, Offset: 1}, []string{"d", "c"}},
+		{"filter with paging", ListFilter{Done: boolPtr(false), Limit: 1, Offset: 1}, []string{"c"}},
+		{"offset at end", ListFilter{Offset: 5}, []string{}},
+		{"offset past end", ListFilter{Offset: 100}, []string{}},
+		{"limit larger than set", ListFilter{Limit: 100}, []string{"e", "d", "c", "b", "a"}},
+		{"negative offset", ListFilter{Offset: -3, Limit: 1}, []string{"e"}},
+		{"negative limit means no limit", ListFilter{Limit: -1}, []string{"e", "d", "c", "b", "a"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := s.List(tt.f)
+			if got == nil {
+				t.Fatalf("List(%+v) = nil, want non-nil slice", tt.f)
+			}
+			if g := titles(got); !slices.Equal(g, tt.want) {
+				t.Errorf("List(%+v) = %v, want %v", tt.f, g, tt.want)
+			}
+		})
+	}
+
+	t.Run("empty store", func(t *testing.T) {
+		got := newTestStore().List(ListFilter{})
+		if got == nil || len(got) != 0 {
+			t.Errorf("List on empty store = %v, want empty non-nil slice", got)
+		}
+	})
+}
+
+func TestConcurrentUse(t *testing.T) {
+	const workers = 16
+	const perWorker = 50
+
+	s := NewStore(&stepClock{t: epoch})
+	var wg sync.WaitGroup
+	ids := make(chan string, workers*perWorker)
+
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < perWorker; i++ {
+				created, err := s.Create("item")
+				if err != nil {
+					t.Errorf("Create(item) error = %v", err)
+					return
+				}
+				ids <- created.ID
+				if _, err := s.Update(created.ID, UpdateParams{Done: boolPtr(i%2 == 0)}); err != nil {
+					t.Errorf("Update(%q) error = %v", created.ID, err)
+				}
+				if _, err := s.Get(created.ID); err != nil {
+					t.Errorf("Get(%q) error = %v", created.ID, err)
+				}
+				s.List(ListFilter{Limit: 10})
+			}
+		}()
+	}
+	wg.Wait()
+	close(ids)
+
+	seen := make(map[string]bool)
+	for id := range ids {
+		if seen[id] {
+			t.Fatalf("duplicate id %q", id)
+		}
+		seen[id] = true
+	}
+	if got := len(s.List(ListFilter{})); got != workers*perWorker {
+		t.Fatalf("List has %d items, want %d", got, workers*perWorker)
+	}
+
+	// Delete everything concurrently; each id is deleted exactly once.
+	idList := make([]string, 0, len(seen))
+	for id := range seen {
+		idList = append(idList, id)
+	}
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := w; i < len(idList); i += workers {
+				if err := s.Delete(idList[i]); err != nil {
+					t.Errorf("Delete(%q) error = %v", idList[i], err)
+				}
+				s.List(ListFilter{})
+			}
+		}()
+	}
+	wg.Wait()
+	if got := len(s.List(ListFilter{})); got != 0 {
+		t.Errorf("List after deleting all has %d items, want 0", got)
+	}
+}
