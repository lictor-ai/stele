+package main
+
+import (
+	"bytes"
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestRunFlags(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+	}{
+		{"unknown flag", []string{"-nope"}},
+		{"flag missing its value", []string{"-addr"}},
+		{"unlistenable address", []string{"-addr", "not an address"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			if err := run(tt.args, &stdout, &stderr); err == nil {
+				t.Errorf("run(%q) = nil, want an error", tt.args)
+			}
+		})
+	}
+}
+
+func TestRunHelp(t *testing.T) {
+	var stdout, stderr bytes.Buffer
+	if err := run([]string{"-h"}, &stdout, &stderr); err == nil {
+		t.Errorf("run(-h) = nil, want flag.ErrHelp")
+	}
+	if !strings.Contains(stderr.String(), "-addr") {
+		t.Errorf("run(-h) usage = %q, want it to mention -addr", stderr.String())
+	}
+}
+
+func TestServeStopsOnCancel(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	srv := newServer("127.0.0.1:0", http.NotFoundHandler())
+	if err := serve(ctx, srv); err != nil {
+		t.Errorf("serve with cancelled context = %v, want nil", err)
+	}
+}
+
+func TestNewServerTimeouts(t *testing.T) {
+	srv := newServer(":0", http.NotFoundHandler())
+	if srv.ReadHeaderTimeout == 0 || srv.ReadTimeout == 0 || srv.WriteTimeout == 0 || srv.IdleTimeout == 0 {
+		t.Errorf("newServer timeouts = %v %v %v %v, want all set",
+			srv.ReadHeaderTimeout, srv.ReadTimeout, srv.WriteTimeout, srv.IdleTimeout)
+	}
+}
diff --git a/internal/api/handler.go b/internal/api/handler.go
new file mode 100644
index 0000000..f508725
--- /dev/null
+++ b/internal/api/handler.go
@@ -0,0 +1,170 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const (
+	maxBodyBytes = 1 << 20
+	defaultLimit = 20
+	maxLimit     = 100
+)
+
+type handler struct {
+	store *todo.Store
+}
+
+// NewHandler returns the HTTP handler for the todo API, backed by store.
+func NewHandler(store *todo.Store) http.Handler {
+	h := &handler{store: store}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		Error(w, http.StatusNotFound, "no such route")
+	})
+	return mux
+}
+
+type createRequest struct {
+	Title string `json:"title"`
+}
+
+type updateRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+func (h *handler) create(w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	if !decodeBody(w, r, &req) {
+		return
+	}
+	t, err := h.store.Create(req.Title)
+	if err != nil {
+		storeError(w, "create todo", err)
+		return
+	}
+	JSON(w, http.StatusCreated, t)
+}
+
+func (h *handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	f := todo.ListFilter{Limit: defaultLimit}
+
+	if q.Has("done") {
+		switch q.Get("done") {
+		case "true":
+			done := true
+			f.Done = &done
+		case "false":
+			done := false
+			f.Done = &done
+		default:
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+	}
+
+	if q.Has("limit") {
+		n, err := strconv.Atoi(q.Get("limit"))
+		if err != nil || n < 1 || n > maxLimit {
+			Error(w, http.StatusBadRequest, fmt.Sprintf("limit must be an integer from 1 to %d", maxLimit))
+			return
+		}
+		f.Limit = n
+	}
+	if q.Has("offset") {
+		n, err := strconv.Atoi(q.Get("offset"))
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be an integer of 0 or more")
+			return
+		}
+		f.Offset = n
+	}
+
+	JSON(w, http.StatusOK, h.store.List(f))
+}
+
+func (h *handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.PathValue("id"))
+	if err != nil {
+		storeError(w, "get todo", err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) update(w http.ResponseWriter, r *http.Request) {
+	var req updateRequest
+	if !decodeBody(w, r, &req) {
+		return
+	}
+	if req.Title == nil && req.Done == nil {
+		Error(w, http.StatusBadRequest, "provide title, done or both")
+		return
+	}
+	t, err := h.store.Update(r.PathValue("id"), todo.UpdateParams{Title: req.Title, Done: req.Done})
+	if err != nil {
+		storeError(w, "update todo", err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) delete(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.PathValue("id")); err != nil {
+		storeError(w, "delete todo", err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// decodeBody reads one JSON object from the request into v. On failure it
+// writes the error response and returns false.
+func decodeBody(w http.ResponseWriter, r *http.Request, v any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, maxBodyBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	err := dec.Decode(v)
+	if err == nil {
+		// Reject trailing data after the object.
+		if _, err = dec.Token(); err == io.EOF {
+			return true
+		}
+		if err == nil {
+			err = errors.New("trailing data")
+		}
+	}
+	var tooLarge *http.MaxBytesError
+	if errors.As(err, &tooLarge) {
+		Error(w, http.StatusRequestEntityTooLarge, "request body is too large")
+		return false
+	}
+	Error(w, http.StatusBadRequest, "request body must be a single valid JSON object with known fields")
+	return false
+}
+
+// storeError maps a store error to a response without exposing its text.
+func storeError(w http.ResponseWriter, op string, err error) {
+	switch {
+	case errors.Is(err, todo.ErrNotFound):
+		Error(w, http.StatusNotFound, "todo not found")
+	case errors.Is(err, todo.ErrInvalidTitle):
+		Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+	default:
+		log.Error(op, "err", err)
+		Error(w, http.StatusInternalServerError, "internal error, try again later")
+	}
+}
diff --git a/internal/api/handler_test.go b/internal/api/handler_test.go
new file mode 100644
index 0000000..97244fd
--- /dev/null
+++ b/internal/api/handler_test.go
@@ -0,0 +1,362 @@
+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+var epoch = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newTestHandler() http.Handler {
+	return NewHandler(todo.NewStore(clock.Fixed{T: epoch}))
+}
+
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	var req *http.Request
+	if body == "" {
+		req = httptest.NewRequest(method, target, nil)
+	} else {
+		req = httptest.NewRequest(method, target, strings.NewReader(body))
+		req.Header.Set("Content-Type", "application/json")
+	}
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+func decodeTodo(t *testing.T, rec *httptest.ResponseRecorder) todo.Todo {
+	t.Helper()
+	var got todo.Todo
+	if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
+		t.Fatalf("response %q is not a todo: %v", rec.Body.String(), err)
+	}
+	return got
+}
+
+func decodeList(t *testing.T, rec *httptest.ResponseRecorder) []todo.Todo {
+	t.Helper()
+	var got []todo.Todo
+	if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
+		t.Fatalf("response %q is not a todo list: %v", rec.Body.String(), err)
+	}
+	return got
+}
+
+// checkError verifies status and the {"error": "..."} envelope.
+func checkError(t *testing.T, call string, rec *httptest.ResponseRecorder, wantStatus int) {
+	t.Helper()
+	if rec.Code != wantStatus {
+		t.Errorf("%s status = %d, want %d (body %q)", call, rec.Code, wantStatus, rec.Body.String())
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Errorf("%s Content-Type = %q, want application/json", call, ct)
+	}
+	var env map[string]string
+	if err := json.Unmarshal(rec.Body.Bytes(), &env); err != nil || env["error"] == "" {
+		t.Errorf("%s body = %q, want {\"error\": \"...\"}", call, rec.Body.String())
+	}
+}
+
+func seed(t *testing.T, h http.Handler, title string) todo.Todo {
+	t.Helper()
+	rec := do(h, http.MethodPost, "/todos", fmt.Sprintf(`{"title":%q}`, title))
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("seed POST /todos %q status = %d, want %d", title, rec.Code, http.StatusCreated)
+	}
+	return decodeTodo(t, rec)
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name       string
+		body       string
+		wantStatus int
+		wantTitle  string
+	}{
+		{"ok", `{"title":"buy milk"}`, http.StatusCreated, "buy milk"},
+		{"trimmed", `{"title":"  buy milk  "}`, http.StatusCreated, "buy milk"},
+		{"200 chars", `{"title":"` + strings.Repeat("a", 200) + `"}`, http.StatusCreated, strings.Repeat("a", 200)},
+		{"201 chars", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, ""},
+		{"empty title", `{"title":""}`, http.StatusBadRequest, ""},
+		{"blank title", `{"title":"   "}`, http.StatusBadRequest, ""},
+		{"missing title", `{}`, http.StatusBadRequest, ""},
+		{"null title", `{"title":null}`, http.StatusBadRequest, ""},
+		{"wrong type", `{"title":5}`, http.StatusBadRequest, ""},
+		{"unknown field", `{"title":"x","done":true}`, http.StatusBadRequest, ""},
+		{"not json", `nope`, http.StatusBadRequest, ""},
+		{"empty body", ``, http.StatusBadRequest, ""},
+		{"array body", `[]`, http.StatusBadRequest, ""},
+		{"trailing data", `{"title":"x"}{"title":"y"}`, http.StatusBadRequest, ""},
+		{"too large", `{"title":"` + strings.Repeat("a", 1<<20) + `"}`, http.StatusRequestEntityTooLarge, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := newTestHandler()
+			rec := do(h, http.MethodPost, "/todos", tt.body)
+			if tt.wantStatus != http.StatusCreated {
+				checkError(t, "POST /todos", rec, tt.wantStatus)
+				if n := len(decodeList(t, do(h, http.MethodGet, "/todos", ""))); n != 0 {
+					t.Errorf("after rejected POST, GET /todos has %d items, want 0", n)
+				}
+				return
+			}
+			if rec.Code != http.StatusCreated {
+				t.Fatalf("POST /todos status = %d, want %d", rec.Code, http.StatusCreated)
+			}
+			if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+				t.Errorf("POST /todos Content-Type = %q, want application/json", ct)
+			}
+			got := decodeTodo(t, rec)
+			if got.Title != tt.wantTitle || got.ID == "" || got.Done {
+				t.Errorf("POST /todos = %+v, want title %q, an id, done false", got, tt.wantTitle)
+			}
+			if !got.CreatedAt.Equal(epoch) || !got.UpdatedAt.Equal(epoch) {
+				t.Errorf("POST /todos times = %v, %v, want %v", got.CreatedAt, got.UpdatedAt, epoch)
+			}
+		})
+	}
+}
+
+func TestCreateJSONFieldNames(t *testing.T) {
+	rec := do(newTestHandler(), http.MethodPost, "/todos", `{"title":"x"}`)
+	var raw map[string]any
+	if err := json.Unmarshal(rec.Body.Bytes(), &raw); err != nil {
+		t.Fatalf("response %q is not an object: %v", rec.Body.String(), err)
+	}
+	for _, key := range []string{"id", "title", "done", "created_at", "updated_at"} {
+		if _, ok := raw[key]; !ok {
+			t.Errorf("POST /todos response %q lacks field %q", rec.Body.String(), key)
+		}
+	}
+}
+
+func TestGet(t *testing.T) {
+	h := newTestHandler()
+	created := seed(t, h, "one")
+
+	tests := []struct {
+		name       string
+		path       string
+		wantStatus int
+	}{
+		{"existing", "/todos/" + created.ID, http.StatusOK},
+		{"unknown id", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := do(h, http.MethodGet, tt.path, "")
+			if tt.wantStatus != http.StatusOK {
+				checkError(t, "GET "+tt.path, rec, tt.wantStatus)
+				return
+			}
+			if rec.Code != http.StatusOK {
+				t.Fatalf("GET %s status = %d, want %d", tt.path, rec.Code, http.StatusOK)
+			}
+			if got := decodeTodo(t, rec); got != created {
+				t.Errorf("GET %s = %+v, want %+v", tt.path, got, created)
+			}
+		})
+	}
+}
+
+func TestList(t *testing.T) {
+	h := newTestHandler()
+	for i := 1; i <= 25; i++ {
+		created := seed(t, h, fmt.Sprintf("t%02d", i))
+		if i%5 == 0 {
+			rec := do(h, http.MethodPatch, "/todos/"+created.ID, `{"done":true}`)
+			if rec.Code != http.StatusOK {
+				t.Fatalf("seed PATCH status = %d, want %d", rec.Code, http.StatusOK)
+			}
+		}
+	}
+
+	tests := []struct {
+		name      string
+		query     string
+		wantFirst string
+		wantLen   int
+	}{
+		{"default limit is 20", "", "t25", 20},
+		{"limit 3", "?limit=3", "t25", 3},
+		{"limit 1", "?limit=1", "t25", 1},
+		{"limit 100", "?limit=100", "t25", 25},
+		{"offset", "?offset=20", "t05", 5},
+		{"offset and limit", "?limit=2&offset=1", "t24", 2},
+		{"offset past end", "?offset=25", "", 0},
+		{"done true", "?done=true", "t25", 5},
+		{"done false", "?done=false&limit=100", "t24", 20},
+		{"done with paging", "?done=true&limit=2&offset=1", "t20", 2},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := do(h, http.MethodGet, "/todos"+tt.query, "")
+			if rec.Code != http.StatusOK {
+				t.Fatalf("GET /todos%s status = %d, want %d", tt.query, rec.Code, http.StatusOK)
+			}
+			if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+				t.Errorf("GET /todos%s Content-Type = %q, want application/json", tt.query, ct)
+			}
+			got := decodeList(t, rec)
+			if len(got) != tt.wantLen {
+				t.Fatalf("GET /todos%s returned %d items, want %d", tt.query, len(got), tt.wantLen)
+			}
+			if tt.wantLen > 0 && got[0].Title != tt.wantFirst {
+				t.Errorf("GET /todos%s first = %q, want %q", tt.query, got[0].Title, tt.wantFirst)
+			}
+		})
+	}
+
+	t.Run("newest first and filtered", func(t *testing.T) {
+		got := decodeList(t, do(h, http.MethodGet, "/todos?done=true", ""))
+		var titles []string
+		for _, td := range got {
+			titles = append(titles, td.Title)
+		}
+		want := []string{"t25", "t20", "t15", "t10", "t05"}
+		if !slices.Equal(titles, want) {
+			t.Errorf("GET /todos?done=true = %v, want %v", titles, want)
+		}
+	})
+
+	t.Run("empty list is an array", func(t *testing.T) {
+		rec := do(newTestHandler(), http.MethodGet, "/todos", "")
+		if rec.Code != http.StatusOK || strings.TrimSpace(rec.Body.String()) != "[]" {
+			t.Errorf("GET /todos on empty store = %d %q, want 200 []", rec.Code, rec.Body.String())
+		}
+	})
+
+	bad := []struct {
+		name  string
+		query string
+	}{
+		{"limit zero", "?limit=0"},
+		{"limit negative", "?limit=-1"},
+		{"limit over max", "?limit=101"},
+		{"limit not a number", "?limit=abc"},
+		{"limit empty", "?limit="},
+		{"offset negative", "?offset=-1"},
+		{"offset not a number", "?offset=x"},
+		{"offset empty", "?offset="},
+		{"done invalid", "?done=maybe"},
+		{"done numeric", "?done=1"},
+		{"done empty", "?done="},
+	}
+	for _, tt := range bad {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := do(h, http.MethodGet, "/todos"+tt.query, "")
+			checkError(t, "GET /todos"+tt.query, rec, http.StatusBadRequest)
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name       string
+		body       string
+		wantStatus int
+		wantTitle  string
+		wantDone   bool
+	}{
+		{"title", `{"title":" new "}`, http.StatusOK, "new", false},
+		{"done true", `{"done":true}`, http.StatusOK, "old", true},
+		{"done false", `{"done":false}`, http.StatusOK, "old", false},
+		{"both", `{"title":"new","done":true}`, http.StatusOK, "new", true},
+		{"empty object", `{}`, http.StatusBadRequest, "old", false},
+		{"nulls only", `{"title":null,"done":null}`, http.StatusBadRequest, "old", false},
+		{"empty title", `{"title":""}`, http.StatusBadRequest, "old", false},
+		{"long title", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, "old", false},
+		{"bad title keeps done", `{"title":" ","done":true}`, http.StatusBadRequest, "old", false},
+		{"done wrong type", `{"done":"yes"}`, http.StatusBadRequest, "old", false},
+		{"unknown field", `{"id":"x"}`, http.StatusBadRequest, "old", false},
+		{"not json", `{`, http.StatusBadRequest, "old", false},
+		{"empty body", ``, http.StatusBadRequest, "old", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := newTestHandler()
+			created := seed(t, h, "old")
+			path := "/todos/" + created.ID
+			rec := do(h, http.MethodPatch, path, tt.body)
+			if tt.wantStatus != http.StatusOK {
+				checkError(t, "PATCH "+path, rec, tt.wantStatus)
+			} else {
+				if rec.Code != http.StatusOK {
+					t.Fatalf("PATCH %s status = %d, want %d", path, rec.Code, http.StatusOK)
+				}
+				if got := decodeTodo(t, rec); got.Title != tt.wantTitle || got.Done != tt.wantDone || got.ID != created.ID {
+					t.Errorf("PATCH %s = %+v, want title %q done %v", path, got, tt.wantTitle, tt.wantDone)
+				}
+			}
+			stored := decodeTodo(t, do(h, http.MethodGet, path, ""))
+			if stored.Title != tt.wantTitle || stored.Done != tt.wantDone {
+				t.Errorf("GET %s after PATCH = %q done %v, want %q done %v", path, stored.Title, stored.Done, tt.wantTitle, tt.wantDone)
+			}
+		})
+	}
+
+	t.Run("unknown id", func(t *testing.T) {
+		rec := do(newTestHandler(), http.MethodPatch, "/todos/nope", `{"done":true}`)
+		checkError(t, "PATCH /todos/nope", rec, http.StatusNotFound)
+	})
+}
+
+func TestDelete(t *testing.T) {
+	h := newTestHandler()
+	created := seed(t, h, "gone")
+	path := "/todos/" + created.ID
+
+	tests := []struct {
+		name       string
+		path       string
+		wantStatus int
+	}{
+		{"existing", path, http.StatusNoContent},
+		{"already deleted", path, http.StatusNotFound},
+		{"unknown id", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := do(h, http.MethodDelete, tt.path, "")
+			if tt.wantStatus == http.StatusNoContent {
+				if rec.Code != tt.wantStatus || rec.Body.Len() != 0 {
+					t.Errorf("DELETE %s = %d %q, want %d with empty body", tt.path, rec.Code, rec.Body.String(), tt.wantStatus)
+				}
+				return
+			}
+			checkError(t, "DELETE "+tt.path, rec, tt.wantStatus)
+		})
+	}
+
+	if rec := do(h, http.MethodGet, path, ""); rec.Code != http.StatusNotFound {
+		t.Errorf("GET %s after DELETE status = %d, want %d", path, rec.Code, http.StatusNotFound)
+	}
+}
+
+func TestUnroutable(t *testing.T) {
+	tests := []struct {
+		name       string
+		method     string
+		path       string
+		wantStatus int
+	}{
+		{"unknown path", http.MethodGet, "/nope", http.StatusNotFound},
+		{"root", http.MethodGet, "/", http.StatusNotFound},
+		{"nested path", http.MethodGet, "/todos/a/b", http.StatusNotFound},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rec := do(newTestHandler(), tt.method, tt.path, "")
+			checkError(t, tt.method+" "+tt.path, rec, tt.wantStatus)
+		})
+	}
+}
