diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..95e656f
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,134 @@
+// Command loga summarises nginx access logs.
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+const (
+	exitFailure = 1
+	exitUsage   = 2
+)
+
+// usageError marks a problem with the command line, which exits with 2.
+type usageError struct{ err error }
+
+func (e usageError) Error() string { return e.err.Error() }
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	err := run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	if err == nil {
+		return
+	}
+	var ue usageError
+	if errors.As(err, &ue) {
+		// The flag set already printed its own message.
+		os.Exit(exitUsage)
+	}
+	fmt.Fprintln(os.Stderr, "loga:", err)
+	os.Exit(exitFailure)
+}
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of top paths to list")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: loga [-top N] [-json] [file ...]")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return usageError{err}
+	}
+	if *top < 1 {
+		err := fmt.Errorf("-top must be at least 1, got %d", *top)
+		fmt.Fprintln(stderr, "loga:", err)
+		return usageError{err}
+	}
+
+	col := stats.NewCollector()
+	add := func(e logparse.Entry) {
+		col.Add(stats.Observation{Path: e.Path, Status: e.Status, Millis: e.Millis, Time: e.Time})
+	}
+
+	malformed := 0
+	if fs.NArg() == 0 {
+		n, err := logparse.Scan(stdin, add)
+		if err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+		malformed += n
+	}
+	for _, name := range fs.Args() {
+		n, err := scanFile(name, add)
+		if err != nil {
+			return err
+		}
+		malformed += n
+	}
+
+	report := col.Report(*top, malformed)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(report); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+		return nil
+	}
+	return writeText(stdout, report)
+}
+
+func scanFile(name string, fn func(logparse.Entry)) (int, error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return 0, fmt.Errorf("open log: %w", err)
+	}
+	defer f.Close()
+	n, err := logparse.Scan(f, fn)
+	if err != nil {
+		return n, fmt.Errorf("%s: %w", name, err)
+	}
+	return n, nil
+}
+
+func writeText(w io.Writer, r stats.Report) error {
+	var err error
+	p := func(format string, a ...any) {
+		if err == nil {
+			_, err = fmt.Fprintf(w, format, a...)
+		}
+	}
+	p("Total requests:  %d\n", r.TotalRequests)
+	p("Malformed lines: %d\n", r.MalformedLines)
+	p("\nTop paths\n")
+	for _, pc := range r.TopPaths {
+		p("  %8d  %s\n", pc.Count, pc.Path)
+	}
+	p("\nStatus classes\n")
+	p("  2xx  %d\n  3xx  %d\n  4xx  %d\n  5xx  %d\n",
+		r.StatusClasses.C2xx, r.StatusClasses.C3xx, r.StatusClasses.C4xx, r.StatusClasses.C5xx)
+	p("\nRequest time (ms)\n")
+	p("  p50  %.3f\n  p95  %.3f\n  p99  %.3f\n", r.LatencyMs.P50, r.LatencyMs.P95, r.LatencyMs.P99)
+	p("\n5xx per hour (UTC)\n")
+	if len(r.Errors5xxHour) == 0 {
+		p("  none\n")
+	}
+	for _, h := range r.Errors5xxHour {
+		p("  %s  %d\n", h.Hour, h.Count)
+	}
+	return err
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..dd57f00
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,196 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const logFixture = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 200 512 "-" "curl/8.0" 0.010
+203.0.113.9 - - [10/Oct/2026:13:57:00 +0000] "GET /health HTTP/1.1" 500 10 "-" "curl/8.0" 0.100
+this line is garbage
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "GET /missing HTTP/1.1" 404 10 "-" "curl/8.0" 0.020
+`
+
+func writeLog(t *testing.T, content string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "access.log")
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+	return path
+}
+
+func TestRunText(t *testing.T) {
+	file := writeLog(t, logFixture)
+	tests := []struct {
+		name  string
+		args  []string
+		stdin string
+		want  []string
+		avoid []string
+	}{
+		{
+			name: "file argument",
+			args: []string{file},
+			want: []string{"Total requests:  4", "Malformed lines: 1", "/api/items", "2xx  2", "4xx  1", "5xx  1", "2026-10-10T13:00:00Z  1"},
+		},
+		{
+			name:  "stdin when no files",
+			args:  nil,
+			stdin: logFixture,
+			want:  []string{"Total requests:  4", "Malformed lines: 1"},
+		},
+		{
+			name:  "top limits paths",
+			args:  []string{"-top", "1"},
+			stdin: logFixture,
+			want:  []string{"/api/items"},
+			avoid: []string{"/health", "/missing"},
+		},
+		{
+			name: "same file twice adds up",
+			args: []string{file, file},
+			want: []string{"Total requests:  8", "Malformed lines: 2"},
+		},
+		{
+			name:  "empty input",
+			args:  nil,
+			stdin: "",
+			want:  []string{"Total requests:  0", "Malformed lines: 0", "none"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(tt.args, strings.NewReader(tt.stdin), &out, &errOut)
+			if err != nil {
+				t.Fatalf("run(%v) error = %v, want nil", tt.args, err)
+			}
+			for _, w := range tt.want {
+				if !strings.Contains(out.String(), w) {
+					t.Errorf("run(%v) output missing %q:\n%s", tt.args, w, out.String())
+				}
+			}
+			for _, a := range tt.avoid {
+				if strings.Contains(out.String(), a) {
+					t.Errorf("run(%v) output contains %q, want it absent:\n%s", tt.args, a, out.String())
+				}
+			}
+		})
+	}
+}
+
+func TestRunJSON(t *testing.T) {
+	tests := []struct {
+		name          string
+		stdin         string
+		wantTotal     int
+		wantMalformed int
+		wantTop       int
+		wantHours     int
+		want5xx       int
+	}{
+		{"fixture", logFixture, 4, 1, 3, 1, 1},
+		{"empty", "", 0, 0, 0, 0, 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			if err := run([]string{"-json"}, strings.NewReader(tt.stdin), &out, &errOut); err != nil {
+				t.Fatalf("run(-json) error = %v, want nil", err)
+			}
+			var got struct {
+				Total     int `json:"total_requests"`
+				Malformed int `json:"malformed_lines"`
+				Top       []struct {
+					Path  string `json:"path"`
+					Count int    `json:"count"`
+				} `json:"top_paths"`
+				Classes map[string]int     `json:"status_classes"`
+				Latency map[string]float64 `json:"latency_ms"`
+				Hours   []struct {
+					Hour  string `json:"hour"`
+					Count int    `json:"count"`
+				} `json:"errors_5xx_per_hour"`
+			}
+			if err := json.Unmarshal(out.Bytes(), &got); err != nil {
+				t.Fatalf("run(-json) output is not JSON: %v\n%s", err, out.String())
+			}
+			if got.Total != tt.wantTotal {
+				t.Errorf("run(-json) total_requests = %d, want %d", got.Total, tt.wantTotal)
+			}
+			if got.Malformed != tt.wantMalformed {
+				t.Errorf("run(-json) malformed_lines = %d, want %d", got.Malformed, tt.wantMalformed)
+			}
+			if len(got.Top) != tt.wantTop {
+				t.Errorf("run(-json) len(top_paths) = %d, want %d", len(got.Top), tt.wantTop)
+			}
+			if len(got.Hours) != tt.wantHours {
+				t.Errorf("run(-json) len(errors_5xx_per_hour) = %d, want %d", len(got.Hours), tt.wantHours)
+			}
+			if got.Classes["5xx"] != tt.want5xx {
+				t.Errorf("run(-json) status_classes[5xx] = %d, want %d", got.Classes["5xx"], tt.want5xx)
+			}
+			for _, k := range []string{"p50", "p95", "p99"} {
+				if _, ok := got.Latency[k]; !ok {
+					t.Errorf("run(-json) latency_ms missing %q: %v", k, got.Latency)
+				}
+			}
+		})
+	}
+}
+
+func TestRunErrors(t *testing.T) {
+	missing := filepath.Join(t.TempDir(), "nope.log")
+	good := writeLog(t, logFixture)
+	tests := []struct {
+		name      string
+		args      []string
+		wantUsage bool
+	}{
+		{"unknown flag", []string{"-bogus"}, true},
+		{"top not a number", []string{"-top", "abc"}, true},
+		{"top zero", []string{"-top", "0"}, true},
+		{"top negative", []string{"-top", "-3"}, true},
+		{"missing file", []string{missing}, false},
+		{"missing file after good one", []string{good, missing}, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(tt.args, strings.NewReader(""), &out, &errOut)
+			if err == nil {
+				t.Fatalf("run(%v) error = nil, want an error", tt.args)
+			}
+			var ue usageError
+			if got := errors.As(err, &ue); got != tt.wantUsage {
+				t.Errorf("run(%v) usage error = %v, want %v (err: %v)", tt.args, got, tt.wantUsage, err)
+			}
+			if out.Len() != 0 {
+				t.Errorf("run(%v) wrote to stdout on failure: %q", tt.args, out.String())
+			}
+			if tt.wantUsage && errOut.Len() == 0 {
+				t.Errorf("run(%v) printed nothing to stderr for a usage error", tt.args)
+			}
+			if !tt.wantUsage && !errors.Is(err, os.ErrNotExist) {
+				t.Errorf("run(%v) error = %v, want wrapping os.ErrNotExist", tt.args, err)
+			}
+		})
+	}
+}
+
+func TestRunHelp(t *testing.T) {
+	var out, errOut bytes.Buffer
+	if err := run([]string{"-h"}, strings.NewReader(""), &out, &errOut); err != nil {
+		t.Errorf("run(-h) error = %v, want nil", err)
+	}
+	if !strings.Contains(errOut.String(), "usage: loga") {
+		t.Errorf("run(-h) stderr = %q, want usage text", errOut.String())
+	}
+}
