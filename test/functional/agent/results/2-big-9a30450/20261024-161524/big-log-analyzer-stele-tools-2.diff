+package logparse
+
+import "errors"
+
+// ErrMalformed is returned by ParseLine for a line that is not a valid
+// access log entry.
+var ErrMalformed = errors.New("malformed log line")
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..0fc2393
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,181 @@
+// Package logparse parses nginx access logs in the combined format with the
+// request time appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// TimeLayout is the layout of the bracketed timestamp field.
+const TimeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// Entry is one parsed access log line.
+type Entry struct {
+	// Remote is the client address.
+	Remote string
+	// Time is the time the request was received.
+	Time time.Time
+	// Method is the HTTP method.
+	Method string
+	// Path is the request path with the query string removed.
+	Path string
+	// Status is the HTTP status code.
+	Status int
+	// Bytes is the response size, 0 when the log has "-".
+	Bytes int64
+	// Millis is the request time in milliseconds.
+	Millis float64
+}
+
+// ParseLine parses one log line. It returns an error wrapping ErrMalformed
+// when the line does not match the format.
+func ParseLine(line string) (Entry, error) {
+	fields, err := tokenize(line)
+	if err != nil {
+		return Entry{}, err
+	}
+	// remote ident user [time] "request" status bytes "referer" "agent" time
+	if len(fields) != 10 {
+		return Entry{}, fmt.Errorf("%w: want 10 fields, got %d", ErrMalformed, len(fields))
+	}
+
+	t, err := time.Parse(TimeLayout, fields[3])
+	if err != nil {
+		return Entry{}, fmt.Errorf("%w: bad time %q", ErrMalformed, fields[3])
+	}
+
+	req := strings.Fields(fields[4])
+	if len(req) < 2 {
+		return Entry{}, fmt.Errorf("%w: bad request %q", ErrMalformed, fields[4])
+	}
+	path := req[1]
+	if i := strings.IndexAny(path, "?#"); i >= 0 {
+		path = path[:i]
+	}
+	if path == "" {
+		return Entry{}, fmt.Errorf("%w: empty path in %q", ErrMalformed, fields[4])
+	}
+
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, fmt.Errorf("%w: bad status %q", ErrMalformed, fields[5])
+	}
+
+	var size int64
+	if fields[6] != "-" {
+		size, err = strconv.ParseInt(fields[6], 10, 64)
+		if err != nil || size < 0 {
+			return Entry{}, fmt.Errorf("%w: bad size %q", ErrMalformed, fields[6])
+		}
+	}
+
+	secs, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || secs < 0 || math.IsNaN(secs) || math.IsInf(secs, 0) {
+		return Entry{}, fmt.Errorf("%w: bad request time %q", ErrMalformed, fields[9])
+	}
+
+	return Entry{
+		Remote: fields[0],
+		Time:   t,
+		Method: req[0],
+		Path:   path,
+		Status: status,
+		Bytes:  size,
+		Millis: secs * 1000,
+	}, nil
+}
+
+// tokenize splits a line into space separated fields. A field may be wrapped
+// in [] or "" (with backslash escapes inside quotes); the wrapping is dropped.
+func tokenize(line string) ([]string, error) {
+	var fields []string
+	i := 0
+	for i < len(line) {
+		switch line[i] {
+		case ' ':
+			i++
+		case '[':
+			end := strings.IndexByte(line[i:], ']')
+			if end < 0 {
+				return nil, fmt.Errorf("%w: unterminated [", ErrMalformed)
+			}
+			fields = append(fields, line[i+1:i+end])
+			i += end + 1
+			if err := checkBoundary(line, i); err != nil {
+				return nil, err
+			}
+		case '"':
+			var b strings.Builder
+			j := i + 1
+			closed := false
+			for j < len(line) {
+				c := line[j]
+				if c == '\\' && j+1 < len(line) {
+					b.WriteByte(line[j+1])
+					j += 2
+					continue
+				}
+				if c == '"' {
+					closed = true
+					break
+				}
+				b.WriteByte(c)
+				j++
+			}
+			if !closed {
+				return nil, fmt.Errorf("%w: unterminated quote", ErrMalformed)
+			}
+			fields = append(fields, b.String())
+			i = j + 1
+			if err := checkBoundary(line, i); err != nil {
+				return nil, err
+			}
+		default:
+			j := i
+			for j < len(line) && line[j] != ' ' {
+				j++
+			}
+			fields = append(fields, line[i:j])
+			i = j
+		}
+	}
+	return fields, nil
+}
+
+func checkBoundary(line string, i int) error {
+	if i < len(line) && line[i] != ' ' {
+		return fmt.Errorf("%w: unexpected text after field", ErrMalformed)
+	}
+	return nil
+}
+
+// Scan reads r line by line and calls fn for every valid entry. Blank lines
+// are ignored. It returns the number of malformed lines, which are skipped,
+// and any error from reading r.
+func Scan(r io.Reader, fn func(Entry)) (malformed int, err error) {
+	br := bufio.NewReader(r)
+	for {
+		line, readErr := br.ReadString('\n')
+		if readErr != nil && !errors.Is(readErr, io.EOF) {
+			return malformed, fmt.Errorf("read log: %w", readErr)
+		}
+		line = strings.TrimRight(line, "\r\n")
+		if strings.TrimSpace(line) != "" {
+			if e, perr := ParseLine(line); perr != nil {
+				malformed++
+			} else {
+				fn(e)
+			}
+		}
+		if readErr != nil {
+			return malformed, nil
+		}
+	}
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..d61504a
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,181 @@
+package logparse
+
+import (
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"testing/iotest"
+	"time"
+)
+
+const goodLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParseLine(t *testing.T) {
+	tests := []struct {
+		name       string
+		line       string
+		wantPath   string
+		wantStatus int
+		wantBytes  int64
+		wantMillis float64
+		wantMethod string
+	}{
+		{"query removed", goodLine, "/api/items", 200, 512, 42, "GET"},
+		{"no query", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "POST /a HTTP/1.1" 404 0 "-" "x" 1.5`, "/a", 404, 0, 1500, "POST"},
+		{"dash bytes", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 304 - "-" "x" 0.000`, "/", 304, 0, 0, "GET"},
+		{"user agent with spaces and quotes", `1.2.3.4 - bob [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "http://r/" "Mozilla/5.0 (X; \"q\") Gecko" 0.001`, "/x", 200, 1, 1, "GET"},
+		{"fragment removed", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /p#frag HTTP/1.1" 200 1 "-" "x" 0.001`, "/p", 200, 1, 1, "GET"},
+		{"http/0.9 style request", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /old" 200 1 "-" "x" 0.001`, "/old", 200, 1, 1, "GET"},
+		{"5xx", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /e HTTP/1.1" 503 9 "-" "x" 2`, "/e", 503, 9, 2000, "GET"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			e, err := ParseLine(tt.line)
+			if err != nil {
+				t.Fatalf("ParseLine(%q) error = %v, want nil", tt.line, err)
+			}
+			if e.Path != tt.wantPath {
+				t.Errorf("ParseLine(%q).Path = %q, want %q", tt.line, e.Path, tt.wantPath)
+			}
+			if e.Status != tt.wantStatus {
+				t.Errorf("ParseLine(%q).Status = %d, want %d", tt.line, e.Status, tt.wantStatus)
+			}
+			if e.Bytes != tt.wantBytes {
+				t.Errorf("ParseLine(%q).Bytes = %d, want %d", tt.line, e.Bytes, tt.wantBytes)
+			}
+			if e.Method != tt.wantMethod {
+				t.Errorf("ParseLine(%q).Method = %q, want %q", tt.line, e.Method, tt.wantMethod)
+			}
+			if diff := e.Millis - tt.wantMillis; diff > 1e-9 || diff < -1e-9 {
+				t.Errorf("ParseLine(%q).Millis = %v, want %v", tt.line, e.Millis, tt.wantMillis)
+			}
+		})
+	}
+}
+
+func TestParseLineTimeAndRemote(t *testing.T) {
+	tests := []struct {
+		name       string
+		line       string
+		wantTime   time.Time
+		wantRemote string
+	}{
+		{"utc", goodLine, time.Date(2026, time.October, 10, 13, 55, 36, 0, time.UTC), "203.0.113.9"},
+		{"positive offset", `2001:db8::1 - - [10/Oct/2026:13:55:36 +0200] "GET / HTTP/1.1" 200 1 "-" "x" 0.001`, time.Date(2026, time.October, 10, 11, 55, 36, 0, time.UTC), "2001:db8::1"},
+		{"negative offset", `1.2.3.4 - - [10/Oct/2026:23:30:00 -0500] "GET / HTTP/1.1" 200 1 "-" "x" 0.001`, time.Date(2026, time.October, 11, 4, 30, 0, 0, time.UTC), "1.2.3.4"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			e, err := ParseLine(tt.line)
+			if err != nil {
+				t.Fatalf("ParseLine(%q) error = %v, want nil", tt.line, err)
+			}
+			if !e.Time.Equal(tt.wantTime) {
+				t.Errorf("ParseLine(%q).Time = %v, want %v", tt.line, e.Time.UTC(), tt.wantTime)
+			}
+			if e.Remote != tt.wantRemote {
+				t.Errorf("ParseLine(%q).Remote = %q, want %q", tt.line, e.Remote, tt.wantRemote)
+			}
+		})
+	}
+}
+
+func TestParseLineMalformed(t *testing.T) {
+	tests := []struct {
+		name string
+		line string
+	}{
+		{"empty", ""},
+		{"garbage", "not a log line"},
+		{"missing request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "x"`},
+		{"extra field", goodLine + " extra"},
+		{"plain combined without time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "x" "y" 0.1`},
+		{"bad timestamp", `1.2.3.4 - - [yesterday] "GET / HTTP/1.1" 200 1 "-" "x" 0.001`},
+		{"unterminated bracket", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 1 "-" "x" 0.001`},
+		{"unterminated quote", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 200 1 "-" "x" 0.001`},
+		{"text glued to quote", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1"x 200 1 "-" "x" 0.001`},
+		{"empty request", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "" 400 1 "-" "x" 0.001`},
+		{"dash request", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "-" 400 1 "-" "x" 0.001`},
+		{"method only", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET" 400 1 "-" "x" 0.001`},
+		{"query only path", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET ?a=1 HTTP/1.1" 200 1 "-" "x" 0.001`},
+		{"non numeric status", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" OK 1 "-" "x" 0.001`},
+		{"status too low", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 99 1 "-" "x" 0.001`},
+		{"status too high", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 600 1 "-" "x" 0.001`},
+		{"bad size", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 big "-" "x" 0.001`},
+		{"negative size", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 -5 "-" "x" 0.001`},
+		{"bad request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "x" fast`},
+		{"dash request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "x" -`},
+		{"negative request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "x" -0.5`},
+		{"NaN request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "x" NaN`},
+		{"infinite request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "x" Inf`},
+		{"binary junk", "\x00\x01\x02\xff"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := ParseLine(tt.line)
+			if !errors.Is(err, ErrMalformed) {
+				t.Errorf("ParseLine(%q) error = %v, want ErrMalformed", tt.line, err)
+			}
+		})
+	}
+}
+
+func TestScan(t *testing.T) {
+	bad := "garbage"
+	tests := []struct {
+		name          string
+		input         string
+		wantEntries   int
+		wantMalformed int
+	}{
+		{"empty input", "", 0, 0},
+		{"only blank lines", "\n\n  \n", 0, 0},
+		{"single request", goodLine + "\n", 1, 0},
+		{"no trailing newline", goodLine, 1, 0},
+		{"crlf line endings", goodLine + "\r\n" + goodLine + "\r\n", 2, 0},
+		{"malformed skipped", goodLine + "\n" + bad + "\n" + goodLine + "\n", 2, 1},
+		{"only malformed", bad + "\n" + bad, 0, 2},
+		{"blank lines not counted", goodLine + "\n\n" + bad + "\n", 1, 1},
+		{"very long line", strings.Repeat("a", 1<<20) + "\n" + goodLine + "\n", 1, 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var got int
+			malformed, err := Scan(strings.NewReader(tt.input), func(Entry) { got++ })
+			if err != nil {
+				t.Fatalf("Scan(%q) error = %v, want nil", tt.name, err)
+			}
+			if got != tt.wantEntries {
+				t.Errorf("Scan(%q) entries = %d, want %d", tt.name, got, tt.wantEntries)
+			}
+			if malformed != tt.wantMalformed {
+				t.Errorf("Scan(%q) malformed = %d, want %d", tt.name, malformed, tt.wantMalformed)
+			}
+		})
+	}
+}
+
+func TestScanReadError(t *testing.T) {
+	boom := errors.New("boom")
+	tests := []struct {
+		name        string
+		r           io.Reader
+		wantEntries int
+	}{
+		{"error after data", io.MultiReader(strings.NewReader(goodLine+"\n"), iotest.ErrReader(boom)), 1},
+		{"error immediately", iotest.ErrReader(boom), 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var got int
+			_, err := Scan(tt.r, func(Entry) { got++ })
+			if !errors.Is(err, boom) {
+				t.Errorf("Scan(%s) error = %v, want wrapping %v", tt.name, err, boom)
+			}
+			if got != tt.wantEntries {
+				t.Errorf("Scan(%s) entries = %d, want %d", tt.name, got, tt.wantEntries)
+			}
+		})
+	}
+}
