+package stats
+
+import "errors"
+
+// ErrNoData is returned when a statistic is requested over no samples.
+var ErrNoData = errors.New("no data")
+
+// ErrBadPercentile is returned for a percentile outside 0..100.
+var ErrBadPercentile = errors.New("percentile out of range")
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..7b146fa
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,156 @@
+// Package stats aggregates request observations into a report.
+package stats
+
+import (
+	"fmt"
+	"math"
+	"slices"
+	"sort"
+	"time"
+)
+
+// Observation is one request, as the collector sees it.
+type Observation struct {
+	// Path is the request path without query string.
+	Path string
+	// Status is the HTTP status code.
+	Status int
+	// Millis is the request time in milliseconds.
+	Millis float64
+	// Time is when the request happened.
+	Time time.Time
+}
+
+// PathCount is a request path and how many times it was requested.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// StatusClasses counts requests per status class.
+type StatusClasses struct {
+	C2xx int `json:"2xx"`
+	C3xx int `json:"3xx"`
+	C4xx int `json:"4xx"`
+	C5xx int `json:"5xx"`
+}
+
+// Latency holds request time percentiles in milliseconds.
+type Latency struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// HourCount is the number of 5xx responses in one hour (UTC).
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// Report is the summary of all observations.
+type Report struct {
+	TotalRequests  int           `json:"total_requests"`
+	MalformedLines int           `json:"malformed_lines"`
+	TopPaths       []PathCount   `json:"top_paths"`
+	StatusClasses  StatusClasses `json:"status_classes"`
+	LatencyMs      Latency       `json:"latency_ms"`
+	Errors5xxHour  []HourCount   `json:"errors_5xx_per_hour"`
+}
+
+// HourLayout is the format of HourCount.Hour.
+const HourLayout = "2006-01-02T15:00:00Z"
+
+// Collector accumulates observations. The zero value is not usable; call
+// NewCollector.
+type Collector struct {
+	total   int
+	paths   map[string]int
+	classes StatusClasses
+	millis  []float64
+	hours   map[string]int
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{paths: map[string]int{}, hours: map[string]int{}}
+}
+
+// Add records one observation.
+func (c *Collector) Add(o Observation) {
+	c.total++
+	c.paths[o.Path]++
+	c.millis = append(c.millis, o.Millis)
+	switch {
+	case o.Status >= 200 && o.Status < 300:
+		c.classes.C2xx++
+	case o.Status >= 300 && o.Status < 400:
+		c.classes.C3xx++
+	case o.Status >= 400 && o.Status < 500:
+		c.classes.C4xx++
+	case o.Status >= 500 && o.Status < 600:
+		c.classes.C5xx++
+		c.hours[o.Time.UTC().Format(HourLayout)]++
+	}
+}
+
+// Report builds the report with the top n paths. A malformed line count is
+// passed through. With n <= 0 no paths are listed.
+func (c *Collector) Report(top, malformed int) Report {
+	r := Report{
+		TotalRequests:  c.total,
+		MalformedLines: malformed,
+		TopPaths:       topPaths(c.paths, top),
+		StatusClasses:  c.classes,
+		Errors5xxHour:  make([]HourCount, 0, len(c.hours)),
+	}
+	sorted := slices.Clone(c.millis)
+	slices.Sort(sorted)
+	// Percentile only fails for empty input or a bad p; the zero value
+	// is the right report for no data.
+	r.LatencyMs.P50, _ = Percentile(sorted, 50)
+	r.LatencyMs.P95, _ = Percentile(sorted, 95)
+	r.LatencyMs.P99, _ = Percentile(sorted, 99)
+	for h, n := range c.hours {
+		r.Errors5xxHour = append(r.Errors5xxHour, HourCount{Hour: h, Count: n})
+	}
+	// The layout sorts lexically in time order.
+	sort.Slice(r.Errors5xxHour, func(i, j int) bool { return r.Errors5xxHour[i].Hour < r.Errors5xxHour[j].Hour })
+	return r
+}
+
+func topPaths(counts map[string]int, n int) []PathCount {
+	out := make([]PathCount, 0, len(counts))
+	for p, k := range counts {
+		out = append(out, PathCount{Path: p, Count: k})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Count != out[j].Count {
+			return out[i].Count > out[j].Count
+		}
+		return out[i].Path < out[j].Path
+	})
+	if n < 0 {
+		n = 0
+	}
+	if len(out) > n {
+		out = out[:n]
+	}
+	return out
+}
+
+// Percentile returns the p-th percentile (0..100) of sorted using the
+// nearest-rank method. sorted must be in ascending order.
+func Percentile(sorted []float64, p float64) (float64, error) {
+	if math.IsNaN(p) || p < 0 || p > 100 {
+		return 0, fmt.Errorf("percentile %v: %w", p, ErrBadPercentile)
+	}
+	if len(sorted) == 0 {
+		return 0, fmt.Errorf("percentile %v: %w", p, ErrNoData)
+	}
+	rank := int(math.Ceil(p / 100 * float64(len(sorted))))
+	if rank < 1 {
+		rank = 1
+	}
+	return sorted[rank-1], nil
+}
