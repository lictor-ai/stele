@@ -0,0 +1,329 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var testTime = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newTestStore() *Store {
+	return NewStore(clock.Fixed{T: testTime})
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name    string
+		title   string
+		want    string
+		wantErr error
+	}{
+		{"plain", "buy milk", "buy milk", nil},
+		{"trimmed", "  buy milk \n", "buy milk", nil},
+		{"one char", "a", "a", nil},
+		{"max length", strings.Repeat("a", 200), strings.Repeat("a", 200), nil},
+		{"max length multibyte", strings.Repeat("é", 200), strings.Repeat("é", 200), nil},
+		{"empty", "", "", ErrInvalidTitle},
+		{"blank", " \t ", "", ErrInvalidTitle},
+		{"too long", strings.Repeat("a", 201), "", ErrInvalidTitle},
+		{"too long multibyte", strings.Repeat("é", 201), "", ErrInvalidTitle},
+		{"max length padded", " " + strings.Repeat("a", 200) + " ", strings.Repeat("a", 200), nil},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			got, err := s.Create(context.Background(), tc.title)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.title, err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if got.Title != tc.want || got.Done || got.ID == "" {
+				t.Errorf("Create(%q) = %+v, want title %q, done false, non-empty id", tc.title, got, tc.want)
+			}
+			if !got.CreatedAt.Equal(testTime) || !got.UpdatedAt.Equal(testTime) {
+				t.Errorf("Create(%q) times = %v/%v, want %v", tc.title, got.CreatedAt, got.UpdatedAt, testTime)
+			}
+		})
+	}
+}
+
+func TestCanceledContext(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	s := newTestStore()
+	tests := []struct {
+		name string
+		call func() error
+	}{
+		{"Create", func() error { _, err := s.Create(ctx, "x"); return err }},
+		{"Get", func() error { _, err := s.Get(ctx, "x"); return err }},
+		{"Update", func() error { _, err := s.Update(ctx, "x", nil, nil); return err }},
+		{"Delete", func() error { return s.Delete(ctx, "x") }},
+		{"List", func() error { _, err := s.List(ctx, ListOptions{}); return err }},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := tc.call(); !errors.Is(err, context.Canceled) {
+				t.Errorf("%s(canceled ctx) error = %v, want %v", tc.name, err, context.Canceled)
+			}
+		})
+	}
+}
+
+func TestGet(t *testing.T) {
+	s := newTestStore()
+	created, err := s.Create(context.Background(), "x")
+	if err != nil {
+		t.Fatalf("Create: %v", err)
+	}
+	tests := []struct {
+		name    string
+		id      string
+		wantErr error
+	}{
+		{"existing", created.ID, nil},
+		{"missing", "nope", ErrNotFound},
+		{"empty id", "", ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.Get(context.Background(), tc.id)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Get(%q) error = %v, want %v", tc.id, err, tc.wantErr)
+			}
+			if err == nil && got != created {
+				t.Errorf("Get(%q) = %+v, want %+v", tc.id, got, created)
+			}
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	str := func(s string) *string { return &s }
+	flag := func(b bool) *bool { return &b }
+	tests := []struct {
+		name      string
+		id        string // empty means the created todo
+		title     *string
+		done      *bool
+		wantTitle string
+		wantDone  bool
+		wantErr   error
+	}{
+		{"title only", "", str("  new "), nil, "new", false, nil},
+		{"done only", "", nil, flag(true), "old", true, nil},
+		{"both", "", str("new"), flag(true), "new", true, nil},
+		{"neither", "", nil, nil, "old", false, nil},
+		{"empty title", "", str(" "), nil, "", false, ErrInvalidTitle},
+		{"long title", "", str(strings.Repeat("a", 201)), nil, "", false, ErrInvalidTitle},
+		{"missing", "nope", str("new"), nil, "", false, ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			later := time.Date(2026, 6, 1, 0, 0, 0, 0, time.UTC)
+			s := newTestStore()
+			created, err := s.Create(context.Background(), "old")
+			if err != nil {
+				t.Fatalf("Create: %v", err)
+			}
+			s.clock = clock.Fixed{T: later}
+			id := tc.id
+			if id == "" {
+				id = created.ID
+			}
+			got, err := s.Update(context.Background(), id, tc.title, tc.done)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Update(%q) error = %v, want %v", id, err, tc.wantErr)
+			}
+			if err != nil {
+				stored, _ := s.Get(context.Background(), created.ID)
+				if stored != created {
+					t.Errorf("Update(%q) failed but changed todo: %+v, want %+v", id, stored, created)
+				}
+				return
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%q) = title %q done %v, want title %q done %v", id, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			if !got.CreatedAt.Equal(testTime) || !got.UpdatedAt.Equal(later) {
+				t.Errorf("Update(%q) times = %v/%v, want %v/%v", id, got.CreatedAt, got.UpdatedAt, testTime, later)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	s := newTestStore()
+	created, err := s.Create(context.Background(), "x")
+	if err != nil {
+		t.Fatalf("Create: %v", err)
+	}
+	tests := []struct {
+		name    string
+		id      string
+		wantErr error
+	}{
+		{"existing", created.ID, nil},
+		{"again", created.ID, ErrNotFound},
+		{"missing", "nope", ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := s.Delete(context.Background(), tc.id); !errors.Is(err, tc.wantErr) {
+				t.Errorf("Delete(%q) error = %v, want %v", tc.id, err, tc.wantErr)
+			}
+		})
+	}
+	if _, err := s.Get(context.Background(), created.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get after Delete error = %v, want %v", err, ErrNotFound)
+	}
+}
+
+func TestList(t *testing.T) {
+	ctx := context.Background()
+	s := newTestStore()
+	// Titles t0..t4 are created in order; t1 and t3 are done.
+	for i, title := range []string{"t0", "t1", "t2", "t3", "t4"} {
+		item, err := s.Create(ctx, title)
+		if err != nil {
+			t.Fatalf("Create(%q): %v", title, err)
+		}
+		if i%2 == 1 {
+			done := true
+			if _, err := s.Update(ctx, item.ID, nil, &done); err != nil {
+				t.Fatalf("Update(%q): %v", title, err)
+			}
+		}
+	}
+	yes, no := true, false
+	tests := []struct {
+		name string
+		opts ListOptions
+		want []string
+	}{
+		{"all newest first", ListOptions{}, []string{"t4", "t3", "t2", "t1", "t0"}},
+		{"done", ListOptions{Done: &yes}, []string{"t3", "t1"}},
+		{"not done", ListOptions{Done: &no}, []string{"t4", "t2", "t0"}},
+		{"limit", ListOptions{Limit: 2}, []string{"t4", "t3"}},
+		{"offset", ListOptions{Offset: 3}, []string{"t1", "t0"}},
+		{"limit and offset", ListOptions{Limit: 2, Offset: 1}, []string{"t3", "t2"}},
+		{"filter limit offset", ListOptions{Done: &no, Limit: 1, Offset: 1}, []string{"t2"}},
+		{"offset past end", ListOptions{Offset: 9}, []string{}},
+		{"limit past end", ListOptions{Limit: 50, Offset: 4}, []string{"t0"}},
+		{"negative offset", ListOptions{Offset: -3, Limit: 1}, []string{"t4"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.List(ctx, tc.opts)
+			if err != nil {
+				t.Fatalf("List(%+v) error = %v", tc.opts, err)
+			}
+			if got == nil {
+				t.Errorf("List(%+v) = nil, want non-nil slice", tc.opts)
+			}
+			titles := []string{}
+			for _, item := range got {
+				titles = append(titles, item.Title)
+			}
+			if !slices.Equal(titles, tc.want) {
+				t.Errorf("List(%+v) = %v, want %v", tc.opts, titles, tc.want)
+			}
+		})
+	}
+}
+
+func TestListEmpty(t *testing.T) {
+	got, err := newTestStore().List(context.Background(), ListOptions{})
+	if err != nil || got == nil || len(got) != 0 {
+		t.Errorf("List on empty store = %v, %v, want empty non-nil slice and nil error", got, err)
+	}
+}
+
+func TestListReturnsCopies(t *testing.T) {
+	ctx := context.Background()
+	s := newTestStore()
+	created, err := s.Create(ctx, "x")
+	if err != nil {
+		t.Fatalf("Create: %v", err)
+	}
+	items, _ := s.List(ctx, ListOptions{})
+	items[0].Title = "changed"
+	got, _ := s.Get(ctx, created.ID)
+	if got.Title != "x" {
+		t.Errorf("Get after mutating List result = %q, want %q", got.Title, "x")
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	ctx := context.Background()
+	const workers, perWorker = 16, 50
+
+	tests := []struct {
+		name       string
+		deleteEach int // delete every Nth created todo; 0 deletes none
+	}{
+		{"keep all", 0},
+		{"delete some", 2},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			var wg sync.WaitGroup
+			for range workers {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					for i := range perWorker {
+						item, err := s.Create(ctx, "x")
+						if err != nil {
+							t.Errorf("Create: %v", err)
+							return
+						}
+						done := true
+						if _, err := s.Update(ctx, item.ID, nil, &done); err != nil {
+							t.Errorf("Update(%q) error = %v, want nil", item.ID, err)
+						}
+						if _, err := s.Get(ctx, item.ID); err != nil {
+							t.Errorf("Get(%q) error = %v, want nil", item.ID, err)
+						}
+						if _, err := s.List(ctx, ListOptions{Limit: 10}); err != nil {
+							t.Errorf("List error = %v, want nil", err)
+						}
+						if tc.deleteEach > 0 && i%tc.deleteEach == 0 {
+							if err := s.Delete(ctx, item.ID); err != nil {
+								t.Errorf("Delete(%q) error = %v, want nil", item.ID, err)
+							}
+						}
+					}
+				}()
+			}
+			wg.Wait()
+
+			wantCount := workers * perWorker
+			if tc.deleteEach > 0 {
+				wantCount = workers * (perWorker / tc.deleteEach)
+			}
+			all, err := s.List(ctx, ListOptions{})
+			if err != nil {
+				t.Fatalf("List error = %v, want nil", err)
+			}
+			if len(all) != wantCount {
+				t.Errorf("List returned %d todos, want %d", len(all), wantCount)
+			}
