+package todo
+
+import "errors"
+
+// ErrNotFound is returned when no todo has the requested id.
+var ErrNotFound = errors.New("todo not found")
+
+// ErrInvalidTitle is returned when a title is empty or longer than MaxTitleLen
+// characters after trimming.
+var ErrInvalidTitle = errors.New("invalid title")
diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..f635325
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,171 @@
+// Package todo holds the Todo type and a concurrency-safe in-memory Store.
+package todo
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// MaxTitleLen is the longest allowed title, in characters.
+const MaxTitleLen = 200
+
+// Todo is a single item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// ListOptions selects which todos List returns. A nil Done matches all todos.
+// A Limit of zero or less returns everything from Offset on.
+type ListOptions struct {
+	Done   *bool
+	Limit  int
+	Offset int
+}
+
+// NormalizeTitle trims title and reports ErrInvalidTitle if the result is
+// empty or longer than MaxTitleLen characters.
+func NormalizeTitle(title string) (string, error) {
+	t := strings.TrimSpace(title)
+	if n := utf8.RuneCountInString(t); n < 1 || n > MaxTitleLen {
+		return "", ErrInvalidTitle
+	}
+	return t, nil
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards byID and order.
+	mu    sync.RWMutex
+	byID  map[string]*Todo
+	order []*Todo // oldest first
+}
+
+// NewStore returns an empty Store that reads time from c.
+func NewStore(c clock.Clock) *Store {
+	return &Store{clock: c, byID: make(map[string]*Todo)}
+}
+
+// Create adds a todo with the given title and returns a copy of it.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	t, err := NormalizeTitle(title)
+	if err != nil {
+		return Todo{}, err
+	}
+	now := s.clock.Now()
+	item := &Todo{ID: id.New(), Title: t, CreatedAt: now, UpdatedAt: now}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.byID[item.ID] = item
+	s.order = append(s.order, item)
+	return *item, nil
+}
+
+// Get returns a copy of the todo with the given id, or ErrNotFound.
+func (s *Store) Get(ctx context.Context, todoID string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	item, ok := s.byID[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return *item, nil
+}
+
+// Update changes the title and/or done flag; a nil argument leaves that field
+// as it is. It returns the updated copy, ErrNotFound or ErrInvalidTitle.
+func (s *Store) Update(ctx context.Context, todoID string, title *string, done *bool) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	var newTitle string
+	if title != nil {
+		t, err := NormalizeTitle(*title)
+		if err != nil {
+			return Todo{}, err
+		}
+		newTitle = t
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.byID[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		item.Title = newTitle
+	}
+	if done != nil {
+		item.Done = *done
+	}
+	item.UpdatedAt = s.clock.Now()
+	return *item, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(ctx context.Context, todoID string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.byID[todoID]
+	if !ok {
+		return ErrNotFound
+	}
+	delete(s.byID, todoID)
+	for i, o := range s.order {
+		if o == item {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns copies of the todos matching opts, newest first.
+func (s *Store) List(ctx context.Context, opts ListOptions) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	offset := max(opts.Offset, 0)
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	skipped := 0
+	for i := len(s.order) - 1; i >= 0; i-- {
+		item := s.order[i]
+		if opts.Done != nil && item.Done != *opts.Done {
+			continue
+		}
+		if skipped < offset {
+			skipped++
+			continue
+		}
+		if opts.Limit > 0 && len(out) >= opts.Limit {
+			break
+		}
+		out = append(out, *item)
+	}
+	return out, nil
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
