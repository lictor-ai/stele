+func TestDelete(t *testing.T) {
+	s := newStore()
+	c, _ := s.Create("a")
+	if err := s.Delete(c.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Get(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("err = %v", err)
+	}
+	if err := s.Delete(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestList(t *testing.T) {
+	s := newStore() // fixed clock: ordering must still be newest first
+	var ids []string
+	for i := 0; i < 5; i++ {
+		c, _ := s.Create(fmt.Sprint(i))
+		ids = append(ids, c.ID)
+	}
+	yes := true
+	s.Update(ids[1], nil, &yes)
+	s.Update(ids[3], nil, &yes)
+
+	titles := func(ts []Todo) string {
+		var out []string
+		for _, t := range ts {
+			out = append(out, t.Title)
+		}
+		return strings.Join(out, ",")
+	}
+	no := false
+	cases := []struct {
+		name  string
+		opts  ListOptions
+		want  string
+		total int
+	}{
+		{"all", ListOptions{Limit: -1}, "4,3,2,1,0", 5},
+		{"done", ListOptions{Done: &yes, Limit: -1}, "3,1", 2},
+		{"not done", ListOptions{Done: &no, Limit: -1}, "4,2,0", 3},
+		{"limit", ListOptions{Limit: 2}, "4,3", 5},
+		{"offset", ListOptions{Limit: 2, Offset: 2}, "2,1", 5},
+		{"tail", ListOptions{Limit: 10, Offset: 4}, "0", 5},
+		{"past end", ListOptions{Limit: 10, Offset: 9}, "", 5},
+		{"filter+page", ListOptions{Done: &no, Limit: 1, Offset: 1}, "2", 3},
+	}
+	for _, c := range cases {
+		got, total := s.List(c.opts)
+		if titles(got) != c.want || total != c.total {
+			t.Errorf("%s: got %q (total %d), want %q (total %d)", c.name, titles(got), total, c.want, c.total)
+		}
+	}
+}
+
+func TestConcurrent(t *testing.T) {
+	s := NewStore(nil)
+	const workers, per = 16, 50
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < per; i++ {
+				c, err := s.Create("x")
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				done := true
+				s.Update(c.ID, nil, &done)
+				s.Get(c.ID)
+				s.List(ListOptions{Limit: 10})
+				if i%2 == 0 {
+					s.Delete(c.ID)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	_, total := s.List(ListOptions{Limit: -1})
+	if want := workers * per / 2; total != want {
+		t.Fatalf("total = %d, want %d", total, want)
+	}
+}
