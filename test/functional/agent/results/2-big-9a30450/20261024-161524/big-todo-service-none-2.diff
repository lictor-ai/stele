diff --git a/cmd/server/main.go b/cmd/server/main.go
new file mode 100644
index 0000000..d4f308c
--- /dev/null
+++ b/cmd/server/main.go
@@ -0,0 +1,50 @@
+// Command server serves the TODO API.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"net/http"
+	"os"
+	"os/signal"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	addr := flag.String("addr", ":8080", "listen address")
+	flag.Parse()
+
+	srv := &http.Server{
+		Addr:              *addr,
+		Handler:           api.NewHandler(todo.NewStore(nil)),
+		ReadHeaderTimeout: 10 * time.Second,
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
+	defer stop()
+
+	errc := make(chan error, 1)
+	go func() { errc <- srv.ListenAndServe() }()
+	log.Info("listening", "addr", *addr)
+
+	select {
+	case err := <-errc:
+		log.Error("server", "err", err)
+		os.Exit(1)
+	case <-ctx.Done():
+	}
+	stop()
+
+	log.Info("shutting down")
+	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := srv.Shutdown(shutdownCtx); err != nil && !errors.Is(err, http.ErrServerClosed) {
+		log.Error("shutdown", "err", err)
+		os.Exit(1)
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..243988b
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,144 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strconv"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const (
+	defaultLimit = 20
+	maxLimit     = 100
+	maxBodyBytes = 1 << 20
+)
+
+// NewHandler returns the TODO API handler backed by store.
+func NewHandler(store *todo.Store) http.Handler {
+	h := &handler{store: store}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return mux
+}
+
+type handler struct {
+	store *todo.Store
+}
+
+func decode(w http.ResponseWriter, r *http.Request, v any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, maxBodyBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(v); err != nil || dec.More() {
+		Error(w, http.StatusBadRequest, "invalid JSON body")
+		return false
+	}
+	return true
+}
+
+func storeError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, todo.ErrNotFound):
+		Error(w, http.StatusNotFound, err.Error())
+	case errors.Is(err, todo.ErrInvalidTitle):
+		Error(w, http.StatusBadRequest, err.Error())
+	default:
+		log.Error("store", "err", err)
+		Error(w, http.StatusInternalServerError, "internal error")
+	}
+}
+
+func (h *handler) create(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		Title *string `json:"title"`
+	}
+	if !decode(w, r, &req) {
+		return
+	}
+	if req.Title == nil {
+		Error(w, http.StatusBadRequest, "title is required")
+		return
+	}
+	t, err := h.store.Create(*req.Title)
+	if err != nil {
+		storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusCreated, t)
+}
+
+func (h *handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.PathValue("id"))
+	if err != nil {
+		storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) update(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		Title *string `json:"title"`
+		Done  *bool   `json:"done"`
+	}
+	if !decode(w, r, &req) {
+		return
+	}
+	if req.Title == nil && req.Done == nil {
+		Error(w, http.StatusBadRequest, "title or done is required")
+		return
+	}
+	t, err := h.store.Update(r.PathValue("id"), req.Title, req.Done)
+	if err != nil {
+		storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) delete(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.PathValue("id")); err != nil {
+		storeError(w, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (h *handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	opts := todo.ListOptions{Limit: defaultLimit}
+	if v := q.Get("done"); v != "" {
+		if v != "true" && v != "false" {
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+		b := v == "true"
+		opts.Done = &b
+	}
+	if v := q.Get("limit"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 1 || n > maxLimit {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		opts.Limit = n
+	}
+	if v := q.Get("offset"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+			return
+		}
+		opts.Offset = n
+	}
+	items, total := h.store.List(opts)
+	w.Header().Set("X-Total-Count", strconv.Itoa(total))
+	JSON(w, http.StatusOK, items)
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..5b343cd
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,222 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/todo"
+)
+
+func do(t *testing.T, h http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	t.Helper()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+func decodeTodo(t *testing.T, rec *httptest.ResponseRecorder) todo.Todo {
+	t.Helper()
+	var td todo.Todo
+	if err := json.Unmarshal(rec.Body.Bytes(), &td); err != nil {
+		t.Fatalf("decode %q: %v", rec.Body.String(), err)
+	}
+	return td
+}
+
+func wantError(t *testing.T, rec *httptest.ResponseRecorder, status int) {
+	t.Helper()
+	if rec.Code != status {
+		t.Fatalf("status = %d, want %d (body %s)", rec.Code, status, rec.Body)
+	}
+	var e map[string]string
+	if err := json.Unmarshal(rec.Body.Bytes(), &e); err != nil || e["error"] == "" {
+		t.Fatalf("bad error body %q", rec.Body.String())
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("content-type = %q", ct)
+	}
+}
+
+func newHandler() http.Handler { return NewHandler(todo.NewStore(nil)) }
+
+func TestCreate(t *testing.T) {
+	h := newHandler()
+	rec := do(t, h, "POST", "/todos", `{"title":"  write tests "}`)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("status = %d", rec.Code)
+	}
+	td := decodeTodo(t, rec)
+	if td.ID == "" || td.Title != "write tests" || td.Done {
+		t.Fatalf("todo = %+v", td)
+	}
+	if !strings.Contains(rec.Body.String(), `"created_at"`) || !strings.Contains(rec.Body.String(), `"updated_at"`) {
+		t.Fatalf("body = %s", rec.Body)
+	}
+}
+
+func TestCreateErrors(t *testing.T) {
+	h := newHandler()
+	for name, body := range map[string]string{
+		"empty body":    ``,
+		"malformed":     `{`,
+		"missing title": `{}`,
+		"null title":    `{"title":null}`,
+		"empty title":   `{"title":""}`,
+		"blank title":   `{"title":"   "}`,
+		"too long":      `{"title":"` + strings.Repeat("a", 201) + `"}`,
+		"wrong type":    `{"title":5}`,
+		"unknown field": `{"title":"a","x":1}`,
+		"trailing data": `{"title":"a"}{"title":"b"}`,
+	} {
+		t.Run(name, func(t *testing.T) { wantError(t, do(t, h, "POST", "/todos", body), 400) })
+	}
+	if rec := do(t, h, "POST", "/todos", `{"title":"`+strings.Repeat("a", 200)+`"}`); rec.Code != 201 {
+		t.Fatalf("200 chars status = %d", rec.Code)
+	}
+}
+
+func TestGet(t *testing.T) {
+	h := newHandler()
+	created := decodeTodo(t, do(t, h, "POST", "/todos", `{"title":"a"}`))
+	rec := do(t, h, "GET", "/todos/"+created.ID, "")
+	if rec.Code != 200 {
+		t.Fatalf("status = %d", rec.Code)
+	}
+	if got := decodeTodo(t, rec); got.ID != created.ID || got.Title != "a" {
+		t.Fatalf("got %+v", got)
+	}
+	wantError(t, do(t, h, "GET", "/todos/missing", ""), 404)
+}
+
+func TestUpdate(t *testing.T) {
+	h := newHandler()
+	id := decodeTodo(t, do(t, h, "POST", "/todos", `{"title":"a"}`)).ID
+	path := "/todos/" + id
+
+	rec := do(t, h, "PATCH", path, `{"done":true}`)
+	if td := decodeTodo(t, rec); rec.Code != 200 || !td.Done || td.Title != "a" {
+		t.Fatalf("done: %d %+v", rec.Code, td)
+	}
+	rec = do(t, h, "PATCH", path, `{"title":" b "}`)
+	if td := decodeTodo(t, rec); rec.Code != 200 || !td.Done || td.Title != "b" {
+		t.Fatalf("title: %d %+v", rec.Code, td)
+	}
+	rec = do(t, h, "PATCH", path, `{"title":"c","done":false}`)
+	if td := decodeTodo(t, rec); rec.Code != 200 || td.Done || td.Title != "c" {
+		t.Fatalf("both: %d %+v", rec.Code, td)
+	}
+
+	for name, body := range map[string]string{
+		"empty object": `{}`,
+		"malformed":    `nope`,
+		"blank title":  `{"title":" "}`,
+		"long title":   `{"title":"` + strings.Repeat("a", 201) + `"}`,
+		"bad done":     `{"done":"yes"}`,
+	} {
+		t.Run(name, func(t *testing.T) { wantError(t, do(t, h, "PATCH", path, body), 400) })
+	}
+	if td := decodeTodo(t, do(t, h, "GET", path, "")); td.Title != "c" {
+		t.Fatalf("failed patches changed todo: %+v", td)
+	}
+	wantError(t, do(t, h, "PATCH", "/todos/missing", `{"done":true}`), 404)
+}
+
+func TestDelete(t *testing.T) {
+	h := newHandler()
+	id := decodeTodo(t, do(t, h, "POST", "/todos", `{"title":"a"}`)).ID
+	rec := do(t, h, "DELETE", "/todos/"+id, "")
+	if rec.Code != 204 || rec.Body.Len() != 0 {
+		t.Fatalf("status = %d body = %q", rec.Code, rec.Body)
+	}
+	wantError(t, do(t, h, "GET", "/todos/"+id, ""), 404)
+	wantError(t, do(t, h, "DELETE", "/todos/"+id, ""), 404)
+}
+
+func list(t *testing.T, h http.Handler, query string) []todo.Todo {
+	t.Helper()
+	rec := do(t, h, "GET", "/todos"+query, "")
+	if rec.Code != 200 {
+		t.Fatalf("GET /todos%s status = %d: %s", query, rec.Code, rec.Body)
+	}
+	var out []todo.Todo
+	if err := json.Unmarshal(rec.Body.Bytes(), &out); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func TestList(t *testing.T) {
+	h := newHandler()
+	if rec := do(t, h, "GET", "/todos", ""); strings.TrimSpace(rec.Body.String()) != "[]" {
+		t.Fatalf("empty list body = %q", rec.Body)
+	}
+	var ids []string
+	for _, title := range []string{"0", "1", "2", "3", "4"} {
+		ids = append(ids, decodeTodo(t, do(t, h, "POST", "/todos", `{"title":"`+title+`"}`)).ID)
+	}
+	do(t, h, "PATCH", "/todos/"+ids[1], `{"done":true}`)
+	do(t, h, "PATCH", "/todos/"+ids[3], `{"done":true}`)
+
+	titles := func(ts []todo.Todo) string {
+		var s []string
+		for _, t := range ts {
+			s = append(s, t.Title)
+		}
+		return strings.Join(s, ",")
+	}
+	for query, want := range map[string]string{
+		"":                             "4,3,2,1,0",
+		"?done=true":                   "3,1",
+		"?done=false":                  "4,2,0",
+		"?limit=2":                     "4,3",
+		"?limit=2&offset=2":            "2,1",
+		"?offset=4":                    "0",
+		"?offset=50":                   "",
+		"?done=false&limit=1&offset=1": "2",
+	} {
+		if got := titles(list(t, h, query)); got != want {
+			t.Errorf("query %q: got %q, want %q", query, got, want)
+		}
+	}
+	if rec := do(t, h, "GET", "/todos?limit=2", ""); rec.Header().Get("X-Total-Count") != "5" {
+		t.Errorf("X-Total-Count = %q", rec.Header().Get("X-Total-Count"))
+	}
+}
+
+func TestListDefaultAndMaxLimit(t *testing.T) {
+	h := newHandler()
+	for i := 0; i < 105; i++ {
+		do(t, h, "POST", "/todos", `{"title":"x"}`)
+	}
+	if n := len(list(t, h, "")); n != 20 {
+		t.Errorf("default limit gave %d", n)
+	}
+	if n := len(list(t, h, "?limit=100")); n != 100 {
+		t.Errorf("limit=100 gave %d", n)
+	}
+}
+
+func TestListErrors(t *testing.T) {
+	h := newHandler()
+	for _, q := range []string{
+		"?limit=0", "?limit=101", "?limit=-1", "?limit=abc",
+		"?offset=-1", "?offset=abc",
+		"?done=maybe", "?done=1", "?done=TRUE",
+	} {
+		t.Run(q, func(t *testing.T) { wantError(t, do(t, h, "GET", "/todos"+q, ""), 400) })
+	}
+}
+
+func TestUnroutedRequests(t *testing.T) {
+	h := newHandler()
+	if rec := do(t, h, "PUT", "/todos", ""); rec.Code != http.StatusMethodNotAllowed {
+		t.Errorf("PUT /todos = %d", rec.Code)
+	}
+	if rec := do(t, h, "GET", "/nothing", ""); rec.Code != http.StatusNotFound {
+		t.Errorf("GET /nothing = %d", rec.Code)
+	}
+}
diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..fc74cd8
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,155 @@
+// Package todo holds the Todo type and an in-memory store for it.
+package todo
+
+import (
+	"errors"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// MaxTitleLen is the maximum title length in characters.
+const MaxTitleLen = 200
+
+var (
+	// ErrNotFound is returned when a todo does not exist.
+	ErrNotFound = errors.New("todo not found")
+	// ErrInvalidTitle is returned when a title is empty or too long.
+	ErrInvalidTitle = errors.New("title must be 1 to 200 characters")
+)
+
+// Todo is a single task.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+
+	seq uint64 // creation order, breaks created_at ties
+}
+
+// NormalizeTitle trims title and checks its length.
+func NormalizeTitle(title string) (string, error) {
+	title = strings.TrimSpace(title)
+	if n := utf8.RuneCountInString(title); n < 1 || n > MaxTitleLen {
+		return "", ErrInvalidTitle
+	}
+	return title, nil
+}
+
+// Store is an in-memory Todo store safe for concurrent use.
+type Store struct {
+	mu    sync.RWMutex
+	clock clock.Clock
+	items map[string]*Todo
+	seq   uint64
+}
+
+// NewStore returns an empty store. A nil clock means the real clock.
+func NewStore(c clock.Clock) *Store {
+	if c == nil {
+		c = clock.Real{}
+	}
+	return &Store{clock: c, items: make(map[string]*Todo)}
+}
+
+// Create adds a todo with the given title.
+func (s *Store) Create(title string) (Todo, error) {
+	title, err := NormalizeTitle(title)
+	if err != nil {
+		return Todo{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.clock.Now()
+	s.seq++
+	t := &Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now, seq: s.seq}
+	s.items[t.ID] = t
+	return *t, nil
+}
+
+// Get returns the todo with the given id.
+func (s *Store) Get(id string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return *t, nil
+}
+
+// Update changes the title and/or done flag; nil fields are left alone.
+func (s *Store) Update(id string, title *string, done *bool) (Todo, error) {
+	var newTitle string
+	if title != nil {
+		var err error
+		if newTitle, err = NormalizeTitle(*title); err != nil {
+			return Todo{}, err
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		t.Title = newTitle
+	}
+	if done != nil {
+		t.Done = *done
+	}
+	t.UpdatedAt = s.clock.Now()
+	return *t, nil
+}
+
+// Delete removes the todo with the given id.
+func (s *Store) Delete(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, id)
+	return nil
+}
+
+// ListOptions controls List. A negative Limit means no limit.
+type ListOptions struct {
+	Done   *bool // filter on done when non-nil
+	Limit  int
+	Offset int
+}
+
+// List returns todos newest first, filtered and paginated, along with the
+// total number of matches before pagination.
+func (s *Store) List(o ListOptions) ([]Todo, int) {
+	s.mu.RLock()
+	matched := make([]Todo, 0, len(s.items))
+	for _, t := range s.items {
+		if o.Done == nil || t.Done == *o.Done {
+			matched = append(matched, *t)
+		}
+	}
+	s.mu.RUnlock()
+
+	sort.Slice(matched, func(i, j int) bool { return matched[i].seq > matched[j].seq })
+	total := len(matched)
+	if o.Offset > 0 {
+		if o.Offset >= total {
+			return []Todo{}, total
+		}
+		matched = matched[o.Offset:]
+	}
+	if o.Limit >= 0 && o.Limit < len(matched) {
+		matched = matched[:o.Limit]
+	}
+	return matched, total
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
new file mode 100644
index 0000000..88ea902
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,162 @@
+package todo
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var t0 = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newStore() *Store { return NewStore(clock.Fixed{T: t0}) }
+
+func TestCreateGet(t *testing.T) {
+	s := newStore()
+	c, err := s.Create("  buy milk  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.Title != "buy milk" || c.Done || c.ID == "" || !c.CreatedAt.Equal(t0) || !c.UpdatedAt.Equal(t0) {
+		t.Fatalf("unexpected todo %+v", c)
+	}
+	g, err := s.Get(c.ID)
+	if err != nil || g != c {
+		t.Fatalf("Get = %+v, %v", g, err)
+	}
+	if _, err := s.Get("nope"); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("err = %v", err)
+	}
+}
+
+func TestTitleValidation(t *testing.T) {
+	s := newStore()
+	for _, title := range []string{"", "   ", strings.Repeat("a", 201), strings.Repeat("é", 201)} {
+		if _, err := s.Create(title); !errors.Is(err, ErrInvalidTitle) {
+			t.Errorf("Create(%.10q) err = %v", title, err)
+		}
+	}
+	for _, title := range []string{"a", strings.Repeat("a", 200), strings.Repeat("é", 200), " " + strings.Repeat("a", 200) + " "} {
+		if _, err := s.Create(title); err != nil {
+			t.Errorf("Create(%.10q) err = %v", title, err)
+		}
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	later := t0.Add(time.Hour)
+	s := NewStore(clock.Fixed{T: t0})
+	c, _ := s.Create("a")
+	s.clock = clock.Fixed{T: later}
+
+	title, done := " b ", true
+	u, err := s.Update(c.ID, &title, nil)
+	if err != nil || u.Title != "b" || u.Done || !u.UpdatedAt.Equal(later) || !u.CreatedAt.Equal(t0) {
+		t.Fatalf("title update = %+v, %v", u, err)
+	}
+	u, err = s.Update(c.ID, nil, &done)
+	if err != nil || u.Title != "b" || !u.Done {
+		t.Fatalf("done update = %+v, %v", u, err)
+	}
+	bad := " "
+	if _, err := s.Update(c.ID, &bad, nil); !errors.Is(err, ErrInvalidTitle) {
+		t.Fatalf("err = %v", err)
+	}
+	if g, _ := s.Get(c.ID); g.Title != "b" {
+		t.Fatalf("title changed on failed update: %q", g.Title)
+	}
+	if _, err := s.Update("nope", &title, nil); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("err = %v", err)
+	}
+}
