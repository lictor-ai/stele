new file mode 100644
index 0000000..463f4fc
--- /dev/null
+++ b/cmd/server/main.go
@@ -0,0 +1,71 @@
+// Command server serves the to-do list JSON API.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+const shutdownTimeout = 10 * time.Second
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, "server:", err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("server", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	addr := fs.String("addr", ":8080", "address to listen on")
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	srv := &http.Server{
+		Addr:              *addr,
+		Handler:           api.NewHandler(todo.NewStore(clock.Real{})),
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       10 * time.Second,
+		WriteTimeout:      10 * time.Second,
+		IdleTimeout:       60 * time.Second,
+	}
+
+	errc := make(chan error, 1)
+	go func() { errc <- srv.ListenAndServe() }()
+	fmt.Fprintf(stdout, "listening on %s\n", *addr)
+
+	select {
+	case err := <-errc:
+		return fmt.Errorf("serve: %w", err)
+	case <-ctx.Done():
+	}
+	stop()
+
+	shutCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
+	defer cancel()
+	if err := srv.Shutdown(shutCtx); err != nil {
+		return fmt.Errorf("shutdown: %w", err)
+	}
+	if err := <-errc; !errors.Is(err, http.ErrServerClosed) {
+		return fmt.Errorf("serve: %w", err)
+	}
+	fmt.Fprintln(stdout, "stopped")
+	return nil
+}
diff --git a/internal/api/handler.go b/internal/api/handler.go
new file mode 100644
index 0000000..9c0aad4
--- /dev/null
+++ b/internal/api/handler.go
@@ -0,0 +1,174 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const (
+	maxBodyBytes   = 1 << 20
+	maxTitleChars  = 200
+	defaultLimit   = 20
+	maxLimit       = 100
+	msgInvalidBody = "request body must be a JSON object with known fields"
+	msgBadTitle    = "title must be 1 to 200 characters"
+)
+
+type server struct {
+	store *todo.Store
+}
+
+// NewHandler returns the HTTP handler for the todo API, backed by store.
+func NewHandler(store *todo.Store) http.Handler {
+	s := &server{store: store}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", s.create)
+	mux.HandleFunc("GET /todos", s.list)
+	mux.HandleFunc("GET /todos/{id}", s.get)
+	mux.HandleFunc("PATCH /todos/{id}", s.update)
+	mux.HandleFunc("DELETE /todos/{id}", s.delete)
+	return mux
+}
+
+type createRequest struct {
+	Title string `json:"title"`
+}
+
+type updateRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+// decode reads a single JSON object from the body into v, limiting its size
+// and rejecting unknown fields.
+func decode(w http.ResponseWriter, r *http.Request, v any) error {
+	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, maxBodyBytes))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(v); err != nil {
+		return fmt.Errorf("decode body: %w", err)
+	}
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		return errors.New("decode body: trailing data")
+	}
+	return nil
+}
+
+// validTitle trims title and reports whether it is 1 to 200 characters.
+func validTitle(title string) (string, bool) {
+	title = strings.TrimSpace(title)
+	n := utf8.RuneCountInString(title)
+	return title, n >= 1 && n <= maxTitleChars
+}
+
+func (s *server) create(w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	if err := decode(w, r, &req); err != nil {
+		Error(w, http.StatusBadRequest, msgInvalidBody)
+		return
+	}
+	title, ok := validTitle(req.Title)
+	if !ok {
+		Error(w, http.StatusBadRequest, msgBadTitle)
+		return
+	}
+	JSON(w, http.StatusCreated, s.store.Create(title))
+}
+
+func (s *server) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	f := todo.ListFilter{Limit: defaultLimit}
+
+	if v := q.Get("done"); v != "" {
+		switch v {
+		case "true":
+			t := true
+			f.Done = &t
+		case "false":
+			t := false
+			f.Done = &t
+		default:
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+	}
+	if v := q.Get("limit"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 1 || n > maxLimit {
+			Error(w, http.StatusBadRequest, "limit must be an integer from 1 to 100")
+			return
+		}
+		f.Limit = n
+	}
+	if v := q.Get("offset"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be an integer of 0 or more")
+			return
+		}
+		f.Offset = n
+	}
+	JSON(w, http.StatusOK, s.store.List(f))
+}
+
+func (s *server) get(w http.ResponseWriter, r *http.Request) {
+	t, err := s.store.Get(r.PathValue("id"))
+	if err != nil {
+		s.fail(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (s *server) update(w http.ResponseWriter, r *http.Request) {
+	var req updateRequest
+	if err := decode(w, r, &req); err != nil {
+		Error(w, http.StatusBadRequest, msgInvalidBody)
+		return
+	}
+	if req.Title == nil && req.Done == nil {
+		Error(w, http.StatusBadRequest, "provide title, done or both")
+		return
+	}
+	u := todo.Update{Done: req.Done}
+	if req.Title != nil {
+		title, ok := validTitle(*req.Title)
+		if !ok {
+			Error(w, http.StatusBadRequest, msgBadTitle)
+			return
+		}
+		u.Title = &title
+	}
+	t, err := s.store.Update(r.PathValue("id"), u)
+	if err != nil {
+		s.fail(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (s *server) delete(w http.ResponseWriter, r *http.Request) {
+	if err := s.store.Delete(r.PathValue("id")); err != nil {
+		s.fail(w, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// fail maps a store error to a response.
+func (s *server) fail(w http.ResponseWriter, err error) {
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	log.Error("todo store", "err", err)
+	Error(w, http.StatusInternalServerError, "internal error, try again later")
+}
diff --git a/internal/api/handler_test.go b/internal/api/handler_test.go
new file mode 100644
index 0000000..552a948
--- /dev/null
+++ b/internal/api/handler_test.go
@@ -0,0 +1,342 @@
+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+var now = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newTestHandler(t *testing.T) (http.Handler, *todo.Store) {
+	t.Helper()
+	s := todo.NewStore(clock.Fixed{T: now})
+	return NewHandler(s), s
+}
+
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	var r *http.Request
+	if body == "" {
+		r = httptest.NewRequest(method, target, nil)
+	} else {
+		r = httptest.NewRequest(method, target, strings.NewReader(body))
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func decodeTodo(t *testing.T, w *httptest.ResponseRecorder) todo.Todo {
+	t.Helper()
+	var got todo.Todo
+	if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+		t.Fatalf("response body %q is not a todo: %v", w.Body.String(), err)
+	}
+	return got
+}
+
+func wantErrorBody(t *testing.T, w *httptest.ResponseRecorder) {
+	t.Helper()
+	if ct := w.Header().Get("Content-Type"); ct != "application/json" {
+		t.Errorf("Content-Type = %q, want application/json", ct)
+	}
+	var body map[string]string
+	if err := json.Unmarshal(w.Body.Bytes(), &body); err != nil || body["error"] == "" {
+		t.Errorf("error body = %q (%v), want {\"error\": \"...\"}", w.Body.String(), err)
+	}
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name      string
+		body      string
+		wantCode  int
+		wantTitle string
+	}{
+		{"valid", `{"title":"buy milk"}`, http.StatusCreated, "buy milk"},
+		{"trimmed", `{"title":"  padded \t"}`, http.StatusCreated, "padded"},
+		{"one char", `{"title":"x"}`, http.StatusCreated, "x"},
+		{"200 chars", `{"title":"` + strings.Repeat("a", 200) + `"}`, http.StatusCreated, strings.Repeat("a", 200)},
+		{"200 multibyte chars", `{"title":"` + strings.Repeat("é", 200) + `"}`, http.StatusCreated, strings.Repeat("é", 200)},
+		{"201 chars", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, ""},
+		{"201 chars after trim is ok only if 200", `{"title":" ` + strings.Repeat("a", 200) + ` "}`, http.StatusCreated, strings.Repeat("a", 200)},
+		{"empty", `{"title":""}`, http.StatusBadRequest, ""},
+		{"blank", `{"title":"   "}`, http.StatusBadRequest, ""},
+		{"missing title", `{}`, http.StatusBadRequest, ""},
+		{"wrong type", `{"title":5}`, http.StatusBadRequest, ""},
+		{"unknown field", `{"title":"a","extra":1}`, http.StatusBadRequest, ""},
+		{"not json", `nope`, http.StatusBadRequest, ""},
+		{"empty body", ``, http.StatusBadRequest, ""},
+		{"trailing data", `{"title":"a"} {"title":"b"}`, http.StatusBadRequest, ""},
+		{"too large", `{"title":"` + strings.Repeat("a", 2<<20) + `"}`, http.StatusBadRequest, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, s := newTestHandler(t)
+			w := do(h, http.MethodPost, "/todos", tc.body)
+			if w.Code != tc.wantCode {
+				t.Fatalf("POST /todos %.40q = %d, want %d (body %.100s)", tc.body, w.Code, tc.wantCode, w.Body.String())
+			}
+			if tc.wantCode != http.StatusCreated {
+				wantErrorBody(t, w)
+				if n := len(s.List(todo.ListFilter{})); n != 0 {
+					t.Errorf("store has %d todos after rejected create, want 0", n)
+				}
+				return
+			}
+			got := decodeTodo(t, w)
+			if got.ID == "" || got.Title != tc.wantTitle || got.Done || !got.CreatedAt.Equal(now) || !got.UpdatedAt.Equal(now) {
+				t.Errorf("POST /todos %.40q = %+v, want title %.20q, not done, times %v", tc.body, got, tc.wantTitle, now)
+			}
+			if stored, err := s.Get(got.ID); err != nil || stored.Title != tc.wantTitle {
+				t.Errorf("store Get(%q) = %+v, %v, want title %.20q", got.ID, stored, err, tc.wantTitle)
+			}
+		})
+	}
+}
+
+func TestResponseJSONFieldNames(t *testing.T) {
+	h, _ := newTestHandler(t)
+	w := do(h, http.MethodPost, "/todos", `{"title":"a"}`)
+	var raw map[string]any
+	if err := json.Unmarshal(w.Body.Bytes(), &raw); err != nil {
+		t.Fatalf("response %q is not JSON: %v", w.Body.String(), err)
+	}
+	for _, key := range []string{"id", "title", "done", "created_at", "updated_at"} {
+		if _, ok := raw[key]; !ok {
+			t.Errorf("POST /todos response lacks field %q: %v", key, raw)
+		}
+	}
+}
+
+func TestGet(t *testing.T) {
+	h, s := newTestHandler(t)
+	created := s.Create("find me")
+
+	tests := []struct {
+		name     string
+		path     string
+		wantCode int
+	}{
+		{"existing", "/todos/" + created.ID, http.StatusOK},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, http.MethodGet, tc.path, "")
+			if w.Code != tc.wantCode {
+				t.Fatalf("GET %s = %d, want %d", tc.path, w.Code, tc.wantCode)
+			}
+			if tc.wantCode != http.StatusOK {
+				wantErrorBody(t, w)
+				return
+			}
+			if got := decodeTodo(t, w); got != created {
+				t.Errorf("GET %s = %+v, want %+v", tc.path, got, created)
+			}
+		})
+	}
+}
+
+func TestList(t *testing.T) {
+	h, s := newTestHandler(t)
+	// a..e oldest to newest; c and e are done.
+	for _, title := range []string{"a", "b", "c", "d", "e"} {
+		created := s.Create(title)
+		if title == "c" || title == "e" {
+			if _, err := s.Update(created.ID, todo.Update{Done: new(true)}); err != nil {
+				t.Fatalf("Update(%q) = %v", created.ID, err)
+			}
+		}
+	}
+	many, _ := newTestHandler(t)
+
+	tests := []struct {
+		name       string
+		query      string
+		wantCode   int
+		wantTitles []string
+	}{
+		{"all", "", http.StatusOK, []string{"e", "d", "c", "b", "a"}},
+		{"done true", "?done=true", http.StatusOK, []string{"e", "c"}},
+		{"done false", "?done=false", http.StatusOK, []string{"d", "b", "a"}},
+		{"limit", "?limit=2", http.StatusOK, []string{"e", "d"}},
+		{"offset", "?offset=3", http.StatusOK, []string{"b", "a"}},
+		{"limit offset", "?limit=2&offset=1", http.StatusOK, []string{"d", "c"}},
+		{"filter and page", "?done=false&limit=1&offset=1", http.StatusOK, []string{"b"}},
+		{"offset past end", "?offset=99", http.StatusOK, []string{}},
+		{"limit 1", "?limit=1", http.StatusOK, []string{"e"}},
+		{"limit 100", "?limit=100", http.StatusOK, []string{"e", "d", "c", "b", "a"}},
+		{"limit 0", "?limit=0", http.StatusBadRequest, nil},
+		{"limit 101", "?limit=101", http.StatusBadRequest, nil},
+		{"limit negative", "?limit=-1", http.StatusBadRequest, nil},
+		{"limit not a number", "?limit=abc", http.StatusBadRequest, nil},
+		{"offset negative", "?offset=-1", http.StatusBadRequest, nil},
+		{"offset not a number", "?offset=x", http.StatusBadRequest, nil},
+		{"done invalid", "?done=maybe", http.StatusBadRequest, nil},
+		{"done uppercase", "?done=TRUE", http.StatusBadRequest, nil},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, http.MethodGet, "/todos"+tc.query, "")
+			if w.Code != tc.wantCode {
+				t.Fatalf("GET /todos%s = %d, want %d (body %s)", tc.query, w.Code, tc.wantCode, w.Body.String())
+			}
+			if tc.wantCode != http.StatusOK {
+				wantErrorBody(t, w)
+				return
+			}
+			var got []todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatalf("GET /todos%s body %q is not a todo list: %v", tc.query, w.Body.String(), err)
+			}
+			titles := make([]string, len(got))
+			for i, td := range got {
+				titles[i] = td.Title
+			}
+			if !slices.Equal(titles, tc.wantTitles) {
+				t.Errorf("GET /todos%s = %v, want %v", tc.query, titles, tc.wantTitles)
+			}
+		})
+	}
+
+	t.Run("empty list is an array", func(t *testing.T) {
+		w := do(many, http.MethodGet, "/todos", "")
+		if got := strings.TrimSpace(w.Body.String()); w.Code != http.StatusOK || got != "[]" {
+			t.Errorf("GET /todos on empty store = %d %q, want 200 []", w.Code, got)
+		}
+	})
+
+	t.Run("default limit is 20", func(t *testing.T) {
+		h, s := newTestHandler(t)
+		for i := range 25 {
+			s.Create(fmt.Sprintf("t%d", i))
+		}
+		var got []todo.Todo
+		w := do(h, http.MethodGet, "/todos", "")
+		if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil || len(got) != 20 {
+			t.Errorf("GET /todos with 25 todos returned %d (%v), want 20", len(got), err)
+		}
+	})
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		path      string // "{id}" is replaced with the created todo id
+		body      string
+		wantCode  int
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title", "/todos/{id}", `{"title":"new"}`, http.StatusOK, "new", false},
+		{"title trimmed", "/todos/{id}", `{"title":"  new  "}`, http.StatusOK, "new", false},
+		{"done", "/todos/{id}", `{"done":true}`, http.StatusOK, "old", true},
+		{"both", "/todos/{id}", `{"title":"new","done":true}`, http.StatusOK, "new", true},
+		{"done false", "/todos/{id}", `{"done":false}`, http.StatusOK, "old", false},
+		{"missing id", "/todos/nope", `{"done":true}`, http.StatusNotFound, "", false},
+		{"empty object", "/todos/{id}", `{}`, http.StatusBadRequest, "", false},
+		{"empty title", "/todos/{id}", `{"title":""}`, http.StatusBadRequest, "", false},
+		{"blank title", "/todos/{id}", `{"title":"  "}`, http.StatusBadRequest, "", false},
+		{"long title", "/todos/{id}", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, "", false},
+		{"null title only", "/todos/{id}", `{"title":null}`, http.StatusBadRequest, "", false},
+		{"wrong done type", "/todos/{id}", `{"done":"yes"}`, http.StatusBadRequest, "", false},
+		{"unknown field", "/todos/{id}", `{"id":"x"}`, http.StatusBadRequest, "", false},
+		{"not json", "/todos/{id}", `nope`, http.StatusBadRequest, "", false},
+		{"empty body", "/todos/{id}", ``, http.StatusBadRequest, "", false},
+		{"invalid body and missing id", "/todos/nope", `nope`, http.StatusBadRequest, "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, s := newTestHandler(t)
+			created := s.Create("old")
+			path := strings.ReplaceAll(tc.path, "{id}", created.ID)
+
+			w := do(h, http.MethodPatch, path, tc.body)
+			if w.Code != tc.wantCode {
+				t.Fatalf("PATCH %s %.40q = %d, want %d (body %s)", tc.path, tc.body, w.Code, tc.wantCode, w.Body.String())
+			}
+			stored, err := s.Get(created.ID)
+			if err != nil {
+				t.Fatalf("store Get(%q) = %v, want nil", created.ID, err)
+			}
+			if tc.wantCode != http.StatusOK {
+				wantErrorBody(t, w)
+				if stored != created {
+					t.Errorf("todo changed by rejected PATCH: %+v, want %+v", stored, created)
+				}
+				return
+			}
+			got := decodeTodo(t, w)
+			if got.ID != created.ID || got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("PATCH %s %.40q = %+v, want title %q done %v", tc.path, tc.body, got, tc.wantTitle, tc.wantDone)
+			}
+			if stored != got {
+				t.Errorf("stored todo = %+v, want %+v", stored, got)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	h, s := newTestHandler(t)
+	created := s.Create("bye")
+
+	tests := []struct {
+		name     string
+		path     string
+		wantCode int
+	}{
+		{"existing", "/todos/" + created.ID, http.StatusNoContent},
+		{"again", "/todos/" + created.ID, http.StatusNotFound},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, http.MethodDelete, tc.path, "")
+			if w.Code != tc.wantCode {
+				t.Fatalf("DELETE %s = %d, want %d", tc.path, w.Code, tc.wantCode)
+			}
+			if tc.wantCode == http.StatusNoContent {
+				if w.Body.Len() != 0 {
+					t.Errorf("DELETE %s body = %q, want empty", tc.path, w.Body.String())
+				}
+				return
+			}
+			wantErrorBody(t, w)
+		})
+	}
+	if w := do(h, http.MethodGet, "/todos/"+created.ID, ""); w.Code != http.StatusNotFound {
+		t.Errorf("GET after DELETE = %d, want %d", w.Code, http.StatusNotFound)
+	}
+}
+
+func TestRouting(t *testing.T) {
+	h, _ := newTestHandler(t)
+	tests := []struct {
+		name     string
+		method   string
+		path     string
+		wantCode int
+	}{
+		{"unknown path", http.MethodGet, "/nothing", http.StatusNotFound},
+		{"collection delete", http.MethodDelete, "/todos", http.StatusMethodNotAllowed},
+		{"item post", http.MethodPost, "/todos/abc", http.StatusMethodNotAllowed},
+		{"item put", http.MethodPut, "/todos/abc", http.StatusMethodNotAllowed},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if w := do(h, tc.method, tc.path, ""); w.Code != tc.wantCode {
+				t.Errorf("%s %s = %d, want %d", tc.method, tc.path, w.Code, tc.wantCode)
+			}
+		})
+	}
+}
