diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..583119a
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,135 @@
+// Package todo holds the Todo type and an in-memory store for it.
+package todo
+
+import (
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a single item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Update describes a partial change. A nil field is left as it is.
+type Update struct {
+	Title *string
+	Done  *bool
+}
+
+// ListFilter selects and pages the todos returned by List.
+type ListFilter struct {
+	// Done, when not nil, keeps only todos whose done flag equals it.
+	Done *bool
+	// Limit is the maximum number of todos returned. Zero or less means no limit.
+	Limit int
+	// Offset is the number of matching todos skipped. Less than zero means zero.
+	Offset int
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards items and order.
+	mu    sync.RWMutex
+	items map[string]Todo
+	order []string // ids, oldest first
+}
+
+// NewStore returns an empty Store that reads time from c.
+func NewStore(c clock.Clock) *Store {
+	return &Store{clock: c, items: make(map[string]Todo)}
+}
+
+// Create adds a todo with the given title and returns it. The title is
+// stored as given: the caller validates it.
+func (s *Store) Create(title string) Todo {
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.items[t.ID] = t
+	s.order = append(s.order, t.ID)
+	return t
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(id string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update applies u to the todo with the given id and returns the result, or
+// ErrNotFound.
+func (s *Store) Update(id string, u Update) (Todo, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if u.Title != nil {
+		t.Title = *u.Title
+	}
+	if u.Done != nil {
+		t.Done = *u.Done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.items[id] = t
+	return t, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, id)
+	for i, v := range s.order {
+		if v == id {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns the todos matching f, newest first.
+func (s *Store) List(f ListFilter) []Todo {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	offset := max(f.Offset, 0)
+	out := []Todo{}
+	for i := len(s.order) - 1; i >= 0; i-- {
+		t := s.items[s.order[i]]
+		if f.Done != nil && t.Done != *f.Done {
+			continue
+		}
+		if offset > 0 {
+			offset--
+			continue
+		}
+		if f.Limit > 0 && len(out) >= f.Limit {
+			break
+		}
+		out = append(out, t)
+	}
+	return out
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
new file mode 100644
index 0000000..ab5878d
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,243 @@
+package todo
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var (
+	t0 = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	t1 = t0.Add(time.Hour)
+)
+
+// stepClock returns the times it was given, one per call, then the last one.
+type stepClock struct {
+	mu    sync.Mutex
+	times []time.Time
+}
+
+func (c *stepClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	t := c.times[0]
+	if len(c.times) > 1 {
+		c.times = c.times[1:]
+	}
+	return t
+}
+
+func ptr[T any](v T) *T { return &v }
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func TestCreateAndGet(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	a := s.Create("a")
+	b := s.Create("b")
+
+	if a.ID == "" || a.ID == b.ID {
+		t.Errorf("Create ids = %q, %q, want distinct non-empty", a.ID, b.ID)
+	}
+	if a.Title != "a" || a.Done || !a.CreatedAt.Equal(t0) || !a.UpdatedAt.Equal(t0) {
+		t.Errorf("Create(%q) = %+v, want title a, not done, times %v", "a", a, t0)
+	}
+
+	tests := []struct {
+		name    string
+		id      string
+		want    string
+		wantErr error
+	}{
+		{"existing", a.ID, "a", nil},
+		{"other", b.ID, "b", nil},
+		{"missing", "nope", "", ErrNotFound},
+		{"empty id", "", "", ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.Get(tc.id)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Get(%q) error = %v, want %v", tc.id, err, tc.wantErr)
+			}
+			if got.Title != tc.want {
+				t.Errorf("Get(%q).Title = %q, want %q", tc.id, got.Title, tc.want)
+			}
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		upd       Update
+		missingID bool
+		wantTitle string
+		wantDone  bool
+		wantErr   error
+	}{
+		{name: "title only", upd: Update{Title: ptr("new")}, wantTitle: "new"},
+		{name: "done only", upd: Update{Done: ptr(true)}, wantTitle: "old", wantDone: true},
+		{name: "both", upd: Update{Title: ptr("new"), Done: ptr(true)}, wantTitle: "new", wantDone: true},
+		{name: "done false", upd: Update{Done: ptr(false)}, wantTitle: "old"},
+		{name: "missing", upd: Update{Done: ptr(true)}, missingID: true, wantErr: ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(&stepClock{times: []time.Time{t0, t1}})
+			created := s.Create("old")
+
+			id := created.ID
+			if tc.missingID {
+				id = "nope"
+			}
+			got, err := s.Update(id, tc.upd)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Update(%q, %+v) error = %v, want %v", id, tc.upd, err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%q, %+v) = title %q done %v, want title %q done %v",
+					id, tc.upd, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			if !got.CreatedAt.Equal(t0) || !got.UpdatedAt.Equal(t1) {
+				t.Errorf("Update(%q, %+v) times = %v, %v, want %v, %v",
+					id, tc.upd, got.CreatedAt, got.UpdatedAt, t0, t1)
+			}
+			again, err := s.Get(id)
+			if err != nil || again != got {
+				t.Errorf("Get(%q) after Update = %+v, %v, want %+v", id, again, err, got)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	a := s.Create("a")
+	s.Create("b")
+
+	tests := []struct {
+		name    string
+		id      string
+		wantErr error
+	}{
+		{"existing", a.ID, nil},
+		{"again", a.ID, ErrNotFound},
+		{"missing", "nope", ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := s.Delete(tc.id); !errors.Is(err, tc.wantErr) {
+				t.Errorf("Delete(%q) = %v, want %v", tc.id, err, tc.wantErr)
+			}
+		})
+	}
+	if _, err := s.Get(a.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(%q) after Delete = %v, want %v", a.ID, err, ErrNotFound)
+	}
+	if got := titles(s.List(ListFilter{})); !slices.Equal(got, []string{"b"}) {
+		t.Errorf("List after Delete = %v, want [b]", got)
+	}
+}
+
+func TestList(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	// Created in order a..e; c and e are done.
+	var all []Todo
+	for _, title := range []string{"a", "b", "c", "d", "e"} {
+		all = append(all, s.Create(title))
+	}
+	for _, i := range []int{2, 4} {
+		if _, err := s.Update(all[i].ID, Update{Done: ptr(true)}); err != nil {
+			t.Fatalf("Update(%q) = %v", all[i].ID, err)
+		}
+	}
+
+	tests := []struct {
+		name string
+		f    ListFilter
+		want []string
+	}{
+		{"all newest first", ListFilter{}, []string{"e", "d", "c", "b", "a"}},
+		{"done", ListFilter{Done: ptr(true)}, []string{"e", "c"}},
+		{"not done", ListFilter{Done: ptr(false)}, []string{"d", "b", "a"}},
+		{"limit", ListFilter{Limit: 2}, []string{"e", "d"}},
+		{"offset", ListFilter{Offset: 3}, []string{"b", "a"}},
+		{"limit and offset", ListFilter{Limit: 2, Offset: 1}, []string{"d", "c"}},
+		{"filter limit offset", ListFilter{Done: ptr(false), Limit: 1, Offset: 1}, []string{"b"}},
+		{"offset past end", ListFilter{Offset: 10}, []string{}},
+		{"negative offset", ListFilter{Offset: -4, Limit: 1}, []string{"e"}},
+		{"negative limit is unlimited", ListFilter{Limit: -1}, []string{"e", "d", "c", "b", "a"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := s.List(tc.f)
+			if got == nil {
+				t.Errorf("List(%+v) = nil, want non-nil slice", tc.f)
+			}
+			if got := titles(got); !slices.Equal(got, tc.want) {
+				t.Errorf("List(%+v) = %v, want %v", tc.f, got, tc.want)
+			}
+		})
+	}
+
+	t.Run("empty store", func(t *testing.T) {
+		got := NewStore(clock.Fixed{T: t0}).List(ListFilter{})
+		if got == nil || len(got) != 0 {
+			t.Errorf("List on empty store = %v, want empty non-nil slice", got)
+		}
+	})
+}
+
+func TestConcurrentUse(t *testing.T) {
+	const workers, perWorker = 16, 50
+	s := NewStore(clock.Fixed{T: t0})
+
+	var wg sync.WaitGroup
+	for w := range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range perWorker {
+				created := s.Create(fmt.Sprintf("w%d-%d", w, i))
+				if _, err := s.Get(created.ID); err != nil {
+					t.Errorf("Get(%q) = %v, want nil", created.ID, err)
+				}
+				if _, err := s.Update(created.ID, Update{Done: ptr(true)}); err != nil {
+					t.Errorf("Update(%q) = %v, want nil", created.ID, err)
+				}
+				s.List(ListFilter{Done: ptr(true), Limit: 5})
+				if i%2 == 0 {
+					if err := s.Delete(created.ID); err != nil {
+						t.Errorf("Delete(%q) = %v, want nil", created.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+
+	got := s.List(ListFilter{})
+	if want := workers * perWorker / 2; len(got) != want {
+		t.Errorf("List after concurrent use has %d todos, want %d", len(got), want)
+	}
+	for _, td := range got {
+		if !td.Done {
+			t.Errorf("todo %q is not done, want done", td.ID)
+		}
+	}
+}
