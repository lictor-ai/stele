+
+func ms(n int) time.Duration { return time.Duration(n) * time.Millisecond }
+
+func seq(n int) []time.Duration {
+	s := make([]time.Duration, n)
+	for i := range s {
+		s[i] = ms(i + 1)
+	}
+	return s
+}
+
+func TestPercentile(t *testing.T) {
+	tests := []struct {
+		name string
+		in   []time.Duration
+		p    int
+		want float64
+	}{
+		{"empty", nil, 50, 0},
+		{"single p50", []time.Duration{ms(7)}, 50, 7},
+		{"single p99", []time.Duration{ms(7)}, 99, 7},
+		{"two p50", []time.Duration{ms(1), ms(2)}, 50, 1},
+		{"two p95", []time.Duration{ms(1), ms(2)}, 95, 2},
+		{"hundred p50", seq(100), 50, 50},
+		{"hundred p95", seq(100), 95, 95},
+		{"hundred p99", seq(100), 99, 99},
+		{"p0 is min", seq(100), 0, 1},
+		{"p100 is max", seq(100), 100, 100},
+		{"p over 100 clamps", seq(100), 150, 100},
+		{"p negative clamps", seq(100), -5, 1},
+		{"twenty p95", seq(20), 95, 19},
+		{"fractional", []time.Duration{1500 * time.Microsecond}, 50, 1.5},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := Percentile(tt.in, tt.p); got != tt.want {
+				t.Errorf("Percentile(len %d, %d) = %v, want %v", len(tt.in), tt.p, got, tt.want)
+			}
+		})
+	}
+}
+
+func entry(path string, status int, hour int, d time.Duration) logparse.Entry {
+	return logparse.Entry{
+		Path:     path,
+		Status:   status,
+		Time:     time.Date(2026, 10, 10, hour, 30, 0, 0, time.UTC),
+		Duration: d,
+	}
+}
+
+func TestReportEmpty(t *testing.T) {
+	r := New().Report(10)
+	if r.Total != 0 || r.P50Ms != 0 || r.P99Ms != 0 || len(r.TopPaths) != 0 || len(r.ErrorsByHour) != 0 {
+		t.Errorf("Report(10) on empty = %+v, want zero values", r)
+	}
+	if r.TopPaths == nil || r.ErrorsByHour == nil {
+		t.Error("Report(10) slices are nil, want empty so JSON has []")
+	}
+}
+
+func TestReportSingle(t *testing.T) {
+	c := New()
+	c.Add(entry("/a", 503, 4, ms(10)))
+	r := c.Report(10)
+	if r.Total != 1 || r.Status.Class5xx != 1 || r.P50Ms != 10 || r.P95Ms != 10 || r.P99Ms != 10 {
+		t.Errorf("Report(10) = %+v, want one 5xx request at 10ms", r)
+	}
+	want := []HourCount{{Hour: "2026-10-10T04:00:00Z", Count: 1}}
+	if !slices.Equal(r.ErrorsByHour, want) {
+		t.Errorf("ErrorsByHour = %v, want %v", r.ErrorsByHour, want)
+	}
+}
+
+func TestReport(t *testing.T) {
+	c := New()
+	c.Add(entry("/b", 200, 1, ms(5)))
+	c.Add(entry("/b", 301, 1, ms(5)))
+	c.Add(entry("/a", 404, 2, ms(5)))
+	c.Add(entry("/a", 500, 3, ms(5)))
+	c.Add(entry("/a", 502, 3, ms(5)))
+	c.Add(entry("/c", 500, 2, ms(5)))
+	c.Add(entry("/c", 101, 2, ms(5)))
+	c.AddMalformed(2)
+
+	r := c.Report(2)
+	if r.Total != 7 || r.Malformed != 2 {
+		t.Errorf("Total, Malformed = %d, %d, want 7, 2", r.Total, r.Malformed)
+	}
+	if want := (StatusClasses{Class2xx: 1, Class3xx: 1, Class4xx: 1, Class5xx: 3}); r.Status != want {
+		t.Errorf("Status = %+v, want %+v", r.Status, want)
+	}
+	wantTop := []PathCount{{"/a", 3}, {"/b", 2}}
+	if !slices.Equal(r.TopPaths, wantTop) {
+		t.Errorf("TopPaths = %v, want %v", r.TopPaths, wantTop)
+	}
+	wantHours := []HourCount{{"2026-10-10T02:00:00Z", 1}, {"2026-10-10T03:00:00Z", 2}}
+	if !slices.Equal(r.ErrorsByHour, wantHours) {
+		t.Errorf("ErrorsByHour = %v, want %v", r.ErrorsByHour, wantHours)
+	}
