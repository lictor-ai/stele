diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..3360ef3
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,108 @@
+// Package logparse parses nginx "combined" access log lines that have the
+// request time (in seconds) appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+var lineRE = regexp.MustCompile(`^(\S+) \S+ \S+ \[([^\]]+)\] "((?:[^"\\]|\\.)*)" (\d{3}) (\d+|-) "(?:[^"\\]|\\.)*" "(?:[^"\\]|\\.)*" (\S+)$`)
+
+// Entry is one parsed access log record.
+type Entry struct {
+	// RemoteAddr is the client address.
+	RemoteAddr string
+	// Time is the time the request was received.
+	Time time.Time
+	// Method is the HTTP method.
+	Method string
+	// Path is the request path with the query string and fragment removed.
+	Path string
+	// Status is the HTTP status code.
+	Status int
+	// Bytes is the response size; zero when the log has "-".
+	Bytes int64
+	// Duration is the request time.
+	Duration time.Duration
+}
+
+// Parse parses a single log line. It returns an error wrapping ErrMalformed
+// when the line does not match the expected format.
+func Parse(line string) (Entry, error) {
+	m := lineRE.FindStringSubmatch(strings.TrimRight(line, "\r\n"))
+	if m == nil {
+		return Entry{}, fmt.Errorf("parse %q: %w", line, ErrMalformed)
+	}
+	ts, err := time.Parse(timeLayout, m[2])
+	if err != nil {
+		return Entry{}, fmt.Errorf("parse time %q: %w", m[2], ErrMalformed)
+	}
+	parts := strings.Split(m[3], " ")
+	if len(parts) != 3 || parts[0] == "" || !strings.HasPrefix(parts[1], "/") {
+		return Entry{}, fmt.Errorf("parse request %q: %w", m[3], ErrMalformed)
+	}
+	status, err := strconv.Atoi(m[4])
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, fmt.Errorf("parse status %q: %w", m[4], ErrMalformed)
+	}
+	var size int64
+	if m[5] != "-" {
+		size, err = strconv.ParseInt(m[5], 10, 64)
+		if err != nil {
+			return Entry{}, fmt.Errorf("parse size %q: %w", m[5], ErrMalformed)
+		}
+	}
+	secs, err := strconv.ParseFloat(m[6], 64)
+	if err != nil || math.IsNaN(secs) || math.IsInf(secs, 0) || secs < 0 || secs > 1e9 {
+		return Entry{}, fmt.Errorf("parse request time %q: %w", m[6], ErrMalformed)
+	}
+	return Entry{
+		RemoteAddr: m[1],
+		Time:       ts,
+		Method:     parts[0],
+		Path:       stripQuery(parts[1]),
+		Status:     status,
+		Bytes:      size,
+		Duration:   time.Duration(math.Round(secs * float64(time.Second))),
+	}, nil
+}
+
+func stripQuery(target string) string {
+	if i := strings.IndexAny(target, "?#"); i >= 0 {
+		return target[:i]
+	}
+	return target
+}
+
+// Read parses every line of r and calls fn for each valid entry. Blank lines
+// are ignored. Malformed lines are counted and skipped. It returns the number
+// of malformed lines, and an error only if reading r fails.
+func Read(r io.Reader, fn func(Entry)) (malformed int, err error) {
+	br := bufio.NewReader(r)
+	for {
+		line, rerr := br.ReadString('\n')
+		if strings.TrimSpace(line) != "" {
+			if e, perr := Parse(line); perr != nil {
+				malformed++
+			} else {
+				fn(e)
+			}
+		}
+		if rerr != nil {
+			if errors.Is(rerr, io.EOF) {
+				return malformed, nil
+			}
+			return malformed, fmt.Errorf("read log: %w", rerr)
+		}
+	}
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..945ca4d
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,102 @@
+package logparse
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+const good = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	tests := []struct {
+		name    string
+		line    string
+		want    Entry
+		wantErr bool
+	}{
+		{name: "valid", line: good, want: Entry{RemoteAddr: "203.0.113.9", Method: "GET", Path: "/api/items", Status: 200, Bytes: 512, Duration: 42 * time.Millisecond}},
+		{name: "trailing newline", line: good + "\r\n", want: Entry{RemoteAddr: "203.0.113.9", Method: "GET", Path: "/api/items", Status: 200, Bytes: 512, Duration: 42 * time.Millisecond}},
+		{name: "dash size", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 304 - "-" "ua" 0.001`, want: Entry{RemoteAddr: "1.2.3.4", Method: "GET", Path: "/", Status: 304, Duration: time.Millisecond}},
+		{name: "quotes in user agent", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /a#frag HTTP/1.1" 200 1 "-" "a \"b\" c" 0`, want: Entry{RemoteAddr: "1.2.3.4", Method: "GET", Path: "/a", Status: 200, Bytes: 1}},
+		{name: "empty", line: "", wantErr: true},
+		{name: "garbage", line: "hello world", wantErr: true},
+		{name: "missing request time", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua"`, wantErr: true},
+		{name: "bad request time", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" fast`, wantErr: true},
+		{name: "negative request time", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" -1`, wantErr: true},
+		{name: "NaN request time", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" NaN`, wantErr: true},
+		{name: "bad timestamp", line: `1.2.3.4 - - [32/Foo/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`, wantErr: true},
+		{name: "bad status", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 999 1 "-" "ua" 0.1`, wantErr: true},
+		{name: "short request", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /" 200 1 "-" "ua" 0.1`, wantErr: true},
+		{name: "dash request", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "-" 400 0 "-" "-" 0.000`, wantErr: true},
+		{name: "relative target", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET x HTTP/1.1" 200 1 "-" "ua" 0.1`, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Parse(tt.line)
+			if tt.wantErr {
+				if !errors.Is(err, ErrMalformed) {
+					t.Fatalf("Parse(%q) error = %v, want ErrMalformed", tt.line, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v, want nil", tt.line, err)
+			}
+			got.Time = time.Time{}
+			if got != tt.want {
+				t.Errorf("Parse(%q) = %+v, want %+v", tt.line, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestParseTime(t *testing.T) {
+	e, err := Parse(`1.2.3.4 - - [10/Oct/2026:13:55:36 +0200] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`)
+	if err != nil {
+		t.Fatalf("Parse error = %v", err)
+	}
+	want := time.Date(2026, 10, 10, 11, 55, 36, 0, time.UTC)
+	if !e.Time.Equal(want) {
+		t.Errorf("Parse time = %v, want %v", e.Time, want)
+	}
+}
+
+type errReader struct{}
+
+func (errReader) Read([]byte) (int, error) { return 0, errors.New("boom") }
+
+func TestRead(t *testing.T) {
+	long := strings.Repeat("x", 200000)
+	tests := []struct {
+		name          string
+		in            string
+		wantEntries   int
+		wantMalformed int
+	}{
+		{name: "empty", in: ""},
+		{name: "blank lines only", in: "\n\n  \n"},
+		{name: "single", in: good + "\n", wantEntries: 1},
+		{name: "no final newline", in: good, wantEntries: 1},
+		{name: "mixed", in: good + "\nbad\n" + good + "\n\n", wantEntries: 2, wantMalformed: 1},
+		{name: "very long bad line", in: long + "\n" + good + "\n", wantEntries: 1, wantMalformed: 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			n := 0
+			bad, err := Read(strings.NewReader(tt.in), func(Entry) { n++ })
+			if err != nil {
+				t.Fatalf("Read error = %v", err)
+			}
+			if n != tt.wantEntries || bad != tt.wantMalformed {
+				t.Errorf("Read = %d entries, %d malformed, want %d, %d", n, bad, tt.wantEntries, tt.wantMalformed)
+			}
+		})
+	}
+	t.Run("read error", func(t *testing.T) {
+		if _, err := Read(errReader{}, func(Entry) {}); err == nil {
+			t.Error("Read(errReader) error = nil, want error")
+		}
+	})
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..bdb845e
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,177 @@
+// Package stats aggregates parsed access log entries into a report.
+package stats
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+	"text/tabwriter"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+const hourLayout = "2006-01-02T15:00:00Z"
+
+// PathCount is a request path and how many requests it received.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// HourCount is the number of 5xx responses in one UTC hour.
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// StatusClasses counts requests per status class. Informational (1xx)
+// responses are not counted in any class.
+type StatusClasses struct {
+	Class2xx int `json:"2xx"`
+	Class3xx int `json:"3xx"`
+	Class4xx int `json:"4xx"`
+	Class5xx int `json:"5xx"`
+}
+
+// Report is the summary of a set of log entries. Times are in milliseconds.
+type Report struct {
+	Total        int           `json:"total_requests"`
+	Malformed    int           `json:"malformed_lines"`
+	TopPaths     []PathCount   `json:"top_paths"`
+	Status       StatusClasses `json:"status_classes"`
+	P50Ms        float64       `json:"p50_ms"`
+	P95Ms        float64       `json:"p95_ms"`
+	P99Ms        float64       `json:"p99_ms"`
+	ErrorsByHour []HourCount   `json:"errors_per_hour"`
+}
+
+// Collector accumulates entries. The zero value is not usable; use New.
+type Collector struct {
+	total     int
+	malformed int
+	paths     map[string]int
+	status    StatusClasses
+	durations []time.Duration
+	errHours  map[string]int
+}
+
+// New returns an empty Collector.
+func New() *Collector {
+	return &Collector{paths: map[string]int{}, errHours: map[string]int{}}
+}
+
+// Add records one valid entry.
+func (c *Collector) Add(e logparse.Entry) {
+	c.total++
+	c.paths[e.Path]++
+	c.durations = append(c.durations, e.Duration)
+	switch e.Status / 100 {
+	case 2:
+		c.status.Class2xx++
+	case 3:
+		c.status.Class3xx++
+	case 4:
+		c.status.Class4xx++
+	case 5:
+		c.status.Class5xx++
+		c.errHours[e.Time.UTC().Format(hourLayout)]++
+	}
+}
+
+// AddMalformed records n lines that could not be parsed.
+func (c *Collector) AddMalformed(n int) { c.malformed += n }
+
+// Report builds the report with the topN most requested paths. A topN of zero
+// or less yields no paths.
+func (c *Collector) Report(topN int) Report {
+	r := Report{
+		Total:        c.total,
+		Malformed:    c.malformed,
+		TopPaths:     []PathCount{},
+		Status:       c.status,
+		ErrorsByHour: []HourCount{},
+	}
+	for p, n := range c.paths {
+		r.TopPaths = append(r.TopPaths, PathCount{Path: p, Count: n})
+	}
+	sort.Slice(r.TopPaths, func(i, j int) bool {
+		a, b := r.TopPaths[i], r.TopPaths[j]
+		if a.Count != b.Count {
+			return a.Count > b.Count
+		}
+		return a.Path < b.Path
+	})
+	if topN < 0 {
+		topN = 0
+	}
+	if len(r.TopPaths) > topN {
+		r.TopPaths = r.TopPaths[:topN]
+	}
+
+	sorted := append([]time.Duration(nil), c.durations...)
+	sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+	r.P50Ms = Percentile(sorted, 50)
+	r.P95Ms = Percentile(sorted, 95)
+	r.P99Ms = Percentile(sorted, 99)
+
+	for h, n := range c.errHours {
+		r.ErrorsByHour = append(r.ErrorsByHour, HourCount{Hour: h, Count: n})
+	}
+	sort.Slice(r.ErrorsByHour, func(i, j int) bool { return r.ErrorsByHour[i].Hour < r.ErrorsByHour[j].Hour })
+	return r
+}
+
+// Percentile returns the p-th percentile (nearest rank) of sorted, in
+// milliseconds. p is clamped to 0..100. It returns 0 for empty input.
+func Percentile(sorted []time.Duration, p int) float64 {
+	n := len(sorted)
+	if n == 0 {
+		return 0
+	}
+	if p < 0 {
+		p = 0
+	}
+	if p > 100 {
+		p = 100
+	}
+	rank := (p*n + 99) / 100 // ceil(p*n/100) in integer arithmetic
+	if rank < 1 {
+		rank = 1
+	}
+	return float64(sorted[rank-1]) / float64(time.Millisecond)
+}
+
+// WriteJSON writes the report as indented JSON.
+func (r Report) WriteJSON(w io.Writer) error {
+	enc := json.NewEncoder(w)
+	enc.SetIndent("", "  ")
+	if err := enc.Encode(r); err != nil {
+		return fmt.Errorf("write json report: %w", err)
+	}
+	return nil
+}
+
+// WriteText writes the report as a human-readable text table.
+func (r Report) WriteText(w io.Writer) error {
+	tw := tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+	fmt.Fprintf(tw, "Total requests:\t%d\n", r.Total)
+	fmt.Fprintf(tw, "Malformed lines:\t%d\n", r.Malformed)
+	fmt.Fprintf(tw, "\nTOP PATHS\tREQUESTS\n")
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(tw, "%s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintf(tw, "\nSTATUS\tREQUESTS\n")
+	fmt.Fprintf(tw, "2xx\t%d\n3xx\t%d\n4xx\t%d\n5xx\t%d\n", r.Status.Class2xx, r.Status.Class3xx, r.Status.Class4xx, r.Status.Class5xx)
+	fmt.Fprintf(tw, "\nREQUEST TIME\tMS\n")
+	fmt.Fprintf(tw, "p50\t%.3f\np95\t%.3f\np99\t%.3f\n", r.P50Ms, r.P95Ms, r.P99Ms)
+	fmt.Fprintf(tw, "\n5XX PER HOUR (UTC)\tERRORS\n")
+	for _, h := range r.ErrorsByHour {
+		fmt.Fprintf(tw, "%s\t%d\n", h.Hour, h.Count)
+	}
+	if err := tw.Flush(); err != nil {
+		return fmt.Errorf("write text report: %w", err)
+	}
+	return nil
+}
