diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..eccb59d
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,84 @@
+// Command loga analyzes nginx access logs and prints a report.
+package main
+
+import (
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// usageError marks a bad command line, which exits with code 2.
+type usageError struct{ err error }
+
+func (e usageError) Error() string { return e.err.Error() }
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	err := run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	if err == nil || errors.Is(err, flag.ErrHelp) {
+		return
+	}
+	fmt.Fprintln(os.Stderr, "loga:", err)
+	var ue usageError
+	if errors.As(err, &ue) {
+		os.Exit(2)
+	}
+	os.Exit(1)
+}
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of top paths to show")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return err
+		}
+		return usageError{err}
+	}
+	if *top < 1 {
+		return usageError{fmt.Errorf("-top must be at least 1, got %d", *top)}
+	}
+
+	c := stats.New()
+	if fs.NArg() == 0 {
+		if err := ingest(c, stdin); err != nil {
+			return err
+		}
+	}
+	for _, name := range fs.Args() {
+		if err := ingestFile(c, name); err != nil {
+			return err
+		}
+	}
+
+	rep := c.Report(*top)
+	if *asJSON {
+		return rep.WriteJSON(stdout)
+	}
+	return rep.WriteText(stdout)
+}
+
+func ingest(c *stats.Collector, r io.Reader) error {
+	bad, err := logparse.Read(r, c.Add)
+	c.AddMalformed(bad)
+	return err
+}
+
+func ingestFile(c *stats.Collector, name string) error {
+	f, err := os.Open(name)
+	if err != nil {
+		return fmt.Errorf("open log: %w", err)
+	}
+	defer f.Close()
+	if err := ingest(c, f); err != nil {
+		return fmt.Errorf("%s: %w", name, err)
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..a231f89
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"flag"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const sample = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 500 10 "-" "curl/8.0" 0.100
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "GET /health HTTP/1.1" 200 2 "-" "curl/8.0" 0.001
+not a log line
+`
+
+func TestRun(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "access.log")
+	if err := os.WriteFile(file, []byte(sample), 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+
+	tests := []struct {
+		name      string
+		args      []string
+		stdin     string
+		wantErr   bool
+		wantUsage bool
+		wantOut   []string
+	}{
+		{name: "file text", args: []string{file}, wantOut: []string{"Total requests:   3", "Malformed lines:  1", "/api/items", "2026-10-10T13:00:00Z"}},
+		{name: "stdin text", stdin: sample, wantOut: []string{"Total requests:   3"}},
+		{name: "empty stdin", stdin: "", wantOut: []string{"Total requests:   0"}},
+		{name: "two files", args: []string{file, file}, wantOut: []string{"Total requests:   6", "Malformed lines:  2"}},
+		{name: "missing file", args: []string{filepath.Join(dir, "nope.log")}, wantErr: true},
+		{name: "bad flag", args: []string{"-bogus"}, wantErr: true, wantUsage: true},
+		{name: "top zero", args: []string{"-top", "0", file}, wantErr: true, wantUsage: true},
+		{name: "top not a number", args: []string{"-top", "x"}, wantErr: true, wantUsage: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(tt.args, strings.NewReader(tt.stdin), &out, &errOut)
+			var ue usageError
+			if (err != nil) != tt.wantErr || errors.As(err, &ue) != tt.wantUsage {
+				t.Fatalf("run(%q) error = %v, want error %v, usage %v", tt.args, err, tt.wantErr, tt.wantUsage)
+			}
+			for _, w := range tt.wantOut {
+				if !strings.Contains(out.String(), w) {
+					t.Errorf("run(%q) output missing %q:\n%s", tt.args, w, out.String())
+				}
+			}
+		})
+	}
+
+	t.Run("json", func(t *testing.T) {
+		var out bytes.Buffer
+		if err := run([]string{"-json", "-top", "1", file}, nil, &out, &bytes.Buffer{}); err != nil {
+			t.Fatalf("run(-json) error = %v", err)
+		}
+		var got struct {
+			Total     int `json:"total_requests"`
+			Malformed int `json:"malformed_lines"`
+			TopPaths  []struct {
+				Path  string `json:"path"`
+				Count int    `json:"count"`
+			} `json:"top_paths"`
+			P50 float64 `json:"p50_ms"`
+		}
+		if err := json.Unmarshal(out.Bytes(), &got); err != nil {
+			t.Fatalf("output is not JSON: %v\n%s", err, out.String())
+		}
+		if got.Total != 3 || got.Malformed != 1 || len(got.TopPaths) != 1 || got.TopPaths[0].Path != "/api/items" || got.TopPaths[0].Count != 2 || got.P50 != 42 {
+			t.Errorf("json report = %+v, want 3 total, 1 malformed, /api/items x2, p50 42", got)
+		}
+	})
+
+	t.Run("help", func(t *testing.T) {
+		err := run([]string{"-h"}, nil, &bytes.Buffer{}, &bytes.Buffer{})
+		if !errors.Is(err, flag.ErrHelp) {
+			t.Errorf("run(-h) = %v, want flag.ErrHelp", err)
+		}
+	})
+}
