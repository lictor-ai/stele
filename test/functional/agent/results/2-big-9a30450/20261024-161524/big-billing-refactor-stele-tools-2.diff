diff --git a/internal/billing/discount.go b/internal/billing/discount.go
new file mode 100644
index 0000000..abf0cca
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,104 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// DiscountCode is a percentage or fixed-amount discount.
+// Exactly one of PercentBP and FixedCents must be set (positive).
+type DiscountCode struct {
+	Code       string
+	PercentBP  int64     // percent off in basis points (1000 = 10%, max 10000)
+	FixedCents int64     // fixed amount off, in cents
+	ExpiresAt  time.Time // zero means no expiry
+}
+
+func (c DiscountCode) validate() error {
+	pct, fixed := c.PercentBP != 0, c.FixedCents != 0
+	if c.Code == "" || pct == fixed || c.PercentBP < 0 || c.PercentBP > 10000 || c.FixedCents < 0 {
+		return fmt.Errorf("check code %q: %w", c.Code, ErrCodeInvalid)
+	}
+	return nil
+}
+
+// amountOff returns the discount for a total, capped so the total never goes below zero.
+// Percentages are rounded half up to the nearest cent (totals are non-negative).
+func (c DiscountCode) amountOff(total int64) int64 {
+	off := c.FixedCents
+	if c.PercentBP != 0 {
+		off = (total*c.PercentBP + 5000) / 10000
+	}
+	return max(0, min(off, total))
+}
+
+// Redemptions records which customers have used which codes. It is safe for concurrent use.
+type Redemptions struct {
+	mu   sync.RWMutex // guards used
+	used map[[2]string]bool
+}
+
+// NewRedemptions returns an empty redemption record.
+func NewRedemptions() *Redemptions {
+	return &Redemptions{used: map[[2]string]bool{}}
+}
+
+// Used reports whether customer has already redeemed code.
+func (r *Redemptions) Used(customer, code string) bool {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	return r.used[[2]string{customer, code}]
+}
+
+// redeem atomically marks the code used, failing if it already was.
+func (r *Redemptions) redeem(customer, code string) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	k := [2]string{customer, code}
+	if r.used[k] {
+		return fmt.Errorf("redeem %q for %q: %w", code, customer, ErrCodeReused)
+	}
+	r.used[k] = true
+	return nil
+}
+
+// TaxRates maps a region (e.g. "FR", "US-CA") to a tax rate in basis points (2000 = 20%).
+type TaxRates map[string]int64
+
+// Price applies at most one discount code and regional tax to inv, returning the result.
+// TotalCents is the pre-discount subtotal; DiscountCents is subtracted from it, tax is
+// computed (rounded half up) on the discounted amount, and GrandTotalCents is the sum.
+// code may be nil to skip discounting; a code requires redemptions. The code is only
+// recorded as used if pricing succeeds. clk is used for expiry checks.
+func Price(inv Invoice, region string, rates TaxRates, code *DiscountCode, redemptions *Redemptions, clk clock.Clock) (Invoice, error) {
+	rate, ok := rates[region]
+	if !ok {
+		return inv, fmt.Errorf("price invoice %s: %w: %q", inv.ID, ErrUnknownRegion, region)
+	}
+	var off int64
+	if code != nil {
+		if redemptions == nil {
+			return inv, fmt.Errorf("price invoice %s: no redemption record: %w", inv.ID, ErrCodeInvalid)
+		}
+		if err := code.validate(); err != nil {
+			return inv, err
+		}
+		if !code.ExpiresAt.IsZero() && !clk.Now().Before(code.ExpiresAt) {
+			return inv, fmt.Errorf("price invoice %s: code %q: %w", inv.ID, code.Code, ErrCodeExpired)
+		}
+		off = code.amountOff(inv.TotalCents)
+		if err := redemptions.redeem(inv.Customer, code.Code); err != nil {
+			return inv, err
+		}
+	}
+	net := inv.TotalCents - off
+	tax := (net*rate + 5000) / 10000
+	inv.Region = region
+	inv.DiscountCents = off
+	inv.TaxCents = tax
+	inv.GrandTotalCents = net + tax
+	return inv, nil
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
new file mode 100644
index 0000000..b602648
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,15 @@
+package billing
+
+import "errors"
+
+// Errors returned by Price.
+var (
+	// ErrCodeExpired means the discount code is past its expiry time.
+	ErrCodeExpired = errors.New("billing: discount code expired")
+	// ErrCodeReused means the customer already used the discount code.
+	ErrCodeReused = errors.New("billing: discount code already used by customer")
+	// ErrCodeInvalid means the discount code is malformed.
+	ErrCodeInvalid = errors.New("billing: invalid discount code")
+	// ErrUnknownRegion means the tax table has no rate for the region.
+	ErrUnknownRegion = errors.New("billing: unknown tax region")
+)
