--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,36 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+	"time"
+)
+
+// WriteCSV writes invoices as CSV with a header row. Amounts are in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	header := []string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}
+	if err := cw.Write(header); err != nil {
+		return fmt.Errorf("write csv header: %w", err)
+	}
+	for _, inv := range invoices {
+		rec := []string{
+			inv.ID, inv.Customer, inv.Region,
+			inv.IssuedAt.Format(time.RFC3339),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := cw.Write(rec); err != nil {
+			return fmt.Errorf("write csv invoice %s: %w", inv.ID, err)
+		}
+	}
+	cw.Flush()
+	if err := cw.Error(); err != nil {
+		return fmt.Errorf("flush csv: %w", err)
+	}
+	return nil
+}
diff --git a/internal/billing/pricing_test.go b/internal/billing/pricing_test.go
new file mode 100644
index 0000000..b3129ef
--- /dev/null
+++ b/internal/billing/pricing_test.go
@@ -0,0 +1,204 @@
+package billing
+
+import (
+	"bytes"
+	"encoding/csv"
+	"errors"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var (
+	t0    = time.Date(2025, 1, 1, 12, 0, 0, 0, time.UTC)
+	clk   = clock.Fixed{T: t0}
+	rates = TaxRates{"FR": 2000, "DE": 1900, "US-CA": 725, "NONE": 0}
+)
+
+func testInvoice(total int64) Invoice {
+	return Invoice{ID: "i1", Customer: "acme", TotalCents: total, IssuedAt: t0}
+}
+
+func TestPrice(t *testing.T) {
+	tests := []struct {
+		name                 string
+		total                int64
+		region               string
+		code                 *DiscountCode
+		discount, tax, grand int64
+		wantErr              error
+	}{
+		{name: "no discount", total: 1000, region: "FR", tax: 200, grand: 1200},
+		{name: "zero total", total: 0, region: "FR"},
+		{name: "zero rate", total: 1000, region: "NONE", grand: 1000},
+		{name: "unknown region", total: 1000, region: "XX", wantErr: ErrUnknownRegion},
+		{name: "empty region", total: 1000, region: "", wantErr: ErrUnknownRegion},
+		{name: "tax on discounted total", total: 1001, region: "US-CA",
+			code: &DiscountCode{Code: "T", FixedCents: 100}, discount: 100, tax: 65, grand: 966},
+		{name: "percent 10", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "P", PercentBP: 1000}, discount: 100, grand: 900},
+		{name: "percent half rounds up", total: 5, region: "NONE",
+			code: &DiscountCode{Code: "P", PercentBP: 1000}, discount: 1, grand: 4},
+		{name: "percent below half rounds down", total: 4, region: "NONE",
+			code: &DiscountCode{Code: "P", PercentBP: 1000}, discount: 0, grand: 4},
+		{name: "percent fractional", total: 999, region: "NONE",
+			code: &DiscountCode{Code: "P", PercentBP: 3333}, discount: 333, grand: 666},
+		{name: "percent 100", total: 1000, region: "FR",
+			code: &DiscountCode{Code: "P", PercentBP: 10000}, discount: 1000},
+		{name: "fixed floors at zero", total: 1000, region: "FR",
+			code: &DiscountCode{Code: "BIG", FixedCents: 5000}, discount: 1000},
+		{name: "fixed on zero total", total: 0, region: "FR",
+			code: &DiscountCode{Code: "F", FixedCents: 5}},
+		{name: "not yet expired", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "E", FixedCents: 100, ExpiresAt: t0.Add(time.Second)}, discount: 100, grand: 900},
+		{name: "expired at instant", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "E", FixedCents: 100, ExpiresAt: t0}, wantErr: ErrCodeExpired},
+		{name: "expired earlier", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "E", FixedCents: 100, ExpiresAt: t0.Add(-time.Hour)}, wantErr: ErrCodeExpired},
+		{name: "empty code name", total: 1000, region: "NONE",
+			code: &DiscountCode{FixedCents: 1}, wantErr: ErrCodeInvalid},
+		{name: "neither kind", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "A"}, wantErr: ErrCodeInvalid},
+		{name: "both kinds", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "B", FixedCents: 1, PercentBP: 1}, wantErr: ErrCodeInvalid},
+		{name: "percent over 100", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "C", PercentBP: 10001}, wantErr: ErrCodeInvalid},
+		{name: "negative fixed", total: 1000, region: "NONE",
+			code: &DiscountCode{Code: "D", FixedCents: -5}, wantErr: ErrCodeInvalid},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := NewRedemptions()
+			got, err := Price(testInvoice(tc.total), tc.region, rates, tc.code, r, clk)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Price(%d, %q) error = %v, want %v", tc.total, tc.region, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				if tc.code != nil && r.Used("acme", tc.code.Code) {
+					t.Errorf("Price(%d, %q) recorded code as used despite error", tc.total, tc.region)
+				}
+				return
+			}
+			if got.DiscountCents != tc.discount || got.TaxCents != tc.tax || got.GrandTotalCents != tc.grand || got.Region != tc.region {
+				t.Errorf("Price(%d, %q) = discount %d tax %d grand %d region %q, want discount %d tax %d grand %d",
+					tc.total, tc.region, got.DiscountCents, got.TaxCents, got.GrandTotalCents, got.Region,
+					tc.discount, tc.tax, tc.grand)
+			}
+		})
+	}
+}
+
+func TestPriceCodeWithoutRedemptions(t *testing.T) {
+	_, err := Price(testInvoice(1000), "FR", rates, &DiscountCode{Code: "A", FixedCents: 1}, nil, clk)
+	if !errors.Is(err, ErrCodeInvalid) {
+		t.Errorf("Price(code, nil redemptions) error = %v, want %v", err, ErrCodeInvalid)
+	}
+}
+
+func TestPriceReuse(t *testing.T) {
+	c := &DiscountCode{Code: "ONCE", FixedCents: 100}
+	r := NewRedemptions()
+	globex := testInvoice(1000)
+	globex.Customer = "globex"
+
+	steps := []struct {
+		name    string
+		inv     Invoice
+		region  string
+		wantErr error
+	}{
+		{name: "first use", inv: testInvoice(1000), region: "FR"},
+		{name: "same customer again", inv: testInvoice(1000), region: "FR", wantErr: ErrCodeReused},
+		{name: "other customer", inv: globex, region: "FR"},
+		{name: "other customer again", inv: globex, region: "FR", wantErr: ErrCodeReused},
+	}
+	for _, s := range steps {
+		t.Run(s.name, func(t *testing.T) {
+			_, err := Price(s.inv, s.region, rates, c, r, clk)
+			if !errors.Is(err, s.wantErr) {
+				t.Errorf("Price(%s, %q) error = %v, want %v", s.inv.Customer, s.region, err, s.wantErr)
+			}
+		})
+	}
+}
+
+func TestPriceFailureKeepsCodeUnused(t *testing.T) {
+	c := &DiscountCode{Code: "X", FixedCents: 100}
+	r := NewRedemptions()
+	if _, err := Price(testInvoice(1000), "XX", rates, c, r, clk); !errors.Is(err, ErrUnknownRegion) {
+		t.Fatalf("Price(unknown region) error = %v, want %v", err, ErrUnknownRegion)
+	}
+	if _, err := Price(testInvoice(1000), "FR", rates, c, r, clk); err != nil {
+		t.Errorf("Price after failed attempt = %v, want nil", err)
+	}
+}
+
+func TestComputeGrandTotal(t *testing.T) {
+	tests := []struct {
+		name  string
+		lines []Line
+		want  int64
+	}{
+		{name: "no lines", want: 0},
+		{name: "lines", lines: []Line{{Quantity: 2, UnitCents: 50}, {Quantity: 1, UnitCents: 5}}, want: 105},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Compute("a", "b", tc.lines)
+			if got.GrandTotalCents != tc.want || got.TotalCents != tc.want {
+				t.Errorf("Compute(%v) = total %d grand %d, want %d", tc.lines, got.TotalCents, got.GrandTotalCents, tc.want)
+			}
+		})
+	}
+}
+
+func TestWriteCSV(t *testing.T) {
+	priced, err := Price(testInvoice(1000), "FR", rates, &DiscountCode{Code: "C", FixedCents: 100}, NewRedemptions(), clk)
+	if err != nil {
+		t.Fatal(err)
+	}
+	quoted := priced
+	quoted.ID = "i2"
+	quoted.Customer = `Acme, "Inc"`
+	local := testInvoice(500)
+	local.ID = "i3"
+	local.IssuedAt = time.Date(2025, 3, 4, 5, 6, 7, 0, time.FixedZone("x", 3600))
+
+	header := []string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}
+	tests := []struct {
+		name string
+		in   []Invoice
+		want [][]string
+	}{
+		{name: "empty", want: [][]string{header}},
+		{name: "priced", in: []Invoice{priced}, want: [][]string{header,
+			{"i1", "acme", "FR", "2025-01-01T12:00:00Z", "1000", "100", "180", "1080"}}},
+		{name: "quoting", in: []Invoice{quoted}, want: [][]string{header,
+			{"i2", `Acme, "Inc"`, "FR", "2025-01-01T12:00:00Z", "1000", "100", "180", "1080"}}},
+		{name: "offset time and no region", in: []Invoice{local}, want: [][]string{header,
+			{"i3", "acme", "", "2025-03-04T05:06:07+01:00", "500", "0", "0", "0"}}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := WriteCSV(&buf, tc.in); err != nil {
+				t.Fatalf("WriteCSV error = %v", err)
+			}
+			got, err := csv.NewReader(strings.NewReader(buf.String())).ReadAll()
+			if err != nil {
+				t.Fatalf("parse output %q: %v", buf.String(), err)
+			}
+			if len(got) != len(tc.want) {
+				t.Fatalf("WriteCSV rows = %v, want %v", got, tc.want)
+			}
+			for i := range tc.want {
+				if !slices.Equal(got[i], tc.want[i]) {
+					t.Errorf("WriteCSV row %d = %q, want %q", i, got[i], tc.want[i])
+				}
+			}
+		})
+	}
+}
