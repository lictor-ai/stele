+func TestListOrderFilterPaginate(t *testing.T) {
+	// Fixed clock: ordering must not depend on timestamps.
+	s := NewStore(clock.Fixed{T: time.Unix(1, 0)})
+	for i := 0; i < 5; i++ {
+		c, _ := s.Create(fmt.Sprint(i))
+		if i%2 == 0 {
+			s.Update(c.ID, Update{Done: ptr(true)})
+		}
+	}
+	if got := titles(s.List(ListOptions{})); got != "4,3,2,1,0" {
+		t.Errorf("all = %s", got)
+	}
+	if got := titles(s.List(ListOptions{Done: ptr(true)})); got != "4,2,0" {
+		t.Errorf("done = %s", got)
+	}
+	if got := titles(s.List(ListOptions{Done: ptr(false)})); got != "3,1" {
+		t.Errorf("not done = %s", got)
+	}
+	if got := titles(s.List(ListOptions{Limit: 2, Offset: 1})); got != "3,2" {
+		t.Errorf("page = %s", got)
+	}
+	if got := titles(s.List(ListOptions{Done: ptr(true), Limit: 1, Offset: 1})); got != "2" {
+		t.Errorf("filtered page = %s", got)
+	}
+	if got := s.List(ListOptions{Offset: 10}); got == nil || len(got) != 0 {
+		t.Errorf("past end = %#v", got)
+	}
+}
