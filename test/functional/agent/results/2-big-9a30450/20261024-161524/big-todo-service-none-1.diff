+func TestUpdate(t *testing.T) {
+	s := NewStore(clock.Fixed{T: time.Unix(1, 0)})
+	c, _ := s.Create("a")
+	u, err := s.Update(c.ID, Update{Done: ptr(true)})
+	if err != nil || !u.Done || u.Title != "a" {
+		t.Fatalf("got %+v, %v", u, err)
+	}
+	u, err = s.Update(c.ID, Update{Title: ptr(" b ")})
+	if err != nil || u.Title != "b" || !u.Done {
+		t.Fatalf("got %+v, %v", u, err)
+	}
+	if _, err := s.Update(c.ID, Update{Title: ptr("")}); !errors.Is(err, ErrInvalidTitle) {
+		t.Fatalf("err = %v", err)
+	}
+	if g, _ := s.Get(c.ID); g.Title != "b" {
+		t.Fatalf("title changed on failed update: %+v", g)
+	}
+	if _, err := s.Update("nope", Update{}); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("err = %v", err)
+	}
+}
