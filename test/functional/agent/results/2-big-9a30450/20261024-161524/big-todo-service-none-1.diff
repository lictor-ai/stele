+func TestConcurrent(t *testing.T) {
+	s := NewStore(nil)
+	const workers, per = 16, 50
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < per; i++ {
+				c, err := s.Create("x")
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				s.Update(c.ID, Update{Done: ptr(true)})
+				s.Get(c.ID)
+				s.List(ListOptions{Limit: 10})
+				if i%2 == 0 {
+					if err := s.Delete(c.ID); err != nil {
+						t.Error(err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if n := len(s.List(ListOptions{})); n != workers*per/2 {
+		t.Fatalf("len = %d, want %d", n, workers*per/2)
+	}
+}
