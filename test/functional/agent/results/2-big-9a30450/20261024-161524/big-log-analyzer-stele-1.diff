new file mode 100644
index 0000000..9137d3e
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,97 @@
+// Command loga summarises nginx access logs.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// errUsage marks errors caused by bad flags; main exits 2 for them, and 1 for
+// any other error.
+var errUsage = errors.New("usage error")
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	stop()
+	switch {
+	case err == nil:
+	case errors.Is(err, errUsage):
+		fmt.Fprintln(os.Stderr, "loga:", err)
+		os.Exit(2)
+	default:
+		fmt.Fprintln(os.Stderr, "loga:", err)
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: loga [-top N] [-json] [file ...]")
+		fs.PrintDefaults()
+	}
+	top := fs.Int("top", 10, "number of paths to list")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return fmt.Errorf("%w: %w", errUsage, err)
+	}
+	if *top < 0 {
+		return fmt.Errorf("%w: -top must not be negative, got %d", errUsage, *top)
+	}
+
+	c := stats.NewCollector()
+	if fs.NArg() == 0 {
+		if err := collect(ctx, stdin, c); err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+	}
+	for _, name := range fs.Args() {
+		if err := collectFile(ctx, name, c); err != nil {
+			return err
+		}
+	}
+
+	report := c.Report(*top)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(report); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+		return nil
+	}
+	return report.WriteText(stdout)
+}
+
+func collect(ctx context.Context, r io.Reader, c *stats.Collector) error {
+	bad, err := logparse.Read(ctx, r, c.Add)
+	c.AddMalformed(bad)
+	return err
+}
+
+func collectFile(ctx context.Context, name string, c *stats.Collector) error {
+	f, err := os.Open(name)
+	if err != nil {
+		return fmt.Errorf("open log: %w", err)
+	}
+	defer f.Close()
+	if err := collect(ctx, f, c); err != nil {
+		return fmt.Errorf("read %s: %w", name, err)
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..5395b32
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,132 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/stats"
+)
+
+const sample = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 502 0 "-" "curl/8.0" 0.100
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "POST /login HTTP/1.1" 302 0 "-" "curl/8.0" 0.010
+this is not a log line
+`
+
+func writeFile(t *testing.T, name, content string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), name)
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatalf("WriteFile(%s) error = %v, want nil", p, err)
+	}
+	return p
+}
+
+func TestRun(t *testing.T) {
+	logFile := writeFile(t, "a.log", sample)
+	second := writeFile(t, "b.log", sample)
+	missing := filepath.Join(t.TempDir(), "nope.log")
+
+	tests := []struct {
+		name       string
+		args       []string
+		stdin      string
+		wantErr    error
+		wantUsage  bool
+		wantOut    []string
+		wantNotOut []string
+	}{
+		{name: "stdin text", stdin: sample, wantOut: []string{"Total requests:  3", "Malformed lines: 1", "/api/items", "/login", "2026-10-10T13:00Z"}, wantNotOut: []string{"id=3"}},
+		{name: "file text", args: []string{logFile}, wantOut: []string{"Total requests:  3", "Malformed lines: 1"}},
+		{name: "two files add up", args: []string{logFile, second}, wantOut: []string{"Total requests:  6", "Malformed lines: 2"}},
+		{name: "empty stdin", stdin: "", wantOut: []string{"Total requests:  0", "Malformed lines: 0"}},
+		{name: "top limits paths", args: []string{"-top", "1", logFile}, wantOut: []string{"/api/items"}, wantNotOut: []string{"/login"}},
+		{name: "missing file", args: []string{missing}, wantErr: os.ErrNotExist},
+		{name: "missing file after good one", args: []string{logFile, missing}, wantErr: os.ErrNotExist},
+		{name: "bad flag", args: []string{"-bogus"}, wantUsage: true},
+		{name: "non numeric top", args: []string{"-top", "many"}, wantUsage: true},
+		{name: "negative top", args: []string{"-top", "-1"}, wantUsage: true},
+		{name: "help", args: []string{"-h"}, wantOut: nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(context.Background(), tt.args, strings.NewReader(tt.stdin), &out, &errOut)
+			switch {
+			case tt.wantUsage:
+				if !errors.Is(err, errUsage) {
+					t.Fatalf("run(%v) error = %v, want errUsage", tt.args, err)
+				}
+			case tt.wantErr != nil:
+				if !errors.Is(err, tt.wantErr) || errors.Is(err, errUsage) {
+					t.Fatalf("run(%v) error = %v, want %v and not a usage error", tt.args, err, tt.wantErr)
+				}
+			case err != nil:
+				t.Fatalf("run(%v) error = %v, want nil", tt.args, err)
+			}
+			for _, w := range tt.wantOut {
+				if !strings.Contains(out.String(), w) {
+					t.Errorf("run(%v) output = %q, want it to contain %q", tt.args, out.String(), w)
+				}
+			}
+			for _, w := range tt.wantNotOut {
+				if strings.Contains(out.String(), w) {
+					t.Errorf("run(%v) output = %q, want it not to contain %q", tt.args, out.String(), w)
+				}
+			}
+		})
+	}
+}
+
+func TestRunJSON(t *testing.T) {
+	var out, errOut bytes.Buffer
+	err := run(context.Background(), []string{"-json"}, strings.NewReader(sample), &out, &errOut)
+	if err != nil {
+		t.Fatalf("run(-json) error = %v, want nil", err)
+	}
+	var got stats.Report
+	if err := json.Unmarshal(out.Bytes(), &got); err != nil {
+		t.Fatalf("run(-json) output %q is not a report: %v", out.String(), err)
+	}
+	tests := []struct {
+		name      string
+		got, want int
+	}{
+		{"total", got.TotalRequests, 3},
+		{"malformed", got.MalformedLines, 1},
+		{"2xx", got.StatusClasses.C2xx, 1},
+		{"3xx", got.StatusClasses.C3xx, 1},
+		{"5xx", got.StatusClasses.C5xx, 1},
+		{"top paths", len(got.TopPaths), 2},
+		{"error hours", len(got.ErrorsPerHour), 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.got != tt.want {
+				t.Errorf("run(-json) %s = %d, want %d", tt.name, tt.got, tt.want)
+			}
+		})
+	}
+	if got.LatencyMS.P99 != 100 || got.LatencyMS.P50 != 42 {
+		t.Errorf("run(-json) latency = %+v, want p50 42 and p99 100", got.LatencyMS)
+	}
+	if got.TopPaths[0].Path != "/api/items" || got.TopPaths[0].Count != 2 {
+		t.Errorf("run(-json) top path = %+v, want /api/items x2", got.TopPaths[0])
+	}
+}
+
+func TestRunCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var out, errOut bytes.Buffer
+	err := run(ctx, nil, strings.NewReader(sample), &out, &errOut)
+	if !errors.Is(err, context.Canceled) {
+		t.Errorf("run(cancelled ctx) error = %v, want context.Canceled", err)
+	}
+}
