+package stats
+
+import "errors"
+
+// ErrNoData is returned by Percentile when there are no values.
+var ErrNoData = errors.New("no data")
+
+// ErrBadPercentile is returned by Percentile when p is not in (0, 100].
+var ErrBadPercentile = errors.New("percentile out of range")
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..e69cb89
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,190 @@
+// Package stats aggregates parsed log entries into a report.
+package stats
+
+import (
+	"fmt"
+	"io"
+	"math"
+	"slices"
+	"sort"
+	"strings"
+	"text/tabwriter"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+const hourLayout = "2006-01-02T15:00Z"
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// StatusClasses counts requests per status class. Other holds statuses below
+// 200.
+type StatusClasses struct {
+	Other int `json:"other"`
+	C2xx  int `json:"2xx"`
+	C3xx  int `json:"3xx"`
+	C4xx  int `json:"4xx"`
+	C5xx  int `json:"5xx"`
+}
+
+// Latency holds request time percentiles in milliseconds.
+type Latency struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// HourCount is the number of 5xx responses in one UTC hour.
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// Report is the summary of a set of log entries.
+type Report struct {
+	TotalRequests  int           `json:"total_requests"`
+	MalformedLines int           `json:"malformed_lines"`
+	TopPaths       []PathCount   `json:"top_paths"`
+	StatusClasses  StatusClasses `json:"status_classes"`
+	LatencyMS      Latency       `json:"latency_ms"`
+	ErrorsPerHour  []HourCount   `json:"errors_per_hour"`
+}
+
+// Collector accumulates entries. The zero value is not usable; call
+// NewCollector.
+type Collector struct {
+	total     int
+	malformed int
+	paths     map[string]int
+	classes   StatusClasses
+	millis    []float64
+	errHours  map[time.Time]int
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{paths: map[string]int{}, errHours: map[time.Time]int{}}
+}
+
+// AddMalformed records n lines that could not be parsed.
+func (c *Collector) AddMalformed(n int) { c.malformed += n }
+
+// Add records one request.
+func (c *Collector) Add(e logparse.Entry) {
+	c.total++
+	c.paths[e.Path]++
+	c.millis = append(c.millis, float64(e.Duration)/float64(time.Millisecond))
+	switch {
+	case e.Status >= 500:
+		c.classes.C5xx++
+		c.errHours[e.Time.UTC().Truncate(time.Hour)]++
+	case e.Status >= 400:
+		c.classes.C4xx++
+	case e.Status >= 300:
+		c.classes.C3xx++
+	case e.Status >= 200:
+		c.classes.C2xx++
+	default:
+		c.classes.Other++
+	}
+}
+
+// Report summarises what was collected. At most top paths are listed, most
+// requested first, ties broken by path. A top below 1 lists none.
+func (c *Collector) Report(top int) Report {
+	r := Report{
+		TotalRequests:  c.total,
+		MalformedLines: c.malformed,
+		TopPaths:       []PathCount{},
+		StatusClasses:  c.classes,
+		ErrorsPerHour:  []HourCount{},
+	}
+
+	all := make([]PathCount, 0, len(c.paths))
+	for p, n := range c.paths {
+		all = append(all, PathCount{p, n})
+	}
+	sort.Slice(all, func(i, j int) bool {
+		if all[i].Count != all[j].Count {
+			return all[i].Count > all[j].Count
+		}
+		return all[i].Path < all[j].Path
+	})
+	if top > 0 {
+		r.TopPaths = append(r.TopPaths, all[:min(top, len(all))]...)
+	}
+
+	sorted := slices.Clone(c.millis)
+	slices.Sort(sorted)
+	r.LatencyMS = Latency{P50: percentileOrZero(sorted, 50), P95: percentileOrZero(sorted, 95), P99: percentileOrZero(sorted, 99)}
+
+	hours := make([]time.Time, 0, len(c.errHours))
+	for h := range c.errHours {
+		hours = append(hours, h)
+	}
+	slices.SortFunc(hours, func(a, b time.Time) int { return a.Compare(b) })
+	for _, h := range hours {
+		r.ErrorsPerHour = append(r.ErrorsPerHour, HourCount{h.Format(hourLayout), c.errHours[h]})
+	}
+	return r
+}
+
+// Percentile returns the p-th percentile of sorted (ascending) using the
+// nearest-rank method. p must be in (0, 100]; sorted must not be empty.
+func Percentile(sorted []float64, p float64) (float64, error) {
+	if math.IsNaN(p) || p <= 0 || p > 100 {
+		return 0, fmt.Errorf("percentile %v: %w", p, ErrBadPercentile)
+	}
+	if len(sorted) == 0 {
+		return 0, fmt.Errorf("percentile %v: %w", p, ErrNoData)
+	}
+	rank := int(math.Ceil(p / 100 * float64(len(sorted))))
+	return sorted[min(max(rank, 1), len(sorted))-1], nil
+}
+
+func percentileOrZero(sorted []float64, p float64) float64 {
+	v, err := Percentile(sorted, p)
+	if err != nil {
+		return 0
+	}
+	return v
+}
+
+// WriteText writes the report as a plain text table.
+func (r Report) WriteText(w io.Writer) error {
+	var b strings.Builder
+	fmt.Fprintf(&b, "Total requests:  %d\n", r.TotalRequests)
+	fmt.Fprintf(&b, "Malformed lines: %d\n", r.MalformedLines)
+
+	tw := tabwriter.NewWriter(&b, 0, 4, 2, ' ', 0)
+	fmt.Fprintln(tw, "\nTop paths")
+	fmt.Fprintln(tw, "COUNT\tPATH")
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(tw, "%d\t%s\n", p.Count, p.Path)
+	}
+	fmt.Fprintln(tw, "\nStatus classes")
+	fmt.Fprintln(tw, "CLASS\tCOUNT")
+	fmt.Fprintf(tw, "2xx\t%d\n3xx\t%d\n4xx\t%d\n5xx\t%d\n", r.StatusClasses.C2xx, r.StatusClasses.C3xx, r.StatusClasses.C4xx, r.StatusClasses.C5xx)
+	if r.StatusClasses.Other > 0 {
+		fmt.Fprintf(tw, "other\t%d\n", r.StatusClasses.Other)
+	}
+	fmt.Fprintln(tw, "\nRequest time (ms)")
+	fmt.Fprintf(tw, "p50\t%.3f\np95\t%.3f\np99\t%.3f\n", r.LatencyMS.P50, r.LatencyMS.P95, r.LatencyMS.P99)
+	fmt.Fprintln(tw, "\n5xx per hour (UTC)")
+	fmt.Fprintln(tw, "HOUR\tCOUNT")
+	for _, h := range r.ErrorsPerHour {
+		fmt.Fprintf(tw, "%s\t%d\n", h.Hour, h.Count)
+	}
+	if err := tw.Flush(); err != nil {
+		return fmt.Errorf("format report: %w", err)
+	}
+	if _, err := io.WriteString(w, b.String()); err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	return nil
+}
