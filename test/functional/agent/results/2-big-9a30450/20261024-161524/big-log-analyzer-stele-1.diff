@@ -0,0 +1,252 @@
+package stats
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"math"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestPercentile(t *testing.T) {
+	hundred := make([]float64, 100)
+	for i := range hundred {
+		hundred[i] = float64(i + 1)
+	}
+	tests := []struct {
+		name    string
+		in      []float64
+		p       float64
+		want    float64
+		wantErr error
+	}{
+		{"single value p50", []float64{7}, 50, 7, nil},
+		{"single value p99", []float64{7}, 99, 7, nil},
+		{"single value p100", []float64{7}, 100, 7, nil},
+		{"two values p50", []float64{1, 2}, 50, 1, nil},
+		{"two values p51", []float64{1, 2}, 51, 2, nil},
+		{"four values p50", []float64{1, 2, 3, 4}, 50, 2, nil},
+		{"four values p75", []float64{1, 2, 3, 4}, 75, 3, nil},
+		{"hundred p50", hundred, 50, 50, nil},
+		{"hundred p95", hundred, 95, 95, nil},
+		{"hundred p99", hundred, 99, 99, nil},
+		{"hundred p100", hundred, 100, 100, nil},
+		{"tiny p keeps first", hundred, 0.0001, 1, nil},
+		{"duplicates", []float64{5, 5, 5, 5}, 99, 5, nil},
+		{"empty", nil, 50, 0, ErrNoData},
+		{"zero p", []float64{1}, 0, 0, ErrBadPercentile},
+		{"negative p", []float64{1}, -1, 0, ErrBadPercentile},
+		{"p over 100", []float64{1}, 100.5, 0, ErrBadPercentile},
+		{"nan p", []float64{1}, math.NaN(), 0, ErrBadPercentile},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Percentile(tt.in, tt.p)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Percentile(%v, %v) error = %v, want %v", tt.in, tt.p, err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("Percentile(%v, %v) = %v, want %v", tt.in, tt.p, got, tt.want)
+			}
+		})
+	}
+}
+
+func entry(path string, status int, ms int, at time.Time) logparse.Entry {
+	return logparse.Entry{Time: at, Method: "GET", Path: path, Status: status, Duration: time.Duration(ms) * time.Millisecond}
+}
+
+func TestReport(t *testing.T) {
+	h13 := time.Date(2026, 10, 10, 13, 5, 0, 0, time.UTC)
+	h14 := time.Date(2026, 10, 10, 14, 59, 59, 0, time.UTC)
+	plus2 := time.Date(2026, 10, 10, 15, 30, 0, 0, time.FixedZone("x", 2*3600)) // 13:30 UTC
+
+	many := func() []logparse.Entry {
+		var es []logparse.Entry
+		for i := 1; i <= 100; i++ {
+			es = append(es, entry("/p", 200, i, h13))
+		}
+		return es
+	}
+
+	tests := []struct {
+		name      string
+		entries   []logparse.Entry
+		malformed int
+		top       int
+		check     func(t *testing.T, r Report)
+	}{
+		{
+			name: "empty",
+			top:  10,
+			check: func(t *testing.T, r Report) {
+				if r.TotalRequests != 0 || r.LatencyMS != (Latency{}) || r.StatusClasses != (StatusClasses{}) {
+					t.Errorf("Report() on no input = %+v, want all zero", r)
+				}
+				if r.TopPaths == nil || r.ErrorsPerHour == nil || len(r.TopPaths) != 0 || len(r.ErrorsPerHour) != 0 {
+					t.Errorf("Report() slices = %v, %v, want empty non-nil", r.TopPaths, r.ErrorsPerHour)
+				}
+			},
+		},
+		{
+			name:      "malformed only",
+			malformed: 3,
+			top:       10,
+			check: func(t *testing.T, r Report) {
+				if r.TotalRequests != 0 || r.MalformedLines != 3 {
+					t.Errorf("Report() = total %d malformed %d, want 0, 3", r.TotalRequests, r.MalformedLines)
+				}
+			},
+		},
+		{
+			name:    "single request",
+			entries: []logparse.Entry{entry("/a", 200, 42, h13)},
+			top:     10,
+			check: func(t *testing.T, r Report) {
+				if r.TotalRequests != 1 || r.StatusClasses.C2xx != 1 {
+					t.Errorf("Report() = %+v, want one 2xx request", r)
+				}
+				if r.LatencyMS != (Latency{42, 42, 42}) {
+					t.Errorf("Report().LatencyMS = %+v, want 42 for every percentile", r.LatencyMS)
+				}
+				if len(r.TopPaths) != 1 || r.TopPaths[0] != (PathCount{"/a", 1}) {
+					t.Errorf("Report().TopPaths = %v, want [/a 1]", r.TopPaths)
+				}
+			},
+		},
+		{
+			name:    "status classes",
+			entries: []logparse.Entry{entry("/", 200, 1, h13), entry("/", 204, 1, h13), entry("/", 301, 1, h13), entry("/", 404, 1, h13), entry("/", 499, 1, h13), entry("/", 500, 1, h13), entry("/", 599, 1, h13), entry("/", 101, 1, h13)},
+			top:     10,
+			check: func(t *testing.T, r Report) {
+				want := StatusClasses{Other: 1, C2xx: 2, C3xx: 1, C4xx: 2, C5xx: 2}
+				if r.StatusClasses != want {
+					t.Errorf("Report().StatusClasses = %+v, want %+v", r.StatusClasses, want)
+				}
+			},
+		},
+		{
+			name:    "top paths ordering and limit",
+			entries: []logparse.Entry{entry("/b", 200, 1, h13), entry("/a", 200, 1, h13), entry("/c", 200, 1, h13), entry("/c", 200, 1, h13), entry("/b", 200, 1, h13), entry("/d", 200, 1, h13)},
+			top:     3,
+			check: func(t *testing.T, r Report) {
+				want := []PathCount{{"/b", 2}, {"/c", 2}, {"/a", 1}}
+				if !slices.Equal(r.TopPaths, want) {
+					t.Errorf("Report(3).TopPaths = %v, want %v", r.TopPaths, want)
+				}
+			},
+		},
+		{
+			name:    "top larger than distinct paths",
+			entries: []logparse.Entry{entry("/a", 200, 1, h13)},
+			top:     50,
+			check: func(t *testing.T, r Report) {
+				if len(r.TopPaths) != 1 {
+					t.Errorf("Report(50).TopPaths = %v, want 1 entry", r.TopPaths)
+				}
+			},
+		},
+		{
+			name:    "top zero",
+			entries: []logparse.Entry{entry("/a", 200, 1, h13)},
+			top:     0,
+			check: func(t *testing.T, r Report) {
+				if len(r.TopPaths) != 0 {
+					t.Errorf("Report(0).TopPaths = %v, want none", r.TopPaths)
+				}
+			},
+		},
+		{
+			name:    "percentiles over 100 values",
+			entries: many(),
+			top:     1,
+			check: func(t *testing.T, r Report) {
+				if r.LatencyMS != (Latency{50, 95, 99}) {
+					t.Errorf("Report().LatencyMS = %+v, want {50 95 99}", r.LatencyMS)
+				}
+			},
+		},
+		{
+			name:    "percentiles ignore input order",
+			entries: []logparse.Entry{entry("/", 200, 30, h13), entry("/", 200, 10, h13), entry("/", 200, 20, h13)},
+			top:     1,
+			check: func(t *testing.T, r Report) {
+				if r.LatencyMS != (Latency{20, 30, 30}) {
+					t.Errorf("Report().LatencyMS = %+v, want {20 30 30}", r.LatencyMS)
+				}
+			},
+		},
+		{
+			name:    "errors per hour",
+			entries: []logparse.Entry{entry("/", 500, 1, h14), entry("/", 502, 1, h13), entry("/", 503, 1, plus2), entry("/", 404, 1, h13), entry("/", 200, 1, h13)},
+			top:     1,
+			check: func(t *testing.T, r Report) {
+				want := []HourCount{{"2026-10-10T13:00Z", 2}, {"2026-10-10T14:00Z", 1}}
+				if !slices.Equal(r.ErrorsPerHour, want) {
+					t.Errorf("Report().ErrorsPerHour = %v, want %v", r.ErrorsPerHour, want)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			for _, e := range tt.entries {
+				c.Add(e)
+			}
+			c.AddMalformed(tt.malformed)
+			tt.check(t, c.Report(tt.top))
+		})
+	}
+}
+
+func TestReportJSON(t *testing.T) {
+	c := NewCollector()
+	c.AddMalformed(2)
+	c.Add(entry("/a", 500, 12, time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)))
+	out, err := json.Marshal(c.Report(5))
+	if err != nil {
+		t.Fatalf("json.Marshal(Report) error = %v, want nil", err)
+	}
+	var got map[string]any
+	if err := json.Unmarshal(out, &got); err != nil {
+		t.Fatalf("json.Unmarshal(%s) error = %v, want nil", out, err)
+	}
+	for _, key := range []string{"total_requests", "malformed_lines", "top_paths", "status_classes", "latency_ms", "errors_per_hour"} {
+		if _, ok := got[key]; !ok {
+			t.Errorf("Report JSON %s lacks key %q", out, key)
+		}
+	}
+}
+
+func TestWriteText(t *testing.T) {
+	c := NewCollector()
+	c.AddMalformed(1)
+	c.Add(entry("/a", 502, 12, time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)))
+	tests := []struct {
+		name   string
+		report Report
+		want   []string
+	}{
+		{"empty", NewCollector().Report(10), []string{"Total requests:  0", "p50", "5xx per hour"}},
+		{"with data", c.Report(10), []string{"Total requests:  1", "Malformed lines: 1", "/a", "12.000", "2026-10-10T13:00Z"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := tt.report.WriteText(&buf); err != nil {
+				t.Fatalf("WriteText() error = %v, want nil", err)
+			}
+			for _, w := range tt.want {
+				if !strings.Contains(buf.String(), w) {
+					t.Errorf("WriteText() = %q, want it to contain %q", buf.String(), w)
+				}
+			}
+		})
+	}
+}
