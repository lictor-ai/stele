diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..6e6cac6
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,175 @@
+// Package logparse parses nginx access log lines in the combined format with
+// the request time in seconds appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// Entry is one parsed request.
+type Entry struct {
+	Time     time.Time
+	Method   string
+	Path     string // request path with the query string and fragment removed
+	Status   int
+	Bytes    int64
+	Duration time.Duration
+}
+
+// Parse parses one log line. Every error it returns wraps ErrMalformed.
+func Parse(line string) (Entry, error) {
+	line = strings.TrimRight(line, "\r\n")
+	open := strings.IndexByte(line, '[')
+	if open < 0 {
+		return Entry{}, malformed("missing timestamp")
+	}
+	if len(strings.Fields(line[:open])) != 3 {
+		return Entry{}, malformed("want address, ident and user before the timestamp")
+	}
+	end := strings.IndexByte(line[open:], ']')
+	if end < 0 {
+		return Entry{}, malformed("unterminated timestamp")
+	}
+	ts, err := time.Parse(timeLayout, line[open+1:open+end])
+	if err != nil {
+		return Entry{}, malformed("bad timestamp %q", line[open+1:open+end])
+	}
+
+	s := scanner{rest: line[open+end+1:]}
+	request, ok := s.quoted()
+	if !ok {
+		return Entry{}, malformed("missing request")
+	}
+	statusText, _ := s.word()
+	bytesText, _ := s.word()
+	if _, ok := s.quoted(); !ok {
+		return Entry{}, malformed("missing referer")
+	}
+	if _, ok := s.quoted(); !ok {
+		return Entry{}, malformed("missing user agent")
+	}
+	timeText, _ := s.word()
+	if !s.done() {
+		return Entry{}, malformed("unexpected trailing data")
+	}
+
+	parts := strings.Fields(request)
+	if len(parts) != 3 {
+		return Entry{}, malformed("bad request line %q", request)
+	}
+	status, err := strconv.Atoi(statusText)
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, malformed("bad status %q", statusText)
+	}
+	var size int64
+	if bytesText != "-" {
+		size, err = strconv.ParseInt(bytesText, 10, 64)
+		if err != nil || size < 0 {
+			return Entry{}, malformed("bad byte count %q", bytesText)
+		}
+	}
+	secs, err := strconv.ParseFloat(timeText, 64)
+	if err != nil || math.IsNaN(secs) || secs < 0 || secs > 1e9 {
+		return Entry{}, malformed("bad request time %q", timeText)
+	}
+
+	return Entry{
+		Time:     ts,
+		Method:   parts[0],
+		Path:     stripQuery(parts[1]),
+		Status:   status,
+		Bytes:    size,
+		Duration: time.Duration(math.Round(secs * 1e9)),
+	}, nil
+}
+
+// Read parses every line of r and calls fn for each valid entry. Malformed
+// lines are counted and skipped; blank lines are ignored. It stops with the
+// context's error if ctx is cancelled, or with the reader's error.
+func Read(ctx context.Context, r io.Reader, fn func(Entry)) (malformedLines int, err error) {
+	br := bufio.NewReader(r)
+	for {
+		if err := ctx.Err(); err != nil {
+			return malformedLines, err
+		}
+		line, readErr := br.ReadString('\n')
+		if strings.TrimSpace(line) != "" {
+			if e, perr := Parse(line); perr != nil {
+				malformedLines++
+			} else {
+				fn(e)
+			}
+		}
+		if readErr == io.EOF {
+			return malformedLines, nil
+		}
+		if readErr != nil {
+			return malformedLines, fmt.Errorf("read log: %w", readErr)
+		}
+	}
+}
+
+func malformed(format string, args ...any) error {
+	return fmt.Errorf("%w: %s", ErrMalformed, fmt.Sprintf(format, args...))
+}
+
+func stripQuery(target string) string {
+	if i := strings.IndexAny(target, "?#"); i >= 0 {
+		return target[:i]
+	}
+	return target
+}
+
+// scanner walks the space separated fields after the timestamp.
+type scanner struct{ rest string }
+
+func (s *scanner) skipSpace() { s.rest = strings.TrimLeft(s.rest, " ") }
+
+func (s *scanner) done() bool {
+	s.skipSpace()
+	return s.rest == ""
+}
+
+// word returns the next field up to a space.
+func (s *scanner) word() (string, bool) {
+	s.skipSpace()
+	if s.rest == "" {
+		return "", false
+	}
+	end := strings.IndexByte(s.rest, ' ')
+	if end < 0 {
+		end = len(s.rest)
+	}
+	w := s.rest[:end]
+	s.rest = s.rest[end:]
+	return w, true
+}
+
+// quoted returns the contents of the next double quoted field. A backslash
+// escapes the character after it.
+func (s *scanner) quoted() (string, bool) {
+	s.skipSpace()
+	if s.rest == "" || s.rest[0] != '"' {
+		return "", false
+	}
+	for i := 1; i < len(s.rest); i++ {
+		switch s.rest[i] {
+		case '\\':
+			i++
+		case '"':
+			v := s.rest[1:i]
+			s.rest = s.rest[i+1:]
+			return v, true
+		}
+	}
+	return "", false
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..1ec793d
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,138 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"time"
+)
+
+const goodLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	utc := time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC)
+	ms42 := 42 * time.Millisecond
+	ms100 := 100 * time.Millisecond
+	tests := []struct {
+		name    string
+		line    string
+		want    Entry
+		wantErr bool
+	}{
+		{"good", goodLine, Entry{utc, "GET", "/api/items", 200, 512, ms42}, false},
+		{"trailing newline", goodLine + "\n", Entry{utc, "GET", "/api/items", 200, 512, ms42}, false},
+		{"crlf", goodLine + "\r\n", Entry{utc, "GET", "/api/items", 200, 512, ms42}, false},
+		{"dash bytes", `1.2.3.4 - bob [10/Oct/2026:13:55:36 +0000] "POST /x HTTP/1.1" 304 - "-" "ua" 0.000`, Entry{utc, "POST", "/x", 304, 0, 0}, false},
+		{"fragment and query", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /a/b?x=1#frag HTTP/2.0" 404 0 "-" "ua" 1`, Entry{utc, "GET", "/a/b", 404, 0, time.Second}, false},
+		{"root path", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" 0.5`, Entry{utc, "GET", "/", 200, 1, 500 * time.Millisecond}, false},
+		{"escaped quote in agent", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "a \"b\" c" 0.1`, Entry{utc, "GET", "/x", 200, 1, ms100}, false},
+		{"referer with spaces", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "http://a b/" "ua" 0.1`, Entry{utc, "GET", "/x", 200, 1, ms100}, false},
+		{"offset zone", `1.2.3.4 - - [10/Oct/2026:15:55:36 +0200] "GET /x HTTP/1.1" 200 1 "-" "ua" 0.1`, Entry{utc, "GET", "/x", 200, 1, ms100}, false},
+		{"empty", ``, Entry{}, true},
+		{"garbage", `hello world`, Entry{}, true},
+		{"no request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua"`, Entry{}, true},
+		{"non numeric request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua" fast`, Entry{}, true},
+		{"negative request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua" -1`, Entry{}, true},
+		{"dash request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua" -`, Entry{}, true},
+		{"nan request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua" NaN`, Entry{}, true},
+		{"huge request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua" 1e300`, Entry{}, true},
+		{"bad status", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" abc 1 "-" "ua" 0.1`, Entry{}, true},
+		{"status out of range", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 999 1 "-" "ua" 0.1`, Entry{}, true},
+		{"bad bytes", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 -5 "-" "ua" 0.1`, Entry{}, true},
+		{"bad timestamp", `1.2.3.4 - - [yesterday] "GET /x HTTP/1.1" 200 1 "-" "ua" 0.1`, Entry{}, true},
+		{"unterminated timestamp", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000 "GET /x HTTP/1.1" 200 1 "-" "ua" 0.1`, Entry{}, true},
+		{"missing prefix fields", `1.2.3.4 [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua" 0.1`, Entry{}, true},
+		{"dash request line", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "-" 400 0 "-" "-" 0.000`, Entry{}, true},
+		{"short request line", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x" 200 1 "-" "ua" 0.1`, Entry{}, true},
+		{"unterminated request", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1 200 1`, Entry{}, true},
+		{"unterminated agent", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 1 "-" "ua 0.1`, Entry{}, true},
+		{"trailing data", goodLine + " extra", Entry{}, true},
+		{"truncated after status", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200`, Entry{}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Parse(tt.line)
+			if tt.wantErr {
+				if !errors.Is(err, ErrMalformed) {
+					t.Fatalf("Parse(%q) error = %v, want ErrMalformed", tt.line, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v, want nil", tt.line, err)
+			}
+			if !got.Time.Equal(tt.want.Time) {
+				t.Errorf("Parse(%q).Time = %v, want %v", tt.line, got.Time, tt.want.Time)
+			}
+			got.Time, tt.want.Time = time.Time{}, time.Time{}
+			if got != tt.want {
+				t.Errorf("Parse(%q) = %+v, want %+v", tt.line, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRead(t *testing.T) {
+	tests := []struct {
+		name          string
+		input         string
+		wantEntries   int
+		wantMalformed int
+	}{
+		{"empty", "", 0, 0},
+		{"only newlines", "\n\n  \n", 0, 0},
+		{"single line", goodLine + "\n", 1, 0},
+		{"no final newline", goodLine, 1, 0},
+		{"mixed", goodLine + "\nnot a log line\n" + goodLine + "\n\n\"-\"\n", 2, 2},
+		{"all malformed", "a\nb\nc", 0, 3},
+		{"crlf", goodLine + "\r\n" + goodLine + "\r\n", 2, 0},
+		{"very long line", strings.Repeat("x", 200000) + "\n" + goodLine + "\n", 1, 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			entries := 0
+			bad, err := Read(context.Background(), strings.NewReader(tt.input), func(Entry) { entries++ })
+			if err != nil {
+				t.Fatalf("Read(%q) error = %v, want nil", tt.name, err)
+			}
+			if entries != tt.wantEntries || bad != tt.wantMalformed {
+				t.Errorf("Read(%q) = %d entries, %d malformed, want %d, %d", tt.name, entries, bad, tt.wantEntries, tt.wantMalformed)
+			}
+		})
+	}
+}
+
+type failingReader struct{}
+
+func (failingReader) Read([]byte) (int, error) { return 0, errors.New("disk on fire") }
+
+func TestReadErrors(t *testing.T) {
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+	tests := []struct {
+		name    string
+		ctx     context.Context
+		r       io.Reader
+		wantIs  error
+		wantMsg string
+	}{
+		{"cancelled context", cancelled, strings.NewReader(goodLine + "\n"), context.Canceled, ""},
+		{"reader failure", context.Background(), failingReader{}, nil, "disk on fire"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := Read(tt.ctx, tt.r, func(Entry) {})
+			if err == nil {
+				t.Fatalf("Read(%s) error = nil, want an error", tt.name)
+			}
+			if tt.wantIs != nil && !errors.Is(err, tt.wantIs) {
+				t.Errorf("Read(%s) error = %v, want %v", tt.name, err, tt.wantIs)
+			}
+			if tt.wantMsg != "" && !strings.Contains(err.Error(), tt.wantMsg) {
+				t.Errorf("Read(%s) error = %v, want it to contain %q", tt.name, err, tt.wantMsg)
+			}
+		})
+	}
+}
