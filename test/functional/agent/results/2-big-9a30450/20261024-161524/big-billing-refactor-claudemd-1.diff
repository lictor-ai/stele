--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,16 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrNoCustomer is returned when an invoice has no customer.
+	ErrNoCustomer = errors.New("billing: no customer")
+	// ErrInvalidDiscount is returned when a discount code is malformed.
+	ErrInvalidDiscount = errors.New("billing: invalid discount")
+	// ErrDiscountExpired is returned when a discount code is past its expiry.
+	ErrDiscountExpired = errors.New("billing: discount expired")
+	// ErrDiscountUsed is returned when a customer already used a discount code.
+	ErrDiscountUsed = errors.New("billing: discount already used by customer")
+	// ErrUnknownRegion is returned when the tax table has no rate for a region.
+	ErrUnknownRegion = errors.New("billing: unknown tax region")
+)
