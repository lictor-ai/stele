+	if !ok {
+		return Invoice{}, fmt.Errorf("region %q: %w", region, ErrUnknownRegion)
 	}
+	now := b.clock.Now()
+	inv := Invoice{ID: id, Customer: customer, Region: region, Lines: lines, IssuedAt: now}
+	for _, l := range lines {
+		inv.TotalCents += int64(l.Quantity) * l.UnitCents
