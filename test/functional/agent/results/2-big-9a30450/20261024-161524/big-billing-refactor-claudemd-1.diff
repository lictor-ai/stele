+++ b/internal/billing/discount.go
@@ -0,0 +1,103 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// DiscountKind says how a Discount reduces an invoice.
+type DiscountKind int
+
+const (
+	// Percent takes Discount.Percent basis points off the total.
+	Percent DiscountKind = iota + 1
+	// Fixed takes Discount.AmountCents off the total.
+	Fixed
+)
+
+// Discount is a discount code.
+type Discount struct {
+	Code string
+	Kind DiscountKind
+	// Percent is the reduction in basis points (1% = 100), for Percent codes.
+	Percent int64
+	// AmountCents is the reduction in cents, for Fixed codes.
+	AmountCents int64
+	// ExpiresAt is the first instant the code is no longer valid. The zero
+	// time means the code never expires.
+	ExpiresAt time.Time
+}
+
+// validate reports whether the discount is well formed.
+func (d Discount) validate() error {
+	if d.Code == "" {
+		return fmt.Errorf("empty code: %w", ErrInvalidDiscount)
+	}
+	switch d.Kind {
+	case Percent:
+		if d.Percent < 0 || d.Percent > 10000 {
+			return fmt.Errorf("code %q: percent %d bp out of range: %w", d.Code, d.Percent, ErrInvalidDiscount)
+		}
+	case Fixed:
+		if d.AmountCents < 0 {
+			return fmt.Errorf("code %q: negative amount %d: %w", d.Code, d.AmountCents, ErrInvalidDiscount)
+		}
+	default:
+		return fmt.Errorf("code %q: unknown kind %d: %w", d.Code, d.Kind, ErrInvalidDiscount)
+	}
+	return nil
+}
+
+// amount returns the discount in cents for a total, never more than the total.
+func (d Discount) amount(total int64) int64 {
+	if total <= 0 {
+		return 0
+	}
+	off := d.AmountCents
+	if d.Kind == Percent {
+		off = mulBP(total, d.Percent)
+	}
+	return min(off, total)
+}
+
+// mulBP returns cents * bp / 10000, rounded half away from zero.
+func mulBP(cents, bp int64) int64 {
+	n := cents * bp
+	if n < 0 {
+		return -((-n + 5000) / 10000)
+	}
+	return (n + 5000) / 10000
+}
+
+// Redemptions records which customers used which codes.
+type Redemptions struct {
+	mu   sync.Mutex // guards used
+	used map[redemption]bool
+}
+
+type redemption struct{ customer, code string }
+
+// NewRedemptions returns an empty record of redemptions.
+func NewRedemptions() *Redemptions {
+	return &Redemptions{used: make(map[redemption]bool)}
+}
+
+// Used reports whether the customer has already used the code.
+func (r *Redemptions) Used(customer, code string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.used[redemption{customer, code}]
+}
+
+// redeem records the use, or returns ErrDiscountUsed if it was already used.
+func (r *Redemptions) redeem(customer, code string) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	k := redemption{customer, code}
+	if r.used[k] {
+		return fmt.Errorf("customer %q code %q: %w", customer, code, ErrDiscountUsed)
+	}
+	r.used[k] = true
+	return nil
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
