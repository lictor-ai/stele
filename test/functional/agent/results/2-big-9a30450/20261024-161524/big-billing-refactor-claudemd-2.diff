--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,19 @@
+package billing
+
+import "errors"
+
+// Errors returned by invoice building and discount redemption.
+var (
+	// ErrNoCustomer means the request has no customer.
+	ErrNoCustomer = errors.New("billing: no customer")
+	// ErrInvalidLine means a line has a negative quantity or unit price.
+	ErrInvalidLine = errors.New("billing: invalid line")
+	// ErrInvalidCode means a discount code is malformed.
+	ErrInvalidCode = errors.New("billing: invalid discount code")
+	// ErrCodeExpired means the discount code is past its expiry time.
+	ErrCodeExpired = errors.New("billing: discount code expired")
+	// ErrCodeUsed means the customer already used the discount code.
+	ErrCodeUsed = errors.New("billing: discount code already used by customer")
+	// ErrUnknownRegion means the tax table has no rate for the region.
+	ErrUnknownRegion = errors.New("billing: unknown tax region")
+)
