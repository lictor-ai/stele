index 0000000..7b0c0a2
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,92 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// CodeKind says how a discount code reduces a total.
+type CodeKind int
+
+// Kinds of discount code.
+const (
+	// Percent takes a percentage, in basis points, off the total.
+	Percent CodeKind = iota + 1
+	// Fixed takes a fixed number of cents off the total.
+	Fixed
+)
+
+// Code is a discount code.
+type Code struct {
+	Name string
+	Kind CodeKind
+	// Value is basis points (1% = 100) for Percent, cents for Fixed.
+	Value int64
+	// ExpiresAt is the first instant the code no longer works. The zero
+	// value means the code never expires.
+	ExpiresAt time.Time
+}
+
+// validate checks the code is well formed.
+func (c Code) validate() error {
+	switch {
+	case c.Name == "":
+		return fmt.Errorf("%w: empty name", ErrInvalidCode)
+	case c.Kind == Percent && (c.Value < 0 || c.Value > 10000):
+		return fmt.Errorf("%w: %q percent %d outside 0..10000 basis points", ErrInvalidCode, c.Name, c.Value)
+	case c.Kind == Fixed && c.Value < 0:
+		return fmt.Errorf("%w: %q negative amount %d", ErrInvalidCode, c.Name, c.Value)
+	case c.Kind != Percent && c.Kind != Fixed:
+		return fmt.Errorf("%w: %q unknown kind %d", ErrInvalidCode, c.Name, c.Kind)
+	}
+	return nil
+}
+
+// amount returns the discount in cents for a total, never above the total.
+func (c Code) amount(total int64) int64 {
+	d := c.Value
+	if c.Kind == Percent {
+		d = mulBP(total, c.Value)
+	}
+	return min(max(d, 0), total)
+}
+
+// Redemptions records which customer used which code.
+type Redemptions struct {
+	mu   sync.Mutex         // guards used
+	used map[[2]string]bool // {customer, code name} -> redeemed
+}
+
+// NewRedemptions returns an empty record of redemptions.
+func NewRedemptions() *Redemptions {
+	return &Redemptions{used: make(map[[2]string]bool)}
+}
+
+// Used reports whether the customer has already redeemed the code.
+func (r *Redemptions) Used(customer, code string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.used[[2]string{customer, code}]
+}
+
+// redeem marks the code used, or returns ErrCodeUsed if it already was.
+func (r *Redemptions) redeem(customer, code string) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	k := [2]string{customer, code}
+	if r.used[k] {
+		return fmt.Errorf("customer %q code %q: %w", customer, code, ErrCodeUsed)
+	}
+	r.used[k] = true
+	return nil
+}
+
+// mulBP returns v * bp / 10000 rounded half away from zero.
+func mulBP(v, bp int64) int64 {
+	n := v * bp
+	if n >= 0 {
+		return (n + 5000) / 10000
+	}
+	return -((-n + 5000) / 10000)
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
