@@ -0,0 +1,39 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+	"time"
+)
+
+// WriteCSV writes invoices as CSV, with a header row, to w. Amounts are in
+// cents and issued_at is RFC 3339 in UTC.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	header := []string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}
+	if err := cw.Write(header); err != nil {
+		return fmt.Errorf("write csv header: %w", err)
+	}
+	for _, inv := range invoices {
+		rec := []string{
+			inv.ID,
+			inv.Customer,
+			inv.Region,
+			inv.IssuedAt.UTC().Format(time.RFC3339),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := cw.Write(rec); err != nil {
+			return fmt.Errorf("write csv invoice %s: %w", inv.ID, err)
+		}
+	}
+	cw.Flush()
+	if err := cw.Error(); err != nil {
+		return fmt.Errorf("flush csv: %w", err)
+	}
+	return nil
+}
