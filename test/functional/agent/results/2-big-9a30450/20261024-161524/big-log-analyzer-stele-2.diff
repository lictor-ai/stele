+// ErrMalformed is returned, wrapped with detail, for a line that is not in the
+// expected log format.
+var ErrMalformed = errors.New("malformed log line")
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..4313441
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,209 @@
+// Package logparse parses nginx access logs in the combined format with the
+// request time in seconds appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// Entry is one parsed log line.
+type Entry struct {
+	RemoteAddr  string
+	Time        time.Time
+	Method      string
+	Path        string // request target without query string or fragment
+	Proto       string
+	Status      int
+	Bytes       int64
+	Referer     string
+	UserAgent   string
+	RequestTime time.Duration
+}
+
+// Summary counts the lines seen by Scan.
+type Summary struct {
+	Lines     int
+	Malformed int
+}
+
+// Parse parses one log line. It returns an error wrapping ErrMalformed when
+// the line does not match the format.
+func Parse(line string) (Entry, error) {
+	var e Entry
+	rest := strings.TrimRight(line, "\r\n")
+
+	var f string
+	var err error
+
+	// remote address, ident, user
+	var head [3]string
+	for i := range head {
+		head[i], rest, err = word(rest)
+		if err != nil {
+			return e, malformed("field %d: %v", i+1, err)
+		}
+	}
+	e.RemoteAddr = head[0]
+
+	var ts string
+	ts, rest, err = bracketed(rest)
+	if err != nil {
+		return e, malformed("time: %v", err)
+	}
+	e.Time, err = time.Parse(timeLayout, ts)
+	if err != nil {
+		return e, malformed("time %q: %v", ts, err)
+	}
+
+	var req string
+	req, rest, err = quoted(rest)
+	if err != nil {
+		return e, malformed("request: %v", err)
+	}
+	parts := strings.Fields(req)
+	if len(parts) != 3 {
+		return e, malformed("request %q: want method, target and protocol", req)
+	}
+	e.Method, e.Proto = parts[0], parts[2]
+	e.Path = parts[1]
+	if i := strings.IndexAny(e.Path, "?#"); i >= 0 {
+		e.Path = e.Path[:i]
+	}
+	if e.Path == "" {
+		return e, malformed("request %q: empty path", req)
+	}
+
+	f, rest, err = word(rest)
+	if err != nil {
+		return e, malformed("status: %v", err)
+	}
+	e.Status, err = strconv.Atoi(f)
+	if err != nil || e.Status < 100 || e.Status > 599 {
+		return e, malformed("status %q: want a number from 100 to 599", f)
+	}
+
+	f, rest, err = word(rest)
+	if err != nil {
+		return e, malformed("bytes: %v", err)
+	}
+	if f != "-" {
+		e.Bytes, err = strconv.ParseInt(f, 10, 64)
+		if err != nil || e.Bytes < 0 {
+			return e, malformed("bytes %q: want a non-negative number", f)
+		}
+	}
+
+	e.Referer, rest, err = quoted(rest)
+	if err != nil {
+		return e, malformed("referer: %v", err)
+	}
+	e.UserAgent, rest, err = quoted(rest)
+	if err != nil {
+		return e, malformed("user agent: %v", err)
+	}
+
+	f, rest, err = word(rest)
+	if err != nil {
+		return e, malformed("request time: %v", err)
+	}
+	secs, err := strconv.ParseFloat(f, 64)
+	if err != nil || !(secs >= 0 && secs <= 1e9) {
+		return e, malformed("request time %q: want seconds as a number from 0 to 1e9", f)
+	}
+	e.RequestTime = time.Duration(secs * float64(time.Second))
+
+	if strings.TrimSpace(rest) != "" {
+		return e, malformed("unexpected trailing data %q", strings.TrimSpace(rest))
+	}
+	return e, nil
+}
+
+// Scan reads r line by line and calls fn for each well-formed entry. Blank
+// lines are ignored. Malformed lines are counted in the summary and skipped.
+// Scan stops with the context's error if ctx is cancelled, and with a
+// wrapped error from r if reading fails.
+func Scan(ctx context.Context, r io.Reader, fn func(Entry)) (Summary, error) {
+	var s Summary
+	br := bufio.NewReader(r)
+	for {
+		if err := ctx.Err(); err != nil {
+			return s, err
+		}
+		line, err := br.ReadString('\n')
+		if strings.TrimSpace(line) != "" {
+			s.Lines++
+			if e, perr := Parse(line); perr != nil {
+				s.Malformed++
+			} else {
+				fn(e)
+			}
+		}
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				return s, nil
+			}
+			return s, fmt.Errorf("read log: %w", err)
+		}
+	}
+}
+
+func malformed(format string, args ...any) error {
+	return fmt.Errorf("%w: %s", ErrMalformed, fmt.Sprintf(format, args...))
+}
+
+// word returns the next space-delimited field and the remainder.
+func word(s string) (string, string, error) {
+	s = strings.TrimLeft(s, " ")
+	if s == "" {
+		return "", "", errors.New("missing field")
+	}
+	i := strings.IndexByte(s, ' ')
+	if i < 0 {
+		return s, "", nil
+	}
+	return s[:i], s[i:], nil
+}
+
+// bracketed returns the contents of the next [..] field.
+func bracketed(s string) (string, string, error) {
+	s = strings.TrimLeft(s, " ")
+	if !strings.HasPrefix(s, "[") {
+		return "", "", errors.New("want [")
+	}
+	i := strings.IndexByte(s, ']')
+	if i < 0 {
+		return "", "", errors.New("missing ]")
+	}
+	return s[1:i], s[i+1:], nil
+}
+
+// quoted returns the contents of the next "..." field, resolving backslash
+// escapes of quotes and backslashes.
+func quoted(s string) (string, string, error) {
+	s = strings.TrimLeft(s, " ")
+	if !strings.HasPrefix(s, `"`) {
+		return "", "", errors.New(`want "`)
+	}
+	var b strings.Builder
+	for i := 1; i < len(s); i++ {
+		switch c := s[i]; {
+		case c == '\\' && i+1 < len(s) && (s[i+1] == '"' || s[i+1] == '\\'):
+			b.WriteByte(s[i+1])
+			i++
+		case c == '"':
+			return b.String(), s[i+1:], nil
+		default:
+			b.WriteByte(c)
+		}
+	}
+	return "", "", errors.New(`missing closing "`)
+}
