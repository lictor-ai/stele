@@ -0,0 +1,188 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+	"time"
+)
+
+const goodLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name     string
+		line     string
+		wantPath string
+		status   int
+		bytes    int64
+		rt       time.Duration
+		ua       string
+	}{
+		{"example line", goodLine, "/api/items", 200, 512, 42 * time.Millisecond, "curl/8.0"},
+		{"trailing newline", goodLine + "\n", "/api/items", 200, 512, 42 * time.Millisecond, "curl/8.0"},
+		{"crlf", goodLine + "\r\n", "/api/items", 200, 512, 42 * time.Millisecond, "curl/8.0"},
+		{"no query", `1.2.3.4 - bob [10/Oct/2026:13:55:36 +0000] "POST /login HTTP/2.0" 302 0 "http://x/" "ua" 1`, "/login", 302, 0, time.Second, "ua"},
+		{"fragment", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /a#top HTTP/1.1" 200 1 "-" "ua" 0`, "/a", 200, 1, 0, "ua"},
+		{"dash bytes", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 304 - "-" "ua" 0.001`, "/", 304, 0, time.Millisecond, "ua"},
+		{"escaped quote in ua", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "a \"b\" c" 0.5`, "/", 200, 1, 500 * time.Millisecond, `a "b" c`},
+		{"query on root", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /?x=1 HTTP/1.1" 200 1 "-" "ua" 0.5`, "/", 200, 1, 500 * time.Millisecond, "ua"},
+		{"space in ua", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 500 1 "-" "Mozilla/5.0 (X11; Linux)" 0.25`, "/x", 500, 1, 250 * time.Millisecond, "Mozilla/5.0 (X11; Linux)"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v, want nil", tc.line, err)
+			}
+			if got.Path != tc.wantPath {
+				t.Errorf("Parse(%q).Path = %q, want %q", tc.line, got.Path, tc.wantPath)
+			}
+			if got.Status != tc.status {
+				t.Errorf("Parse(%q).Status = %d, want %d", tc.line, got.Status, tc.status)
+			}
+			if got.Bytes != tc.bytes {
+				t.Errorf("Parse(%q).Bytes = %d, want %d", tc.line, got.Bytes, tc.bytes)
+			}
+			if got.RequestTime != tc.rt {
+				t.Errorf("Parse(%q).RequestTime = %v, want %v", tc.line, got.RequestTime, tc.rt)
+			}
+			if got.UserAgent != tc.ua {
+				t.Errorf("Parse(%q).UserAgent = %q, want %q", tc.line, got.UserAgent, tc.ua)
+			}
+		})
+	}
+}
+
+func TestParseFields(t *testing.T) {
+	got, err := Parse(goodLine)
+	if err != nil {
+		t.Fatalf("Parse(%q) error = %v, want nil", goodLine, err)
+	}
+	want := time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC)
+	if !got.Time.Equal(want) {
+		t.Errorf("Parse(%q).Time = %v, want %v", goodLine, got.Time, want)
+	}
+	if got.RemoteAddr != "203.0.113.9" {
+		t.Errorf("Parse(%q).RemoteAddr = %q, want 203.0.113.9", goodLine, got.RemoteAddr)
+	}
+	if got.Method != "GET" || got.Proto != "HTTP/1.1" {
+		t.Errorf("Parse(%q) method/proto = %q/%q, want GET/HTTP/1.1", goodLine, got.Method, got.Proto)
+	}
+	if got.Referer != "-" {
+		t.Errorf("Parse(%q).Referer = %q, want -", goodLine, got.Referer)
+	}
+}
+
+func TestParseTimeZone(t *testing.T) {
+	line := `1.2.3.4 - - [10/Oct/2026:23:30:00 -0200] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`
+	got, err := Parse(line)
+	if err != nil {
+		t.Fatalf("Parse(%q) error = %v, want nil", line, err)
+	}
+	want := time.Date(2026, 10, 11, 1, 30, 0, 0, time.UTC)
+	if !got.Time.Equal(want) {
+		t.Errorf("Parse(%q).Time = %v, want %v", line, got.Time.UTC(), want)
+	}
+}
+
+func TestParseMalformed(t *testing.T) {
+	cases := []struct {
+		name string
+		line string
+	}{
+		{"empty", ""},
+		{"blank", "   "},
+		{"garbage", "not a log line"},
+		{"truncated after time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000]`},
+		{"truncated request", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1`},
+		{"missing request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua"`},
+		{"trailing junk", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1 extra`},
+		{"bad time", `1.2.3.4 - - [32/Foo/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`},
+		{"unbracketed time", `1.2.3.4 - - 10/Oct/2026:13:55:36 "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`},
+		{"unclosed bracket", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`},
+		{"dash request", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "-" 400 0 "-" "-" 0.001`},
+		{"request missing protocol", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /" 200 1 "-" "ua" 0.1`},
+		{"status not a number", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" OK 1 "-" "ua" 0.1`},
+		{"status too small", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 99 1 "-" "ua" 0.1`},
+		{"status too large", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 600 1 "-" "ua" 0.1`},
+		{"bytes not a number", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 many "-" "ua" 0.1`},
+		{"negative bytes", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 -5 "-" "ua" 0.1`},
+		{"request time not a number", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" fast`},
+		{"negative request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" -0.1`},
+		{"nan request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" NaN`},
+		{"huge request time", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" 1e300`},
+		{"empty path", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET ?x=1 HTTP/1.1" 200 1 "-" "ua" 0.1`},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := Parse(tc.line)
+			if !errors.Is(err, ErrMalformed) {
+				t.Errorf("Parse(%q) error = %v, want ErrMalformed", tc.line, err)
+			}
+		})
+	}
+}
+
+func TestScan(t *testing.T) {
+	cases := []struct {
+		name          string
+		input         string
+		wantEntries   int
+		wantLines     int
+		wantMalformed int
+	}{
+		{"empty input", "", 0, 0, 0},
+		{"only blank lines", "\n\n  \n", 0, 0, 0},
+		{"single request", goodLine + "\n", 1, 1, 0},
+		{"no trailing newline", goodLine, 1, 1, 0},
+		{"malformed skipped", goodLine + "\nbroken\n" + goodLine + "\n", 2, 3, 1},
+		{"only malformed", "a\nb\n", 0, 2, 2},
+		{"blank lines between", goodLine + "\n\n" + goodLine + "\n", 2, 2, 0},
+		{"very long line", strings.Repeat("x", 1<<20) + "\n" + goodLine + "\n", 1, 2, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var n int
+			sum, err := Scan(context.Background(), strings.NewReader(tc.input), func(Entry) { n++ })
+			if err != nil {
+				t.Fatalf("Scan(%q) error = %v, want nil", tc.name, err)
+			}
+			if n != tc.wantEntries {
+				t.Errorf("Scan(%q) entries = %d, want %d", tc.name, n, tc.wantEntries)
+			}
+			if sum.Lines != tc.wantLines || sum.Malformed != tc.wantMalformed {
+				t.Errorf("Scan(%q) summary = %+v, want lines %d malformed %d", tc.name, sum, tc.wantLines, tc.wantMalformed)
+			}
+		})
+	}
+}
+
+type failingReader struct{ err error }
+
+func (f failingReader) Read([]byte) (int, error) { return 0, f.err }
+
+func TestScanErrors(t *testing.T) {
+	boom := errors.New("boom")
+	cancelled, cancel := context.WithCancel(context.Background())
+	cancel()
+	cases := []struct {
+		name string
+		ctx  context.Context
+		r    io.Reader
+		want error
+	}{
+		{"read error", context.Background(), failingReader{boom}, boom},
+		{"cancelled context", cancelled, strings.NewReader(goodLine + "\n"), context.Canceled},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := Scan(tc.ctx, tc.r, func(Entry) {})
+			if !errors.Is(err, tc.want) {
+				t.Errorf("Scan(%q) error = %v, want %v", tc.name, err, tc.want)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..0ff248c
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,147 @@
+// Package stats computes the report figures for parsed access log entries.
+package stats
+
+import (
+	"cmp"
+	"math"
+	"slices"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// HourCount is a count for one hour, labelled in UTC as RFC 3339.
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// Latency holds request time percentiles in milliseconds.
+type Latency struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// StatusClasses counts requests per status class. 1xx responses are only
+// part of the total.
+type StatusClasses struct {
+	C2xx int `json:"2xx"`
+	C3xx int `json:"3xx"`
+	C4xx int `json:"4xx"`
+	C5xx int `json:"5xx"`
+}
+
+// Report is the result of an analysis.
+type Report struct {
+	TotalRequests  int           `json:"total_requests"`
+	MalformedLines int           `json:"malformed_lines"`
+	TopPaths       []PathCount   `json:"top_paths"`
+	StatusClasses  StatusClasses `json:"status_classes"`
+	LatencyMS      Latency       `json:"latency_ms"`
+	Errors5xxHour  []HourCount   `json:"errors_5xx_per_hour"`
+}
+
+// Collector accumulates entries. Create one with NewCollector.
+type Collector struct {
+	total   int
+	paths   map[string]int
+	classes StatusClasses
+	times   []float64 // request times in milliseconds
+	errHour map[time.Time]int
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{
+		paths:   make(map[string]int),
+		errHour: make(map[time.Time]int),
+	}
+}
+
+// Add records one entry.
+func (c *Collector) Add(e logparse.Entry) {
+	c.total++
+	c.paths[e.Path]++
+	c.times = append(c.times, float64(e.RequestTime)/float64(time.Millisecond))
+	switch e.Status / 100 {
+	case 2:
+		c.classes.C2xx++
+	case 3:
+		c.classes.C3xx++
+	case 4:
+		c.classes.C4xx++
+	case 5:
+		c.classes.C5xx++
+		c.errHour[e.Time.UTC().Truncate(time.Hour)]++
+	}
+}
+
+// Report returns the figures for the entries added so far, with the topN most
+// requested paths and the number of malformed lines the caller counted. A
+// topN below 1 yields no paths.
+func (c *Collector) Report(topN, malformed int) Report {
+	r := Report{
+		TotalRequests:  c.total,
+		MalformedLines: malformed,
+		TopPaths:       TopPaths(c.paths, topN),
+		StatusClasses:  c.classes,
+		LatencyMS: Latency{
+			P50: Percentile(c.times, 50),
+			P95: Percentile(c.times, 95),
+			P99: Percentile(c.times, 99),
+		},
+		Errors5xxHour: []HourCount{},
+	}
+	hours := make([]time.Time, 0, len(c.errHour))
+	for h := range c.errHour {
+		hours = append(hours, h)
+	}
+	slices.SortFunc(hours, func(a, b time.Time) int { return a.Compare(b) })
+	for _, h := range hours {
+		r.Errors5xxHour = append(r.Errors5xxHour, HourCount{
+			Hour:  h.Format(time.RFC3339),
+			Count: c.errHour[h],
+		})
+	}
+	return r
+}
+
+// TopPaths returns the n paths with the highest counts, ordered by count
+// descending and then by path. The result is never nil.
+func TopPaths(counts map[string]int, n int) []PathCount {
+	out := make([]PathCount, 0, len(counts))
+	if n < 1 {
+		return out
+	}
+	for p, k := range counts {
+		out = append(out, PathCount{Path: p, Count: k})
+	}
+	slices.SortFunc(out, func(a, b PathCount) int {
+		return cmp.Or(cmp.Compare(b.Count, a.Count), cmp.Compare(a.Path, b.Path))
+	})
+	if len(out) > n {
+		out = out[:n]
+	}
+	return out
+}
+
+// Percentile returns the p-th percentile (0 to 100) of values using the
+// nearest-rank method. It does not modify values. It returns 0 for empty
+// input, the minimum for p <= 0 and the maximum for p >= 100.
+func Percentile(values []float64, p float64) float64 {
+	if len(values) == 0 || math.IsNaN(p) {
+		return 0
+	}
+	sorted := slices.Clone(values)
+	slices.Sort(sorted)
+	rank := int(math.Ceil(p / 100 * float64(len(sorted))))
+	rank = min(max(rank, 1), len(sorted))
+	return sorted[rank-1]
+}
