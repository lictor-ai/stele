diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..c57406d
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,162 @@
+// Command loga reads nginx access logs and prints a summary report.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"strings"
+	"syscall"
+	"text/tabwriter"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+const (
+	exitOK    = 0
+	exitInput = 1
+	exitUsage = 2
+)
+
+// usageError marks a failure caused by bad command-line flags. The flag
+// package has already told the user what was wrong.
+type usageError struct{ err error }
+
+func (e *usageError) Error() string { return e.err.Error() }
+func (e *usageError) Unwrap() error { return e.err }
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	stop()
+	code := exitCode(err)
+	if code == exitInput {
+		fmt.Fprintln(os.Stderr, "loga:", err)
+	}
+	os.Exit(code)
+}
+
+// exitCode maps an error from run to the process exit code.
+func exitCode(err error) int {
+	var u *usageError
+	switch {
+	case err == nil, errors.Is(err, flag.ErrHelp):
+		return exitOK
+	case errors.As(err, &u):
+		return exitUsage
+	default:
+		return exitInput
+	}
+}
+
+// run parses args, reads the named files (or stdin when there are none) and
+// writes the report to stdout.
+func run(ctx context.Context, args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: loga [-top N] [-json] [file ...]")
+		fs.PrintDefaults()
+	}
+	top := fs.Int("top", 10, "number of paths to list")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return err
+		}
+		return &usageError{err}
+	}
+	if *top < 1 {
+		err := fmt.Errorf("invalid -top %d: want at least 1", *top)
+		fmt.Fprintln(stderr, err)
+		return &usageError{err}
+	}
+
+	col := stats.NewCollector()
+	var sum logparse.Summary
+	add := func(r io.Reader) error {
+		s, err := logparse.Scan(ctx, r, col.Add)
+		sum.Lines += s.Lines
+		sum.Malformed += s.Malformed
+		return err
+	}
+
+	if fs.NArg() == 0 {
+		if err := add(stdin); err != nil {
+			return err
+		}
+	}
+	for _, name := range fs.Args() {
+		if err := readFile(name, add); err != nil {
+			return err
+		}
+	}
+
+	report := col.Report(*top, sum.Malformed)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(report); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+		return nil
+	}
+	return writeText(stdout, report)
+}
+
+func readFile(name string, add func(io.Reader) error) error {
+	f, err := os.Open(name)
+	if err != nil {
+		return fmt.Errorf("open log: %w", err)
+	}
+	defer f.Close()
+	if err := add(f); err != nil {
+		return fmt.Errorf("%s: %w", name, err)
+	}
+	return nil
+}
+
+func writeText(w io.Writer, r stats.Report) error {
+	var b strings.Builder
+	tw := tabwriter.NewWriter(&b, 0, 0, 2, ' ', 0)
+	fmt.Fprintf(tw, "Total requests:\t%d\n", r.TotalRequests)
+	fmt.Fprintf(tw, "Malformed lines:\t%d\n", r.MalformedLines)
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "Top paths")
+	fmt.Fprintln(tw, "COUNT\tPATH")
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(tw, "%d\t%s\n", p.Count, p.Path)
+	}
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "Status classes")
+	fmt.Fprintf(tw, "2xx\t%d\n", r.StatusClasses.C2xx)
+	fmt.Fprintf(tw, "3xx\t%d\n", r.StatusClasses.C3xx)
+	fmt.Fprintf(tw, "4xx\t%d\n", r.StatusClasses.C4xx)
+	fmt.Fprintf(tw, "5xx\t%d\n", r.StatusClasses.C5xx)
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "Request time (ms)")
+	fmt.Fprintf(tw, "p50\t%.3f\n", r.LatencyMS.P50)
+	fmt.Fprintf(tw, "p95\t%.3f\n", r.LatencyMS.P95)
+	fmt.Fprintf(tw, "p99\t%.3f\n", r.LatencyMS.P99)
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "5xx per hour (UTC)")
+	if len(r.Errors5xxHour) == 0 {
+		fmt.Fprintln(tw, "none")
+	}
+	for _, h := range r.Errors5xxHour {
+		fmt.Fprintf(tw, "%s\t%d\n", h.Hour, h.Count)
+	}
+	if err := tw.Flush(); err != nil {
+		return fmt.Errorf("format report: %w", err)
+	}
+	if _, err := io.WriteString(w, b.String()); err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..6a09a60
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,158 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/stats"
+)
+
+const sample = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 200 512 "-" "curl/8.0" 0.100
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "POST /api/orders HTTP/1.1" 502 10 "-" "curl/8.0" 1.5
+this line is garbage
+203.0.113.9 - - [10/Oct/2026:14:02:00 +0000] "GET /missing HTTP/1.1" 404 10 "-" "curl/8.0" 0.003
+`
+
+func writeLog(t *testing.T, content string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "access.log")
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+	return path
+}
+
+func TestRunJSON(t *testing.T) {
+	path := writeLog(t, sample)
+	var out, errOut bytes.Buffer
+	err := run(context.Background(), []string{"-json", "-top", "2", path}, strings.NewReader(""), &out, &errOut)
+	if err != nil {
+		t.Fatalf("run(-json -top 2 file) error = %v, want nil", err)
+	}
+	var got stats.Report
+	if err := json.Unmarshal(out.Bytes(), &got); err != nil {
+		t.Fatalf("run output %q is not JSON: %v", out.String(), err)
+	}
+	if got.TotalRequests != 4 || got.MalformedLines != 1 {
+		t.Errorf("run totals = %d/%d, want 4/1", got.TotalRequests, got.MalformedLines)
+	}
+	if len(got.TopPaths) != 2 || got.TopPaths[0].Path != "/api/items" || got.TopPaths[0].Count != 2 {
+		t.Errorf("run top paths = %v, want /api/items first with 2 and length 2", got.TopPaths)
+	}
+	if got.StatusClasses.C2xx != 2 || got.StatusClasses.C4xx != 1 || got.StatusClasses.C5xx != 1 {
+		t.Errorf("run classes = %+v, want 2xx=2 4xx=1 5xx=1", got.StatusClasses)
+	}
+	if len(got.Errors5xxHour) != 1 || got.Errors5xxHour[0].Hour != "2026-10-10T14:00:00Z" {
+		t.Errorf("run 5xx per hour = %v, want one entry at 14:00Z", got.Errors5xxHour)
+	}
+	if got.LatencyMS.P50 != 42 {
+		t.Errorf("run p50 = %v, want 42", got.LatencyMS.P50)
+	}
+}
+
+func TestRunText(t *testing.T) {
+	var out, errOut bytes.Buffer
+	err := run(context.Background(), nil, strings.NewReader(sample), &out, &errOut)
+	if err != nil {
+		t.Fatalf("run(stdin) error = %v, want nil", err)
+	}
+	for _, want := range []string{
+		"Total requests:", "Malformed lines:", "/api/items", "2xx", "5xx",
+		"p50", "p95", "p99", "2026-10-10T14:00:00Z",
+	} {
+		if !strings.Contains(out.String(), want) {
+			t.Errorf("run(stdin) output = %q, want it to contain %q", out.String(), want)
+		}
+	}
+	if strings.Contains(out.String(), "?id=") {
+		t.Errorf("run(stdin) output = %q, want query strings removed", out.String())
+	}
+}
+
+func TestRunEmptyInput(t *testing.T) {
+	cases := []struct {
+		name string
+		args []string
+	}{
+		{"text", nil},
+		{"json", []string{"-json"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			if err := run(context.Background(), tc.args, strings.NewReader(""), &out, &errOut); err != nil {
+				t.Fatalf("run(%v, empty) error = %v, want nil", tc.args, err)
+			}
+			if out.Len() == 0 {
+				t.Errorf("run(%v, empty) printed nothing, want a report", tc.args)
+			}
+		})
+	}
+}
+
+func TestRunMultipleFiles(t *testing.T) {
+	a := writeLog(t, sample)
+	b := writeLog(t, sample)
+	var out, errOut bytes.Buffer
+	if err := run(context.Background(), []string{"-json", a, b}, strings.NewReader(""), &out, &errOut); err != nil {
+		t.Fatalf("run(two files) error = %v, want nil", err)
+	}
+	var got stats.Report
+	if err := json.Unmarshal(out.Bytes(), &got); err != nil {
+		t.Fatalf("run output is not JSON: %v", err)
+	}
+	if got.TotalRequests != 8 || got.MalformedLines != 2 {
+		t.Errorf("run(two files) totals = %d/%d, want 8/2", got.TotalRequests, got.MalformedLines)
+	}
+}
+
+func TestExitCodes(t *testing.T) {
+	good := writeLog(t, sample)
+	missing := filepath.Join(t.TempDir(), "nope.log")
+	cases := []struct {
+		name string
+		args []string
+		want int
+	}{
+		{"success", []string{good}, 0},
+		{"help", []string{"-h"}, 0},
+		{"missing file", []string{missing}, 1},
+		{"missing file after good one", []string{good, missing}, 1},
+		{"unknown flag", []string{"-bogus"}, 2},
+		{"bad top value", []string{"-top", "abc"}, 2},
+		{"top zero", []string{"-top", "0"}, 2},
+		{"top negative", []string{"-top", "-3", good}, 2},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(context.Background(), tc.args, strings.NewReader(""), &out, &errOut)
+			if got := exitCode(err); got != tc.want {
+				t.Errorf("exitCode(run(%v)) = %d (err %v), want %d", tc.args, got, err, tc.want)
+			}
+			if tc.want == 1 && !errors.Is(err, os.ErrNotExist) {
+				t.Errorf("run(%v) error = %v, want it to wrap os.ErrNotExist", tc.args, err)
+			}
+			if tc.want == 2 && out.Len() != 0 {
+				t.Errorf("run(%v) wrote %q to stdout, want nothing", tc.args, out.String())
+			}
+			if tc.want == 2 && errOut.Len() == 0 {
+				t.Errorf("run(%v) wrote nothing to stderr, want a usage message", tc.args)
+			}
+		})
+	}
+}
+
+func TestExitCodeHelpError(t *testing.T) {
+	if got := exitCode(flag.ErrHelp); got != 0 {
+		t.Errorf("exitCode(flag.ErrHelp) = %d, want 0", got)
+	}
+}
