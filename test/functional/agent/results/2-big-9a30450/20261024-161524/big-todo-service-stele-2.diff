index 0000000..9956513
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,137 @@
+// Package todo holds the Todo type and an in-memory, concurrency-safe Store.
+package todo
+
+import (
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a single item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Patch describes a partial update. A nil field is left unchanged.
+type Patch struct {
+	Title *string
+	Done  *bool
+}
+
+// ListOptions selects and pages the todos returned by List.
+type ListOptions struct {
+	// Done keeps only todos with this done value when non-nil.
+	Done *bool
+	// Limit is the maximum number of todos returned; zero or less means no limit.
+	Limit int
+	// Offset is the number of matching todos to skip; less than zero counts as zero.
+	Offset int
+}
+
+// Store keeps todos in memory. It is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	mu    sync.RWMutex // guards items and order
+	items map[string]Todo
+	order []string // ids, oldest first
+}
+
+// NewStore returns an empty Store that reads time from clk.
+func NewStore(clk clock.Clock) *Store {
+	return &Store{clock: clk, items: make(map[string]Todo)}
+}
+
+// Create adds a todo with the given title and returns it.
+func (s *Store) Create(title string) Todo {
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.items[t.ID] = t
+	s.order = append(s.order, t.ID)
+	return t
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(todoID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update applies p to the todo with the given id and returns the result, or
+// ErrNotFound.
+func (s *Store) Update(todoID string, p Patch) (Todo, error) {
+	now := s.clock.Now()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if p.Title != nil {
+		t.Title = *p.Title
+	}
+	if p.Done != nil {
+		t.Done = *p.Done
+	}
+	t.UpdatedAt = now
+	s.items[todoID] = t
+	return t, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(todoID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[todoID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, todoID)
+	for i, oid := range s.order {
+		if oid == todoID {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns todos newest first, filtered and paged by opts. The result is
+// never nil.
+func (s *Store) List(opts ListOptions) []Todo {
+	offset := max(opts.Offset, 0)
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	skipped := 0
+	for i := len(s.order) - 1; i >= 0; i-- {
+		t := s.items[s.order[i]]
+		if opts.Done != nil && t.Done != *opts.Done {
+			continue
+		}
+		if skipped < offset {
+			skipped++
+			continue
+		}
+		if opts.Limit > 0 && len(out) >= opts.Limit {
+			break
+		}
+		out = append(out, t)
+	}
+	return out
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
new file mode 100644
index 0000000..0fa3b13
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,220 @@
+package todo
+
+import (
+	"errors"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var epoch = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+// stepClock moves forward one second on every call. Single goroutine only.
+type stepClock struct{ t time.Time }
+
+func (c *stepClock) Now() time.Time {
+	c.t = c.t.Add(time.Second)
+	return c.t
+}
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func ptr[T any](v T) *T { return &v }
+
+func TestCreate(t *testing.T) {
+	s := NewStore(clock.Fixed{T: epoch})
+	a := s.Create("a")
+	b := s.Create("b")
+
+	if a.ID == "" || a.ID == b.ID {
+		t.Errorf("Create ids = %q and %q, want distinct non-empty", a.ID, b.ID)
+	}
+	if a.Title != "a" || a.Done {
+		t.Errorf("Create(%q) = %+v, want title a and done false", "a", a)
+	}
+	if !a.CreatedAt.Equal(epoch) || !a.UpdatedAt.Equal(epoch) {
+		t.Errorf("Create timestamps = %v, %v, want both %v", a.CreatedAt, a.UpdatedAt, epoch)
+	}
+	got, err := s.Get(a.ID)
+	if err != nil || got != a {
+		t.Errorf("Get(%q) = %+v, %v, want %+v, nil", a.ID, got, err, a)
+	}
+}
+
+func TestGetMissing(t *testing.T) {
+	s := NewStore(clock.Fixed{T: epoch})
+	if _, err := s.Get("nope"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(%q) error = %v, want ErrNotFound", "nope", err)
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		patch     Patch
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title only", Patch{Title: ptr("new")}, "new", false},
+		{"done only", Patch{Done: ptr(true)}, "old", true},
+		{"both", Patch{Title: ptr("new"), Done: ptr(true)}, "new", true},
+		{"empty patch", Patch{}, "old", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(&stepClock{t: epoch})
+			created := s.Create("old")
+			got, err := s.Update(created.ID, tc.patch)
+			if err != nil {
+				t.Fatalf("Update(%q, %s) error = %v, want nil", created.ID, tc.name, err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%s) = title %q done %v, want title %q done %v",
+					tc.name, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			if !got.CreatedAt.Equal(created.CreatedAt) {
+				t.Errorf("Update(%s) changed created_at to %v, want %v", tc.name, got.CreatedAt, created.CreatedAt)
+			}
+			if !got.UpdatedAt.After(created.UpdatedAt) {
+				t.Errorf("Update(%s) updated_at = %v, want after %v", tc.name, got.UpdatedAt, created.UpdatedAt)
+			}
+			stored, _ := s.Get(created.ID)
+			if stored != got {
+				t.Errorf("Get after Update = %+v, want %+v", stored, got)
+			}
+		})
+	}
+
+	t.Run("missing", func(t *testing.T) {
+		s := NewStore(clock.Fixed{T: epoch})
+		if _, err := s.Update("nope", Patch{Done: ptr(true)}); !errors.Is(err, ErrNotFound) {
+			t.Errorf("Update(%q) error = %v, want ErrNotFound", "nope", err)
+		}
+	})
+}
+
+func TestDelete(t *testing.T) {
+	s := NewStore(clock.Fixed{T: epoch})
+	a := s.Create("a")
+	b := s.Create("b")
+
+	if err := s.Delete(a.ID); err != nil {
+		t.Fatalf("Delete(%q) = %v, want nil", a.ID, err)
+	}
+	if _, err := s.Get(a.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get after Delete error = %v, want ErrNotFound", err)
+	}
+	if err := s.Delete(a.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("second Delete(%q) = %v, want ErrNotFound", a.ID, err)
+	}
+	if got := titles(s.List(ListOptions{})); !slices.Equal(got, []string{"b"}) {
+		t.Errorf("List after Delete = %v, want [b] (kept %s)", got, b.ID)
+	}
+}
+
+func TestList(t *testing.T) {
+	s := NewStore(&stepClock{t: epoch})
+	var made []Todo
+	for _, title := range []string{"t0", "t1", "t2", "t3", "t4"} {
+		made = append(made, s.Create(title))
+	}
+	for _, i := range []int{1, 3} {
+		if _, err := s.Update(made[i].ID, Patch{Done: ptr(true)}); err != nil {
+			t.Fatalf("Update(%q) = %v, want nil", made[i].ID, err)
+		}
+	}
+
+	tests := []struct {
+		name string
+		opts ListOptions
+		want []string
+	}{
+		{"all newest first", ListOptions{}, []string{"t4", "t3", "t2", "t1", "t0"}},
+		{"done only", ListOptions{Done: ptr(true)}, []string{"t3", "t1"}},
+		{"not done only", ListOptions{Done: ptr(false)}, []string{"t4", "t2", "t0"}},
+		{"limit", ListOptions{Limit: 2}, []string{"t4", "t3"}},
+		{"offset", ListOptions{Offset: 3}, []string{"t1", "t0"}},
+		{"limit and offset", ListOptions{Limit: 2, Offset: 1}, []string{"t3", "t2"}},
+		{"filter with paging", ListOptions{Done: ptr(false), Limit: 1, Offset: 1}, []string{"t2"}},
+		{"offset past end", ListOptions{Offset: 10}, []string{}},
+		{"negative offset", ListOptions{Offset: -4, Limit: 1}, []string{"t4"}},
+		{"limit larger than data", ListOptions{Limit: 50}, []string{"t4", "t3", "t2", "t1", "t0"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := s.List(tc.opts)
+			if got == nil {
+				t.Fatalf("List(%+v) = nil, want non-nil slice", tc.opts)
+			}
+			if !slices.Equal(titles(got), tc.want) {
+				t.Errorf("List(%+v) = %v, want %v", tc.opts, titles(got), tc.want)
+			}
+		})
+	}
+}
+
+func TestListEmpty(t *testing.T) {
+	s := NewStore(clock.Fixed{T: epoch})
+	if got := s.List(ListOptions{}); got == nil || len(got) != 0 {
+		t.Errorf("List on empty store = %#v, want empty non-nil slice", got)
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	const workers = 16
+	const perWorker = 50
+
+	s := NewStore(clock.Fixed{T: epoch})
+	seed := s.Create("seed")
+
+	var wg sync.WaitGroup
+	for range workers {
+		wg.Go(func() {
+			for range perWorker {
+				created := s.Create("x")
+				if _, err := s.Update(created.ID, Patch{Done: ptr(true)}); err != nil {
+					t.Errorf("Update(%q) = %v, want nil", created.ID, err)
+				}
+				if _, err := s.Get(created.ID); err != nil {
+					t.Errorf("Get(%q) = %v, want nil", created.ID, err)
+				}
+				s.List(ListOptions{Limit: 10})
+				if _, err := s.Update(seed.ID, Patch{Title: ptr("seed")}); err != nil {
+					t.Errorf("Update(seed) = %v, want nil", err)
+				}
+				if err := s.Delete(created.ID); err != nil {
+					t.Errorf("Delete(%q) = %v, want nil", created.ID, err)
+				}
+			}
+		})
+	}
+	wg.Wait()
+
+	if got := s.List(ListOptions{}); len(got) != 1 || got[0].ID != seed.ID {
+		t.Errorf("List after concurrent run = %d items, want only the seed todo", len(got))
+	}
+}
+
+func TestConcurrentCreateKeepsAll(t *testing.T) {
+	const n = 200
+	s := NewStore(clock.Fixed{T: epoch})
+
+	var wg sync.WaitGroup
+	for range n {
+		wg.Go(func() { s.Create("x") })
+	}
+	wg.Wait()
+
+	if got := len(s.List(ListOptions{})); got != n {
+		t.Errorf("List after %d concurrent Create calls = %d items, want %d", n, got, n)
+	}
+}
