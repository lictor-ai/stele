index 0000000..714ad64
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,128 @@
+// Package todo holds the Todo type and a concurrency-safe in-memory Store.
+package todo
+
+import (
+	"sort"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a single item on a todo list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// ListOptions selects and pages the todos returned by Store.List.
+type ListOptions struct {
+	// Done, when not nil, keeps only todos whose done flag equals *Done.
+	Done *bool
+	// Limit is the maximum number of todos to return. Zero or less means no limit.
+	Limit int
+	// Offset is the number of matching todos to skip.
+	Offset int
+}
+
+type entry struct {
+	todo Todo
+	seq  uint64
+}
+
+// Store holds todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	mu    sync.RWMutex // guards items and next
+	items map[string]*entry
+	next  uint64
+}
+
+// NewStore returns an empty Store that reads time from clk.
+func NewStore(clk clock.Clock) *Store {
+	return &Store{clock: clk, items: make(map[string]*entry)}
+}
+
+// Create adds a todo with the given title and returns it.
+func (s *Store) Create(title string) Todo {
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.next++
+	e := &entry{
+		todo: Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now},
+		seq:  s.next,
+	}
+	s.items[e.todo.ID] = e
+	return e.todo
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(todoID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	e, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return e.todo, nil
+}
+
+// Update changes the title and/or done flag of a todo; nil arguments are left
+// unchanged. It returns the updated todo, or ErrNotFound.
+func (s *Store) Update(todoID string, title *string, done *bool) (Todo, error) {
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		e.todo.Title = *title
+	}
+	if done != nil {
+		e.todo.Done = *done
+	}
+	e.todo.UpdatedAt = now
+	return e.todo, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(todoID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[todoID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, todoID)
+	return nil
+}
+
+// List returns todos newest first, filtered and paged by opts.
+func (s *Store) List(opts ListOptions) []Todo {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	matched := make([]*entry, 0, len(s.items))
+	for _, e := range s.items {
+		if opts.Done == nil || e.todo.Done == *opts.Done {
+			matched = append(matched, e)
+		}
+	}
+	sort.Slice(matched, func(i, j int) bool { return matched[i].seq > matched[j].seq })
+	offset := min(max(opts.Offset, 0), len(matched))
+	matched = matched[offset:]
+	if opts.Limit > 0 && opts.Limit < len(matched) {
+		matched = matched[:opts.Limit]
+	}
+	out := make([]Todo, len(matched))
+	for i, e := range matched {
+		out[i] = e.todo
+	}
+	return out
+}
