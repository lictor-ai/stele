+package main
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestRunBadArgs(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+	}{
+		{"unknown flag", []string{"-nope"}},
+		{"bad address", []string{"-addr", "not-an-address"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			if err := run(context.Background(), tc.args, &out, &errOut); err == nil {
+				t.Errorf("run(%q) = nil, want error", strings.Join(tc.args, " "))
+			}
+		})
+	}
+}
+
+func TestRunStopsOnCancel(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var out, errOut bytes.Buffer
+	if err := run(ctx, []string{"-addr", "127.0.0.1:0"}, &out, &errOut); err != nil {
+		t.Errorf("run with cancelled context = %v, want nil", err)
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..fea424d
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,176 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const (
+	maxBodyBytes = 1 << 20
+	maxTitleLen  = 200
+	defaultLimit = 20
+	maxLimit     = 100
+)
+
+type handler struct {
+	store *todo.Store
+}
+
+// NewHandler returns the todo API backed by store.
+func NewHandler(store *todo.Store) http.Handler {
+	h := &handler{store: store}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return mux
+}
+
+type createRequest struct {
+	Title *string `json:"title"`
+}
+
+type updateRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+// decodeBody reads a size-limited JSON object into v, rejecting unknown fields
+// and trailing data. On failure it writes the response and returns false.
+func decodeBody(w http.ResponseWriter, r *http.Request, v any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, maxBodyBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(v); err != nil {
+		var tooBig *http.MaxBytesError
+		if errors.As(err, &tooBig) {
+			Error(w, http.StatusRequestEntityTooLarge, "request body is too large")
+			return false
+		}
+		Error(w, http.StatusBadRequest, "request body must be a JSON object with known fields")
+		return false
+	}
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		Error(w, http.StatusBadRequest, "request body must contain a single JSON object")
+		return false
+	}
+	return true
+}
+
+// cleanTitle trims title and reports whether its length is 1 to 200 characters.
+func cleanTitle(title string) (string, bool) {
+	title = strings.TrimSpace(title)
+	n := utf8.RuneCountInString(title)
+	return title, n >= 1 && n <= maxTitleLen
+}
+
+const badTitleMsg = "title must be 1 to 200 characters"
+
+func (h *handler) create(w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	if !decodeBody(w, r, &req) {
+		return
+	}
+	if req.Title == nil {
+		Error(w, http.StatusBadRequest, badTitleMsg)
+		return
+	}
+	title, ok := cleanTitle(*req.Title)
+	if !ok {
+		Error(w, http.StatusBadRequest, badTitleMsg)
+		return
+	}
+	JSON(w, http.StatusCreated, h.store.Create(title))
+}
+
+func (h *handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	opts := todo.ListOptions{Limit: defaultLimit}
+	if v := q.Get("done"); v != "" {
+		done, err := strconv.ParseBool(v)
+		if err != nil || (v != "true" && v != "false") {
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+		opts.Done = &done
+	}
+	if v := q.Get("limit"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 1 || n > maxLimit {
+			Error(w, http.StatusBadRequest, "limit must be an integer from 1 to 100")
+			return
+		}
+		opts.Limit = n
+	}
+	if v := q.Get("offset"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be an integer of 0 or more")
+			return
+		}
+		opts.Offset = n
+	}
+	JSON(w, http.StatusOK, h.store.List(opts))
+}
+
+func (h *handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.PathValue("id"))
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) update(w http.ResponseWriter, r *http.Request) {
+	var req updateRequest
+	if !decodeBody(w, r, &req) {
+		return
+	}
+	if req.Title == nil && req.Done == nil {
+		Error(w, http.StatusBadRequest, "provide title and/or done")
+		return
+	}
+	var title *string
+	if req.Title != nil {
+		clean, ok := cleanTitle(*req.Title)
+		if !ok {
+			Error(w, http.StatusBadRequest, badTitleMsg)
+			return
+		}
+		title = &clean
+	}
+	t, err := h.store.Update(r.PathValue("id"), title, req.Done)
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) delete(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.PathValue("id")); err != nil {
+		h.storeError(w, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (h *handler) storeError(w http.ResponseWriter, err error) {
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	log.Error("todo store", "err", err)
+	Error(w, http.StatusInternalServerError, "something went wrong, try again later")
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..cc8ba5d
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,285 @@
+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func newTestHandler() (http.Handler, *todo.Store) {
+	s := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)})
+	return NewHandler(s), s
+}
+
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	var r *http.Request
+	if body == "" {
+		r = httptest.NewRequest(method, target, nil)
+	} else {
+		r = httptest.NewRequest(method, target, strings.NewReader(body))
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func errorBody(t *testing.T, w *httptest.ResponseRecorder) string {
+	t.Helper()
+	var e map[string]string
+	if err := json.Unmarshal(w.Body.Bytes(), &e); err != nil || e["error"] == "" {
+		t.Fatalf("body %q is not an error envelope (err %v)", w.Body.String(), err)
+	}
+	return e["error"]
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name       string
+		body       string
+		wantStatus int
+		wantTitle  string
+	}{
+		{"valid", `{"title":"buy milk"}`, http.StatusCreated, "buy milk"},
+		{"trimmed", `{"title":"  buy milk  "}`, http.StatusCreated, "buy milk"},
+		{"200 characters", `{"title":"` + strings.Repeat("a", 200) + `"}`, http.StatusCreated, strings.Repeat("a", 200)},
+		{"200 multibyte characters", `{"title":"` + strings.Repeat("é", 200) + `"}`, http.StatusCreated, strings.Repeat("é", 200)},
+		{"201 characters", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, ""},
+		{"empty", `{"title":""}`, http.StatusBadRequest, ""},
+		{"blank", `{"title":"   "}`, http.StatusBadRequest, ""},
+		{"missing title", `{}`, http.StatusBadRequest, ""},
+		{"null title", `{"title":null}`, http.StatusBadRequest, ""},
+		{"wrong type", `{"title":5}`, http.StatusBadRequest, ""},
+		{"unknown field", `{"title":"x","extra":1}`, http.StatusBadRequest, ""},
+		{"invalid json", `{"title":`, http.StatusBadRequest, ""},
+		{"trailing data", `{"title":"x"}{"title":"y"}`, http.StatusBadRequest, ""},
+		{"no body", ``, http.StatusBadRequest, ""},
+		{"body too large", `{"title":"` + strings.Repeat("a", 2<<20) + `"}`, http.StatusRequestEntityTooLarge, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, _ := newTestHandler()
+			w := do(h, "POST", "/todos", tc.body)
+			if w.Code != tc.wantStatus {
+				t.Fatalf("POST /todos %q = %d, want %d (body %s)", tc.name, w.Code, tc.wantStatus, w.Body)
+			}
+			if tc.wantStatus != http.StatusCreated {
+				errorBody(t, w)
+				return
+			}
+			var got todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatal(err)
+			}
+			if got.Title != tc.wantTitle || got.ID == "" || got.Done {
+				t.Errorf("POST /todos = %+v, want title %q, new id, not done", got, tc.wantTitle)
+			}
+			if ct := w.Header().Get("Content-Type"); ct != "application/json" {
+				t.Errorf("Content-Type = %q, want application/json", ct)
+			}
+		})
+	}
+}
+
+func TestCreateJSONFieldNames(t *testing.T) {
+	h, _ := newTestHandler()
+	w := do(h, "POST", "/todos", `{"title":"x"}`)
+	var m map[string]any
+	if err := json.Unmarshal(w.Body.Bytes(), &m); err != nil {
+		t.Fatal(err)
+	}
+	for _, k := range []string{"id", "title", "done", "created_at", "updated_at"} {
+		if _, ok := m[k]; !ok {
+			t.Errorf("POST /todos response lacks field %q: %v", k, m)
+		}
+	}
+}
+
+func TestGet(t *testing.T) {
+	h, s := newTestHandler()
+	c := s.Create("x")
+	tests := []struct {
+		name       string
+		path       string
+		wantStatus int
+	}{
+		{"found", "/todos/" + c.ID, http.StatusOK},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "GET", tc.path, "")
+			if w.Code != tc.wantStatus {
+				t.Fatalf("GET %s = %d, want %d", tc.path, w.Code, tc.wantStatus)
+			}
+			if tc.wantStatus == http.StatusNotFound {
+				errorBody(t, w)
+				return
+			}
+			var got todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil || got.ID != c.ID {
+				t.Errorf("GET %s = %+v (err %v), want id %s", tc.path, got, err, c.ID)
+			}
+		})
+	}
+}
+
+func TestList(t *testing.T) {
+	h, s := newTestHandler()
+	for i := 1; i <= 25; i++ {
+		c := s.Create(fmt.Sprintf("t%d", i))
+		if i%5 == 0 {
+			d := true
+			if _, err := s.Update(c.ID, nil, &d); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	tests := []struct {
+		name      string
+		query     string
+		wantCount int
+		wantFirst string
+	}{
+		{"default limit", "", 20, "t25"},
+		{"limit", "?limit=3", 3, "t25"},
+		{"max limit", "?limit=100", 25, "t25"},
+		{"offset", "?offset=22", 3, "t3"},
+		{"offset past end", "?offset=100", 0, ""},
+		{"done true", "?done=true", 5, "t25"},
+		{"done false", "?done=false&limit=2&offset=1", 2, "t23"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "GET", "/todos"+tc.query, "")
+			if w.Code != http.StatusOK {
+				t.Fatalf("GET /todos%s = %d, want 200", tc.query, w.Code)
+			}
+			var got []todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatal(err)
+			}
+			if got == nil || len(got) != tc.wantCount {
+				t.Fatalf("GET /todos%s returned %d todos (%s), want %d as a JSON array", tc.query, len(got), w.Body, tc.wantCount)
+			}
+			if tc.wantCount > 0 && got[0].Title != tc.wantFirst {
+				t.Errorf("GET /todos%s first = %q, want %q", tc.query, got[0].Title, tc.wantFirst)
+			}
+		})
+	}
+}
+
+func TestListBadQuery(t *testing.T) {
+	tests := []string{
+		"?done=maybe", "?done=1", "?done=TRUE",
+		"?limit=0", "?limit=101", "?limit=-1", "?limit=abc",
+		"?offset=-1", "?offset=abc",
+	}
+	for _, q := range tests {
+		t.Run(q, func(t *testing.T) {
+			h, _ := newTestHandler()
+			w := do(h, "GET", "/todos"+q, "")
+			if w.Code != http.StatusBadRequest {
+				t.Fatalf("GET /todos%s = %d, want 400", q, w.Code)
+			}
+			errorBody(t, w)
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name       string
+		id         string // empty means the created todo
+		body       string
+		wantStatus int
+		wantTitle  string
+		wantDone   bool
+	}{
+		{"title", "", `{"title":" new "}`, http.StatusOK, "new", false},
+		{"done", "", `{"done":true}`, http.StatusOK, "old", true},
+		{"both", "", `{"title":"new","done":true}`, http.StatusOK, "new", true},
+		{"empty object", "", `{}`, http.StatusBadRequest, "", false},
+		{"blank title", "", `{"title":" "}`, http.StatusBadRequest, "", false},
+		{"long title", "", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, "", false},
+		{"wrong done type", "", `{"done":"yes"}`, http.StatusBadRequest, "", false},
+		{"unknown field", "", `{"id":"x"}`, http.StatusBadRequest, "", false},
+		{"invalid json", "", `nope`, http.StatusBadRequest, "", false},
+		{"missing todo", "nope", `{"done":true}`, http.StatusNotFound, "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, s := newTestHandler()
+			c := s.Create("old")
+			id := tc.id
+			if id == "" {
+				id = c.ID
+			}
+			w := do(h, "PATCH", "/todos/"+id, tc.body)
+			if w.Code != tc.wantStatus {
+				t.Fatalf("PATCH /todos/%s %s = %d, want %d (body %s)", id, tc.body, w.Code, tc.wantStatus, w.Body)
+			}
+			if tc.wantStatus != http.StatusOK {
+				errorBody(t, w)
+				return
+			}
+			var got todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatal(err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("PATCH %s = %q/%v, want %q/%v", tc.body, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	h, s := newTestHandler()
+	c := s.Create("x")
+	tests := []struct {
+		name       string
+		path       string
+		wantStatus int
+	}{
+		{"found", "/todos/" + c.ID, http.StatusNoContent},
+		{"again", "/todos/" + c.ID, http.StatusNotFound},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "DELETE", tc.path, "")
+			if w.Code != tc.wantStatus {
+				t.Fatalf("DELETE %s = %d, want %d", tc.path, w.Code, tc.wantStatus)
+			}
+			if tc.wantStatus == http.StatusNoContent && w.Body.Len() != 0 {
+				t.Errorf("DELETE %s body = %q, want empty", tc.path, w.Body)
+			}
+			if tc.wantStatus == http.StatusNotFound {
+				errorBody(t, w)
+			}
+		})
+	}
+}
+
+func TestMethodNotAllowed(t *testing.T) {
+	tests := []struct{ method, path string }{
+		{"PUT", "/todos/abc"},
+		{"DELETE", "/todos"},
+		{"PATCH", "/todos"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.method+" "+tc.path, func(t *testing.T) {
+			h, _ := newTestHandler()
+			if w := do(h, tc.method, tc.path, ""); w.Code != http.StatusMethodNotAllowed {
+				t.Errorf("%s %s = %d, want 405", tc.method, tc.path, w.Code)
+			}
+		})
+	}
+}
