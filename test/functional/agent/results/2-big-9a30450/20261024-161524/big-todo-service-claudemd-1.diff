+package todo
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var t0 = time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func ptr[T any](v T) *T { return &v }
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func TestCreateGet(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	c := s.Create("write tests")
+	if c.ID == "" || c.Title != "write tests" || c.Done || !c.CreatedAt.Equal(t0) || !c.UpdatedAt.Equal(t0) {
+		t.Fatalf("Create(%q) = %+v, want fresh todo at %v", "write tests", c, t0)
+	}
+	got, err := s.Get(c.ID)
+	if err != nil || got != c {
+		t.Errorf("Get(%q) = %+v, %v, want %+v, nil", c.ID, got, err, c)
+	}
+	if _, err := s.Get("missing"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(missing) error = %v, want ErrNotFound", err)
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		title     *string
+		done      *bool
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title only", ptr("new"), nil, "new", false},
+		{"done only", nil, ptr(true), "old", true},
+		{"both", ptr("new"), ptr(true), "new", true},
+		{"neither", nil, nil, "old", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: t0})
+			c := s.Create("old")
+			got, err := s.Update(c.ID, tc.title, tc.done)
+			if err != nil {
+				t.Fatalf("Update() error = %v", err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update() = %q/%v, want %q/%v", got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+	t.Run("missing", func(t *testing.T) {
+		s := NewStore(clock.Fixed{T: t0})
+		if _, err := s.Update("nope", ptr("x"), nil); !errors.Is(err, ErrNotFound) {
+			t.Errorf("Update(nope) error = %v, want ErrNotFound", err)
+		}
+	})
+}
+
+func TestDelete(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	c := s.Create("x")
+	if err := s.Delete(c.ID); err != nil {
+		t.Errorf("Delete(%q) = %v, want nil", c.ID, err)
+	}
+	if err := s.Delete(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("second Delete(%q) = %v, want ErrNotFound", c.ID, err)
+	}
+	if _, err := s.Get(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get after Delete = %v, want ErrNotFound", err)
+	}
+}
+
+func TestList(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	for i := 1; i <= 5; i++ {
+		c := s.Create(fmt.Sprintf("t%d", i))
+		if i%2 == 0 {
+			if _, err := s.Update(c.ID, nil, ptr(true)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	tests := []struct {
+		name string
+		opts ListOptions
+		want []string
+	}{
+		{"all newest first", ListOptions{}, []string{"t5", "t4", "t3", "t2", "t1"}},
+		{"done", ListOptions{Done: ptr(true)}, []string{"t4", "t2"}},
+		{"not done", ListOptions{Done: ptr(false)}, []string{"t5", "t3", "t1"}},
+		{"limit", ListOptions{Limit: 2}, []string{"t5", "t4"}},
+		{"offset", ListOptions{Offset: 3}, []string{"t2", "t1"}},
+		{"limit and offset", ListOptions{Limit: 2, Offset: 1}, []string{"t4", "t3"}},
+		{"offset past end", ListOptions{Offset: 10}, []string{}},
+		{"limit larger than set", ListOptions{Limit: 50}, []string{"t5", "t4", "t3", "t2", "t1"}},
+		{"filter with page", ListOptions{Done: ptr(false), Limit: 1, Offset: 1}, []string{"t3"}},
+		{"negative offset", ListOptions{Offset: -1, Limit: 1}, []string{"t5"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := titles(s.List(tc.opts))
+			if !slices.Equal(got, tc.want) {
+				t.Errorf("List(%+v) = %v, want %v", tc.opts, got, tc.want)
+			}
+		})
+	}
+	t.Run("empty store", func(t *testing.T) {
+		if got := NewStore(clock.Fixed{T: t0}).List(ListOptions{}); len(got) != 0 {
+			t.Errorf("List on empty store = %v, want none", got)
+		}
+	})
+}
+
+func TestConcurrentUse(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	const workers, per = 16, 50
+	var wg sync.WaitGroup
+	for range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range per {
+				c := s.Create("x")
+				if _, err := s.Update(c.ID, ptr("y"), ptr(i%2 == 0)); err != nil {
+					t.Errorf("Update(%q) = %v", c.ID, err)
+				}
+				if _, err := s.Get(c.ID); err != nil {
+					t.Errorf("Get(%q) = %v", c.ID, err)
+				}
+				s.List(ListOptions{Limit: 10})
+				if i%5 == 0 {
+					if err := s.Delete(c.ID); err != nil {
+						t.Errorf("Delete(%q) = %v", c.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	want := workers * (per - per/5)
+	if got := len(s.List(ListOptions{})); got != want {
+		t.Errorf("len(List()) = %d, want %d", got, want)
+	}
+}
