+package logparse
+
+import "errors"
+
+// ErrMalformed reports a line that is not a combined-format access log line
+// with the request time appended. Callers count these lines and skip them.
+var ErrMalformed = errors.New("malformed log line")
diff --git a/internal/logparse/parse.go b/internal/logparse/parse.go
new file mode 100644
index 0000000..076402b
--- /dev/null
+++ b/internal/logparse/parse.go
@@ -0,0 +1,192 @@
+// Package logparse parses nginx access logs in the "combined" format with the
+// request time appended as the last field.
+package logparse
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// timeLayout is the Common Log Format timestamp, such as 10/Oct/2026:13:55:36 +0000.
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// maxRequestSeconds is the longest request time that fits in a time.Duration.
+const maxRequestSeconds = math.MaxInt64 / float64(time.Second)
+
+// Entry is one parsed request line.
+type Entry struct {
+	Time        time.Time     // when the server received the request
+	Method      string        // HTTP method, such as GET
+	Path        string        // request path without the query string
+	Status      int           // HTTP status code, from 100 to 599
+	Bytes       int64         // response body size; 0 when the log has "-"
+	RequestTime time.Duration // nginx request time, to the nanosecond
+}
+
+// ParseLine parses one access log line. A trailing newline or spaces are
+// ignored. Any other deviation from the format returns an error that wraps
+// ErrMalformed and names the field that was bad.
+func ParseLine(line string) (Entry, error) {
+	c := &cursor{s: strings.TrimRight(line, " \t\r\n")}
+
+	for _, name := range []string{"remote address", "ident", "user"} {
+		if _, err := c.token(name); err != nil {
+			return Entry{}, err
+		}
+	}
+
+	stamp, err := c.bracketed("time")
+	if err != nil {
+		return Entry{}, err
+	}
+	t, err := time.Parse(timeLayout, stamp)
+	if err != nil {
+		return Entry{}, malformed("time %q", stamp)
+	}
+
+	req, err := c.quoted("request")
+	if err != nil {
+		return Entry{}, err
+	}
+	method, path, err := parseRequest(req)
+	if err != nil {
+		return Entry{}, err
+	}
+
+	statusField, err := c.token("status")
+	if err != nil {
+		return Entry{}, err
+	}
+	status, err := strconv.Atoi(statusField)
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, malformed("status %q", statusField)
+	}
+
+	bytesField, err := c.token("bytes")
+	if err != nil {
+		return Entry{}, err
+	}
+	var size int64
+	if bytesField != "-" {
+		size, err = strconv.ParseInt(bytesField, 10, 64)
+		if err != nil || size < 0 {
+			return Entry{}, malformed("bytes %q", bytesField)
+		}
+	}
+
+	for _, name := range []string{"referer", "user agent"} {
+		if _, err := c.quoted(name); err != nil {
+			return Entry{}, err
+		}
+	}
+
+	timeField, err := c.token("request time")
+	if err != nil {
+		return Entry{}, err
+	}
+	seconds, err := strconv.ParseFloat(timeField, 64)
+	if err != nil || math.IsNaN(seconds) || seconds < 0 || seconds > maxRequestSeconds {
+		return Entry{}, malformed("request time %q", timeField)
+	}
+
+	if !c.done() {
+		return Entry{}, malformed("unexpected text after request time")
+	}
+
+	return Entry{
+		Time:        t,
+		Method:      method,
+		Path:        path,
+		Status:      status,
+		Bytes:       size,
+		RequestTime: time.Duration(math.Round(seconds * float64(time.Second))),
+	}, nil
+}
+
+// parseRequest splits a request line such as "GET /api/items?id=3 HTTP/1.1"
+// into its method and path. The path has no query string.
+func parseRequest(req string) (method, path string, err error) {
+	parts := strings.Split(req, " ")
+	if len(parts) != 3 || parts[0] == "" || parts[1] == "" || !strings.HasPrefix(parts[2], "HTTP/") {
+		return "", "", malformed("request %q", req)
+	}
+	path, _, _ = strings.Cut(parts[1], "?")
+	return parts[0], path, nil
+}
+
+// malformed returns an error that wraps ErrMalformed and describes the bad input.
+func malformed(format string, args ...any) error {
+	return fmt.Errorf("%w: "+format, append([]any{ErrMalformed}, args...)...)
+}
+
+// cursor walks a log line. Fields are separated by exactly one space.
+type cursor struct {
+	s   string
+	pos int
+}
+
+// done reports whether every field has been read.
+func (c *cursor) done() bool { return c.pos >= len(c.s) }
+
+// token reads a field up to the next space and consumes that space.
+func (c *cursor) token(name string) (string, error) {
+	if c.done() {
+		return "", malformed("missing %s", name)
+	}
+	rest := c.s[c.pos:]
+	end := strings.IndexByte(rest, ' ')
+	if end < 0 {
+		end = len(rest)
+	}
+	if end == 0 {
+		return "", malformed("empty %s", name)
+	}
+	c.pos += end
+	c.skipSpace()
+	return rest[:end], nil
+}
+
+// bracketed reads a field in square brackets and returns its contents.
+func (c *cursor) bracketed(name string) (string, error) {
+	if c.done() || c.s[c.pos] != '[' {
+		return "", malformed("%s: missing '['", name)
+	}
+	end := strings.IndexByte(c.s[c.pos:], ']')
+	if end < 0 {
+		return "", malformed("%s: missing ']'", name)
+	}
+	inner := c.s[c.pos+1 : c.pos+end]
+	c.pos += end + 1
+	c.skipSpace()
+	return inner, nil
+}
+
+// quoted reads a field in double quotes and returns its contents as logged.
+// A backslash escapes the next byte, so an escaped quote does not end the field.
+func (c *cursor) quoted(name string) (string, error) {
+	if c.done() || c.s[c.pos] != '"' {
+		return "", malformed("%s: missing '\"'", name)
+	}
+	for i := c.pos + 1; i < len(c.s); i++ {
+		switch c.s[i] {
+		case '\\':
+			i++
+		case '"':
+			inner := c.s[c.pos+1 : i]
+			c.pos = i + 1
+			c.skipSpace()
+			return inner, nil
+		}
+	}
+	return "", malformed("%s: missing closing '\"'", name)
+}
+
+// skipSpace consumes one space separator, if there is one.
+func (c *cursor) skipSpace() {
+	if c.pos < len(c.s) && c.s[c.pos] == ' ' {
+		c.pos++
+	}
+}
diff --git a/internal/logparse/parse_test.go b/internal/logparse/parse_test.go
new file mode 100644
