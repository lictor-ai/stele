+func TestReportErrors5xxByHour(t *testing.T) {
+	utc := time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)
+	plus2 := time.FixedZone("+02", 2*60*60)
+	tests := []struct {
+		name  string
+		entry []logparse.Entry
+		want  []HourCount
+	}{
+		{
+			name: "groups by hour and sorts oldest first",
+			entry: []logparse.Entry{
+				entry("/", 500, 1, utc.Add(50*time.Minute)),
+				entry("/", 502, 1, utc.Add(-2*time.Hour)),
+				entry("/", 503, 1, utc.Add(5*time.Minute)),
+			},
+			want: []HourCount{
+				{Hour: utc.Add(-2 * time.Hour), Count: 1},
+				{Hour: utc, Count: 2},
+			},
+		},
+		{
+			name: "hours are UTC, not the local offset of the line",
+			entry: []logparse.Entry{
+				entry("/", 500, 1, time.Date(2026, 10, 10, 15, 30, 0, 0, plus2)),
+				entry("/", 500, 1, utc.Add(30*time.Minute)),
+			},
+			want: []HourCount{
+				{Hour: utc, Count: 2},
+			},
+		},
+		{
+			name: "4xx and 2xx are not errors",
+			entry: []logparse.Entry{
+				entry("/", 404, 1, utc),
+				entry("/", 200, 1, utc),
+			},
+			want: []HourCount{},
+		},
+		{
+			name:  "no 5xx at all",
+			entry: nil,
+			want:  []HourCount{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			for _, e := range tt.entry {
+				c.Add(e)
+			}
+			got := c.Report(10).Errors5xxByHour
+			if len(got) != len(tt.want) {
+				t.Fatalf("Report().Errors5xxByHour = %+v, want %+v", got, tt.want)
+			}
+			for i := range tt.want {
+				if !got[i].Hour.Equal(tt.want[i].Hour) || got[i].Count != tt.want[i].Count {
+					t.Errorf("Report().Errors5xxByHour[%d] = %v x%d, want %v x%d",
+						i, got[i].Hour, got[i].Count, tt.want[i].Hour, tt.want[i].Count)
+				}
+			}
+		})
+	}
+}
