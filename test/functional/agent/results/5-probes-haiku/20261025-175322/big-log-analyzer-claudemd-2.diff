+func TestAddMalformed(t *testing.T) {
+	tests := []struct {
+		name  string
+		calls []int
+		want  int
+	}{
+		{name: "never called", calls: nil, want: 0},
+		{name: "one call", calls: []int{3}, want: 3},
+		{name: "several calls add up", calls: []int{1, 0, 4}, want: 5},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			for _, n := range tt.calls {
+				c.AddMalformed(n)
+			}
+			if got := c.Report(10).MalformedLines; got != tt.want {
+				t.Errorf("MalformedLines after AddMalformed(%v) = %d, want %d", tt.calls, got, tt.want)
+			}
+		})
+	}
