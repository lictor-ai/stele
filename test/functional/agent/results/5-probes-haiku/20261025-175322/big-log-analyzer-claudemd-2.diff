+func TestReportStatusClasses(t *testing.T) {
+	at := time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)
+	tests := []struct {
+		name     string
+		statuses []int
+		want     []int // counts for 2xx, 3xx, 4xx, 5xx
+	}{
+		{name: "boundaries of each class", statuses: []int{200, 299, 300, 399, 400, 499, 500, 599}, want: []int{2, 2, 2, 2}},
+		{name: "1xx and 6xx are not counted in a class", statuses: []int{100, 199, 600}, want: []int{0, 0, 0, 0}},
+		{name: "no requests", statuses: nil, want: []int{0, 0, 0, 0}},
+		{name: "only 4xx", statuses: []int{404, 404, 403}, want: []int{0, 0, 3, 0}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			for _, s := range tt.statuses {
+				c.Add(entry("/", s, 1, at))
+			}
+			r := c.Report(10)
+			if r.TotalRequests != len(tt.statuses) {
+				t.Errorf("TotalRequests = %d, want %d", r.TotalRequests, len(tt.statuses))
+			}
+			for i, want := range tt.want {
+				if got := r.StatusClasses[i].Count; got != want {
+					t.Errorf("StatusClasses[%s] = %d, want %d", r.StatusClasses[i].Class, got, want)
+				}
+			}
+		})
+	}
+}
