+func TestReportTopPaths(t *testing.T) {
+	at := time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)
+	tests := []struct {
+		name  string
+		paths []string
+		top   int
+		want  []PathCount
+	}{
+		{
+			name:  "most requested first",
+			paths: []string{"/a", "/b", "/b", "/c", "/c", "/c"},
+			top:   10,
+			want:  []PathCount{{"/c", 3}, {"/b", 2}, {"/a", 1}},
+		},
+		{
+			name:  "ties sorted by path",
+			paths: []string{"/z", "/m", "/a"},
+			top:   10,
+			want:  []PathCount{{"/a", 1}, {"/m", 1}, {"/z", 1}},
+		},
+		{
+			name:  "top limits the list",
+			paths: []string{"/a", "/b", "/b", "/c", "/c", "/c"},
+			top:   2,
+			want:  []PathCount{{"/c", 3}, {"/b", 2}},
+		},
+		{
+			name:  "top larger than the number of paths",
+			paths: []string{"/a"},
+			top:   10,
+			want:  []PathCount{{"/a", 1}},
+		},
+		{
+			name:  "top of zero lists nothing",
+			paths: []string{"/a"},
+			top:   0,
+			want:  []PathCount{},
+		},
+		{
+			name:  "negative top lists nothing",
+			paths: []string{"/a"},
+			top:   -3,
+			want:  []PathCount{},
+		},
+		{
+			name:  "no requests",
+			paths: nil,
+			top:   10,
+			want:  []PathCount{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			for _, p := range tt.paths {
+				c.Add(entry(p, 200, 1, at))
+			}
+			got := c.Report(tt.top).TopPaths
+			if len(got) != len(tt.want) {
+				t.Fatalf("Report(%d).TopPaths = %+v, want %+v", tt.top, got, tt.want)
+			}
+			for i := range tt.want {
+				if got[i] != tt.want[i] {
+					t.Errorf("Report(%d).TopPaths[%d] = %+v, want %+v", tt.top, i, got[i], tt.want[i])
+				}
+			}
+		})
+	}
+}
