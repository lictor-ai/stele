@@ -0,0 +1,255 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+const sampleLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParseLine(t *testing.T) {
+	utc := time.FixedZone("UTC", 0)
+	tests := []struct {
+		name string
+		line string
+		want Entry
+	}{
+		{
+			name: "full line strips the query string",
+			line: sampleLine,
+			want: Entry{
+				Time:        time.Date(2026, 10, 10, 13, 55, 36, 0, utc),
+				Method:      "GET",
+				Path:        "/api/items",
+				Status:      200,
+				Bytes:       512,
+				RequestTime: 42 * time.Millisecond,
+			},
+		},
+		{
+			name: "path without query",
+			line: `10.0.0.1 - - [10/Oct/2026:00:00:01 +0000] "POST /login HTTP/1.1" 302 0 "-" "-" 1.5`,
+			want: Entry{
+				Time:        time.Date(2026, 10, 10, 0, 0, 1, 0, utc),
+				Method:      "POST",
+				Path:        "/login",
+				Status:      302,
+				Bytes:       0,
+				RequestTime: 1500 * time.Millisecond,
+			},
+		},
+		{
+			name: "dash bytes is zero",
+			line: `10.0.0.1 - - [10/Oct/2026:00:00:01 +0000] "HEAD / HTTP/1.0" 304 - "-" "-" 0`,
+			want: Entry{
+				Time:        time.Date(2026, 10, 10, 0, 0, 1, 0, utc),
+				Method:      "HEAD",
+				Path:        "/",
+				Status:      304,
+				Bytes:       0,
+				RequestTime: 0,
+			},
+		},
+		{
+			name: "user name and escaped quote in user agent",
+			line: `10.0.0.1 - alice [10/Oct/2026:00:00:01 -0230] "GET /a HTTP/2.0" 500 7 "https://x/\"y\"" "agent \" 1" 0.000001`,
+			want: Entry{
+				Time:        time.Date(2026, 10, 10, 2, 30, 1, 0, utc),
+				Method:      "GET",
+				Path:        "/a",
+				Status:      500,
+				Bytes:       7,
+				RequestTime: time.Microsecond,
+			},
+		},
+		{
+			name: "trailing CRLF and spaces are ignored",
+			line: sampleLine + " \r\n",
+			want: Entry{
+				Time:        time.Date(2026, 10, 10, 13, 55, 36, 0, utc),
+				Method:      "GET",
+				Path:        "/api/items",
+				Status:      200,
+				Bytes:       512,
+				RequestTime: 42 * time.Millisecond,
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := ParseLine(tt.line)
+			if err != nil {
+				t.Fatalf("ParseLine(%q) error = %v, want nil", tt.line, err)
+			}
+			if !got.Time.Equal(tt.want.Time) {
+				t.Errorf("ParseLine(%q).Time = %v, want %v", tt.line, got.Time, tt.want.Time)
+			}
+			if got.Method != tt.want.Method {
+				t.Errorf("ParseLine(%q).Method = %q, want %q", tt.line, got.Method, tt.want.Method)
+			}
+			if got.Path != tt.want.Path {
+				t.Errorf("ParseLine(%q).Path = %q, want %q", tt.line, got.Path, tt.want.Path)
+			}
+			if got.Status != tt.want.Status {
+				t.Errorf("ParseLine(%q).Status = %d, want %d", tt.line, got.Status, tt.want.Status)
+			}
+			if got.Bytes != tt.want.Bytes {
+				t.Errorf("ParseLine(%q).Bytes = %d, want %d", tt.line, got.Bytes, tt.want.Bytes)
+			}
+			if got.RequestTime != tt.want.RequestTime {
+				t.Errorf("ParseLine(%q).RequestTime = %v, want %v", tt.line, got.RequestTime, tt.want.RequestTime)
+			}
+		})
+	}
+}
+
+func TestParseLineMalformed(t *testing.T) {
+	tests := []struct {
+		name string
+		line string
+	}{
+		{name: "empty", line: ""},
+		{name: "only spaces", line: "   "},
+		{name: "old combined format without request time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "curl/8.0"`},
+		{name: "request time missing after user agent", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "curl/8.0" `},
+		{name: "too few fields", line: `203.0.113.9 - -`},
+		{name: "bad timestamp", line: `203.0.113.9 - - [10/Foo/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" 0.1`},
+		{name: "timestamp without brackets", line: `203.0.113.9 - - 10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 512 "-" "-" 0.1`},
+		{name: "timestamp not closed", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 512 "-" "-" 0.1`},
+		{name: "request not quoted", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] GET / HTTP/1.1 200 512 "-" "-" 0.1`},
+		{name: "request not closed", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 200 512 "-" "-" 0.1`},
+		{name: "request with two parts", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /x" 200 512 "-" "-" 0.1`},
+		{name: "request with four parts", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 x" 200 512 "-" "-" 0.1`},
+		{name: "request with empty method", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] " / HTTP/1.1" 200 512 "-" "-" 0.1`},
+		{name: "request with empty path", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET  HTTP/1.1" 200 512 "-" "-" 0.1`},
+		{name: "request without protocol", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / FTP" 200 512 "-" "-" 0.1`},
+		{name: "non-numeric status", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" OK 512 "-" "-" 0.1`},
+		{name: "status below 100", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 99 512 "-" "-" 0.1`},
+		{name: "status above 599", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 600 512 "-" "-" 0.1`},
+		{name: "non-numeric bytes", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 big "-" "-" 0.1`},
+		{name: "negative bytes", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 -5 "-" "-" 0.1`},
+		{name: "referer not quoted", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 - "-" 0.1`},
+		{name: "user agent missing", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" 0.1`},
+		{name: "request time not a number", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" slow`},
+		{name: "request time dash", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" -`},
+		{name: "negative request time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" -0.5`},
+		{name: "NaN request time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" NaN`},
+		{name: "infinite request time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" +Inf`},
+		{name: "request time too large for a duration", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" 1e300`},
+		{name: "double space between fields", line: `203.0.113.9 - -  [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "-" 0.1`},
+		{name: "text after request time", line: sampleLine + " extra"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := ParseLine(tt.line)
+			if !errors.Is(err, ErrMalformed) {
+				t.Errorf("ParseLine(%q) error = %v, want an error wrapping ErrMalformed", tt.line, err)
+			}
+		})
+	}
+}
+
+func TestRead(t *testing.T) {
+	tests := []struct {
+		name          string
+		input         string
+		wantEntries   int
+		wantMalformed int
+	}{
+		{
+			name:          "empty input",
+			input:         "",
+			wantEntries:   0,
+			wantMalformed: 0,
+		},
+		{
+			name:          "only blank lines are not malformed",
+			input:         "\n  \n\r\n",
+			wantEntries:   0,
+			wantMalformed: 0,
+		},
+		{
+			name:          "single valid line with newline",
+			input:         sampleLine + "\n",
+			wantEntries:   1,
+			wantMalformed: 0,
+		},
+		{
+			name:          "single valid line without final newline",
+			input:         sampleLine,
+			wantEntries:   1,
+			wantMalformed: 0,
+		},
+		{
+			name:          "malformed lines are counted and skipped",
+			input:         sampleLine + "\nnot a log line\n" + sampleLine + "\n\n203.0.113.9 - -\n",
+			wantEntries:   2,
+			wantMalformed: 2,
+		},
+		{
+			name:          "only malformed lines",
+			input:         "garbage\nmore garbage\n",
+			wantEntries:   0,
+			wantMalformed: 2,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var entries int
+			malformed, err := Read(t.Context(), strings.NewReader(tt.input), func(Entry) { entries++ })
+			if err != nil {
+				t.Fatalf("Read(%q) error = %v, want nil", tt.input, err)
+			}
+			if entries != tt.wantEntries {
+				t.Errorf("Read(%q) entries = %d, want %d", tt.input, entries, tt.wantEntries)
+			}
+			if malformed != tt.wantMalformed {
+				t.Errorf("Read(%q) malformed = %d, want %d", tt.input, malformed, tt.wantMalformed)
+			}
+		})
+	}
+}
+
+func TestReadErrors(t *testing.T) {
+	t.Run("cancelled context stops before reading", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		cancel()
+		entries := 0
+		_, err := Read(ctx, strings.NewReader(sampleLine+"\n"), func(Entry) { entries++ })
+		if !errors.Is(err, context.Canceled) {
+			t.Errorf("Read(cancelled) error = %v, want %v", err, context.Canceled)
+		}
+		if entries != 0 {
+			t.Errorf("Read(cancelled) entries = %d, want 0", entries)
+		}
+	})
+
+	t.Run("reader failure is returned, not counted as malformed", func(t *testing.T) {
+		failure := errors.New("disk on fire")
+		malformed, err := Read(t.Context(), &failingReader{data: sampleLine + "\n", err: failure}, func(Entry) {})
+		if !errors.Is(err, failure) {
+			t.Errorf("Read(failing reader) error = %v, want %v", err, failure)
+		}
+		if malformed != 0 {
+			t.Errorf("Read(failing reader) malformed = %d, want 0", malformed)
+		}
+	})
+}
+
+// failingReader returns data, then err instead of io.EOF.
+type failingReader struct {
+	data string
+	err  error
+}
+
+func (r *failingReader) Read(p []byte) (int, error) {
+	if r.data == "" {
+		return 0, r.err
+	}
+	n := copy(p, r.data)
+	r.data = r.data[n:]
+	return n, nil
+}
diff --git a/internal/logparse/read.go b/internal/logparse/read.go
new file mode 100644
index 0000000..6fa5358
--- /dev/null
+++ b/internal/logparse/read.go
@@ -0,0 +1,39 @@
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+)
+
+// Read parses every line from r and calls fn for each valid entry. Lines that
+// do not parse are counted and skipped, and blank lines are ignored. Read
+// returns the number of malformed lines. It stops early with the context error
+// if ctx is cancelled, and it returns an error if r cannot be read.
+func Read(ctx context.Context, r io.Reader, fn func(Entry)) (int, error) {
+	br := bufio.NewReader(r)
+	malformedLines := 0
+	for {
+		if err := ctx.Err(); err != nil {
+			return malformedLines, err
+		}
+		line, readErr := br.ReadString('\n')
+		if strings.TrimSpace(line) != "" {
+			e, err := ParseLine(line)
+			if err != nil {
+				malformedLines++
+			} else {
+				fn(e)
+			}
+		}
+		if errors.Is(readErr, io.EOF) {
+			return malformedLines, nil
+		}
+		if readErr != nil {
+			return malformedLines, fmt.Errorf("read access log: %w", readErr)
+		}
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..e0c92ec
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,179 @@
+// Package stats turns parsed access log entries into a report.
+package stats
+
+import (
+	"cmp"
+	"math"
+	"slices"
+	"strings"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// Report is the summary of a set of access log entries.
+type Report struct {
+	TotalRequests   int           `json:"total_requests"`
+	MalformedLines  int           `json:"malformed_lines"`
+	TopPaths        []PathCount   `json:"top_paths"`
+	StatusClasses   []StatusClass `json:"status_classes"`
+	RequestTimeMS   Latency       `json:"request_time_ms"`
+	Errors5xxByHour []HourCount   `json:"errors_5xx_by_hour"`
+}
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// StatusClass is the number of responses in one status class, such as "4xx".
+type StatusClass struct {
+	Class string `json:"class"`
+	Count int    `json:"count"`
+}
+
+// Latency holds request time percentiles in milliseconds. When Samples is 0
+// there is no data, and the percentiles are 0.
+type Latency struct {
+	Samples int     `json:"samples"`
+	P50     float64 `json:"p50"`
+	P95     float64 `json:"p95"`
+	P99     float64 `json:"p99"`
+}
+
+// HourCount is the number of 5xx responses in one UTC hour.
+type HourCount struct {
+	Hour  time.Time `json:"hour"`
+	Count int       `json:"count"`
+}
+
+// statusClassNames names the status classes that Collector counts, in order.
+var statusClassNames = [...]string{"2xx", "3xx", "4xx", "5xx"}
+
+// Collector accumulates entries and builds a Report from them. A Collector is
+// not safe for concurrent use.
+type Collector struct {
+	total     int
+	malformed int
+	paths     map[string]int
+	classes   [len(statusClassNames)]int // counts for 2xx to 5xx
+	latencies []time.Duration            // one per request
+	errors5xx map[time.Time]int          // 5xx responses by start of UTC hour
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{
+		paths:     map[string]int{},
+		errors5xx: map[time.Time]int{},
+	}
+}
+
+// Add records one request. Responses with a 1xx status count toward the total
+// and the latency but not toward any status class.
+func (c *Collector) Add(e logparse.Entry) {
+	c.total++
+	c.paths[e.Path]++
+	c.latencies = append(c.latencies, e.RequestTime)
+
+	class := e.Status / 100
+	if class >= 2 && class <= 5 {
+		c.classes[class-2]++
+	}
+	if class == 5 {
+		c.errors5xx[e.Time.UTC().Truncate(time.Hour)]++
+	}
+}
+
+// AddMalformed adds n lines that could not be parsed to the malformed count.
+func (c *Collector) AddMalformed(n int) {
+	c.malformed += n
+}
+
+// Report builds the report from everything added so far. It lists at most top
+// paths, most requested first, with ties sorted by path.
+func (c *Collector) Report(top int) Report {
+	return Report{
+		TotalRequests:   c.total,
+		MalformedLines:  c.malformed,
+		TopPaths:        c.topPaths(top),
+		StatusClasses:   c.statusClasses(),
+		RequestTimeMS:   c.latency(),
+		Errors5xxByHour: c.hourly(),
+	}
+}
+
+// topPaths returns at most n paths, most requested first.
+func (c *Collector) topPaths(n int) []PathCount {
+	out := make([]PathCount, 0, len(c.paths))
+	for path, count := range c.paths {
+		out = append(out, PathCount{Path: path, Count: count})
+	}
+	slices.SortFunc(out, func(a, b PathCount) int {
+		return cmp.Or(cmp.Compare(b.Count, a.Count), strings.Compare(a.Path, b.Path))
+	})
+	if n < 0 {
+		n = 0
+	}
+	if len(out) > n {
+		out = out[:n]
+	}
+	return out
+}
+
+// statusClasses returns one entry per class, in order from 2xx to 5xx.
+func (c *Collector) statusClasses() []StatusClass {
+	out := make([]StatusClass, 0, len(statusClassNames))
+	for i, name := range statusClassNames {
+		out = append(out, StatusClass{Class: name, Count: c.classes[i]})
+	}
+	return out
+}
+
+// latency returns the request time percentiles.
+func (c *Collector) latency() Latency {
+	sorted := slices.Clone(c.latencies)
+	slices.Sort(sorted)
+	// The percentiles are fixed valid values, so the ok result is not needed:
+	// with no samples each one is 0 and Samples says so.
+	p50, _ := Percentile(sorted, 50)
+	p95, _ := Percentile(sorted, 95)
+	p99, _ := Percentile(sorted, 99)
+	return Latency{
+		Samples: len(sorted),
+		P50:     millis(p50),
+		P95:     millis(p95),
+		P99:     millis(p99),
+	}
+}
+
+// hourly returns the 5xx count for each hour that had at least one, oldest first.
+func (c *Collector) hourly() []HourCount {
+	out := make([]HourCount, 0, len(c.errors5xx))
+	for hour, count := range c.errors5xx {
+		out = append(out, HourCount{Hour: hour, Count: count})
+	}
+	slices.SortFunc(out, func(a, b HourCount) int {
+		return a.Hour.Compare(b.Hour)
+	})
+	return out
+}
+
+// Percentile returns the p-th percentile of sorted, which must be in ascending
+// order, using the nearest-rank method. The result is always a value from
+// sorted. The bool is false when sorted is empty or p is not in [0, 100].
+func Percentile(sorted []time.Duration, p float64) (time.Duration, bool) {
+	n := len(sorted)
+	if n == 0 || math.IsNaN(p) || p < 0 || p > 100 {
+		return 0, false
+	}
+	rank := int(math.Ceil(p * float64(n) / 100))
+	rank = max(rank, 1)
+	return sorted[rank-1], true
+}
+
+// millis converts d to milliseconds.
+func millis(d time.Duration) float64 {
+	return float64(d) / float64(time.Millisecond)
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..2906d4f
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,361 @@
+package stats
+
+import (
+	"math"
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// entry returns a request with the given path, status and request time in
+// milliseconds, received at the given UTC time.
+func entry(path string, status int, ms int, at time.Time) logparse.Entry {
+	return logparse.Entry{
+		Time:        at,
+		Method:      "GET",
+		Path:        path,
+		Status:      status,
+		RequestTime: time.Duration(ms) * time.Millisecond,
+	}
+}
+
+func TestPercentile(t *testing.T) {
+	ms := func(n ...int) []time.Duration {
+		out := make([]time.Duration, len(n))
+		for i, v := range n {
+			out[i] = time.Duration(v) * time.Millisecond
+		}
+		return out
+	}
+	seq := func(n int) []time.Duration {
+		out := make([]time.Duration, n)
+		for i := range out {
+			out[i] = time.Duration(i+1) * time.Millisecond
+		}
+		return out
+	}
+
+	tests := []struct {
+		name   string
+		sorted []time.Duration
+		p      float64
+		want   time.Duration
+		wantOK bool
+	}{
+		{name: "empty input", sorted: nil, p: 50, want: 0, wantOK: false},
+		{name: "empty slice", sorted: []time.Duration{}, p: 99, want: 0, wantOK: false},
+		{name: "single value at p50", sorted: ms(7), p: 50, want: 7 * time.Millisecond, wantOK: true},
+		{name: "single value at p0", sorted: ms(7), p: 0, want: 7 * time.Millisecond, wantOK: true},
+		{name: "single value at p99", sorted: ms(7), p: 99, want: 7 * time.Millisecond, wantOK: true},
+		{name: "single value at p100", sorted: ms(7), p: 100, want: 7 * time.Millisecond, wantOK: true},
+		{name: "p0 is the minimum", sorted: seq(10), p: 0, want: 1 * time.Millisecond, wantOK: true},
+		{name: "p100 is the maximum", sorted: seq(10), p: 100, want: 10 * time.Millisecond, wantOK: true},
+		{name: "p50 of even count takes lower middle", sorted: seq(10), p: 50, want: 5 * time.Millisecond, wantOK: true},
+		{name: "p50 of odd count is the middle", sorted: seq(5), p: 50, want: 3 * time.Millisecond, wantOK: true},
+		{name: "p95 of 20 values is the 19th", sorted: seq(20), p: 95, want: 19 * time.Millisecond, wantOK: true},
+		{name: "p99 of 100 values is the 99th", sorted: seq(100), p: 99, want: 99 * time.Millisecond, wantOK: true},
+		{name: "p99 of 10 values is the maximum", sorted: seq(10), p: 99, want: 10 * time.Millisecond, wantOK: true},
+		{name: "p just above a rank boundary moves up", sorted: seq(4), p: 25.5, want: 2 * time.Millisecond, wantOK: true},
+		{name: "duplicates", sorted: ms(5, 5, 5, 9), p: 50, want: 5 * time.Millisecond, wantOK: true},
+		{name: "negative p", sorted: seq(3), p: -1, want: 0, wantOK: false},
+		{name: "p above 100", sorted: seq(3), p: 101, want: 0, wantOK: false},
+		{name: "NaN p", sorted: seq(3), p: math.NaN(), want: 0, wantOK: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, ok := Percentile(tt.sorted, tt.p)
+			if got != tt.want || ok != tt.wantOK {
+				t.Errorf("Percentile(%d values, %v) = %v, %v, want %v, %v", len(tt.sorted), tt.p, got, ok, tt.want, tt.wantOK)
+			}
+		})
+	}
+}
