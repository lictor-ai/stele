+func TestReportSingleRequest(t *testing.T) {
+	c := NewCollector()
+	at := time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC)
+	c.Add(entry("/api/items", 503, 42, at))
+
+	r := c.Report(10)
+
+	if r.TotalRequests != 1 {
+		t.Errorf("TotalRequests = %d, want 1", r.TotalRequests)
+	}
+	if len(r.TopPaths) != 1 || r.TopPaths[0] != (PathCount{Path: "/api/items", Count: 1}) {
+		t.Errorf("TopPaths = %+v, want one entry for /api/items with count 1", r.TopPaths)
+	}
+	if got := r.StatusClasses[3]; got != (StatusClass{Class: "5xx", Count: 1}) {
+		t.Errorf("StatusClasses[5xx] = %+v, want count 1", got)
+	}
+	want := Latency{Samples: 1, P50: 42, P95: 42, P99: 42}
+	if r.RequestTimeMS != want {
+		t.Errorf("RequestTimeMS = %+v, want %+v", r.RequestTimeMS, want)
+	}
+	if len(r.Errors5xxByHour) != 1 || r.Errors5xxByHour[0].Count != 1 || !r.Errors5xxByHour[0].Hour.Equal(time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)) {
+		t.Errorf("Errors5xxByHour = %+v, want one entry for 13:00 UTC with count 1", r.Errors5xxByHour)
+	}
+}
