+func TestReportLatencyPercentiles(t *testing.T) {
+	at := time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)
+	tests := []struct {
+		name string
+		ms   []int
+		want Latency
+	}{
+		{
+			name: "ten requests",
+			ms:   []int{10, 90, 20, 80, 30, 70, 40, 60, 50, 100},
+			want: Latency{Samples: 10, P50: 50, P95: 100, P99: 100},
+		},
+		{
+			name: "one hundred requests",
+			ms:   seqMS(100),
+			want: Latency{Samples: 100, P50: 50, P95: 95, P99: 99},
+		},
+		{
+			name: "zero request time",
+			ms:   []int{0, 0},
+			want: Latency{Samples: 2, P50: 0, P95: 0, P99: 0},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			for _, v := range tt.ms {
+				c.Add(entry("/", 200, v, at))
+			}
+			got := c.Report(10).RequestTimeMS
+			if got != tt.want {
+				t.Errorf("RequestTimeMS for %d requests = %+v, want %+v", len(tt.ms), got, tt.want)
+			}
+		})
+	}
+}
+
+// seqMS returns 1 to n, as milliseconds.
+func seqMS(n int) []int {
+	out := make([]int, n)
+	for i := range out {
+		out[i] = i + 1
+	}
+	return out
+}
