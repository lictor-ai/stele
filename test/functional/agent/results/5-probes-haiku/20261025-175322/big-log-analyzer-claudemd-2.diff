new file mode 100644
index 0000000..c8f3964
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,93 @@
+// Command loga reads nginx access logs and prints a summary report.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// errUsage reports a bad command line. The flag package has already printed
+// the reason, so main exits with status 2 and prints nothing more.
+var errUsage = errors.New("usage")
+
+func main() {
+	err := run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	switch {
+	case err == nil:
+	case errors.Is(err, errUsage):
+		os.Exit(2)
+	default:
+		fmt.Fprintln(os.Stderr, "loga:", err)
+		os.Exit(1)
+	}
+}
+
+// run analyzes the files named in args, or stdin when there are none, and
+// writes the report to stdout. Stdin is a parameter so tests can supply input.
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to list")
+	asJSON := fs.Bool("json", false, "print the report as JSON instead of a table")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return errUsage
+	}
+	if *top < 1 {
+		fmt.Fprintf(stderr, "loga: -top must be at least 1, got %d\n", *top)
+		return errUsage
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	c := stats.NewCollector()
+	if fs.NArg() == 0 {
+		if err := consume(ctx, stdin, c); err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+	}
+	for _, name := range fs.Args() {
+		if err := readFile(ctx, name, c); err != nil {
+			return err
+		}
+	}
+
+	report := c.Report(*top)
+	if *asJSON {
+		return writeJSON(stdout, report)
+	}
+	return writeText(stdout, report)
+}
+
+// readFile adds the entries in the named file to c.
+func readFile(ctx context.Context, name string, c *stats.Collector) error {
+	f, err := os.Open(name)
+	if err != nil {
+		// The *fs.PathError from Open already names the file.
+		return err
+	}
+	defer f.Close()
+	if err := consume(ctx, f, c); err != nil {
+		return fmt.Errorf("read %s: %w", name, err)
+	}
+	return nil
+}
+
+// consume parses r and adds its entries and malformed-line count to c.
+func consume(ctx context.Context, r io.Reader, c *stats.Collector) error {
+	malformed, err := logparse.Read(ctx, r, c.Add)
+	c.AddMalformed(malformed)
+	return err
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..38024f9
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,238 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/stats"
+)
+
+const logA = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.040
+203.0.113.9 - - [10/Oct/2026:13:55:37 +0000] "GET /api/items?id=4 HTTP/1.1" 200 512 "-" "curl/8.0" 0.060
+203.0.113.10 - - [10/Oct/2026:13:59:59 +0000] "POST /login HTTP/1.1" 302 0 "-" "curl/8.0" 0.200
+`
+
+const logB = `not a log line
+203.0.113.11 - - [10/Oct/2026:14:00:01 +0000] "GET / HTTP/1.1" 500 0 "-" "curl/8.0" 1.000
+203.0.113.11 - - [10/Oct/2026:14:00:02 +0000] "GET /api/items HTTP/1.1" 404 0 "-" "curl/8.0" 0.010
+
+203.0.113.12 - - [10/Oct/2026:14:20:02 +0000] "GET /api/items HTTP/1.1" 503 0 "-" "curl/8.0" 0.010
+`
+
+// writeLog writes content to a new file in a test temp dir and returns its path.
+func writeLog(t *testing.T, name, content string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), name)
+	if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
+		t.Fatalf("write %s: %v", path, err)
+	}
+	return path
+}
+
+// runJSON runs the command with -json added and decodes the report.
+func runJSON(t *testing.T, args []string, stdin string) stats.Report {
+	t.Helper()
+	var out, errOut bytes.Buffer
+	if err := run(append([]string{"-json"}, args...), strings.NewReader(stdin), &out, &errOut); err != nil {
+		t.Fatalf("run(%q) error = %v, want nil; stderr = %q", args, err, errOut.String())
+	}
+	var r stats.Report
+	if err := json.Unmarshal(out.Bytes(), &r); err != nil {
+		t.Fatalf("run(%q) output is not JSON: %v\n%s", args, err, out.String())
+	}
+	return r
+}
+
+func TestRunFiles(t *testing.T) {
+	a := writeLog(t, "a.log", logA)
+	b := writeLog(t, "b.log", logB)
+
+	r := runJSON(t, []string{a, b}, "")
+
+	if r.TotalRequests != 6 {
+		t.Errorf("total_requests = %d, want 6", r.TotalRequests)
+	}
+	if r.MalformedLines != 1 {
+		t.Errorf("malformed_lines = %d, want 1", r.MalformedLines)
+	}
+	wantPaths := []stats.PathCount{{Path: "/api/items", Count: 4}, {Path: "/", Count: 1}, {Path: "/login", Count: 1}}
+	if len(r.TopPaths) != len(wantPaths) {
+		t.Fatalf("len(top_paths) = %d, want %d", len(r.TopPaths), len(wantPaths))
+	}
+	for i, want := range wantPaths {
+		if r.TopPaths[i] != want {
+			t.Errorf("top_paths[%d] = %+v, want %+v", i, r.TopPaths[i], want)
+		}
+	}
+	wantClasses := []int{2, 1, 1, 2}
+	for i, want := range wantClasses {
+		if got := r.StatusClasses[i].Count; got != want {
+			t.Errorf("status_classes[%s] = %d, want %d", r.StatusClasses[i].Class, got, want)
+		}
+	}
+	if r.RequestTimeMS.Samples != 6 {
+		t.Errorf("request_time_ms.samples = %d, want 6", r.RequestTimeMS.Samples)
+	}
+	// The 500 at 14:00:01 and the 503 at 14:20:02 share the 14:00 UTC hour.
+	if len(r.Errors5xxByHour) != 1 {
+		t.Fatalf("len(errors_5xx_by_hour) = %d, want 1", len(r.Errors5xxByHour))
+	}
+	if got := r.Errors5xxByHour[0]; got.Hour.Hour() != 14 || got.Count != 2 {
+		t.Errorf("errors_5xx_by_hour[0] = %v x%d, want 14:00 UTC x2", got.Hour, got.Count)
+	}
+}
+
+func TestRunStdin(t *testing.T) {
+	r := runJSON(t, nil, logA)
+
+	if r.TotalRequests != 3 {
+		t.Errorf("total_requests = %d, want 3", r.TotalRequests)
+	}
+	if r.MalformedLines != 0 {
+		t.Errorf("malformed_lines = %d, want 0", r.MalformedLines)
+	}
+}
+
+func TestRunJSONEmptyInput(t *testing.T) {
+	r := runJSON(t, nil, "")
+
+	if r.TotalRequests != 0 || r.MalformedLines != 0 {
+		t.Errorf("totals = %d requests, %d malformed; want 0, 0", r.TotalRequests, r.MalformedLines)
+	}
+	if len(r.TopPaths) != 0 {
+		t.Errorf("len(top_paths) = %d, want 0", len(r.TopPaths))
+	}
+	if r.RequestTimeMS.Samples != 0 {
+		t.Errorf("request_time_ms.samples = %d, want 0", r.RequestTimeMS.Samples)
+	}
+}
+
+func TestRunTop(t *testing.T) {
+	a := writeLog(t, "a.log", logA)
+	b := writeLog(t, "b.log", logB)
+
+	tests := []struct {
+		name     string
+		top      []string
+		wantSize int
+	}{
+		{name: "default is ten", top: nil, wantSize: 3},
+		{name: "top one", top: []string{"-top", "1"}, wantSize: 1},
+		{name: "top larger than paths", top: []string{"-top", "50"}, wantSize: 3},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			args := append(append([]string{}, tt.top...), a, b)
+			r := runJSON(t, args, "")
+			if len(r.TopPaths) != tt.wantSize {
+				t.Errorf("run(%q) len(top_paths) = %d, want %d", args, len(r.TopPaths), tt.wantSize)
+			}
+		})
+	}
+}
+
+func TestRunText(t *testing.T) {
+	a := writeLog(t, "a.log", logA)
+	b := writeLog(t, "b.log", logB)
+
+	var out, errOut bytes.Buffer
+	if err := run([]string{"-top", "2", a, b}, strings.NewReader(""), &out, &errOut); err != nil {
+		t.Fatalf("run(text) error = %v, want nil; stderr = %q", err, errOut.String())
+	}
+	text := out.String()
+	wants := []string{
+		"Requests",
+		"Malformed lines",
+		"Top paths",
+		"/api/items",
+		"Status classes",
+		"2xx",
+		"5xx",
+		"Request time (ms)",
+		"p50",
+		"p95",
+		"p99",
+		"5xx errors per hour (UTC)",
+		"2026-10-10 14:00",
+	}
+	for _, want := range wants {
+		if !strings.Contains(text, want) {
+			t.Errorf("run(text) output does not contain %q:\n%s", want, text)
+		}
+	}
+	if strings.Contains(text, "/login") {
+		t.Errorf("run(-top 2) output lists a third path:\n%s", text)
+	}
+}
+
+func TestRunTextEmptyInput(t *testing.T) {
+	var out, errOut bytes.Buffer
+	if err := run(nil, strings.NewReader(""), &out, &errOut); err != nil {
+		t.Fatalf("run(empty) error = %v, want nil", err)
+	}
+	text := out.String()
+	for _, want := range []string{"(none)", "(no requests)"} {
+		if !strings.Contains(text, want) {
+			t.Errorf("run(empty) output does not contain %q:\n%s", want, text)
+		}
+	}
+}
+
+func TestRunErrors(t *testing.T) {
+	tests := []struct {
+		name      string
+		args      []string
+		wantUsage bool
+		wantText  string
+	}{
+		{name: "unknown flag is a usage error", args: []string{"-nope"}, wantUsage: true},
+		{name: "non-numeric top is a usage error", args: []string{"-top", "many"}, wantUsage: true},
+		{name: "top of zero is a usage error", args: []string{"-top", "0"}, wantUsage: true, wantText: "-top must be at least 1"},
+		{name: "negative top is a usage error", args: []string{"-top", "-1"}, wantUsage: true, wantText: "-top must be at least 1"},
+		{name: "missing file is a read error", args: []string{filepath.Join("no", "such", "file.log")}, wantUsage: false, wantText: "file.log"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(tt.args, strings.NewReader(""), &out, &errOut)
+			if err == nil {
+				t.Fatalf("run(%q) error = nil, want an error", tt.args)
+			}
+			if got := errors.Is(err, errUsage); got != tt.wantUsage {
+				t.Errorf("run(%q) errors.Is(err, errUsage) = %v, want %v; err = %v", tt.args, got, tt.wantUsage, err)
+			}
+			if tt.wantText != "" && !strings.Contains(err.Error()+errOut.String(), tt.wantText) {
+				t.Errorf("run(%q) error = %q, stderr = %q; want text %q", tt.args, err, errOut.String(), tt.wantText)
+			}
+			if out.Len() != 0 {
+				t.Errorf("run(%q) wrote %q to stdout, want nothing", tt.args, out.String())
+			}
+		})
+	}
+}
+
+func TestRunMissingFileNamesFile(t *testing.T) {
+	name := filepath.Join(t.TempDir(), "gone.log")
+	err := run([]string{name}, strings.NewReader(""), &bytes.Buffer{}, &bytes.Buffer{})
+	if err == nil {
+		t.Fatalf("run(%q) error = nil, want an error", name)
+	}
+	if !strings.Contains(err.Error(), "gone.log") {
+		t.Errorf("run(%q) error = %q, want it to name the file", name, err)
+	}
+}
+
+func TestRunHelp(t *testing.T) {
+	var out, errOut bytes.Buffer
+	if err := run([]string{"-h"}, strings.NewReader(""), &out, &errOut); err != nil {
+		t.Errorf("run(-h) error = %v, want nil", err)
+	}
+	if !strings.Contains(errOut.String(), "-top") {
+		t.Errorf("run(-h) stderr = %q, want the flag list", errOut.String())
+	}
+}
diff --git a/cmd/loga/report.go b/cmd/loga/report.go
new file mode 100644
index 0000000..324e45f
--- /dev/null
+++ b/cmd/loga/report.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"text/tabwriter"
+
+	"example.com/app/internal/stats"
+)
+
+// writeJSON writes r as indented JSON.
+func writeJSON(w io.Writer, r stats.Report) error {
+	enc := json.NewEncoder(w)
+	enc.SetIndent("", "  ")
+	return enc.Encode(r)
+}
+
+// writeText writes r as a plain-text report with aligned columns.
+func writeText(w io.Writer, r stats.Report) error {
+	tw := tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+
+	fmt.Fprintf(tw, "Requests\t%d\n", r.TotalRequests)
+	fmt.Fprintf(tw, "Malformed lines\t%d\n", r.MalformedLines)
+
+	fmt.Fprintf(tw, "\nTop paths\n")
+	if len(r.TopPaths) == 0 {
+		fmt.Fprintf(tw, "  (none)\n")
+	}
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(tw, "  %d\t%s\n", p.Count, p.Path)
+	}
+
+	fmt.Fprintf(tw, "\nStatus classes\n")
+	for _, s := range r.StatusClasses {
+		fmt.Fprintf(tw, "  %s\t%d\n", s.Class, s.Count)
+	}
+
+	fmt.Fprintf(tw, "\nRequest time (ms)\n")
+	if r.RequestTimeMS.Samples == 0 {
+		fmt.Fprintf(tw, "  (no requests)\n")
+	} else {
+		fmt.Fprintf(tw, "  p50\t%.3f\n", r.RequestTimeMS.P50)
+		fmt.Fprintf(tw, "  p95\t%.3f\n", r.RequestTimeMS.P95)
+		fmt.Fprintf(tw, "  p99\t%.3f\n", r.RequestTimeMS.P99)
+	}
+
+	fmt.Fprintf(tw, "\n5xx errors per hour (UTC)\n")
+	if len(r.Errors5xxByHour) == 0 {
+		fmt.Fprintf(tw, "  (none)\n")
+	}
+	for _, h := range r.Errors5xxByHour {
+		fmt.Fprintf(tw, "  %s\t%d\n", h.Hour.Format("2006-01-02 15:00"), h.Count)
+	}
+
+	return tw.Flush()
+}
