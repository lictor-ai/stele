+// entry returns a request for path with the given status and request time.
+func entry(path string, status int, ms int) logparse.Entry {
+	return logparse.Entry{
+		Time:        time.Date(2026, 10, 10, 13, 30, 0, 0, time.UTC),
+		Method:      "GET",
+		Path:        path,
+		Status:      status,
+		RequestTime: time.Duration(ms) * time.Millisecond,
+	}
+}
