@@ -0,0 +1,248 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/stats"
+)
+
+const (
+	okLine      = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+	errLine     = `203.0.113.9 - - [10/Oct/2026:13:56:01 +0000] "GET /api/items HTTP/1.1" 503 0 "-" "curl/8.0" 1.000`
+	homeLine    = `198.51.100.4 - - [10/Oct/2026:14:02:10 +0000] "GET / HTTP/1.1" 200 2048 "-" "Mozilla/5.0" 0.100`
+	badLine     = `this is not a log line`
+	missingFile = "does-not-exist.log"
+)
+
+// sample is a small log: four requests and one malformed line.
+var sample = strings.Join([]string{okLine, badLine, errLine, homeLine, okLine}, "\n") + "\n"
+
+// hasRow reports whether some line of out has exactly the given fields.
+// Text output is aligned with spaces, so the test compares fields, not columns.
+func hasRow(out string, fields ...string) bool {
+	for _, line := range strings.Split(out, "\n") {
+		if slices.Equal(strings.Fields(line), fields) {
+			return true
+		}
+	}
+	return false
+}
+
+// pathRows counts the rows of out that look like "COUNT PATH".
+func pathRows(out string) int {
+	n := 0
+	for _, line := range strings.Split(out, "\n") {
+		f := strings.Fields(line)
+		if len(f) == 2 && strings.HasPrefix(f[1], "/") {
+			n++
+		}
+	}
+	return n
+}
+
+func TestRunText(t *testing.T) {
+	var out, errOut bytes.Buffer
+	err := run(t.Context(), nil, strings.NewReader(sample), &out, &errOut)
+	if err != nil {
+		t.Fatalf("run() error = %v, want nil", err)
+	}
+	got := out.String()
+	wantRows := [][]string{
+		{"Requests:", "4"},
+		{"Malformed", "lines:", "1"},
+		{"3", "/api/items"},
+		{"1", "/"},
+		{"2xx", "3"},
+		{"3xx", "0"},
+		{"4xx", "0"},
+		{"5xx", "1"},
+		{"other", "0"},
+		{"p50", "42.000"},
+		{"p95", "1000.000"},
+		{"p99", "1000.000"},
+		{"2026-10-10", "13:00", "1"},
+	}
+	for _, row := range wantRows {
+		if !hasRow(got, row...) {
+			t.Errorf("run() output has no row %q\n%s", row, got)
+		}
+	}
+	if strings.Contains(got, "?id=3") {
+		t.Errorf("run() output contains the query string\n%s", got)
+	}
+}
+
+func TestRunJSON(t *testing.T) {
+	var out bytes.Buffer
+	err := run(t.Context(), []string{"-json"}, strings.NewReader(sample), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run(-json) error = %v, want nil", err)
+	}
+	var rep stats.Report
+	if err := json.Unmarshal(out.Bytes(), &rep); err != nil {
+		t.Fatalf("run(-json) output is not JSON: %v\n%s", err, out.String())
+	}
+	if rep.Requests != 4 {
+		t.Errorf("run(-json).Requests = %d, want 4", rep.Requests)
+	}
+	if rep.Malformed != 1 {
+		t.Errorf("run(-json).Malformed = %d, want 1", rep.Malformed)
+	}
+	wantPaths := []stats.PathCount{{Path: "/api/items", Count: 3}, {Path: "/", Count: 1}}
+	if !slices.Equal(rep.TopPaths, wantPaths) {
+		t.Errorf("run(-json).TopPaths = %+v, want %+v", rep.TopPaths, wantPaths)
+	}
+	if rep.StatusClasses.Class2xx != 3 || rep.StatusClasses.Class5xx != 1 {
+		t.Errorf("run(-json).StatusClasses = %+v, want 2xx=3 and 5xx=1", rep.StatusClasses)
+	}
+	if rep.LatencyMS.P50 != 42 || rep.LatencyMS.P99 != 1000 {
+		t.Errorf("run(-json).LatencyMS = %+v, want p50=42 and p99=1000", rep.LatencyMS)
+	}
+	if len(rep.Errors5xxByHour) != 1 || rep.Errors5xxByHour[0].Count != 1 {
+		t.Errorf("run(-json).Errors5xxByHour = %+v, want one hour with count 1", rep.Errors5xxByHour)
+	}
+	if !strings.Contains(out.String(), `"errors_5xx_by_hour"`) {
+		t.Errorf("run(-json) output does not use snake_case keys\n%s", out.String())
+	}
+}
+
+func TestRunJSONEmptyArraysAreNotNull(t *testing.T) {
+	var out bytes.Buffer
+	err := run(t.Context(), []string{"-json"}, strings.NewReader(""), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run(-json) on empty input error = %v, want nil", err)
+	}
+	for _, want := range []string{`"top_paths": []`, `"errors_5xx_by_hour": []`} {
+		if !strings.Contains(out.String(), want) {
+			t.Errorf("run(-json) on empty input does not contain %q\n%s", want, out.String())
+		}
+	}
+}
+
+func TestRunEmptyInput(t *testing.T) {
+	var out bytes.Buffer
+	err := run(t.Context(), nil, strings.NewReader(""), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run() on empty input error = %v, want nil", err)
+	}
+	for _, row := range [][]string{{"Requests:", "0"}, {"Malformed", "lines:", "0"}, {"none"}} {
+		if !hasRow(out.String(), row...) {
+			t.Errorf("run() on empty input has no row %q\n%s", row, out.String())
+		}
+	}
+}
+
+func TestRunTopFlag(t *testing.T) {
+	tests := []struct {
+		name      string
+		args      []string
+		wantPaths int
+	}{
+		{"default lists up to 10 paths", nil, 2},
+		{"top 1 lists one path", []string{"-top", "1"}, 1},
+		{"top larger than the number of paths", []string{"-top", "50"}, 2},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out bytes.Buffer
+			err := run(t.Context(), tt.args, strings.NewReader(sample), &out, &bytes.Buffer{})
+			if err != nil {
+				t.Fatalf("run(%q) error = %v, want nil", tt.args, err)
+			}
+			if got := pathRows(out.String()); got != tt.wantPaths {
+				t.Errorf("run(%q) listed %d paths, want %d\n%s", tt.args, got, tt.wantPaths, out.String())
+			}
+		})
+	}
+}
+
+func TestRunFiles(t *testing.T) {
+	dir := t.TempDir()
+	first := filepath.Join(dir, "a.log")
+	second := filepath.Join(dir, "b.log")
+	if err := os.WriteFile(first, []byte(okLine+"\n"+errLine+"\n"), 0o600); err != nil {
+		t.Fatalf("write %s: %v", first, err)
+	}
+	if err := os.WriteFile(second, []byte(homeLine+"\n"+badLine+"\n"), 0o600); err != nil {
+		t.Fatalf("write %s: %v", second, err)
+	}
+
+	var out bytes.Buffer
+	err := run(t.Context(), []string{"-json", first, second}, strings.NewReader(""), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run(%s, %s) error = %v, want nil", first, second, err)
+	}
+	var rep stats.Report
+	if err := json.Unmarshal(out.Bytes(), &rep); err != nil {
+		t.Fatalf("run() output is not JSON: %v\n%s", err, out.String())
+	}
+	if rep.Requests != 3 || rep.Malformed != 1 {
+		t.Errorf("run() over two files: requests=%d malformed=%d, want 3 and 1", rep.Requests, rep.Malformed)
+	}
+}
+
+func TestRunDashReadsStdin(t *testing.T) {
+	var out bytes.Buffer
+	err := run(t.Context(), []string{"-json", "-"}, strings.NewReader(okLine+"\n"), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run(-) error = %v, want nil", err)
+	}
+	var rep stats.Report
+	if err := json.Unmarshal(out.Bytes(), &rep); err != nil {
+		t.Fatalf("run(-) output is not JSON: %v\n%s", err, out.String())
+	}
+	if rep.Requests != 1 {
+		t.Errorf("run(-).Requests = %d, want 1", rep.Requests)
+	}
+}
+
+func TestRunErrors(t *testing.T) {
+	cancelled, cancel := context.WithCancel(t.Context())
+	cancel()
+
+	tests := []struct {
+		name     string
+		ctx      context.Context
+		args     []string
+		wantCode int
+	}{
+		{"unknown flag", t.Context(), []string{"-nope"}, 2},
+		{"top zero", t.Context(), []string{"-top", "0"}, 2},
+		{"top negative", t.Context(), []string{"-top", "-1"}, 2},
+		{"top not a number", t.Context(), []string{"-top", "many"}, 2},
+		{"missing file", t.Context(), []string{missingFile}, 1},
+		{"cancelled context", cancelled, nil, 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := run(tt.ctx, tt.args, strings.NewReader(sample), &bytes.Buffer{}, &bytes.Buffer{})
+			if err == nil {
+				t.Fatalf("run(%q) error = nil, want an error", tt.args)
+			}
+			if got := exitCode(err); got != tt.wantCode {
+				t.Errorf("run(%q) exit code = %d, want %d (error: %v)", tt.args, got, tt.wantCode, err)
+			}
+		})
+	}
+}
+
+func TestRunHelp(t *testing.T) {
+	var out, errOut bytes.Buffer
+	err := run(t.Context(), []string{"-h"}, strings.NewReader(""), &out, &errOut)
+	if err != nil {
+		t.Fatalf("run(-h) error = %v, want nil", err)
+	}
+	if out.Len() != 0 {
+		t.Errorf("run(-h) wrote %q to stdout, want nothing", out.String())
+	}
+	if !strings.Contains(errOut.String(), "-top") {
+		t.Errorf("run(-h) usage on stderr does not mention -top\n%s", errOut.String())
+	}
+}
