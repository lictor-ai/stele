index 0000000..0b1e2b4
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,149 @@
+// Command loga reads nginx access logs and prints a summary report.
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+	"text/tabwriter"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// usageError marks a bad command line. The process exits with code 2.
+type usageError struct{ err error }
+
+// Error returns the message of the wrapped error.
+func (e usageError) Error() string { return e.err.Error() }
+
+// Unwrap returns the wrapped error.
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	stop()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "loga:", err)
+		os.Exit(exitCode(err))
+	}
+}
+
+// exitCode maps an error from run to the process exit code.
+func exitCode(err error) int {
+	var ue usageError
+	if errors.As(err, &ue) {
+		return 2
+	}
+	return 1
+}
+
+// run parses args, reads the log files (or stdin when none are named, or when
+// a name is "-"), and writes the report to stdout.
+func run(ctx context.Context, args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	top := fs.Int("top", 10, "number of paths to list")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			fs.SetOutput(stderr)
+			fs.Usage()
+			return nil
+		}
+		return usageError{fmt.Errorf("%w; run loga -h for usage", err)}
+	}
+	if *top < 1 {
+		return usageError{fmt.Errorf("-top must be at least 1, got %d", *top)}
+	}
+
+	names := fs.Args()
+	if len(names) == 0 {
+		names = []string{"-"}
+	}
+	c := stats.NewCollector()
+	for _, name := range names {
+		if err := scanFile(ctx, name, stdin, c); err != nil {
+			return err
+		}
+	}
+
+	rep, err := c.Report(*top)
+	if err != nil {
+		return fmt.Errorf("build report: %w", err)
+	}
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		return enc.Encode(rep)
+	}
+	return writeText(stdout, rep)
+}
+
+// scanFile adds the requests in the named file to c. The name "-" reads stdin.
+func scanFile(ctx context.Context, name string, stdin io.Reader, c *stats.Collector) error {
+	src := stdin
+	if name != "-" {
+		f, err := os.Open(name) // the error already says "open NAME: ..."
+		if err != nil {
+			return err
+		}
+		defer f.Close()
+		src = f
+	}
+	skipped, err := logparse.Scan(ctx, src, c.Add)
+	c.AddMalformed(skipped)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", name, err)
+	}
+	return nil
+}
+
+// writeText prints the report as aligned tables.
+func writeText(w io.Writer, r stats.Report) error {
+	var buf bytes.Buffer
+	tw := tabwriter.NewWriter(&buf, 0, 0, 2, ' ', 0)
+	fmt.Fprintf(tw, "Requests:\t%d\n", r.Requests)
+	fmt.Fprintf(tw, "Malformed lines:\t%d\n", r.Malformed)
+
+	fmt.Fprintf(tw, "\nTop paths\n")
+	fmt.Fprintf(tw, "  COUNT\tPATH\n")
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(tw, "  %d\t%s\n", p.Count, p.Path)
+	}
+
+	sc := r.StatusClasses
+	fmt.Fprintf(tw, "\nStatus classes\n")
+	fmt.Fprintf(tw, "  2xx\t%d\n", sc.Class2xx)
+	fmt.Fprintf(tw, "  3xx\t%d\n", sc.Class3xx)
+	fmt.Fprintf(tw, "  4xx\t%d\n", sc.Class4xx)
+	fmt.Fprintf(tw, "  5xx\t%d\n", sc.Class5xx)
+	fmt.Fprintf(tw, "  other\t%d\n", sc.Other)
+
+	fmt.Fprintf(tw, "\nRequest time (ms)\n")
+	fmt.Fprintf(tw, "  p50\t%.3f\n", r.LatencyMS.P50)
+	fmt.Fprintf(tw, "  p95\t%.3f\n", r.LatencyMS.P95)
+	fmt.Fprintf(tw, "  p99\t%.3f\n", r.LatencyMS.P99)
+
+	fmt.Fprintf(tw, "\n5xx errors per hour (UTC)\n")
+	if len(r.Errors5xxByHour) == 0 {
+		fmt.Fprintf(tw, "  none\n")
+	}
+	for _, h := range r.Errors5xxByHour {
+		fmt.Fprintf(tw, "  %s\t%d\n", h.Hour.Format("2006-01-02 15:04"), h.Count)
+	}
+
+	if err := tw.Flush(); err != nil {
+		return err
+	}
+	_, err := w.Write(buf.Bytes())
+	return err
+}
