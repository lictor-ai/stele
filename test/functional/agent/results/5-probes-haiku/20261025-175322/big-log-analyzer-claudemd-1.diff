index 0000000..a706c43
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,235 @@
+// Package logparse reads nginx access logs in the "combined" format with the
+// request time appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// MaxLineBytes is the longest line Scan accepts. A longer line is counted as
+// malformed and skipped.
+const MaxLineBytes = 64 << 10
+
+// maxRequestSeconds is the largest request time that fits in a time.Duration.
+const maxRequestSeconds = math.MaxInt64 / int64(time.Second)
+
+// timeLayout is the nginx time format inside the square brackets.
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// Entry is one parsed request.
+type Entry struct {
+	Time        time.Time     // when the request was logged
+	Method      string        // HTTP method, such as GET
+	Path        string        // request path with the query string removed
+	Status      int           // HTTP status code, from 100 to 599
+	Bytes       int64         // response body size; 0 when the log has "-"
+	RequestTime time.Duration // time taken to serve the request
+}
+
+// ParseLine parses one log line. It returns an error that wraps ErrMalformed
+// when the line does not match the format. The error names the bad field.
+func ParseLine(line string) (Entry, error) {
+	var e Entry
+	var err error
+	s := strings.TrimSpace(line)
+
+	// The format carries the remote address, identity and user name. They are
+	// checked for presence only.
+	if _, s, err = token(s, "remote address"); err != nil {
+		return Entry{}, err
+	}
+	if _, s, err = token(s, "identity"); err != nil {
+		return Entry{}, err
+	}
+	if _, s, err = token(s, "user"); err != nil {
+		return Entry{}, err
+	}
+
+	var raw string
+	if raw, s, err = bracketed(s, "time"); err != nil {
+		return Entry{}, err
+	}
+	if e.Time, err = time.Parse(timeLayout, raw); err != nil {
+		return Entry{}, malformed("time %q is not in nginx format", raw)
+	}
+
+	var req string
+	if req, s, err = quoted(s, "request"); err != nil {
+		return Entry{}, err
+	}
+	parts := strings.Fields(req)
+	if len(parts) != 3 {
+		return Entry{}, malformed("request %q is not METHOD URI PROTOCOL", req)
+	}
+	path, _, _ := strings.Cut(parts[1], "?")
+	if path == "" {
+		return Entry{}, malformed("request %q has an empty path", req)
+	}
+	e.Method = parts[0]
+	e.Path = path
+
+	var tok string
+	if tok, s, err = token(s, "status"); err != nil {
+		return Entry{}, err
+	}
+	e.Status, err = strconv.Atoi(tok)
+	if err != nil || e.Status < 100 || e.Status > 599 {
+		return Entry{}, malformed("status %q is not an HTTP status code", tok)
+	}
+
+	if tok, s, err = token(s, "bytes"); err != nil {
+		return Entry{}, err
+	}
+	if tok != "-" {
+		e.Bytes, err = strconv.ParseInt(tok, 10, 64)
+		if err != nil || e.Bytes < 0 {
+			return Entry{}, malformed("bytes %q is not a size", tok)
+		}
+	}
+
+	// The referer and user agent are checked for quoting only.
+	if _, s, err = quoted(s, "referer"); err != nil {
+		return Entry{}, err
+	}
+	if _, s, err = quoted(s, "user agent"); err != nil {
+		return Entry{}, err
+	}
+
+	if tok, s, err = token(s, "request time"); err != nil {
+		return Entry{}, err
+	}
+	seconds, err := strconv.ParseFloat(tok, 64)
+	if err != nil || math.IsNaN(seconds) || seconds < 0 || seconds > float64(maxRequestSeconds) {
+		return Entry{}, malformed("request time %q is not a number of seconds", tok)
+	}
+	e.RequestTime = time.Duration(math.Round(seconds * float64(time.Second)))
+
+	if s != "" {
+		return Entry{}, malformed("unexpected text %q after the request time", s)
+	}
+	return e, nil
+}
+
+// Scan reads lines from r and calls visit with each valid entry, in order. It
+// skips blank lines and lines that are malformed or longer than MaxLineBytes,
+// and returns how many lines it skipped for being malformed. Only a read error
+// or a cancelled ctx stops the scan.
+func Scan(ctx context.Context, r io.Reader, visit func(Entry)) (int, error) {
+	br := bufio.NewReader(r)
+	skipped := 0
+	for {
+		if err := ctx.Err(); err != nil {
+			return skipped, err
+		}
+		line, tooLong, err := readLine(br)
+		if errors.Is(err, io.EOF) {
+			return skipped, nil
+		}
+		if err != nil {
+			return skipped, err
+		}
+		if tooLong {
+			skipped++
+			continue
+		}
+		if strings.TrimSpace(line) == "" {
+			continue
+		}
+		e, err := ParseLine(line)
+		if err != nil {
+			skipped++
+			continue
+		}
+		visit(e)
+	}
+}
+
+// readLine returns the next line without its line ending. If the line is longer
+// than MaxLineBytes, it returns tooLong and no text. It returns io.EOF when the
+// input is done.
+func readLine(br *bufio.Reader) (line string, tooLong bool, err error) {
+	var buf []byte
+	for {
+		chunk, isPrefix, err := br.ReadLine()
+		if err != nil {
+			// A final line with no newline can end with an error after
+			// some of its bytes were read. Return it, then report EOF.
+			if len(buf) > 0 || tooLong {
+				return string(buf), tooLong, nil
+			}
+			return "", false, err
+		}
+		if !tooLong {
+			if len(buf)+len(chunk) > MaxLineBytes {
+				tooLong = true
+				buf = nil
+			} else {
+				buf = append(buf, chunk...)
+			}
+		}
+		if !isPrefix {
+			return string(buf), tooLong, nil
+		}
+	}
+}
+
+// token splits off the next space-separated field of s.
+func token(s, what string) (tok, rest string, err error) {
+	s = strings.TrimLeft(s, " ")
+	if s == "" {
+		return "", "", malformed("missing %s", what)
+	}
+	tok, rest, _ = strings.Cut(s, " ")
+	return tok, rest, nil
+}
+
+// quoted splits off a double-quoted field of s. A backslash escapes the byte
+// after it, as nginx does for quotes inside the field.
+func quoted(s, what string) (val, rest string, err error) {
+	s = strings.TrimLeft(s, " ")
+	if !strings.HasPrefix(s, `"`) {
+		return "", "", malformed("%s is not quoted", what)
+	}
+	for i := 1; i < len(s); i++ {
+		switch s[i] {
+		case '\\':
+			i++
+		case '"':
+			rest = s[i+1:]
+			if rest != "" && rest[0] != ' ' {
+				return "", "", malformed("%s has text right after its closing quote", what)
+			}
+			return s[1:i], rest, nil
+		}
+	}
+	return "", "", malformed("%s has no closing quote", what)
+}
+
+// bracketed splits off a field of s that is wrapped in square brackets.
+func bracketed(s, what string) (val, rest string, err error) {
+	s = strings.TrimLeft(s, " ")
+	if !strings.HasPrefix(s, "[") {
+		return "", "", malformed("%s is not in square brackets", what)
+	}
+	val, rest, ok := strings.Cut(s[1:], "]")
+	if !ok {
+		return "", "", malformed("%s has no closing bracket", what)
+	}
+	if rest != "" && rest[0] != ' ' {
+		return "", "", malformed("%s has text right after its closing bracket", what)
+	}
+	return val, rest, nil
+}
+
+// malformed returns an error that wraps ErrMalformed and describes the problem.
+func malformed(format string, args ...any) error {
+	return fmt.Errorf("%w: %s", ErrMalformed, fmt.Sprintf(format, args...))
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..8a33848
