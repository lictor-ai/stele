+func TestReportTopPaths(t *testing.T) {
+	tests := []struct {
+		name string
+		top  int
+		want []PathCount
+	}{
+		{
+			name: "top 2 of 3 paths",
+			top:  2,
+			want: []PathCount{{"/a", 3}, {"/b", 2}},
+		},
+		{
+			name: "top larger than the number of paths",
+			top:  10,
+			want: []PathCount{{"/a", 3}, {"/b", 2}, {"/c", 1}},
+		},
+		{
+			name: "top 1 keeps the most requested",
+			top:  1,
+			want: []PathCount{{"/a", 3}},
+		},
+		{
+			name: "top 0 lists none",
+			top:  0,
+			want: []PathCount{},
+		},
+		{
+			name: "negative top lists none",
+			top:  -4,
+			want: []PathCount{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			for _, p := range []string{"/c", "/a", "/b", "/a", "/a", "/b"} {
+				c.Add(entry(p, 200, 1))
+			}
+			r, err := c.Report(tt.top)
+			if err != nil {
+				t.Fatalf("Report(%d) error = %v, want nil", tt.top, err)
+			}
+			if len(r.TopPaths) != len(tt.want) {
+				t.Fatalf("Report(%d).TopPaths = %v, want %v", tt.top, r.TopPaths, tt.want)
+			}
+			for i := range tt.want {
+				if r.TopPaths[i] != tt.want[i] {
+					t.Errorf("Report(%d).TopPaths[%d] = %+v, want %+v", tt.top, i, r.TopPaths[i], tt.want[i])
+				}
+			}
+		})
+	}
+}
