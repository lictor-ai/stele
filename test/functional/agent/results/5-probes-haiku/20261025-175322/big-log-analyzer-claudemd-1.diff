+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,261 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"slices"
+	"strings"
+	"testing"
+	"testing/iotest"
+	"time"
+)
+
+const validLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParseLine(t *testing.T) {
+	at := time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC)
+	tests := []struct {
+		name string
+		line string
+		want Entry
+	}{
+		{
+			name: "spec example",
+			line: validLine,
+			want: Entry{Time: at, Method: "GET", Path: "/api/items", Status: 200, Bytes: 512, RequestTime: 42 * time.Millisecond},
+		},
+		{
+			name: "path without query",
+			line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "POST /login HTTP/1.1" 302 0 "-" "-" 1.5`,
+			want: Entry{Time: at, Method: "POST", Path: "/login", Status: 302, Bytes: 0, RequestTime: 1500 * time.Millisecond},
+		},
+		{
+			name: "empty query after question mark",
+			line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /a? HTTP/1.1" 200 1 "-" "-" 0`,
+			want: Entry{Time: at, Method: "GET", Path: "/a", Status: 200, Bytes: 1, RequestTime: 0},
+		},
+		{
+			name: "dash for bytes",
+			line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 304 - "-" "-" 0.001`,
+			want: Entry{Time: at, Method: "GET", Path: "/", Status: 304, Bytes: 0, RequestTime: time.Millisecond},
+		},
+		{
+			name: "escaped quote in user agent",
+			line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "a \"quoted\" agent" 0.010`,
+			want: Entry{Time: at, Method: "GET", Path: "/", Status: 200, Bytes: 1, RequestTime: 10 * time.Millisecond},
+		},
+		{
+			name: "empty quoted fields",
+			line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "" "" 0.010`,
+			want: Entry{Time: at, Method: "GET", Path: "/", Status: 200, Bytes: 1, RequestTime: 10 * time.Millisecond},
+		},
+		{
+			name: "time zone offset is kept in the instant",
+			line: `203.0.113.9 - - [10/Oct/2026:15:55:36 +0200] "GET / HTTP/1.1" 200 1 "-" "-" 0`,
+			want: Entry{Time: at, Method: "GET", Path: "/", Status: 200, Bytes: 1, RequestTime: 0},
+		},
+		{
+			name: "leading and trailing spaces",
+			line: "  " + validLine + "  ",
+			want: Entry{Time: at, Method: "GET", Path: "/api/items", Status: 200, Bytes: 512, RequestTime: 42 * time.Millisecond},
+		},
+		{
+			name: "sub-millisecond request time rounds to nanoseconds",
+			line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "-" 0.0000015`,
+			want: Entry{Time: at, Method: "GET", Path: "/", Status: 200, Bytes: 1, RequestTime: 1500 * time.Nanosecond},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := ParseLine(tt.line)
+			if err != nil {
+				t.Fatalf("ParseLine(%q) error = %v, want nil", tt.line, err)
+			}
+			checkEntry(t, tt.line, got, tt.want)
+		})
+	}
+}
+
+// checkEntry reports each field of got that differs from want.
+func checkEntry(t *testing.T, line string, got, want Entry) {
+	t.Helper()
+	if !got.Time.Equal(want.Time) {
+		t.Errorf("ParseLine(%q).Time = %v, want %v", line, got.Time, want.Time)
+	}
+	if got.Method != want.Method {
+		t.Errorf("ParseLine(%q).Method = %q, want %q", line, got.Method, want.Method)
+	}
+	if got.Path != want.Path {
+		t.Errorf("ParseLine(%q).Path = %q, want %q", line, got.Path, want.Path)
+	}
+	if got.Status != want.Status {
+		t.Errorf("ParseLine(%q).Status = %d, want %d", line, got.Status, want.Status)
+	}
+	if got.Bytes != want.Bytes {
+		t.Errorf("ParseLine(%q).Bytes = %d, want %d", line, got.Bytes, want.Bytes)
+	}
+	if got.RequestTime != want.RequestTime {
+		t.Errorf("ParseLine(%q).RequestTime = %v, want %v", line, got.RequestTime, want.RequestTime)
+	}
+}
+
+func TestParseLineMalformed(t *testing.T) {
+	const pre = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] `
+	tests := []struct {
+		name string
+		line string
+	}{
+		{"empty line", ""},
+		{"only spaces", "   "},
+		{"one field", "203.0.113.9"},
+		{"missing user", "203.0.113.9 -"},
+		{"time not bracketed", `203.0.113.9 - - 10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 1 "-" "-" 0`},
+		{"time with no closing bracket", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 1 "-" "-" 0`},
+		{"text right after time bracket", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000]x "GET / HTTP/1.1" 200 1 "-" "-" 0`},
+		{"bad time", `203.0.113.9 - - [2026-10-10 13:55:36] "GET / HTTP/1.1" 200 1 "-" "-" 0`},
+		{"request not quoted", pre + `GET / HTTP/1.1 200 1 "-" "-" 0`},
+		{"request has no closing quote", pre + `"GET / HTTP/1.1 200 1 "-" "-" 0`},
+		{"text right after closing quote", pre + `"GET / HTTP/1.1"x 200 1 "-" "-" 0`},
+		{"request has two parts", pre + `"GET /" 200 1 "-" "-" 0`},
+		{"request is empty", pre + `"" 200 1 "-" "-" 0`},
+		{"request has empty path", pre + `"GET ? HTTP/1.1" 200 1 "-" "-" 0`},
+		{"status is not a number", pre + `"GET / HTTP/1.1" abc 1 "-" "-" 0`},
+		{"status below 100", pre + `"GET / HTTP/1.1" 99 1 "-" "-" 0`},
+		{"status above 599", pre + `"GET / HTTP/1.1" 600 1 "-" "-" 0`},
+		{"status missing", pre + `"GET / HTTP/1.1"`},
+		{"bytes is not a number", pre + `"GET / HTTP/1.1" 200 big "-" "-" 0`},
+		{"bytes is negative", pre + `"GET / HTTP/1.1" 200 -5 "-" "-" 0`},
+		{"referer not quoted", pre + `"GET / HTTP/1.1" 200 1 - "-" 0`},
+		{"user agent missing", pre + `"GET / HTTP/1.1" 200 1 "-"`},
+		{"request time missing (old format)", pre + `"GET / HTTP/1.1" 200 1 "-" "-"`},
+		{"request time is not a number", pre + `"GET / HTTP/1.1" 200 1 "-" "-" fast`},
+		{"request time is NaN", pre + `"GET / HTTP/1.1" 200 1 "-" "-" NaN`},
+		{"request time is infinite", pre + `"GET / HTTP/1.1" 200 1 "-" "-" +Inf`},
+		{"request time is negative", pre + `"GET / HTTP/1.1" 200 1 "-" "-" -0.5`},
+		{"request time too large for a duration", pre + `"GET / HTTP/1.1" 200 1 "-" "-" 1e12`},
+		{"extra field after request time", validLine + " extra"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := ParseLine(tt.line)
+			if !errors.Is(err, ErrMalformed) {
+				t.Errorf("ParseLine(%q) error = %v, want an error wrapping ErrMalformed", tt.line, err)
+			}
+		})
+	}
+}
+
+func TestScan(t *testing.T) {
+	long := strings.Repeat("x", MaxLineBytes+1)
+	tests := []struct {
+		name      string
+		input     string
+		wantPaths []string
+		wantSkip  int
+	}{
+		{
+			name:      "empty input",
+			input:     "",
+			wantPaths: nil,
+			wantSkip:  0,
+		},
+		{
+			name:      "only blank lines",
+			input:     "\n\n   \n",
+			wantPaths: nil,
+			wantSkip:  0,
+		},
+		{
+			name:      "single request with no trailing newline",
+			input:     validLine,
+			wantPaths: []string{"/api/items"},
+			wantSkip:  0,
+		},
+		{
+			name:      "single request with trailing newline",
+			input:     validLine + "\n",
+			wantPaths: []string{"/api/items"},
+			wantSkip:  0,
+		},
+		{
+			name:      "CRLF line endings",
+			input:     validLine + "\r\n" + validLine + "\r\n",
+			wantPaths: []string{"/api/items", "/api/items"},
+			wantSkip:  0,
+		},
+		{
+			name:      "malformed lines are skipped and counted",
+			input:     "garbage\n" + validLine + "\n\nmore garbage\n",
+			wantPaths: []string{"/api/items"},
+			wantSkip:  2,
+		},
+		{
+			name:      "line over the limit is skipped and counted",
+			input:     long + "\n" + validLine + "\n",
+			wantPaths: []string{"/api/items"},
+			wantSkip:  1,
+		},
+		{
+			name:      "over-long final line with no newline is counted",
+			input:     validLine + "\n" + long,
+			wantPaths: []string{"/api/items"},
+			wantSkip:  1,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var paths []string
+			skipped, err := Scan(t.Context(), strings.NewReader(tt.input), func(e Entry) {
+				paths = append(paths, e.Path)
+			})
+			if err != nil {
+				t.Fatalf("Scan() error = %v, want nil", err)
+			}
+			if !slices.Equal(paths, tt.wantPaths) {
+				t.Errorf("Scan() paths = %q, want %q", paths, tt.wantPaths)
+			}
+			if skipped != tt.wantSkip {
+				t.Errorf("Scan() skipped = %d, want %d", skipped, tt.wantSkip)
+			}
+		})
+	}
+}
+
+func TestScanErrors(t *testing.T) {
+	errBoom := errors.New("boom")
+	cancelled, cancel := context.WithCancel(t.Context())
+	cancel()
+
+	tests := []struct {
+		name    string
+		ctx     context.Context
+		reader  func() *strings.Reader
+		wantErr error
+	}{
+		{
+			name:    "cancelled context",
+			ctx:     cancelled,
+			reader:  func() *strings.Reader { return strings.NewReader(validLine + "\n") },
+			wantErr: context.Canceled,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			visited := 0
+			skipped, err := Scan(tt.ctx, tt.reader(), func(Entry) { visited++ })
+			if !errors.Is(err, tt.wantErr) {
+				t.Errorf("Scan() error = %v, want %v", err, tt.wantErr)
+			}
+			if visited != 0 || skipped != 0 {
+				t.Errorf("Scan() visited %d and skipped %d lines, want 0 and 0", visited, skipped)
+			}
+		})
+	}
+
+	t.Run("read error is returned", func(t *testing.T) {
+		_, err := Scan(t.Context(), iotest.ErrReader(errBoom), func(Entry) {})
+		if !errors.Is(err, errBoom) {
+			t.Errorf("Scan() error = %v, want %v", err, errBoom)
+		}
+	})
+}
