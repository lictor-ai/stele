+func TestReportFiveXXByHour(t *testing.T) {
+	at := func(h, m int) time.Time {
+		return time.Date(2026, 10, 10, h, m, 0, 0, time.UTC)
+	}
+	// 14:05 at +02:00 is 12:05 UTC, so it counts toward the 12:00 hour.
+	plus2 := time.FixedZone("plus2", 2*60*60)
+
+	tests := []struct {
+		name string
+		errs []time.Time
+		want []HourCount
+	}{
+		{
+			name: "no 5xx responses",
+			errs: nil,
+			want: []HourCount{},
+		},
+		{
+			name: "several in one hour",
+			errs: []time.Time{at(13, 1), at(13, 59), at(13, 30)},
+			want: []HourCount{{at(13, 0), 3}},
+		},
+		{
+			name: "hours listed oldest first, empty hours skipped",
+			errs: []time.Time{at(15, 0), at(9, 0), at(15, 45)},
+			want: []HourCount{{at(9, 0), 1}, {at(15, 0), 2}},
+		},
+		{
+			name: "non-UTC time counts toward its UTC hour",
+			errs: []time.Time{time.Date(2026, 10, 10, 14, 5, 0, 0, plus2)},
+			want: []HourCount{{at(12, 0), 1}},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewCollector()
+			c.Add(entry("/ok", 200, 1))
+			for _, ts := range tt.errs {
+				e := entry("/boom", 500, 1)
+				e.Time = ts
+				c.Add(e)
+			}
+			r, err := c.Report(1)
+			if err != nil {
+				t.Fatalf("Report(1) error = %v, want nil", err)
+			}
+			if len(r.Errors5xxByHour) != len(tt.want) {
+				t.Fatalf("Report(1).Errors5xxByHour = %+v, want %+v", r.Errors5xxByHour, tt.want)
+			}
+			for i := range tt.want {
+				got := r.Errors5xxByHour[i]
+				if !got.Hour.Equal(tt.want[i].Hour) || got.Count != tt.want[i].Count {
+					t.Errorf("Report(1).Errors5xxByHour[%d] = {%v %d}, want {%v %d}",
+						i, got.Hour, got.Count, tt.want[i].Hour, tt.want[i].Count)
+				}
+			}
+		})
+	}
+}
