+package stats
+
+import "errors"
+
+// ErrNoSamples means a percentile was asked for in an empty set.
+var ErrNoSamples = errors.New("no samples")
+
+// ErrPercentile means a percentile was outside 1 to 100.
+var ErrPercentile = errors.New("percentile out of range")
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..aefeb62
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,187 @@
+// Package stats summarizes parsed requests into a report.
+package stats
+
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// Report is the summary of a set of requests. Its JSON field names are the
+// wire format of the -json output.
+type Report struct {
+	Requests        int           `json:"requests"`
+	Malformed       int           `json:"malformed"`
+	TopPaths        []PathCount   `json:"top_paths"`
+	StatusClasses   StatusClasses `json:"status_classes"`
+	LatencyMS       Latency       `json:"latency_ms"`
+	Errors5xxByHour []HourCount   `json:"errors_5xx_by_hour"`
+}
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// StatusClasses counts requests by the first digit of their status code.
+// Other holds the 1xx codes and any code outside the four classes.
+type StatusClasses struct {
+	Class2xx int `json:"2xx"`
+	Class3xx int `json:"3xx"`
+	Class4xx int `json:"4xx"`
+	Class5xx int `json:"5xx"`
+	Other    int `json:"other"`
+}
+
+// Latency holds request time percentiles in milliseconds. All fields are 0
+// when there are no requests.
+type Latency struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// HourCount is the number of 5xx responses in one hour.
+type HourCount struct {
+	Hour  time.Time `json:"hour"`
+	Count int       `json:"count"`
+}
+
+// Collector gathers requests and builds a Report from them. It is not safe for
+// concurrent use.
+type Collector struct {
+	requests  int
+	malformed int
+	paths     map[string]int // request count by path
+	classes   StatusClasses  // request count by status class
+	latencies []float64      // request times in milliseconds, unsorted
+	errors5xx map[int64]int  // 5xx count by the Unix time of the UTC hour start
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{
+		paths:     map[string]int{},
+		errors5xx: map[int64]int{},
+	}
+}
+
+// Add records one request.
+func (c *Collector) Add(e logparse.Entry) {
+	c.requests++
+	c.paths[e.Path]++
+	c.classes.add(e.Status)
+	c.latencies = append(c.latencies, float64(e.RequestTime)/float64(time.Millisecond))
+	if e.Status/100 == 5 {
+		hour := e.Time.UTC().Truncate(time.Hour).Unix()
+		c.errors5xx[hour]++
+	}
+}
+
+// AddMalformed adds n skipped lines to the malformed count.
+func (c *Collector) AddMalformed(n int) {
+	c.malformed += n
+}
+
+// Report summarizes the requests added so far. It lists at most top paths,
+// most requested first. Paths with the same count are listed by name. A top
+// below 1 lists none.
+func (c *Collector) Report(top int) (Report, error) {
+	r := Report{
+		Requests:        c.requests,
+		Malformed:       c.malformed,
+		TopPaths:        topPaths(c.paths, top),
+		StatusClasses:   c.classes,
+		Errors5xxByHour: hourCounts(c.errors5xx),
+	}
+	if len(c.latencies) == 0 {
+		return r, nil
+	}
+
+	sorted := slices.Clone(c.latencies)
+	slices.Sort(sorted)
+	targets := []struct {
+		p   int
+		dst *float64
+	}{
+		{50, &r.LatencyMS.P50},
+		{95, &r.LatencyMS.P95},
+		{99, &r.LatencyMS.P99},
+	}
+	for _, t := range targets {
+		v, err := Percentile(sorted, t.p)
+		if err != nil {
+			return Report{}, fmt.Errorf("latency p%d: %w", t.p, err)
+		}
+		*t.dst = v
+	}
+	return r, nil
+}
+
+// add counts one status code in its class.
+func (s *StatusClasses) add(status int) {
+	switch status / 100 {
+	case 2:
+		s.Class2xx++
+	case 3:
+		s.Class3xx++
+	case 4:
+		s.Class4xx++
+	case 5:
+		s.Class5xx++
+	default:
+		s.Other++
+	}
+}
+
+// Percentile returns the p-th percentile of sorted, using the nearest-rank
+// method: the smallest value with at least p percent of the samples at or below
+// it. sorted must be in ascending order. p must be from 1 to 100.
+func Percentile(sorted []float64, p int) (float64, error) {
+	if len(sorted) == 0 {
+		return 0, ErrNoSamples
+	}
+	if p < 1 || p > 100 {
+		return 0, fmt.Errorf("percentile %d: %w", p, ErrPercentile)
+	}
+	rank := (p*len(sorted) + 99) / 100 // ceil(p/100 * n), in integers
+	return sorted[rank-1], nil
+}
+
+// topPaths returns the n most requested paths. It always returns a non-nil
+// slice.
+func topPaths(paths map[string]int, n int) []PathCount {
+	out := make([]PathCount, 0, len(paths))
+	for path, count := range paths {
+		out = append(out, PathCount{Path: path, Count: count})
+	}
+	slices.SortFunc(out, func(a, b PathCount) int {
+		if a.Count != b.Count {
+			return b.Count - a.Count
+		}
+		return strings.Compare(a.Path, b.Path)
+	})
+	if n < 0 {
+		n = 0
+	}
+	if len(out) > n {
+		out = out[:n]
+	}
+	return out
+}
+
+// hourCounts returns the hours with at least one 5xx, oldest first. It always
+// returns a non-nil slice.
+func hourCounts(counts map[int64]int) []HourCount {
+	hours := slices.Sorted(maps.Keys(counts))
+	out := make([]HourCount, 0, len(hours))
+	for _, h := range hours {
+		out = append(out, HourCount{Hour: time.Unix(h, 0).UTC(), Count: counts[h]})
+	}
+	return out
+}
