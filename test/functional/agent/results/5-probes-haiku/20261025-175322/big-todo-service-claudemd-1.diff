+// Package todo holds the to-do model and an in-memory store for it.
+package todo
+
+import (
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const (
+	// MaxTitleLen is the longest allowed title, in characters after trimming.
+	MaxTitleLen = 200
+
+	// DefaultLimit is the page size used when a caller gives none.
+	DefaultLimit = 20
+
+	// MaxLimit is the largest page size a caller may ask for.
+	MaxLimit = 100
+)
+
+// Todo is one to-do item.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Patch changes the fields of a to-do. A nil field is left unchanged.
+type Patch struct {
+	Title *string
+	Done  *bool
+}
+
+// Filter selects and pages the results of List. A nil Done matches every
+// item. Limit must be between 1 and MaxLimit, and Offset must not be negative.
+type Filter struct {
+	Done   *bool
+	Limit  int
+	Offset int
+}
+
+// normalizeTitle trims spaces from s and checks that the result has 1 to
+// MaxTitleLen characters.
+func normalizeTitle(s string) (string, error) {
+	t := strings.TrimSpace(s)
+	if n := utf8.RuneCountInString(t); n < 1 || n > MaxTitleLen {
+		return "", ErrInvalidTitle
+	}
+	return t, nil
+}
