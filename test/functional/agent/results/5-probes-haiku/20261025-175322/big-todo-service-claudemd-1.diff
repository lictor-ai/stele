@@ -0,0 +1,28 @@
+package main
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestRunArgumentErrors(t *testing.T) {
+	// Every case here fails before a socket is opened, so no port is taken.
+	cases := []struct {
+		name    string
+		args    []string
+		wantErr bool
+	}{
+		{name: "help exits cleanly", args: []string{"-h"}, wantErr: false},
+		{name: "unknown flag", args: []string{"-nope"}, wantErr: true},
+		{name: "bad address", args: []string{"-addr", "not an address"}, wantErr: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			err := run(tc.args, &stdout, &stderr)
+			if (err != nil) != tc.wantErr {
+				t.Errorf("run(%q) error = %v, want error: %v", tc.args, err, tc.wantErr)
+			}
+		})
+	}
+}
diff --git a/internal/api/handler.go b/internal/api/handler.go
new file mode 100644
index 0000000..60ae5cd
--- /dev/null
+++ b/internal/api/handler.go
@@ -0,0 +1,221 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// maxBodyBytes is the largest request body an endpoint reads.
+const maxBodyBytes = 1 << 20
+
+// badRequest is a client error. Its text is a fixed message that is safe to
+// send back to the client.
+type badRequest string
+
+func (e badRequest) Error() string { return string(e) }
+
+// createRequest is the body of POST /todos.
+type createRequest struct {
+	Title string `json:"title"`
+}
+
+// patchRequest is the body of PATCH /todos/{id}. A nil field is left unchanged.
+type patchRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+// Handler serves the to-do API.
+type Handler struct {
+	store *todo.Store
+	mux   *http.ServeMux
+}
+
+// NewHandler returns a Handler that reads and writes to-dos in store.
+func NewHandler(store *todo.Store) *Handler {
+	h := &Handler{store: store, mux: http.NewServeMux()}
+	h.mux.HandleFunc("POST /todos", h.createTodo)
+	h.mux.HandleFunc("GET /todos", h.listTodos)
+	h.mux.HandleFunc("GET /todos/{id}", h.getTodo)
+	h.mux.HandleFunc("PATCH /todos/{id}", h.updateTodo)
+	h.mux.HandleFunc("DELETE /todos/{id}", h.deleteTodo)
+	// A known path with a method it does not allow gets a JSON 405 with an
+	// Allow header. Any other path gets a JSON 404.
+	h.mux.HandleFunc("/todos", methodNotAllowed("GET, POST"))
+	h.mux.HandleFunc("/todos/{id}", methodNotAllowed("GET, PATCH, DELETE"))
+	h.mux.HandleFunc("/", notFound)
+	return h
+}
+
+// ServeHTTP routes r to the matching endpoint.
+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	h.mux.ServeHTTP(w, r)
+}
+
+// createTodo handles POST /todos.
+func (h *Handler) createTodo(w http.ResponseWriter, r *http.Request) {
+	var in createRequest
+	if err := decodeBody(w, r, &in); err != nil {
+		fail(w, err)
+		return
+	}
+	t, err := h.store.Create(r.Context(), in.Title)
+	if err != nil {
+		fail(w, err)
+		return
+	}
+	w.Header().Set("Location", "/todos/"+t.ID)
+	JSON(w, http.StatusCreated, t)
+}
+
+// listTodos handles GET /todos.
+func (h *Handler) listTodos(w http.ResponseWriter, r *http.Request) {
+	f, err := parseListQuery(r.URL.Query())
+	if err != nil {
+		fail(w, err)
+		return
+	}
+	todos, err := h.store.List(r.Context(), f)
+	if err != nil {
+		fail(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, todos)
+}
+
+// getTodo handles GET /todos/{id}.
+func (h *Handler) getTodo(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.Context(), r.PathValue("id"))
+	if err != nil {
+		fail(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+// updateTodo handles PATCH /todos/{id}.
+func (h *Handler) updateTodo(w http.ResponseWriter, r *http.Request) {
+	var in patchRequest
+	if err := decodeBody(w, r, &in); err != nil {
+		fail(w, err)
+		return
+	}
+	t, err := h.store.Update(r.Context(), r.PathValue("id"), todo.Patch{Title: in.Title, Done: in.Done})
+	if err != nil {
+		fail(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+// deleteTodo handles DELETE /todos/{id}.
+func (h *Handler) deleteTodo(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.Context(), r.PathValue("id")); err != nil {
+		fail(w, err)
+		return
+	}
+	NoContent(w)
+}
+
+// parseListQuery reads done, limit and offset from the query string. An
+// absent limit means todo.DefaultLimit.
+func parseListQuery(q url.Values) (todo.Filter, error) {
+	f := todo.Filter{Limit: todo.DefaultLimit}
+	if q.Has("done") {
+		switch q.Get("done") {
+		case "true":
+			v := true
+			f.Done = &v
+		case "false":
+			v := false
+			f.Done = &v
+		default:
+			return f, badRequest("done must be true or false")
+		}
+	}
+	if q.Has("limit") {
+		n, err := strconv.Atoi(q.Get("limit"))
+		if err != nil || n < 1 || n > todo.MaxLimit {
+			return f, badRequest("limit must be an integer from 1 to 100")
+		}
+		f.Limit = n
+	}
+	if q.Has("offset") {
+		n, err := strconv.Atoi(q.Get("offset"))
+		if err != nil || n < 0 {
+			return f, badRequest("offset must be an integer of 0 or more")
+		}
+		f.Offset = n
+	}
+	return f, nil
+}
+
+// decodeBody reads a single JSON object from the request body into dst. It
+// rejects unknown fields, trailing data and bodies over maxBodyBytes.
+func decodeBody(w http.ResponseWriter, r *http.Request, dst any) error {
+	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, maxBodyBytes))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(dst); err != nil {
+		return bodyError(err)
+	}
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		return bodyError(err)
+	}
+	return nil
+}
+
+// bodyError keeps the size-limit error, which maps to 413, and turns every
+// other body problem into a fixed 400 message. The decoder's own text is not
+// sent to the client.
+func bodyError(err error) error {
+	var mbe *http.MaxBytesError
+	if errors.As(err, &mbe) {
+		return err
+	}
+	return badRequest("body must be one JSON object with only known fields")
+}
+
+// fail writes the error response for err. Client errors get their own
+// message. Unexpected errors are logged and get a generic 500.
+func fail(w http.ResponseWriter, err error) {
+	var br badRequest
+	var mbe *http.MaxBytesError
+	switch {
+	case errors.As(err, &br):
+		Error(w, http.StatusBadRequest, string(br))
+	case errors.As(err, &mbe):
+		Error(w, http.StatusRequestEntityTooLarge, "request body must be 1 MiB or less")
+	case errors.Is(err, todo.ErrNotFound):
+		Error(w, http.StatusNotFound, "todo not found")
+	case errors.Is(err, todo.ErrInvalidTitle):
+		Error(w, http.StatusBadRequest, "title must be 1 to 200 characters after trimming spaces")
+	case errors.Is(err, todo.ErrEmptyPatch):
+		Error(w, http.StatusBadRequest, "body must set title, done or both")
+	case errors.Is(err, todo.ErrInvalidPage):
+		Error(w, http.StatusBadRequest, "limit must be 1 to 100 and offset 0 or more")
+	default:
+		log.Error("handle request", "err", err)
+		Error(w, http.StatusInternalServerError, "internal error, try again later")
+	}
+}
+
+// methodNotAllowed returns a handler that answers 405 and names the allowed
+// methods in the Allow header.
+func methodNotAllowed(allow string) http.HandlerFunc {
+	return func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Allow", allow)
+		Error(w, http.StatusMethodNotAllowed, "method not allowed")
+	}
+}
+
+// notFound answers 404 for paths that match no route.
+func notFound(w http.ResponseWriter, _ *http.Request) {
+	Error(w, http.StatusNotFound, "no such route")
+}
diff --git a/internal/api/handler_test.go b/internal/api/handler_test.go
new file mode 100644
index 0000000..1dd0fbf
--- /dev/null
+++ b/internal/api/handler_test.go
@@ -0,0 +1,351 @@
+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+var fixedNow = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+// newTestHandler returns a handler over an empty store with a fixed clock.
+func newTestHandler() *Handler {
+	return NewHandler(todo.NewStore(clock.Fixed{T: fixedNow}))
+}
+
+// do sends one request through h and returns the recorded response.
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(method, target, strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json")
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+// checkJSONError fails the test unless rec has the status, a JSON content
+// type and a non-empty error envelope.
+func checkJSONError(t *testing.T, rec *httptest.ResponseRecorder, want int) {
+	t.Helper()
+	if rec.Code != want {
+		t.Fatalf("status = %d, want %d; body %q", rec.Code, want, rec.Body.String())
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Errorf("Content-Type = %q, want %q", ct, "application/json")
+	}
+	var env map[string]string
+	if err := json.Unmarshal(rec.Body.Bytes(), &env); err != nil || env["error"] == "" {
+		t.Errorf("body = %q, want a JSON envelope with a non-empty error", rec.Body.String())
+	}
+}
+
+// createOne posts one to-do and returns it. It fails the test on any error.
+func createOne(t *testing.T, h http.Handler, title string) todo.Todo {
+	t.Helper()
+	rec := do(h, http.MethodPost, "/todos", fmt.Sprintf(`{"title":%q}`, title))
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("POST /todos %q status = %d, want %d; body %q", title, rec.Code, http.StatusCreated, rec.Body.String())
+	}
+	var item todo.Todo
+	if err := json.Unmarshal(rec.Body.Bytes(), &item); err != nil {
+		t.Fatalf("POST /todos %q body %q is not a to-do: %v", title, rec.Body.String(), err)
+	}
+	return item
+}
+
+// decodeTodo reads one to-do from the response body.
+func decodeTodo(t *testing.T, rec *httptest.ResponseRecorder) todo.Todo {
+	t.Helper()
+	var item todo.Todo
+	if err := json.Unmarshal(rec.Body.Bytes(), &item); err != nil {
+		t.Fatalf("body %q is not a to-do: %v", rec.Body.String(), err)
+	}
+	return item
+}
+
+// titlesOf returns the titles of items in order.
+func titlesOf(items []todo.Todo) []string {
+	out := make([]string, 0, len(items))
+	for _, item := range items {
+		out = append(out, item.Title)
+	}
+	return out
+}
+
+// newestFirst returns the titles "t<hi>" down to "t<lo>".
+func newestFirst(hi, lo int) []string {
+	var out []string
+	for i := hi; i >= lo; i-- {
+		out = append(out, fmt.Sprintf("t%d", i))
+	}
+	return out
+}
+
+func TestCreateTodo(t *testing.T) {
+	cases := []struct {
+		name      string
+		body      string
+		wantCode  int
+		wantTitle string
+	}{
+		{name: "valid", body: `{"title":"buy milk"}`, wantCode: http.StatusCreated, wantTitle: "buy milk"},
+		{name: "title trimmed", body: `{"title":"  buy milk  "}`, wantCode: http.StatusCreated, wantTitle: "buy milk"},
+		{name: "200 characters", body: `{"title":"` + strings.Repeat("a", 200) + `"}`, wantCode: http.StatusCreated, wantTitle: strings.Repeat("a", 200)},
+		{name: "201 characters", body: `{"title":"` + strings.Repeat("a", 201) + `"}`, wantCode: http.StatusBadRequest},
+		{name: "missing title", body: `{}`, wantCode: http.StatusBadRequest},
+		{name: "empty title", body: `{"title":""}`, wantCode: http.StatusBadRequest},
+		{name: "blank title", body: `{"title":"   "}`, wantCode: http.StatusBadRequest},
+		{name: "null title", body: `{"title":null}`, wantCode: http.StatusBadRequest},
+		{name: "title not a string", body: `{"title":5}`, wantCode: http.StatusBadRequest},
+		{name: "unknown field", body: `{"title":"a","color":"red"}`, wantCode: http.StatusBadRequest},
+		{name: "malformed json", body: `{"title":`, wantCode: http.StatusBadRequest},
+		{name: "two objects", body: `{"title":"a"}{"title":"b"}`, wantCode: http.StatusBadRequest},
+		{name: "empty body", body: ``, wantCode: http.StatusBadRequest},
+		{name: "json array", body: `["a"]`, wantCode: http.StatusBadRequest},
+		{name: "body over 1 MiB", body: `{"title":"` + strings.Repeat("a", maxBodyBytes) + `"}`, wantCode: http.StatusRequestEntityTooLarge},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := newTestHandler()
+			rec := do(h, http.MethodPost, "/todos", tc.body)
+			if tc.wantCode != http.StatusCreated {
+				checkJSONError(t, rec, tc.wantCode)
+				return
+			}
+			if rec.Code != tc.wantCode {
+				t.Fatalf("POST /todos status = %d, want %d; body %q", rec.Code, tc.wantCode, rec.Body.String())
+			}
+			item := decodeTodo(t, rec)
+			if item.Title != tc.wantTitle {
+				t.Errorf("POST /todos title = %q, want %q", item.Title, tc.wantTitle)
+			}
+			if item.Done {
+				t.Errorf("POST /todos done = true, want false")
+			}
+			if !item.CreatedAt.Equal(fixedNow) || !item.UpdatedAt.Equal(fixedNow) {
+				t.Errorf("POST /todos times = %v, %v, want %v", item.CreatedAt, item.UpdatedAt, fixedNow)
+			}
+			if got, want := rec.Header().Get("Location"), "/todos/"+item.ID; got != want {
+				t.Errorf("POST /todos Location = %q, want %q", got, want)
+			}
+		})
+	}
+}
+
+func TestListTodos(t *testing.T) {
+	h := newTestHandler()
+	// t0 to t24 are created oldest first. Even numbers are done.
+	for i := range 25 {
+		item := createOne(t, h, fmt.Sprintf("t%d", i))
+		if i%2 == 0 {
+			if rec := do(h, http.MethodPatch, "/todos/"+item.ID, `{"done":true}`); rec.Code != http.StatusOK {
+				t.Fatalf("PATCH done status = %d, want %d", rec.Code, http.StatusOK)
+			}
+		}
+	}
+	var evens, odds []string
+	for i := 24; i >= 0; i-- {
+		if i%2 == 0 {
+			evens = append(evens, fmt.Sprintf("t%d", i))
+		} else {
+			odds = append(odds, fmt.Sprintf("t%d", i))
+		}
+	}
+
+	cases := []struct {
+		name       string
+		target     string
+		wantCode   int
+		wantTitles []string
+	}{
+		{name: "default page is 20 newest", target: "/todos", wantCode: http.StatusOK, wantTitles: newestFirst(24, 5)},
+		{name: "limit 100 returns all", target: "/todos?limit=100", wantCode: http.StatusOK, wantTitles: newestFirst(24, 0)},
+		{name: "limit 5", target: "/todos?limit=5", wantCode: http.StatusOK, wantTitles: newestFirst(24, 20)},
+		{name: "offset 20", target: "/todos?offset=20", wantCode: http.StatusOK, wantTitles: newestFirst(4, 0)},
+		{name: "offset at end", target: "/todos?offset=25", wantCode: http.StatusOK, wantTitles: []string{}},
+		{name: "offset huge", target: "/todos?offset=9223372036854775807", wantCode: http.StatusOK, wantTitles: []string{}},
+		{name: "done true", target: "/todos?done=true&limit=100", wantCode: http.StatusOK, wantTitles: evens},
+		{name: "done false", target: "/todos?done=false&limit=100", wantCode: http.StatusOK, wantTitles: odds},
+		{name: "done with limit and offset", target: "/todos?done=true&limit=2&offset=1", wantCode: http.StatusOK, wantTitles: []string{"t22", "t20"}},
+		{name: "done invalid", target: "/todos?done=yes", wantCode: http.StatusBadRequest},
+		{name: "done empty", target: "/todos?done=", wantCode: http.StatusBadRequest},
+		{name: "limit zero", target: "/todos?limit=0", wantCode: http.StatusBadRequest},
+		{name: "limit negative", target: "/todos?limit=-1", wantCode: http.StatusBadRequest},
+		{name: "limit over 100", target: "/todos?limit=101", wantCode: http.StatusBadRequest},
+		{name: "limit not a number", target: "/todos?limit=abc", wantCode: http.StatusBadRequest},
+		{name: "limit empty", target: "/todos?limit=", wantCode: http.StatusBadRequest},
+		{name: "offset negative", target: "/todos?offset=-1", wantCode: http.StatusBadRequest},
+		{name: "offset not a number", target: "/todos?offset=abc", wantCode: http.StatusBadRequest},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := do(h, http.MethodGet, tc.target, "")
+			if tc.wantCode != http.StatusOK {
+				checkJSONError(t, rec, tc.wantCode)
+				return
+			}
+			if rec.Code != http.StatusOK {
+				t.Fatalf("GET %s status = %d, want %d; body %q", tc.target, rec.Code, http.StatusOK, rec.Body.String())
+			}
+			var items []todo.Todo
+			if err := json.Unmarshal(rec.Body.Bytes(), &items); err != nil {
+				t.Fatalf("GET %s body %q is not a list: %v", tc.target, rec.Body.String(), err)
+			}
+			if got := titlesOf(items); !slices.Equal(got, tc.wantTitles) {
+				t.Errorf("GET %s titles = %q, want %q", tc.target, got, tc.wantTitles)
+			}
+		})
+	}
+}
+
+func TestListTodosEmptyIsArray(t *testing.T) {
+	rec := do(newTestHandler(), http.MethodGet, "/todos", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("GET /todos status = %d, want %d", rec.Code, http.StatusOK)
+	}
+	if got := strings.TrimSpace(rec.Body.String()); got != "[]" {
+		t.Errorf("GET /todos on empty store body = %q, want %q", got, "[]")
+	}
+}
+
+func TestGetTodo(t *testing.T) {
+	h := newTestHandler()
+	made := createOne(t, h, "buy milk")
+	cases := []struct {
+		name     string
+		id       string
+		wantCode int
+	}{
+		{name: "existing", id: made.ID, wantCode: http.StatusOK},
+		{name: "missing", id: "nope", wantCode: http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := do(h, http.MethodGet, "/todos/"+tc.id, "")
+			if tc.wantCode != http.StatusOK {
+				checkJSONError(t, rec, tc.wantCode)
+				return
+			}
+			if rec.Code != http.StatusOK {
+				t.Fatalf("GET /todos/%s status = %d, want %d", tc.id, rec.Code, http.StatusOK)
+			}
+			if got := decodeTodo(t, rec); got.ID != made.ID || got.Title != "buy milk" {
+				t.Errorf("GET /todos/%s = %+v, want %+v", tc.id, got, made)
+			}
+		})
+	}
+}
+
+func TestUpdateTodo(t *testing.T) {
+	cases := []struct {
+		name      string
+		target    string // "{id}" is replaced with the id of the seeded to-do
+		body      string
+		wantCode  int
+		wantTitle string
+		wantDone  bool
+	}{
+		{name: "title only", target: "/todos/{id}", body: `{"title":"new"}`, wantCode: http.StatusOK, wantTitle: "new"},
+		{name: "done only", target: "/todos/{id}", body: `{"done":true}`, wantCode: http.StatusOK, wantTitle: "old", wantDone: true},
+		{name: "both", target: "/todos/{id}", body: `{"title":"new","done":true}`, wantCode: http.StatusOK, wantTitle: "new", wantDone: true},
+		{name: "title trimmed", target: "/todos/{id}", body: `{"title":"  new  "}`, wantCode: http.StatusOK, wantTitle: "new"},
+		{name: "empty object", target: "/todos/{id}", body: `{}`, wantCode: http.StatusBadRequest},
+		{name: "blank title", target: "/todos/{id}", body: `{"title":"   "}`, wantCode: http.StatusBadRequest},
+		{name: "title 201 characters", target: "/todos/{id}", body: `{"title":"` + strings.Repeat("a", 201) + `"}`, wantCode: http.StatusBadRequest},
+		{name: "null title only", target: "/todos/{id}", body: `{"title":null}`, wantCode: http.StatusBadRequest},
+		{name: "done not a bool", target: "/todos/{id}", body: `{"done":"yes"}`, wantCode: http.StatusBadRequest},
+		{name: "unknown field", target: "/todos/{id}", body: `{"done":true,"color":"red"}`, wantCode: http.StatusBadRequest},
+		{name: "malformed json", target: "/todos/{id}", body: `{"done":`, wantCode: http.StatusBadRequest},
+		{name: "empty body", target: "/todos/{id}", body: ``, wantCode: http.StatusBadRequest},
+		{name: "body over 1 MiB", target: "/todos/{id}", body: `{"title":"` + strings.Repeat("a", maxBodyBytes) + `"}`, wantCode: http.StatusRequestEntityTooLarge},
+		{name: "missing id", target: "/todos/nope", body: `{"done":true}`, wantCode: http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := newTestHandler()
+			made := createOne(t, h, "old")
+			target := strings.ReplaceAll(tc.target, "{id}", made.ID)
+			rec := do(h, http.MethodPatch, target, tc.body)
+			if tc.wantCode != http.StatusOK {
+				checkJSONError(t, rec, tc.wantCode)
+				if after := decodeTodo(t, do(h, http.MethodGet, "/todos/"+made.ID, "")); after.Title != "old" || after.Done {
+					t.Errorf("failed PATCH changed the to-do to %+v, want title %q done false", after, "old")
+				}
+				return
+			}
+			if rec.Code != http.StatusOK {
+				t.Fatalf("PATCH %s status = %d, want %d; body %q", target, rec.Code, http.StatusOK, rec.Body.String())
+			}
+			got := decodeTodo(t, rec)
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("PATCH %s = title %q done %v, want title %q done %v",
+					target, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
+
+func TestDeleteTodo(t *testing.T) {
+	h := newTestHandler()
+	made := createOne(t, h, "buy milk")
+
+	rec := do(h, http.MethodDelete, "/todos/"+made.ID, "")
+	if rec.Code != http.StatusNoContent {
+		t.Fatalf("DELETE /todos/%s status = %d, want %d; body %q", made.ID, rec.Code, http.StatusNoContent, rec.Body.String())
+	}
+	if rec.Body.Len() != 0 {
+		t.Errorf("DELETE /todos/%s body = %q, want empty", made.ID, rec.Body.String())
+	}
+	if after := do(h, http.MethodGet, "/todos/"+made.ID, ""); after.Code != http.StatusNotFound {
+		t.Errorf("GET /todos/%s after DELETE status = %d, want %d", made.ID, after.Code, http.StatusNotFound)
+	}
+
+	cases := []struct {
+		name string
+		id   string
+	}{
+		{name: "already deleted", id: made.ID},
+		{name: "never existed", id: "nope"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			checkJSONError(t, do(h, http.MethodDelete, "/todos/"+tc.id, ""), http.StatusNotFound)
+		})
+	}
+}
+
+func TestRoutingErrors(t *testing.T) {
+	h := newTestHandler()
+	made := createOne(t, h, "buy milk")
+
+	cases := []struct {
+		name      string
+		method    string
+		target    string
+		wantCode  int
+		wantAllow string
+	}{
+		{name: "PUT on collection", method: http.MethodPut, target: "/todos", wantCode: http.StatusMethodNotAllowed, wantAllow: "GET, POST"},
+		{name: "DELETE on collection", method: http.MethodDelete, target: "/todos", wantCode: http.StatusMethodNotAllowed, wantAllow: "GET, POST"},
+		{name: "POST on item", method: http.MethodPost, target: "/todos/" + made.ID, wantCode: http.StatusMethodNotAllowed, wantAllow: "GET, PATCH, DELETE"},
+		{name: "PUT on item", method: http.MethodPut, target: "/todos/" + made.ID, wantCode: http.StatusMethodNotAllowed, wantAllow: "GET, PATCH, DELETE"},
+		{name: "unknown path", method: http.MethodGet, target: "/nope", wantCode: http.StatusNotFound},
+		{name: "trailing slash on collection", method: http.MethodGet, target: "/todos/", wantCode: http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := do(h, tc.method, tc.target, "")
+			checkJSONError(t, rec, tc.wantCode)
+			if got := rec.Header().Get("Allow"); got != tc.wantAllow {
+				t.Errorf("%s %s Allow = %q, want %q", tc.method, tc.target, got, tc.wantAllow)
+			}
+		})
+	}
+}
