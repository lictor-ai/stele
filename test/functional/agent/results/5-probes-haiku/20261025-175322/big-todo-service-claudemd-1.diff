+++ b/internal/todo/store_test.go
@@ -0,0 +1,365 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var (
+	t0 = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	t1 = t0.Add(time.Hour)
+)
+
+// testClock is a clock that a test can move forward. It is not safe for
+// concurrent use, so only single-goroutine tests use it.
+type testClock struct{ T time.Time }
+
+// Now returns the current value of T.
+func (c *testClock) Now() time.Time { return c.T }
+
+// ptr returns a pointer to a copy of v, for filling optional fields.
+func ptr[T any](v T) *T { return &v }
+
+// create adds one to-do and fails the test on error.
+func create(t *testing.T, s *Store, title string) Todo {
+	t.Helper()
+	item, err := s.Create(context.Background(), title)
+	if err != nil {
+		t.Fatalf("Create(%q) error = %v, want nil", title, err)
+	}
+	return item
+}
+
+func TestCreate(t *testing.T) {
+	cases := []struct {
+		name      string
+		title     string
+		wantTitle string
+		wantErr   error
+	}{
+		{name: "plain", title: "buy milk", wantTitle: "buy milk"},
+		{name: "trims spaces and tabs", title: " \tbuy milk \n", wantTitle: "buy milk"},
+		{name: "empty", title: "", wantErr: ErrInvalidTitle},
+		{name: "only spaces", title: "   ", wantErr: ErrInvalidTitle},
+		{name: "max length", title: strings.Repeat("a", 200), wantTitle: strings.Repeat("a", 200)},
+		{name: "one over max length", title: strings.Repeat("a", 201), wantErr: ErrInvalidTitle},
+		{name: "max length in characters not bytes", title: strings.Repeat("é", 200), wantTitle: strings.Repeat("é", 200)},
+		{name: "one over max in characters", title: strings.Repeat("é", 201), wantErr: ErrInvalidTitle},
+		{name: "long after trimming", title: " " + strings.Repeat("a", 200) + " ", wantTitle: strings.Repeat("a", 200)},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: t0})
+			got, err := s.Create(context.Background(), tc.title)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.title, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				return
+			}
+			if got.Title != tc.wantTitle {
+				t.Errorf("Create(%q) title = %q, want %q", tc.title, got.Title, tc.wantTitle)
+			}
+			if got.ID == "" {
+				t.Errorf("Create(%q) id is empty, want a generated id", tc.title)
+			}
+			if got.Done {
+				t.Errorf("Create(%q) done = true, want false", tc.title)
+			}
+			if !got.CreatedAt.Equal(t0) || !got.UpdatedAt.Equal(t0) {
+				t.Errorf("Create(%q) times = %v, %v, want %v, %v", tc.title, got.CreatedAt, got.UpdatedAt, t0, t0)
+			}
+		})
+	}
+}
+
+func TestCreateGivesUniqueIDs(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	seen := make(map[string]bool)
+	for range 100 {
+		item := create(t, s, "x")
+		if seen[item.ID] {
+			t.Fatalf("Create() id = %q, already issued", item.ID)
+		}
+		seen[item.ID] = true
+	}
+}
+
+func TestGet(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	made := create(t, s, "buy milk")
+
+	cases := []struct {
+		name    string
+		id      string
+		wantErr error
+	}{
+		{name: "existing", id: made.ID},
+		{name: "missing", id: "nope", wantErr: ErrNotFound},
+		{name: "empty id", id: "", wantErr: ErrNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.Get(context.Background(), tc.id)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Get(%q) error = %v, want %v", tc.id, err, tc.wantErr)
+			}
+			if tc.wantErr == nil && got != made {
+				t.Errorf("Get(%q) = %+v, want %+v", tc.id, got, made)
+			}
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	cases := []struct {
+		name      string
+		patch     Patch
+		wantTitle string
+		wantDone  bool
+		wantErr   error
+	}{
+		{name: "title only", patch: Patch{Title: ptr("new")}, wantTitle: "new", wantDone: false},
+		{name: "done only", patch: Patch{Done: ptr(true)}, wantTitle: "old", wantDone: true},
+		{name: "both", patch: Patch{Title: ptr("new"), Done: ptr(true)}, wantTitle: "new", wantDone: true},
+		{name: "title is trimmed", patch: Patch{Title: ptr("  new  ")}, wantTitle: "new", wantDone: false},
+		{name: "done set to false", patch: Patch{Done: ptr(false)}, wantTitle: "old", wantDone: false},
+		{name: "empty patch", patch: Patch{}, wantErr: ErrEmptyPatch},
+		{name: "blank title", patch: Patch{Title: ptr("   ")}, wantErr: ErrInvalidTitle},
+		{name: "title too long", patch: Patch{Title: ptr(strings.Repeat("a", 201))}, wantErr: ErrInvalidTitle},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: t0})
+			made := create(t, s, "old")
+			got, err := s.Update(context.Background(), made.ID, tc.patch)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Update(%+v) error = %v, want %v", tc.patch, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				after, _ := s.Get(context.Background(), made.ID)
+				if after != made {
+					t.Errorf("after failed Update(%+v) item = %+v, want unchanged %+v", tc.patch, after, made)
+				}
+				return
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%+v) = title %q done %v, want title %q done %v",
+					tc.patch, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
+
+func TestUpdateMissingID(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	_, err := s.Update(context.Background(), "nope", Patch{Done: ptr(true)})
+	if !errors.Is(err, ErrNotFound) {
+		t.Errorf("Update(missing) error = %v, want %v", err, ErrNotFound)
+	}
+}
+
+func TestUpdateSetsUpdatedAtOnly(t *testing.T) {
+	clk := &testClock{T: t0}
+	s := NewStore(clk)
+	made := create(t, s, "old")
+
+	clk.T = t1
+	got, err := s.Update(context.Background(), made.ID, Patch{Done: ptr(true)})
+	if err != nil {
+		t.Fatalf("Update(done) error = %v, want nil", err)
+	}
+	if !got.CreatedAt.Equal(t0) {
+		t.Errorf("Update(done) created_at = %v, want %v", got.CreatedAt, t0)
+	}
+	if !got.UpdatedAt.Equal(t1) {
+		t.Errorf("Update(done) updated_at = %v, want %v", got.UpdatedAt, t1)
+	}
+}
+
+func TestDelete(t *testing.T) {
+	cases := []struct {
+		name    string
+		useReal bool
+		wantErr error
+	}{
+		{name: "existing", useReal: true},
+		{name: "missing", wantErr: ErrNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: t0})
+			id := "nope"
+			if tc.useReal {
+				id = create(t, s, "buy milk").ID
+			}
+			err := s.Delete(context.Background(), id)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Delete(%q) error = %v, want %v", id, err, tc.wantErr)
+			}
+			if tc.useReal {
+				if _, err := s.Get(context.Background(), id); !errors.Is(err, ErrNotFound) {
+					t.Errorf("Get(%q) after Delete error = %v, want %v", id, err, ErrNotFound)
+				}
+			}
+		})
+	}
+}
+
+// seedList creates five to-dos titled "t1" to "t5", oldest first. Even
+// numbers are done. Every item gets the same timestamp, so order must come
+// from creation order.
+func seedList(t *testing.T) *Store {
+	t.Helper()
+	s := NewStore(clock.Fixed{T: t0})
+	for i := 1; i <= 5; i++ {
+		item := create(t, s, fmt.Sprintf("t%d", i))
+		if i%2 == 0 {
+			if _, err := s.Update(context.Background(), item.ID, Patch{Done: ptr(true)}); err != nil {
+				t.Fatalf("Update(t%d) error = %v, want nil", i, err)
+			}
+		}
+	}
+	return s
+}
+
+func TestList(t *testing.T) {
+	cases := []struct {
+		name    string
+		filter  Filter
+		want    []string
+		wantErr error
+	}{
+		{name: "all, newest first", filter: Filter{Limit: DefaultLimit}, want: []string{"t5", "t4", "t3", "t2", "t1"}},
+		{name: "done only", filter: Filter{Done: ptr(true), Limit: 10}, want: []string{"t4", "t2"}},
+		{name: "not done only", filter: Filter{Done: ptr(false), Limit: 10}, want: []string{"t5", "t3", "t1"}},
+		{name: "limit", filter: Filter{Limit: 2}, want: []string{"t5", "t4"}},
+		{name: "limit and offset", filter: Filter{Limit: 2, Offset: 2}, want: []string{"t3", "t2"}},
+		{name: "offset reaches last item", filter: Filter{Limit: 10, Offset: 4}, want: []string{"t1"}},
+		{name: "offset at end", filter: Filter{Limit: 10, Offset: 5}, want: []string{}},
+		{name: "offset past end", filter: Filter{Limit: 10, Offset: math.MaxInt}, want: []string{}},
+		{name: "done with limit and offset", filter: Filter{Done: ptr(true), Limit: 1, Offset: 1}, want: []string{"t2"}},
+		{name: "max limit", filter: Filter{Limit: MaxLimit}, want: []string{"t5", "t4", "t3", "t2", "t1"}},
+		{name: "limit zero", filter: Filter{Limit: 0}, wantErr: ErrInvalidPage},
+		{name: "limit negative", filter: Filter{Limit: -1}, wantErr: ErrInvalidPage},
+		{name: "limit over max", filter: Filter{Limit: MaxLimit + 1}, wantErr: ErrInvalidPage},
+		{name: "offset negative", filter: Filter{Limit: 10, Offset: -1}, wantErr: ErrInvalidPage},
+	}
+	s := seedList(t)
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.List(context.Background(), tc.filter)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("List(%+v) error = %v, want %v", tc.filter, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				return
+			}
+			titles := make([]string, 0, len(got))
+			for _, item := range got {
+				titles = append(titles, item.Title)
+			}
+			if !slices.Equal(titles, tc.want) {
+				t.Errorf("List(%+v) titles = %q, want %q", tc.filter, titles, tc.want)
+			}
+		})
+	}
+}
+
+func TestListEmptyStore(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	got, err := s.List(context.Background(), Filter{Limit: DefaultLimit})
+	if err != nil {
+		t.Fatalf("List() error = %v, want nil", err)
+	}
+	if got == nil || len(got) != 0 {
+		t.Errorf("List() = %v, want a non-nil empty slice", got)
+	}
+}
+
+func TestCanceledContext(t *testing.T) {
+	s := NewStore(clock.Fixed{T: t0})
+	made := create(t, s, "buy milk")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	ops := []struct {
+		name string
+		call func() error
+	}{
+		{"Create", func() error { _, err := s.Create(ctx, "x"); return err }},
+		{"Get", func() error { _, err := s.Get(ctx, made.ID); return err }},
+		{"Update", func() error { _, err := s.Update(ctx, made.ID, Patch{Done: ptr(true)}); return err }},
+		{"Delete", func() error { return s.Delete(ctx, made.ID) }},
+		{"List", func() error { _, err := s.List(ctx, Filter{Limit: DefaultLimit}); return err }},
+	}
+	for _, op := range ops {
+		t.Run(op.name, func(t *testing.T) {
+			if err := op.call(); !errors.Is(err, context.Canceled) {
+				t.Errorf("%s with canceled ctx error = %v, want %v", op.name, err, context.Canceled)
+			}
+		})
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	const workers = 20
+	const perWorker = 10
+
+	s := NewStore(clock.Fixed{T: t0})
+	ctx := context.Background()
+	var wg sync.WaitGroup
+	for w := range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			ids := make([]string, 0, perWorker)
+			for i := range perWorker {
+				item, err := s.Create(ctx, fmt.Sprintf("w%d-%d", w, i))
+				if err != nil {
+					t.Errorf("Create(w%d-%d) error = %v, want nil", w, i, err)
+					return
+				}
+				ids = append(ids, item.ID)
+			}
+			// Index 0 becomes done. Odd indexes are deleted, so each worker
+			// keeps 5 items, 1 of them done.
+			if _, err := s.Update(ctx, ids[0], Patch{Done: ptr(true)}); err != nil {
+				t.Errorf("Update(w%d first) error = %v, want nil", w, err)
+			}
+			for i := 1; i < perWorker; i += 2 {
+				if err := s.Delete(ctx, ids[i]); err != nil {
+					t.Errorf("Delete(w%d-%d) error = %v, want nil", w, i, err)
+				}
+			}
+			if _, err := s.List(ctx, Filter{Limit: MaxLimit, Offset: w}); err != nil {
+				t.Errorf("List(w%d) error = %v, want nil", w, err)
+			}
+		}()
+	}
+	wg.Wait()
+
+	all, err := s.List(ctx, Filter{Limit: MaxLimit})
+	if err != nil {
+		t.Fatalf("List() error = %v, want nil", err)
+	}
+	if want := workers * 5; len(all) != want {
+		t.Errorf("List() returned %d items, want %d", len(all), want)
+	}
+	done, err := s.List(ctx, Filter{Done: ptr(true), Limit: MaxLimit})
+	if err != nil {
+		t.Fatalf("List(done) error = %v, want nil", err)
+	}
+	if want := workers; len(done) != want {
+		t.Errorf("List(done) returned %d items, want %d", len(done), want)
+	}
+}
