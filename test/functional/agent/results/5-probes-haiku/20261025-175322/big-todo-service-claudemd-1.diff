diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..f347d67
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,152 @@
+package todo
+
+import (
+	"cmp"
+	"context"
+	"slices"
+	"sync"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Store keeps to-do items in memory. It is safe for concurrent use.
+type Store struct {
+	clk clock.Clock
+
+	mu    sync.RWMutex // guards items and seq
+	items map[string]*entry
+	seq   uint64
+}
+
+// entry is a stored to-do and its place in creation order.
+type entry struct {
+	todo Todo
+	seq  uint64
+}
+
+// NewStore returns an empty Store that reads the time from clk.
+func NewStore(clk clock.Clock) *Store {
+	return &Store{clk: clk, items: make(map[string]*entry)}
+}
+
+// Create adds a to-do with the given title and returns it. It returns
+// ErrInvalidTitle if the title is empty or too long after trimming spaces.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	t, err := normalizeTitle(title)
+	if err != nil {
+		return Todo{}, err
+	}
+	now := s.clk.Now()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.seq++
+	item := Todo{ID: id.New(), Title: t, CreatedAt: now, UpdatedAt: now}
+	s.items[item.ID] = &entry{todo: item, seq: s.seq}
+	return item, nil
+}
+
+// Get returns the to-do with the given id, or ErrNotFound.
+func (s *Store) Get(ctx context.Context, itemID string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	e, ok := s.items[itemID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return e.todo, nil
+}
+
+// Update changes the fields set in p and returns the updated to-do. It
+// returns ErrEmptyPatch if p sets nothing, ErrInvalidTitle if the new title
+// is not valid, and ErrNotFound if no to-do has the given id. A failed update
+// changes nothing.
+func (s *Store) Update(ctx context.Context, itemID string, p Patch) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	if p.Title == nil && p.Done == nil {
+		return Todo{}, ErrEmptyPatch
+	}
+	var title string
+	if p.Title != nil {
+		t, err := normalizeTitle(*p.Title)
+		if err != nil {
+			return Todo{}, err
+		}
+		title = t
+	}
+	now := s.clk.Now()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.items[itemID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if p.Title != nil {
+		e.todo.Title = title
+	}
+	if p.Done != nil {
+		e.todo.Done = *p.Done
+	}
+	e.todo.UpdatedAt = now
+	return e.todo, nil
+}
+
+// Delete removes the to-do with the given id. It returns ErrNotFound if no
+// to-do has that id.
+func (s *Store) Delete(ctx context.Context, itemID string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[itemID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, itemID)
+	return nil
+}
+
+// List returns the to-dos that match f, newest first. Order follows creation
+// order, not the clock, so items created at the same instant keep a stable
+// order. It returns ErrInvalidPage if f.Limit or f.Offset is out of range.
+func (s *Store) List(ctx context.Context, f Filter) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if f.Limit < 1 || f.Limit > MaxLimit || f.Offset < 0 {
+		return nil, ErrInvalidPage
+	}
+
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	matched := make([]*entry, 0, len(s.items))
+	for _, e := range s.items {
+		if f.Done != nil && e.todo.Done != *f.Done {
+			continue
+		}
+		matched = append(matched, e)
+	}
+	slices.SortFunc(matched, func(a, b *entry) int {
+		return cmp.Compare(b.seq, a.seq)
+	})
+
+	start := min(f.Offset, len(matched))
+	end := min(start+f.Limit, len(matched))
+	out := make([]Todo, 0, end-start)
+	for _, e := range matched[start:end] {
+		out = append(out, e.todo)
+	}
+	return out, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
