+		{name: "done only", opts: todo.ListOptions{Done: ptr(true), Limit: 10}, wantTitles: []string{"d", "b"}},
+		{name: "open only", opts: todo.ListOptions{Done: ptr(false), Limit: 10}, wantTitles: []string{"e", "c", "a"}},
+		{name: "done with offset", opts: todo.ListOptions{Done: ptr(true), Limit: 1, Offset: 1}, wantTitles: []string{"b"}},
+		{name: "zero limit", opts: todo.ListOptions{Limit: 0}, wantErr: todo.ErrInvalidPage},
+		{name: "limit over the largest", opts: todo.ListOptions{Limit: todo.MaxPageLimit + 1}, wantErr: todo.ErrInvalidPage},
+		{name: "negative limit", opts: todo.ListOptions{Limit: -1}, wantErr: todo.ErrInvalidPage},
+		{name: "negative offset", opts: todo.ListOptions{Limit: 10, Offset: -1}, wantErr: todo.ErrInvalidPage},
