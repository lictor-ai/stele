@@ -0,0 +1,466 @@
+package todo_test
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+var t0 = time.Date(2026, time.October, 25, 9, 0, 0, 0, time.UTC)
+
+// settableClock is a clock that a test can move forward.
+type settableClock struct{ now time.Time }
+
+// Now returns the time the test set.
+func (c *settableClock) Now() time.Time { return c.now }
+
+func newStore() *todo.Store { return todo.NewStore(clock.Fixed{T: t0}) }
+
+func ptr[T any](v T) *T { return &v }
+
+// seed creates one todo per title, in the order given, and returns them.
+func seed(t *testing.T, s *todo.Store, titles ...string) []todo.Todo {
+	t.Helper()
+	out := make([]todo.Todo, 0, len(titles))
+	for _, title := range titles {
+		td, err := s.Create(context.Background(), title)
+		if err != nil {
+			t.Fatalf("Create(%q) error = %v, want nil", title, err)
+		}
+		out = append(out, td)
+	}
+	return out
+}
+
+// listAll returns every todo in s, newest first, by reading pages of the largest size.
+func listAll(t *testing.T, s *todo.Store) []todo.Todo {
+	t.Helper()
+	var all []todo.Todo
+	for offset := 0; ; offset += todo.MaxPageLimit {
+		page, err := s.List(context.Background(), todo.ListOptions{Limit: todo.MaxPageLimit, Offset: offset})
+		if err != nil {
+			t.Fatalf("List(offset %d) error = %v, want nil", offset, err)
+		}
+		all = append(all, page...)
+		if len(page) < todo.MaxPageLimit {
+			return all
+		}
+	}
+}
+
+// titlesOf returns the titles of list, in order.
+func titlesOf(list []todo.Todo) []string {
+	out := make([]string, 0, len(list))
+	for _, td := range list {
+		out = append(out, td.Title)
+	}
+	return out
+}
+
+func TestValidateTitle(t *testing.T) {
+	long := strings.Repeat("a", todo.MaxTitleLen)
+	multibyte := strings.Repeat("é", todo.MaxTitleLen) // 200 characters, 400 bytes
+
+	tests := []struct {
+		name    string
+		in      string
+		want    string
+		wantErr error
+	}{
+		{name: "empty", in: "", wantErr: todo.ErrInvalidTitle},
+		{name: "spaces only", in: "   \t ", wantErr: todo.ErrInvalidTitle},
+		{name: "one character", in: "a", want: "a"},
+		{name: "trimmed", in: "  buy milk \n", want: "buy milk"},
+		{name: "longest", in: long, want: long},
+		{name: "one over longest", in: long + "a", wantErr: todo.ErrInvalidTitle},
+		{name: "longest counts characters not bytes", in: multibyte, want: multibyte},
+		{name: "spaces do not count toward the limit", in: "  " + long + "  ", want: long},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := todo.ValidateTitle(tc.in)
+			if !errors.Is(err, tc.wantErr) {
+				t.Errorf("ValidateTitle(%q) error = %v, want %v", tc.in, err, tc.wantErr)
+			}
+			if got != tc.want {
+				t.Errorf("ValidateTitle(%q) = %q, want %q", tc.in, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name      string
+		title     string
+		wantTitle string
+		wantErr   error
+	}{
+		{name: "plain", title: "buy milk", wantTitle: "buy milk"},
+		{name: "trimmed", title: "  buy milk \n", wantTitle: "buy milk"},
+		{name: "one character", title: "x", wantTitle: "x"},
+		{name: "empty", title: "", wantErr: todo.ErrInvalidTitle},
+		{name: "blank", title: " \t ", wantErr: todo.ErrInvalidTitle},
+		{name: "too long", title: strings.Repeat("a", todo.MaxTitleLen+1), wantErr: todo.ErrInvalidTitle},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newStore()
+			got, err := s.Create(context.Background(), tc.title)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.title, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				if n := len(listAll(t, s)); n != 0 {
+					t.Errorf("after failed Create(%q), List has %d todos, want 0", tc.title, n)
+				}
+				return
+			}
+			if got.Title != tc.wantTitle {
+				t.Errorf("Create(%q) Title = %q, want %q", tc.title, got.Title, tc.wantTitle)
+			}
+			if got.ID == "" {
+				t.Errorf("Create(%q) ID = empty, want a generated id", tc.title)
+			}
+			if got.Done {
+				t.Errorf("Create(%q) Done = true, want false", tc.title)
+			}
+			if !got.CreatedAt.Equal(t0) || !got.UpdatedAt.Equal(t0) {
+				t.Errorf("Create(%q) CreatedAt, UpdatedAt = %v, %v, want %v for both", tc.title, got.CreatedAt, got.UpdatedAt, t0)
+			}
+		})
+	}
+}
+
+func TestGet(t *testing.T) {
+	tests := []struct {
+		name    string
+		found   bool   // use the id of the seeded todo
+		id      string // used when found is false
+		wantErr error
+	}{
+		{name: "found", found: true},
+		{name: "unknown id", id: "nope", wantErr: todo.ErrNotFound},
+		{name: "empty id", id: "", wantErr: todo.ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newStore()
+			base := seed(t, s, "milk")[0]
+			id := tc.id
+			if tc.found {
+				id = base.ID
+			}
+			got, err := s.Get(context.Background(), id)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Get(%q) error = %v, want %v", id, err, tc.wantErr)
+			}
+			if tc.wantErr == nil && got.Title != "milk" {
+				t.Errorf("Get(%q) Title = %q, want %q", id, got.Title, "milk")
+			}
+		})
+	}
+}
