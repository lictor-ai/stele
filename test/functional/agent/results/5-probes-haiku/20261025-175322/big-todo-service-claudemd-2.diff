+package api_test
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+var t0 = time.Date(2026, time.October, 25, 9, 0, 0, 0, time.UTC)
+
+// newFixture returns a handler and the store behind it.
+func newFixture() (*api.Handler, *todo.Store) {
+	s := todo.NewStore(clock.Fixed{T: t0})
+	return api.NewHandler(s), s
+}
+
+// seedTodo creates one todo in s and returns it.
+func seedTodo(t *testing.T, s *todo.Store, title string) todo.Todo {
+	t.Helper()
+	td, err := s.Create(context.Background(), title)
+	if err != nil {
+		t.Fatalf("Create(%q) error = %v, want nil", title, err)
+	}
+	return td
+}
+
+// do sends one request to h and returns the recorded response.
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, httptest.NewRequest(method, target, strings.NewReader(body)))
+	return rec
+}
+
+// decodeResp decodes the response body into T.
+func decodeResp[T any](t *testing.T, what string, rec *httptest.ResponseRecorder) T {
+	t.Helper()
+	var v T
+	if err := json.NewDecoder(rec.Body).Decode(&v); err != nil {
+		t.Fatalf("%s: body %q is not the wanted JSON: %v", what, rec.Body.String(), err)
+	}
+	return v
+}
+
+// assertError checks that rec is a JSON error response with the wanted status.
+func assertError(t *testing.T, what string, rec *httptest.ResponseRecorder, wantStatus int) {
+	t.Helper()
+	if rec.Code != wantStatus {
+		t.Errorf("%s: status = %d, want %d; body %q", what, rec.Code, wantStatus, rec.Body.String())
+	}
+	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
+		t.Errorf("%s: Content-Type = %q, want %q", what, ct, "application/json")
+	}
+	var body map[string]string
+	if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
+		t.Fatalf("%s: error body %q is not JSON: %v", what, rec.Body.String(), err)
+	}
+	if body["error"] == "" {
+		t.Errorf("%s: error body %q has no error message, want one", what, rec.Body.String())
+	}
+}
+
+func TestCreateTodo(t *testing.T) {
+	long := strings.Repeat("a", todo.MaxTitleLen)
+	tests := []struct {
+		name       string
+		body       string
+		wantStatus int
+		wantTitle  string
+	}{
+		{name: "valid", body: `{"title":"buy milk"}`, wantStatus: http.StatusCreated, wantTitle: "buy milk"},
+		{name: "title trimmed", body: `{"title":"  buy milk  "}`, wantStatus: http.StatusCreated, wantTitle: "buy milk"},
+		{name: "longest title", body: fmt.Sprintf(`{"title":%q}`, long), wantStatus: http.StatusCreated, wantTitle: long},
+		{name: "empty title", body: `{"title":""}`, wantStatus: http.StatusBadRequest},
+		{name: "blank title", body: `{"title":"   "}`, wantStatus: http.StatusBadRequest},
+		{name: "title one over longest", body: fmt.Sprintf(`{"title":%q}`, long+"a"), wantStatus: http.StatusBadRequest},
+		{name: "missing title", body: `{}`, wantStatus: http.StatusBadRequest},
+		{name: "title not a string", body: `{"title":5}`, wantStatus: http.StatusBadRequest},
+		{name: "unknown field", body: `{"title":"x","color":"red"}`, wantStatus: http.StatusBadRequest},
+		{name: "two JSON objects", body: `{"title":"x"}{"title":"y"}`, wantStatus: http.StatusBadRequest},
+		{name: "not JSON", body: `not json`, wantStatus: http.StatusBadRequest},
+		{name: "empty body", body: ``, wantStatus: http.StatusBadRequest},
+		{name: "body over 1 MiB", body: `{"title":"` + strings.Repeat("a", 1<<20) + `"}`, wantStatus: http.StatusRequestEntityTooLarge},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, _ := newFixture()
+			what := "POST /todos " + tc.name
+			rec := do(h, http.MethodPost, "/todos", tc.body)
+			if tc.wantStatus != http.StatusCreated {
+				assertError(t, what, rec, tc.wantStatus)
+				return
+			}
+			if rec.Code != tc.wantStatus {
+				t.Fatalf("%s: status = %d, want %d; body %q", what, rec.Code, tc.wantStatus, rec.Body.String())
+			}
+			td := decodeResp[todo.Todo](t, what, rec)
+			if td.Title != tc.wantTitle {
+				t.Errorf("%s: title = %q, want %q", what, td.Title, tc.wantTitle)
+			}
+			if td.ID == "" {
+				t.Errorf("%s: id is empty, want a generated id", what)
+			}
+			if td.Done {
+				t.Errorf("%s: done = true, want false", what)
+			}
+			if loc := rec.Header().Get("Location"); loc != "/todos/"+td.ID {
+				t.Errorf("%s: Location = %q, want %q", what, loc, "/todos/"+td.ID)
+			}
+		})
+	}
+}
+
+// newListFixture returns a handler over 25 todos titled "todo 00" to "todo 24", oldest first. "todo 23" and "todo 24" are done.
+func newListFixture(t *testing.T) *api.Handler {
+	t.Helper()
+	h, s := newFixture()
+	for i := range 25 {
+		td := seedTodo(t, s, fmt.Sprintf("todo %02d", i))
+		if i >= 23 {
+			done := true
+			if _, err := s.Update(context.Background(), td.ID, todo.Patch{Done: &done}); err != nil {
+				t.Fatalf("Update(%q) error = %v, want nil", td.ID, err)
+			}
+		}
+	}
+	return h
+}
+
+func TestListTodos(t *testing.T) {
+	tests := []struct {
+		name       string
+		query      string
+		wantStatus int
+		wantLen    int
+		wantFirst  string // title of the first todo; checked when wantLen is not 0
+	}{
+		{name: "no parameters, default limit", query: "", wantStatus: http.StatusOK, wantLen: 20, wantFirst: "todo 24"},
+		{name: "limit", query: "?limit=5", wantStatus: http.StatusOK, wantLen: 5, wantFirst: "todo 24"},
+		{name: "limit and offset", query: "?limit=5&offset=5", wantStatus: http.StatusOK, wantLen: 5, wantFirst: "todo 19"},
+		{name: "largest limit", query: "?limit=100", wantStatus: http.StatusOK, wantLen: 25, wantFirst: "todo 24"},
+		{name: "offset past the end", query: "?offset=25", wantStatus: http.StatusOK, wantLen: 0},
+		{name: "done=true", query: "?done=true", wantStatus: http.StatusOK, wantLen: 2, wantFirst: "todo 24"},
+		{name: "done=false uses default limit", query: "?done=false", wantStatus: http.StatusOK, wantLen: 20, wantFirst: "todo 22"},
+		{name: "done=false with largest limit", query: "?done=false&limit=100", wantStatus: http.StatusOK, wantLen: 23, wantFirst: "todo 22"},
+		{name: "done=true with paging", query: "?done=true&limit=1&offset=1", wantStatus: http.StatusOK, wantLen: 1, wantFirst: "todo 23"},
+		{name: "done not a bool", query: "?done=yes", wantStatus: http.StatusBadRequest},
+		{name: "done empty", query: "?done=", wantStatus: http.StatusBadRequest},
+		{name: "done=1", query: "?done=1", wantStatus: http.StatusBadRequest},
+		{name: "limit zero", query: "?limit=0", wantStatus: http.StatusBadRequest},
+		{name: "limit over largest", query: "?limit=101", wantStatus: http.StatusBadRequest},
+		{name: "limit not a number", query: "?limit=abc", wantStatus: http.StatusBadRequest},
+		{name: "limit empty", query: "?limit=", wantStatus: http.StatusBadRequest},
+		{name: "limit negative", query: "?limit=-5", wantStatus: http.StatusBadRequest},
+		{name: "limit overflows int", query: "?limit=99999999999999999999999", wantStatus: http.StatusBadRequest},
+		{name: "offset negative", query: "?offset=-1", wantStatus: http.StatusBadRequest},
+		{name: "offset not a number", query: "?offset=x", wantStatus: http.StatusBadRequest},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h := newListFixture(t)
+			what := "GET /todos" + tc.query
+			rec := do(h, http.MethodGet, "/todos"+tc.query, "")
+			if tc.wantStatus != http.StatusOK {
+				assertError(t, what, rec, tc.wantStatus)
+				return
+			}
+			if rec.Code != tc.wantStatus {
+				t.Fatalf("%s: status = %d, want %d; body %q", what, rec.Code, tc.wantStatus, rec.Body.String())
+			}
+			list := decodeResp[[]todo.Todo](t, what, rec)
+			if len(list) != tc.wantLen {
+				t.Fatalf("%s: got %d todos, want %d", what, len(list), tc.wantLen)
+			}
+			if tc.wantLen > 0 && list[0].Title != tc.wantFirst {
+				t.Errorf("%s: first title = %q, want %q", what, list[0].Title, tc.wantFirst)
+			}
+		})
+	}
+}
+
+func TestListTodosEmptyIsJSONArray(t *testing.T) {
+	h, _ := newFixture()
+	rec := do(h, http.MethodGet, "/todos", "")
+	if rec.Code != http.StatusOK {
+		t.Fatalf("GET /todos on empty store: status = %d, want %d", rec.Code, http.StatusOK)
+	}
+	if got := strings.TrimSpace(rec.Body.String()); got != "[]" {
+		t.Errorf("GET /todos on empty store: body = %q, want %q", got, "[]")
+	}
+}
+
+func TestGetTodo(t *testing.T) {
+	h, s := newFixture()
+	td := seedTodo(t, s, "milk")
+	tests := []struct {
+		name       string
+		path       string
+		wantStatus int
+	}{
+		{name: "found", path: "/todos/" + td.ID, wantStatus: http.StatusOK},
+		{name: "unknown id", path: "/todos/nope", wantStatus: http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			what := "GET " + tc.path
+			rec := do(h, http.MethodGet, tc.path, "")
+			if tc.wantStatus != http.StatusOK {
+				assertError(t, what, rec, tc.wantStatus)
+				return
+			}
+			if rec.Code != tc.wantStatus {
+				t.Fatalf("%s: status = %d, want %d; body %q", what, rec.Code, tc.wantStatus, rec.Body.String())
+			}
+			got := decodeResp[todo.Todo](t, what, rec)
+			if got.ID != td.ID || got.Title != "milk" {
+				t.Errorf("%s: got id %q title %q, want id %q title %q", what, got.ID, got.Title, td.ID, "milk")
+			}
+		})
+	}
+}
+
+func TestUpdateTodo(t *testing.T) {
+	tests := []struct {
+		name       string
+		path       string // "{id}" is replaced with the seeded todo's id
+		body       string
+		wantStatus int
+		wantTitle  string
+		wantDone   bool
+	}{
+		{name: "title only", path: "/todos/{id}", body: `{"title":"renamed"}`, wantStatus: http.StatusOK, wantTitle: "renamed"},
+		{name: "done only", path: "/todos/{id}", body: `{"done":true}`, wantStatus: http.StatusOK, wantTitle: "milk", wantDone: true},
+		{name: "both, title trimmed", path: "/todos/{id}", body: `{"title":" eggs ","done":true}`, wantStatus: http.StatusOK, wantTitle: "eggs", wantDone: true},
+		{name: "empty object", path: "/todos/{id}", body: `{}`, wantStatus: http.StatusBadRequest},
+		{name: "empty title", path: "/todos/{id}", body: `{"title":""}`, wantStatus: http.StatusBadRequest},
+		{name: "blank title", path: "/todos/{id}", body: `{"title":"  "}`, wantStatus: http.StatusBadRequest},
+		{name: "title too long", path: "/todos/{id}", body: fmt.Sprintf(`{"title":%q}`, strings.Repeat("a", todo.MaxTitleLen+1)), wantStatus: http.StatusBadRequest},
+		{name: "done not a bool", path: "/todos/{id}", body: `{"done":"yes"}`, wantStatus: http.StatusBadRequest},
+		{name: "unknown field", path: "/todos/{id}", body: `{"status":"x"}`, wantStatus: http.StatusBadRequest},
+		{name: "not JSON", path: "/todos/{id}", body: `not json`, wantStatus: http.StatusBadRequest},
+		{name: "unknown id", path: "/todos/nope", body: `{"done":true}`, wantStatus: http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, s := newFixture()
+			td := seedTodo(t, s, "milk")
+			path := strings.ReplaceAll(tc.path, "{id}", td.ID)
+			what := "PATCH " + path + " " + tc.body
+			rec := do(h, http.MethodPatch, path, tc.body)
+			if tc.wantStatus != http.StatusOK {
+				assertError(t, what, rec, tc.wantStatus)
+				return
+			}
+			if rec.Code != tc.wantStatus {
+				t.Fatalf("%s: status = %d, want %d; body %q", what, rec.Code, tc.wantStatus, rec.Body.String())
+			}
+			got := decodeResp[todo.Todo](t, what, rec)
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("%s: got title %q done %t, want title %q done %t", what, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			stored, err := s.Get(context.Background(), td.ID)
+			if err != nil {
+				t.Fatalf("%s: Get after PATCH error = %v, want nil", what, err)
+			}
+			if stored.Title != tc.wantTitle || stored.Done != tc.wantDone {
+				t.Errorf("%s: stored title %q done %t, want title %q done %t", what, stored.Title, stored.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
+
+func TestDeleteTodo(t *testing.T) {
+	t.Run("existing todo", func(t *testing.T) {
+		h, s := newFixture()
+		td := seedTodo(t, s, "milk")
+		path := "/todos/" + td.ID
+
+		rec := do(h, http.MethodDelete, path, "")
+		if rec.Code != http.StatusNoContent {
+			t.Fatalf("DELETE %s: status = %d, want %d; body %q", path, rec.Code, http.StatusNoContent, rec.Body.String())
+		}
+		if rec.Body.Len() != 0 {
+			t.Errorf("DELETE %s: body = %q, want empty", path, rec.Body.String())
+		}
+		assertError(t, "GET "+path+" after DELETE", do(h, http.MethodGet, path, ""), http.StatusNotFound)
+		assertError(t, "second DELETE "+path, do(h, http.MethodDelete, path, ""), http.StatusNotFound)
+	})
+	t.Run("unknown id", func(t *testing.T) {
+		h, _ := newFixture()
+		assertError(t, "DELETE /todos/nope", do(h, http.MethodDelete, "/todos/nope", ""), http.StatusNotFound)
+	})
+}
+
+func TestRoutingErrors(t *testing.T) {
+	tests := []struct {
+		name       string
+		method     string
+		path       string
+		wantStatus int
+		wantAllow  string
+	}{
+		{name: "unknown path", method: http.MethodGet, path: "/nope", wantStatus: http.StatusNotFound},
+		{name: "root", method: http.MethodGet, path: "/", wantStatus: http.StatusNotFound},
+		{name: "trailing slash on collection", method: http.MethodGet, path: "/todos/", wantStatus: http.StatusNotFound},
+		{name: "PUT on collection", method: http.MethodPut, path: "/todos", wantStatus: http.StatusMethodNotAllowed, wantAllow: "GET, POST"},
+		{name: "DELETE on collection", method: http.MethodDelete, path: "/todos", wantStatus: http.StatusMethodNotAllowed, wantAllow: "GET, POST"},
+		{name: "POST on item", method: http.MethodPost, path: "/todos/abc", wantStatus: http.StatusMethodNotAllowed, wantAllow: "GET, PATCH, DELETE"},
+		{name: "PUT on item", method: http.MethodPut, path: "/todos/abc", wantStatus: http.StatusMethodNotAllowed, wantAllow: "GET, PATCH, DELETE"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h, _ := newFixture()
+			what := tc.method + " " + tc.path
+			rec := do(h, tc.method, tc.path, "")
+			assertError(t, what, rec, tc.wantStatus)
+			if tc.wantAllow != "" {
+				if allow := rec.Header().Get("Allow"); allow != tc.wantAllow {
+					t.Errorf("%s: Allow = %q, want %q", what, allow, tc.wantAllow)
+				}
+			}
+		})
+	}
+}
