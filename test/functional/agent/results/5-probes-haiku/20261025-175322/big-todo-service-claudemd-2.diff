+++ b/cmd/server/main_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"flag"
+	"io"
+	"net/http"
+	"testing"
+	"time"
+)
+
+func TestParseFlags(t *testing.T) {
+	tests := []struct {
+		name     string
+		args     []string
+		wantAddr string
+		wantErr  bool
+	}{
+		{name: "defaults", args: nil, wantAddr: ":8080"},
+		{name: "addr", args: []string{"-addr", "127.0.0.1:9000"}, wantAddr: "127.0.0.1:9000"},
+		{name: "addr without value", args: []string{"-addr"}, wantErr: true},
+		{name: "unknown flag", args: []string{"-bogus"}, wantErr: true},
+		{name: "positional argument leaves the default addr", args: []string{"extra"}, wantAddr: ":8080"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg, err := parseFlags(tc.args, io.Discard)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("parseFlags(%q) error = %v, want error %t", tc.args, err, tc.wantErr)
+			}
+			if cfg.addr != tc.wantAddr {
+				t.Errorf("parseFlags(%q) addr = %q, want %q", tc.args, cfg.addr, tc.wantAddr)
+			}
+		})
+	}
+}
+
+func TestParseFlagsHelpReturnsErrHelp(t *testing.T) {
+	var usage bytes.Buffer
+	_, err := parseFlags([]string{"-h"}, &usage)
+	if !errors.Is(err, flag.ErrHelp) {
+		t.Errorf("parseFlags([-h]) error = %v, want %v", err, flag.ErrHelp)
+	}
+	if usage.Len() == 0 {
+		t.Error("parseFlags([-h]) wrote no usage text, want some")
+	}
+}
+
+func TestRunHelpIsNotAnError(t *testing.T) {
+	if err := run([]string{"-h"}, io.Discard, io.Discard); err != nil {
+		t.Errorf("run([-h]) error = %v, want nil", err)
+	}
+}
+
+func TestRunRejectsBadFlags(t *testing.T) {
+	if err := run([]string{"-bogus"}, io.Discard, io.Discard); err == nil {
+		t.Error("run([-bogus]) error = nil, want an error")
+	}
+}
+
+func TestNewServerSetsTimeouts(t *testing.T) {
+	srv := newServer("127.0.0.1:9000", http.NotFoundHandler())
+	if srv.Addr != "127.0.0.1:9000" {
+		t.Errorf("newServer addr = %q, want %q", srv.Addr, "127.0.0.1:9000")
+	}
+	if srv.Handler == nil {
+		t.Error("newServer handler = nil, want the handler it was given")
+	}
+	checks := []struct {
+		name string
+		got  time.Duration
+	}{
+		{"ReadHeaderTimeout", srv.ReadHeaderTimeout},
+		{"ReadTimeout", srv.ReadTimeout},
+		{"WriteTimeout", srv.WriteTimeout},
+		{"IdleTimeout", srv.IdleTimeout},
+	}
+	for _, c := range checks {
+		if c.got <= 0 {
+			t.Errorf("newServer %s = %v, want a positive timeout", c.name, c.got)
+		}
+	}
+}
diff --git a/internal/api/handler.go b/internal/api/handler.go
new file mode 100644
index 0000000..a6a9d71
--- /dev/null
+++ b/internal/api/handler.go
@@ -0,0 +1,100 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// maxBodyBytes caps the size of a request body.
+const maxBodyBytes = 1 << 20
+
+// errExtraValue means a request body holds more than one JSON value.
+var errExtraValue = errors.New("body holds more than one JSON value")
+
+// Handler serves the todo API. Use NewHandler to build one.
+type Handler struct {
+	store *todo.Store
+	mux   *http.ServeMux
+}
+
+// NewHandler returns a Handler that reads and writes todos in store.
+func NewHandler(store *todo.Store) *Handler {
+	h := &Handler{store: store, mux: http.NewServeMux()}
+	h.mux.HandleFunc("POST /todos", h.createTodo)
+	h.mux.HandleFunc("GET /todos", h.listTodos)
+	h.mux.HandleFunc("GET /todos/{id}", h.getTodo)
+	h.mux.HandleFunc("PATCH /todos/{id}", h.updateTodo)
+	h.mux.HandleFunc("DELETE /todos/{id}", h.deleteTodo)
+	// Method-less patterns answer every other method on these paths with 405, as JSON.
+	h.mux.HandleFunc("/todos", methodNotAllowed("GET, POST"))
+	h.mux.HandleFunc("/todos/{id}", methodNotAllowed("GET, PATCH, DELETE"))
+	h.mux.HandleFunc("/", func(w http.ResponseWriter, _ *http.Request) {
+		Error(w, http.StatusNotFound, "not found")
+	})
+	return h
+}
+
+// ServeHTTP routes the request to the matching handler.
+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	h.mux.ServeHTTP(w, r)
+}
+
+// methodNotAllowed returns a handler that answers 405 and lists the allowed methods in the Allow header.
+func methodNotAllowed(allow string) http.HandlerFunc {
+	return func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Allow", allow)
+		Error(w, http.StatusMethodNotAllowed, "method not allowed")
+	}
+}
+
+// decodeBody reads one JSON object from the request body into v. It rejects unknown fields and bodies over maxBodyBytes.
+func decodeBody(w http.ResponseWriter, r *http.Request, v any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, maxBodyBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(v); err != nil {
+		return err
+	}
+	var extra json.RawMessage
+	switch err := dec.Decode(&extra); {
+	case errors.Is(err, io.EOF):
+		return nil
+	case err == nil:
+		return errExtraValue
+	default:
+		return err
+	}
+}
+
+// writeBodyError answers a request body that decodeBody rejected.
+func writeBodyError(w http.ResponseWriter, err error) {
+	var tooBig *http.MaxBytesError
+	if errors.As(err, &tooBig) {
+		Error(w, http.StatusRequestEntityTooLarge, "request body must be 1 MiB or less")
+		return
+	}
+	Error(w, http.StatusBadRequest, "body must be one JSON object with only the known fields")
+}
+
+// writeStoreError answers a failed store call. Unexpected failures are logged and answered with a fixed message.
+func writeStoreError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, todo.ErrNotFound):
+		Error(w, http.StatusNotFound, "todo not found")
+	case errors.Is(err, todo.ErrInvalidTitle):
+		Error(w, http.StatusBadRequest, fmt.Sprintf("title must be 1 to %d characters after trimming spaces", todo.MaxTitleLen))
+	case errors.Is(err, todo.ErrNoChanges):
+		Error(w, http.StatusBadRequest, "body must include a title, a done flag, or both")
+	case errors.Is(err, todo.ErrInvalidPage):
+		Error(w, http.StatusBadRequest, fmt.Sprintf("limit must be 1 to %d and offset 0 or more", todo.MaxPageLimit))
+	default:
+		log.Error("todo store failed", "err", err)
+		Error(w, http.StatusInternalServerError, "internal error, try again later")
+	}
+}
