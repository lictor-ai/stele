+func TestUpdateSetsUpdatedAt(t *testing.T) {
+	ctx := context.Background()
+	clk := &settableClock{now: t0}
+	s := todo.NewStore(clk)
+	created, err := s.Create(ctx, "milk")
+	if err != nil {
+		t.Fatalf("Create(%q) error = %v, want nil", "milk", err)
+	}
+
+	t1 := t0.Add(time.Hour)
+	clk.now = t1
+	got, err := s.Update(ctx, created.ID, todo.Patch{Done: ptr(true)})
+	if err != nil {
+		t.Fatalf("Update(%q) error = %v, want nil", created.ID, err)
+	}
+	if !got.CreatedAt.Equal(t0) {
+		t.Errorf("Update(%q) CreatedAt = %v, want %v (unchanged)", created.ID, got.CreatedAt, t0)
+	}
+	if !got.UpdatedAt.Equal(t1) {
+		t.Errorf("Update(%q) UpdatedAt = %v, want %v", created.ID, got.UpdatedAt, t1)
+	}
+}
