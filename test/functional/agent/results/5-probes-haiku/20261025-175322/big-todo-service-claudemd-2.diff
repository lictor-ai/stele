+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		found     bool // use the id of the seeded todo
+		patch     todo.Patch
+		wantTitle string
+		wantDone  bool
+		wantErr   error
+	}{
+		{name: "title only", found: true, patch: todo.Patch{Title: ptr("renamed")}, wantTitle: "renamed"},
+		{name: "done only", found: true, patch: todo.Patch{Done: ptr(true)}, wantTitle: "milk", wantDone: true},
+		{name: "both, title trimmed", found: true, patch: todo.Patch{Title: ptr("  eggs "), Done: ptr(true)}, wantTitle: "eggs", wantDone: true},
+		{name: "empty patch", found: true, patch: todo.Patch{}, wantErr: todo.ErrNoChanges},
+		{name: "blank title", found: true, patch: todo.Patch{Title: ptr("  ")}, wantErr: todo.ErrInvalidTitle},
+		{name: "title too long", found: true, patch: todo.Patch{Title: ptr(strings.Repeat("a", todo.MaxTitleLen+1))}, wantErr: todo.ErrInvalidTitle},
+		{name: "unknown id", found: false, patch: todo.Patch{Done: ptr(true)}, wantErr: todo.ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			s := newStore()
+			base := seed(t, s, "milk")[0]
+			id := "missing"
+			if tc.found {
+				id = base.ID
+			}
+			got, err := s.Update(ctx, id, tc.patch)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Update(%q) error = %v, want %v", id, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				return
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%q) = title %q done %t, want title %q done %t", id, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			stored, err := s.Get(ctx, id)
+			if err != nil {
+				t.Fatalf("Get(%q) after Update error = %v, want nil", id, err)
+			}
+			if stored.Title != tc.wantTitle || stored.Done != tc.wantDone {
+				t.Errorf("Get(%q) after Update = title %q done %t, want title %q done %t", id, stored.Title, stored.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
