+			if tc.wantErr != nil {
+				return
+			}
+			if gotTitles := titlesOf(got); !slices.Equal(gotTitles, tc.wantTitles) {
+				t.Errorf("List(%+v) titles = %q, want %q", tc.opts, gotTitles, tc.wantTitles)
