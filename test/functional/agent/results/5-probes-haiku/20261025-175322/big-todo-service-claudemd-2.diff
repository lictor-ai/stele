+// Package todo holds the todo model and an in-memory store for it.
+package todo
+
+import (
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const (
+	// MaxTitleLen is the longest allowed title, in characters, after trimming spaces.
+	MaxTitleLen = 200
+
+	// DefaultPageLimit is the page size used when a list request sets no limit.
+	DefaultPageLimit = 20
+
+	// MaxPageLimit is the largest page size a list request may ask for.
+	MaxPageLimit = 100
+)
+
+// Todo is one item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// ValidateTitle trims spaces from s and returns the result. It returns ErrInvalidTitle when the result is empty or longer than MaxTitleLen characters.
+func ValidateTitle(s string) (string, error) {
+	t := strings.TrimSpace(s)
+	if n := utf8.RuneCountInString(t); n == 0 || n > MaxTitleLen {
+		return "", ErrInvalidTitle
+	}
+	return t, nil
+}
