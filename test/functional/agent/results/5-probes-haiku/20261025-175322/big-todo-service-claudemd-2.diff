+func TestStoreConcurrentUse(t *testing.T) {
+	const workers = 8
+	const perWorker = 50
+	ctx := context.Background()
+	s := newStore()
+
+	// ids[w][i] is the id of the i-th todo that worker w created. Each worker writes only its own row.
+	ids := make([][]string, workers)
+	var writers sync.WaitGroup
+	for w := range workers {
+		writers.Add(1)
+		go func() {
+			defer writers.Done()
+			for i := range perWorker {
+				td, err := s.Create(ctx, fmt.Sprintf("worker %d item %d", w, i))
+				if err != nil {
+					t.Errorf("Create by worker %d item %d error = %v, want nil", w, i, err)
+					return
+				}
+				ids[w] = append(ids[w], td.ID)
+				if i%2 == 0 {
+					if _, err := s.Update(ctx, td.ID, todo.Patch{Done: ptr(true)}); err != nil {
+						t.Errorf("Update by worker %d item %d error = %v, want nil", w, i, err)
+						return
+					}
+				}
+				if i%5 == 4 {
+					if err := s.Delete(ctx, td.ID); err != nil {
+						t.Errorf("Delete by worker %d item %d error = %v, want nil", w, i, err)
+						return
+					}
+				}
+			}
+		}()
+	}
+
+	stop := make(chan struct{})
+	var readers sync.WaitGroup
+	for range 4 {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				if _, err := s.List(ctx, todo.ListOptions{Limit: todo.MaxPageLimit, Done: ptr(false)}); err != nil {
+					t.Errorf("List during writes error = %v, want nil", err)
+					return
+				}
+			}
+		}()
+	}
+
+	writers.Wait()
+	close(stop)
+	readers.Wait()
+
+	// Every item except the deleted ones (i%5 == 4) must be live, with Done set for even i.
+	wantLive := map[string]bool{}
+	seen := map[string]bool{}
+	for w := range workers {
+		for i, id := range ids[w] {
+			if seen[id] {
+				t.Errorf("worker %d item %d reused id %q", w, i, id)
+			}
+			seen[id] = true
+			if i%5 == 4 {
+				continue
+			}
+			wantLive[id] = i%2 == 0
+		}
+	}
+
+	gotLive := map[string]bool{}
+	for _, td := range listAll(t, s) {
+		if _, dup := gotLive[td.ID]; dup {
+			t.Errorf("List returned id %q twice", td.ID)
+		}
+		gotLive[td.ID] = td.Done
+	}
+	if len(gotLive) != len(wantLive) {
+		t.Errorf("live todos = %d, want %d", len(gotLive), len(wantLive))
+	}
+	for id, wantDone := range wantLive {
+		gotDone, ok := gotLive[id]
+		switch {
+		case !ok:
+			t.Errorf("todo %q missing from List, want it live", id)
+		case gotDone != wantDone:
+			t.Errorf("todo %q Done = %t, want %t", id, gotDone, wantDone)
+		}
+	}
+}
