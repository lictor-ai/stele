+func TestCanceledContextIsReported(t *testing.T) {
+	ops := []struct {
+		name string
+		run  func(ctx context.Context, s *todo.Store) error
+	}{
+		{"Create", func(ctx context.Context, s *todo.Store) error { _, err := s.Create(ctx, "x"); return err }},
+		{"Get", func(ctx context.Context, s *todo.Store) error { _, err := s.Get(ctx, "x"); return err }},
+		{"Update", func(ctx context.Context, s *todo.Store) error {
+			_, err := s.Update(ctx, "x", todo.Patch{Done: ptr(true)})
+			return err
+		}},
+		{"Delete", func(ctx context.Context, s *todo.Store) error { return s.Delete(ctx, "x") }},
+		{"List", func(ctx context.Context, s *todo.Store) error {
+			_, err := s.List(ctx, todo.ListOptions{Limit: 1})
+			return err
+		}},
+	}
+	for _, op := range ops {
+		t.Run(op.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			if err := op.run(ctx, newStore()); !errors.Is(err, context.Canceled) {
+				t.Errorf("%s with canceled context error = %v, want %v", op.name, err, context.Canceled)
+			}
+		})
+	}
+}
