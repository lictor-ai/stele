+++ b/internal/api/todos.go
@@ -0,0 +1,130 @@
+package api
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"strconv"
+
+	"example.com/app/internal/todo"
+)
+
+// createRequest is the body of POST /todos.
+type createRequest struct {
+	Title string `json:"title"`
+}
+
+// updateRequest is the body of PATCH /todos/{id}. A nil field leaves that field unchanged.
+type updateRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+// createTodo handles POST /todos.
+func (h *Handler) createTodo(w http.ResponseWriter, r *http.Request) {
+	var in createRequest
+	if err := decodeBody(w, r, &in); err != nil {
+		writeBodyError(w, err)
+		return
+	}
+	td, err := h.store.Create(r.Context(), in.Title)
+	if err != nil {
+		writeStoreError(w, err)
+		return
+	}
+	w.Header().Set("Location", "/todos/"+td.ID)
+	JSON(w, http.StatusCreated, td)
+}
+
+// listTodos handles GET /todos.
+func (h *Handler) listTodos(w http.ResponseWriter, r *http.Request) {
+	opts, problem := parseListOptions(r.URL.Query())
+	if problem != "" {
+		Error(w, http.StatusBadRequest, problem)
+		return
+	}
+	list, err := h.store.List(r.Context(), opts)
+	if err != nil {
+		writeStoreError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, list)
+}
+
+// getTodo handles GET /todos/{id}.
+func (h *Handler) getTodo(w http.ResponseWriter, r *http.Request) {
+	td, err := h.store.Get(r.Context(), r.PathValue("id"))
+	if err != nil {
+		writeStoreError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, td)
+}
+
+// updateTodo handles PATCH /todos/{id}.
+func (h *Handler) updateTodo(w http.ResponseWriter, r *http.Request) {
+	var in updateRequest
+	if err := decodeBody(w, r, &in); err != nil {
+		writeBodyError(w, err)
+		return
+	}
+	td, err := h.store.Update(r.Context(), r.PathValue("id"), todo.Patch{Title: in.Title, Done: in.Done})
+	if err != nil {
+		writeStoreError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, td)
+}
+
+// deleteTodo handles DELETE /todos/{id}.
+func (h *Handler) deleteTodo(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.Context(), r.PathValue("id")); err != nil {
+		writeStoreError(w, err)
+		return
+	}
+	NoContent(w)
+}
+
+// parseListOptions reads the done, limit and offset query parameters. Missing parameters take their defaults. It returns a message the client can read when a parameter is bad, or "" when all of them are valid.
+func parseListOptions(q url.Values) (todo.ListOptions, string) {
+	opts := todo.ListOptions{Limit: todo.DefaultPageLimit}
+	if q.Has("done") {
+		done, ok := parseBool(q.Get("done"))
+		if !ok {
+			return opts, "done must be true or false"
+		}
+		opts.Done = &done
+	}
+	if q.Has("limit") {
+		n, err := strconv.Atoi(q.Get("limit"))
+		if err != nil {
+			return opts, fmt.Sprintf("limit must be a whole number from 1 to %d", todo.MaxPageLimit)
+		}
+		if n < 1 || n > todo.MaxPageLimit {
+			return opts, fmt.Sprintf("limit must be a whole number from 1 to %d", todo.MaxPageLimit)
+		}
+		opts.Limit = n
+	}
+	if q.Has("offset") {
+		n, err := strconv.Atoi(q.Get("offset"))
+		if err != nil {
+			return opts, "offset must be a whole number, 0 or more"
+		}
+		if n < 0 {
+			return opts, "offset must be a whole number, 0 or more"
+		}
+		opts.Offset = n
+	}
+	return opts, ""
+}
+
+// parseBool reads "true" or "false". The second result is false for any other input.
+func parseBool(s string) (bool, bool) {
+	switch s {
+	case "true":
+		return true, true
+	case "false":
+		return false, true
+	}
+	return false, false
+}
