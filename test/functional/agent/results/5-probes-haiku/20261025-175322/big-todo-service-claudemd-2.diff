+package todo
+
+import "errors"
+
+// ErrNotFound means no todo has the id that was asked for.
+var ErrNotFound = errors.New("todo not found")
+
+// ErrInvalidTitle means the title is empty, or longer than MaxTitleLen characters, after trimming spaces.
+var ErrInvalidTitle = errors.New("invalid title")
+
+// ErrInvalidPage means the limit or offset of a list request is out of range.
+var ErrInvalidPage = errors.New("invalid page")
+
+// ErrNoChanges means an update set neither a title nor a done flag.
+var ErrNoChanges = errors.New("no changes")
diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..94093a4
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,147 @@
+package todo
+
+import (
+	"context"
+	"slices"
+	"sync"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Store keeps todos in memory. It is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	mu    sync.RWMutex
+	byID  map[string]Todo // guarded by mu
+	order []string        // ids in creation order, guarded by mu
+}
+
+// NewStore returns an empty Store that reads the time from clk.
+func NewStore(clk clock.Clock) *Store {
+	return &Store{clock: clk, byID: make(map[string]Todo)}
+}
+
+// Patch is a partial update. A nil field leaves that field unchanged.
+type Patch struct {
+	Title *string
+	Done  *bool
+}
+
+// ListOptions selects one page of todos. A nil Done returns open and done todos alike.
+type ListOptions struct {
+	Done   *bool
+	Limit  int
+	Offset int
+}
+
+// Create adds a todo with the given title and returns it. The title is trimmed and must pass ValidateTitle.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	t, err := ValidateTitle(title)
+	if err != nil {
+		return Todo{}, err
+	}
+	now := s.clock.Now().UTC()
+	td := Todo{ID: id.New(), Title: t, CreatedAt: now, UpdatedAt: now}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.byID[td.ID] = td
+	s.order = append(s.order, td.ID)
+	return td, nil
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(ctx context.Context, todoID string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	td, ok := s.byID[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return td, nil
+}
+
+// Update changes the fields set in p and returns the todo. It returns ErrNotFound for an unknown id, ErrNoChanges when p sets no field, and ErrInvalidTitle for a bad title.
+func (s *Store) Update(ctx context.Context, todoID string, p Patch) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	if p.Title == nil && p.Done == nil {
+		return Todo{}, ErrNoChanges
+	}
+	var title string
+	if p.Title != nil {
+		t, err := ValidateTitle(*p.Title)
+		if err != nil {
+			return Todo{}, err
+		}
+		title = t
+	}
+	now := s.clock.Now().UTC()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	td, ok := s.byID[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if p.Title != nil {
+		td.Title = title
+	}
+	if p.Done != nil {
+		td.Done = *p.Done
+	}
+	td.UpdatedAt = now
+	s.byID[todoID] = td
+	return td, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(ctx context.Context, todoID string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.byID[todoID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.byID, todoID)
+	i := slices.Index(s.order, todoID)
+	s.order = slices.Delete(s.order, i, i+1)
+	return nil
+}
+
+// List returns one page of todos, newest first. Limit must be 1 to MaxPageLimit and Offset must be 0 or more; otherwise List returns ErrInvalidPage. The result is never nil.
+func (s *Store) List(ctx context.Context, opts ListOptions) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if opts.Limit < 1 || opts.Limit > MaxPageLimit || opts.Offset < 0 {
+		return nil, ErrInvalidPage
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := make([]Todo, 0, opts.Limit)
+	skipped := 0
+	for i := len(s.order) - 1; i >= 0 && len(out) < opts.Limit; i-- {
+		td := s.byID[s.order[i]]
+		if opts.Done != nil && td.Done != *opts.Done {
+			continue
+		}
+		if skipped < opts.Offset {
+			skipped++
+			continue
+		}
+		out = append(out, td)
+	}
+	return out, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..4a0eca5
