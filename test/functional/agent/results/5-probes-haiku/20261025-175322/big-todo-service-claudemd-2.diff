+func TestDelete(t *testing.T) {
+	tests := []struct {
+		name       string
+		found      bool // delete the seeded "milk" todo; otherwise delete an unknown id
+		wantErr    error
+		wantTitles []string // newest first, after the delete
+	}{
+		{name: "found", found: true, wantTitles: []string{"eggs"}},
+		{name: "unknown id", wantErr: todo.ErrNotFound, wantTitles: []string{"eggs", "milk"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			s := newStore()
+			base := seed(t, s, "milk", "eggs")
+			id := "missing"
+			if tc.found {
+				id = base[0].ID
+			}
+			err := s.Delete(ctx, id)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Delete(%q) error = %v, want %v", id, err, tc.wantErr)
+			}
+			if got := titlesOf(listAll(t, s)); !slices.Equal(got, tc.wantTitles) {
+				t.Errorf("after Delete(%q), titles = %q, want %q", id, got, tc.wantTitles)
+			}
+			if tc.found {
+				if _, err := s.Get(ctx, id); !errors.Is(err, todo.ErrNotFound) {
+					t.Errorf("Get(%q) after Delete error = %v, want %v", id, err, todo.ErrNotFound)
+				}
+				if err := s.Delete(ctx, id); !errors.Is(err, todo.ErrNotFound) {
+					t.Errorf("second Delete(%q) error = %v, want %v", id, err, todo.ErrNotFound)
+				}
+			}
+		})
+	}
+}
