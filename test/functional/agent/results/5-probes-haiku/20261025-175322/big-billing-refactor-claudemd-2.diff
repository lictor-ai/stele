diff --git a/internal/billing/discount.go b/internal/billing/discount.go
new file mode 100644
index 0000000..c92494c
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,101 @@
+package billing
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+)
+
+// DiscountKind says how a discount code reduces an invoice.
+type DiscountKind int
+
+const (
+	// PercentOff takes a share of the subtotal. Value is in basis points.
+	PercentOff DiscountKind = iota + 1
+	// FixedOff takes a fixed amount off the subtotal. Value is in cents.
+	FixedOff
+)
+
+// Discount is a code a customer can enter to reduce an invoice.
+type Discount struct {
+	Code      string
+	Kind      DiscountKind
+	Value     int64
+	ExpiresAt time.Time // zero means the code never expires
+}
+
+// Validate returns an error wrapping ErrInvalidDiscount if the code is
+// malformed.
+func (d Discount) Validate() error {
+	if d.Code == "" {
+		return fmt.Errorf("code is empty: %w", ErrInvalidDiscount)
+	}
+	switch d.Kind {
+	case PercentOff:
+		if d.Value <= 0 || d.Value > basisPointsTotal {
+			return fmt.Errorf("code %q: percent %d bps is outside 1 to 10000: %w", d.Code, d.Value, ErrInvalidDiscount)
+		}
+	case FixedOff:
+		if d.Value <= 0 {
+			return fmt.Errorf("code %q: fixed amount %d cents is not positive: %w", d.Code, d.Value, ErrInvalidDiscount)
+		}
+	default:
+		return fmt.Errorf("code %q: unknown kind %d: %w", d.Code, d.Kind, ErrInvalidDiscount)
+	}
+	return nil
+}
+
+// amountOff returns the cents the discount takes from subtotal. The result
+// never exceeds subtotal, so the invoice cannot go below zero. The subtotal
+// must not be negative.
+func (d Discount) amountOff(subtotal int64) (int64, error) {
+	if d.Kind == FixedOff {
+		return min(d.Value, subtotal), nil
+	}
+	off, err := percentOf(subtotal, d.Value)
+	if err != nil {
+		return 0, fmt.Errorf("discount %q: %w", d.Code, err)
+	}
+	return min(off, subtotal), nil
+}
+
+// Redeemer records that a customer has used a discount code. Redeem returns
+// an error wrapping ErrCodeUsed if the customer already used the code.
+type Redeemer interface {
+	Redeem(ctx context.Context, code, customer string) error
+}
+
+// redemption is the key for one customer's use of one code.
+type redemption struct {
+	code     string
+	customer string
+}
+
+// MemoryRedeemer is an in-process Redeemer. It loses its state when the
+// process exits. It is safe for concurrent use.
+type MemoryRedeemer struct {
+	mu   sync.Mutex          // guards used
+	used map[redemption]bool // keys are redemptions a customer has made
+}
+
+// NewMemoryRedeemer returns an empty MemoryRedeemer.
+func NewMemoryRedeemer() *MemoryRedeemer {
+	return &MemoryRedeemer{used: make(map[redemption]bool)}
+}
+
+// Redeem marks code as used by customer. It returns an error wrapping
+// ErrCodeUsed if the customer already used it.
+func (m *MemoryRedeemer) Redeem(ctx context.Context, code, customer string) error {
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("redeem %q: %w", code, err)
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	k := redemption{code: code, customer: customer}
+	if m.used[k] {
+		return fmt.Errorf("redeem %q for %q: %w", code, customer, ErrCodeUsed)
+	}
+	m.used[k] = true
+	return nil
+}
diff --git a/internal/billing/discount_test.go b/internal/billing/discount_test.go
new file mode 100644
index 0000000..0b67a75
--- /dev/null
+++ b/internal/billing/discount_test.go
@@ -0,0 +1,99 @@
+package billing
+
+import (
+	"context"
+	"errors"
+	"math"
+	"testing"
+)
+
+func TestPercentOf(t *testing.T) {
+	tests := []struct {
+		name    string
+		amount  int64
+		bps     int64
+		want    int64
+		wantErr error
+	}{
+		{name: "zero amount", amount: 0, bps: 1000, want: 0},
+		{name: "zero rate", amount: 1000, bps: 0, want: 0},
+		{name: "exact", amount: 1000, bps: 1000, want: 100},
+		{name: "whole hundred percent", amount: 9999, bps: 10000, want: 9999},
+		{name: "half rounds up", amount: 1005, bps: 1000, want: 101},
+		{name: "below half rounds down", amount: 1004, bps: 1000, want: 100},
+		{name: "one cent at half rounds up", amount: 1, bps: 5000, want: 1},
+		{name: "one cent below half rounds down", amount: 1, bps: 4999, want: 0},
+		{name: "third of a cent rounds down", amount: 7, bps: 3333, want: 2},
+		{name: "overflow", amount: math.MaxInt64, bps: 10000, wantErr: ErrOverflow},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := percentOf(tt.amount, tt.bps)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("percentOf(%d, %d) error = %v, want %v", tt.amount, tt.bps, err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("percentOf(%d, %d) = %d, want %d", tt.amount, tt.bps, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestDiscountValidate(t *testing.T) {
+	tests := []struct {
+		name    string
+		d       Discount
+		wantErr error
+	}{
+		{name: "empty code", d: Discount{Kind: FixedOff, Value: 1}, wantErr: ErrInvalidDiscount},
+		{name: "unknown kind", d: Discount{Code: "X", Kind: 0, Value: 1}, wantErr: ErrInvalidDiscount},
+		{name: "percent zero", d: Discount{Code: "X", Kind: PercentOff, Value: 0}, wantErr: ErrInvalidDiscount},
+		{name: "percent above 100", d: Discount{Code: "X", Kind: PercentOff, Value: 10001}, wantErr: ErrInvalidDiscount},
+		{name: "percent 100 is allowed", d: Discount{Code: "X", Kind: PercentOff, Value: 10000}},
+		{name: "fixed zero", d: Discount{Code: "X", Kind: FixedOff, Value: 0}, wantErr: ErrInvalidDiscount},
+		{name: "fixed negative", d: Discount{Code: "X", Kind: FixedOff, Value: -5}, wantErr: ErrInvalidDiscount},
+		{name: "fixed one cent", d: Discount{Code: "X", Kind: FixedOff, Value: 1}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.d.Validate()
+			if !errors.Is(err, tt.wantErr) {
+				t.Errorf("Validate(%+v) error = %v, want %v", tt.d, err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestMemoryRedeemer(t *testing.T) {
+	ctx := context.Background()
+	m := NewMemoryRedeemer()
+
+	steps := []struct {
+		name     string
+		code     string
+		customer string
+		wantErr  error
+	}{
+		{name: "first use", code: "SAVE10", customer: "acme"},
+		{name: "same customer again", code: "SAVE10", customer: "acme", wantErr: ErrCodeUsed},
+		{name: "other customer", code: "SAVE10", customer: "globex"},
+		{name: "other code, same customer", code: "OFF5", customer: "acme"},
+	}
+	for _, s := range steps {
+		t.Run(s.name, func(t *testing.T) {
+			err := m.Redeem(ctx, s.code, s.customer)
+			if !errors.Is(err, s.wantErr) {
+				t.Errorf("Redeem(%q, %q) error = %v, want %v", s.code, s.customer, err, s.wantErr)
+			}
+		})
+	}
+
+	t.Run("cancelled context is not a use", func(t *testing.T) {
+		cctx, cancel := context.WithCancel(ctx)
+		cancel()
+		err := NewMemoryRedeemer().Redeem(cctx, "SAVE10", "initech")
+		if !errors.Is(err, context.Canceled) {
+			t.Errorf("Redeem with cancelled ctx error = %v, want %v", err, context.Canceled)
+		}
+	})
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
new file mode 100644
index 0000000..251ee0f
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,24 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrInvalidConfig means a Pricer was built with a missing dependency.
+	ErrInvalidConfig = errors.New("invalid billing config")
+	// ErrInvalidRequest means an invoice request failed validation.
+	ErrInvalidRequest = errors.New("invalid invoice request")
+	// ErrInvalidDiscount means a discount code is malformed.
+	ErrInvalidDiscount = errors.New("invalid discount code")
+	// ErrInvalidTaxRate means a tax rate is outside 0 to 100%.
+	ErrInvalidTaxRate = errors.New("invalid tax rate")
+	// ErrUnknownRegion means the request's region has no tax rate.
+	ErrUnknownRegion = errors.New("unknown tax region")
+	// ErrUnknownCode means the request's discount code does not exist.
+	ErrUnknownCode = errors.New("unknown discount code")
+	// ErrCodeExpired means the discount code is past its expiry time.
+	ErrCodeExpired = errors.New("discount code expired")
+	// ErrCodeUsed means the customer has already used the discount code.
+	ErrCodeUsed = errors.New("discount code already used by customer")
+	// ErrOverflow means an amount does not fit in int64 cents.
+	ErrOverflow = errors.New("amount overflows int64 cents")
+)
diff --git a/internal/billing/export.go b/internal/billing/export.go
new file mode 100644
index 0000000..a21e75a
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,43 @@
+package billing
+
+import (
+	"context"
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+	"time"
+)
+
+// WriteCSV writes invoices to w as CSV, with a header row. Amounts are in
+// cents and issued_at is RFC 3339. It stops early if ctx is done.
+func WriteCSV(ctx context.Context, w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	header := []string{"id", "customer", "region", "issued_at", "total_cents", "discount_cents", "tax_cents", "grand_total_cents"}
+	if err := cw.Write(header); err != nil {
+		return fmt.Errorf("write csv header: %w", err)
+	}
+	for _, inv := range invoices {
+		if err := ctx.Err(); err != nil {
+			return fmt.Errorf("write csv invoice %q: %w", inv.ID, err)
+		}
+		row := []string{
+			inv.ID,
+			inv.Customer,
+			inv.Region,
+			inv.IssuedAt.Format(time.RFC3339),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := cw.Write(row); err != nil {
+			return fmt.Errorf("write csv invoice %q: %w", inv.ID, err)
+		}
+	}
+	cw.Flush()
+	if err := cw.Error(); err != nil {
+		return fmt.Errorf("flush csv: %w", err)
+	}
+	return nil
+}
