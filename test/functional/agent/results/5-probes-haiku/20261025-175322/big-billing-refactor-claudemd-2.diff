index 0000000..2391ba8
--- /dev/null
+++ b/internal/billing/money.go
@@ -0,0 +1,31 @@
+package billing
+
+import (
+	"fmt"
+	"math"
+)
+
+// basisPointsTotal is 100% in basis points. 1% is 100 basis points.
+const basisPointsTotal = 10000
+
+// percentOf returns amount * bps / 10000, rounded half away from zero. The
+// caller must pass non-negative values.
+func percentOf(amount, bps int64) (int64, error) {
+	if amount == 0 || bps == 0 {
+		return 0, nil
+	}
+	if amount > math.MaxInt64/bps {
+		return 0, fmt.Errorf("%d at %d bps: %w", amount, bps, ErrOverflow)
+	}
+	return roundDiv(amount*bps, basisPointsTotal), nil
+}
+
+// roundDiv returns n / d rounded half away from zero. The caller must pass a
+// non-negative n and a positive d. It cannot overflow, unlike (n + d/2) / d.
+func roundDiv(n, d int64) int64 {
+	q, r := n/d, n%d
+	if 2*r >= d {
+		q++
+	}
+	return q
+}
diff --git a/internal/billing/pricer.go b/internal/billing/pricer.go
new file mode 100644
index 0000000..b14ef13
--- /dev/null
+++ b/internal/billing/pricer.go
@@ -0,0 +1,145 @@
+package billing
+
+import (
+	"context"
+	"fmt"
+	"maps"
+	"math"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// TaxTable maps a region code, such as "FR" or "US-CA", to its tax rate in
+// basis points.
+type TaxTable map[string]int64
+
+// Request is what Pricer.Invoice computes an invoice for.
+type Request struct {
+	ID           string
+	Customer     string
+	Region       string
+	Lines        []Line
+	DiscountCode string // optional; empty means no discount
+}
+
+// Pricer computes invoices with an optional discount and tax by region. Its
+// dependencies are fixed by NewPricer. It is safe for concurrent use if its
+// Redeemer is.
+type Pricer struct {
+	clock    clock.Clock
+	codes    map[string]Discount // read-only after NewPricer
+	taxes    TaxTable            // read-only after NewPricer
+	redeemer Redeemer
+}
+
+// NewPricer checks the discount codes and tax rates and returns a Pricer. It
+// copies both, so later changes by the caller do not affect the Pricer.
+func NewPricer(clk clock.Clock, codes []Discount, taxes TaxTable, redeemer Redeemer) (*Pricer, error) {
+	if clk == nil || redeemer == nil {
+		return nil, fmt.Errorf("NewPricer needs a clock and a redeemer: %w", ErrInvalidConfig)
+	}
+	byCode := make(map[string]Discount, len(codes))
+	for _, d := range codes {
+		if err := d.Validate(); err != nil {
+			return nil, err
+		}
+		if _, dup := byCode[d.Code]; dup {
+			return nil, fmt.Errorf("code %q listed twice: %w", d.Code, ErrInvalidDiscount)
+		}
+		byCode[d.Code] = d
+	}
+	for region, bps := range taxes {
+		if bps < 0 || bps > basisPointsTotal {
+			return nil, fmt.Errorf("region %q rate %d bps: %w", region, bps, ErrInvalidTaxRate)
+		}
+	}
+	return &Pricer{clock: clk, codes: byCode, taxes: maps.Clone(taxes), redeemer: redeemer}, nil
+}
+
+// Invoice validates req and computes its invoice. The discount is taken from
+// the subtotal once, and tax is charged once on what remains. A discount
+// code is redeemed last, so a request that fails validation does not use up
+// its code. Its errors wrap the sentinels in errors.go.
+func (p *Pricer) Invoice(ctx context.Context, req Request) (Invoice, error) {
+	if req.ID == "" {
+		return Invoice{}, fmt.Errorf("id is empty: %w", ErrInvalidRequest)
+	}
+	if req.Customer == "" {
+		return Invoice{}, fmt.Errorf("invoice %q has no customer: %w", req.ID, ErrInvalidRequest)
+	}
+	for i, l := range req.Lines {
+		if l.Quantity < 0 || l.UnitCents < 0 {
+			return Invoice{}, fmt.Errorf("invoice %q line %d is negative: %w", req.ID, i, ErrInvalidRequest)
+		}
+	}
+	rate, ok := p.taxes[req.Region]
+	if !ok {
+		return Invoice{}, fmt.Errorf("invoice %q region %q: %w", req.ID, req.Region, ErrUnknownRegion)
+	}
+	subtotal, err := sumLines(req.Lines)
+	if err != nil {
+		return Invoice{}, fmt.Errorf("invoice %q: %w", req.ID, err)
+	}
+
+	now := p.clock.Now()
+	inv := Invoice{
+		ID:         req.ID,
+		Customer:   req.Customer,
+		Region:     req.Region,
+		Lines:      req.Lines,
+		TotalCents: subtotal,
+		IssuedAt:   now,
+	}
+
+	var code Discount
+	if req.DiscountCode != "" {
+		code, ok = p.codes[req.DiscountCode]
+		if !ok {
+			return Invoice{}, fmt.Errorf("code %q: %w", req.DiscountCode, ErrUnknownCode)
+		}
+		if !code.ExpiresAt.IsZero() && !now.Before(code.ExpiresAt) {
+			return Invoice{}, fmt.Errorf("code %q expired at %s: %w", code.Code, code.ExpiresAt.Format(time.RFC3339), ErrCodeExpired)
+		}
+		off, err := code.amountOff(subtotal)
+		if err != nil {
+			return Invoice{}, fmt.Errorf("invoice %q: %w", req.ID, err)
+		}
+		inv.DiscountCode = code.Code
+		inv.DiscountCents = off
+	}
+
+	taxable := subtotal - inv.DiscountCents
+	tax, err := percentOf(taxable, rate)
+	if err != nil {
+		return Invoice{}, fmt.Errorf("invoice %q tax: %w", req.ID, err)
+	}
+	inv.TaxCents = tax
+	inv.GrandTotalCents = taxable + tax
+
+	if req.DiscountCode != "" {
+		if err := p.redeemer.Redeem(ctx, req.DiscountCode, req.Customer); err != nil {
+			return Invoice{}, fmt.Errorf("invoice %q: %w", req.ID, err)
+		}
+	}
+	return inv, nil
+}
+
+// sumLines returns the subtotal of lines in cents. It returns an error
+// wrapping ErrOverflow if the subtotal does not fit in int64. The lines must
+// not be negative.
+func sumLines(lines []Line) (int64, error) {
+	var total int64
+	for _, l := range lines {
+		q := int64(l.Quantity)
+		if l.UnitCents > 0 && q > math.MaxInt64/l.UnitCents {
+			return 0, fmt.Errorf("line %q: %w", l.SKU, ErrOverflow)
+		}
+		amount := q * l.UnitCents
+		if amount > math.MaxInt64-total {
+			return 0, fmt.Errorf("subtotal at line %q: %w", l.SKU, ErrOverflow)
+		}
+		total += amount
+	}
+	return total, nil
+}
