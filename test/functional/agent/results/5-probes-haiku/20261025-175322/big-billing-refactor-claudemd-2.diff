+package billing
+
+import (
+	"context"
+	"errors"
+	"math"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var testNow = time.Date(2026, 10, 1, 12, 0, 0, 0, time.UTC)
+
+// testCodes are the discount codes used by the pricer tests.
+func testCodes() []Discount {
+	return []Discount{
+		{Code: "SAVE10", Kind: PercentOff, Value: 1000},
+		{Code: "OFF5", Kind: FixedOff, Value: 500},
+		{Code: "OLD", Kind: PercentOff, Value: 1000, ExpiresAt: testNow.Add(-time.Hour)},
+		{Code: "EDGE", Kind: FixedOff, Value: 100, ExpiresAt: testNow},
+		{Code: "SOON", Kind: FixedOff, Value: 100, ExpiresAt: testNow.Add(time.Hour)},
+	}
+}
+
+// testTaxes are the regions used by the pricer tests.
+func testTaxes() TaxTable {
+	return TaxTable{"FR": 2000, "US-CA": 0, "TEN": 1000}
+}
+
+// oneLine returns an invoice with a single line of the given unit price.
+func oneLine(unit int64) []Line {
+	return []Line{{SKU: "a", Quantity: 1, UnitCents: unit}}
+}
+
+func newTestPricer(t *testing.T) *Pricer {
+	t.Helper()
+	p, err := NewPricer(clock.Fixed{T: testNow}, testCodes(), testTaxes(), NewMemoryRedeemer())
+	if err != nil {
+		t.Fatalf("NewPricer() error = %v", err)
+	}
+	return p
+}
+
+func TestNewPricer(t *testing.T) {
+	tests := []struct {
+		name    string
+		clk     clock.Clock
+		codes   []Discount
+		taxes   TaxTable
+		wantErr error
+	}{
+		{name: "nil clock", clk: nil, wantErr: ErrInvalidConfig},
+		{name: "empty config", clk: clock.Fixed{T: testNow}},
+		{name: "duplicate code", clk: clock.Fixed{T: testNow}, codes: []Discount{
+			{Code: "A", Kind: FixedOff, Value: 1},
+			{Code: "A", Kind: FixedOff, Value: 2},
+		}, wantErr: ErrInvalidDiscount},
+		{name: "invalid code", clk: clock.Fixed{T: testNow}, codes: []Discount{
+			{Code: "A", Kind: PercentOff, Value: 0},
+		}, wantErr: ErrInvalidDiscount},
+		{name: "negative tax rate", clk: clock.Fixed{T: testNow}, taxes: TaxTable{"FR": -1}, wantErr: ErrInvalidTaxRate},
+		{name: "tax rate above 100 percent", clk: clock.Fixed{T: testNow}, taxes: TaxTable{"FR": 10001}, wantErr: ErrInvalidTaxRate},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := NewPricer(tt.clk, tt.codes, tt.taxes, NewMemoryRedeemer())
+			if !errors.Is(err, tt.wantErr) {
+				t.Errorf("NewPricer() error = %v, want %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestPricerInvoice(t *testing.T) {
+	tests := []struct {
+		name         string
+		req          Request
+		wantDiscount int64
+		wantTax      int64
+		wantGrand    int64
+		wantErr      error
+	}{
+		{
+			name:    "no code, tax on subtotal",
+			req:     Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(1000)},
+			wantTax: 200, wantGrand: 1200,
+		},
+		{
+			name:         "percent code, tax on discounted total",
+			req:          Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(1000), DiscountCode: "SAVE10"},
+			wantDiscount: 100, wantTax: 180, wantGrand: 1080,
+		},
+		{
+			name:         "percent rounds half up",
+			req:          Request{ID: "i1", Customer: "acme", Region: "US-CA", Lines: oneLine(1005), DiscountCode: "SAVE10"},
+			wantDiscount: 101, wantTax: 0, wantGrand: 904,
+		},
+		{
+			name:         "percent rounds down below half",
+			req:          Request{ID: "i1", Customer: "acme", Region: "US-CA", Lines: oneLine(1004), DiscountCode: "SAVE10"},
+			wantDiscount: 100, wantTax: 0, wantGrand: 904,
+		},
+		{
+			name: "percent of zero subtotal",
+			req:  Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(0), DiscountCode: "SAVE10"},
+		},
+		{
+			name:         "fixed code floors at zero",
+			req:          Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(300), DiscountCode: "OFF5"},
+			wantDiscount: 300, wantTax: 0, wantGrand: 0,
+		},
+		{
+			name:         "fixed code exactly covers subtotal",
+			req:          Request{ID: "i1", Customer: "acme", Region: "US-CA", Lines: oneLine(500), DiscountCode: "OFF5"},
+			wantDiscount: 500, wantTax: 0, wantGrand: 0,
+		},
+		{
+			name:         "fixed code not yet expired",
+			req:          Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(1000), DiscountCode: "SOON"},
+			wantDiscount: 100, wantTax: 180, wantGrand: 1080,
+		},
+		{
+			name:    "expired code",
+			req:     Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(1000), DiscountCode: "OLD"},
+			wantErr: ErrCodeExpired,
+		},
+		{
+			name:    "code expires exactly now",
+			req:     Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(1000), DiscountCode: "EDGE"},
+			wantErr: ErrCodeExpired,
+		},
+		{
+			name:    "unknown code",
+			req:     Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(1000), DiscountCode: "NOPE"},
+			wantErr: ErrUnknownCode,
+		},
+		{
+			name:    "unknown region",
+			req:     Request{ID: "i1", Customer: "acme", Region: "XX", Lines: oneLine(1000)},
+			wantErr: ErrUnknownRegion,
+		},
+		{
+			name:    "missing customer",
+			req:     Request{ID: "i1", Region: "FR", Lines: oneLine(1000)},
+			wantErr: ErrInvalidRequest,
+		},
+		{
+			name:    "missing id",
+			req:     Request{Customer: "acme", Region: "FR", Lines: oneLine(1000)},
+			wantErr: ErrInvalidRequest,
+		},
+		{
+			name:    "negative quantity",
+			req:     Request{ID: "i1", Customer: "acme", Region: "FR", Lines: []Line{{SKU: "a", Quantity: -1, UnitCents: 100}}},
+			wantErr: ErrInvalidRequest,
+		},
+		{
+			name:    "negative unit price",
+			req:     Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(-100)},
+			wantErr: ErrInvalidRequest,
+		},
+		{
+			name:    "subtotal overflows",
+			req:     Request{ID: "i1", Customer: "acme", Region: "FR", Lines: []Line{{SKU: "a", Quantity: 2, UnitCents: math.MaxInt64}}},
+			wantErr: ErrOverflow,
+		},
+		{
+			name:    "tax rounds half up",
+			req:     Request{ID: "i1", Customer: "acme", Region: "TEN", Lines: oneLine(105)},
+			wantTax: 11, wantGrand: 116,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inv, err := newTestPricer(t).Invoice(context.Background(), tt.req)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Invoice(%q) error = %v, want %v", tt.req.ID, err, tt.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if inv.DiscountCents != tt.wantDiscount {
+				t.Errorf("Invoice(%q) discount = %d, want %d", tt.req.ID, inv.DiscountCents, tt.wantDiscount)
+			}
+			if inv.TaxCents != tt.wantTax {
+				t.Errorf("Invoice(%q) tax = %d, want %d", tt.req.ID, inv.TaxCents, tt.wantTax)
+			}
+			if inv.GrandTotalCents != tt.wantGrand {
+				t.Errorf("Invoice(%q) grand total = %d, want %d", tt.req.ID, inv.GrandTotalCents, tt.wantGrand)
+			}
+			if !inv.IssuedAt.Equal(testNow) {
+				t.Errorf("Invoice(%q) issued at = %s, want %s", tt.req.ID, inv.IssuedAt, testNow)
+			}
+		})
+	}
+}
+
+func TestPricerCodeReuse(t *testing.T) {
+	ctx := context.Background()
+	p := newTestPricer(t)
+	acme := Request{ID: "i1", Customer: "acme", Region: "FR", Lines: oneLine(1000), DiscountCode: "SAVE10"}
+
+	t.Run("first use applies", func(t *testing.T) {
+		if _, err := p.Invoice(ctx, acme); err != nil {
+			t.Fatalf("Invoice(first) error = %v, want nil", err)
+		}
+	})
+	t.Run("same customer again is refused", func(t *testing.T) {
+		acme.ID = "i2"
+		_, err := p.Invoice(ctx, acme)
+		if !errors.Is(err, ErrCodeUsed) {
+			t.Errorf("Invoice(second) error = %v, want %v", err, ErrCodeUsed)
+		}
+	})
+	t.Run("other customer can use it", func(t *testing.T) {
+		_, err := p.Invoice(ctx, Request{ID: "i3", Customer: "globex", Region: "FR", Lines: oneLine(1000), DiscountCode: "SAVE10"})
+		if err != nil {
+			t.Errorf("Invoice(other customer) error = %v, want nil", err)
+		}
+	})
+	t.Run("failed request does not use the code", func(t *testing.T) {
+		_, err := p.Invoice(ctx, Request{ID: "i4", Customer: "initech", Region: "XX", Lines: oneLine(1000), DiscountCode: "OFF5"})
+		if !errors.Is(err, ErrUnknownRegion) {
+			t.Fatalf("Invoice(bad region) error = %v, want %v", err, ErrUnknownRegion)
+		}
+		_, err = p.Invoice(ctx, Request{ID: "i5", Customer: "initech", Region: "FR", Lines: oneLine(1000), DiscountCode: "OFF5"})
+		if err != nil {
+			t.Errorf("Invoice(after failed request) error = %v, want nil", err)
+		}
+	})
+}
