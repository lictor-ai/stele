@@ -0,0 +1,124 @@
+package billing
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+const csvHeaderRow = "id,customer,region,issued_at,total_cents,discount_cents,tax_cents,grand_total_cents\n"
+
+// errWriter fails every write.
+type errWriter struct{}
+
+func (errWriter) Write([]byte) (int, error) { return 0, errTestWrite }
+
+var errTestWrite = errors.New("test write failure")
+
+func TestWriteCSV(t *testing.T) {
+	paris := time.FixedZone("CEST", 2*60*60)
+	tests := []struct {
+		name     string
+		invoices []Invoice
+		want     string
+	}{
+		{
+			name: "no invoices writes only the header",
+			want: csvHeaderRow,
+		},
+		{
+			name: "one invoice with discount and tax",
+			invoices: []Invoice{{
+				ID:              "i1",
+				Customer:        "acme",
+				Region:          "FR",
+				TotalCents:      1000,
+				DiscountCents:   100,
+				TaxCents:        180,
+				GrandTotalCents: 1080,
+				IssuedAt:        time.Date(2026, 10, 1, 12, 0, 0, 0, time.UTC),
+			}},
+			want: csvHeaderRow + "i1,acme,FR,2026-10-01T12:00:00Z,1000,100,180,1080\n",
+		},
+		{
+			name: "issued_at keeps its own offset",
+			invoices: []Invoice{{
+				ID:              "i2",
+				Customer:        "globex",
+				Region:          "DE",
+				TotalCents:      500,
+				GrandTotalCents: 500,
+				IssuedAt:        time.Date(2026, 10, 1, 9, 30, 0, 0, paris),
+			}},
+			want: csvHeaderRow + "i2,globex,DE,2026-10-01T09:30:00+02:00,500,0,0,500\n",
+		},
+		{
+			name: "customer with comma and quote is escaped",
+			invoices: []Invoice{{
+				ID:              "i3",
+				Customer:        `Acme, "Ltd"`,
+				Region:          "US-CA",
+				IssuedAt:        time.Date(2026, 10, 1, 0, 0, 0, 0, time.UTC),
+				GrandTotalCents: 0,
+			}},
+			want: csvHeaderRow + `i3,"Acme, ""Ltd""",US-CA,2026-10-01T00:00:00Z,0,0,0,0` + "\n",
+		},
+		{
+			name: "rows keep their order",
+			invoices: []Invoice{
+				{ID: "b", Customer: "x", IssuedAt: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)},
+				{ID: "a", Customer: "x", IssuedAt: time.Date(2026, 1, 2, 0, 0, 0, 0, time.UTC)},
+			},
+			want: csvHeaderRow +
+				"b,x,,2026-01-01T00:00:00Z,0,0,0,0\n" +
+				"a,x,,2026-01-02T00:00:00Z,0,0,0,0\n",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := WriteCSV(context.Background(), &buf, tt.invoices); err != nil {
+				t.Fatalf("WriteCSV() error = %v, want nil", err)
+			}
+			if got := buf.String(); got != tt.want {
+				t.Errorf("WriteCSV() =\n%q\nwant\n%q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestWriteCSVErrors(t *testing.T) {
+	tests := []struct {
+		name    string
+		ctx     func() context.Context
+		wantErr error
+	}{
+		{
+			name: "cancelled context stops before writing rows",
+			ctx: func() context.Context {
+				ctx, cancel := context.WithCancel(context.Background())
+				cancel()
+				return ctx
+			},
+			wantErr: context.Canceled,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			err := WriteCSV(tt.ctx(), &buf, []Invoice{{ID: "i1"}})
+			if !errors.Is(err, tt.wantErr) {
+				t.Errorf("WriteCSV() error = %v, want %v", err, tt.wantErr)
+			}
+		})
+	}
+
+	t.Run("writer failure is returned", func(t *testing.T) {
+		err := WriteCSV(context.Background(), errWriter{}, nil)
+		if !errors.Is(err, errTestWrite) {
+			t.Errorf("WriteCSV(failing writer) error = %v, want %v", err, errTestWrite)
+		}
+	})
+}
