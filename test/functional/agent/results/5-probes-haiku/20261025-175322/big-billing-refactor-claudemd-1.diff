@@ -0,0 +1,19 @@
+package billing
+
+import "errors"
+
+// ErrInvalidInput means a request, customer, line or tax rate is malformed.
+var ErrInvalidInput = errors.New("invalid input")
+
+// ErrUnknownRegion means the tax table has no rate for the invoice's region.
+var ErrUnknownRegion = errors.New("unknown region")
+
+// ErrInvalidDiscount means a discount code is not exactly one of a percentage
+// or a fixed amount, or has no code.
+var ErrInvalidDiscount = errors.New("invalid discount")
+
+// ErrDiscountExpired means a discount code was used at or after its expiry.
+var ErrDiscountExpired = errors.New("discount expired")
+
+// ErrDiscountUsed means the customer has already used this discount code.
+var ErrDiscountUsed = errors.New("discount already used by customer")
diff --git a/internal/billing/export.go b/internal/billing/export.go
new file mode 100644
index 0000000..b6957a1
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,42 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+	"time"
+)
+
+// WriteCSV writes invoices to w as CSV, with a header row. Columns are id,
+// customer, region, issued_at (RFC 3339, UTC), total_cents, discount_cents,
+// tax_cents and grand_total_cents. Amounts are integers in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	if err := cw.Write([]string{
+		"id", "customer", "region", "issued_at",
+		"total_cents", "discount_cents", "tax_cents", "grand_total_cents",
+	}); err != nil {
+		return fmt.Errorf("write csv header: %w", err)
+	}
+	for _, inv := range invoices {
+		row := []string{
+			inv.ID,
+			inv.Customer,
+			inv.Region,
+			inv.IssuedAt.UTC().Format(time.RFC3339),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := cw.Write(row); err != nil {
+			return fmt.Errorf("write csv row for invoice %s: %w", inv.ID, err)
+		}
+	}
+	cw.Flush()
+	if err := cw.Error(); err != nil {
+		return fmt.Errorf("flush csv: %w", err)
+	}
+	return nil
+}
diff --git a/internal/billing/export_test.go b/internal/billing/export_test.go
new file mode 100644
index 0000000..959f1e6
--- /dev/null
+++ b/internal/billing/export_test.go
@@ -0,0 +1,83 @@
+package billing
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+	"time"
+)
+
+// failWriter fails every write, to check that WriteCSV reports the error.
+type failWriter struct{}
+
+func (failWriter) Write([]byte) (int, error) { return 0, errors.New("disk full") }
+
+func TestWriteCSV(t *testing.T) {
+	issued := time.Date(2026, time.October, 25, 14, 30, 0, 0, time.FixedZone("CEST", 2*60*60))
+	tests := []struct {
+		name     string
+		invoices []Invoice
+		want     string
+	}{
+		{
+			name:     "no invoices writes only the header",
+			invoices: nil,
+			want:     "id,customer,region,issued_at,total_cents,discount_cents,tax_cents,grand_total_cents\n",
+		},
+		{
+			name: "one invoice in cents and UTC",
+			invoices: []Invoice{{
+				ID:              "inv1",
+				Customer:        "acme",
+				Region:          "FR",
+				IssuedAt:        issued,
+				TotalCents:      1000,
+				DiscountCents:   100,
+				TaxCents:        180,
+				GrandTotalCents: 1080,
+			}},
+			want: "id,customer,region,issued_at,total_cents,discount_cents,tax_cents,grand_total_cents\n" +
+				"inv1,acme,FR,2026-10-25T12:30:00Z,1000,100,180,1080\n",
+		},
+		{
+			name: "zero amounts are written as zero",
+			invoices: []Invoice{{
+				ID:       "inv2",
+				Customer: "beta",
+				Region:   "ZERO",
+				IssuedAt: time.Date(2026, time.January, 2, 3, 4, 5, 0, time.UTC),
+			}},
+			want: "id,customer,region,issued_at,total_cents,discount_cents,tax_cents,grand_total_cents\n" +
+				"inv2,beta,ZERO,2026-01-02T03:04:05Z,0,0,0,0\n",
+		},
+		{
+			name: "fields with commas and quotes are escaped",
+			invoices: []Invoice{{
+				ID:       "inv3",
+				Customer: `Acme, "Inc."`,
+				Region:   "US-CA",
+				IssuedAt: time.Date(2026, time.October, 25, 0, 0, 0, 0, time.UTC),
+			}},
+			want: "id,customer,region,issued_at,total_cents,discount_cents,tax_cents,grand_total_cents\n" +
+				`inv3,"Acme, ""Inc.""",US-CA,2026-10-25T00:00:00Z,0,0,0,0` + "\n",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := WriteCSV(&buf, tt.invoices); err != nil {
+				t.Fatalf("WriteCSV(%d invoices) error = %v", len(tt.invoices), err)
+			}
+			if got := buf.String(); got != tt.want {
+				t.Errorf("WriteCSV(%d invoices) = %q, want %q", len(tt.invoices), got, tt.want)
+			}
+		})
+	}
+}
+
+func TestWriteCSVReportsWriteError(t *testing.T) {
+	err := WriteCSV(failWriter{}, []Invoice{{ID: "inv1", Customer: "acme"}})
+	if err == nil {
+		t.Errorf("WriteCSV(failing writer) error = nil, want an error")
+	}
+}
diff --git a/internal/billing/money.go b/internal/billing/money.go
new file mode 100644
index 0000000..be806c7
--- /dev/null
+++ b/internal/billing/money.go
@@ -0,0 +1,39 @@
+package billing
+
+import (
+	"fmt"
+	"math"
+)
+
+// bpsDenom is the number of basis points in 100%: 1% = 100 bps.
+const bpsDenom = 10000
+
+// maxCents is the largest amount an invoice can hold.
+const maxCents = math.MaxInt64
+
+// mulCents returns a*b for non-negative a and b, or ErrInvalidInput if the
+// product would overflow int64.
+func mulCents(a, b int64) (int64, error) {
+	if a < 0 || b < 0 {
+		return 0, fmt.Errorf("negative amount %d * %d: %w", a, b, ErrInvalidInput)
+	}
+	if a != 0 && b > maxCents/a {
+		return 0, fmt.Errorf("amount %d * %d overflows: %w", a, b, ErrInvalidInput)
+	}
+	return a * b, nil
+}
+
+// roundBps returns amount scaled by bps basis points, rounded half away from
+// zero. Both arguments must be non-negative, so half away from zero is half up.
+// Call it once per calculation, at the end.
+func roundBps(amount, bps int64) (int64, error) {
+	num, err := mulCents(amount, bps)
+	if err != nil {
+		return 0, err
+	}
+	q, r := num/bpsDenom, num%bpsDenom
+	if 2*r >= bpsDenom {
+		q++
+	}
+	return q, nil
+}
