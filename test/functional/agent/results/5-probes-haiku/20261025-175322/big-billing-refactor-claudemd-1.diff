+
+func TestBuildIssuedAtComesFromClock(t *testing.T) {
+	inv, err := newTestCalc(NewMemoryRedemptions()).Build(context.Background(), Request{
+		ID:       "inv1",
+		Customer: "acme",
+		Region:   "ZERO",
+		Lines:    oneLine(1000),
+	})
+	if err != nil {
+		t.Fatalf("Build() error = %v", err)
+	}
+	if !inv.IssuedAt.Equal(testNow) {
+		t.Errorf("Build() IssuedAt = %s, want %s", inv.IssuedAt, testNow)
+	}
+}
diff --git a/internal/billing/discount.go b/internal/billing/discount.go
new file mode 100644
index 0000000..485f1c1
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,90 @@
+package billing
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+)
+
+// Discount is a discount code. Exactly one of PercentBps or AmountCents must
+// be set. ExpiresAt is optional: the zero time means the code never expires.
+type Discount struct {
+	Code        string
+	PercentBps  int64     // percentage off, in basis points (1% = 100)
+	AmountCents int64     // fixed amount off, in cents
+	ExpiresAt   time.Time // the code is expired at and after this time
+}
+
+// validate reports ErrInvalidDiscount if the code is malformed.
+func (d Discount) validate() error {
+	if d.Code == "" {
+		return fmt.Errorf("discount has no code: %w", ErrInvalidDiscount)
+	}
+	percent := d.PercentBps != 0
+	fixed := d.AmountCents != 0
+	if percent == fixed {
+		return fmt.Errorf("discount %s must set exactly one of percent or amount: %w", d.Code, ErrInvalidDiscount)
+	}
+	if percent && (d.PercentBps < 0 || d.PercentBps > bpsDenom) {
+		return fmt.Errorf("discount %s percent %d bps is outside 0 to %d: %w", d.Code, d.PercentBps, bpsDenom, ErrInvalidDiscount)
+	}
+	if fixed && d.AmountCents < 0 {
+		return fmt.Errorf("discount %s amount %d is negative: %w", d.Code, d.AmountCents, ErrInvalidDiscount)
+	}
+	return nil
+}
+
+// amountOff returns the discount in cents on a subtotal, never more than the
+// subtotal. The discount is rounded once, half away from zero.
+func (d Discount) amountOff(subtotal int64) (int64, error) {
+	off := d.AmountCents
+	if d.PercentBps != 0 {
+		var err error
+		off, err = roundBps(subtotal, d.PercentBps)
+		if err != nil {
+			return 0, fmt.Errorf("discount %s: %w", d.Code, err)
+		}
+	}
+	return min(off, subtotal), nil
+}
+
+// Redemptions records which customers have used which discount codes.
+type Redemptions interface {
+	// Redeem records that customer used code. It returns false, and records
+	// nothing, if the customer has already used the code.
+	Redeem(ctx context.Context, customer, code string) (bool, error)
+}
+
+// redemptionKey identifies one customer's use of one code.
+type redemptionKey struct {
+	customer string
+	code     string
+}
+
+// MemoryRedemptions is an in-process Redemptions. It is lost on restart, so
+// production callers should back Redemptions with storage.
+type MemoryRedemptions struct {
+	mu   sync.Mutex
+	used map[redemptionKey]struct{} // guarded by mu
+}
+
+// NewMemoryRedemptions returns an empty MemoryRedemptions.
+func NewMemoryRedemptions() *MemoryRedemptions {
+	return &MemoryRedemptions{used: make(map[redemptionKey]struct{})}
+}
+
+// Redeem implements Redemptions.
+func (m *MemoryRedemptions) Redeem(ctx context.Context, customer, code string) (bool, error) {
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	k := redemptionKey{customer: customer, code: code}
+	if _, ok := m.used[k]; ok {
+		return false, nil
+	}
+	m.used[k] = struct{}{}
+	return true, nil
+}
