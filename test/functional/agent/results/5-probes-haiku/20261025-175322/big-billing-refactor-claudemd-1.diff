+// newInvoice validates the customer and lines and sums the subtotal. It
+// returns an invoice with no region, discount or tax applied.
+func newInvoice(id, customer string, lines []Line, issued time.Time) (Invoice, error) {
+	if customer == "" {
+		return Invoice{}, fmt.Errorf("invoice %q has no customer: %w", id, ErrInvalidInput)
+	}
+	var total int64
+	for i, l := range lines {
+		if l.Quantity < 0 || l.UnitCents < 0 {
+			return Invoice{}, fmt.Errorf("invoice %q line %d (%s) has negative quantity or price: %w", id, i, l.SKU, ErrInvalidInput)
+		}
+		lineTotal, err := mulCents(int64(l.Quantity), l.UnitCents)
+		if err != nil {
+			return Invoice{}, fmt.Errorf("invoice %q line %d (%s): %w", id, i, l.SKU, err)
+		}
+		if total > maxCents-lineTotal {
+			return Invoice{}, fmt.Errorf("invoice %q total overflows: %w", id, ErrInvalidInput)
+		}
+		total += lineTotal
+	}
+	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, IssuedAt: issued}, nil
+}
