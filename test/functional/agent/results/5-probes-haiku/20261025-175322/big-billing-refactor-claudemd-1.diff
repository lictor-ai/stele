diff --git a/internal/billing/calculator.go b/internal/billing/calculator.go
new file mode 100644
index 0000000..3f82c15
--- /dev/null
+++ b/internal/billing/calculator.go
@@ -0,0 +1,108 @@
+package billing
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Request describes an invoice to build with a Calculator.
+type Request struct {
+	ID       string // generated with id.New when empty
+	Customer string
+	Region   string // key into the tax table, for example "FR" or "US-CA"
+	Lines    []Line
+	Discount *Discount // optional; at most one code per invoice
+}
+
+// Calculator builds invoices with discounts and tax. It is safe for
+// concurrent use if its Redemptions is.
+type Calculator struct {
+	clock       clock.Clock
+	rates       map[string]int64 // tax rate in basis points, by region; never written after NewCalculator
+	redemptions Redemptions
+}
+
+// NewCalculator returns a Calculator. rates maps a region to its tax rate in
+// basis points. The map is copied, so later changes by the caller do not
+// affect the Calculator.
+func NewCalculator(clk clock.Clock, rates map[string]int64, redemptions Redemptions) *Calculator {
+	cp := make(map[string]int64, len(rates))
+	for region, rate := range rates {
+		cp[region] = rate
+	}
+	return &Calculator{clock: clk, rates: cp, redemptions: redemptions}
+}
+
+// Build computes an invoice. The discount is applied to the subtotal, then tax
+// is charged on the net amount. A discount is recorded as used only when the
+// whole invoice is valid, so a failed Build does not spend the code.
+func (c *Calculator) Build(ctx context.Context, req Request) (Invoice, error) {
+	if err := ctx.Err(); err != nil {
+		return Invoice{}, err
+	}
+	if req.ID == "" {
+		req.ID = id.New()
+	}
+	inv, err := newInvoice(req.ID, req.Customer, req.Lines, c.clock.Now())
+	if err != nil {
+		return Invoice{}, err
+	}
+	if req.Region == "" {
+		return Invoice{}, fmt.Errorf("invoice %q has no region: %w", req.ID, ErrInvalidInput)
+	}
+	rate, ok := c.rates[req.Region]
+	if !ok {
+		return Invoice{}, fmt.Errorf("invoice %q region %q: %w", req.ID, req.Region, ErrUnknownRegion)
+	}
+	if rate < 0 || rate > bpsDenom {
+		return Invoice{}, fmt.Errorf("region %q tax rate %d bps is outside 0 to %d: %w", req.Region, rate, bpsDenom, ErrInvalidInput)
+	}
+
+	var discountCents int64
+	if req.Discount != nil {
+		discountCents, err = c.discountOff(*req.Discount, inv.TotalCents)
+		if err != nil {
+			return Invoice{}, err
+		}
+	}
+
+	net := inv.TotalCents - discountCents
+	tax, err := roundBps(net, rate)
+	if err != nil {
+		return Invoice{}, fmt.Errorf("invoice %q tax: %w", req.ID, err)
+	}
+
+	// Redeem last: every check that can fail for this invoice has passed.
+	if req.Discount != nil {
+		ok, err := c.redemptions.Redeem(ctx, req.Customer, req.Discount.Code)
+		if err != nil {
+			return Invoice{}, fmt.Errorf("redeem discount %s for %s: %w", req.Discount.Code, req.Customer, err)
+		}
+		if !ok {
+			return Invoice{}, fmt.Errorf("discount %s for %s: %w", req.Discount.Code, req.Customer, ErrDiscountUsed)
+		}
+		inv.DiscountCode = req.Discount.Code
+	}
+
+	inv.Region = req.Region
+	inv.DiscountCents = discountCents
+	inv.TaxCents = tax
+	inv.GrandTotalCents = net + tax
+	return inv, nil
+}
+
+// discountOff validates a discount and returns the cents it takes off the
+// subtotal. It does not record the redemption.
+func (c *Calculator) discountOff(d Discount, subtotal int64) (int64, error) {
+	if err := d.validate(); err != nil {
+		return 0, err
+	}
+	if !d.ExpiresAt.IsZero() && !c.clock.Now().Before(d.ExpiresAt) {
+		return 0, fmt.Errorf("discount %s expired at %s: %w", d.Code, d.ExpiresAt.Format(time.RFC3339), ErrDiscountExpired)
+	}
+	return d.amountOff(subtotal)
+}
diff --git a/internal/billing/calculator_test.go b/internal/billing/calculator_test.go
new file mode 100644
index 0000000..70af210
--- /dev/null
+++ b/internal/billing/calculator_test.go
@@ -0,0 +1,361 @@
+package billing
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var testNow = time.Date(2026, time.October, 25, 12, 0, 0, 0, time.UTC)
+
+// testRates is a fresh tax table for each call, so no test shares state.
+func testRates() map[string]int64 {
+	return map[string]int64{"FR": 2000, "DE": 1900, "US-CA": 725, "ZERO": 0}
+}
+
+// oneLine returns an invoice with one item of quantity 1 at cents.
+func oneLine(cents int64) []Line {
+	return []Line{{SKU: "item", Quantity: 1, UnitCents: cents}}
+}
+
+func newTestCalc(redemptions Redemptions) *Calculator {
+	return NewCalculator(clock.Fixed{T: testNow}, testRates(), redemptions)
+}
+
+func TestBuildDiscount(t *testing.T) {
+	tests := []struct {
+		name         string
+		discount     *Discount
+		wantErr      error
+		wantDiscount int64
+		wantGrand    int64
+	}{
+		{
+			name:         "percent off",
+			discount:     &Discount{Code: "TEN", PercentBps: 1000},
+			wantDiscount: 100,
+			wantGrand:    900,
+		},
+		{
+			name:         "fixed off",
+			discount:     &Discount{Code: "THREE", AmountCents: 300},
+			wantDiscount: 300,
+			wantGrand:    700,
+		},
+		{
+			name:         "no expiry is valid",
+			discount:     &Discount{Code: "FOREVER", AmountCents: 100},
+			wantDiscount: 100,
+			wantGrand:    900,
+		},
+		{
+			name:         "one nanosecond before expiry is valid",
+			discount:     &Discount{Code: "SOON", AmountCents: 100, ExpiresAt: testNow.Add(time.Nanosecond)},
+			wantDiscount: 100,
+			wantGrand:    900,
+		},
+		{
+			name:     "expires exactly now",
+			discount: &Discount{Code: "NOW", AmountCents: 100, ExpiresAt: testNow},
+			wantErr:  ErrDiscountExpired,
+		},
+		{
+			name:     "expired an hour ago",
+			discount: &Discount{Code: "OLD", PercentBps: 1000, ExpiresAt: testNow.Add(-time.Hour)},
+			wantErr:  ErrDiscountExpired,
+		},
+		{
+			name:         "fixed amount floors at zero",
+			discount:     &Discount{Code: "BIG", AmountCents: 5000},
+			wantDiscount: 1000,
+			wantGrand:    0,
+		},
+		{
+			name:         "100 percent floors at zero",
+			discount:     &Discount{Code: "ALL", PercentBps: 10000},
+			wantDiscount: 1000,
+			wantGrand:    0,
+		},
+		{
+			name:     "no code",
+			discount: &Discount{AmountCents: 100},
+			wantErr:  ErrInvalidDiscount,
+		},
+		{
+			name:     "both percent and amount",
+			discount: &Discount{Code: "BOTH", PercentBps: 1000, AmountCents: 100},
+			wantErr:  ErrInvalidDiscount,
+		},
+		{
+			name:     "neither percent nor amount",
+			discount: &Discount{Code: "NONE"},
+			wantErr:  ErrInvalidDiscount,
+		},
+		{
+			name:     "percent over 100",
+			discount: &Discount{Code: "OVER", PercentBps: 10001},
+			wantErr:  ErrInvalidDiscount,
+		},
+		{
+			name:     "negative percent",
+			discount: &Discount{Code: "NEG", PercentBps: -100},
+			wantErr:  ErrInvalidDiscount,
+		},
+		{
+			name:     "negative amount",
+			discount: &Discount{Code: "NEGAMT", AmountCents: -100},
+			wantErr:  ErrInvalidDiscount,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inv, err := newTestCalc(NewMemoryRedemptions()).Build(context.Background(), Request{
+				ID:       "inv1",
+				Customer: "acme",
+				Region:   "ZERO",
+				Lines:    oneLine(1000),
+				Discount: tt.discount,
+			})
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Build(%+v) error = %v, want %v", tt.discount, err, tt.wantErr)
+			}
+			if tt.wantErr != nil {
+				return
+			}
+			if inv.DiscountCents != tt.wantDiscount {
+				t.Errorf("Build(%+v) DiscountCents = %d, want %d", tt.discount, inv.DiscountCents, tt.wantDiscount)
+			}
+			if inv.GrandTotalCents != tt.wantGrand {
+				t.Errorf("Build(%+v) GrandTotalCents = %d, want %d", tt.discount, inv.GrandTotalCents, tt.wantGrand)
+			}
+			if inv.TotalCents != 1000 {
+				t.Errorf("Build(%+v) TotalCents = %d, want 1000 (subtotal before discount)", tt.discount, inv.TotalCents)
+			}
+		})
+	}
+}
+
+func TestPercentRounding(t *testing.T) {
+	tests := []struct {
+		name     string
+		subtotal int64
+		bps      int64
+		want     int64
+	}{
+		{name: "zero subtotal", subtotal: 0, bps: 1000, want: 0},
+		{name: "rounds down below half", subtotal: 1, bps: 3333, want: 0},
+		{name: "exact half rounds up", subtotal: 15, bps: 1000, want: 2},
+		{name: "exact half at one cent", subtotal: 1, bps: 5000, want: 1},
+		{name: "half of 100.5 rounds up", subtotal: 1005, bps: 1000, want: 101},
+		{name: "just under half rounds down", subtotal: 1004, bps: 1000, want: 100},
+		{name: "499.5 rounds up to 500", subtotal: 999, bps: 5000, want: 500},
+		{name: "100 percent is the subtotal", subtotal: 7, bps: 10000, want: 7},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inv, err := newTestCalc(NewMemoryRedemptions()).Build(context.Background(), Request{
+				ID:       "inv1",
+				Customer: "acme",
+				Region:   "ZERO",
+				Lines:    oneLine(tt.subtotal),
+				Discount: &Discount{Code: "PCT", PercentBps: tt.bps},
+			})
+			if err != nil {
+				t.Fatalf("Build(subtotal=%d, bps=%d) error = %v", tt.subtotal, tt.bps, err)
+			}
+			if inv.DiscountCents != tt.want {
+				t.Errorf("Build(subtotal=%d, bps=%d) DiscountCents = %d, want %d", tt.subtotal, tt.bps, inv.DiscountCents, tt.want)
+			}
+		})
+	}
+}
+
+func TestDiscountReuse(t *testing.T) {
+	t.Run("same customer cannot reuse a code", func(t *testing.T) {
+		calc := newTestCalc(NewMemoryRedemptions())
+		req := Request{ID: "inv1", Customer: "acme", Region: "ZERO", Lines: oneLine(1000), Discount: &Discount{Code: "TEN", PercentBps: 1000}}
+		if _, err := calc.Build(context.Background(), req); err != nil {
+			t.Fatalf("first Build() error = %v", err)
+		}
+		req.ID = "inv2"
+		if _, err := calc.Build(context.Background(), req); !errors.Is(err, ErrDiscountUsed) {
+			t.Errorf("second Build() error = %v, want %v", err, ErrDiscountUsed)
+		}
+	})
+
+	t.Run("another customer can use the same code", func(t *testing.T) {
+		calc := newTestCalc(NewMemoryRedemptions())
+		for _, customer := range []string{"acme", "beta"} {
+			req := Request{ID: "inv-" + customer, Customer: customer, Region: "ZERO", Lines: oneLine(1000), Discount: &Discount{Code: "TEN", PercentBps: 1000}}
+			if _, err := calc.Build(context.Background(), req); err != nil {
+				t.Errorf("Build(customer=%s) error = %v", customer, err)
+			}
+		}
+	})
+
+	t.Run("failed build does not spend the code", func(t *testing.T) {
+		calc := newTestCalc(NewMemoryRedemptions())
+		bad := Request{ID: "inv1", Customer: "acme", Region: "NOWHERE", Lines: oneLine(1000), Discount: &Discount{Code: "TEN", PercentBps: 1000}}
+		if _, err := calc.Build(context.Background(), bad); !errors.Is(err, ErrUnknownRegion) {
+			t.Fatalf("Build(region=NOWHERE) error = %v, want %v", err, ErrUnknownRegion)
+		}
+		good := bad
+		good.Region = "ZERO"
+		if _, err := calc.Build(context.Background(), good); err != nil {
+			t.Errorf("Build(after failed build) error = %v, want nil", err)
+		}
+	})
+
+	t.Run("cancelled context records nothing", func(t *testing.T) {
+		calc := newTestCalc(NewMemoryRedemptions())
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		req := Request{ID: "inv1", Customer: "acme", Region: "ZERO", Lines: oneLine(1000), Discount: &Discount{Code: "TEN", PercentBps: 1000}}
+		if _, err := calc.Build(ctx, req); !errors.Is(err, context.Canceled) {
+			t.Errorf("Build(cancelled) error = %v, want %v", err, context.Canceled)
+		}
+	})
+}
+
+func TestBuildTax(t *testing.T) {
+	tests := []struct {
+		name         string
+		region       string
+		lines        []Line
+		discount     *Discount
+		wantErr      error
+		wantDiscount int64
+		wantTax      int64
+		wantGrand    int64
+	}{
+		{
+			name:      "FR tax on subtotal",
+			region:    "FR",
+			lines:     oneLine(1000),
+			wantTax:   200,
+			wantGrand: 1200,
+		},
+		{
+			name:         "tax is charged on the amount after discount",
+			region:       "FR",
+			lines:        oneLine(1000),
+			discount:     &Discount{Code: "TEN", PercentBps: 1000},
+			wantDiscount: 100,
+			wantTax:      180,
+			wantGrand:    1080,
+		},
+		{
+			name:      "US-CA rate rounds half up",
+			region:    "US-CA",
+			lines:     oneLine(1999),
+			wantTax:   145,
+			wantGrand: 2144,
+		},
+		{
+			name:      "DE rounds 0.95 up to 1",
+			region:    "DE",
+			lines:     oneLine(5),
+			wantTax:   1,
+			wantGrand: 6,
+		},
+		{
+			name:      "zero rate charges no tax",
+			region:    "ZERO",
+			lines:     oneLine(1000),
+			wantTax:   0,
+			wantGrand: 1000,
+		},
+		{
+			name:      "multiple lines are summed before tax",
+			region:    "FR",
+			lines:     []Line{{SKU: "a", Quantity: 2, UnitCents: 150}, {SKU: "b", Quantity: 1, UnitCents: 99}},
+			wantTax:   80,
+			wantGrand: 479,
+		},
+		{
+			name:    "unknown region",
+			region:  "MARS",
+			lines:   oneLine(1000),
+			wantErr: ErrUnknownRegion,
+		},
+		{
+			name:    "missing region",
+			region:  "",
+			lines:   oneLine(1000),
+			wantErr: ErrInvalidInput,
+		},
+		{
+			name:    "negative quantity",
+			region:  "FR",
+			lines:   []Line{{SKU: "neg", Quantity: -1, UnitCents: 100}},
+			wantErr: ErrInvalidInput,
+		},
+		{
+			name:    "negative unit price",
+			region:  "FR",
+			lines:   []Line{{SKU: "neg", Quantity: 1, UnitCents: -100}},
+			wantErr: ErrInvalidInput,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			inv, err := newTestCalc(NewMemoryRedemptions()).Build(context.Background(), Request{
+				ID:       "inv1",
+				Customer: "acme",
+				Region:   tt.region,
+				Lines:    tt.lines,
+				Discount: tt.discount,
+			})
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Build(region=%q) error = %v, want %v", tt.region, err, tt.wantErr)
+			}
+			if tt.wantErr != nil {
+				return
+			}
+			if inv.Region != tt.region {
+				t.Errorf("Build(region=%q) Region = %q, want %q", tt.region, inv.Region, tt.region)
+			}
+			if inv.DiscountCents != tt.wantDiscount {
+				t.Errorf("Build(region=%q) DiscountCents = %d, want %d", tt.region, inv.DiscountCents, tt.wantDiscount)
+			}
+			if inv.TaxCents != tt.wantTax {
+				t.Errorf("Build(region=%q) TaxCents = %d, want %d", tt.region, inv.TaxCents, tt.wantTax)
+			}
+			if inv.GrandTotalCents != tt.wantGrand {
+				t.Errorf("Build(region=%q) GrandTotalCents = %d, want %d", tt.region, inv.GrandTotalCents, tt.wantGrand)
+			}
+		})
+	}
+}
+
