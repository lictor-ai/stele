diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..1f9bc86
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,28 @@
+package cmds
+
+import (
+	"runtime"
+
+	"example.com/app/internal/log"
+)
+
+// appName is the app name the version report shows.
+const appName = "app"
+
+// buildVersion is the app version. Set it at build time with
+// -ldflags "-X example.com/app/internal/cmds.buildVersion=1.2.3".
+var buildVersion = "dev"
+
+// Version logs the app name, the app version and the Go version it was built with.
+func Version(args []string) error {
+	if len(args) > 0 {
+		log.Warn("ignoring arguments", "count", len(args))
+	}
+	log.Info("version", versionFields()...)
+	return nil
+}
+
+// versionFields returns the key-value pairs that Version logs.
+func versionFields() []any {
+	return []any{"app", appName, "version", buildVersion, "go", runtime.Version()}
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..bef1623
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,49 @@
+package cmds
+
+import (
+	"runtime"
+	"slices"
+	"testing"
+)
+
+func TestVersionFields(t *testing.T) {
+	got := versionFields()
+	want := []any{"app", "app", "version", buildVersion, "go", runtime.Version()}
+	if !slices.Equal(got, want) {
+		t.Errorf("versionFields() = %v, want %v", got, want)
+	}
+}
+
+func TestVersion(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+	}{
+		{"nil args", nil},
+		{"empty args", []string{}},
+		{"extra args", []string{"extra", "--short"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if err := Version(tt.args); err != nil {
+				t.Errorf("Version(%q) = %v, want nil", tt.args, err)
+			}
+		})
+	}
+}
+
+func TestVersionRegistered(t *testing.T) {
+	for _, c := range All {
+		if c.Name != "version" {
+			continue
+		}
+		if c.Usage == "" {
+			t.Errorf("command %q has an empty usage", c.Name)
+		}
+		if err := c.Run(nil); err != nil {
+			t.Errorf("command %q Run(nil) = %v, want nil", c.Name, err)
+		}
+		return
+	}
+	t.Errorf("All has no command named %q", "version")
+}
