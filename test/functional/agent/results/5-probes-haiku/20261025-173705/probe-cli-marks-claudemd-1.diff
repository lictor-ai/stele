diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..3ea0806
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,89 @@
+// Command healthcheck sends a GET to each URL in parallel and reports which
+// ones answer with a 2xx status. It exits 0 when all of them are healthy and 1
+// otherwise.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"strconv"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+// errUnhealthy means the checks ran and at least one URL failed. The report
+// has already been printed, so main exits 1 without repeating it.
+var errUnhealthy = errors.New("some URLs are unhealthy")
+
+func main() {
+	err := run(os.Args[1:], os.Stdout, os.Stderr)
+	if err == nil {
+		return
+	}
+	if !errors.Is(err, errUnhealthy) {
+		fmt.Fprintln(os.Stderr, "healthcheck:", err)
+	}
+	os.Exit(1)
+}
+
+// run parses args, checks each URL and writes the report to stdout.
+// It returns errUnhealthy when any URL failed.
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+		fmt.Fprintln(stderr, "Sends a GET to each URL in parallel. Exits 0 only if every URL returns 2xx.")
+	}
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return err
+	}
+
+	urls := fs.Args()
+	if err := health.Validate(urls); err != nil {
+		fs.Usage()
+		return err
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	client := &http.Client{Timeout: health.DefaultTimeout}
+	results := health.NewChecker(client, clock.Real{}).Check(ctx, urls)
+	report(stdout, results)
+
+	if health.CountHealthy(results) < len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
+
+// report prints one line per result, then a summary line.
+func report(w io.Writer, results []health.Result) {
+	for _, r := range results {
+		mark, status := "FAIL", "-"
+		if r.Healthy() {
+			mark = "PASS"
+		}
+		if r.Err == nil {
+			status = strconv.Itoa(r.Status)
+		}
+		fmt.Fprintf(w, "%s  %3s  %6s  %s\n", mark, status, r.Latency.Round(time.Millisecond), r.URL)
+		if r.Err != nil {
+			fmt.Fprintf(w, "      %v\n", r.Err)
+		}
+	}
+	fmt.Fprintf(w, "\n%d of %d healthy\n", health.CountHealthy(results), len(results))
+}
