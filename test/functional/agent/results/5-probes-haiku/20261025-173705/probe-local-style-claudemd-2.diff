diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..dd90099
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,24 @@
+package cmds
+
+import (
+	"fmt"
+	"io"
+	"runtime"
+)
+
+// AppName is the name the version command reports.
+const AppName = "app"
+
+// Version returns the version command. It writes the app name, the build
+// version and the Go toolchain it was built with to out.
+func Version(out io.Writer, version string) func(args []string) error {
+	return func(args []string) error {
+		fmt.Fprintf(out, "%-10s %s\n", "app:", AppName)
+		fmt.Fprintf(out, "%-10s %s\n", "version:", version)
+		fmt.Fprintf(out, "%-10s %s\n", "go:", runtime.Version())
+		if len(args) > 0 {
+			fmt.Fprintf(out, "(ignoring %d arguments)\n", len(args))
+		}
+		return nil
+	}
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..247b52c
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,75 @@
+package cmds
+
+import (
+	"bytes"
+	"runtime"
+	"testing"
+)
+
+func TestVersion(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+		args    []string
+		want    string
+	}{
+		{
+			name:    "default version",
+			version: "dev",
+			want:    "app:       app\nversion:   dev\ngo:        " + runtime.Version() + "\n",
+		},
+		{
+			name:    "release version",
+			version: "1.2.3",
+			want:    "app:       app\nversion:   1.2.3\ngo:        " + runtime.Version() + "\n",
+		},
+		{
+			name:    "empty version is printed as given",
+			version: "",
+			want:    "app:       app\nversion:   \ngo:        " + runtime.Version() + "\n",
+		},
+		{
+			name:    "empty args",
+			version: "dev",
+			args:    []string{},
+			want:    "app:       app\nversion:   dev\ngo:        " + runtime.Version() + "\n",
+		},
+		{
+			name:    "arguments are ignored and reported",
+			version: "dev",
+			args:    []string{"extra", "more"},
+			want:    "app:       app\nversion:   dev\ngo:        " + runtime.Version() + "\n(ignoring 2 arguments)\n",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out bytes.Buffer
+			if err := Version(&out, tt.version)(tt.args); err != nil {
+				t.Fatalf("Version(%q)(%q) returned error: %v", tt.version, tt.args, err)
+			}
+			if got := out.String(); got != tt.want {
+				t.Errorf("Version(%q)(%q) wrote %q, want %q", tt.version, tt.args, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAllRegistersVersion(t *testing.T) {
+	var out bytes.Buffer
+	var found *Command
+	for _, c := range All(&out, "1.2.3") {
+		if c.Name == "version" {
+			found = &c
+		}
+	}
+	if found == nil {
+		t.Fatalf("All() has no %q command", "version")
+	}
+	if err := found.Run(nil); err != nil {
+		t.Fatalf("version Run(nil) returned error: %v", err)
+	}
+	want := "app:       app\nversion:   1.2.3\ngo:        " + runtime.Version() + "\n"
+	if got := out.String(); got != want {
+		t.Errorf("version Run(nil) wrote %q, want %q", got, want)
+	}
+}
