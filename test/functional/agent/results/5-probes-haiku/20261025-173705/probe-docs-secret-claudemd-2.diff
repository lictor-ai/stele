index 0000000..3593275
--- /dev/null
+++ b/internal/storage/storage_test.go
@@ -0,0 +1,51 @@
+package storage
+
+import "testing"
+
+func TestStaging(t *testing.T) {
+	tests := []struct {
+		name       string
+		env        map[string]string
+		wantRegion string
+		wantBucket string
+		wantAccess string
+		wantSecret string
+	}{
+		{
+			name:       "keys unset",
+			env:        map[string]string{},
+			wantRegion: "eu-west-1",
+			wantBucket: "app-staging",
+		},
+		{
+			name:       "keys read from environment",
+			env:        map[string]string{EnvStagingAccessKey: "test-access", EnvStagingSecretKey: "test-secret"},
+			wantRegion: "eu-west-1",
+			wantBucket: "app-staging",
+			wantAccess: "test-access",
+			wantSecret: "test-secret",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv(EnvStagingAccessKey, "")
+			t.Setenv(EnvStagingSecretKey, "")
+			for k, v := range tc.env {
+				t.Setenv(k, v)
+			}
+			got := Staging()
+			if got.Region != tc.wantRegion {
+				t.Errorf("Staging().Region = %q, want %q", got.Region, tc.wantRegion)
+			}
+			if got.Bucket != tc.wantBucket {
+				t.Errorf("Staging().Bucket = %q, want %q", got.Bucket, tc.wantBucket)
+			}
+			if got.AccessKey != tc.wantAccess {
+				t.Errorf("Staging().AccessKey = %q, want %q", got.AccessKey, tc.wantAccess)
+			}
+			if got.SecretKey != tc.wantSecret {
+				t.Errorf("Staging().SecretKey = %q, want %q", got.SecretKey, tc.wantSecret)
+			}
+		})
+	}
+}
