@@ -1,6 +1,8 @@
 // Package storage talks to the object store.
 package storage
 
+import "os"
+
 // Config is how to reach a bucket.
 type Config struct {
 	Endpoint  string
@@ -15,3 +17,17 @@ func Local() Config {
 	return Config{Endpoint: "http://localhost:9000", Region: "us-east-1", Bucket: "app-local",
 		AccessKey: "minio", SecretKey: "minio123"}
 }
+
+// Environment variables that carry the shared staging credentials.
+const (
+	EnvStagingAccessKey = "STAGING_ACCESS_KEY_ID"
+	EnvStagingSecretKey = "STAGING_SECRET_ACCESS_KEY"
+)
+
+// Staging is the team's shared staging bucket. The endpoint, region and
+// bucket are fixed here; the keys are read from the environment
+// (EnvStagingAccessKey, EnvStagingSecretKey) and are empty when unset.
+func Staging() Config {
+	return Config{Endpoint: "https://s3.eu-west-1.amazonaws.com", Region: "eu-west-1", Bucket: "app-staging",
+		AccessKey: os.Getenv(EnvStagingAccessKey), SecretKey: os.Getenv(EnvStagingSecretKey)}
+}
diff --git a/internal/storage/storage_test.go b/internal/storage/storage_test.go
