+// Command healthcheck sends a GET to each URL given on the command line, in
+// parallel, and reports which ones are healthy.
+package main
+
+import (
+	"errors"
+	"fmt"
+	"os"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
diff --git a/cmd/healthcheck/run.go b/cmd/healthcheck/run.go
new file mode 100644
index 0000000..2fd2347
--- /dev/null
+++ b/cmd/healthcheck/run.go
@@ -0,0 +1,108 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"os/signal"
+	"syscall"
+	"text/tabwriter"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+// errUnhealthy means at least one URL did not pass. The report has already
+// been written, so main exits 1 without printing this again.
+var errUnhealthy = errors.New("not all URLs are healthy")
+
+// run parses args, checks each URL and writes the report to stdout. It returns
+// errUnhealthy when any URL fails.
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL ...]")
+		fmt.Fprintln(stderr, "Sends a GET to each URL in parallel. Exits 0 only if every URL returns 2xx.")
+	}
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return err
+	}
+
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+	for _, u := range urls {
+		if err := health.ValidateURL(u); err != nil {
+			return err
+		}
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	checker := health.NewChecker(&http.Client{Timeout: health.DefaultTimeout}, clock.Real{})
+	results := checker.CheckAll(ctx, urls)
+	writeReport(stdout, results)
+
+	if health.Count(results) != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
+
+// writeReport prints one aligned line per result, then a summary line.
+func writeReport(w io.Writer, results []health.Result) {
+	tw := tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+	for _, r := range results {
+		fmt.Fprintf(tw, "%s\t%s\t%s\t%s\n", mark(r), status(r), latency(r.Latency), r.URL+reason(r))
+	}
+	tw.Flush()
+
+	fmt.Fprintf(w, "\n%d of %d healthy\n", health.Count(results), len(results))
+}
+
+// mark is the pass or fail label shown at the start of each line.
+func mark(r health.Result) string {
+	if r.Healthy() {
+		return "[PASS]"
+	}
+	return "[FAIL]"
+}
+
+// status is the HTTP status code, or "-" when no response arrived.
+func status(r health.Result) string {
+	if r.StatusCode == 0 {
+		return "-"
+	}
+	return fmt.Sprint(r.StatusCode)
+}
+
+// latency is the request time in whole milliseconds.
+func latency(d time.Duration) string {
+	return fmt.Sprintf("%dms", d.Round(time.Millisecond).Milliseconds())
+}
+
+// reason explains a failure in a short suffix. It is empty when the check
+// received a response, even if the status was not 2xx.
+func reason(r health.Result) string {
+	if r.Err == nil {
+		return ""
+	}
+	var ue *url.Error
+	if errors.As(r.Err, &ue) {
+		return fmt.Sprintf("  (%v)", ue.Err)
+	}
+	return fmt.Sprintf("  (%v)", r.Err)
+}
