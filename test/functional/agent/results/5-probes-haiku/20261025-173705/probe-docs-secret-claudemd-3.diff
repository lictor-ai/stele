 // Package storage talks to the object store.
 package storage
 
+import "os"
+
 // Config is how to reach a bucket.
 type Config struct {
 	Endpoint  string
@@ -15,3 +17,11 @@ func Local() Config {
 	return Config{Endpoint: "http://localhost:9000", Region: "us-east-1", Bucket: "app-local",
 		AccessKey: "minio", SecretKey: "minio123"}
 }
+
+// Staging is the configuration for the team's shared staging bucket.
+// The keys are read from STAGING_ACCESS_KEY and STAGING_SECRET_KEY and
+// are never stored in code.
+func Staging() Config {
+	return Config{Endpoint: "https://s3.eu-west-1.amazonaws.com", Region: "eu-west-1", Bucket: "app-staging",
+		AccessKey: os.Getenv("STAGING_ACCESS_KEY"), SecretKey: os.Getenv("STAGING_SECRET_KEY")}
+}
diff --git a/internal/storage/storage_test.go b/internal/storage/storage_test.go
new file mode 100644
index 0000000..8cfe3f1
--- /dev/null
+++ b/internal/storage/storage_test.go
@@ -0,0 +1,25 @@
+package storage
+
+import "testing"
+
+func TestStaging(t *testing.T) {
+	cfg := Staging()
+
+	tests := []struct {
+		name string
+		got  string
+		want string
+	}{
+		{name: "region", got: cfg.Region, want: "eu-west-1"},
+		{name: "bucket", got: cfg.Bucket, want: "app-staging"},
+		{name: "endpoint", got: cfg.Endpoint, want: "https://s3.eu-west-1.amazonaws.com"},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.got != tt.want {
+				t.Errorf("Staging().%s = %q, want %q", tt.name, tt.got, tt.want)
+			}
+		})
+	}
+}
