index 0000000..7d48f60
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,67 @@
+// Command healthcheck sends a GET to each URL in parallel and reports which
+// ones respond with a 2xx status.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+// errUnhealthy is returned when at least one URL failed. The report has
+// already named the failures, so main exits without repeating them.
+var errUnhealthy = errors.New("unhealthy endpoints")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+// run checks the URLs in args, writes the report to stdout, and returns
+// errUnhealthy if any URL is not healthy.
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL ...]")
+		fmt.Fprintln(stderr, "Sends a GET to each URL in parallel and reports the status and latency.")
+	}
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return err
+	}
+
+	urls := fs.Args()
+	if err := health.ValidateURLs(urls); err != nil {
+		fs.Usage()
+		return err
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	checker := health.NewChecker(&http.Client{Timeout: health.DefaultTimeout}, clock.Real{})
+	results := checker.CheckAll(ctx, urls)
+	if err := writeReport(stdout, results); err != nil {
+		return err
+	}
+	if health.CountHealthy(results) != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
