+++ b/cmd/healthcheck/report.go
@@ -0,0 +1,33 @@
+package main
+
+import (
+	"fmt"
+	"io"
+
+	"example.com/app/internal/health"
+)
+
+// writeReport prints one aligned line per result, then a blank line and a
+// summary such as "3 of 4 healthy". A failed check shows "-" in place of the
+// status code and the error after the URL.
+func writeReport(w io.Writer, results []health.Result) error {
+	for _, r := range results {
+		mark := "[FAIL]"
+		if r.Healthy() {
+			mark = "[ OK ]"
+		}
+		code := "-"
+		if r.Err == nil {
+			code = fmt.Sprintf("%d", r.Status)
+		}
+		line := fmt.Sprintf("%s  %3s  %6s  %s", mark, code, fmt.Sprintf("%dms", r.Latency.Milliseconds()), r.URL)
+		if r.Err != nil {
+			line += fmt.Sprintf(" (%v)", r.Err)
+		}
+		if _, err := fmt.Fprintln(w, line); err != nil {
+			return err
+		}
+	}
+	_, err := fmt.Fprintf(w, "\n%d of %d healthy\n", health.CountHealthy(results), len(results))
+	return err
+}
