@@ -0,0 +1,57 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+	"time"
+
+	"example.com/app/internal/health"
+)
+
+func TestWriteReport(t *testing.T) {
+	tests := []struct {
+		name    string
+		results []health.Result
+		want    string
+	}{
+		{
+			name:    "none",
+			results: nil,
+			want:    "\n0 of 0 healthy\n",
+		},
+		{
+			name: "all healthy",
+			results: []health.Result{
+				{URL: "http://a.test/ok", Status: 200, Latency: 9 * time.Millisecond},
+				{URL: "http://b.test/new", Status: 201, Latency: 1500 * time.Microsecond},
+			},
+			want: "[ OK ]  200     9ms  http://a.test/ok\n" +
+				"[ OK ]  201     1ms  http://b.test/new\n" +
+				"\n2 of 2 healthy\n",
+		},
+		{
+			name: "mixed",
+			results: []health.Result{
+				{URL: "http://a.test/ok", Status: 200, Latency: 134 * time.Millisecond},
+				{URL: "http://b.test/down", Status: 503, Latency: 12 * time.Millisecond},
+				{URL: "http://c.test/slow", Err: errors.New("context deadline exceeded"), Latency: 5 * time.Second},
+			},
+			want: "[ OK ]  200   134ms  http://a.test/ok\n" +
+				"[FAIL]  503    12ms  http://b.test/down\n" +
+				"[FAIL]    -  5000ms  http://c.test/slow (context deadline exceeded)\n" +
+				"\n1 of 3 healthy\n",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := writeReport(&buf, tc.results); err != nil {
+				t.Fatalf("writeReport(%d results) error = %v", len(tc.results), err)
+			}
+			if got := buf.String(); got != tc.want {
+				t.Errorf("writeReport(%d results) =\n%q\nwant\n%q", len(tc.results), got, tc.want)
+			}
+		})
+	}
+}
