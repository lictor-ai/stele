@@ -0,0 +1,84 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdout, os.Stderr, http.DefaultTransport)
+	stop()
+	if err != nil {
+		if !errors.Is(err, health.ErrUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdout, stderr io.Writer, rt http.RoundTripper) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck [-timeout d] URL [URL...]")
+		fs.PrintDefaults()
+	}
+	timeout := fs.Duration("timeout", health.DefaultTimeout, "time allowed for each request")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	client := &http.Client{Transport: rt, Timeout: *timeout}
+	checker := health.NewChecker(client, clock.Real{})
+	results, err := checker.CheckAll(ctx, fs.Args())
+	if err != nil {
+		fs.Usage()
+		return err
+	}
+
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	for _, r := range results {
+		mark, detail := "[ OK ]", fmt.Sprint(r.Status)
+		if !r.Healthy() {
+			mark = "[FAIL]"
+			if r.Err != nil {
+				detail = "error"
+			}
+		}
+		fmt.Fprintf(stdout, "%s  %-*s  %-5s  %8s", mark, width, r.URL, detail, formatLatency(r.Latency))
+		if r.Err != nil {
+			fmt.Fprintf(stdout, "  %v", r.Err)
+		}
+		fmt.Fprintln(stdout)
+	}
+
+	healthy := health.CountHealthy(results)
+	fmt.Fprintf(stdout, "\n%d of %d healthy\n", healthy, len(results))
+	if healthy != len(results) {
+		return health.ErrUnhealthy
+	}
+	return nil
+}
+
+func formatLatency(d time.Duration) string {
+	if d < time.Second {
+		return fmt.Sprintf("%d ms", d.Milliseconds())
+	}
+	return fmt.Sprintf("%.2f s", d.Seconds())
+}
