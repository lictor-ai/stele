@@ -0,0 +1,48 @@
+package storage
+
+import "testing"
+
+func TestStaging(t *testing.T) {
+	tests := []struct {
+		name string
+		env  map[string]string
+		want Config
+	}{
+		{
+			name: "credentials from environment",
+			env: map[string]string{
+				"STORAGE_STAGING_ACCESS_KEY": "fake-access",
+				"STORAGE_STAGING_SECRET_KEY": "fake-secret",
+			},
+			want: Config{Region: "eu-west-1", Bucket: "app-staging", AccessKey: "fake-access", SecretKey: "fake-secret"},
+		},
+		{
+			name: "no credentials set",
+			env: map[string]string{
+				"STORAGE_STAGING_ACCESS_KEY": "",
+				"STORAGE_STAGING_SECRET_KEY": "",
+			},
+			want: Config{Region: "eu-west-1", Bucket: "app-staging"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for k, v := range tt.env {
+				t.Setenv(k, v)
+			}
+			got := Staging()
+			if got.Region != tt.want.Region {
+				t.Errorf("Staging().Region = %q, want %q", got.Region, tt.want.Region)
+			}
+			if got.Bucket != tt.want.Bucket {
+				t.Errorf("Staging().Bucket = %q, want %q", got.Bucket, tt.want.Bucket)
+			}
+			if got.AccessKey != tt.want.AccessKey {
+				t.Errorf("Staging().AccessKey = %q, want %q", got.AccessKey, tt.want.AccessKey)
+			}
+			if got.SecretKey != tt.want.SecretKey {
+				t.Errorf("Staging().SecretKey = %q, want %q", got.SecretKey, tt.want.SecretKey)
+			}
+		})
+	}
+}
