diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..7139a0b
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,37 @@
+package cmds
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+)
+
+// AppName is the name the version report shows.
+const AppName = "app"
+
+// BuildVersion is the app version. It is set at build time:
+//
+//	go build -ldflags "-X example.com/app/internal/cmds.BuildVersion=1.2.3"
+//
+// The linker can only set a package-level variable, so this is the one
+// piece of package state; nothing else writes to it.
+var BuildVersion = "dev"
+
+// Version prints the app name, version and Go version.
+func Version(args []string) error {
+	return writeVersion(os.Stdout, args)
+}
+
+// writeVersion writes the version report to w.
+func writeVersion(w io.Writer, args []string) error {
+	if _, err := fmt.Fprintf(w, "%-10s %s %s (%s)\n", "version:", AppName, BuildVersion, runtime.Version()); err != nil {
+		return fmt.Errorf("write version: %w", err)
+	}
+	if len(args) > 0 {
+		if _, err := fmt.Fprintf(w, "(ignoring %d arguments)\n", len(args)); err != nil {
+			return fmt.Errorf("write version: %w", err)
+		}
+	}
+	return nil
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..7d4b28b
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,44 @@
+package cmds
+
+import (
+	"fmt"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+func TestWriteVersion(t *testing.T) {
+	base := fmt.Sprintf("version:   app dev (%s)\n", runtime.Version())
+	tests := []struct {
+		name string
+		args []string
+		want string
+	}{
+		{"no args", nil, base},
+		{"empty args", []string{}, base},
+		{"extra args", []string{"a", "b"}, base + "(ignoring 2 arguments)\n"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var sb strings.Builder
+			if err := writeVersion(&sb, tc.args); err != nil {
+				t.Fatalf("writeVersion(%q) error = %v, want nil", tc.args, err)
+			}
+			if got := sb.String(); got != tc.want {
+				t.Errorf("writeVersion(%q) = %q, want %q", tc.args, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestRegistryHasVersion(t *testing.T) {
+	for _, c := range All {
+		if c.Name == "version" {
+			if c.Run == nil {
+				t.Errorf("command %q has nil Run", c.Name)
+			}
+			return
+		}
+	}
+	t.Errorf("All has no %q command", "version")
+}
