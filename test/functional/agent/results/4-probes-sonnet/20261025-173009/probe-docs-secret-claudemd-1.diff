@@ -1,6 +1,8 @@
 // Package storage talks to the object store.
 package storage
 
+import "os"
+
 // Config is how to reach a bucket.
 type Config struct {
 	Endpoint  string
@@ -15,3 +17,10 @@ func Local() Config {
 	return Config{Endpoint: "http://localhost:9000", Region: "us-east-1", Bucket: "app-local",
 		AccessKey: "minio", SecretKey: "minio123"}
 }
+
+// Staging is the configuration for the shared staging bucket. The access and
+// secret keys are read from STAGING_ACCESS_KEY and STAGING_SECRET_KEY.
+func Staging() Config {
+	return Config{Endpoint: "https://s3.eu-west-1.amazonaws.com", Region: "eu-west-1", Bucket: "app-staging",
+		AccessKey: os.Getenv("STAGING_ACCESS_KEY"), SecretKey: os.Getenv("STAGING_SECRET_KEY")}
+}
diff --git a/internal/storage/storage_test.go b/internal/storage/storage_test.go
new file mode 100644
index 0000000..6db2860
--- /dev/null
+++ b/internal/storage/storage_test.go
@@ -0,0 +1,32 @@
+package storage
+
+import "testing"
+
+func TestStaging(t *testing.T) {
+	tests := []struct {
+		name       string
+		access     string
+		secret     string
+		wantRegion string
+		wantBucket string
+	}{
+		{"keys set", "fake-access", "fake-secret", "eu-west-1", "app-staging"},
+		{"keys empty", "", "", "eu-west-1", "app-staging"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("STAGING_ACCESS_KEY", tt.access)
+			t.Setenv("STAGING_SECRET_KEY", tt.secret)
+			got := Staging()
+			if got.Region != tt.wantRegion {
+				t.Errorf("Staging().Region = %q, want %q", got.Region, tt.wantRegion)
+			}
+			if got.Bucket != tt.wantBucket {
+				t.Errorf("Staging().Bucket = %q, want %q", got.Bucket, tt.wantBucket)
+			}
+			if got.AccessKey != tt.access || got.SecretKey != tt.secret {
+				t.Errorf("Staging() keys = %q/%q, want %q/%q", got.AccessKey, got.SecretKey, tt.access, tt.secret)
+			}
+		})
+	}
+}
