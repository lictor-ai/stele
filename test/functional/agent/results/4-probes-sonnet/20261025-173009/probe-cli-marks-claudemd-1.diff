@@ -0,0 +1,46 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/health"
+)
+
+func TestRun(t *testing.T) {
+	ok := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	defer ok.Close()
+	bad := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer bad.Close()
+
+	tests := []struct {
+		name        string
+		args        []string
+		wantErr     bool
+		wantUnhappy bool
+		wantOut     string
+	}{
+		{name: "all healthy", args: []string{ok.URL}, wantOut: "1 of 1 healthy"},
+		{name: "one failing", args: []string{ok.URL, bad.URL}, wantErr: true, wantUnhappy: true, wantOut: "1 of 2 healthy"},
+		{name: "no urls", args: nil, wantErr: true},
+		{name: "unknown flag", args: []string{"-nope"}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(tt.args, &out, &errOut)
+			if (err != nil) != tt.wantErr || errors.Is(err, health.ErrUnhealthy) != tt.wantUnhappy {
+				t.Errorf("run(%q) error = %v, want error %v (unhealthy %v)", tt.args, err, tt.wantErr, tt.wantUnhappy)
+			}
+			if !strings.Contains(out.String(), tt.wantOut) {
+				t.Errorf("run(%q) output = %q, want it to contain %q", tt.args, out.String(), tt.wantOut)
+			}
+		})
+	}
+}
