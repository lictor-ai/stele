index 0000000..2e40daf
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,63 @@
+// Command healthcheck sends a GET to each URL given as an argument and reports
+// which ones are healthy. It exits 1 if any URL is not healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, health.ErrUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck [-no-color] URL [URL...]")
+	}
+	noColor := fs.Bool("no-color", false, "disable colored output")
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	if fs.NArg() == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
+	defer stop()
+
+	results := health.NewChecker(clock.Real{}).Check(ctx, fs.Args())
+	if err := health.Report(stdout, results, !*noColor && useColor(stdout)); err != nil {
+		return err
+	}
+	if health.CountHealthy(results) != len(results) {
+		return health.ErrUnhealthy
+	}
+	return nil
+}
+
+// useColor reports whether w is a terminal and NO_COLOR is unset.
+func useColor(w io.Writer) bool {
+	f, ok := w.(*os.File)
+	if !ok || os.Getenv("NO_COLOR") != "" {
+		return false
+	}
+	info, err := f.Stat()
+	return err == nil && info.Mode()&os.ModeCharDevice != 0
+}
