diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..104e960
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,91 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+var errUnhealthy = errors.New("some URLs are unhealthy")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	timeout := fs.Duration("timeout", health.DefaultTimeout, "time limit for each request")
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck [-timeout 5s] URL [URL...]")
+		fs.PrintDefaults()
+	}
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	checker := health.NewChecker(health.NewClient(*timeout), clock.Real{})
+	results := checker.CheckAll(ctx, urls)
+	if healthy := report(stdout, results); healthy != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
+
+// report prints one line per result and a summary, and returns the number of
+// healthy URLs.
+func report(w io.Writer, results []health.Result) int {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, detail := "[ OK ]", fmt.Sprintf("%d", r.Status)
+		if r.Healthy() {
+			healthy++
+		} else {
+			mark = "[FAIL]"
+			if r.Err != nil {
+				detail = "error"
+			}
+		}
+		fmt.Fprintf(w, "%s  %-*s  %5s  %8s", mark, width, r.URL, detail, latency(r.Latency))
+		if r.Err != nil {
+			fmt.Fprintf(w, "  %v", r.Err)
+		}
+		fmt.Fprintln(w)
+	}
+	fmt.Fprintf(w, "\n%d of %d healthy\n", healthy, len(results))
+	return healthy
+}
+
+func latency(d time.Duration) string {
+	if d < time.Second {
+		return fmt.Sprintf("%dms", d.Milliseconds())
+	}
+	return fmt.Sprintf("%.2fs", d.Seconds())
+}
diff --git a/internal/health/health.go b/internal/health/health.go
new file mode 100644
index 0000000..244e199
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,84 @@
+// Package health checks whether HTTP endpoints are healthy.
+package health
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// DefaultTimeout is the time limit for one request.
+const DefaultTimeout = 5 * time.Second
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL     string
+	Status  int
+	Latency time.Duration
+	Err     error
+}
+
+// Healthy reports whether the check got a 2xx response.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= http.StatusOK && r.Status < http.StatusMultipleChoices
+}
+
+// Checker sends GET requests to URLs and times them.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker that uses client for requests and clk for
+// timing. The client should have Timeout set.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	return &Checker{client: client, clock: clk}
+}
+
+// NewClient returns an http.Client with the given per-request timeout.
+func NewClient(timeout time.Duration) *http.Client {
+	return &http.Client{Timeout: timeout}
+}
+
+// CheckAll checks every URL in parallel and returns the results in the same
+// order as urls. It returns when all checks are done or ctx is cancelled.
+func (c *Checker) CheckAll(ctx context.Context, urls []string) []Result {
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.Check(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results
+}
+
+// Check sends one GET request to url and reports what came back.
+func (c *Checker) Check(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	if err != nil {
+		res.Latency = c.clock.Now().Sub(start)
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	res.Latency = c.clock.Now().Sub(start)
+	res.Status = resp.StatusCode
+	return res
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
new file mode 100644
index 0000000..03c05c1
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,110 @@
+package health
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// handlerTransport serves requests straight from a handler, with no network.
+type handlerTransport struct {
+	h http.Handler
+}
+
+func (t handlerTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL.Host == "" || req.URL.Host == "refused.test" {
+		return nil, errors.New("connection refused")
+	}
+	rec := httptest.NewRecorder()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		t.h.ServeHTTP(rec, req)
+	}()
+	select {
+	case <-done:
+		return rec.Result(), nil
+	case <-req.Context().Done():
+		return nil, req.Context().Err()
+	}
+}
+
+func TestCheckAll(t *testing.T) {
+	release := make(chan struct{})
+	defer close(release)
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /ok", func(w http.ResponseWriter, r *http.Request) {})
+	mux.HandleFunc("GET /created", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+	})
+	mux.HandleFunc("GET /down", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	})
+	mux.HandleFunc("GET /missing", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+	})
+	mux.HandleFunc("GET /hang", func(w http.ResponseWriter, r *http.Request) {
+		<-release
+	})
+
+	tests := []struct {
+		name       string
+		url        string
+		wantStatus int
+		wantOK     bool
+		wantErr    bool
+	}{
+		{name: "ok", url: "http://svc.test/ok", wantStatus: http.StatusOK, wantOK: true},
+		{name: "created", url: "http://svc.test/created", wantStatus: http.StatusCreated, wantOK: true},
+		{name: "unavailable", url: "http://svc.test/down", wantStatus: http.StatusServiceUnavailable},
+		{name: "not found", url: "http://svc.test/missing", wantStatus: http.StatusNotFound},
+		{name: "timeout", url: "http://svc.test/hang", wantErr: true},
+		{name: "bad url", url: "http://[::1", wantErr: true},
+		{name: "empty url", url: "", wantErr: true},
+		{name: "refused", url: "http://refused.test/", wantErr: true},
+	}
+
+	urls := make([]string, len(tests))
+	for i, tc := range tests {
+		urls[i] = tc.url
+	}
+
+	client := &http.Client{
+		Timeout:   50 * time.Millisecond,
+		Transport: handlerTransport{h: mux},
+	}
+	c := NewChecker(client, clock.Fixed{T: time.Unix(0, 0)})
+	got := c.CheckAll(context.Background(), urls)
+	if len(got) != len(tests) {
+		t.Fatalf("CheckAll returned %d results, want %d", len(got), len(tests))
+	}
+	for i, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := got[i]
+			if r.URL != tc.url {
+				t.Errorf("CheckAll result %d URL = %q, want %q", i, r.URL, tc.url)
+			}
+			if (r.Err != nil) != tc.wantErr {
+				t.Errorf("CheckAll(%q) err = %v, want error: %v", tc.url, r.Err, tc.wantErr)
+			}
+			if r.Status != tc.wantStatus {
+				t.Errorf("CheckAll(%q) status = %d, want %d", tc.url, r.Status, tc.wantStatus)
+			}
+			if r.Healthy() != tc.wantOK {
+				t.Errorf("CheckAll(%q) Healthy() = %v, want %v", tc.url, r.Healthy(), tc.wantOK)
+			}
+		})
+	}
+}
+
+func TestCheckAllEmpty(t *testing.T) {
+	c := NewChecker(NewClient(DefaultTimeout), clock.Real{})
+	if got := c.CheckAll(context.Background(), nil); len(got) != 0 {
+		t.Errorf("CheckAll(nil) returned %d results, want 0", len(got))
+	}
+}
