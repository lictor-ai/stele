diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..773785a
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,77 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+const requestTimeout = 5 * time.Second
+
+var errUnhealthy = errors.New("some endpoints are unhealthy")
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	client := &http.Client{Timeout: requestTimeout}
+	if err := run(ctx, os.Args[1:], os.Stdout, os.Stderr, client); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		stop()
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdout, stderr io.Writer, client *http.Client) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+	}
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+
+	results := health.NewChecker(client, clock.Real{}).Check(ctx, urls)
+
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	for _, r := range results {
+		mark, detail := "[ OK ]", fmt.Sprintf("%d", r.StatusCode)
+		if !r.Healthy() {
+			mark = "[FAIL]"
+			if r.Err != nil {
+				detail = "error"
+			}
+		}
+		fmt.Fprintf(stdout, "%s  %-*s  %5s  %8s\n", mark, width, r.URL, detail, r.Latency.Round(time.Millisecond))
+		if r.Err != nil {
+			fmt.Fprintf(stdout, "        %v\n", r.Err)
+		}
+	}
+	healthy, total := health.Summary(results)
+	fmt.Fprintf(stdout, "\n%d of %d healthy\n", healthy, total)
+	if healthy != total {
+		return errUnhealthy
+	}
+	return nil
+}
diff --git a/internal/health/health.go b/internal/health/health.go
new file mode 100644
index 0000000..e8d4015
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,83 @@
+// Package health checks whether HTTP endpoints are up.
+package health
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL        string
+	StatusCode int           // zero when no response was received
+	Latency    time.Duration // time until the response headers arrived or the request failed
+	Err        error         // transport error, nil when a response was received
+}
+
+// Healthy reports whether the endpoint answered with a 2xx status.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.StatusCode >= 200 && r.StatusCode < 300
+}
+
+// Checker sends GET requests to endpoints. The timeout is the client's.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker that uses client for requests and clk for latency.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	return &Checker{client: client, clock: clk}
+}
+
+// Check sends a GET to every URL in parallel and returns the results in the
+// order of urls. It returns when all requests are done or ctx is cancelled.
+func (c *Checker) Check(ctx context.Context, urls []string) []Result {
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.checkOne(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results
+}
+
+func (c *Checker) checkOne(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	res.Latency = c.clock.Now().Sub(start)
+	if err != nil {
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<20))
+	res.StatusCode = resp.StatusCode
+	return res
+}
+
+// Summary counts the healthy results.
+func Summary(results []Result) (healthy, total int) {
+	for _, r := range results {
+		if r.Healthy() {
+			healthy++
+		}
+	}
+	return healthy, len(results)
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
new file mode 100644
index 0000000..4411bb7
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,97 @@
+package health
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name        string
+		status      int
+		wantHealthy bool
+	}{
+		{"ok", http.StatusOK, true},
+		{"no content", http.StatusNoContent, true},
+		{"not found", http.StatusNotFound, false},
+		{"server error", http.StatusInternalServerError, false},
+		{"unavailable", http.StatusServiceUnavailable, false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			h := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(tt.status)
+			})
+			srv := httptest.NewServer(h)
+			defer srv.Close()
+			c := NewChecker(&http.Client{Timeout: time.Second}, clock.Real{})
+			got := c.Check(context.Background(), []string{srv.URL})
+			if len(got) != 1 {
+				t.Fatalf("Check() returned %d results, want 1", len(got))
+			}
+			if got[0].StatusCode != tt.status {
+				t.Errorf("Check(%d).StatusCode = %d, want %d", tt.status, got[0].StatusCode, tt.status)
+			}
+			if got[0].Healthy() != tt.wantHealthy {
+				t.Errorf("Check(%d).Healthy() = %v, want %v", tt.status, got[0].Healthy(), tt.wantHealthy)
+			}
+		})
+	}
+}
+
+func TestCheckEdgeCases(t *testing.T) {
+	ok := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	defer ok.Close()
+	c := NewChecker(&http.Client{Timeout: time.Second}, clock.Real{})
+
+	t.Run("empty input", func(t *testing.T) {
+		if got := c.Check(context.Background(), nil); len(got) != 0 {
+			t.Errorf("Check(nil) = %d results, want 0", len(got))
+		}
+	})
+	t.Run("invalid url", func(t *testing.T) {
+		got := c.Check(context.Background(), []string{"http://bad host/"})
+		if got[0].Err == nil || got[0].Healthy() {
+			t.Errorf("Check(invalid) = %+v, want error and unhealthy", got[0])
+		}
+	})
+	t.Run("unreachable", func(t *testing.T) {
+		dead := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+		url := dead.URL
+		dead.Close()
+		got := c.Check(context.Background(), []string{url})
+		if got[0].Err == nil || got[0].Healthy() {
+			t.Errorf("Check(%q) = %+v, want error and unhealthy", url, got[0])
+		}
+	})
+	t.Run("order preserved", func(t *testing.T) {
+		bad := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.WriteHeader(http.StatusBadGateway)
+		}))
+		defer bad.Close()
+		urls := []string{bad.URL, ok.URL, bad.URL}
+		got := c.Check(context.Background(), urls)
+		for i, u := range urls {
+			if got[i].URL != u {
+				t.Errorf("Check()[%d].URL = %q, want %q", i, got[i].URL, u)
+			}
+		}
+		healthy, total := Summary(got)
+		if healthy != 1 || total != 3 {
+			t.Errorf("Summary() = %d, %d, want 1, 3", healthy, total)
+		}
+	})
+	t.Run("cancelled context", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		got := c.Check(ctx, []string{ok.URL})
+		if got[0].Err == nil {
+			t.Errorf("Check(cancelled) = %+v, want error", got[0])
+		}
+	})
+}
