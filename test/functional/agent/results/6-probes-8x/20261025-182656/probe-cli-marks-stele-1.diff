diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..034bf55
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,83 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+const requestTimeout = 5 * time.Second
+
+var errUnhealthy = errors.New("some urls are unhealthy")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+	}
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no urls given")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	checker := health.NewChecker(&http.Client{Timeout: requestTimeout}, clock.Real{})
+	results := checker.CheckAll(ctx, urls)
+	if report(stdout, results) {
+		return nil
+	}
+	return errUnhealthy
+}
+
+// report prints one line per result and a summary. It returns true if every
+// result is healthy.
+func report(w io.Writer, results []health.Result) bool {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, detail := "[FAIL]", ""
+		switch {
+		case r.Err != nil:
+			detail = "error: " + r.Err.Error()
+		default:
+			detail = fmt.Sprintf("%d %s", r.Status, http.StatusText(r.Status))
+		}
+		if r.Healthy() {
+			mark = "[ OK ]"
+			healthy++
+		}
+		fmt.Fprintf(w, "%s  %-*s  %8s  %s\n", mark, width, r.URL, r.Latency.Round(time.Millisecond), detail)
+	}
+	fmt.Fprintf(w, "\n%d of %d healthy\n", healthy, len(results))
+	return healthy == len(results)
+}
diff --git a/internal/health/health.go b/internal/health/health.go
new file mode 100644
index 0000000..6d2f0a5
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,76 @@
+// Package health checks whether HTTP endpoints are up.
+package health
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL     string
+	Status  int
+	Latency time.Duration
+	Err     error
+}
+
+// Healthy reports whether the check got a 2xx response.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= http.StatusOK && r.Status < http.StatusMultipleChoices
+}
+
+// Checker sends GET requests to URLs and times them.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker that sends requests with client and measures
+// latency with clk. The client should have Timeout set.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	return &Checker{client: client, clock: clk}
+}
+
+// Check sends a GET to url and returns the result.
+func (c *Checker) Check(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	if err != nil {
+		res.Latency = c.clock.Now().Sub(start)
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	res.Latency = c.clock.Now().Sub(start)
+	res.Status = resp.StatusCode
+	return res
+}
+
+// CheckAll checks every url in parallel and returns the results in the same
+// order as urls. It returns once every check has finished.
+func (c *Checker) CheckAll(ctx context.Context, urls []string) []Result {
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.Check(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
new file mode 100644
index 0000000..8ece936
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,119 @@
+package health
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// handlerTransport serves requests in process by calling the handler with an
+// httptest.ResponseRecorder, so no listener is opened.
+type handlerTransport struct{ h http.Handler }
+
+func (t handlerTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	rec := httptest.NewRecorder()
+	t.h.ServeHTTP(rec, req)
+	return rec.Result(), nil
+}
+
+type failTransport struct{ err error }
+
+func (t failTransport) RoundTrip(*http.Request) (*http.Response, error) { return nil, t.err }
+
+func newMux() *http.ServeMux {
+	mux := http.NewServeMux()
+	status := func(code int) http.HandlerFunc {
+		return func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(code) }
+	}
+	mux.HandleFunc("GET /ok", status(http.StatusOK))
+	mux.HandleFunc("GET /created", status(http.StatusCreated))
+	mux.HandleFunc("GET /missing", status(http.StatusNotFound))
+	mux.HandleFunc("GET /broken", status(http.StatusInternalServerError))
+	mux.HandleFunc("GET /moved", status(http.StatusFound))
+	return mux
+}
+
+func TestCheckAll(t *testing.T) {
+	tests := []struct {
+		name        string
+		path        string
+		wantStatus  int
+		wantHealthy bool
+	}{
+		{"ok", "/ok", http.StatusOK, true},
+		{"created", "/created", http.StatusCreated, true},
+		{"not found", "/missing", http.StatusNotFound, false},
+		{"server error", "/broken", http.StatusInternalServerError, false},
+		{"redirect", "/moved", http.StatusFound, false},
+	}
+
+	urls := make([]string, len(tests))
+	for i, tc := range tests {
+		urls[i] = "http://svc.test" + tc.path
+	}
+	client := &http.Client{
+		Timeout:       time.Second,
+		Transport:     handlerTransport{newMux()},
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+	}
+	c := NewChecker(client, clock.Fixed{T: time.Unix(0, 0)})
+	got := c.CheckAll(context.Background(), urls)
+	if len(got) != len(tests) {
+		t.Fatalf("CheckAll(%d urls) returned %d results", len(urls), len(got))
+	}
+	for i, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := got[i]
+			if r.URL != urls[i] {
+				t.Errorf("CheckAll result %d URL = %q, want %q", i, r.URL, urls[i])
+			}
+			if r.Status != tc.wantStatus {
+				t.Errorf("Check(%q) status = %d, want %d", r.URL, r.Status, tc.wantStatus)
+			}
+			if r.Healthy() != tc.wantHealthy {
+				t.Errorf("Check(%q).Healthy() = %v, want %v", r.URL, r.Healthy(), tc.wantHealthy)
+			}
+		})
+	}
+}
+
+func TestCheckAllEmpty(t *testing.T) {
+	c := NewChecker(&http.Client{Transport: handlerTransport{newMux()}}, clock.Fixed{T: time.Unix(0, 0)})
+	if got := c.CheckAll(context.Background(), nil); len(got) != 0 {
+		t.Errorf("CheckAll(nil) returned %d results, want 0", len(got))
+	}
+}
+
+func TestCheckErrors(t *testing.T) {
+	errDown := errors.New("connection refused")
+	tests := []struct {
+		name      string
+		url       string
+		transport http.RoundTripper
+		wantIs    error
+	}{
+		{"empty url", "", nil, nil},
+		{"bad url", "http://[::1", handlerTransport{newMux()}, nil},
+		{"connection refused", "http://svc.test/ok", failTransport{errDown}, errDown},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			c := NewChecker(&http.Client{Transport: tc.transport}, clock.Fixed{T: time.Unix(0, 0)})
+			r := c.Check(context.Background(), tc.url)
+			if r.Err == nil {
+				t.Fatalf("Check(%q) error = nil, want an error", tc.url)
+			}
+			if r.Healthy() {
+				t.Errorf("Check(%q).Healthy() = true, want false", tc.url)
+			}
+			if tc.wantIs != nil && !errors.Is(r.Err, tc.wantIs) {
+				t.Errorf("Check(%q) error = %v, want it to wrap %v", tc.url, r.Err, tc.wantIs)
+			}
+		})
+	}
+}
