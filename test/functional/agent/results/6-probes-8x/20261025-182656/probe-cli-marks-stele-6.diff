diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..9712a54
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,98 @@
+// Command healthcheck sends a GET to each URL given as an argument and
+// reports which ones are healthy. It exits 0 if all are, and 1 otherwise.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+const requestTimeout = 5 * time.Second
+
+var errUnhealthy = errors.New("some urls are unhealthy")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+	}
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no urls given")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	client := &http.Client{Timeout: requestTimeout}
+	checker := health.NewChecker(client, clock.Real{}, requestTimeout)
+	results := checker.CheckAll(ctx, urls)
+
+	return report(stdout, results)
+}
+
+// report prints one line per result and a summary, and returns errUnhealthy
+// if any result is not healthy.
+func report(w io.Writer, results []health.Result) error {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+
+	healthy := 0
+	for _, r := range results {
+		mark, detail := "[FAIL]", ""
+		switch {
+		case r.Err != nil:
+			detail = "error: " + shortErr(r)
+		case r.Healthy():
+			mark = "[ OK ]"
+			healthy++
+			detail = fmt.Sprintf("%d  %s", r.Status, r.Latency.Round(time.Millisecond))
+		default:
+			detail = fmt.Sprintf("%d  %s", r.Status, r.Latency.Round(time.Millisecond))
+		}
+		fmt.Fprintf(w, "%s  %-*s  %s\n", mark, width, r.URL, detail)
+	}
+
+	fmt.Fprintf(w, "\n%d of %d healthy\n", healthy, len(results))
+	if healthy != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
+
+// shortErr describes a failed check in a few words.
+func shortErr(r health.Result) string {
+	switch {
+	case errors.Is(r.Err, health.ErrInvalidURL):
+		return "invalid url"
+	case errors.Is(r.Err, context.DeadlineExceeded):
+		return fmt.Sprintf("timed out after %s", requestTimeout)
+	case errors.Is(r.Err, context.Canceled):
+		return "canceled"
+	}
+	return "request failed"
+}
