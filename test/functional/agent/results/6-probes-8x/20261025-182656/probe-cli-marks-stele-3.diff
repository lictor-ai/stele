diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..82dcb18
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,85 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+const requestTimeout = 5 * time.Second
+
+var errUnhealthy = errors.New("some urls are unhealthy")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+	}
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no urls given")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	client := &http.Client{Timeout: requestTimeout}
+	checker := health.NewChecker(client, clock.Real{})
+	results := checker.CheckAll(ctx, urls)
+
+	return report(stdout, results)
+}
+
+// report prints one line per result and a summary. It returns errUnhealthy if
+// any result is not healthy.
+func report(w io.Writer, results []health.Result) error {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, detail := "[FAIL]", "error"
+		if r.Healthy() {
+			healthy++
+			mark = "[ OK ]"
+		}
+		if r.Err == nil {
+			detail = fmt.Sprintf("%d", r.Status)
+		}
+		fmt.Fprintf(w, "%s  %-*s  %5s  %8s\n", mark, width, r.URL, detail, r.Latency.Round(time.Millisecond))
+		if r.Err != nil {
+			fmt.Fprintf(w, "        %v\n", r.Err)
+		}
+	}
+	fmt.Fprintf(w, "\n%d of %d healthy\n", healthy, len(results))
+	if healthy != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
diff --git a/internal/health/health.go b/internal/health/health.go
new file mode 100644
index 0000000..668ee83
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,78 @@
+// Package health checks whether HTTP endpoints are up.
+package health
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	// URL is the address that was checked.
+	URL string
+	// Status is the HTTP status code, or 0 if no response arrived.
+	Status int
+	// Latency is the time from sending the request to the response headers.
+	Latency time.Duration
+	// Err is set when the request could not be made or completed.
+	Err error
+}
+
+// Healthy reports whether the check got a 2xx response.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= http.StatusOK && r.Status < http.StatusMultipleChoices
+}
+
+// Checker sends GET requests and measures them.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker that uses client for requests and clk for
+// timing. The client should have a Timeout set.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	return &Checker{client: client, clock: clk}
+}
+
+// Check sends a GET to url and returns the result. Failures are reported in
+// Result.Err, not as a separate error.
+func (c *Checker) Check(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	res.Latency = c.clock.Now().Sub(start)
+	if err != nil {
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	res.Status = resp.StatusCode
+	return res
+}
+
+// CheckAll checks every URL in parallel and returns the results in the same
+// order as urls. It returns when all checks have finished.
+func (c *Checker) CheckAll(ctx context.Context, urls []string) []Result {
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.Check(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
new file mode 100644
index 0000000..8912d61
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,119 @@
+package health
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// handlerTransport serves requests straight from a handler, so no listener
+// is opened.
+type handlerTransport struct{ h http.Handler }
+
+func (t handlerTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL.Scheme != "http" && req.URL.Scheme != "https" {
+		return nil, fmt.Errorf("unsupported protocol scheme %q", req.URL.Scheme)
+	}
+	rec := httptest.NewRecorder()
+	t.h.ServeHTTP(rec, req)
+	return rec.Result(), nil
+}
+
+func newTestChecker() *Checker {
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /ok", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	})
+	mux.HandleFunc("GET /created", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+	})
+	mux.HandleFunc("GET /redirect", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusFound)
+	})
+	mux.HandleFunc("GET /missing", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+	})
+	mux.HandleFunc("GET /broken", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	})
+	client := &http.Client{Timeout: 5 * time.Second, Transport: handlerTransport{mux}}
+	return NewChecker(client, clock.Fixed{T: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)})
+}
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name       string
+		url        string
+		wantStatus int
+		wantOK     bool
+		wantErr    bool
+	}{
+		{"ok", "http://svc/ok", http.StatusOK, true, false},
+		{"other 2xx", "http://svc/created", http.StatusCreated, true, false},
+		{"redirect is not healthy", "http://svc/redirect", http.StatusFound, false, false},
+		{"client error", "http://svc/missing", http.StatusNotFound, false, false},
+		{"server error", "http://svc/broken", http.StatusInternalServerError, false, false},
+		{"invalid url", "http://bad host/\x7f", 0, false, true},
+		{"empty url", "", 0, false, true},
+	}
+	c := newTestChecker()
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := c.Check(context.Background(), tt.url)
+			if got.Status != tt.wantStatus {
+				t.Errorf("Check(%q).Status = %d, want %d", tt.url, got.Status, tt.wantStatus)
+			}
+			if got.Healthy() != tt.wantOK {
+				t.Errorf("Check(%q).Healthy() = %v, want %v", tt.url, got.Healthy(), tt.wantOK)
+			}
+			if (got.Err != nil) != tt.wantErr {
+				t.Errorf("Check(%q).Err = %v, want error: %v", tt.url, got.Err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestCheckCancelled(t *testing.T) {
+	client := &http.Client{Timeout: 5 * time.Second}
+	c := NewChecker(client, clock.Fixed{})
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	got := c.Check(ctx, "http://svc.invalid/")
+	if got.Err == nil || got.Healthy() {
+		t.Errorf("Check with cancelled context = %+v, want an error and not healthy", got)
+	}
+}
+
+func TestCheckAll(t *testing.T) {
+	tests := []struct {
+		name string
+		urls []string
+		want []bool
+	}{
+		{"empty", nil, []bool{}},
+		{"all healthy", []string{"http://svc/ok", "http://svc/created"}, []bool{true, true}},
+		{"mixed keeps order", []string{"http://svc/broken", "http://svc/ok", "http://svc/missing"}, []bool{false, true, false}},
+	}
+	c := newTestChecker()
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := c.CheckAll(context.Background(), tt.urls)
+			if len(got) != len(tt.want) {
+				t.Fatalf("CheckAll(%q) returned %d results, want %d", tt.urls, len(got), len(tt.want))
+			}
+			for i, r := range got {
+				if r.URL != tt.urls[i] {
+					t.Errorf("CheckAll(%q)[%d].URL = %q, want %q", tt.urls, i, r.URL, tt.urls[i])
+				}
+				if r.Healthy() != tt.want[i] {
+					t.Errorf("CheckAll(%q)[%d].Healthy() = %v, want %v", tt.urls, i, r.Healthy(), tt.want[i])
+				}
+			}
+		})
+	}
+}
