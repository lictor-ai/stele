index 0000000..3c6910b
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,113 @@
+package health
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// handlerTransport serves requests straight from a handler, with no listener.
+type handlerTransport struct{ h http.Handler }
+
+func (t handlerTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	rec := httptest.NewRecorder()
+	t.h.ServeHTTP(rec, r)
+	return rec.Result(), nil
+}
+
+func TestCheck(t *testing.T) {
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /ok", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	})
+	mux.HandleFunc("GET /created", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+	})
+	mux.HandleFunc("GET /down", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	})
+	mux.HandleFunc("GET /redirect", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusFound)
+	})
+
+	c := NewChecker(&http.Client{
+		Transport: handlerTransport{mux},
+		CheckRedirect: func(*http.Request, []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}, clock.Fixed{T: time.Unix(0, 0)})
+
+	tests := []struct {
+		name    string
+		url     string
+		status  int
+		healthy bool
+		wantErr bool
+	}{
+		{"ok", "http://x/ok", http.StatusOK, true, false},
+		{"created", "http://x/created", http.StatusCreated, true, false},
+		{"unavailable", "http://x/down", http.StatusServiceUnavailable, false, false},
+		{"not found", "http://x/missing", http.StatusNotFound, false, false},
+		{"redirect", "http://x/redirect", http.StatusFound, false, false},
+		{"invalid url", "http://x/\x7f", 0, false, true},
+	}
+	urls := make([]string, len(tests))
+	for i, tc := range tests {
+		urls[i] = tc.url
+	}
+
+	got, err := c.Check(context.Background(), urls)
+	if err != nil {
+		t.Fatalf("Check(%q) error = %v", urls, err)
+	}
+	if len(got) != len(tests) {
+		t.Fatalf("Check returned %d results, want %d", len(got), len(tests))
+	}
+	for i, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := got[i]
+			if r.URL != tc.url {
+				t.Errorf("result %d URL = %q, want %q", i, r.URL, tc.url)
+			}
+			if r.Status != tc.status {
+				t.Errorf("Check(%q) status = %d, want %d", tc.url, r.Status, tc.status)
+			}
+			if r.Healthy() != tc.healthy {
+				t.Errorf("Check(%q) healthy = %v, want %v", tc.url, r.Healthy(), tc.healthy)
+			}
+			if (r.Err != nil) != tc.wantErr {
+				t.Errorf("Check(%q) err = %v, want error: %v", tc.url, r.Err, tc.wantErr)
+			}
+		})
+	}
+}
+
+func TestCheckNoURLs(t *testing.T) {
+	c := NewChecker(&http.Client{}, clock.Fixed{})
+	for _, in := range [][]string{nil, {}} {
+		if _, err := c.Check(context.Background(), in); !errors.Is(err, ErrNoURLs) {
+			t.Errorf("Check(%v) error = %v, want %v", in, err, ErrNoURLs)
+		}
+	}
+}
+
+func TestCheckTransportError(t *testing.T) {
+	boom := errors.New("connection refused")
+	c := NewChecker(&http.Client{Transport: errTransport{boom}}, clock.Fixed{})
+	got, err := c.Check(context.Background(), []string{"http://x/"})
+	if err != nil {
+		t.Fatalf("Check error = %v", err)
+	}
+	if got[0].Healthy() || !errors.Is(got[0].Err, boom) {
+		t.Errorf("Check result = %+v, want unhealthy with error %v", got[0], boom)
+	}
+}
+
+type errTransport struct{ err error }
+
+func (t errTransport) RoundTrip(*http.Request) (*http.Response, error) { return nil, t.err }
