--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,78 @@
+// Package health checks whether HTTP endpoints respond with a 2xx status.
+package health
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// Timeout is the time limit for a single request.
+const Timeout = 5 * time.Second
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL     string
+	Status  int // zero when no response arrived
+	Latency time.Duration
+	Err     error // set when the request failed before a response
+}
+
+// Healthy reports whether the URL answered with a 2xx status.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= 200 && r.Status < 300
+}
+
+// Checker sends GET requests and measures how long they take.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker that uses client and reads time from clk.
+// The client should have a Timeout set.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	return &Checker{client: client, clock: clk}
+}
+
+// Check requests every URL in parallel and returns one Result per URL, in the
+// order given. It returns when all requests are done or ctx is cancelled.
+func (c *Checker) Check(ctx context.Context, urls []string) ([]Result, error) {
+	if len(urls) == 0 {
+		return nil, ErrNoURLs
+	}
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.checkOne(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results, nil
+}
+
+func (c *Checker) checkOne(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	res.Latency = c.clock.Now().Sub(start)
+	if err != nil {
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	res.Status = resp.StatusCode
+	return res
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
