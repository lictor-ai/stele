+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+var errUnhealthy = errors.New("some urls are unhealthy")
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	if err := run(ctx, os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		stop()
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+	}
+	timeout := fs.Duration("timeout", health.Timeout, "time limit per request")
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+
+	checker := health.NewChecker(&http.Client{Timeout: *timeout}, clock.Real{})
+	results, err := checker.Check(ctx, fs.Args())
+	if err != nil {
+		fs.Usage()
+		return err
+	}
+
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, status := "[FAIL]", "ERR"
+		if r.Healthy() {
+			mark = "[ OK ]"
+			healthy++
+		}
+		detail := ""
+		if r.Status != 0 {
+			status = fmt.Sprintf("%d", r.Status)
+		} else if r.Err != nil {
+			detail = "  " + errors.Unwrap(r.Err).Error()
+		}
+		fmt.Fprintf(stdout, "%s  %-*s  %3s  %8s%s\n", mark, width, r.URL, status,
+			r.Latency.Round(time.Millisecond), detail)
+	}
+	fmt.Fprintf(stdout, "\n%d of %d healthy\n", healthy, len(results))
+	if healthy != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
