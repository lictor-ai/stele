diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..fcb28c3
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,87 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+var errUnhealthy = errors.New("some URLs are unhealthy")
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	if err := run(ctx, os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		stop()
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+	for _, raw := range urls {
+		u, err := url.Parse(raw)
+		if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" {
+			return fmt.Errorf("invalid URL %q: want http:// or https://", raw)
+		}
+	}
+
+	checker := health.NewChecker(&http.Client{Timeout: health.Timeout}, clock.Real{})
+	results := checker.CheckAll(ctx, urls)
+	return report(stdout, results)
+}
+
+func report(w io.Writer, results []health.Result) error {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, detail := "[FAIL]", "error"
+		switch {
+		case r.Healthy():
+			healthy++
+			mark, detail = "[ OK ]", fmt.Sprintf("%d", r.Status)
+		case r.Err == nil:
+			detail = fmt.Sprintf("%d", r.Status)
+		}
+		fmt.Fprintf(w, "%s  %-*s  %5s  %8s\n", mark, width, r.URL, detail,
+			r.Latency.Round(time.Millisecond))
+		if r.Err != nil {
+			fmt.Fprintf(w, "        %v\n", r.Err)
+		}
+	}
+	fmt.Fprintf(w, "\n%d of %d healthy\n", healthy, len(results))
+	if healthy != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
diff --git a/internal/health/health.go b/internal/health/health.go
new file mode 100644
index 0000000..ea79e1d
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,81 @@
+// Package health checks whether HTTP endpoints are healthy.
+package health
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// Timeout is the longest a single check may take.
+const Timeout = 5 * time.Second
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL     string
+	Status  int
+	Latency time.Duration
+	Err     error
+}
+
+// Healthy reports whether the check got a 2xx response.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= 200 && r.Status < 300
+}
+
+// Checker sends GET requests and measures how long they take.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker that uses client and reads time from clk.
+// The client should have its own Timeout set.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	return &Checker{client: client, clock: clk}
+}
+
+// Check sends a GET to url and gives up after Timeout.
+func (c *Checker) Check(ctx context.Context, url string) Result {
+	ctx, cancel := context.WithTimeout(ctx, Timeout)
+	defer cancel()
+
+	res := Result{URL: url}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	res.Latency = c.clock.Now().Sub(start)
+	if err != nil {
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	res.Status = resp.StatusCode
+	return res
+}
+
+// CheckAll checks every URL in parallel and returns results in the order of urls.
+func (c *Checker) CheckAll(ctx context.Context, urls []string) []Result {
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.Check(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
new file mode 100644
index 0000000..c00861c
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,85 @@
+package health
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestCheckAll(t *testing.T) {
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /ok", func(w http.ResponseWriter, r *http.Request) {})
+	mux.HandleFunc("GET /created", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusCreated)
+	})
+	mux.HandleFunc("GET /down", func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	})
+	srv := httptest.NewServer(mux)
+	defer srv.Close()
+
+	c := NewChecker(&http.Client{Timeout: Timeout}, clock.Fixed{T: time.Unix(0, 0)})
+
+	tests := []struct {
+		name        string
+		path        string
+		wantStatus  int
+		wantHealthy bool
+		wantErr     bool
+	}{
+		{"ok", srv.URL + "/ok", http.StatusOK, true, false},
+		{"2xx other than 200", srv.URL + "/created", http.StatusCreated, true, false},
+		{"server error", srv.URL + "/down", http.StatusServiceUnavailable, false, false},
+		{"not found", srv.URL + "/missing", http.StatusNotFound, false, false},
+		{"bad scheme", "bogus://x", 0, false, true},
+		{"empty", "", 0, false, true},
+	}
+	urls := make([]string, len(tests))
+	for i, tc := range tests {
+		urls[i] = tc.path
+	}
+
+	got := c.CheckAll(context.Background(), urls)
+	if len(got) != len(tests) {
+		t.Fatalf("CheckAll returned %d results, want %d", len(got), len(tests))
+	}
+	for i, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := got[i]
+			if r.URL != tc.path {
+				t.Errorf("CheckAll()[%d].URL = %q, want %q", i, r.URL, tc.path)
+			}
+			if r.Status != tc.wantStatus {
+				t.Errorf("Check(%q).Status = %d, want %d", tc.path, r.Status, tc.wantStatus)
+			}
+			if r.Healthy() != tc.wantHealthy {
+				t.Errorf("Check(%q).Healthy() = %v, want %v", tc.path, r.Healthy(), tc.wantHealthy)
+			}
+			if (r.Err != nil) != tc.wantErr {
+				t.Errorf("Check(%q).Err = %v, want error: %v", tc.path, r.Err, tc.wantErr)
+			}
+		})
+	}
+}
+
+func TestCheckAllEmpty(t *testing.T) {
+	c := NewChecker(&http.Client{Timeout: Timeout}, clock.Fixed{})
+	if got := c.CheckAll(context.Background(), nil); len(got) != 0 {
+		t.Errorf("CheckAll(nil) returned %d results, want 0", len(got))
+	}
+}
+
+func TestCheckCancelled(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	defer srv.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	c := NewChecker(&http.Client{Timeout: Timeout}, clock.Fixed{})
+	if r := c.Check(ctx, srv.URL); r.Err == nil || r.Healthy() {
+		t.Errorf("Check(cancelled ctx) = %+v, want error and unhealthy", r)
+	}
+}
