diff --git a/cmd/healthcheck/main.go b/cmd/healthcheck/main.go
new file mode 100644
index 0000000..6be7830
--- /dev/null
+++ b/cmd/healthcheck/main.go
@@ -0,0 +1,91 @@
+// Command healthcheck sends a GET to each URL and reports which are healthy.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/health"
+)
+
+var errUnhealthy = errors.New("some URLs are unhealthy")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		if !errors.Is(err, errUnhealthy) {
+			fmt.Fprintln(os.Stderr, "healthcheck:", err)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("healthcheck", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: healthcheck URL [URL...]")
+	}
+	if err := fs.Parse(args); err != nil {
+		return err
+	}
+	urls := fs.Args()
+	if len(urls) == 0 {
+		fs.Usage()
+		return errors.New("no URLs given")
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	client := &http.Client{Timeout: health.DefaultTimeout}
+	checker := health.NewChecker(client, clock.Real{}, health.DefaultTimeout)
+	results := checker.CheckAll(ctx, urls)
+
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	healthy := 0
+	for _, r := range results {
+		mark, detail := "[FAIL]", ""
+		switch {
+		case r.Err != nil:
+			detail = "error: " + shortErr(r.Err)
+		default:
+			detail = fmt.Sprintf("%d %s", r.StatusCode, http.StatusText(r.StatusCode))
+		}
+		if r.Healthy() {
+			mark = "[ OK ]"
+			healthy++
+		}
+		fmt.Fprintf(stdout, "%s  %-*s  %-24s %8s\n", mark, width, r.URL, detail,
+			r.Latency.Round(time.Millisecond))
+	}
+	fmt.Fprintf(stdout, "\n%d of %d healthy\n", healthy, len(results))
+
+	if healthy != len(results) {
+		return errUnhealthy
+	}
+	return nil
+}
+
+// shortErr gives the innermost reason for a failure, which is what a person
+// scanning the output wants to see.
+func shortErr(err error) string {
+	for {
+		inner := errors.Unwrap(err)
+		if inner == nil {
+			return err.Error()
+		}
+		err = inner
+	}
+}
diff --git a/internal/health/health.go b/internal/health/health.go
new file mode 100644
index 0000000..4509850
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,85 @@
+// Package health checks whether HTTP endpoints are healthy.
+package health
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// DefaultTimeout is how long a single request may take.
+const DefaultTimeout = 5 * time.Second
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL        string
+	StatusCode int // zero when no response was received
+	Latency    time.Duration
+	Err        error // set when the request failed before a response arrived
+}
+
+// Healthy reports whether the endpoint answered with a 2xx status.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.StatusCode >= http.StatusOK && r.StatusCode < http.StatusMultipleChoices
+}
+
+// Checker sends GET requests to endpoints and times them.
+type Checker struct {
+	client  *http.Client
+	clock   clock.Clock
+	timeout time.Duration
+}
+
+// NewChecker returns a Checker that uses client for requests, clk to time
+// them, and gives each request at most timeout to finish.
+func NewChecker(client *http.Client, clk clock.Clock, timeout time.Duration) *Checker {
+	return &Checker{client: client, clock: clk, timeout: timeout}
+}
+
+// Check sends one GET to url and reports what happened.
+func (c *Checker) Check(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	ctx, cancel := context.WithTimeout(ctx, c.timeout)
+	defer cancel()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	if err != nil {
+		res.Latency = c.clock.Now().Sub(start)
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	// Drain the body so latency covers the whole response.
+	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<20))
+	res.Latency = c.clock.Now().Sub(start)
+	res.StatusCode = resp.StatusCode
+	return res
+}
+
+// CheckAll checks every URL in parallel and returns results in the order of
+// urls.
+func (c *Checker) CheckAll(ctx context.Context, urls []string) []Result {
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.Check(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
new file mode 100644
index 0000000..583ffc4
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,112 @@
+package health
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var errUnreachable = errors.New("connection refused")
+
+// handlerTransport serves requests by calling a handler directly with an
+// httptest.ResponseRecorder, so no listener is opened.
+type handlerTransport struct{ h http.Handler }
+
+func (t handlerTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL.Host == "" || req.URL.Host == "unreachable.test" {
+		return nil, errUnreachable
+	}
+	rec := httptest.NewRecorder()
+	t.h.ServeHTTP(rec, req)
+	if err := req.Context().Err(); err != nil {
+		return nil, err
+	}
+	resp := rec.Result()
+	resp.Request = req
+	return resp, nil
+}
+
+func testHandler() http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/created":
+			w.WriteHeader(http.StatusCreated)
+		case "/missing":
+			w.WriteHeader(http.StatusNotFound)
+		case "/broken", "/bad":
+			w.WriteHeader(http.StatusInternalServerError)
+		case "/slow":
+			<-r.Context().Done()
+		}
+	})
+}
+
+func newTestChecker(timeout time.Duration) *Checker {
+	client := &http.Client{Transport: handlerTransport{testHandler()}, Timeout: timeout}
+	return NewChecker(client, clock.Fixed{T: time.Unix(0, 0)}, timeout)
+}
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name       string
+		url        string
+		timeout    time.Duration
+		wantStatus int
+		wantOK     bool
+		wantErr    bool
+	}{
+		{"ok", "http://svc.test/ok", time.Second, http.StatusOK, true, false},
+		{"created is 2xx", "http://svc.test/created", time.Second, http.StatusCreated, true, false},
+		{"not found", "http://svc.test/missing", time.Second, http.StatusNotFound, false, false},
+		{"server error", "http://svc.test/broken", time.Second, http.StatusInternalServerError, false, false},
+		{"timeout", "http://svc.test/slow", 20 * time.Millisecond, 0, false, true},
+		{"empty url", "", time.Second, 0, false, true},
+		{"unreachable", "http://unreachable.test/", time.Second, 0, false, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := newTestChecker(tt.timeout).Check(context.Background(), tt.url)
+			if got.StatusCode != tt.wantStatus {
+				t.Errorf("Check(%q) status = %d, want %d", tt.url, got.StatusCode, tt.wantStatus)
+			}
+			if got.Healthy() != tt.wantOK {
+				t.Errorf("Check(%q).Healthy() = %v, want %v", tt.url, got.Healthy(), tt.wantOK)
+			}
+			if (got.Err != nil) != tt.wantErr {
+				t.Errorf("Check(%q) err = %v, want error: %v", tt.url, got.Err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestCheckAllKeepsOrder(t *testing.T) {
+	tests := []struct {
+		name string
+		urls []string
+		want []bool
+	}{
+		{"empty", nil, []bool{}},
+		{"mixed", []string{"http://svc.test/a", "http://svc.test/bad", "http://svc.test/b"}, []bool{true, false, true}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := newTestChecker(time.Second).CheckAll(context.Background(), tt.urls)
+			if len(got) != len(tt.want) {
+				t.Fatalf("CheckAll(%v) returned %d results, want %d", tt.urls, len(got), len(tt.want))
+			}
+			for i, r := range got {
+				if r.URL != tt.urls[i] {
+					t.Errorf("CheckAll result %d url = %q, want %q", i, r.URL, tt.urls[i])
+				}
+				if r.Healthy() != tt.want[i] {
+					t.Errorf("CheckAll(%q).Healthy() = %v, want %v", r.URL, r.Healthy(), tt.want[i])
+				}
+			}
+		})
+	}
+}
