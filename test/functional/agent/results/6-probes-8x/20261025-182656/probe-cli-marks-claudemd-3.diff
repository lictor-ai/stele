+package health
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// handlerTransport serves requests from a handler through httptest.NewRecorder.
+type handlerTransport struct{ h http.Handler }
+
+func (t handlerTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	rec := httptest.NewRecorder()
+	t.h.ServeHTTP(rec, r)
+	return rec.Result(), nil
+}
+
+func newTestChecker() *Checker {
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /ok", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusOK) })
+	mux.HandleFunc("GET /created", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusCreated) })
+	mux.HandleFunc("GET /down", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusServiceUnavailable) })
+	mux.HandleFunc("GET /moved", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusFound) })
+	client := &http.Client{Transport: handlerTransport{mux}, Timeout: Timeout}
+	return NewChecker(client, clock.Fixed{T: time.Unix(0, 0)})
+}
+
+func TestCheck(t *testing.T) {
+	tests := []struct {
+		name        string
+		url         string
+		wantStatus  int
+		wantHealthy bool
+		wantErr     bool
+	}{
+		{"ok", "http://x/ok", http.StatusOK, true, false},
+		{"created", "http://x/created", http.StatusCreated, true, false},
+		{"server error", "http://x/down", http.StatusServiceUnavailable, false, false},
+		{"redirect", "http://x/moved", http.StatusFound, false, false},
+		{"not found", "http://x/missing", http.StatusNotFound, false, false},
+		{"invalid url", "http://x/\x7f", 0, false, true},
+	}
+	c := newTestChecker()
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := c.Check(context.Background(), tt.url)
+			if got.Healthy() != tt.wantHealthy || (got.Err != nil) != tt.wantErr {
+				t.Errorf("Check(%q) = healthy %v err %v, want healthy %v err %v",
+					tt.url, got.Healthy(), got.Err, tt.wantHealthy, tt.wantErr)
+			}
+			if got.Err == nil && got.Status != tt.wantStatus {
+				t.Errorf("Check(%q).Status = %d, want %d", tt.url, got.Status, tt.wantStatus)
+			}
+		})
+	}
+}
+
+func TestCheckAll(t *testing.T) {
+	tests := []struct {
+		name        string
+		urls        []string
+		wantSummary string
+		wantAll     bool
+		wantErr     error
+	}{
+		{"empty", nil, "", false, ErrNoURLs},
+		{"all healthy", []string{"http://x/ok", "http://x/created"}, "2 of 2 healthy", true, nil},
+		{"one failing", []string{"http://x/ok", "http://x/down", "http://x/ok", "http://x/missing"}, "2 of 4 healthy", false, nil},
+	}
+	c := newTestChecker()
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := c.CheckAll(context.Background(), tt.urls)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("CheckAll(%q) error = %v, want %v", tt.urls, err, tt.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			for i, r := range got {
+				if r.URL != tt.urls[i] {
+					t.Errorf("CheckAll(%q)[%d].URL = %q, want %q", tt.urls, i, r.URL, tt.urls[i])
+				}
+			}
+			if s := Summary(got); s != tt.wantSummary {
+				t.Errorf("Summary = %q, want %q", s, tt.wantSummary)
+			}
+			if a := AllHealthy(got); a != tt.wantAll {
+				t.Errorf("AllHealthy = %v, want %v", a, tt.wantAll)
+			}
+		})
+	}
+}
+
+func TestLine(t *testing.T) {
+	tests := []struct {
+		name string
+		r    Result
+		want []string
+	}{
+		{"pass", Result{URL: "http://a", Status: 200, Latency: 12 * time.Millisecond}, []string{"[ OK ]", "200", "12ms", "http://a"}},
+		{"fail", Result{URL: "http://b", Status: 500, Latency: time.Second}, []string{"[FAIL]", "500", "1s", "http://b"}},
+		{"error", Result{URL: "http://c", Err: errors.New("boom")}, []string{"[FAIL]", "ERR", "http://c"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := tt.r.Line()
+			for _, w := range tt.want {
+				if !strings.Contains(got, w) {
+					t.Errorf("Line() = %q, want it to contain %q", got, w)
+				}
+			}
+		})
+	}
+}
