index 0000000..209af3b
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,128 @@
+// Package health checks whether HTTP endpoints respond with a 2xx status.
+package health
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// Timeout is the time allowed for each request.
+const Timeout = 5 * time.Second
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL     string
+	Status  int
+	Latency time.Duration
+	Err     error
+}
+
+// Healthy reports whether the check got a 2xx response.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= 200 && r.Status < 300
+}
+
+// Line renders the result as one line: mark, status, latency and URL.
+func (r Result) Line() string {
+	mark, status := "[ OK ]", fmt.Sprintf("%d", r.Status)
+	if !r.Healthy() {
+		mark = "[FAIL]"
+	}
+	if r.Err != nil {
+		status = "ERR"
+	}
+	line := fmt.Sprintf("%s %-4s %8s  %s", mark, status, r.Latency.Round(time.Millisecond), r.URL)
+	if r.Err != nil {
+		line += "  (request failed)"
+	}
+	return line
+}
+
+// Checker sends GET requests and measures how long they take.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker that uses client and reads time from clk.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	return &Checker{client: client, clock: clk}
+}
+
+// Check sends a GET to url and reports the outcome.
+func (c *Checker) Check(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	res.Latency = c.clock.Now().Sub(start)
+	if err != nil {
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	res.Status = resp.StatusCode
+	return res
+}
+
+// CheckAll checks every URL in parallel and returns results in input order.
+// It returns only after all requests have finished.
+func (c *Checker) CheckAll(ctx context.Context, urls []string) ([]Result, error) {
+	if len(urls) == 0 {
+		return nil, ErrNoURLs
+	}
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.Check(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results, nil
+}
+
+// Summary renders a line such as "3 of 4 healthy".
+func Summary(results []Result) string {
+	n := 0
+	for _, r := range results {
+		if r.Healthy() {
+			n++
+		}
+	}
+	return fmt.Sprintf("%d of %d healthy", n, len(results))
+}
+
+// Report renders all result lines followed by the summary.
+func Report(results []Result) string {
+	var b strings.Builder
+	for _, r := range results {
+		b.WriteString(r.Line())
+		b.WriteByte('\n')
+	}
+	b.WriteString(Summary(results))
+	b.WriteByte('\n')
+	return b.String()
+}
+
+// AllHealthy reports whether every result is healthy.
+func AllHealthy(results []Result) bool {
+	for _, r := range results {
+		if !r.Healthy() {
+			return false
+		}
+	}
+	return true
+}
