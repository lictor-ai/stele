index 0000000..c1c9cc6
--- /dev/null
+++ b/internal/health/health.go
@@ -0,0 +1,118 @@
+// Package health checks whether HTTP endpoints are up.
+package health
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// Timeout is how long a single request may take.
+const Timeout = 5 * time.Second
+
+// Result is the outcome of checking one URL.
+type Result struct {
+	URL     string
+	Status  int
+	Latency time.Duration
+	Err     error
+}
+
+// Healthy reports whether the check got a 2xx response.
+func (r Result) Healthy() bool {
+	return r.Err == nil && r.Status >= 200 && r.Status < 300
+}
+
+// Checker sends GET requests and measures them.
+type Checker struct {
+	client *http.Client
+	clock  clock.Clock
+}
+
+// NewChecker returns a Checker. A nil client gets one with the default Timeout.
+func NewChecker(client *http.Client, clk clock.Clock) *Checker {
+	if client == nil {
+		client = &http.Client{Timeout: Timeout}
+	}
+	return &Checker{client: client, clock: clk}
+}
+
+// Check requests every URL in parallel and returns results in input order.
+// It returns only after all requests have finished.
+func (c *Checker) Check(ctx context.Context, urls []string) ([]Result, error) {
+	if len(urls) == 0 {
+		return nil, ErrNoURLs
+	}
+	results := make([]Result, len(urls))
+	var wg sync.WaitGroup
+	for i, u := range urls {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			results[i] = c.checkOne(ctx, u)
+		}()
+	}
+	wg.Wait()
+	return results, nil
+}
+
+func (c *Checker) checkOne(ctx context.Context, url string) Result {
+	res := Result{URL: url}
+	ctx, cancel := context.WithTimeout(ctx, Timeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		res.Err = fmt.Errorf("build request for %s: %w", url, err)
+		return res
+	}
+	start := c.clock.Now()
+	resp, err := c.client.Do(req)
+	res.Latency = c.clock.Now().Sub(start)
+	if err != nil {
+		res.Err = fmt.Errorf("get %s: %w", url, err)
+		return res
+	}
+	defer resp.Body.Close()
+	_, _ = io.Copy(io.Discard, resp.Body)
+	res.Status = resp.StatusCode
+	return res
+}
+
+// Summary counts the healthy results.
+func Summary(results []Result) (healthy, total int) {
+	for _, r := range results {
+		if r.Healthy() {
+			healthy++
+		}
+	}
+	return healthy, len(results)
+}
+
+// Write prints one line per result and a summary line to w.
+func Write(w io.Writer, results []Result) error {
+	width := 0
+	for _, r := range results {
+		width = max(width, len(r.URL))
+	}
+	var b strings.Builder
+	for _, r := range results {
+		mark, detail := "[ OK ]", fmt.Sprintf("%d", r.Status)
+		if !r.Healthy() {
+			mark = "[FAIL]"
+			if r.Err != nil {
+				detail = "error"
+			}
+		}
+		fmt.Fprintf(&b, "%s  %-*s  %5s  %8s\n", mark, width, r.URL, detail, r.Latency.Round(time.Millisecond))
+	}
+	healthy, total := Summary(results)
+	fmt.Fprintf(&b, "\n%d of %d healthy\n", healthy, total)
+	_, err := io.WriteString(w, b.String())
+	return err
+}
diff --git a/internal/health/health_test.go b/internal/health/health_test.go
