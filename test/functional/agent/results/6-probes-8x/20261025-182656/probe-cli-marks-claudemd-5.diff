+package main
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+		want error
+	}{
+		{"no args", nil, nil},
+		{"bad flag", []string{"-nope"}, nil},
+		{"unhealthy url", []string{"nope://x"}, errUnhealthy},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(context.Background(), tt.args, &out, &errOut)
+			if err == nil {
+				t.Fatalf("run(%v) = nil, want error", tt.args)
+			}
+			if tt.want != nil && !errors.Is(err, tt.want) {
+				t.Errorf("run(%v) = %v, want %v", tt.args, err, tt.want)
+			}
+		})
+	}
+}
