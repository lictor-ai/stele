index 0000000..f8c2282
--- /dev/null
+++ b/internal/health/health_test.go
@@ -0,0 +1,85 @@
+package health
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// recorderTransport serves requests from a handler through httptest.NewRecorder,
+// so no listener is opened.
+type recorderTransport struct{ h http.Handler }
+
+func (t recorderTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	rec := httptest.NewRecorder()
+	t.h.ServeHTTP(rec, r)
+	return rec.Result(), nil
+}
+
+func TestCheck(t *testing.T) {
+	ok := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})
+	bad := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusInternalServerError)
+	})
+	tests := []struct {
+		name    string
+		handler http.Handler
+		url     string
+		want    bool
+		status  int
+	}{
+		{"2xx", ok, "http://example.test/", true, http.StatusOK},
+		{"5xx", bad, "http://example.test/", false, http.StatusInternalServerError},
+		{"unsupported scheme", nil, "nope://x", false, 0},
+		{"empty url", nil, "", false, 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var client *http.Client // nil uses the real client; these URLs never connect
+			if tt.handler != nil {
+				client = &http.Client{Transport: recorderTransport{tt.handler}}
+			}
+			c := NewChecker(client, clock.Fixed{T: time.Unix(0, 0)})
+			got, err := c.Check(context.Background(), []string{tt.url})
+			if err != nil {
+				t.Fatalf("Check(%q) error = %v", tt.url, err)
+			}
+			if got[0].Healthy() != tt.want || got[0].Status != tt.status {
+				t.Errorf("Check(%q) = healthy %v status %d, want healthy %v status %d",
+					tt.url, got[0].Healthy(), got[0].Status, tt.want, tt.status)
+			}
+		})
+	}
+}
+
+func TestCheckNoURLs(t *testing.T) {
+	c := NewChecker(nil, clock.Fixed{})
+	if _, err := c.Check(context.Background(), nil); !errors.Is(err, ErrNoURLs) {
+		t.Errorf("Check(nil) error = %v, want %v", err, ErrNoURLs)
+	}
+}
+
+func TestWrite(t *testing.T) {
+	results := []Result{
+		{URL: "http://a", Status: 200, Latency: 12 * time.Millisecond},
+		{URL: "http://b", Status: 503, Latency: 40 * time.Millisecond},
+		{URL: "http://c", Err: errors.New("boom")},
+	}
+	var buf bytes.Buffer
+	if err := Write(&buf, results); err != nil {
+		t.Fatalf("Write() error = %v", err)
+	}
+	out := buf.String()
+	for _, want := range []string{"[ OK ]  http://a", "[FAIL]  http://b", "503", "1 of 3 healthy"} {
+		if !strings.Contains(out, want) {
+			t.Errorf("Write() output missing %q:\n%s", want, out)
+		}
+	}
+}
