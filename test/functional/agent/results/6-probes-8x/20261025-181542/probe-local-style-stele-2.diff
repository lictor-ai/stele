+// All lists the subcommands, in the order help shows them. out receives the
+// output of commands that report build information, and build is the version
+// string set at build time.
+func All(out io.Writer, build string) []Command {
+	return []Command{
+		{"status", "show the service status", Status},
+		{"users", "list users", Users},
+		{"config", "print the effective config", Config},
+		{"jobs", "list background jobs", Jobs},
+		{"queues", "show queue depths", Queues},
+		{"cache", "show cache statistics", Cache},
+		{"tenants", "list tenants", Tenants},
+		{"flags", "list feature flags", Flags},
+		{"version", "print the app version", Version(out, build)},
+	}
 }
