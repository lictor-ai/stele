+		{"flags", "list feature flags", Flags},
+		{"version", "print the app version", Version(version)},
+	}
 }
diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..1058eda
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,27 @@
+package cmds
+
+import (
+	"runtime"
+
+	"example.com/app/internal/log"
+)
+
+// appName is the name the version command reports.
+const appName = "app"
+
+// Version returns the version subcommand. It logs the app name, the build
+// version set with -ldflags, and the Go version the binary was built with.
+func Version(version string) func(args []string) error {
+	return func(args []string) error {
+		if len(args) > 0 {
+			log.Warn("ignoring arguments", "count", len(args))
+		}
+		log.Info("version", versionFields(version)...)
+		return nil
+	}
+}
+
+// versionFields returns the key-value pairs the version command logs.
+func versionFields(version string) []any {
+	return []any{"app", appName, "version", version, "go", runtime.Version()}
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..b426af9
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,75 @@
+package cmds
+
+import (
+	"runtime"
+	"slices"
+	"testing"
+)
+
+func TestVersionFields(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+		want    []any
+	}{
+		{"default version", "dev", []any{"app", "app", "version", "dev", "go", runtime.Version()}},
+		{"set at build", "1.2.3", []any{"app", "app", "version", "1.2.3", "go", runtime.Version()}},
+		{"empty version", "", []any{"app", "app", "version", "", "go", runtime.Version()}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := versionFields(tt.version)
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("versionFields(%q) = %v, want %v", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestVersionRun(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+	}{
+		{"no arguments", nil},
+		{"empty arguments", []string{}},
+		{"extra arguments are ignored", []string{"extra", "args"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			run := Version("1.2.3")
+			if err := run(tt.args); err != nil {
+				t.Errorf("Version(%q)(%q) error = %v, want nil", "1.2.3", tt.args, err)
+			}
+		})
+	}
+}
+
+func TestAllRegistersVersion(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+	}{
+		{"default version", "dev"},
+		{"set at build", "1.2.3"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var found *Command
+			for _, c := range All(tt.version) {
+				if c.Name == "version" {
+					found = &c
+				}
+			}
+			if found == nil {
+				t.Fatalf("All(%q) has no version command", tt.version)
+			}
+			if found.Usage == "" {
+				t.Errorf("All(%q) version Usage is empty, want a description", tt.version)
+			}
+			if err := found.Run(nil); err != nil {
+				t.Errorf("All(%q) version Run(nil) error = %v, want nil", tt.version, err)
+			}
+		})
+	}
+}
