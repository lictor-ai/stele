diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..1a0ec20
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,34 @@
+package cmds
+
+import (
+	"fmt"
+	"io"
+	"runtime"
+	"strings"
+)
+
+// AppName is the name the version command reports.
+const AppName = "app"
+
+// NewVersion returns the version subcommand. It writes the app name, the build
+// version and the Go version the binary was built with to stdout. version comes
+// from the caller, which sets it at build time.
+func NewVersion(version string, stdout io.Writer) Command {
+	return Command{
+		Name:  "version",
+		Usage: "print the app version",
+		Run: func(args []string) error {
+			var b strings.Builder
+			fmt.Fprintf(&b, "%-10s %s\n", "app:", AppName)
+			fmt.Fprintf(&b, "%-10s %s\n", "version:", version)
+			fmt.Fprintf(&b, "%-10s %s\n", "go:", runtime.Version())
+			if len(args) > 0 {
+				fmt.Fprintf(&b, "(ignoring %d arguments)\n", len(args))
+			}
+			if _, err := io.WriteString(stdout, b.String()); err != nil {
+				return fmt.Errorf("write version report: %w", err)
+			}
+			return nil
+		},
+	}
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..0054d28
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,82 @@
+package cmds
+
+import (
+	"errors"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+var errDiskFull = errors.New("disk full")
+
+// failWriter fails every write, so the error path can be tested.
+type failWriter struct{}
+
+func (failWriter) Write([]byte) (int, error) { return 0, errDiskFull }
+
+func TestVersion(t *testing.T) {
+	goLine := "go:        " + runtime.Version() + "\n"
+	tests := []struct {
+		name    string
+		version string
+		args    []string
+		want    string
+	}{
+		{
+			name:    "no args",
+			version: "dev",
+			args:    nil,
+			want:    "app:       app\nversion:   dev\n" + goLine,
+		},
+		{
+			name:    "release version",
+			version: "1.4.0",
+			args:    []string{},
+			want:    "app:       app\nversion:   1.4.0\n" + goLine,
+		},
+		{
+			name:    "extra args are ignored and counted",
+			version: "dev",
+			args:    []string{"x", "y"},
+			want:    "app:       app\nversion:   dev\n" + goLine + "(ignoring 2 arguments)\n",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var b strings.Builder
+			c := NewVersion(tt.version, &b)
+			if err := c.Run(tt.args); err != nil {
+				t.Fatalf("version Run(%q) error = %v, want nil", tt.args, err)
+			}
+			if got := b.String(); got != tt.want {
+				t.Errorf("version Run(%q) wrote %q, want %q", tt.args, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestVersionWriteError(t *testing.T) {
+	c := NewVersion("dev", failWriter{})
+	err := c.Run(nil)
+	if !errors.Is(err, errDiskFull) {
+		t.Errorf("version Run() error = %v, want it to wrap %v", err, errDiskFull)
+	}
+}
+
+func TestAllRegistersVersion(t *testing.T) {
+	var b strings.Builder
+	for _, c := range All("2.0.0", &b) {
+		if c.Name != "version" {
+			continue
+		}
+		if err := c.Run(nil); err != nil {
+			t.Fatalf("registered version Run(nil) error = %v, want nil", err)
+		}
+		want := "version:   2.0.0\n"
+		if !strings.Contains(b.String(), want) {
+			t.Errorf("registered version wrote %q, want it to contain %q", b.String(), want)
+		}
+		return
+	}
+	t.Errorf("All() has no command named %q", "version")
+}
