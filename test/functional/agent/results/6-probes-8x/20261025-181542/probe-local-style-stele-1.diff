diff --git a/cmd/app/main_test.go b/cmd/app/main_test.go
new file mode 100644
index 0000000..c470619
--- /dev/null
+++ b/cmd/app/main_test.go
@@ -0,0 +1,50 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	tests := []struct {
+		name       string
+		args       []string
+		wantErr    bool
+		wantStdout string
+	}{
+		{
+			name:       "version prints the app name",
+			args:       []string{"version"},
+			wantErr:    false,
+			wantStdout: "app:       app\n",
+		},
+		{
+			name:       "version with extra args still runs",
+			args:       []string{"version", "extra"},
+			wantErr:    false,
+			wantStdout: "(ignoring 1 arguments)\n",
+		},
+		{
+			name:    "no command is an error",
+			args:    nil,
+			wantErr: true,
+		},
+		{
+			name:    "unknown command is an error",
+			args:    []string{"nope"},
+			wantErr: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var stdout, stderr strings.Builder
+			err := run(tt.args, &stdout, &stderr)
+			if (err != nil) != tt.wantErr {
+				t.Errorf("run(%q) error = %v, want error %v", tt.args, err, tt.wantErr)
+			}
+			if tt.wantStdout != "" && !strings.Contains(stdout.String(), tt.wantStdout) {
+				t.Errorf("run(%q) stdout = %q, want it to contain %q", tt.args, stdout.String(), tt.wantStdout)
+			}
+		})
+	}
+}
