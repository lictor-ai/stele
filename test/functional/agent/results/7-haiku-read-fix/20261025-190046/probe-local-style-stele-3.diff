+// All lists the subcommands, in the order help shows them. version is the
+// build version reported by the version subcommand.
+func All(version string) []Command {
+	return []Command{
+		{"status", "show the service status", Status},
+		{"users", "list users", Users},
+		{"config", "print the effective config", Config},
+		{"jobs", "list background jobs", Jobs},
+		{"queues", "show queue depths", Queues},
+		{"cache", "show cache statistics", Cache},
+		{"tenants", "list tenants", Tenants},
+		{"flags", "list feature flags", Flags},
+		NewVersion(version),
+	}
 }
diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..2693d8d
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,32 @@
+package cmds
+
+import (
+	"runtime"
+
+	"example.com/app/internal/log"
+)
+
+// appName is the name the version subcommand reports.
+const appName = "app"
+
+// NewVersion returns the version subcommand. It reports the app name, the
+// build version and the Go version the binary was built with. The build
+// version is passed in by main, which sets it with -ldflags.
+func NewVersion(version string) Command {
+	return Command{
+		Name:  "version",
+		Usage: "show the app version and Go version",
+		Run: func(args []string) error {
+			if len(args) > 0 {
+				log.Warn("ignoring arguments", "count", len(args))
+			}
+			log.Info("version", versionFields(version)...)
+			return nil
+		},
+	}
+}
+
+// versionFields returns the key-value pairs the version subcommand logs.
+func versionFields(version string) []any {
+	return []any{"app", appName, "version", version, "go", runtime.Version()}
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..564b73f
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,65 @@
+package cmds
+
+import (
+	"runtime"
+	"slices"
+	"testing"
+)
+
+func TestVersionFields(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+		want    []any
+	}{
+		{"default", "dev", []any{"app", "app", "version", "dev", "go", runtime.Version()}},
+		{"release", "1.2.3", []any{"app", "app", "version", "1.2.3", "go", runtime.Version()}},
+		{"empty", "", []any{"app", "app", "version", "", "go", runtime.Version()}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := versionFields(tt.version)
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("versionFields(%q) = %v, want %v", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestVersionRun(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+	}{
+		{"no args", nil},
+		{"empty args", []string{}},
+		{"extra args", []string{"extra", "more"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewVersion("1.2.3")
+			if err := c.Run(tt.args); err != nil {
+				t.Errorf("version Run(%q) = %v, want nil", tt.args, err)
+			}
+		})
+	}
+}
+
+func TestAllRegistersVersion(t *testing.T) {
+	var found *Command
+	for _, c := range All("dev") {
+		if c.Name == "version" {
+			found = &c
+			break
+		}
+	}
+	if found == nil {
+		t.Fatalf("All(%q) has no version command", "dev")
+	}
+	if found.Usage == "" {
+		t.Errorf("version command Usage is empty, want a description")
+	}
+	if err := found.Run(nil); err != nil {
+		t.Errorf("version Run(nil) = %v, want nil", err)
+	}
+}
