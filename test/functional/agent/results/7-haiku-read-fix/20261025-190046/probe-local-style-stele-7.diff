+// All lists the subcommands for a build with the given version, in the order help shows them.
+func All(version string) []Command {
+	return []Command{
+		{"status", "show the service status", Status},
+		{"users", "list users", Users},
+		{"config", "print the effective config", Config},
+		{"jobs", "list background jobs", Jobs},
+		{"queues", "show queue depths", Queues},
+		{"cache", "show cache statistics", Cache},
+		{"tenants", "list tenants", Tenants},
+		{"flags", "list feature flags", Flags},
+		NewVersion(version),
+	}
 }
diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..4652549
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,25 @@
+package cmds
+
+import (
+	"runtime"
+
+	"example.com/app/internal/log"
+)
+
+const appName = "app"
+
+// NewVersion returns the version command for a build with the given version string.
+func NewVersion(version string) Command {
+	return Command{"version", "show the app version", func(args []string) error {
+		if len(args) > 0 {
+			log.Warn("version ignores arguments", "count", len(args))
+		}
+		log.Info("version", versionFields(version)...)
+		return nil
+	}}
+}
+
+// versionFields returns the key-value pairs the version command logs.
+func versionFields(version string) []any {
+	return []any{"app", appName, "version", version, "go", runtime.Version()}
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..7b7ab4b
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,48 @@
+package cmds
+
+import (
+	"runtime"
+	"slices"
+	"testing"
+)
+
+func TestVersionFields(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+		want    []any
+	}{
+		{"default build", "dev", []any{"app", "app", "version", "dev", "go", runtime.Version()}},
+		{"release build", "1.2.3", []any{"app", "app", "version", "1.2.3", "go", runtime.Version()}},
+		{"empty version", "", []any{"app", "app", "version", "", "go", runtime.Version()}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := versionFields(tt.version)
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("versionFields(%q) = %v, want %v", tt.version, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestNewVersion(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+	}{
+		{"no args", nil},
+		{"extra args", []string{"extra"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := NewVersion("dev")
+			if c.Name != "version" {
+				t.Errorf("NewVersion().Name = %q, want %q", c.Name, "version")
+			}
+			if err := c.Run(tt.args); err != nil {
+				t.Errorf("NewVersion().Run(%q) = %v, want nil", tt.args, err)
+			}
+		})
+	}
+}
