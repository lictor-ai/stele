diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..e8136c5
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,30 @@
+package cmds
+
+import (
+	"runtime"
+
+	"example.com/app/internal/log"
+)
+
+// BuildVersion is the app version. Set it at build time with
+// -ldflags "-X example.com/app/internal/cmds.BuildVersion=1.2.3".
+var BuildVersion = "dev"
+
+// appName is the name the version command reports.
+const appName = "app"
+
+// Version logs the app name, the build version and the Go version it was
+// built with.
+func Version(args []string) error {
+	log.Info("version", versionFields(BuildVersion)...)
+	if len(args) > 0 {
+		log.Warn("ignoring arguments", "count", len(args))
+	}
+	return nil
+}
+
+// versionFields returns the key-value pairs the version command logs for
+// the given build version.
+func versionFields(build string) []any {
+	return []any{"app", appName, "version", build, "go", runtime.Version()}
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..8f10b02
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,73 @@
+package cmds
+
+import (
+	"runtime"
+	"slices"
+	"testing"
+)
+
+func TestBuildVersionDefault(t *testing.T) {
+	if BuildVersion != "dev" {
+		t.Errorf("BuildVersion = %q, want %q", BuildVersion, "dev")
+	}
+}
+
+func TestVersionFields(t *testing.T) {
+	cases := []struct {
+		name  string
+		build string
+		want  []any
+	}{
+		{"default", "dev", []any{"app", "app", "version", "dev", "go", runtime.Version()}},
+		{"release", "1.2.3", []any{"app", "app", "version", "1.2.3", "go", runtime.Version()}},
+		{"empty", "", []any{"app", "app", "version", "", "go", runtime.Version()}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := versionFields(tc.build)
+			if !slices.Equal(got, tc.want) {
+				t.Errorf("versionFields(%q) = %v, want %v", tc.build, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestVersionRun(t *testing.T) {
+	cases := []struct {
+		name string
+		args []string
+	}{
+		{"no args", nil},
+		{"extra args", []string{"x", "y"}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := Version(tc.args); err != nil {
+				t.Errorf("Version(%q) = %v, want nil", tc.args, err)
+			}
+		})
+	}
+}
+
+func TestVersionRegistered(t *testing.T) {
+	cases := []struct {
+		name string
+		want bool
+	}{
+		{"version", true},
+		{"no-such-command", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := false
+			for _, c := range All {
+				if c.Name == tc.name {
+					got = true
+				}
+			}
+			if got != tc.want {
+				t.Errorf("registered(%q) = %v, want %v", tc.name, got, tc.want)
+			}
+		})
+	}
+}
