diff --git a/internal/cmds/version.go b/internal/cmds/version.go
new file mode 100644
index 0000000..64e2438
--- /dev/null
+++ b/internal/cmds/version.go
@@ -0,0 +1,26 @@
+package cmds
+
+import (
+	"fmt"
+	"io"
+	"runtime"
+)
+
+// appName is the app name the version report shows.
+const appName = "app"
+
+// Version writes the app name, the build version and the Go version the
+// binary was built with. The build sets version with
+// -ldflags "-X main.version=...".
+func Version(version string, args []string, stdout io.Writer) error {
+	if _, err := fmt.Fprintf(stdout, "%-10s %s\n%-10s %s\n%-10s %s\n",
+		"app:", appName, "version:", version, "go:", runtime.Version()); err != nil {
+		return fmt.Errorf("write version report: %w", err)
+	}
+	if len(args) > 0 {
+		if _, err := fmt.Fprintf(stdout, "(ignoring %d arguments)\n", len(args)); err != nil {
+			return fmt.Errorf("write version report: %w", err)
+		}
+	}
+	return nil
+}
diff --git a/internal/cmds/version_test.go b/internal/cmds/version_test.go
new file mode 100644
index 0000000..29281c0
--- /dev/null
+++ b/internal/cmds/version_test.go
@@ -0,0 +1,94 @@
+package cmds
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"runtime"
+	"strings"
+	"testing"
+)
+
+// versionReport is the report Version should write for the given version.
+func versionReport(version string) string {
+	return fmt.Sprintf("%-10s %s\n%-10s %s\n%-10s %s\n",
+		"app:", "app", "version:", version, "go:", runtime.Version())
+}
+
+// failWriter accepts ok writes, then fails every write after that.
+type failWriter struct{ ok int }
+
+func (w *failWriter) Write(p []byte) (int, error) {
+	if w.ok > 0 {
+		w.ok--
+		return len(p), nil
+	}
+	return 0, errors.New("disk full")
+}
+
+func TestVersion(t *testing.T) {
+	tests := []struct {
+		name    string
+		version string
+		args    []string
+		want    string
+	}{
+		{"default dev build", "dev", nil, versionReport("dev")},
+		{"release version", "1.2.3", nil, versionReport("1.2.3")},
+		{"empty version is printed as empty", "", nil, versionReport("")},
+		{"extra arguments are reported", "dev", []string{"x", "y"}, versionReport("dev") + "(ignoring 2 arguments)\n"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := Version(tt.version, tt.args, &buf); err != nil {
+				t.Fatalf("Version(%q, %q) error = %v, want nil", tt.version, tt.args, err)
+			}
+			if got := buf.String(); got != tt.want {
+				t.Errorf("Version(%q, %q) wrote %q, want %q", tt.version, tt.args, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestVersionWriteError(t *testing.T) {
+	tests := []struct {
+		name string
+		ok   int // writes that succeed before the writer fails
+		args []string
+	}{
+		{"report write fails", 0, nil},
+		{"argument write fails", 1, []string{"x"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := Version("dev", tt.args, &failWriter{ok: tt.ok})
+			if err == nil {
+				t.Fatalf("Version(%q) with %d good writes error = nil, want write error", tt.args, tt.ok)
+			}
+			if !strings.Contains(err.Error(), "write version report") {
+				t.Errorf("Version(%q) error = %q, want it to say what was being done", tt.args, err)
+			}
+		})
+	}
+}
+
+func TestAllRegistersVersion(t *testing.T) {
+	var found bool
+	for _, c := range All("1.2.3") {
+		if c.Name != "version" {
+			continue
+		}
+		found = true
+		var buf bytes.Buffer
+		if err := c.Run(nil, &buf); err != nil {
+			t.Fatalf("version Run() error = %v, want nil", err)
+		}
+		if got, want := buf.String(), versionReport("1.2.3"); got != want {
+			t.Errorf("version Run() wrote %q, want %q", got, want)
+		}
+	}
+	if !found {
+		t.Errorf("All() has no %q command, want one", "version")
+	}
+}
