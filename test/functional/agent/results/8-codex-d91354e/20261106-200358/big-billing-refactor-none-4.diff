+	ID              string    `json:"id"`
+	Customer        string    `json:"customer"`
+	Region          string    `json:"region"`
+	Lines           []Line    `json:"lines"`
+	TotalCents      int64     `json:"total_cents"`
+	DiscountCents   int64     `json:"discount_cents"`
+	TaxCents        int64     `json:"tax_cents"`
+	GrandTotalCents int64     `json:"grand_total_cents"`
+	IssuedAt        time.Time `json:"issued_at"`
 }
 
 // Compute builds an invoice for a customer.
@@ -31,8 +37,88 @@ func Compute(id, customer string, lines []Line) Invoice {
 	for _, l := range lines {
 		total += int64(l.Quantity) * l.UnitCents
 	}
-	fmt.Printf("computed invoice %s for %s: %d\n", id, customer, total)
-	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, IssuedAt: time.Now()}
+	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, GrandTotalCents: total, IssuedAt: time.Now()}
+}
+
+// DiscountCode describes either a percentage discount (Percent) or a fixed
+// cents discount (AmountCents). Exactly one of those fields must be positive.
+type DiscountCode struct {
+	Code        string
+	Percent     int64
+	AmountCents int64
+	ExpiresAt   *time.Time
+}
+
+var (
+	ErrUnknownDiscount = errors.New("billing: unknown discount code")
+	ErrExpiredDiscount = errors.New("billing: expired discount code")
+	ErrDiscountUsed    = errors.New("billing: discount code already used by customer")
+	ErrInvalidDiscount = errors.New("billing: invalid discount code")
+)
+
+// Calculator applies discounts and region tax rates. TaxRates maps region to
+// basis points (e.g. 2000 is 20%). A calculator tracks code use across calls.
+type Calculator struct {
+	DiscountCodes map[string]DiscountCode
+	TaxRates      map[string]int64
+	mu            sync.Mutex
+	used          map[string]bool
+}
+
+func NewCalculator(codes []DiscountCode, taxRates map[string]int64) *Calculator {
+	c := &Calculator{DiscountCodes: make(map[string]DiscountCode), TaxRates: make(map[string]int64), used: make(map[string]bool)}
+	for _, code := range codes {
+		c.DiscountCodes[code.Code] = code
+	}
+	for region, rate := range taxRates {
+		c.TaxRates[region] = rate
+	}
+	return c
+}
+
+// ComputeInvoice computes an invoice with an optional discount code.
+func (c *Calculator) ComputeInvoice(id, customer, region string, lines []Line, code string) (Invoice, error) {
+	if customer == "" {
+		return Invoice{}, errors.New("billing: no customer")
+	}
+	var total int64
+	for _, l := range lines {
+		total += int64(l.Quantity) * l.UnitCents
+	}
+	inv := Invoice{ID: id, Customer: customer, Region: region, Lines: lines, TotalCents: total, IssuedAt: time.Now()}
+	if code != "" {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		d, ok := c.DiscountCodes[code]
+		if !ok {
+			return Invoice{}, ErrUnknownDiscount
+		}
+		if (d.Percent > 0) == (d.AmountCents > 0) || d.Percent > 100 {
+			return Invoice{}, ErrInvalidDiscount
+		}
+		if d.ExpiresAt != nil && time.Now().After(*d.ExpiresAt) {
+			return Invoice{}, ErrExpiredDiscount
+		}
+		key := customer + "\x00" + code
+		if c.used[key] {
+			return Invoice{}, ErrDiscountUsed
+		}
+		if d.Percent > 0 {
+			inv.DiscountCents = (total*d.Percent + 50) / 100
+		} else {
+			inv.DiscountCents = d.AmountCents
+		}
+		if inv.DiscountCents > total {
+			inv.DiscountCents = total
+		}
+		c.used[key] = true
+	}
+	base := total - inv.DiscountCents
+	if rate := c.TaxRates[region]; rate > 0 {
+		inv.TaxCents = (base*rate + 5000) / 10000
+	}
+	inv.GrandTotalCents = base + inv.TaxCents
+	return inv, nil
 }
 
