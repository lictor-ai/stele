+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\n\"i,1\",Acme,DE,2025-02-03T04:05:06Z,120,20,19,119\n"
+	if strings.ReplaceAll(b.String(), "\r\n", "\n") != want {
+		t.Fatalf("CSV = %q, want %q", b.String(), want)
+	}
