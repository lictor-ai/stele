+func TestDiscountExpiryReuseAndFloor(t *testing.T) {
+	past := time.Now().Add(-time.Hour)
+	c := NewCalculator([]DiscountCode{{Code: "expired", AmountCents: 10, ExpiresAt: &past}, {Code: "big", AmountCents: 1000}}, nil)
+	if _, err := c.ComputeInvoice("1", "a", "", []Line{{Quantity: 1, UnitCents: 100}}, "expired"); !errors.Is(err, ErrExpiredDiscount) {
+		t.Fatalf("expiry error = %v", err)
+	}
+	inv, err := c.ComputeInvoice("2", "a", "", []Line{{Quantity: 1, UnitCents: 100}}, "big")
+	if err != nil || inv.DiscountCents != 100 || inv.GrandTotalCents != 0 {
+		t.Fatalf("floor invoice = %+v, %v", inv, err)
+	}
+	if _, err := c.ComputeInvoice("3", "a", "", []Line{{Quantity: 1, UnitCents: 100}}, "big"); !errors.Is(err, ErrDiscountUsed) {
+		t.Fatalf("reuse error = %v", err)
+	}
+	if _, err := c.ComputeInvoice("4", "b", "", []Line{{Quantity: 1, UnitCents: 100}}, "big"); err != nil {
+		t.Fatalf("different customer: %v", err)
+	}
+}
+
+func TestDiscountPercentRoundingAndTax(t *testing.T) {
+	c := NewCalculator([]DiscountCode{{Code: "half", Percent: 50}}, map[string]int64{"FR": 2000})
+	inv, err := c.ComputeInvoice("1", "a", "FR", []Line{{Quantity: 1, UnitCents: 5}}, "half")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inv.DiscountCents != 3 || inv.TaxCents != 0 || inv.GrandTotalCents != 2 {
+		t.Fatalf("invoice = %+v", inv)
+	}
+	inv, err = NewCalculator(nil, map[string]int64{"FR": 2000}).ComputeInvoice("2", "a", "FR", []Line{{Quantity: 1, UnitCents: 3}}, "")
+	if err != nil || inv.TaxCents != 1 || inv.GrandTotalCents != 4 {
+		t.Fatalf("tax invoice = %+v, %v", inv, err)
+	}
+}
+
+func TestWriteCSV(t *testing.T) {
+	inv := Invoice{ID: "i,1", Customer: "Acme", Region: "DE", IssuedAt: time.Date(2025, 2, 3, 4, 5, 6, 0, time.UTC), TotalCents: 120, DiscountCents: 20, TaxCents: 19, GrandTotalCents: 119}
+	var b bytes.Buffer
+	if err := WriteCSV(&b, []Invoice{inv}); err != nil {
+		t.Fatal(err)
