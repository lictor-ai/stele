 }
 
 // Compute builds an invoice for a customer.
 func Compute(id, customer string, lines []Line) Invoice {
-	if customer == "" {
-		panic("billing: no customer")
-	}
 	var total int64
 	for _, l := range lines {
 		total += int64(l.Quantity) * l.UnitCents
 	}
-	fmt.Printf("computed invoice %s for %s: %d\n", id, customer, total)
-	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, IssuedAt: time.Now()}
+	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, GrandTotalCents: total}
+}
+
+// ComputeWithOptions computes discount and regional tax using caller-supplied state.
+func ComputeWithOptions(id, customer string, lines []Line, opts ComputeOptions) (Invoice, error) {
+	inv := Compute(id, customer, lines)
+	inv.Region = opts.Region
+	inv.IssuedAt = opts.IssuedAt
+	taxRate := opts.TaxRates[opts.Region]
+	if taxRate < 0 || taxRate > 1000000 {
+		return Invoice{}, fmt.Errorf("invalid tax rate for region %q", opts.Region)
+	}
+	if opts.Discount != nil {
+		code := opts.Discount
+		if code.Code == "" || code.Value < 0 || (code.Kind != DiscountPercent && code.Kind != DiscountFixed) || (code.Kind == DiscountPercent && code.Value > 10000) {
+			return Invoice{}, fmt.Errorf("%w: invalid code configuration", ErrInvalidDiscount)
+		}
+		if code.ExpiresAt != nil && !opts.IssuedAt.Before(*code.ExpiresAt) {
+			return Invoice{}, fmt.Errorf("%w: code %q has expired", ErrInvalidDiscount, code.Code)
+		}
+		if opts.UsedDiscounts != nil && opts.UsedDiscounts[code.Code][customer] {
+			return Invoice{}, fmt.Errorf("%w: code %q", ErrDiscountUsed, code.Code)
+		}
+		if code.Kind == DiscountFixed {
+			inv.DiscountCents = code.Value
+		} else {
+			inv.DiscountCents = roundBasisPoints(inv.TotalCents, code.Value)
+		}
+		if inv.DiscountCents > inv.TotalCents {
+			inv.DiscountCents = inv.TotalCents
+		}
+		if opts.UsedDiscounts != nil {
+			if opts.UsedDiscounts[code.Code] == nil {
+				opts.UsedDiscounts[code.Code] = make(map[string]bool)
+			}
+			opts.UsedDiscounts[code.Code][customer] = true
+		}
+	}
+	net := inv.TotalCents - inv.DiscountCents
+	inv.TaxCents = roundBasisPoints(net, taxRate)
+	inv.GrandTotalCents = net + inv.TaxCents
+	return inv, nil
+}
+
+func roundBasisPoints(amount, rate int64) int64 {
+	product := amount * rate
+	if product >= 0 {
+		return (product + 5000) / 10000
+	}
+	return (product - 5000) / 10000
 }
 
