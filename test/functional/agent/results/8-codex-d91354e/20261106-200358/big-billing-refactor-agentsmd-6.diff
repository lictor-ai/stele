+// DiscountKind identifies the calculation used by a discount code.
+type DiscountKind string
+
+const (
+	// DiscountPercent applies a percentage expressed in basis points.
+	DiscountPercent DiscountKind = "percent"
+	// DiscountFixed subtracts a fixed amount in cents.
+	DiscountFixed DiscountKind = "fixed"
+)
+
+// DiscountCode describes a percentage or fixed amount discount.
+type DiscountCode struct {
+	Code      string
