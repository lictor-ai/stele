index 0000000..2541af5
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,37 @@
+package logparse
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+const sample = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	r, err := Parse(sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Path != "/api/items" || r.Status != 200 || r.Duration != 42*time.Millisecond || r.Time.UTC().Format(time.RFC3339) != "2026-10-10T13:55:36Z" {
+		t.Fatalf("unexpected request: %+v", r)
+	}
+}
+
+func TestMalformedLines(t *testing.T) {
+	for _, line := range []string{"", "not a log", strings.Replace(sample, "200 512", "bogus 512", 1), strings.Replace(sample, "0.042", "-1", 1), strings.Replace(sample, "13:55:36", "bad", 1)} {
+		if _, err := Parse(line); err == nil {
+			t.Errorf("Parse(%q) unexpectedly succeeded", line)
+		}
+	}
+}
+
+func TestEmptyLineAndEscapedQuotedContent(t *testing.T) {
+	if _, err := Parse("   "); err == nil {
+		t.Fatal("empty input accepted")
+	}
+	line := strings.Replace(sample, `"-"`, `"https://example.test/a b"`, 1)
+	if _, err := Parse(line); err != nil {
+		t.Fatalf("quoted whitespace rejected: %v", err)
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
