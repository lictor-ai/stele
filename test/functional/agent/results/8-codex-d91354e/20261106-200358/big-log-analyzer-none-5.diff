+++ b/cmd/loga/main.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() { os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)) }
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	asJSON := fs.Bool("json", false, "print JSON report")
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	if *top < 0 {
+		fmt.Fprintln(stderr, "-top must be non-negative")
+		return 2
+	}
+	var reqs []logparse.Request
+	malformed := 0
+	consume := func(r io.Reader) error {
+		sc := bufio.NewScanner(r)
+		sc.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for sc.Scan() {
+			q, e := logparse.Parse(sc.Text())
+			if e != nil {
+				malformed++
+			} else {
+				reqs = append(reqs, q)
+			}
+		}
+		return sc.Err()
+	}
+	files := fs.Args()
+	if len(files) == 0 {
+		if e := consume(stdin); e != nil {
+			fmt.Fprintln(stderr, e)
+			return 1
+		}
+	} else {
+		for _, name := range files {
+			f, e := os.Open(name)
+			if e != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, e)
+				return 1
+			}
+			e = consume(f)
+			ce := f.Close()
+			if e == nil {
+				e = ce
+			}
+			if e != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, e)
+				return 1
+			}
+		}
+	}
+	r := stats.Build(reqs, malformed, *top)
+	if *asJSON {
+		if err := json.NewEncoder(stdout).Encode(r); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+		return 0
+	}
+	printReport(stdout, r)
+	return 0
+}
+
+func printReport(w io.Writer, r stats.Report) {
+	fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", r.Total, r.Malformed)
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(w, "%s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintln(w, "\nStatus classes\nCLASS\tCOUNT")
+	for _, k := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		fmt.Fprintf(w, "%s\t%d\n", k, r.StatusClasses[k])
+	}
+	fmt.Fprintf(w, "\nRequest time (ms)\np50\t%s\np95\t%s\np99\t%s\n", num(r.P50MS), num(r.P95MS), num(r.P99MS))
+	fmt.Fprintln(w, "\n5xx per hour\nHOUR\tCOUNT")
+	keys := make([]string, 0, len(r.FiveXXPerHour))
+	for k := range r.FiveXXPerHour {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		fmt.Fprintf(w, "%s\t%d\n", k, r.FiveXXPerHour[k])
+	}
+}
+func num(f float64) string { return strconv.FormatFloat(f, 'f', 3, 64) }
