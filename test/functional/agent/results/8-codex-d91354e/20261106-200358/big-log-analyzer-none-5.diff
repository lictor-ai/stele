+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestRunStdinTextAndJSON(t *testing.T) {
+	line := `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 500 512 "-" "curl/8.0" 0.042`
+	for _, tc := range []struct {
+		args []string
+		want string
+	}{{[]string{"-top", "1"}, "Total requests: 1"}, {[]string{"-json"}, `"total_requests":1`}} {
+		var out, errout bytes.Buffer
+		if code := run(tc.args, strings.NewReader(line+"\nmalformed\n"), &out, &errout); code != 0 {
+			t.Fatalf("run exit=%d: %s", code, errout.String())
+		}
+		if !strings.Contains(out.String(), tc.want) || !strings.Contains(strings.ToLower(out.String()), "malformed") {
+			t.Fatalf("unexpected output: %s", out.String())
+		}
+	}
+}
+
+func TestRunBadFlagsAndUnreadableFile(t *testing.T) {
+	var out, errout bytes.Buffer
+	if code := run([]string{"-unknown"}, strings.NewReader(""), &out, &errout); code != 2 {
+		t.Fatalf("bad flag exit=%d", code)
+	}
+	errout.Reset()
+	if code := run([]string{"missing-file-for-loga"}, strings.NewReader(""), &out, &errout); code != 1 {
+		t.Fatalf("missing file exit=%d", code)
+	}
+}
