index 0000000..76e5de7
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,79 @@
+// Package stats aggregates parsed access-log requests.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50MS         float64        `json:"p50_ms"`
+	P95MS         float64        `json:"p95_ms"`
+	P99MS         float64        `json:"p99_ms"`
+	FiveXXPerHour map[string]int `json:"5xx_per_hour"`
+}
+
+// Build creates a report from requests and the number of skipped malformed lines.
+func Build(reqs []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	r := Report{Total: len(reqs), Malformed: malformed, TopPaths: []PathCount{}, StatusClasses: map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}, FiveXXPerHour: map[string]int{}}
+	counts := map[string]int{}
+	durations := make([]float64, 0, len(reqs))
+	for _, q := range reqs {
+		counts[q.Path]++
+		class := q.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			r.StatusClasses[key]++
+		}
+		durations = append(durations, float64(q.Duration)/float64(time.Millisecond))
+		if class == 5 {
+			h := q.Time.Truncate(time.Hour).Format(time.RFC3339)
+			r.FiveXXPerHour[h]++
+		}
+	}
+	for p, n := range counts {
+		r.TopPaths = append(r.TopPaths, PathCount{p, n})
+	}
+	sort.Slice(r.TopPaths, func(i, j int) bool {
+		if r.TopPaths[i].Count == r.TopPaths[j].Count {
+			return r.TopPaths[i].Path < r.TopPaths[j].Path
+		}
+		return r.TopPaths[i].Count > r.TopPaths[j].Count
+	})
+	if len(r.TopPaths) > top {
+		r.TopPaths = r.TopPaths[:top]
+	}
+	sort.Float64s(durations)
+	r.P50MS = percentile(durations, .50)
+	r.P95MS = percentile(durations, .95)
+	r.P99MS = percentile(durations, .99)
+	return r
+}
+
+// percentile uses linear interpolation between adjacent sorted observations.
+func percentile(x []float64, p float64) float64 {
+	if len(x) == 0 {
+		return 0
+	}
+	if len(x) == 1 {
+		return x[0]
+	}
+	pos := p * float64(len(x)-1)
+	lo := int(math.Floor(pos))
+	hi := int(math.Ceil(pos))
+	return x[lo] + (x[hi]-x[lo])*(pos-float64(lo))
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..c150b66
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,56 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func req(path string, status int, d time.Duration, hour int) logparse.Request {
+	return logparse.Request{Path: path, Status: status, Duration: d, Time: time.Date(2026, 10, 10, hour, 20, 0, 0, time.UTC)}
+}
+
+func TestEmpty(t *testing.T) {
+	r := Build(nil, 3, 10)
+	if r.Total != 0 || r.Malformed != 3 || r.P50MS != 0 || len(r.TopPaths) != 0 || r.StatusClasses["5xx"] != 0 {
+		t.Fatalf("unexpected empty report: %+v", r)
+	}
+}
+
+func TestSingleRequest(t *testing.T) {
+	r := Build([]logparse.Request{req("/a", 200, 17*time.Millisecond, 13)}, 0, 10)
+	if r.Total != 1 || r.P50MS != 17 || r.P95MS != 17 || r.P99MS != 17 || r.StatusClasses["2xx"] != 1 || r.TopPaths[0].Path != "/a" {
+		t.Fatalf("unexpected report: %+v", r)
+	}
+}
+
+func TestCountsTopHoursAndPercentiles(t *testing.T) {
+	items := []logparse.Request{req("/b", 500, 0, 13), req("/a", 200, 10*time.Millisecond, 13), req("/a", 404, 20*time.Millisecond, 13), req("/b", 502, 30*time.Millisecond, 14)}
+	r := Build(items, 1, 1)
+	if r.Total != 4 || r.Malformed != 1 || len(r.TopPaths) != 1 || r.TopPaths[0].Path != "/a" || r.StatusClasses["4xx"] != 1 || r.StatusClasses["5xx"] != 2 {
+		t.Fatalf("counts: %+v", r)
+	}
+	if r.P50MS != 15 || abs(r.P95MS-28.5) > 1e-9 || abs(r.P99MS-29.7) > 1e-9 {
+		t.Fatalf("percentiles: %v %v %v", r.P50MS, r.P95MS, r.P99MS)
+	}
+	if r.FiveXXPerHour["2026-10-10T13:00:00Z"] != 1 || r.FiveXXPerHour["2026-10-10T14:00:00Z"] != 1 {
+		t.Fatalf("hours: %#v", r.FiveXXPerHour)
+	}
+}
+
+func abs(v float64) float64 {
+	if v < 0 {
+		return -v
+	}
+	return v
+}
+
+func TestPercentileEdgeCases(t *testing.T) {
+	if percentile(nil, .5) != 0 || percentile([]float64{9}, .99) != 9 {
+		t.Fatal("empty/single percentile incorrect")
+	}
+	if got := percentile([]float64{0, 10}, .5); got != 5 {
+		t.Fatalf("interpolated percentile=%v", got)
+	}
+}
