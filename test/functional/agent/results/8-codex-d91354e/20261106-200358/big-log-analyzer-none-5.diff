index 0000000..ef0e53f
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,86 @@
+// Package logparse parses nginx combined access logs with a trailing request time.
+package logparse
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is the useful, validated data from one access-log record.
+type Request struct {
+	Path     string
+	Status   int
+	Duration time.Duration
+	Time     time.Time
+}
+
+// Parse parses one combined-format line whose final field is seconds elapsed.
+func Parse(line string) (Request, error) {
+	f, err := fields(line)
+	if err != nil {
+		return Request{}, err
+	}
+	if len(f) != 10 {
+		return Request{}, fmt.Errorf("expected 10 fields, got %d", len(f))
+	}
+	t, err := time.Parse("02/Jan/2006:15:04:05 -0700", f[3])
+	if err != nil {
+		return Request{}, fmt.Errorf("invalid timestamp: %w", err)
+	}
+	rq := strings.Fields(f[4])
+	if len(rq) != 3 {
+		return Request{}, fmt.Errorf("invalid request")
+	}
+	path := rq[1]
+	if i := strings.IndexByte(path, '?'); i >= 0 {
+		path = path[:i]
+	}
+	if path == "" {
+		path = "/"
+	}
+	status, err := strconv.Atoi(f[5])
+	if err != nil || status < 100 || status > 599 {
+		return Request{}, fmt.Errorf("invalid status")
+	}
+	secs, err := strconv.ParseFloat(f[9], 64)
+	if err != nil || secs < 0 {
+		return Request{}, fmt.Errorf("invalid request time")
+	}
+	return Request{Path: path, Status: status, Duration: time.Duration(secs * float64(time.Second)), Time: t}, nil
+}
+
+// fields groups quoted and bracketed fields while splitting on whitespace.
+func fields(s string) ([]string, error) {
+	var out []string
+	for i := 0; i < len(s); {
+		for i < len(s) && (s[i] == ' ' || s[i] == '\t' || s[i] == '\r') {
+			i++
+		}
+		if i == len(s) {
+			break
+		}
+		start := i
+		if s[i] == '"' || s[i] == '[' {
+			end := byte('"')
+			if s[i] == '[' {
+				end = ']'
+			}
+			i++
+			for i < len(s) && s[i] != end {
+				i++
+			}
+			if i == len(s) {
+				return nil, fmt.Errorf("unterminated field")
+			}
+			i++
+		} else {
+			for i < len(s) && s[i] != ' ' && s[i] != '\t' && s[i] != '\r' {
+				i++
+			}
+		}
+		out = append(out, strings.Trim(s[start:i], "[]\""))
+	}
+	return out, nil
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
