@@ -0,0 +1,36 @@
+package stats
+
+import (
+	"example.com/app/internal/logparse"
+	"testing"
+	"time"
+)
+
+func TestEmpty(t *testing.T) {
+	r := Analyze(nil, 2, 10)
+	if r.Total != 0 || r.Malformed != 2 || r.P50Millis != 0 || len(r.TopPaths) != 0 {
+		t.Fatalf("unexpected report: %+v", r)
+	}
+	for _, c := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if r.StatusClasses[c] != 0 {
+			t.Fatal(r.StatusClasses)
+		}
+	}
+}
+func TestSingleAndTopAndHourly(t *testing.T) {
+	e := logparse.Entry{Path: "/x", Status: 503, Duration: 25 * time.Millisecond, Time: time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)}
+	r := Analyze([]logparse.Entry{e}, 0, 1)
+	if r.P50Millis != 25 || r.P95Millis != 25 || r.P99Millis != 25 || r.StatusClasses["5xx"] != 1 || len(r.ErrorsPerHour) != 1 || r.ErrorsPerHour[0].Count != 1 {
+		t.Fatalf("unexpected report: %+v", r)
+	}
+}
+func TestPercentileNearestRank(t *testing.T) {
+	var es []logparse.Entry
+	for i := 1; i <= 100; i++ {
+		es = append(es, logparse.Entry{Duration: time.Duration(i) * time.Millisecond, Status: 200})
+	}
+	r := Analyze(es, 0, 10)
+	if r.P50Millis != 50 || r.P95Millis != 95 || r.P99Millis != 99 {
+		t.Fatalf("percentiles = %.0f %.0f %.0f", r.P50Millis, r.P95Millis, r.P99Millis)
+	}
+}
