+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestRunStdinJSON(t *testing.T) {
+	input := `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042` + "\nmalformed\n"
+	var out, errOut bytes.Buffer
+	code := Run([]string{"-json"}, strings.NewReader(input), &out, &errOut)
+	if code != 0 {
+		t.Fatalf("code %d: %s", code, errOut.String())
+	}
+	if !strings.Contains(out.String(), `"total_requests": 1`) || !strings.Contains(out.String(), `"malformed_lines": 1`) {
+		t.Fatal(out.String())
+	}
+}
+func TestRunBadFlags(t *testing.T) {
+	var out, errOut bytes.Buffer
+	if code := Run([]string{"-top", "nope"}, strings.NewReader(""), &out, &errOut); code != 2 {
+		t.Fatalf("code=%d", code)
+	}
+}
