index 0000000..5ef6f06
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,99 @@
+// Package logparse parses nginx combined access log lines with a trailing
+// request duration in seconds.
+package logparse
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Entry is one successfully parsed access log record.
+type Entry struct {
+	Path     string
+	Status   int
+	Duration time.Duration
+	Time     time.Time
+}
+
+// Parse parses a combined-format log line whose final field is request time.
+func Parse(line string) (Entry, error) {
+	fields, err := split(line)
+	if err != nil || len(fields) != 10 {
+		return Entry{}, fmt.Errorf("invalid combined log line")
+	}
+	ts, err := time.Parse("02/Jan/2006:15:04:05 -0700", fields[3])
+	if err != nil {
+		return Entry{}, fmt.Errorf("invalid timestamp: %w", err)
+	}
+	request := strings.Fields(fields[4])
+	if len(request) != 3 {
+		return Entry{}, fmt.Errorf("invalid request")
+	}
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, fmt.Errorf("invalid status")
+	}
+	if fields[6] != "-" {
+		if _, err = strconv.ParseUint(fields[6], 10, 64); err != nil {
+			return Entry{}, fmt.Errorf("invalid bytes")
+		}
+	}
+	seconds, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || seconds < 0 {
+		return Entry{}, fmt.Errorf("invalid request time")
+	}
+	duration := time.Duration(seconds * float64(time.Second))
+	path := strings.SplitN(request[1], "?", 2)[0]
+	return Entry{Path: path, Status: status, Duration: duration, Time: ts}, nil
+}
+
+// split handles quoted fields and backslash escapes within quotes.
+func split(s string) ([]string, error) {
+	var out []string
+	for i := 0; i < len(s); {
+		for i < len(s) && (s[i] == ' ' || s[i] == '\t') {
+			i++
+		}
+		if i == len(s) {
+			break
+		}
+		if s[i] == '"' || s[i] == '[' {
+			open, close := s[i], byte('"')
+			if open == '[' {
+				close = ']'
+			}
+			i++
+			start := i
+			var b strings.Builder
+			for i < len(s) && s[i] != close {
+				if s[i] == '\\' && i+1 < len(s) {
+					b.WriteString(s[start:i])
+					b.WriteByte(s[i+1])
+					i += 2
+					start = i
+					continue
+				}
+				i++
+			}
+			if i == len(s) {
+				return nil, fmt.Errorf("unterminated quoted field")
+			}
+			if b.Len() == 0 {
+				out = append(out, s[start:i])
+			} else {
+				b.WriteString(s[start:i])
+				out = append(out, b.String())
+			}
+			i++
+		} else {
+			start := i
+			for i < len(s) && s[i] != ' ' && s[i] != '\t' {
+				i++
+			}
+			out = append(out, s[start:i])
+		}
+	}
+	return out, nil
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..668d172
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,27 @@
+package logparse
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+const good = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	e, err := Parse(good)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if e.Path != "/api/items" || e.Status != 200 || e.Duration != 42*time.Millisecond || e.Time.Hour() != 13 {
+		t.Fatalf("unexpected entry: %+v", e)
+	}
+}
+func TestMalformed(t *testing.T) {
+	for _, s := range []string{"", "not a log", stringsReplace(good, "0.042", "bad"), stringsReplace(good, `"GET /api/items?id=3 HTTP/1.1"`, `"GET /x"`)} {
+		if _, err := Parse(s); err == nil {
+			t.Errorf("Parse(%q) succeeded", s)
+		}
+	}
+}
+func stringsReplace(s, old, new string) string { return strings.Replace(s, old, new, 1) }
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..4216630
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,86 @@
+// Package stats aggregates parsed access log entries.
+package stats
+
+import (
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50Millis     float64        `json:"p50_ms"`
+	P95Millis     float64        `json:"p95_ms"`
+	P99Millis     float64        `json:"p99_ms"`
+	ErrorsPerHour []HourCount    `json:"5xx_per_hour"`
+}
+
+// Analyze builds a report. Percentiles use nearest-rank (ceil(p*n)).
+func Analyze(entries []logparse.Entry, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	r := Report{Total: len(entries), Malformed: malformed, TopPaths: []PathCount{}, StatusClasses: map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}, ErrorsPerHour: []HourCount{}}
+	paths := map[string]int{}
+	hours := map[string]int{}
+	times := make([]float64, 0, len(entries))
+	for _, e := range entries {
+		paths[e.Path]++
+		class := e.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			r.StatusClasses[key]++
+		}
+		times = append(times, float64(e.Duration)/float64(time.Millisecond))
+		if e.Status >= 500 && e.Status < 600 {
+			h := e.Time.Format("2006-01-02T15:00:00Z07:00")
+			hours[h]++
+		}
+	}
+	for p, n := range paths {
+		r.TopPaths = append(r.TopPaths, PathCount{p, n})
+	}
+	sort.Slice(r.TopPaths, func(i, j int) bool {
+		if r.TopPaths[i].Count == r.TopPaths[j].Count {
+			return r.TopPaths[i].Path < r.TopPaths[j].Path
+		}
+		return r.TopPaths[i].Count > r.TopPaths[j].Count
+	})
+	if len(r.TopPaths) > top {
+		r.TopPaths = r.TopPaths[:top]
+	}
+	for h, n := range hours {
+		r.ErrorsPerHour = append(r.ErrorsPerHour, HourCount{h, n})
+	}
+	sort.Slice(r.ErrorsPerHour, func(i, j int) bool { return r.ErrorsPerHour[i].Hour < r.ErrorsPerHour[j].Hour })
+	sort.Float64s(times)
+	r.P50Millis = percentile(times, .50)
+	r.P95Millis = percentile(times, .95)
+	r.P99Millis = percentile(times, .99)
+	return r
+}
+func percentile(v []float64, p float64) float64 {
+	if len(v) == 0 {
+		return 0
+	}
+	i := int(float64(len(v)) * p)
+	if float64(i) < float64(len(v))*p {
+		i++
+	}
+	if i == 0 {
+		i = 1
+	}
+	return v[i-1]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
