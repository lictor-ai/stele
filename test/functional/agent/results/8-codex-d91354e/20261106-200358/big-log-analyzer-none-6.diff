+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() { os.Exit(Run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)) }
+
+// Run executes the command and returns its process exit code.
+func Run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	asJSON := fs.Bool("json", false, "print JSON report")
+	if err := fs.Parse(args); err != nil || *top < 0 {
+		if err == nil {
+			fmt.Fprintln(stderr, "-top must be non-negative")
+		}
+		return 2
+	}
+	files := fs.Args()
+	var entries []logparse.Entry
+	malformed := 0
+	consume := func(r io.Reader) error {
+		sc := bufio.NewScanner(r)
+		sc.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for sc.Scan() {
+			e, err := logparse.Parse(sc.Text())
+			if err != nil {
+				malformed++
+				continue
+			}
+			entries = append(entries, e)
+		}
+		return sc.Err()
+	}
+	if len(files) == 0 {
+		if err := consume(stdin); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+	} else {
+		for _, name := range files {
+			f, err := os.Open(name)
+			if err != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, err)
+				return 1
+			}
+			err = consume(f)
+			closeErr := f.Close()
+			if err != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, err)
+				return 1
+			}
+			if closeErr != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, closeErr)
+				return 1
+			}
+		}
+	}
+	r := stats.Analyze(entries, malformed, *top)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(r); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+		return 0
+	}
+	fmt.Fprintf(stdout, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", r.Total, r.Malformed)
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(stdout, "%s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintln(stdout, "\nStatus classes\nCLASS\tCOUNT")
+	for _, c := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		fmt.Fprintf(stdout, "%s\t%d\n", c, r.StatusClasses[c])
+	}
+	fmt.Fprintf(stdout, "\nRequest time (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n\n5xx per hour\nHOUR\tCOUNT\n", r.P50Millis, r.P95Millis, r.P99Millis)
+	for _, h := range r.ErrorsPerHour {
+		fmt.Fprintf(stdout, "%s\t%d\n", h.Hour, h.Count)
+	}
+	return 0
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
