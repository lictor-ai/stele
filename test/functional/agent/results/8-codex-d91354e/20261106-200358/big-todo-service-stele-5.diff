+++ b/internal/api/todos.go
@@ -0,0 +1,189 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+type todoStore interface {
+	Create(context.Context, string) (todo.Todo, error)
+	Get(context.Context, string) (todo.Todo, error)
+	Update(context.Context, string, *string, *bool) (todo.Todo, error)
+	Delete(context.Context, string) error
+	List(context.Context, *bool, int, int) ([]todo.Todo, error)
+}
+
+// NewHandler registers the todo API routes.
+func NewHandler(store todoStore) http.Handler {
+	mux := http.NewServeMux()
+	h := handler{store: store}
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return mux
+}
+
+type handler struct {
+	store todoStore
+}
+
+func decode(w http.ResponseWriter, r *http.Request, dst any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if err := d.Decode(dst); err != nil {
+		return err
+	}
+	var extra any
+	if err := d.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+func (h handler) create(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Title string `json:"title"`
+	}
+	if err := decode(w, r, &body); err != nil {
+		Error(w, http.StatusBadRequest, "send a valid JSON body")
+		return
+	}
+	if len([]rune(strings.TrimSpace(body.Title))) < 1 || len([]rune(strings.TrimSpace(body.Title))) > 200 {
+		Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+		return
+	}
+	t, err := h.store.Create(r.Context(), body.Title)
+	if err != nil {
+		log.Error("create todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not create todo")
+		return
+	}
+	JSON(w, http.StatusCreated, t)
+}
+
+func (h handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	var done *bool
+	if v := q.Get("done"); v != "" {
+		b, err := strconv.ParseBool(v)
+		if err != nil {
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+		done = &b
+	}
+	limit := 20
+	if v := q.Get("limit"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 1 || n > 100 {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		limit = n
+	}
+	offset := 0
+	if v := q.Get("offset"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be zero or greater")
+			return
+		}
+		offset = n
+	}
+	items, err := h.store.List(r.Context(), done, limit, offset)
+	if err != nil {
+		log.Error("list todos", "err", err)
+		Error(w, http.StatusInternalServerError, "could not list todos")
+		return
+	}
+	JSON(w, http.StatusOK, items)
+}
+
+func (h handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		log.Error("get todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not get todo")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h handler) update(w http.ResponseWriter, r *http.Request) {
+	var body map[string]json.RawMessage
+	if err := decode(w, r, &body); err != nil || len(body) == 0 {
+		Error(w, http.StatusBadRequest, "send a valid title or done field")
+		return
+	}
+	var title *string
+	var done *bool
+	for key, raw := range body {
+		switch key {
+		case "title":
+			var v string
+			if err := json.Unmarshal(raw, &v); err != nil {
+				Error(w, http.StatusBadRequest, "title must be a string")
+				return
+			}
+			if len([]rune(strings.TrimSpace(v))) < 1 || len([]rune(strings.TrimSpace(v))) > 200 {
+				Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+				return
+			}
+			title = &v
+		case "done":
+			var v bool
+			if err := json.Unmarshal(raw, &v); err != nil {
+				Error(w, http.StatusBadRequest, "done must be a boolean")
+				return
+			}
+			done = &v
+		default:
+			Error(w, http.StatusBadRequest, "unknown field")
+			return
+		}
+	}
+	t, err := h.store.Update(r.Context(), r.PathValue("id"), title, done)
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		log.Error("update todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not update todo")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h handler) delete(w http.ResponseWriter, r *http.Request) {
+	err := h.store.Delete(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		log.Error("delete todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not delete todo")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
