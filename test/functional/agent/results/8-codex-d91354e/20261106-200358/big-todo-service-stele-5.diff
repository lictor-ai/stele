diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..5cd1ffe
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,137 @@
+// Package todo provides an in-memory concurrent todo store.
+package todo
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task with creation and update timestamps.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store holds todos behind a mutex that guards items.
+type Store struct {
+	mu    sync.RWMutex
+	items map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates a store that uses c for timestamps.
+func NewStore(c clock.Clock) *Store {
+	return &Store{items: make(map[string]Todo), clock: c}
+}
+
+// Create stores a todo with a generated identifier.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns a todo by identifier.
+func (s *Store) Get(ctx context.Context, identifier string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	t, ok := s.items[identifier]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the supplied title and done fields.
+func (s *Store) Update(ctx context.Context, identifier string, title *string, done *bool) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[identifier]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		v := strings.TrimSpace(*title)
+		if len([]rune(v)) < 1 || len([]rune(v)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+		t.Title = v
+	}
+	if done != nil {
+		t.Done = *done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.items[identifier] = t
+	return t, nil
+}
+
+// Delete removes a todo.
+func (s *Store) Delete(ctx context.Context, identifier string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[identifier]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, identifier)
+	return nil
+}
+
+// List returns matching todos newest first, with limit and offset pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if limit < 1 || offset < 0 {
+		return nil, ErrInvalid
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.items))
+	for _, t := range s.items {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	end := offset + limit
+	if end < offset || end > len(items) {
+		end = len(items)
+	}
+	return items[offset:end], nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..c49dbf7
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,110 @@
+package todo
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name string
+		run  func(*testing.T)
+	}{
+		{"create get update delete", func(t *testing.T) {
+			store := NewStore(clock.Fixed{T: time.Date(2026, 1, 2, 3, 4, 0, 0, time.UTC)})
+			created, err := store.Create(context.Background(), "  task  ")
+			if err != nil {
+				t.Fatalf("Create() error = %v", err)
+			}
+			if created.Title != "task" {
+				t.Errorf("Create().Title = %q, want task", created.Title)
+			}
+			got, err := store.Get(context.Background(), created.ID)
+			if err != nil || got.ID != created.ID {
+				t.Errorf("Get() = %v, %v; want ID %q", got, err, created.ID)
+			}
+			name := "renamed"
+			done := true
+			got, err = store.Update(context.Background(), created.ID, &name, &done)
+			if err != nil || got.Title != name || !got.Done {
+				t.Errorf("Update() = %v, %v; want renamed and done", got, err)
+			}
+			if err := store.Delete(context.Background(), created.ID); err != nil {
+				t.Errorf("Delete() error = %v, want nil", err)
+			}
+			if _, err := store.Get(context.Background(), created.ID); err != ErrNotFound {
+				t.Errorf("Get(deleted) error = %v, want ErrNotFound", err)
+			}
+		}},
+		{"invalid input and missing id", func(t *testing.T) {
+			store := NewStore(clock.Fixed{T: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)})
+			if _, err := store.Create(context.Background(), "   "); err != ErrInvalid {
+				t.Errorf("Create(empty) error = %v, want ErrInvalid", err)
+			}
+			if _, err := store.Get(context.Background(), "missing"); err != ErrNotFound {
+				t.Errorf("Get(missing) error = %v, want ErrNotFound", err)
+			}
+			if err := store.Delete(context.Background(), "missing"); err != ErrNotFound {
+				t.Errorf("Delete(missing) error = %v, want ErrNotFound", err)
+			}
+		}},
+		{"list filter and pagination", func(t *testing.T) {
+			store := NewStore(clock.Fixed{T: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)})
+			first, _ := store.Create(context.Background(), "first")
+			second, _ := store.Create(context.Background(), "second")
+			done := true
+			_, _ = store.Update(context.Background(), first.ID, nil, &done)
+			all, err := store.List(context.Background(), nil, 1, 0)
+			if err != nil || len(all) != 1 {
+				t.Errorf("List() = %v, %v; want one item", all, err)
+			}
+			filtered, err := store.List(context.Background(), &done, 10, 0)
+			if err != nil || len(filtered) != 1 || filtered[0].ID != first.ID {
+				t.Errorf("List(done=true) = %v, %v; want first todo", filtered, err)
+			}
+			beyond, _ := store.List(context.Background(), nil, 10, 9)
+			if len(beyond) != 0 {
+				t.Errorf("List(offset beyond results) = %v, want empty", beyond)
+			}
+			if second.ID == "" {
+				t.Fatal("second todo has empty ID")
+			}
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)})
+	const workers = 16
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			created, err := store.Create(context.Background(), "concurrent")
+			if err != nil {
+				t.Errorf("Create() error = %v", err)
+				return
+			}
+			if _, err := store.Get(context.Background(), created.ID); err != nil {
+				t.Errorf("Get() error = %v, want nil", err)
+			}
+			done := true
+			if _, err := store.Update(context.Background(), created.ID, nil, &done); err != nil {
+				t.Errorf("Update() error = %v, want nil", err)
+			}
+		}()
+	}
+	wg.Wait()
+	items, err := store.List(context.Background(), nil, workers, 0)
+	if err != nil || len(items) != workers {
+		t.Errorf("List() returned %d items, %v; want %d", len(items), err, workers)
+	}
+}
