@@ -0,0 +1,84 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	cases := []struct {
+		name, method, path, body string
+		status                   int
+	}{
+		{"create", http.MethodPost, "/todos", `{"title":"task"}`, http.StatusCreated},
+		{"create empty title", http.MethodPost, "/todos", `{"title":"  "}`, http.StatusBadRequest},
+		{"create unknown field", http.MethodPost, "/todos", `{"title":"task","other":1}`, http.StatusBadRequest},
+		{"create malformed", http.MethodPost, "/todos", `{`, http.StatusBadRequest},
+		{"list", http.MethodGet, "/todos", "", http.StatusOK},
+		{"list filter", http.MethodGet, "/todos?done=false&limit=1&offset=0", "", http.StatusOK},
+		{"list bad done", http.MethodGet, "/todos?done=maybe", "", http.StatusBadRequest},
+		{"list bad limit", http.MethodGet, "/todos?limit=101", "", http.StatusBadRequest},
+		{"list bad offset", http.MethodGet, "/todos?offset=-1", "", http.StatusBadRequest},
+		{"get missing", http.MethodGet, "/todos/missing", "", http.StatusNotFound},
+		{"update missing", http.MethodPatch, "/todos/missing", `{"done":true}`, http.StatusNotFound},
+		{"update empty", http.MethodPatch, "/todos/missing", `{}`, http.StatusBadRequest},
+		{"delete missing", http.MethodDelete, "/todos/missing", "", http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			h := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)}))
+			r := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+			w := httptest.NewRecorder()
+			h.ServeHTTP(w, r)
+			if w.Code != tc.status {
+				t.Errorf("%s %s status = %d, want %d; body %s", tc.method, tc.path, w.Code, tc.status, w.Body.String())
+			}
+			if tc.status >= 400 {
+				var envelope map[string]string
+				if err := json.Unmarshal(w.Body.Bytes(), &envelope); err != nil || envelope["error"] == "" {
+					t.Errorf("error response body = %q, want JSON error envelope", w.Body.String())
+				}
+			}
+		})
+	}
+}
+
+func TestTodoRouteLifecycle(t *testing.T) {
+	h := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)}))
+	call := func(method, path, body string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(method, path, strings.NewReader(body))
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		return w
+	}
+	created := call(http.MethodPost, "/todos", `{"title":"task"}`)
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil {
+		t.Fatalf("decode create response: %v", err)
+	}
+	for _, tc := range []struct {
+		name, method, path, body string
+		status                   int
+	}{
+		{"get", http.MethodGet, "/todos/" + item.ID, "", http.StatusOK},
+		{"patch", http.MethodPatch, "/todos/" + item.ID, `{"title":"next","done":true}`, http.StatusOK},
+		{"delete", http.MethodDelete, "/todos/" + item.ID, "", http.StatusNoContent},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			w := call(tc.method, tc.path, tc.body)
+			if w.Code != tc.status {
+				t.Errorf("%s %s status = %d, want %d", tc.method, tc.path, w.Code, tc.status)
+			}
+		})
+	}
+	if call(http.MethodGet, "/todos/"+item.ID, "").Code != http.StatusNotFound {
+		t.Error("GET deleted todo status was not 404")
+	}
+}
