+++ b/internal/todo/todo_test.go
@@ -0,0 +1,66 @@
+package todo
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreCRUDAndList(t *testing.T) {
+	s := NewStoreWithClock(clock.Fixed{T: time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)})
+	a := s.Create(" first ")
+	b := s.Create("second")
+	if a.Title != "first" || a.ID == "" || !a.CreatedAt.Equal(a.UpdatedAt) {
+		t.Fatalf("bad create: %+v", a)
+	}
+	done := true
+	updated, ok := s.Update(a.ID, Changes{Done: &done})
+	if !ok || !updated.Done {
+		t.Fatalf("update: %+v %v", updated, ok)
+	}
+	filter := true
+	list := s.List(&filter, 1, 0)
+	if len(list) != 1 || list[0].ID != a.ID {
+		t.Fatalf("filtered list: %+v", list)
+	}
+	if !s.Delete(b.ID) || s.Delete(b.ID) {
+		t.Fatal("delete result incorrect")
+	}
+	if _, ok := s.Get(b.ID); ok {
+		t.Fatal("deleted todo still exists")
+	}
+	if got := s.List(nil, 1, 1); len(got) != 0 {
+		t.Fatalf("pagination: %+v", got)
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore()
+	const n = 100
+	var wg sync.WaitGroup
+	ids := make(chan string, n)
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) { defer wg.Done(); ids <- s.Create(fmt.Sprintf("task %d", i)).ID }(i)
+	}
+	wg.Wait()
+	close(ids)
+	var workers sync.WaitGroup
+	for id := range ids {
+		workers.Add(1)
+		go func(id string) {
+			defer workers.Done()
+			value := true
+			s.Update(id, Changes{Done: &value})
+			s.Get(id)
+			s.List(nil, 10, 0)
+		}(id)
+	}
+	workers.Wait()
+	if got := s.List(nil, 200, 0); len(got) != n {
+		t.Fatalf("got %d items", len(got))
+	}
+}
