@@ -0,0 +1,60 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("server", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	addr := flags.String("addr", ":8080", "listen address")
+	if err := flags.Parse(args); err != nil {
+		return err
+	}
+	if flags.NArg() != 0 {
+		return fmt.Errorf("unexpected arguments: %v", flags.Args())
+	}
+	server := &http.Server{Addr: *addr, Handler: api.NewHandler(todo.NewStore(clock.Real{})), ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second, WriteTimeout: 10 * time.Second, IdleTimeout: 60 * time.Second}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	serveErr := make(chan error, 1)
+	go func() { serveErr <- server.ListenAndServe() }()
+	select {
+	case <-ctx.Done():
+		shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := server.Shutdown(shutdownCtx); err != nil {
+			return fmt.Errorf("shut down server: %w", err)
+		}
+		err := <-serveErr
+		if err != nil && !errors.Is(err, http.ErrServerClosed) {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	case err := <-serveErr:
+		if errors.Is(err, http.ErrServerClosed) {
+			return nil
+		}
+		return fmt.Errorf("serve HTTP: %w", err)
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..9f886d5
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,141 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// NewHandler creates the HTTP API handler.
+func NewHandler(store *todo.Store) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", createTodo(store))
+	mux.HandleFunc("GET /todos", listTodos(store))
+	mux.HandleFunc("GET /todos/{id}", getTodo(store))
+	mux.HandleFunc("PATCH /todos/{id}", updateTodo(store))
+	mux.HandleFunc("DELETE /todos/{id}", deleteTodo(store))
+	return mux
+}
+
+func createTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title string `json:"title"`
+		}
+		if !decodeBody(w, r, &body) {
+			Error(w, http.StatusBadRequest, "request body must contain a valid title")
+			return
+		}
+		t, err := store.Create(body.Title)
+		if err != nil {
+			Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+			return
+		}
+		JSON(w, http.StatusCreated, t)
+	}
+}
+
+func listTodos(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		q := r.URL.Query()
+		var done *bool
+		if values, ok := q["done"]; ok {
+			if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			v := values[0] == "true"
+			done = &v
+		}
+		limit, err := queryInt(q, "limit", 20)
+		if err != nil || limit < 1 || limit > 100 {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		offset, err := queryInt(q, "offset", 0)
+		if err != nil || offset < 0 {
+			Error(w, http.StatusBadRequest, "offset must be zero or greater")
+			return
+		}
+		JSON(w, http.StatusOK, store.List(done, limit, offset))
+	}
+}
+
+func getTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		t, err := store.Get(r.PathValue("id"))
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func updateTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title *string `json:"title"`
+			Done  *bool   `json:"done"`
+		}
+		if !decodeBody(w, r, &body) || (body.Title == nil && body.Done == nil) {
+			Error(w, http.StatusBadRequest, "provide a valid title and/or done value")
+			return
+		}
+		t, err := store.Update(r.PathValue("id"), body.Title, body.Done)
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		if errors.Is(err, todo.ErrInvalid) {
+			Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func deleteTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if err := store.Delete(r.PathValue("id")); err != nil {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, target any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return false
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return false
+	}
+	return true
+}
+
+func queryInt(values map[string][]string, name string, fallback int) (int, error) {
+	items, ok := values[name]
+	if !ok {
+		return fallback, nil
+	}
+	if len(items) != 1 || strings.TrimSpace(items[0]) == "" {
+		return 0, strconv.ErrSyntax
+	}
+	n, err := strconv.Atoi(items[0])
+	if err != nil {
+		log.Warn("invalid integer query parameter", "name", name, "err", err)
+	}
+	return n, err
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..a617418
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,67 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	store := todo.NewStore(clock.Real{})
+	handler := NewHandler(store)
+	created := request(handler, http.MethodPost, "/todos", `{"title":"task"}`)
+	if created.Code != http.StatusCreated {
+		t.Fatalf("POST /todos status = %d, want %d", created.Code, http.StatusCreated)
+	}
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name, method, path, body string
+		want                     int
+	}{
+		{name: "list", method: "GET", path: "/todos", want: http.StatusOK},
+		{name: "list filtered", method: "GET", path: "/todos?done=false&limit=1&offset=0", want: http.StatusOK},
+		{name: "get", method: "GET", path: "/todos/" + item.ID, want: http.StatusOK},
+		{name: "patch", method: "PATCH", path: "/todos/" + item.ID, body: `{"done":true}`, want: http.StatusOK},
+		{name: "delete", method: "DELETE", path: "/todos/" + item.ID, want: http.StatusNoContent},
+		{name: "missing get", method: "GET", path: "/todos/no-such-id", want: http.StatusNotFound},
+		{name: "missing patch", method: "PATCH", path: "/todos/no-such-id", body: `{"done":true}`, want: http.StatusNotFound},
+		{name: "missing delete", method: "DELETE", path: "/todos/no-such-id", want: http.StatusNotFound},
+		{name: "invalid create empty", method: "POST", path: "/todos", body: `{"title":"  "}`, want: http.StatusBadRequest},
+		{name: "invalid create JSON", method: "POST", path: "/todos", body: `{`, want: http.StatusBadRequest},
+		{name: "unknown field", method: "POST", path: "/todos", body: `{"title":"x","extra":true}`, want: http.StatusBadRequest},
+		{name: "invalid patch empty", method: "PATCH", path: "/todos/no-such-id", body: `{}`, want: http.StatusBadRequest},
+		{name: "invalid patch title", method: "PATCH", path: "/todos/no-such-id", body: `{"title":" "}`, want: http.StatusBadRequest},
+		{name: "invalid done query", method: "GET", path: "/todos?done=maybe", want: http.StatusBadRequest},
+		{name: "invalid limit query", method: "GET", path: "/todos?limit=101", want: http.StatusBadRequest},
+		{name: "invalid offset query", method: "GET", path: "/todos?offset=-1", want: http.StatusBadRequest},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			resp := request(handler, tc.method, tc.path, tc.body)
+			if resp.Code != tc.want {
+				t.Errorf("%s %s status = %d, want %d", tc.method, tc.path, resp.Code, tc.want)
+			}
+			if tc.want == http.StatusBadRequest || tc.want == http.StatusNotFound {
+				var envelope map[string]string
+				if err := json.Unmarshal(resp.Body.Bytes(), &envelope); err != nil || envelope["error"] == "" {
+					t.Errorf("%s %s error body = %q, want JSON error envelope", tc.method, tc.path, resp.Body.String())
+				}
+			}
+		})
+	}
+}
+
+func request(handler http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	recorder := httptest.NewRecorder()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	handler.ServeHTTP(recorder, req)
+	return recorder
+}
