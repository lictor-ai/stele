diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..1a5a923
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,129 @@
+package todo
+
+import (
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task tracked by the service.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	mu    sync.RWMutex // guards todos
+	todos map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates an in-memory store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	if c == nil {
+		c = clock.Real{}
+	}
+	return &Store{todos: make(map[string]Todo), clock: c}
+}
+
+// Create validates and stores a new todo.
+func (s *Store) Create(title string) (Todo, error) {
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.todos[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns a todo by its identifier.
+func (s *Store) Get(id string) (Todo, error) {
+	s.mu.RLock()
+	t, ok := s.todos[id]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes a todo title and/or completion state.
+func (s *Store) Update(id string, title *string, done *bool) (Todo, error) {
+	if title == nil && done == nil {
+		return Todo{}, ErrInvalid
+	}
+	if title != nil {
+		trimmed := strings.TrimSpace(*title)
+		if len([]rune(trimmed)) < 1 || len([]rune(trimmed)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+		title = &trimmed
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.todos[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		t.Title = *title
+	}
+	if done != nil {
+		t.Done = *done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.todos[id] = t
+	return t, nil
+}
+
+// Delete removes a todo.
+func (s *Store) Delete(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.todos[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.todos, id)
+	return nil
+}
+
+// List returns todos newest first, with optional completion filtering and pagination.
+func (s *Store) List(done *bool, limit, offset int) []Todo {
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.todos))
+	for _, t := range s.todos {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset < 0 {
+		offset = 0
+	}
+	if offset >= len(items) {
+		return []Todo{}
+	}
+	items = items[offset:]
+	if limit > 0 && len(items) > limit {
+		items = items[:limit]
+	}
+	return items
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
