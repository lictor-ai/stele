+++ b/internal/todo/store_test.go
@@ -0,0 +1,100 @@
+package todo
+
+import (
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name string
+		run  func(*testing.T)
+	}{
+		{name: "create update list delete", run: func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)})
+			created, err := s.Create("  first  ")
+			if err != nil || created.Title != "first" {
+				t.Fatalf("Create() = %+v, %v; want title first", created, err)
+			}
+			if got, err := s.Get(created.ID); err != nil || got.ID != created.ID {
+				t.Errorf("Get(%q) = %+v, %v; want created todo", created.ID, got, err)
+			}
+			done := true
+			updated, err := s.Update(created.ID, nil, &done)
+			if err != nil || !updated.Done {
+				t.Errorf("Update(%q) = %+v, %v; want done", created.ID, updated, err)
+			}
+			if got := s.List(&done, 1, 0); len(got) != 1 || got[0].ID != created.ID {
+				t.Errorf("List(done) = %+v, want created todo", got)
+			}
+			if err := s.Delete(created.ID); err != nil {
+				t.Errorf("Delete(%q) = %v, want nil", created.ID, err)
+			}
+			if _, err := s.Get(created.ID); err != ErrNotFound {
+				t.Errorf("Get(deleted) error = %v, want ErrNotFound", err)
+			}
+		}},
+		{name: "invalid values", run: func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Now()})
+			for _, title := range []string{"", "  ", string(make([]byte, 201))} {
+				if _, err := s.Create(title); err != ErrInvalid {
+					t.Errorf("Create(%q) error = %v, want ErrInvalid", title, err)
+				}
+			}
+			if _, err := s.Update("missing", nil, nil); err != ErrInvalid {
+				t.Errorf("Update with no fields error = %v, want ErrInvalid", err)
+			}
+			if err := s.Delete("missing"); err != ErrNotFound {
+				t.Errorf("Delete(missing) error = %v, want ErrNotFound", err)
+			}
+		}},
+		{name: "pagination", run: func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Now()})
+			for _, title := range []string{"a", "b", "c"} {
+				if _, err := s.Create(title); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if got := s.List(nil, 1, 1); len(got) != 1 || got[0].Title != "b" {
+				t.Errorf("List(limit 1 offset 1) = %+v, want b", got)
+			}
+			if got := s.List(nil, 1, 5); len(got) != 0 {
+				t.Errorf("List(offset 5) = %+v, want empty", got)
+			}
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore(clock.Fixed{T: time.Now()})
+	const workers = 40
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			created, err := s.Create("parallel")
+			if err != nil {
+				t.Errorf("Create() error = %v, want nil", err)
+				return
+			}
+			if _, err := s.Get(created.ID); err != nil {
+				t.Errorf("Get(%q) error = %v, want nil", created.ID, err)
+			}
+			done := true
+			if _, err := s.Update(created.ID, nil, &done); err != nil {
+				t.Errorf("Update(%q) error = %v, want nil", created.ID, err)
+			}
+		}()
+	}
+	wg.Wait()
+	if got := len(s.List(nil, 100, 0)); got != workers {
+		t.Errorf("List() length = %d, want %d", got, workers)
+	}
+}
