+++ b/internal/logparse/parse_test.go
@@ -0,0 +1,33 @@
+package logparse
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, line   string
+		wantPath     string
+		wantStatus   int
+		wantDuration time.Duration
+		wantErr      bool
+	}{
+		{"single request", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, "/api/items", 200, 42 * time.Millisecond, false},
+		{"empty", "", "", 0, 0, true},
+		{"malformed request", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "bad" 200 1 "-" "ua" 0.1`, "", 0, 0, true},
+		{"malformed time", `203.0.113.9 - - [bad] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`, "", 0, 0, true},
+		{"negative duration", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" -1`, "", 0, 0, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("Parse(%q) error = %v, want error %v", tc.line, err, tc.wantErr)
+			}
+			if err == nil && (got.Path != tc.wantPath || got.Status != tc.wantStatus || got.RequestTime != tc.wantDuration) {
+				t.Errorf("Parse(%q) = %+v, want path %q status %d duration %s", tc.line, got, tc.wantPath, tc.wantStatus, tc.wantDuration)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..8e0aded
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,74 @@
+// Package stats aggregates parsed access log records.
+package stats
+
+import (
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount pairs a path with its request count.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains aggregate access log statistics.
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50           float64        `json:"p50_ms"`
+	P95           float64        `json:"p95_ms"`
+	P99           float64        `json:"p99_ms"`
+	ErrorsPerHour map[string]int `json:"5xx_per_hour"`
+}
+
+// Analyze builds a report from records and a malformed line count.
+func Analyze(records []logparse.Record, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	r := Report{Total: len(records), Malformed: malformed, TopPaths: []PathCount{}, StatusClasses: map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}, ErrorsPerHour: map[string]int{}}
+	paths := make(map[string]int)
+	durations := make([]float64, 0, len(records))
+	for _, record := range records {
+		class := record.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			r.StatusClasses[key]++
+		}
+		if class == 5 {
+			r.ErrorsPerHour[record.Time.UTC().Format("2006-01-02T15:00:00Z")]++
+		}
+		paths[record.Path]++
+		durations = append(durations, float64(record.RequestTime)/float64(time.Millisecond))
+	}
+	for path, count := range paths {
+		r.TopPaths = append(r.TopPaths, PathCount{path, count})
+	}
+	sort.Slice(r.TopPaths, func(i, j int) bool {
+		if r.TopPaths[i].Count == r.TopPaths[j].Count {
+			return r.TopPaths[i].Path < r.TopPaths[j].Path
+		}
+		return r.TopPaths[i].Count > r.TopPaths[j].Count
+	})
+	if len(r.TopPaths) > top {
+		r.TopPaths = r.TopPaths[:top]
+	}
+	sort.Float64s(durations)
+	r.P50 = percentile(durations, .50)
+	r.P95 = percentile(durations, .95)
+	r.P99 = percentile(durations, .99)
+	return r
+}
+
+func percentile(sorted []float64, p float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	index := int(float64(len(sorted)-1)*p + 0.5)
+	return sorted[index]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..8e81803
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,41 @@
+package stats
+
+import (
+	"example.com/app/internal/logparse"
+	"testing"
+	"time"
+)
+
+func TestAnalyze(t *testing.T) {
+	cases := []struct {
+		name                 string
+		records              []logparse.Record
+		top                  int
+		wantTotal, wantPaths int
+		wantP50              float64
+	}{
+		{"empty input", nil, 10, 0, 0, 0},
+		{"single request", []logparse.Record{{Path: "/one", Status: 200, RequestTime: 12 * time.Millisecond}}, 10, 1, 1, 12},
+		{"percentile edges", []logparse.Record{{Path: "/a", RequestTime: 0}, {Path: "/b", RequestTime: 10 * time.Millisecond}, {Path: "/c", RequestTime: 20 * time.Millisecond}, {Path: "/d", RequestTime: 30 * time.Millisecond}}, 2, 4, 2, 20},
+		{"zero top", []logparse.Record{{Path: "/one"}}, 0, 1, 0, 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Analyze(tc.records, 3, tc.top)
+			if got.Total != tc.wantTotal || len(got.TopPaths) != tc.wantPaths || got.P50 != tc.wantP50 || got.Malformed != 3 {
+				t.Errorf("Analyze(...) = total %d paths %d p50 %v malformed %d, want %d %d %v 3", got.Total, len(got.TopPaths), got.P50, got.Malformed, tc.wantTotal, tc.wantPaths, tc.wantP50)
+			}
+		})
+	}
+}
+
+func TestAnalyzeClassesAndHours(t *testing.T) {
+	stamp := time.Date(2026, 10, 10, 13, 20, 0, 0, time.FixedZone("offset", 2*60*60))
+	got := Analyze([]logparse.Record{{Status: 503, Time: stamp}, {Status: 302}, {Status: 404}}, 0, 10)
+	if got.StatusClasses["5xx"] != 1 || got.StatusClasses["3xx"] != 1 || got.StatusClasses["4xx"] != 1 {
+		t.Errorf("status classes = %v, want one each", got.StatusClasses)
+	}
+	if got.ErrorsPerHour["2026-10-10T11:00:00Z"] != 1 {
+		t.Errorf("5xx per hour = %v, want UTC hour count 1", got.ErrorsPerHour)
+	}
+}
