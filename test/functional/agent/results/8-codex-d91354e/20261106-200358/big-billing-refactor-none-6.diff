 )
 
@@ -15,15 +16,46 @@ type Line struct {
 
 // Invoice is a computed invoice.
 type Invoice struct {
-	ID         string    `json:"id"`
-	Customer   string    `json:"customer"`
-	Lines      []Line    `json:"lines"`
-	TotalCents int64     `json:"total_cents"`
-	IssuedAt   time.Time `json:"issued_at"`
+	ID              string    `json:"id"`
+	Customer        string    `json:"customer"`
+	Region          string    `json:"region"`
+	Lines           []Line    `json:"lines"`
+	TotalCents      int64     `json:"total_cents"`
+	DiscountCents   int64     `json:"discount_cents"`
+	TaxCents        int64     `json:"tax_cents"`
+	GrandTotalCents int64     `json:"grand_total_cents"`
+	IssuedAt        time.Time `json:"issued_at"`
+}
+
+// DiscountCode describes either a whole percentage discount (Percent, 1–100)
+// or a fixed amount discount (AmountCents). Set exactly one of those fields. Expiry is
+// inclusive: a code expires when now is after ExpiresAt.
+type DiscountCode struct {
+	Code        string
+	Percent     int64
+	AmountCents int64
+	ExpiresAt   time.Time
+}
+
+// DiscountUsage tracks customer/code pairs already redeemed. Share one usage
+// value across invoice computations that must enforce single use.
+type DiscountUsage struct {
+	mu   sync.Mutex
+	used map[string]map[string]bool
+}
+
+// Options supplies optional invoice region, discount, tax rates, and clock.
+// TaxRates are integer basis points (100 = 1%).
+type Options struct {
+	Region        string
+	Discount      *DiscountCode
+	TaxRates      map[string]int64
+	DiscountUsage *DiscountUsage
+	Now           time.Time
 }
 
 // Compute builds an invoice for a customer.
-func Compute(id, customer string, lines []Line) Invoice {
+func Compute(id, customer string, lines []Line, options ...Options) Invoice {
 	if customer == "" {
 		panic("billing: no customer")
 	}
@@ -31,8 +63,56 @@ func Compute(id, customer string, lines []Line) Invoice {
 	for _, l := range lines {
 		total += int64(l.Quantity) * l.UnitCents
 	}
+	var opts Options
+	if len(options) > 0 {
+		opts = options[0]
+	}
+	now := opts.Now
+	if now.IsZero() {
+		now = time.Now()
+	}
+	discount := int64(0)
+	if code := opts.Discount; code != nil && validDiscount(*code) && (code.ExpiresAt.IsZero() || !now.After(code.ExpiresAt)) {
+		if opts.DiscountUsage == nil || opts.DiscountUsage.redeem(code.Code, customer) {
+			if code.Percent > 0 {
+				// Round percentage cents to the nearest cent, with halves up.
+				discount = (total*code.Percent + 50) / 100
+			} else {
+				discount = code.AmountCents
+			}
+			if discount > total {
+				discount = total
+			}
+		}
+	}
+	if discount < 0 {
+		discount = 0
+	}
+	taxable := total - discount
+	rate := opts.TaxRates[opts.Region]
+	tax := (taxable*rate + 5000) / 10000
 	fmt.Printf("computed invoice %s for %s: %d\n", id, customer, total)
-	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, IssuedAt: time.Now()}
+	return Invoice{ID: id, Customer: customer, Region: opts.Region, Lines: lines, TotalCents: total, DiscountCents: discount, TaxCents: tax, GrandTotalCents: taxable + tax, IssuedAt: now}
+}
+
+func validDiscount(d DiscountCode) bool {
+	return d.Code != "" && ((d.Percent > 0 && d.Percent <= 100 && d.AmountCents == 0) || (d.Percent == 0 && d.AmountCents > 0))
+}
+
+func (u *DiscountUsage) redeem(code, customer string) bool {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	if u.used == nil {
+		u.used = make(map[string]map[string]bool)
+	}
+	if u.used[code] != nil && u.used[code][customer] {
+		return false
+	}
+	if u.used[code] == nil {
+		u.used[code] = make(map[string]bool)
+	}
+	u.used[code][customer] = true
+	return true
 }
 
 // Describe returns a one-line summary of an invoice.
