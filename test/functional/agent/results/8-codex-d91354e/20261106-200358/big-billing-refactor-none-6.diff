+func TestDiscounts(t *testing.T) {
+	now := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	usage := &DiscountUsage{}
+	lines := []Line{{Quantity: 1, UnitCents: 101}}
+	percent := DiscountCode{Code: "HALF", Percent: 50, ExpiresAt: now}
+	inv := Compute("a", "cust", lines, Options{Discount: &percent, DiscountUsage: usage, Now: now})
+	if inv.DiscountCents != 51 {
+		t.Fatalf("percent discount = %d, want 51", inv.DiscountCents)
+	}
+	// Expired codes do not apply or consume a redemption.
+	expired := DiscountCode{Code: "OLD", AmountCents: 20, ExpiresAt: now.Add(-time.Second)}
+	if got := Compute("b", "cust", lines, Options{Discount: &expired, DiscountUsage: usage, Now: now}).DiscountCents; got != 0 {
+		t.Fatalf("expired discount = %d", got)
+	}
+	fixed := DiscountCode{Code: "ONCE", AmountCents: 20}
+	opts := Options{Discount: &fixed, DiscountUsage: usage, Now: now}
+	if got := Compute("c", "cust", lines, opts).DiscountCents; got != 20 {
+		t.Fatalf("first redemption = %d", got)
+	}
+	if got := Compute("d", "cust", lines, opts).DiscountCents; got != 0 {
+		t.Fatalf("reuse discount = %d", got)
+	}
+	if got := Compute("e", "other", lines, opts).DiscountCents; got != 20 {
+		t.Fatalf("other customer discount = %d", got)
+	}
+	tooLarge := DiscountCode{Code: "BIG", AmountCents: 1000}
+	if got := Compute("f", "cust", lines, Options{Discount: &tooLarge, Now: now}).DiscountCents; got != 101 {
+		t.Fatalf("discount floor = %d, want 101", got)
+	}
+}
+
+func TestTaxAndCSV(t *testing.T) {
+	issued := time.Date(2025, 3, 4, 5, 6, 7, 0, time.UTC)
+	d := DiscountCode{Code: "TEN", Percent: 10}
+	inv := Compute("id,1", "Acme", []Line{{Quantity: 1, UnitCents: 1001}}, Options{Region: "FR", Discount: &d, TaxRates: map[string]int64{"FR": 2000}, Now: issued})
+	if inv.DiscountCents != 100 || inv.TaxCents != 180 || inv.GrandTotalCents != 1081 {
+		t.Fatalf("unexpected invoice amounts: %+v", inv)
+	}
+	var out bytes.Buffer
+	if err := WriteCSV(&out, []Invoice{inv}); err != nil {
+		t.Fatal(err)
+	}
+	got := out.String()
+	for _, part := range []string{"id,customer,region,issued_at,total,discount,tax,grand_total", "\"id,1\",Acme,FR,2025-03-04T05:06:07Z,1001,100,180,1081"} {
+		if !strings.Contains(got, part) {
+			t.Fatalf("CSV missing %q: %s", part, got)
+		}
+	}
+}
diff --git a/internal/billing/export.go b/internal/billing/export.go
new file mode 100644
index 0000000..d5e9a28
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,23 @@
+package billing
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+)
+
+// WriteCSV writes invoice totals in cents, with issued_at formatted as RFC 3339.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	if err := cw.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return err
+	}
+	for _, inv := range invoices {
+		row := []string{inv.ID, inv.Customer, inv.Region, inv.IssuedAt.Format("2006-01-02T15:04:05Z07:00"), strconv.FormatInt(inv.TotalCents, 10), strconv.FormatInt(inv.DiscountCents, 10), strconv.FormatInt(inv.TaxCents, 10), strconv.FormatInt(inv.GrandTotalCents, 10)}
+		if err := cw.Write(row); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
