index 0000000..aa6ac20
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,126 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+type exitError struct {
+	code int
+	err  error
+}
+
+func (e exitError) Error() string { return e.err.Error() }
+func (e exitError) Unwrap() error { return e.err }
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		var coded exitError
+		if errors.As(err, &coded) {
+			os.Exit(coded.code)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	jsonOutput := fs.Bool("json", false, "write JSON output")
+	if err := fs.Parse(args); err != nil {
+		return exitError{2, err}
+	}
+	if *top < 0 {
+		return exitError{2, fmt.Errorf("-top must be non-negative")}
+	}
+	files := fs.Args()
+	var records []logparse.Record
+	malformed := 0
+	consume := func(reader io.Reader) error {
+		scanner := bufio.NewScanner(reader)
+		scanner.Buffer(make([]byte, 4096), 1024*1024)
+		for scanner.Scan() {
+			record, err := logparse.Parse(scanner.Text())
+			if err != nil {
+				malformed++
+			} else {
+				records = append(records, record)
+			}
+		}
+		return scanner.Err()
+	}
+	if len(files) == 0 {
+		if err := consume(os.Stdin); err != nil {
+			return exitError{1, fmt.Errorf("read stdin: %w", err)}
+		}
+	} else {
+		for _, name := range files {
+			f, err := os.Open(name)
+			if err != nil {
+				return exitError{1, fmt.Errorf("read %s: %w", name, err)}
+			}
+			scanErr := consume(f)
+			closeErr := f.Close()
+			if scanErr != nil {
+				return exitError{1, fmt.Errorf("read %s: %w", name, scanErr)}
+			}
+			if closeErr != nil {
+				return exitError{1, fmt.Errorf("close %s: %w", name, closeErr)}
+			}
+		}
+	}
+	report := stats.Build(records, malformed, *top)
+	if *jsonOutput {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(report); err != nil {
+			return err
+		}
+		return nil
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(w io.Writer, r stats.Report) error {
+	if _, err := fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", r.Total, r.Malformed); err != nil {
+		return err
+	}
+	for _, p := range r.TopPaths {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", p.Path, p.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(w, "\nStatus class\tCOUNT"); err != nil {
+		return err
+	}
+	for _, key := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", key, r.StatusClasses[key]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(w, "\nRequest time (ms)\nP50\t%.3f\nP95\t%.3f\nP99\t%.3f\n\n5xx errors per hour\nHOUR\tCOUNT\n", r.P50, r.P95, r.P99); err != nil {
+		return err
+	}
+	hours := make([]string, 0, len(r.ErrorsPerHour))
+	for hour := range r.ErrorsPerHour {
+		hours = append(hours, hour)
+	}
+	sort.Strings(hours)
+	for _, hour := range hours {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", hour, r.ErrorsPerHour[hour]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
