+func TestDiscountExpiryReuseFloorAndRounding(t *testing.T) {
+	tracker := &DiscountTracker{}
+	now := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	expiry := now.Add(-time.Second)
+	inv := Invoice{Customer: "a", TotalCents: 101}
+	if err := tracker.ApplyDiscount(&inv, DiscountCode{Code: "expired", AmountCents: 10, ExpiresAt: &expiry}, now); err == nil {
+		t.Fatal("expired code accepted")
+	}
+	code := DiscountCode{Code: "ten", Percent: 10}
+	if err := tracker.ApplyDiscount(&inv, code, now); err != nil {
+		t.Fatal(err)
+	}
+	if inv.DiscountCents != 10 {
+		t.Fatalf("rounded discount = %d, want 10", inv.DiscountCents)
+	}
+	again := Invoice{Customer: "a", TotalCents: 100}
+	if err := tracker.ApplyDiscount(&again, code, now); err == nil {
+		t.Fatal("reused code accepted")
+	}
+	other := Invoice{Customer: "b", TotalCents: 4}
+	if err := tracker.ApplyDiscount(&other, DiscountCode{Code: "big", AmountCents: 99}, now); err != nil {
+		t.Fatal(err)
+	}
+	if other.DiscountCents != 4 {
+		t.Fatalf("discount floor = %d, want 4", other.DiscountCents)
+	}
+}
