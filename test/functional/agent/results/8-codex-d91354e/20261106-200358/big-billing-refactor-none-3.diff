+}
+
+// DiscountCode applies either a whole-number percentage (0-100) or fixed cents.
+// Exactly one of Percent and AmountCents must be positive.
+type DiscountCode struct {
+	Code        string
+	Percent     int
+	AmountCents int64
+	ExpiresAt   *time.Time
+}
+
+// DiscountTracker records successful uses, once per customer and code.
+type DiscountTracker struct {
+	mu   sync.Mutex
+	used map[string]map[string]bool
+}
+
+// ApplyDiscount validates and applies code to an invoice. now is supplied by
+// the caller to make expiry behavior deterministic.
+func (t *DiscountTracker) ApplyDiscount(inv *Invoice, code DiscountCode, now time.Time) error {
+	if inv == nil {
+		return fmt.Errorf("billing: nil invoice")
+	}
+	if code.Code == "" || (code.Percent > 0) == (code.AmountCents > 0) || code.Percent < 0 || code.Percent > 100 || code.AmountCents < 0 {
+		return fmt.Errorf("billing: invalid discount code")
+	}
+	if code.ExpiresAt != nil && now.After(*code.ExpiresAt) {
+		return fmt.Errorf("billing: discount code expired")
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.used != nil && t.used[code.Code][inv.Customer] {
+		return fmt.Errorf("billing: discount code already used by customer")
+	}
+	var discount int64
+	if code.Percent > 0 {
+		discount = int64(math.Floor(float64(inv.TotalCents)*float64(code.Percent)/100 + 0.5))
+	} else {
+		discount = code.AmountCents
+	}
+	if discount > inv.TotalCents {
+		discount = inv.TotalCents
+	}
+	inv.DiscountCents = discount
+	if t.used == nil {
+		t.used = make(map[string]map[string]bool)
+	}
+	if t.used[code.Code] == nil {
+		t.used[code.Code] = make(map[string]bool)
+	}
+	t.used[code.Code][inv.Customer] = true
+	return nil
+}
+
+// Options supplies optional invoice region, discounts, and tax rates.
+type Options struct {
+	Region          string
+	TaxRates        map[string]int // basis points, where 10000 is 100%
+	Discount        *DiscountCode
+	DiscountTracker *DiscountTracker
+	Now             time.Time
+}
+
+// ComputeWithOptions computes an invoice with optional discount and regional tax.
+func ComputeWithOptions(id, customer string, lines []Line, opts Options) (Invoice, error) {
+	inv := Compute(id, customer, lines)
+	inv.Region = opts.Region
+	if opts.Discount != nil {
+		if opts.DiscountTracker == nil {
+			return Invoice{}, fmt.Errorf("billing: discount tracker required")
+		}
+		now := opts.Now
+		if now.IsZero() {
+			now = time.Now()
+		}
+		if err := opts.DiscountTracker.ApplyDiscount(&inv, *opts.Discount, now); err != nil {
+			return Invoice{}, err
+		}
+	}
+	taxable := inv.TotalCents - inv.DiscountCents
+	if rate := opts.TaxRates[opts.Region]; rate > 0 {
+		inv.TaxCents = int64(math.Floor(float64(taxable)*float64(rate)/10000 + 0.5))
+	}
+	inv.GrandTotalCents = taxable + inv.TaxCents
+	return inv, nil
 }
 
 // Compute builds an invoice for a customer.
