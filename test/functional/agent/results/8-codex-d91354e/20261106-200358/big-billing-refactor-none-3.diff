index 0000000..f0f94b3
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,27 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// WriteCSV writes invoices with monetary values represented in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	c := csv.NewWriter(w)
+	if err := c.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return err
+	}
+	for _, inv := range invoices {
+		grand := inv.GrandTotalCents
+		if grand == 0 && inv.TotalCents != inv.DiscountCents+inv.TaxCents {
+			grand = inv.TotalCents - inv.DiscountCents + inv.TaxCents
+		}
+		record := []string{inv.ID, inv.Customer, inv.Region, inv.IssuedAt.Format("2006-01-02T15:04:05Z07:00"), fmt.Sprint(inv.TotalCents), fmt.Sprint(inv.DiscountCents), fmt.Sprint(inv.TaxCents), fmt.Sprint(grand)}
+		if err := c.Write(record); err != nil {
+			return err
+		}
+	}
+	c.Flush()
+	return c.Error()
+}
