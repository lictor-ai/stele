index 0000000..5c91ba4
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,43 @@
+// Package logparse parses nginx combined access log entries with an appended request time.
+package logparse
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+var linePattern = regexp.MustCompile(`^\S+ \S+ \S+ \[([^]]+)\] "([^" ]+) ([^" ]+)(?: ([^"]+))?" (\d{3}) (\S+) "(?:[^"\\]|\\.)*" "(?:[^"\\]|\\.)*" (\S+)\s*$`)
+
+// Request is one successfully parsed access log entry.
+type Request struct {
+	Time     time.Time
+	Path     string
+	Status   int
+	Duration time.Duration
+}
+
+// Parse parses a combined-format line with request time in seconds as its final field.
+func Parse(line string) (Request, error) {
+	m := linePattern.FindStringSubmatch(line)
+	if m == nil {
+		return Request{}, fmt.Errorf("invalid combined access log line")
+	}
+	t, err := time.Parse("02/Jan/2006:15:04:05 -0700", m[1])
+	if err != nil {
+		return Request{}, fmt.Errorf("invalid timestamp: %w", err)
+	}
+	status, err := strconv.Atoi(m[5])
+	if err != nil {
+		return Request{}, fmt.Errorf("invalid status: %w", err)
+	}
+	seconds, err := strconv.ParseFloat(m[7], 64)
+	if err != nil || seconds < 0 {
+		return Request{}, fmt.Errorf("invalid request time %q", m[7])
+	}
+	d := time.Duration(seconds * float64(time.Second))
+	path, _, _ := strings.Cut(m[3], "?")
+	return Request{Time: t, Path: path, Status: status, Duration: d}, nil
+}
