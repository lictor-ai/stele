+++ b/cmd/loga/main.go
@@ -0,0 +1,105 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"text/tabwriter"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	jsonOutput := fs.Bool("json", false, "print report as JSON")
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	if *top < 0 {
+		fmt.Fprintln(stderr, "-top must not be negative")
+		return 2
+	}
+	files := fs.Args()
+	requests := []logparse.Request{}
+	malformed := 0
+	read := func(name string, input io.Reader) error {
+		s := bufio.NewScanner(input)
+		s.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for s.Scan() {
+			q, err := logparse.Parse(s.Text())
+			if err != nil {
+				malformed++
+			} else {
+				requests = append(requests, q)
+			}
+		}
+		return s.Err()
+	}
+	if len(files) == 0 {
+		if err := read("stdin", stdin); err != nil {
+			fmt.Fprintln(stderr, "stdin:", err)
+			return 1
+		}
+	} else {
+		for _, name := range files {
+			f, err := os.Open(name)
+			if err != nil {
+				fmt.Fprintln(stderr, name+":", err)
+				return 1
+			}
+			err = read(name, f)
+			closeErr := f.Close()
+			if err == nil {
+				err = closeErr
+			}
+			if err != nil {
+				fmt.Fprintln(stderr, name+":", err)
+				return 1
+			}
+		}
+	}
+	r := stats.Aggregate(requests, malformed, *top)
+	if *jsonOutput {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(r); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+		return 0
+	}
+	w := tabwriter.NewWriter(stdout, 0, 4, 2, ' ', 0)
+	fmt.Fprintf(w, "Total requests\t%d\nMalformed lines\t%d\n", r.Total, r.Malformed)
+	fmt.Fprintf(w, "Status class\tCount\n")
+	for _, k := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		fmt.Fprintf(w, "%s\t%d\n", k, r.StatusClasses[k])
+	}
+	fmt.Fprintf(w, "p50 (ms)\t%.3f\np95 (ms)\t%.3f\np99 (ms)\t%.3f\n", r.P50MS, r.P95MS, r.P99MS)
+	fmt.Fprintln(w, "Top paths\tCount")
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(w, "%s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintln(w, "5xx errors per hour\tCount")
+	hours := make([]string, 0, len(r.ErrorsPerHour))
+	for h := range r.ErrorsPerHour {
+		hours = append(hours, h)
+	}
+	sort.Strings(hours)
+	for _, h := range hours {
+		fmt.Fprintf(w, "%s\t%d\n", h, r.ErrorsPerHour[h])
+	}
+	if err := w.Flush(); err != nil {
+		fmt.Fprintln(stderr, err)
+		return 1
+	}
+	return 0
+}
+
+func main() { os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)) }
