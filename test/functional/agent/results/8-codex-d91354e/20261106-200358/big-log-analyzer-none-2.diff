@@ -0,0 +1,29 @@
+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestCommandJSONAndFlags(t *testing.T) {
+	input := `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 500 512 "-" "curl/8.0" 0.042` + "\ninvalid\n"
+	var out, errOut bytes.Buffer
+	code := run([]string{"-json", "-top", "1"}, strings.NewReader(input), &out, &errOut)
+	if code != 0 || !strings.Contains(out.String(), `"total_requests": 1`) || !strings.Contains(out.String(), `"malformed_lines": 1`) || !strings.Contains(out.String(), `"path": "/api/items"`) {
+		t.Fatalf("code=%d stdout=%s stderr=%s", code, out.String(), errOut.String())
+	}
+	if got := run([]string{"-top=-1"}, strings.NewReader(""), &out, &errOut); got != 2 {
+		t.Fatalf("bad top exit code=%d", got)
+	}
+	if got := run([]string{"-not-a-flag"}, strings.NewReader(""), &out, &errOut); got != 2 {
+		t.Fatalf("bad flag exit code=%d", got)
+	}
+}
+
+func TestMissingFile(t *testing.T) {
+	var out, errOut bytes.Buffer
+	if got := run([]string{"missing-loga-test.log"}, strings.NewReader(""), &out, &errOut); got != 1 {
+		t.Fatalf("missing file exit code=%d", got)
+	}
+}
