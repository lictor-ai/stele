index 0000000..44b39dd
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,79 @@
+// Package stats aggregates parsed access log requests.
+package stats
+
+import (
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50MS         float64        `json:"p50_ms"`
+	P95MS         float64        `json:"p95_ms"`
+	P99MS         float64        `json:"p99_ms"`
+	ErrorsPerHour map[string]int `json:"errors_per_hour"`
+}
+
+// Aggregate builds a report from requests and the count of malformed lines.
+func Aggregate(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	r := Report{Total: len(requests), Malformed: malformed, TopPaths: []PathCount{}, StatusClasses: map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}, ErrorsPerHour: map[string]int{}}
+	paths := map[string]int{}
+	durations := make([]time.Duration, 0, len(requests))
+	for _, q := range requests {
+		paths[q.Path]++
+		class := q.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			r.StatusClasses[key]++
+		}
+		if q.Status >= 500 && q.Status <= 599 {
+			key := q.Time.Format("2006-01-02T15:00:00Z07:00")
+			r.ErrorsPerHour[key]++
+		}
+		durations = append(durations, q.Duration)
+	}
+	for p, c := range paths {
+		r.TopPaths = append(r.TopPaths, PathCount{p, c})
+	}
+	sort.Slice(r.TopPaths, func(i, j int) bool {
+		if r.TopPaths[i].Count == r.TopPaths[j].Count {
+			return r.TopPaths[i].Path < r.TopPaths[j].Path
+		}
+		return r.TopPaths[i].Count > r.TopPaths[j].Count
+	})
+	if len(r.TopPaths) > top {
+		r.TopPaths = r.TopPaths[:top]
+	}
+	sort.Slice(durations, func(i, j int) bool { return durations[i] < durations[j] })
+	r.P50MS = percentile(durations, .50)
+	r.P95MS = percentile(durations, .95)
+	r.P99MS = percentile(durations, .99)
+	return r
+}
+
+// percentile uses nearest-rank (ceil(p*n)); an empty sample has percentile zero.
+func percentile(sorted []time.Duration, p float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	i := int(float64(len(sorted))*p+.999999999) - 1
+	if i < 0 {
+		i = 0
+	}
+	if i >= len(sorted) {
+		i = len(sorted) - 1
+	}
+	return float64(sorted[i]) / float64(time.Millisecond)
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
