@@ -0,0 +1,26 @@
+package logparse
+
+import (
+	"testing"
+	"time"
+)
+
+const sample = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	r, err := Parse(sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.Path != "/api/items" || r.Status != 200 || r.Duration != 42*time.Millisecond || r.Time.UTC().Hour() != 13 {
+		t.Fatalf("unexpected request: %#v", r)
+	}
+}
+
+func TestMalformedLines(t *testing.T) {
+	for _, line := range []string{"", "not a log", sample + " trailing", `203.0.113.9 - - [bad] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`, `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" nope`} {
+		if _, err := Parse(line); err == nil {
+			t.Errorf("Parse(%q) succeeded", line)
+		}
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
