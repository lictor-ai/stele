+++ b/internal/stats/stats_test.go
@@ -0,0 +1,39 @@
+package stats
+
+import (
+	"example.com/app/internal/logparse"
+	"testing"
+	"time"
+)
+
+func req(path string, status int, sec int, ms int) logparse.Request {
+	return logparse.Request{Path: path, Status: status, Time: time.Date(2026, 10, 10, 13, sec, 0, 0, time.UTC), Duration: time.Duration(ms) * time.Millisecond}
+}
+
+func TestEmptyInput(t *testing.T) {
+	r := Aggregate(nil, 3, 10)
+	if r.Total != 0 || r.Malformed != 3 || r.P50MS != 0 || len(r.TopPaths) != 0 || r.StatusClasses["2xx"] != 0 {
+		t.Fatalf("unexpected empty report: %#v", r)
+	}
+}
+
+func TestSingleRequest(t *testing.T) {
+	r := Aggregate([]logparse.Request{req("/one", 200, 5, 42)}, 0, 10)
+	if r.Total != 1 || r.P50MS != 42 || r.P95MS != 42 || r.P99MS != 42 || r.TopPaths[0].Path != "/one" {
+		t.Fatalf("unexpected report: %#v", r)
+	}
+}
+
+func TestPercentileEdgesAndAggregates(t *testing.T) {
+	items := []logparse.Request{req("/b", 200, 5, 10), req("/a", 301, 5, 20), req("/b", 404, 5, 30), req("/c", 500, 5, 40), req("/c", 503, 5, 50)}
+	r := Aggregate(items, 1, 2)
+	if r.P50MS != 30 || r.P95MS != 50 || r.P99MS != 50 {
+		t.Fatalf("unexpected percentiles: %#v", r)
+	}
+	if r.Total != 5 || r.Malformed != 1 || r.StatusClasses["2xx"] != 1 || r.StatusClasses["3xx"] != 1 || r.StatusClasses["4xx"] != 1 || r.StatusClasses["5xx"] != 2 {
+		t.Fatalf("unexpected counts: %#v", r)
+	}
+	if len(r.TopPaths) != 2 || r.TopPaths[0].Path != "/b" || r.TopPaths[1].Path != "/c" || r.ErrorsPerHour["2026-10-10T13:00:00Z"] != 2 {
+		t.Fatalf("unexpected grouping: %#v", r)
+	}
+}
