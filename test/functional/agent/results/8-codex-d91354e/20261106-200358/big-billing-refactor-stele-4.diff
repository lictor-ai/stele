+	for _, line := range lines {
+		if line.Quantity < 0 || line.UnitCents < 0 {
+			return Invoice{}, fmt.Errorf("invalid line %q: %w", line.SKU, ErrInvalidLine)
+		}
+		amount := int64(line.Quantity) * line.UnitCents
+		if line.Quantity != 0 && amount/int64(line.Quantity) != line.UnitCents || total > math.MaxInt64-amount {
+			return Invoice{}, ErrAmountOverflow
+		}
+		total += amount
