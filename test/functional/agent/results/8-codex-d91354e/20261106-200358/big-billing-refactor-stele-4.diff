+func TestDiscounts(t *testing.T) {
+	now := time.Date(2026, time.January, 2, 0, 0, 0, 0, time.UTC)
+	cases := []struct {
+		name    string
+		code    DiscountCode
+		amount  int64
+		want    int64
+		wantErr error
+	}{
+		{name: "expired", code: DiscountCode{Code: "old", AmountCents: 10, ExpiresAt: timePtr(now.Add(-time.Second))}, amount: 100, wantErr: ErrDiscountExpired},
+		{name: "fixed floors at zero", code: DiscountCode{Code: "large", AmountCents: 200}, amount: 100, want: 100},
+		{name: "percentage rounds half away", code: DiscountCode{Code: "half", PercentBasisPoints: 5000}, amount: 101, want: 51},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			usage := &DiscountUsage{}
+			invoice, err := ComputeWithOptions("i", "c", []Line{{Quantity: 1, UnitCents: tc.amount}}, ComputeOptions{Discount: &tc.code, Usage: usage, Clock: clock.Fixed{T: now}})
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("ComputeWithOptions error = %v, want %v", err, tc.wantErr)
+			}
+			if err == nil && invoice.DiscountCents != tc.want {
+				t.Errorf("discount = %d, want %d", invoice.DiscountCents, tc.want)
+			}
+		})
+	}
+	usage := &DiscountUsage{}
+	code := DiscountCode{Code: "once", AmountCents: 1}
+	for i, customer := range []string{"c", "c", "another"} {
+		_, err := ComputeWithOptions("i", customer, []Line{{Quantity: 1, UnitCents: 100}}, ComputeOptions{Discount: &code, Usage: usage, Clock: clock.Fixed{T: now}})
+		wantErr := error(nil)
+		if i == 1 {
+			wantErr = ErrDiscountAlreadyUsed
+		}
+		if !errors.Is(err, wantErr) {
+			t.Errorf("ComputeWithOptions reuse error = %v, want %v", err, wantErr)
+		}
+	}
+}
