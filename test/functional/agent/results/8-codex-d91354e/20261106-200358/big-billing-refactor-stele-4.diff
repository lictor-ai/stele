+
+func discountAmount(code DiscountCode, total int64, now time.Time) (int64, error) {
+	if code.Code == "" {
+		return 0, ErrInvalidDiscount
+	}
+	if code.ExpiresAt != nil && now.After(*code.ExpiresAt) {
+		return 0, ErrDiscountExpired
+	}
+	if code.PercentBasisPoints != 0 && code.AmountCents != 0 || code.PercentBasisPoints < 0 || code.PercentBasisPoints > 10000 || code.AmountCents < 0 {
+		return 0, ErrInvalidDiscount
+	}
+	if code.PercentBasisPoints == 0 && code.AmountCents == 0 {
+		return 0, ErrInvalidDiscount
+	}
+	if code.PercentBasisPoints != 0 {
+		return roundedBasisPoints(total, code.PercentBasisPoints)
+	}
+	return code.AmountCents, nil
+}
+
+func roundedBasisPoints(amount, basisPoints int64) (int64, error) {
+	if amount != 0 && basisPoints > math.MaxInt64/amount {
+		return 0, ErrAmountOverflow
+	}
+	product := amount * basisPoints
+	quotient, remainder := product/10000, product%10000
+	if remainder >= 5000 {
+		quotient++
+	}
+	return quotient, nil
+}
+
+func (usage *DiscountUsage) claim(code, customer string) error {
