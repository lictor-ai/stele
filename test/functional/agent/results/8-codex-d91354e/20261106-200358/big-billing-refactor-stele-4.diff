+	rate, ok := options.TaxRates[options.Region]
+	if options.Region != "" && !ok {
+		return Invoice{}, fmt.Errorf("region %q: %w", options.Region, ErrUnknownRegion)
+	}
+	if rate < 0 || rate > 100000 {
+		return Invoice{}, fmt.Errorf("region %q tax rate: %w", options.Region, ErrInvalidTaxRate)
+	}
+	if options.Discount != nil && options.Usage == nil {
+		return Invoice{}, ErrUsageTrackerRequired
+	}
+	tax, err := roundedBasisPoints(total-discount, rate)
+	if err != nil {
+		return Invoice{}, err
+	}
+	if total-discount > math.MaxInt64-tax {
+		return Invoice{}, ErrAmountOverflow
+	}
+	if options.Discount != nil {
+		if err := options.Usage.claim(options.Discount.Code, customer); err != nil {
+			return Invoice{}, err
+		}
