+++ b/internal/billing/errors.go
@@ -0,0 +1,24 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrNoCustomer means the invoice has no customer.
+	ErrNoCustomer = errors.New("billing: no customer")
+	// ErrInvalidLine means an invoice line has a negative quantity or price.
+	ErrInvalidLine = errors.New("billing: invalid line")
+	// ErrAmountOverflow means an invoice amount exceeds int64.
+	ErrAmountOverflow = errors.New("billing: amount overflow")
+	// ErrInvalidDiscount means a discount code is malformed.
+	ErrInvalidDiscount = errors.New("billing: invalid discount")
+	// ErrDiscountExpired means the discount code has expired.
+	ErrDiscountExpired = errors.New("billing: discount expired")
+	// ErrDiscountAlreadyUsed means this customer already used this code.
+	ErrDiscountAlreadyUsed = errors.New("billing: discount already used")
+	// ErrUsageTrackerRequired means discounts need a usage tracker.
+	ErrUsageTrackerRequired = errors.New("billing: discount usage tracker required")
+	// ErrUnknownRegion means no tax rate exists for the invoice region.
+	ErrUnknownRegion = errors.New("billing: unknown region")
+	// ErrInvalidTaxRate means the tax rate is outside the supported range.
+	ErrInvalidTaxRate = errors.New("billing: invalid tax rate")
+)
diff --git a/internal/billing/export.go b/internal/billing/export.go
new file mode 100644
index 0000000..9d3e11c
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,37 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+	"time"
+)
+
+// ExportCSV writes invoices as CSV to writer.
+func ExportCSV(writer io.Writer, invoices []Invoice) error {
+	output := csv.NewWriter(writer)
+	if err := output.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return fmt.Errorf("write invoice CSV header: %w", err)
+	}
+	for _, invoice := range invoices {
+		row := []string{
+			invoice.ID,
+			invoice.Customer,
+			invoice.Region,
+			invoice.IssuedAt.Format(time.RFC3339),
+			strconv.FormatInt(invoice.TotalCents, 10),
+			strconv.FormatInt(invoice.DiscountCents, 10),
+			strconv.FormatInt(invoice.TaxCents, 10),
+			strconv.FormatInt(invoice.GrandTotalCents, 10),
+		}
+		if err := output.Write(row); err != nil {
+			return fmt.Errorf("write invoice CSV row %q: %w", invoice.ID, err)
+		}
+	}
+	output.Flush()
+	if err := output.Error(); err != nil {
+		return fmt.Errorf("flush invoice CSV: %w", err)
+	}
+	return nil
+}
