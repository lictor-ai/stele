@@ -0,0 +1,94 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() { os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)) }
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	asJSON := fs.Bool("json", false, "print JSON report")
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	if *top < 0 {
+		fmt.Fprintln(stderr, "-top must be non-negative")
+		return 2
+	}
+	var requests []logparse.Request
+	malformed := 0
+	consume := func(rd io.Reader) error {
+		sc := bufio.NewScanner(rd)
+		sc.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for sc.Scan() {
+			q, e := logparse.ParseLine(sc.Text())
+			if e != nil {
+				malformed++
+				continue
+			}
+			requests = append(requests, q)
+		}
+		return sc.Err()
+	}
+	files := fs.Args()
+	if len(files) == 0 {
+		if err := consume(stdin); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+	} else {
+		for _, name := range files {
+			f, err := os.Open(name)
+			if err != nil {
+				fmt.Fprintln(stderr, err)
+				return 1
+			}
+			err = consume(f)
+			closeErr := f.Close()
+			if err != nil {
+				fmt.Fprintln(stderr, err)
+				return 1
+			}
+			if closeErr != nil {
+				fmt.Fprintln(stderr, closeErr)
+				return 1
+			}
+		}
+	}
+	report := stats.Build(requests, malformed, *top)
+	if *asJSON {
+		if err := json.NewEncoder(stdout).Encode(report); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+		return 0
+	}
+	fmt.Fprintf(stdout, "Total requests: %d\nMalformed lines: %d\n", report.Total, report.Malformed)
+	fmt.Fprintln(stdout, "\nTop paths:")
+	fmt.Fprintln(stdout, "PATH\tCOUNT")
+	for _, p := range report.TopPaths {
+		fmt.Fprintf(stdout, "%s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintln(stdout, "\nStatus classes:")
+	for _, c := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		fmt.Fprintf(stdout, "%s\t%d\n", c, report.StatusClasses[c])
+	}
+	fmt.Fprintf(stdout, "\nRequest time (ms):\np50\t%.3f\np95\t%.3f\np99\t%.3f\n", report.P50MS, report.P95MS, report.P99MS)
+	fmt.Fprintln(stdout, "\n5xx errors per hour:")
+	fmt.Fprintln(stdout, "HOUR\tCOUNT")
+	for _, h := range report.ErrorsPerHour {
+		fmt.Fprintf(stdout, "%s\t%d\n", h.Hour, h.Count)
+	}
+	return 0
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..2603a70
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,51 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const cliLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 500 512 "-" "curl/8.0" 0.042`
+
+func TestRunStdinJSON(t *testing.T) {
+	var out, errout bytes.Buffer
+	code := run([]string{"-json", "-top=2"}, strings.NewReader(cliLine+"\nbad\n"), &out, &errout)
+	if code != 0 {
+		t.Fatalf("exit %d: %s", code, errout.String())
+	}
+	var report struct {
+		Total     int     `json:"total_requests"`
+		Malformed int     `json:"malformed_lines"`
+		P95       float64 `json:"p95_ms"`
+	}
+	if err := json.Unmarshal(out.Bytes(), &report); err != nil {
+		t.Fatal(err)
+	}
+	if report.Total != 1 || report.Malformed != 1 || report.P95 != 42 {
+		t.Fatalf("report %+v", report)
+	}
+}
+
+func TestRunFileAndExitCodes(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "access.log")
+	if err := os.WriteFile(path, []byte(cliLine+"\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var out, errout bytes.Buffer
+	if code := run([]string{path}, strings.NewReader(""), &out, &errout); code != 0 || !strings.Contains(out.String(), "Total requests: 1") {
+		t.Fatalf("exit %d output %q", code, out.String())
+	}
+	out.Reset()
+	errout.Reset()
+	if code := run([]string{filepath.Join(t.TempDir(), "missing")}, nil, &out, &errout); code != 1 {
+		t.Fatalf("read exit = %d", code)
+	}
+	errout.Reset()
+	if code := run([]string{"-top=-1"}, nil, &out, &errout); code != 2 {
+		t.Fatalf("flag exit = %d", code)
+	}
+}
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..ef3d054
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,76 @@
+// Package logparse parses nginx combined access logs with a request-time field.
+package logparse
+
+import (
+	"errors"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is one valid access-log record.
+type Request struct {
+	Path     string
+	Status   int
+	Duration time.Duration
+	Time     time.Time
+}
+
+// ParseLine parses the combined format followed by a duration in seconds.
+func ParseLine(line string) (Request, error) {
+	fields, err := tokenize(strings.TrimSpace(line))
+	if err != nil || len(fields) != 10 {
+		return Request{}, errors.New("invalid access log fields")
+	}
+	tm, err := time.Parse("02/Jan/2006:15:04:05 -0700", strings.Trim(fields[3], "[]"))
+	if err != nil {
+		return Request{}, errors.New("invalid timestamp")
+	}
+	req := strings.Trim(fields[4], `"`)
+	parts := strings.Fields(req)
+	if len(parts) != 3 || !strings.HasPrefix(parts[1], "/") {
+		return Request{}, errors.New("invalid request")
+	}
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return Request{}, errors.New("invalid status")
+	}
+	seconds, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || seconds < 0 || seconds > float64((1<<63-1))/float64(time.Second) {
+		return Request{}, errors.New("invalid request time")
+	}
+	return Request{Path: strings.SplitN(parts[1], "?", 2)[0], Status: status, Duration: time.Duration(seconds * float64(time.Second)), Time: tm}, nil
+}
+
+func tokenize(s string) ([]string, error) {
+	var out []string
+	for i := 0; i < len(s); {
+		for i < len(s) && s[i] == ' ' {
+			i++
+		}
+		if i == len(s) {
+			break
+		}
+		start := i
+		if s[i] == '"' || s[i] == '[' {
+			close := byte('"')
+			if s[i] == '[' {
+				close = ']'
+			}
+			i++
+			for i < len(s) && s[i] != close {
+				i++
+			}
+			if i == len(s) {
+				return nil, errors.New("unterminated field")
+			}
+			i++
+		} else {
+			for i < len(s) && s[i] != ' ' {
+				i++
+			}
+		}
+		out = append(out, s[start:i])
+	}
+	return out, nil
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
