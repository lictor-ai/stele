+++ b/internal/stats/stats_test.go
@@ -0,0 +1,31 @@
+package stats
+
+import (
+	"example.com/app/internal/logparse"
+	"testing"
+	"time"
+)
+
+func TestEmpty(t *testing.T) {
+	r := Build(nil, 3, 10)
+	if r.Total != 0 || r.Malformed != 3 || r.P50MS != 0 || len(r.TopPaths) != 0 || len(r.ErrorsPerHour) != 0 {
+		t.Fatalf("empty report: %+v", r)
+	}
+}
+
+func TestSingleAndAggregation(t *testing.T) {
+	tm, _ := time.Parse(time.RFC3339, "2026-10-10T13:25:00Z")
+	r := Build([]logparse.Request{{Path: "/z", Status: 503, Duration: 42 * time.Millisecond, Time: tm}, {Path: "/a", Status: 200, Duration: 2 * time.Millisecond, Time: tm}}, 1, 1)
+	if r.Total != 2 || r.Malformed != 1 || r.StatusClasses["5xx"] != 1 || r.StatusClasses["2xx"] != 1 || r.P50MS != 2 || r.P95MS != 42 || r.P99MS != 42 {
+		t.Fatalf("unexpected report: %+v", r)
+	}
+	if len(r.TopPaths) != 1 || r.TopPaths[0].Path != "/a" || len(r.ErrorsPerHour) != 1 || r.ErrorsPerHour[0].Count != 1 {
+		t.Fatalf("aggregation: %+v", r)
+	}
+}
+
+func TestPercentileNearestRankEdges(t *testing.T) {
+	if percentile(nil, .5) != 0 || percentile([]float64{7}, .5) != 7 || percentile([]float64{1, 2, 3, 4}, .5) != 2 || percentile([]float64{1, 2, 3, 4}, .95) != 4 || percentile([]float64{1, 2, 3, 4}, 0) != 1 || percentile([]float64{1, 2, 3, 4}, 1) != 4 {
+		t.Fatal("percentile edge case failed")
+	}
+}
