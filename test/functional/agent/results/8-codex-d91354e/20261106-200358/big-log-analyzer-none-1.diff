--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,26 @@
+package logparse
+
+import (
+	"strings"
+	"testing"
+)
+
+const sample = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParseLine(t *testing.T) {
+	q, err := ParseLine(sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if q.Path != "/api/items" || q.Status != 200 || q.Duration.Milliseconds() != 42 || q.Time.Hour() != 13 {
+		t.Fatalf("unexpected parse: %+v", q)
+	}
+}
+
+func TestMalformedLines(t *testing.T) {
+	for _, line := range []string{"", sample + " extra", strings.Replace(sample, "0.042", "oops", 1), strings.Replace(sample, "200", "bad", 1), strings.Replace(sample, "/api/items?id=3", "relative", 1), strings.Replace(sample, "[10/Oct/2026:13:55:36 +0000]", "[bad]", 1), strings.Replace(sample, "\"curl/8.0\"", "\"unterminated", 1)} {
+		if _, err := ParseLine(line); err == nil {
+			t.Errorf("expected malformed: %q", line)
+		}
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..c49af09
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,93 @@
+// Package stats aggregates parsed access-log requests.
+package stats
+
+import (
+	"fmt"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50MS         float64        `json:"p50_ms"`
+	P95MS         float64        `json:"p95_ms"`
+	P99MS         float64        `json:"p99_ms"`
+	ErrorsPerHour []HourCount    `json:"errors_per_hour"`
+}
+
+func Build(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	r := Report{Total: len(requests), Malformed: malformed, TopPaths: []PathCount{}, StatusClasses: map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}, ErrorsPerHour: []HourCount{}}
+	paths := map[string]int{}
+	hours := map[string]int{}
+	ds := make([]float64, 0, len(requests))
+	for _, q := range requests {
+		paths[q.Path]++
+		class := fmt.Sprintf("%dxx", q.Status/100)
+		if _, ok := r.StatusClasses[class]; ok {
+			r.StatusClasses[class]++
+		}
+		ds = append(ds, float64(q.Duration)/float64(time.Millisecond))
+		if q.Status >= 500 && q.Status < 600 {
+			h := q.Time.Format("2006-01-02T15:00:00Z07:00")
+			hours[h]++
+		}
+	}
+	for p, n := range paths {
+		r.TopPaths = append(r.TopPaths, PathCount{p, n})
+	}
+	sort.Slice(r.TopPaths, func(i, j int) bool {
+		if r.TopPaths[i].Count == r.TopPaths[j].Count {
+			return r.TopPaths[i].Path < r.TopPaths[j].Path
+		}
+		return r.TopPaths[i].Count > r.TopPaths[j].Count
+	})
+	if len(r.TopPaths) > top {
+		r.TopPaths = r.TopPaths[:top]
+	}
+	for h, n := range hours {
+		r.ErrorsPerHour = append(r.ErrorsPerHour, HourCount{h, n})
+	}
+	sort.Slice(r.ErrorsPerHour, func(i, j int) bool { return r.ErrorsPerHour[i].Hour < r.ErrorsPerHour[j].Hour })
+	sort.Float64s(ds)
+	r.P50MS = percentile(ds, .50)
+	r.P95MS = percentile(ds, .95)
+	r.P99MS = percentile(ds, .99)
+	return r
+}
+
+func percentile(sorted []float64, p float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	if p <= 0 {
+		return sorted[0]
+	}
+	if p >= 1 {
+		return sorted[len(sorted)-1]
+	}
+	// Nearest-rank percentile.
+	i := int(float64(len(sorted)) * p)
+	if float64(len(sorted))*p > float64(i) {
+		i++
+	}
+	if i < 1 {
+		i = 1
+	}
+	return sorted[i-1]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
