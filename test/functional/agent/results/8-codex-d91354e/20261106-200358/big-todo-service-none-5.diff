+++ b/internal/todo/todo_test.go
@@ -0,0 +1,68 @@
+package todo
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestCRUDAndList(t *testing.T) {
+	now := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	n := 0
+	s := NewStoreWith(clock.Fixed{T: now}, func() string { n++; return fmt.Sprint(n) })
+	a := s.Create("first")
+	b := s.Create("second")
+	done := true
+	updated, err := s.Update(a.ID, nil, &done)
+	if err != nil || !updated.Done {
+		t.Fatalf("update = %#v, %v", updated, err)
+	}
+	if got := s.List(nil, 20, 0); len(got) != 2 || got[0].ID != b.ID {
+		t.Fatalf("newest first: %#v", got)
+	}
+	if got := s.List(&done, 20, 0); len(got) != 1 || got[0].ID != a.ID {
+		t.Fatalf("done filter: %#v", got)
+	}
+	if got := s.List(nil, 1, 1); len(got) != 1 || got[0].ID != a.ID {
+		t.Fatalf("pagination: %#v", got)
+	}
+	if _, err := s.Get("missing"); err != ErrNotFound {
+		t.Fatalf("Get missing: %v", err)
+	}
+	if err := s.Delete(b.ID); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.Delete(b.ID); err != ErrNotFound {
+		t.Fatalf("Delete missing: %v", err)
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	s := NewStore()
+	const workers = 40
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			item := s.Create(fmt.Sprintf("task %d", i))
+			yes := true
+			if _, err := s.Update(item.ID, nil, &yes); err != nil {
+				t.Error(err)
+			}
+			if _, err := s.Get(item.ID); err != nil {
+				t.Error(err)
+			}
+			if err := s.Delete(item.ID); err != nil {
+				t.Error(err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	if got := s.List(nil, 20, 0); len(got) != 0 {
+		t.Fatalf("store has %d items", len(got))
+	}
+}
