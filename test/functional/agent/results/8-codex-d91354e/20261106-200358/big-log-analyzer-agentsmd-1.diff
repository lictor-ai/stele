+++ b/internal/stats/stats_test.go
@@ -0,0 +1,33 @@
+package stats
+
+import (
+	"example.com/app/internal/logparse"
+	"testing"
+)
+
+func TestBuild(t *testing.T) {
+	cases := []struct {
+		name       string
+		input      []logparse.Request
+		top, total int
+		p50        float64
+	}{
+		{"empty", nil, 10, 0, 0},
+		{"single", []logparse.Request{{Path: "/", Status: 200, DurationSeconds: .042}}, 10, 1, 42},
+		{"top limit", []logparse.Request{{Path: "/b", Status: 500, DurationSeconds: 1, Timestamp: "10/Oct/2026:13:00:00 +0000"}, {Path: "/a", Status: 200, DurationSeconds: 3}, {Path: "/a", Status: 404, DurationSeconds: 2}}, 1, 3, 2000},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Build(tc.input, 2, tc.top)
+			if got.TotalRequests != tc.total || got.P50Milliseconds != tc.p50 {
+				t.Errorf("Build(...) = total %d p50 %v, want %d %v", got.TotalRequests, got.P50Milliseconds, tc.total, tc.p50)
+			}
+			if got.MalformedLines != 2 {
+				t.Errorf("MalformedLines = %d, want 2", got.MalformedLines)
+			}
+			if tc.name == "top limit" && (got.FiveXXPerHour["2026-10-10T13:00Z"] != 1 || got.StatusClasses["4xx"] != 1) {
+				t.Errorf("Build(...) buckets = %+v %+v, want one 5xx hour and one 4xx", got.FiveXXPerHour, got.StatusClasses)
+			}
+		})
+	}
+}
