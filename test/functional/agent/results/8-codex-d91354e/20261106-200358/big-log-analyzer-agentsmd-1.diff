+++ b/cmd/loga/main.go
@@ -0,0 +1,129 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+type flagError struct{ err error }
+
+func (e flagError) Error() string { return e.err.Error() }
+func (e flagError) Unwrap() error { return e.err }
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		var badFlags flagError
+		if errors.As(err, &badFlags) {
+			os.Exit(2)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	return runInput(args, stdout, stderr, os.Stdin)
+}
+
+func runInput(args []string, stdout, stderr io.Writer, stdin io.Reader) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	jsonOutput := fs.Bool("json", false, "write JSON report")
+	if err := fs.Parse(args); err != nil {
+		return flagError{err}
+	}
+	if *top < 0 {
+		return flagError{fmt.Errorf("-top must be non-negative")}
+	}
+	files := fs.Args()
+	requests := make([]logparse.Request, 0)
+	malformed := 0
+	consume := func(name string, input io.Reader) error {
+		scanner := bufio.NewScanner(input)
+		scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for scanner.Scan() {
+			request, err := logparse.Parse(scanner.Text())
+			if err != nil {
+				malformed++
+				continue
+			}
+			requests = append(requests, request)
+		}
+		if err := scanner.Err(); err != nil {
+			return fmt.Errorf("read %s: %w", name, err)
+		}
+		return nil
+	}
+	if len(files) == 0 {
+		if err := consume("stdin", stdin); err != nil {
+			return err
+		}
+	} else {
+		for _, name := range files {
+			file, err := os.Open(name)
+			if err != nil {
+				return fmt.Errorf("open %s: %w", name, err)
+			}
+			readErr := consume(name, file)
+			closeErr := file.Close()
+			if readErr != nil {
+				return readErr
+			}
+			if closeErr != nil {
+				return fmt.Errorf("close %s: %w", name, closeErr)
+			}
+		}
+	}
+	report := stats.Build(requests, malformed, *top)
+	if *jsonOutput {
+		encoder := json.NewEncoder(stdout)
+		encoder.SetIndent("", "  ")
+		return encoder.Encode(report)
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(out io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(out, "Total requests: %d\nMalformed lines: %d\n\nTop paths\n", report.TotalRequests, report.MalformedLines); err != nil {
+		return err
+	}
+	for _, path := range report.TopPaths {
+		if _, err := fmt.Fprintf(out, "%d\t%s\n", path.Count, path.Path); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(out, "\nStatus classes"); err != nil {
+		return err
+	}
+	for _, class := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", class, report.StatusClasses[class]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(out, "\nRequest time (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n\n5xx per hour\n", report.P50Milliseconds, report.P95Milliseconds, report.P99Milliseconds); err != nil {
+		return err
+	}
+	var hours []string
+	for hour := range report.FiveXXPerHour {
+		hours = append(hours, hour)
+	}
+	sortStrings(hours)
+	for _, hour := range hours {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", hour, report.FiveXXPerHour[hour]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func sortStrings(values []string) { sort.Strings(values) }
