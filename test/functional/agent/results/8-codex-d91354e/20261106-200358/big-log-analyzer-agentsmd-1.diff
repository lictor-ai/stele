@@ -0,0 +1,41 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	cases := []struct {
+		name    string
+		args    []string
+		input   string
+		wantErr bool
+		want    string
+	}{
+		{"text and malformed", nil, "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /x?a=1 HTTP/1.1\" 200 2 \"-\" \"curl\" 0.042\nbad\n", false, "Total requests: 1\nMalformed lines: 1"},
+		{"json", []string{"-json"}, "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET / HTTP/1.1\" 500 2 \"-\" \"curl\" 0.1\n", false, "\"total_requests\": 1"},
+		{"bad flag", []string{"-unknown"}, "", true, ""},
+		{"negative top", []string{"-top=-1"}, "", true, ""},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var out, stderr bytes.Buffer
+			err := runInput(tc.args, &out, &stderr, strings.NewReader(tc.input))
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("run(...) error = %v, want error %v", err, tc.wantErr)
+			}
+			if !tc.wantErr && !bytes.Contains(out.Bytes(), []byte(tc.want)) {
+				t.Errorf("run(...) output = %q, want substring %q", out.String(), tc.want)
+			}
+			if tc.name == "json" {
+				var data map[string]any
+				if err := json.Unmarshal(out.Bytes(), &data); err != nil {
+					t.Errorf("JSON output %q: %v", out.String(), err)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/logparse/parse.go b/internal/logparse/parse.go
new file mode 100644
index 0000000..8940a98
--- /dev/null
+++ b/internal/logparse/parse.go
@@ -0,0 +1,42 @@
+// Package logparse parses nginx access log records.
+package logparse
+
+import (
+	"fmt"
+	"math"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is one parsed nginx access log entry.
+type Request struct {
+	Path            string
+	Status          int
+	DurationSeconds float64
+	Timestamp       string
+}
+
+var linePattern = regexp.MustCompile(`^\S+ \S+ \S+ \[([^]]+)\] "([A-Z]+) (\S+) HTTP/[^" ]+" (\d{3}) \S+ "[^"]*" "[^"]*" (\S+)$`)
+
+// Parse parses a combined nginx access log line with a trailing request duration.
+func Parse(line string) (Request, error) {
+	match := linePattern.FindStringSubmatch(strings.TrimSuffix(line, "\r"))
+	if match == nil {
+		return Request{}, fmt.Errorf("invalid combined access log line")
+	}
+	if _, err := time.Parse("02/Jan/2006:15:04:05 -0700", match[1]); err != nil {
+		return Request{}, fmt.Errorf("invalid request timestamp %q: %w", match[1], err)
+	}
+	status, err := strconv.Atoi(match[4])
+	if err != nil {
+		return Request{}, fmt.Errorf("parse status %q: %w", match[4], err)
+	}
+	duration, err := strconv.ParseFloat(match[5], 64)
+	if err != nil || duration < 0 || math.IsNaN(duration) || math.IsInf(duration, 0) {
+		return Request{}, fmt.Errorf("invalid request duration %q", match[5])
+	}
+	path := strings.SplitN(match[3], "?", 2)[0]
+	return Request{Path: path, Status: status, DurationSeconds: duration, Timestamp: match[1]}, nil
+}
