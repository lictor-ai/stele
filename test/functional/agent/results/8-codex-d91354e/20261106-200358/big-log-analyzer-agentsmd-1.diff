@@ -0,0 +1,29 @@
+package logparse
+
+import "testing"
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, line string
+		ok         bool
+		path       string
+		status     int
+	}{
+		{"valid query", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, true, "/api/items", 200},
+		{"empty", "", false, "", 0},
+		{"truncated", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200`, false, "", 0},
+		{"bad status", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" abc 512 "-" "curl" 0.1`, false, "", 0},
+		{"bad duration", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "curl" nope`, false, "", 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if (err == nil) != tc.ok {
+				t.Fatalf("Parse(%q) error = %v, want success %v", tc.line, err, tc.ok)
+			}
+			if tc.ok && (got.Path != tc.path || got.Status != tc.status) {
+				t.Errorf("Parse(%q) = %+v, want path %q status %d", tc.line, got, tc.path, tc.status)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
