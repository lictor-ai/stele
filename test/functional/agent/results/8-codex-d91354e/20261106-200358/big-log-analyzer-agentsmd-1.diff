index 0000000..1e07d6d
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,80 @@
+// Package stats computes summaries for parsed access log requests.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount records a path and its request count.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains the requested access log summary.
+type Report struct {
+	TotalRequests   int            `json:"total_requests"`
+	MalformedLines  int            `json:"malformed_lines"`
+	TopPaths        []PathCount    `json:"top_paths"`
+	StatusClasses   map[string]int `json:"status_classes"`
+	P50Milliseconds float64        `json:"p50_milliseconds"`
+	P95Milliseconds float64        `json:"p95_milliseconds"`
+	P99Milliseconds float64        `json:"p99_milliseconds"`
+	FiveXXPerHour   map[string]int `json:"five_xx_per_hour"`
+}
+
+// Build creates a report from valid requests and a malformed line count.
+func Build(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	counts := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	durations := make([]float64, 0, len(requests))
+	for _, req := range requests {
+		counts[req.Path]++
+		class := req.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			classes[key]++
+		}
+		if class == 5 {
+			if parsed, err := time.Parse("02/Jan/2006:15:04:05 -0700", req.Timestamp); err == nil {
+				key := parsed.UTC().Format("2006-01-02T15:00Z")
+				hours[key]++
+			}
+		}
+		durations = append(durations, req.DurationSeconds*1000)
+	}
+	paths := make([]PathCount, 0, len(counts))
+	for path, count := range counts {
+		paths = append(paths, PathCount{path, count})
+	}
+	sort.Slice(paths, func(i, j int) bool {
+		if paths[i].Count == paths[j].Count {
+			return paths[i].Path < paths[j].Path
+		}
+		return paths[i].Count > paths[j].Count
+	})
+	if len(paths) > top {
+		paths = paths[:top]
+	}
+	sort.Float64s(durations)
+	return Report{len(requests), malformed, paths, classes, percentile(durations, .50), percentile(durations, .95), percentile(durations, .99), hours}
+}
+
+func percentile(values []float64, p float64) float64 {
+	if len(values) == 0 {
+		return 0
+	}
+	index := int(math.Ceil(p*float64(len(values)))) - 1
+	if index < 0 {
+		index = 0
+	}
+	return values[index]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
