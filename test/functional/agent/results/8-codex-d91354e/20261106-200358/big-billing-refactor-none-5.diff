+func TestApplyDiscountExpiryReuseAndFloor(t *testing.T) {
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	expiry := now
+	code := &DiscountCode{Code: "SAVE", AmountCents: 900, ExpiresAt: &expiry}
+	inv := Invoice{Customer: "acme", TotalCents: 500, GrandTotalCents: 500}
+	if err := ApplyDiscount(&inv, code, now); err != nil {
+		t.Fatalf("ApplyDiscount at expiry: %v", err)
+	}
+	if inv.DiscountCents != 500 {
+		t.Errorf("discount = %d, want floor at 500", inv.DiscountCents)
+	}
+	if err := ApplyDiscount(&Invoice{Customer: "acme", TotalCents: 1000}, code, now); err == nil {
+		t.Error("expected reuse by same customer to fail")
+	}
+	expired := &DiscountCode{Code: "OLD", Percent: 10, ExpiresAt: &expiry}
+	if err := ApplyDiscount(&Invoice{Customer: "other", TotalCents: 1000}, expired, now.Add(time.Nanosecond)); err == nil {
+		t.Error("expected expired code to fail")
+	}
+}
