+	if inv.Region != "FR" || inv.TaxCents != 180 || inv.GrandTotalCents != 1080 {
+		t.Errorf("taxed invoice = region %q, tax %d, grand total %d; want FR, 180, 1080", inv.Region, inv.TaxCents, inv.GrandTotalCents)
+	}
+}
+
+func TestWriteCSV(t *testing.T) {
+	issued := time.Date(2026, 3, 4, 5, 6, 7, 0, time.FixedZone("UTC+1", 3600))
+	var out bytes.Buffer
+	inv := Invoice{ID: "i1", Customer: "Acme, Inc.", Region: "US-CA", IssuedAt: issued, TotalCents: 1200, DiscountCents: 200, TaxCents: 80, GrandTotalCents: 1080}
+	if err := WriteCSV(&out, []Invoice{inv}); err != nil {
+		t.Fatal(err)
+	}
+	rows, err := csv.NewReader(strings.NewReader(out.String())).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) != 2 || len(rows[1]) != 8 {
+		t.Fatalf("CSV rows = %#v", rows)
+	}
+	want := []string{"i1", "Acme, Inc.", "US-CA", "2026-03-04T05:06:07+01:00", "1200", "200", "80", "1080"}
+	for i := range want {
+		if rows[1][i] != want[i] {
+			t.Errorf("CSV field %d = %q, want %q", i, rows[1][i], want[i])
+		}
+	}
+}
diff --git a/internal/billing/export.go b/internal/billing/export.go
new file mode 100644
index 0000000..2feee50
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,32 @@
+package billing
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+)
+
+// WriteCSV writes invoices to w with monetary values represented in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand total"}); err != nil {
+		return err
+	}
+	for _, inv := range invoices {
+		row := []string{
+			inv.ID,
+			inv.Customer,
+			inv.Region,
+			inv.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := writer.Write(row); err != nil {
+			return err
+		}
+	}
+	writer.Flush()
+	return writer.Error()
+}
