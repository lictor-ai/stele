+	ID              string    `json:"id"`
+	Customer        string    `json:"customer"`
+	Region          string    `json:"region"`
+	Lines           []Line    `json:"lines"`
+	TotalCents      int64     `json:"total_cents"`
+	DiscountCents   int64     `json:"discount_cents"`
+	DiscountCode    string    `json:"discount_code,omitempty"`
+	TaxCents        int64     `json:"tax_cents"`
+	GrandTotalCents int64     `json:"grand_total_cents"`
+	IssuedAt        time.Time `json:"issued_at"`
+}
+
+// DiscountCode represents either a percentage discount or a fixed amount.
+// Set exactly one of Percent or AmountCents to a positive value. Expiry is
+// inclusive: a code may be used at exactly ExpiresAt.
+type DiscountCode struct {
+	Code        string
+	Percent     int
+	AmountCents int64
+	ExpiresAt   *time.Time
+	UsedBy      map[string]bool
+}
+
+// ApplyDiscount applies code once to an invoice and records its use by the
+// invoice's customer. Percentage discounts are rounded to the nearest cent.
+func ApplyDiscount(inv *Invoice, code *DiscountCode, now time.Time) error {
+	if inv == nil || code == nil {
+		return fmt.Errorf("billing: invoice and discount code are required")
+	}
+	if (code.Percent > 0) == (code.AmountCents > 0) || code.Percent < 0 || code.Percent > 100 || code.AmountCents < 0 {
+		return fmt.Errorf("billing: discount must be a valid percentage or fixed amount")
+	}
+	if code.ExpiresAt != nil && now.After(*code.ExpiresAt) {
+		return fmt.Errorf("billing: discount code expired")
+	}
+	if code.UsedBy != nil && code.UsedBy[inv.Customer] {
+		return fmt.Errorf("billing: discount code already used by customer")
+	}
+	if inv.DiscountCode != "" {
+		return fmt.Errorf("billing: invoice already has a discount code")
+	}
+	amount := code.AmountCents
+	if code.Percent > 0 {
+		amount = (inv.TotalCents*int64(code.Percent) + 50) / 100
+	}
+	if amount > inv.TotalCents {
+		amount = inv.TotalCents
+	}
+	if amount < 0 {
+		amount = 0
+	}
+	inv.DiscountCents = amount
+	inv.DiscountCode = code.Code
+	if code.UsedBy == nil {
+		code.UsedBy = make(map[string]bool)
+	}
+	code.UsedBy[inv.Customer] = true
+	return nil
+}
+
+// ApplyTax sets an invoice's region and computes tax on the post-discount
+// amount. Rates are integer basis points (for example, 2000 means 20%).
+func ApplyTax(inv *Invoice, region string, rates map[string]int) error {
+	if inv == nil {
+		return fmt.Errorf("billing: invoice is required")
+	}
+	rate, ok := rates[region]
+	if !ok {
+		return fmt.Errorf("billing: no tax rate for region %q", region)
+	}
+	if rate < 0 {
+		return fmt.Errorf("billing: tax rate cannot be negative")
+	}
+	net := inv.TotalCents - inv.DiscountCents
+	if net < 0 {
+		net = 0
+	}
+	inv.Region = region
+	inv.TaxCents = (net*int64(rate) + 5000) / 10000
+	inv.GrandTotalCents = net + inv.TaxCents
+	return nil
 }
 
