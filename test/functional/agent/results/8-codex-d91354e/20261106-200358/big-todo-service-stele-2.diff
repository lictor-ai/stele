index 0000000..07a778c
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,190 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// TodoStore is the storage interface used by the HTTP API.
+type TodoStore interface {
+	Create(context.Context, string) (todo.Todo, error)
+	Get(context.Context, string) (todo.Todo, error)
+	Update(context.Context, string, todo.Changes) (todo.Todo, error)
+	Delete(context.Context, string) error
+	List(context.Context, *bool, int, int) ([]todo.Todo, error)
+}
+
+// NewTodoHandler creates an HTTP handler for todo routes.
+func NewTodoHandler(store TodoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", createTodo(store))
+	mux.HandleFunc("GET /todos", listTodos(store))
+	mux.HandleFunc("GET /todos/{id}", getTodo(store))
+	mux.HandleFunc("PATCH /todos/{id}", updateTodo(store))
+	mux.HandleFunc("DELETE /todos/{id}", deleteTodo(store))
+	return mux
+}
+
+func createTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct { Title string `json:"title"` }
+		if err := decodeBody(w, r, &body); err != nil {
+			Error(w, http.StatusBadRequest, "request body must contain a valid title")
+			return
+		}
+		t, err := store.Create(r.Context(), body.Title)
+		if errors.Is(err, todo.ErrInvalid) {
+			Error(w, http.StatusBadRequest, "title must be between 1 and 200 characters")
+			return
+		}
+		if err != nil {
+			log.Error("create todo", "err", err)
+			Error(w, http.StatusInternalServerError, "could not create todo; try again")
+			return
+		}
+		JSON(w, http.StatusCreated, t)
+	}
+}
+
+func getTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		t, err := store.Get(r.Context(), r.PathValue("id"))
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		if err != nil {
+			log.Error("get todo", "err", err)
+			Error(w, http.StatusInternalServerError, "could not get todo; try again")
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func updateTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title *string `json:"title"`
+			Done  *bool   `json:"done"`
+		}
+		if err := decodeBody(w, r, &body); err != nil {
+			Error(w, http.StatusBadRequest, "request body must contain title and/or done")
+			return
+		}
+		changes := todo.Changes{Title: body.Title, Done: body.Done}
+		if changes.Title == nil && changes.Done == nil {
+			Error(w, http.StatusBadRequest, "provide title and/or done")
+			return
+		}
+		t, err := store.Update(r.Context(), r.PathValue("id"), changes)
+		if errors.Is(err, todo.ErrInvalid) {
+			Error(w, http.StatusBadRequest, "title must be between 1 and 200 characters")
+			return
+		}
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		if err != nil {
+			log.Error("update todo", "err", err)
+			Error(w, http.StatusInternalServerError, "could not update todo; try again")
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func deleteTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		err := store.Delete(r.Context(), r.PathValue("id"))
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		if err != nil {
+			log.Error("delete todo", "err", err)
+			Error(w, http.StatusInternalServerError, "could not delete todo; try again")
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func listTodos(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		q := r.URL.Query()
+		for key := range q {
+			if key != "done" && key != "limit" && key != "offset" {
+				Error(w, http.StatusBadRequest, "unsupported query parameter")
+				return
+			}
+		}
+		var done *bool
+		if values, ok := q["done"]; ok {
+			if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			v := values[0] == "true"
+			done = &v
+		}
+		limit := 20
+		if values, ok := q["limit"]; ok {
+			if len(values) != 1 {
+				Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+				return
+			}
+			v, err := strconv.Atoi(values[0])
+			if err != nil || v < 1 || v > 100 {
+				Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+				return
+			}
+			limit = v
+		}
+		offset := 0
+		if values, ok := q["offset"]; ok {
+			if len(values) != 1 {
+				Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+				return
+			}
+			v, err := strconv.Atoi(values[0])
+			if err != nil || v < 0 {
+				Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+				return
+			}
+			offset = v
+		}
+		items, err := store.List(r.Context(), done, limit, offset)
+		if err != nil {
+			log.Error("list todos", "err", err)
+			Error(w, http.StatusInternalServerError, "could not list todos; try again")
+			return
+		}
+		JSON(w, http.StatusOK, items)
+	}
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, dst any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(dst); err != nil {
+		return fmt.Errorf("decode request: %w", err)
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		if err != nil {
+			return fmt.Errorf("decode trailing request data: %w", err)
+		}
+		return fmt.Errorf("request has trailing JSON data")
+	}
+	return nil
+}
