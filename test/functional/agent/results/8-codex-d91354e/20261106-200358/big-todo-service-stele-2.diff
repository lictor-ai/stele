@@ -0,0 +1,149 @@
+// Package todo provides an in-memory todo store.
+package todo
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task tracked by the service.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Changes contains fields supplied to an update.
+type Changes struct {
+	Title *string
+	Done  *bool
+}
+
+// Store holds todos in memory. mu guards todos.
+type Store struct {
+	mu    sync.RWMutex
+	todos map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates an empty store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{todos: make(map[string]Todo), clock: c}
+}
+
+// Create validates and stores a todo.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.todos[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns a todo by its identifier.
+func (s *Store) Get(ctx context.Context, todoID string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	t, ok := s.todos[todoID]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the supplied title and/or done value.
+func (s *Store) Update(ctx context.Context, todoID string, changes Changes) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	if changes.Title == nil && changes.Done == nil {
+		return Todo{}, ErrInvalid
+	}
+	if changes.Title != nil {
+		title := strings.TrimSpace(*changes.Title)
+		if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+		changes.Title = &title
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.todos[todoID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if changes.Title != nil {
+		t.Title = *changes.Title
+	}
+	if changes.Done != nil {
+		t.Done = *changes.Done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.todos[todoID] = t
+	return t, nil
+}
+
+// Delete removes a todo.
+func (s *Store) Delete(ctx context.Context, todoID string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.todos[todoID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.todos, todoID)
+	return nil
+}
+
+// List returns todos newest first, with optional done filtering and pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if limit < 0 || offset < 0 {
+		return nil, ErrInvalid
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.todos))
+	for _, t := range s.todos {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if limit >= 0 && limit < len(items) {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..81c0438
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,105 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	fixed := clock.Fixed{T: time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)}
+	store := NewStore(fixed)
+	ctx := context.Background()
+	created, err := store.Create(ctx, "  first  ")
+	if err != nil || created.Title != "first" || created.CreatedAt != fixed.T {
+		t.Fatalf("Create() = %#v, %v; want trimmed todo and no error", created, err)
+	}
+	done := true
+	updated, err := store.Update(ctx, created.ID, Changes{Done: &done})
+	if err != nil || !updated.Done {
+		t.Fatalf("Update() = %#v, %v; want done todo and no error", updated, err)
+	}
+	filtered, err := store.List(ctx, &done, 10, 0)
+	if err != nil || len(filtered) != 1 || filtered[0].ID != created.ID {
+		t.Fatalf("List(done=true) = %#v, %v; want created todo", filtered, err)
+	}
+	if err := store.Delete(ctx, created.ID); err != nil {
+		t.Fatalf("Delete(%q) = %v, want nil", created.ID, err)
+	}
+	_, err = store.Get(ctx, created.ID)
+	if !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(%q) error = %v, want ErrNotFound", created.ID, err)
+	}
+}
+
+func TestStoreValidationAndPagination(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Unix(1, 0)})
+	ctx := context.Background()
+	cases := []struct {
+		name  string
+		title string
+		want  bool
+	}{
+		{name: "empty"},
+		{name: "spaces", title: "   "},
+		{name: "too long", title: string(make([]rune, 201))},
+		{name: "valid", title: "x", want: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := store.Create(ctx, tc.title)
+			if tc.want && err != nil {
+				t.Fatalf("Create(%q) error = %v, want nil", tc.title, err)
+			}
+			if !tc.want && !errors.Is(err, ErrInvalid) {
+				t.Errorf("Create(%q) error = %v, want ErrInvalid", tc.title, err)
+			}
+		})
+	}
+	_, _ = store.Create(ctx, "first")
+	_, _ = store.Create(ctx, "second")
+	items, err := store.List(ctx, nil, 1, 1)
+	if err != nil || len(items) != 1 {
+		t.Errorf("List(limit=1, offset=1) returned %d todos, %v; want one todo", len(items), err)
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Unix(1, 0)})
+	const count = 80
+	var wg sync.WaitGroup
+	ids := make(chan string, count)
+	for i := 0; i < count; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			created, err := store.Create(context.Background(), "parallel")
+			if err != nil {
+				t.Errorf("Create(parallel) error = %v, want nil", err)
+				return
+			}
+			ids <- created.ID
+			_, err = store.Get(context.Background(), created.ID)
+			if err != nil {
+				t.Errorf("Get(%q) error = %v, want nil", created.ID, err)
+			}
+		}()
+	}
+	wg.Wait()
+	close(ids)
+	seen := make(map[string]bool, count)
+	for id := range ids {
+		if seen[id] {
+			t.Errorf("Create generated duplicate id %q", id)
+		}
+		seen[id] = true
+	}
+	items, err := store.List(context.Background(), nil, 100, 0)
+	if err != nil || len(items) != count {
+		t.Errorf("List() returned %d items, %v; want %d items and nil error", len(items), err, count)
+	}
+}
