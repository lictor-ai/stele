+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	store := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 2, 0, 0, 0, 0, time.UTC)})
+	handler := NewTodoHandler(store)
+	request := func(method, path, body string) *httptest.ResponseRecorder {
+		r := httptest.NewRequest(method, path, strings.NewReader(body))
+		w := httptest.NewRecorder()
+		handler.ServeHTTP(w, r)
+		return w
+	}
+	created := request(http.MethodPost, "/todos", `{"title":"  alpha  "}`)
+	if created.Code != http.StatusCreated {
+		t.Fatalf("POST /todos status = %d, want %d: %s", created.Code, http.StatusCreated, created.Body)
+	}
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil || item.Title != "alpha" || item.ID == "" {
+		t.Fatalf("POST /todos body = %q, %v; want created todo", created.Body, err)
+	}
+	id := item.ID
+	get := request(http.MethodGet, "/todos/"+id, "")
+	if get.Code != http.StatusOK {
+		t.Errorf("GET /todos/{id} status = %d, want %d", get.Code, http.StatusOK)
+	}
+	updated := request(http.MethodPatch, "/todos/"+id, `{"done":true}`)
+	if updated.Code != http.StatusOK || !bytes.Contains(updated.Body.Bytes(), []byte(`"done":true`)) {
+		t.Errorf("PATCH /todos/{id} = %d %s; want updated todo", updated.Code, updated.Body)
+	}
+	for _, path := range []string{"/todos?done=true&limit=1&offset=0", "/todos?done=false", "/todos"} {
+		w := request(http.MethodGet, path, "")
+		if w.Code != http.StatusOK {
+			t.Errorf("GET %s status = %d, want %d", path, w.Code, http.StatusOK)
+		}
+	}
+	deleted := request(http.MethodDelete, "/todos/"+id, "")
+	if deleted.Code != http.StatusNoContent || deleted.Body.Len() != 0 {
+		t.Errorf("DELETE /todos/{id} = %d %q; want empty 204", deleted.Code, deleted.Body)
+	}
+	for _, route := range []struct {
+		method string
+		path   string
+	}{
+		{method: http.MethodGet, path: "/todos/missing"},
+		{method: http.MethodPatch, path: "/todos/missing"},
+		{method: http.MethodDelete, path: "/todos/missing"},
+	} {
+		w := request(route.method, route.path, `{"done":true}`)
+		if w.Code != http.StatusNotFound || !strings.Contains(w.Body.String(), `"error"`) {
+			t.Errorf("%s %s = %d %s; want JSON 404", route.method, route.path, w.Code, w.Body)
+		}
+	}
+}
+
+func TestTodoRouteErrors(t *testing.T) {
+	handler := NewTodoHandler(todo.NewStore(clock.Fixed{T: time.Unix(1, 0)}))
+	cases := []struct {
+		name   string
+		method string
+		path   string
+		body   string
+	}{
+		{name: "missing title", method: http.MethodPost, path: "/todos", body: `{}`},
+		{name: "blank title", method: http.MethodPost, path: "/todos", body: `{"title":"   "}`},
+		{name: "unknown field", method: http.MethodPost, path: "/todos", body: `{"title":"a","extra":1}`},
+		{name: "malformed JSON", method: http.MethodPost, path: "/todos", body: `{`},
+		{name: "empty patch", method: http.MethodPatch, path: "/todos/missing", body: `{}`},
+		{name: "invalid patch title", method: http.MethodPatch, path: "/todos/missing", body: `{"title":" "}`},
+		{name: "invalid done", method: http.MethodGet, path: "/todos?done=yes"},
+		{name: "invalid limit", method: http.MethodGet, path: "/todos?limit=101"},
+		{name: "invalid offset", method: http.MethodGet, path: "/todos?offset=-1"},
+		{name: "unknown query", method: http.MethodGet, path: "/todos?other=x"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			r := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+			w := httptest.NewRecorder()
+			handler.ServeHTTP(w, r)
+			if w.Code != http.StatusBadRequest || !strings.Contains(w.Body.String(), `"error"`) {
+				t.Errorf("%s %s returned %d %s; want JSON 400", tc.method, tc.path, w.Code, w.Body)
+			}
+		})
+	}
+}
