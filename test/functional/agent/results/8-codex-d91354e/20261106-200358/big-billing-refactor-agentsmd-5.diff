+		}
+		inv.TaxCents = roundBasisPoints(base, rate)
+	}
+	inv.GrandTotalCents = base + inv.TaxCents
+	return inv, nil
+}
+
+func (book *DiscountBook) apply(code, customer string, total int64, at time.Time) (DiscountCode, error) {
+	book.mu.Lock()
+	defer book.mu.Unlock()
+	discount, ok := book.codes[code]
+	if !ok || customer == "" || (discount.ExpiresAt != nil && at.After(*discount.ExpiresAt)) {
+		return DiscountCode{}, ErrDiscountUnavailable
+	}
+	if book.used[code] != nil && book.used[code][customer] {
+		return DiscountCode{}, ErrDiscountUnavailable
+	}
+	amount, err := discountAmount(discount, total)
+	if err != nil {
+		return DiscountCode{}, err
+	}
+	if book.used[code] == nil {
+		book.used[code] = make(map[string]bool)
+	}
+	book.used[code][customer] = true
+	discount.Value = amount
+	return discount, nil
+}
+
+func discountAmount(code DiscountCode, total int64) (int64, error) {
+	if code.Value < 0 {
+		return 0, fmt.Errorf("%w: negative discount", ErrInvalidInvoice)
+	}
+	switch code.Kind {
+	case DiscountFixed:
+		if code.Value > total {
+			return total, nil
+		}
+		return code.Value, nil
+	case DiscountPercentage:
+		if code.Value > 10000 {
+			return 0, fmt.Errorf("%w: percentage exceeds 100%%", ErrInvalidInvoice)
+		}
+		return roundBasisPoints(total, code.Value), nil
+	default:
+		return 0, fmt.Errorf("%w: unknown discount kind", ErrInvalidInvoice)
+	}
+}
+
+func roundBasisPoints(amount, basisPoints int64) int64 {
+	whole := amount / 10000 * basisPoints
+	remainder := amount % 10000 * basisPoints
+	whole += remainder / 10000
+	if remainder%10000 >= 5000 {
+		whole++
 	}
