+package billing
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestDiscounts(t *testing.T) {
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	expired := now.Add(-time.Second)
+	cases := []struct {
+		name  string
+		code  DiscountCode
+		total int64
+		want  int64
+	}{
+		{name: "fixed floor", code: DiscountCode{Code: "large", Kind: DiscountFixed, Value: 900}, total: 250, want: 250},
+		{name: "percentage rounds half up", code: DiscountCode{Code: "half", Kind: DiscountPercentage, Value: 5000}, total: 1, want: 1},
+		{name: "percentage fraction rounds down", code: DiscountCode{Code: "small", Kind: DiscountPercentage, Value: 4999}, total: 1, want: 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			book := NewDiscountBook([]DiscountCode{tc.code})
+			inv, err := ComputeWithOptions("i1", "c1", []Line{{Quantity: 1, UnitCents: tc.total}}, ComputeOptions{IssuedAt: now, DiscountCode: tc.code.Code, Discounts: book})
+			if err != nil || inv.DiscountCents != tc.want || inv.GrandTotalCents != tc.total-tc.want {
+				t.Errorf("ComputeWithOptions() = (%d, %d, %v), want (%d, %d, nil)", inv.DiscountCents, inv.GrandTotalCents, err, tc.want, tc.total-tc.want)
+			}
+		})
+	}
+
+	book := NewDiscountBook([]DiscountCode{{Code: "once", Kind: DiscountFixed, Value: 50}})
+	_, firstErr := ComputeWithOptions("i1", "c1", []Line{{Quantity: 1, UnitCents: 100}}, ComputeOptions{IssuedAt: now, DiscountCode: "once", Discounts: book})
+	_, reuseErr := ComputeWithOptions("i2", "c1", []Line{{Quantity: 1, UnitCents: 100}}, ComputeOptions{IssuedAt: now, DiscountCode: "once", Discounts: book})
+	_, otherCustomerErr := ComputeWithOptions("i3", "c2", []Line{{Quantity: 1, UnitCents: 100}}, ComputeOptions{IssuedAt: now, DiscountCode: "once", Discounts: book})
+	if firstErr != nil || !errors.Is(reuseErr, ErrDiscountUnavailable) || otherCustomerErr != nil {
+		t.Errorf("discount use errors = (%v, %v, %v), want (nil, unavailable, nil)", firstErr, reuseErr, otherCustomerErr)
+	}
+	expiredBook := NewDiscountBook([]DiscountCode{{Code: "old", Kind: DiscountFixed, Value: 1, ExpiresAt: &expired}})
+	_, err := ComputeWithOptions("i4", "c1", []Line{{Quantity: 1, UnitCents: 10}}, ComputeOptions{IssuedAt: now, DiscountCode: "old", Discounts: expiredBook})
+	if !errors.Is(err, ErrDiscountUnavailable) {
+		t.Errorf("ComputeWithOptions(expired) error = %v, want ErrDiscountUnavailable", err)
+	}
+}
+
+func TestTaxAfterDiscount(t *testing.T) {
+	book := NewDiscountBook([]DiscountCode{{Code: "ten", Kind: DiscountPercentage, Value: 1000}})
+	inv, err := ComputeWithOptions("i1", "c1", []Line{{Quantity: 1, UnitCents: 1001}}, ComputeOptions{
+		IssuedAt: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC), Region: "FR", TaxRates: map[string]int64{"FR": 2000},
+		DiscountCode: "ten", Discounts: book,
+	})
+	if err != nil {
+		t.Fatalf("ComputeWithOptions() error = %v, want nil", err)
+	}
+	if inv.DiscountCents != 100 || inv.TaxCents != 180 || inv.GrandTotalCents != 1081 {
+		t.Errorf("invoice discount/tax/grand total = %d/%d/%d, want 100/180/1081", inv.DiscountCents, inv.TaxCents, inv.GrandTotalCents)
+	}
+}
+
+func TestExportCSV(t *testing.T) {
+	issuedAt := time.Date(2026, 2, 3, 4, 5, 6, 0, time.FixedZone("plus one", 3600))
+	var output bytes.Buffer
+	inv := Invoice{ID: "i1", Customer: "Acme, Inc", Region: "US-CA", IssuedAt: issuedAt, TotalCents: 1000, DiscountCents: 100, TaxCents: 72, GrandTotalCents: 972}
+	if err := ExportCSV(&output, []Invoice{inv}); err != nil {
+		t.Fatalf("ExportCSV() error = %v, want nil", err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\ni1,\"Acme, Inc\",US-CA,2026-02-03T04:05:06+01:00,1000,100,72,972\n"
+	if output.String() != want {
+		t.Errorf("ExportCSV() = %q, want %q", output.String(), want)
+	}
+	if strings.Contains(output.String(), "1000.00") {
+		t.Errorf("ExportCSV() formatted cents as currency: %q", output.String())
+	}
+}
