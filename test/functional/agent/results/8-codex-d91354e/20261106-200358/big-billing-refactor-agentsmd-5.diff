+// ComputeWithOptions builds an invoice with region tax and an optional discount.
+func ComputeWithOptions(id, customer string, lines []Line, options ComputeOptions) (Invoice, error) {
+	if customer == "" || id == "" {
+		return Invoice{}, fmt.Errorf("%w: id and customer are required", ErrInvalidInvoice)
