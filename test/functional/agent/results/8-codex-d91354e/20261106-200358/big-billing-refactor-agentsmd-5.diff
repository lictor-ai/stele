+			return Invoice{}, fmt.Errorf("%w: invalid line %q", ErrInvalidInvoice, line.SKU)
+		}
+		amount := int64(line.Quantity) * line.UnitCents
+		if total > int64(^uint64(0)>>1)-amount {
+			return Invoice{}, fmt.Errorf("%w: total overflows", ErrInvalidInvoice)
+		}
+		total += amount
+	}
+	inv := Invoice{ID: id, Customer: customer, Region: options.Region, Lines: append([]Line(nil), lines...), TotalCents: total, IssuedAt: options.IssuedAt}
+	if inv.IssuedAt.IsZero() {
+		inv.IssuedAt = time.Now()
+	}
+	if options.DiscountCode != "" {
+		if options.Discounts == nil {
