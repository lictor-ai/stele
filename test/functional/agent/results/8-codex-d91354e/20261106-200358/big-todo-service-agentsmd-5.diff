@@ -0,0 +1,137 @@
+// Package todo stores TODO items.
+package todo
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"sync"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task with creation and update timestamps.
+type Todo struct {
+	ID        string `json:"id"`
+	Title     string `json:"title"`
+	Done      bool   `json:"done"`
+	CreatedAt string `json:"created_at"`
+	UpdatedAt string `json:"updated_at"`
+}
+
+// Store provides concurrent-safe access to TODO items.
+type Store struct {
+	mu    sync.RWMutex // guards items
+	items map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates a store using the supplied clock.
+func NewStore(c clock.Clock) *Store { return &Store{items: make(map[string]Todo), clock: c} }
+
+// Create adds a TODO with a generated identifier.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now().UTC().Format("2006-01-02T15:04:05.999999999Z07:00")
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns one TODO by identifier.
+func (s *Store) Get(ctx context.Context, key string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	t, ok := s.items[key]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes a TODO title and/or completion state.
+func (s *Store) Update(ctx context.Context, key string, title *string, done *bool) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	if title == nil && done == nil {
+		return Todo{}, ErrInvalid
+	}
+	clean := ""
+	if title != nil {
+		clean = strings.TrimSpace(*title)
+		if len([]rune(clean)) < 1 || len([]rune(clean)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[key]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		t.Title = clean
+	}
+	if done != nil {
+		t.Done = *done
+	}
+	t.UpdatedAt = s.clock.Now().UTC().Format("2006-01-02T15:04:05.999999999Z07:00")
+	s.items[key] = t
+	return t, nil
+}
+
+// Delete removes one TODO.
+func (s *Store) Delete(ctx context.Context, key string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[key]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, key)
+	return nil
+}
+
+// List returns matching TODOs newest first, with offset and limit pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	s.mu.RLock()
+	out := make([]Todo, 0, len(s.items))
+	for _, t := range s.items {
+		if done == nil || t.Done == *done {
+			out = append(out, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].CreatedAt == out[j].CreatedAt {
+			return out[i].ID > out[j].ID
+		}
+		return out[i].CreatedAt > out[j].CreatedAt
+	})
+	if offset >= len(out) {
+		return []Todo{}, nil
+	}
+	out = out[offset:]
+	if limit >= 0 && len(out) > limit {
+		out = out[:limit]
+	}
+	return out, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..0a71b2f
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,94 @@
+package todo
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name    string
+		title   string
+		wantErr bool
+	}{{"valid", " first ", false}, {"empty", "  ", true}, {"too long", string(make([]byte, 201)), true}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			got, err := s.Create(context.Background(), tc.title)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("Create(%q) error = %v, wantErr %v", tc.title, err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if got.Title != "first" {
+				t.Errorf("Create title = %q, want %q", got.Title, "first")
+			}
+			fetched, err := s.Get(context.Background(), got.ID)
+			if err != nil || fetched.ID != got.ID {
+				t.Errorf("Get(%q) = (%+v, %v), want created item", got.ID, fetched, err)
+			}
+			done := true
+			changed, err := s.Update(context.Background(), got.ID, nil, &done)
+			if err != nil || !changed.Done {
+				t.Errorf("Update(%q) = (%+v, %v), want done", got.ID, changed, err)
+			}
+			listed, err := s.List(context.Background(), &done, 20, 0)
+			if err != nil || len(listed) != 1 {
+				t.Errorf("List(done) = (%d items, %v), want one item", len(listed), err)
+			}
+			if err := s.Delete(context.Background(), got.ID); err != nil {
+				t.Errorf("Delete(%q) = %v, want nil", got.ID, err)
+			}
+			if _, err := s.Get(context.Background(), got.ID); err != ErrNotFound {
+				t.Errorf("Get(deleted id) error = %v, want %v", err, ErrNotFound)
+			}
+		})
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore(clock.Real{})
+	const count = 80
+	var wg sync.WaitGroup
+	ids := make(chan string, count)
+	for i := 0; i < count; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			item, err := s.Create(context.Background(), "task")
+			if err != nil {
+				t.Errorf("Create(task) error = %v, want nil", err)
+				return
+			}
+			ids <- item.ID
+			_, err = s.Get(context.Background(), item.ID)
+			if err != nil {
+				t.Errorf("Get(%q) error = %v, want nil", item.ID, err)
+			}
+			done := true
+			if _, err = s.Update(context.Background(), item.ID, nil, &done); err != nil {
+				t.Errorf("Update(%q) error = %v, want nil", item.ID, err)
+			}
+			if err = s.Delete(context.Background(), item.ID); err != nil {
+				t.Errorf("Delete(%q) error = %v, want nil", item.ID, err)
+			}
+		}()
+	}
+	wg.Wait()
+	close(ids)
+	seen := make(map[string]bool)
+	for key := range ids {
+		if seen[key] {
+			t.Errorf("Create generated duplicate id %q", key)
+		}
+		seen[key] = true
+	}
+	if len(seen) != count {
+		t.Errorf("concurrent operations created %d identifiers, want %d", len(seen), count)
+	}
+}
