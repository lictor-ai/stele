index 0000000..ff2703b
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,170 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+
+	"example.com/app/internal/todo"
+)
+
+type todoStore interface {
+	Create(context.Context, string) (todo.Todo, error)
+	Get(context.Context, string) (todo.Todo, error)
+	Update(context.Context, string, *string, *bool) (todo.Todo, error)
+	Delete(context.Context, string) error
+	List(context.Context, *bool, int, int) ([]todo.Todo, error)
+}
+
+// NewHandler builds the TODO HTTP API.
+func NewHandler(store todoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", func(w http.ResponseWriter, r *http.Request) { createTodo(w, r, store) })
+	mux.HandleFunc("GET /todos", func(w http.ResponseWriter, r *http.Request) { listTodos(w, r, store) })
+	mux.HandleFunc("GET /todos/{id}", func(w http.ResponseWriter, r *http.Request) { getTodo(w, r, store) })
+	mux.HandleFunc("PATCH /todos/{id}", func(w http.ResponseWriter, r *http.Request) { patchTodo(w, r, store) })
+	mux.HandleFunc("DELETE /todos/{id}", func(w http.ResponseWriter, r *http.Request) { deleteTodo(w, r, store) })
+	return mux
+}
+
+func decode(w http.ResponseWriter, r *http.Request, dst any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if err := d.Decode(dst); err != nil {
+		Error(w, http.StatusBadRequest, "invalid JSON request")
+		return false
+	}
+	var extra any
+	if err := d.Decode(&extra); err != io.EOF {
+		Error(w, http.StatusBadRequest, "request must contain one JSON value")
+		return false
+	}
+	return true
+}
+
+func createTodo(w http.ResponseWriter, r *http.Request, s todoStore) {
+	var body struct {
+		Title string `json:"title"`
+	}
+	if !decode(w, r, &body) {
+		return
+	}
+	t, err := s.Create(r.Context(), body.Title)
+	if err != nil {
+		Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+		return
+	}
+	JSON(w, http.StatusCreated, t)
+}
+
+func listTodos(w http.ResponseWriter, r *http.Request, s todoStore) {
+	q := r.URL.Query()
+	var done *bool
+	if values, ok := q["done"]; ok {
+		if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+		value := values[0] == "true"
+		done = &value
+	}
+	limit := 20
+	offset := 0
+	for key, target := range map[string]*int{"limit": &limit, "offset": &offset} {
+		values, ok := q[key]
+		if !ok {
+			continue
+		}
+		if len(values) != 1 {
+			Error(w, http.StatusBadRequest, "invalid pagination parameter")
+			return
+		}
+		n, err := strconv.Atoi(values[0])
+		if err != nil || (key == "limit" && (n < 1 || n > 100)) || (key == "offset" && n < 0) {
+			Error(w, http.StatusBadRequest, "invalid pagination parameter")
+			return
+		}
+		*target = n
+	}
+	items, err := s.List(r.Context(), done, limit, offset)
+	if err != nil {
+		Error(w, http.StatusBadRequest, "invalid request")
+		return
+	}
+	JSON(w, http.StatusOK, items)
+}
+
+func getTodo(w http.ResponseWriter, r *http.Request, s todoStore) {
+	t, err := s.Get(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		Error(w, http.StatusBadRequest, "invalid request")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func patchTodo(w http.ResponseWriter, r *http.Request, s todoStore) {
+	var body map[string]json.RawMessage
+	if !decode(w, r, &body) {
+		return
+	}
+	if len(body) == 0 {
+		Error(w, http.StatusBadRequest, "provide title and/or done")
+		return
+	}
+	var title *string
+	var done *bool
+	for key, raw := range body {
+		switch key {
+		case "title":
+			var v string
+			if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) || json.Unmarshal(raw, &v) != nil {
+				Error(w, http.StatusBadRequest, "title must be a string")
+				return
+			}
+			title = &v
+		case "done":
+			var v bool
+			if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) || json.Unmarshal(raw, &v) != nil {
+				Error(w, http.StatusBadRequest, "done must be a boolean")
+				return
+			}
+			done = &v
+		default:
+			Error(w, http.StatusBadRequest, "unknown field")
+			return
+		}
+	}
+	t, err := s.Update(r.Context(), r.PathValue("id"), title, done)
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func deleteTodo(w http.ResponseWriter, r *http.Request, s todoStore) {
+	err := s.Delete(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		Error(w, http.StatusBadRequest, "invalid request")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
