@@ -0,0 +1,86 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestRoutes(t *testing.T) {
+	cases := []struct {
+		name, method, path, body string
+		want                     int
+	}{
+		{"create", "POST", "/todos", `{"title":" alpha "}`, 201},
+		{"create invalid title", "POST", "/todos", `{"title":" "}`, 400},
+		{"create unknown field", "POST", "/todos", `{"title":"x","extra":1}`, 400},
+		{"create malformed", "POST", "/todos", `{`, 400},
+		{"list", "GET", "/todos", ``, 200},
+		{"list done", "GET", "/todos?done=true&limit=1&offset=0", ``, 200},
+		{"list invalid done", "GET", "/todos?done=yes", ``, 400},
+		{"list invalid limit", "GET", "/todos?limit=101", ``, 400},
+		{"list invalid offset", "GET", "/todos?offset=-1", ``, 400},
+		{"get missing", "GET", "/todos/missing", ``, 404},
+		{"patch missing", "PATCH", "/todos/missing", `{"done":true}`, 404},
+		{"patch empty", "PATCH", "/todos/missing", `{}`, 400},
+		{"delete missing", "DELETE", "/todos/missing", ``, 404},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			created, err := s.Create(context.Background(), "seed")
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(tc.path, "missing") {
+				_ = created
+			}
+			h := NewHandler(s)
+			req := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+			rec := httptest.NewRecorder()
+			h.ServeHTTP(rec, req)
+			if rec.Code != tc.want {
+				t.Errorf("%s %s status = %d, want %d; body %s", tc.method, tc.path, rec.Code, tc.want, rec.Body.String())
+			}
+			if tc.want == 400 || tc.want == 404 {
+				var envelope map[string]string
+				if err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil || envelope["error"] == "" {
+					t.Errorf("%s %s error body = %q, want JSON error envelope", tc.method, tc.path, rec.Body.String())
+				}
+			}
+		})
+	}
+}
+
+func TestRoutesCreatedItemLifecycle(t *testing.T) {
+	s := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	h := NewHandler(s)
+	req := httptest.NewRequest(http.MethodPost, "/todos", strings.NewReader(`{"title":"write"}`))
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	if rec.Code != http.StatusCreated {
+		t.Fatalf("POST /todos status = %d, want %d", rec.Code, http.StatusCreated)
+	}
+	var created todo.Todo
+	if err := json.Unmarshal(rec.Body.Bytes(), &created); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		method, body string
+		want         int
+	}{{http.MethodGet, "", 200}, {http.MethodPatch, `{"title":"done","done":true}`, 200}, {http.MethodDelete, "", 204}} {
+		request := httptest.NewRequest(tc.method, "/todos/"+created.ID, strings.NewReader(tc.body))
+		response := httptest.NewRecorder()
+		h.ServeHTTP(response, request)
+		if response.Code != tc.want {
+			t.Errorf("%s /todos/{id} status = %d, want %d", tc.method, response.Code, tc.want)
+		}
+	}
+}
