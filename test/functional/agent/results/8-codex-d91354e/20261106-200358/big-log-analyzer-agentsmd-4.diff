@@ -0,0 +1,57 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	cases := []struct {
+		name     string
+		args     []string
+		want     string
+		wantCode int
+	}{
+		{name: "text report", args: []string{"-top=1"}, want: "Total requests"},
+		{name: "json report", args: []string{"-json"}, want: `"total_requests": 1`},
+		{name: "bad flags", args: []string{"-unknown"}, wantCode: 2},
+		{name: "unreadable file", args: []string{"missing.log"}, wantCode: 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, "access.log")
+			data := `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042` + "\nnot a log line\n"
+			if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+				t.Fatal(err)
+			}
+			args := append([]string(nil), tc.args...)
+			if tc.name == "text report" || tc.name == "json report" {
+				args = append(args, path)
+			}
+			var stdout, stderr bytes.Buffer
+			err := run(args, &stdout, &stderr)
+			code := 0
+			if err != nil {
+				if ex, ok := err.(exitError); ok {
+					code = ex.code
+				} else {
+					t.Fatalf("run(%v) error = %v, want nil", args, err)
+				}
+			}
+			if code != tc.wantCode {
+				t.Errorf("run(%v) exit code = %d, want %d", args, code, tc.wantCode)
+			}
+			output := stdout.String() + stderr.String()
+			if tc.want != "" && !strings.Contains(output, tc.want) {
+				t.Errorf("run(%v) output = %q, want it to contain %q", args, output, tc.want)
+			}
+			if tc.name == "text report" && !strings.Contains(output, "Malformed lines") {
+				t.Errorf("run(%v) output = %q, want malformed count", args, output)
+			}
+		})
+	}
+}
diff --git a/internal/logparse/parse.go b/internal/logparse/parse.go
new file mode 100644
index 0000000..9b9671c
--- /dev/null
+++ b/internal/logparse/parse.go
@@ -0,0 +1,82 @@
+// Package logparse parses nginx combined access log records with a trailing request time.
+package logparse
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Record is one valid access log request.
+type Record struct {
+	Path     string
+	Status   int
+	Duration time.Duration
+	Time     time.Time
+}
+
+// Parse parses one combined log line whose final field is request time in seconds.
+func Parse(line string) (Record, error) {
+	fields, err := split(line)
+	if err != nil || len(fields) != 10 {
+		return Record{}, fmt.Errorf("invalid combined log line")
+	}
+	timestamp, err := time.Parse("02/Jan/2006:15:04:05 -0700", fields[3])
+	if err != nil {
+		return Record{}, fmt.Errorf("invalid timestamp: %w", err)
+	}
+	request := strings.Fields(fields[4])
+	if len(request) != 3 {
+		return Record{}, fmt.Errorf("invalid request")
+	}
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return Record{}, fmt.Errorf("invalid status")
+	}
+	seconds, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || seconds < 0 {
+		return Record{}, fmt.Errorf("invalid request time")
+	}
+	duration := time.Duration(seconds * float64(time.Second))
+	path := strings.SplitN(request[1], "?", 2)[0]
+	if path == "" || !strings.HasPrefix(request[2], "HTTP/") {
+		return Record{}, fmt.Errorf("invalid request target")
+	}
+	return Record{Path: path, Status: status, Duration: duration, Time: timestamp}, nil
+}
+
+func split(line string) ([]string, error) {
+	var fields []string
+	for i := 0; i < len(line); {
+		for i < len(line) && line[i] == ' ' {
+			i++
+		}
+		if i == len(line) {
+			break
+		}
+		if line[i] == '"' || line[i] == '[' {
+			close := byte('"')
+			if line[i] == '[' {
+				close = ']'
+			}
+			i++
+			start := i
+			for i < len(line) && line[i] != close {
+				i++
+			}
+			if i == len(line) {
+				return nil, fmt.Errorf("unterminated field")
+			}
+			fields = append(fields, line[start:i])
+			i++
+		} else {
+			start := i
+			for i < len(line) && line[i] != ' ' {
+				i++
+			}
+			fields = append(fields, line[start:i])
+		}
+	}
+	return fields, nil
+}
