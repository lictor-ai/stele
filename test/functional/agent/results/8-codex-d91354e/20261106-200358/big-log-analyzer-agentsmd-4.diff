+++ b/internal/stats/stats_test.go
@@ -0,0 +1,49 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestBuild(t *testing.T) {
+	cases := []struct {
+		name                               string
+		records                            []logparse.Record
+		malformed, top, wantTotal, wantTop int
+		wantP50, wantP95, wantP99          float64
+		want5xx                            int
+	}{
+		{name: "empty", top: 10},
+		{name: "single", records: []logparse.Record{{Path: "/a", Status: 503, Duration: 42 * time.Millisecond, Time: time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)}}, malformed: 2, top: 10, wantTotal: 1, wantTop: 1, wantP50: 42, wantP95: 42, wantP99: 42, want5xx: 1},
+		{name: "percentile edges and top", records: []logparse.Record{{Path: "/b", Status: 200, Duration: 1 * time.Millisecond}, {Path: "/a", Status: 404, Duration: 2 * time.Millisecond}, {Path: "/a", Status: 200, Duration: 3 * time.Millisecond}, {Path: "/a", Status: 200, Duration: 4 * time.Millisecond}}, top: 1, wantTotal: 4, wantTop: 1, wantP50: 2, wantP95: 4, wantP99: 4},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Build(tc.records, tc.malformed, tc.top)
+			if got.Total != tc.wantTotal {
+				t.Errorf("Build total = %d, want %d", got.Total, tc.wantTotal)
+			}
+			if got.Malformed != tc.malformed {
+				t.Errorf("Build malformed = %d, want %d", got.Malformed, tc.malformed)
+			}
+			if len(got.TopPaths) != tc.wantTop {
+				t.Errorf("Build top paths = %d, want %d", len(got.TopPaths), tc.wantTop)
+			}
+			if got.P50 != tc.wantP50 || got.P95 != tc.wantP95 || got.P99 != tc.wantP99 {
+				t.Errorf("Build percentiles = %v/%v/%v, want %v/%v/%v", got.P50, got.P95, got.P99, tc.wantP50, tc.wantP95, tc.wantP99)
+			}
+			if got.StatusClasses["2xx"]+got.StatusClasses["3xx"]+got.StatusClasses["4xx"]+got.StatusClasses["5xx"] != tc.wantTotal {
+				t.Errorf("Build status counts = %v, want total %d", got.StatusClasses, tc.wantTotal)
+			}
+			count := 0
+			for _, n := range got.ErrorsPerHour {
+				count += n
+			}
+			if count != tc.want5xx {
+				t.Errorf("Build hourly 5xx total = %d, want %d", count, tc.want5xx)
+			}
+		})
+	}
+}
