@@ -0,0 +1,36 @@
+package logparse
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, line   string
+		wantPath     string
+		wantStatus   int
+		wantDuration time.Duration
+		wantErr      bool
+	}{
+		{name: "valid with query", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, wantPath: "/api/items", wantStatus: 200, wantDuration: 42 * time.Millisecond},
+		{name: "empty", line: "", wantErr: true},
+		{name: "missing quote", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 200 3 "-" "agent" 0.1`, wantErr: true},
+		{name: "bad status", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" nope 3 "-" "agent" 0.1`, wantErr: true},
+		{name: "bad time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 3 "-" "agent" -0.1`, wantErr: true},
+		{name: "bad timestamp", line: `203.0.113.9 - - [bad] "GET / HTTP/1.1" 200 3 "-" "agent" 0.1`, wantErr: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("Parse(%q) error = %v, wantErr %v", tc.line, err, tc.wantErr)
+			}
+			if err == nil {
+				if got.Path != tc.wantPath || got.Status != tc.wantStatus || got.Duration != tc.wantDuration {
+					t.Errorf("Parse(%q) = %+v, want path %q status %d duration %v", tc.line, got, tc.wantPath, tc.wantStatus, tc.wantDuration)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
