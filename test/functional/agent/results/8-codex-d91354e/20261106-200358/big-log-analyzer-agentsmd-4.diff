index 0000000..6bdca91
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,116 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"text/tabwriter"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+type exitError struct {
+	code int
+	err  error
+}
+
+func (e exitError) Error() string { return e.err.Error() }
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		var ex exitError
+		if errors.As(err, &ex) {
+			fmt.Fprintln(os.Stderr, ex.err)
+			os.Exit(ex.code)
+		}
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	asJSON := fs.Bool("json", false, "write JSON report")
+	if err := fs.Parse(args); err != nil {
+		return exitError{2, err}
+	}
+	if *top < 0 {
+		return exitError{2, fmt.Errorf("-top must not be negative")}
+	}
+	var records []logparse.Record
+	malformed := 0
+	consume := func(r io.Reader) error {
+		scanner := bufio.NewScanner(r)
+		scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for scanner.Scan() {
+			rec, err := logparse.Parse(scanner.Text())
+			if err != nil {
+				malformed++
+				continue
+			}
+			records = append(records, rec)
+		}
+		return scanner.Err()
+	}
+	files := fs.Args()
+	if len(files) == 0 {
+		if err := consume(os.Stdin); err != nil {
+			return exitError{1, fmt.Errorf("read stdin: %w", err)}
+		}
+	} else {
+		for _, name := range files {
+			file, err := os.Open(name)
+			if err != nil {
+				return exitError{1, fmt.Errorf("open %s: %w", name, err)}
+			}
+			readErr := consume(file)
+			closeErr := file.Close()
+			if readErr != nil {
+				return exitError{1, fmt.Errorf("read %s: %w", name, readErr)}
+			}
+			if closeErr != nil {
+				return exitError{1, fmt.Errorf("close %s: %w", name, closeErr)}
+			}
+		}
+	}
+	report := stats.Build(records, malformed, *top)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		return enc.Encode(report)
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(out io.Writer, r stats.Report) error {
+	w := tabwriter.NewWriter(out, 0, 4, 2, ' ', 0)
+	if _, err := fmt.Fprintf(w, "Total requests\t%d\nMalformed lines\t%d\n2xx\t%d\n3xx\t%d\n4xx\t%d\n5xx\t%d\nP50 (ms)\t%.3f\nP95 (ms)\t%.3f\nP99 (ms)\t%.3f\n\nTop paths\tRequests\n", r.Total, r.Malformed, r.StatusClasses["2xx"], r.StatusClasses["3xx"], r.StatusClasses["4xx"], r.StatusClasses["5xx"], r.P50, r.P95, r.P99); err != nil {
+		return err
+	}
+	for _, p := range r.TopPaths {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", p.Path, p.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(w, "\n5xx errors per hour\tCount"); err != nil {
+		return err
+	}
+	hours := make([]string, 0, len(r.ErrorsPerHour))
+	for h := range r.ErrorsPerHour {
+		hours = append(hours, h)
+	}
+	sort.Strings(hours)
+	for _, h := range hours {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", h, r.ErrorsPerHour[h]); err != nil {
+			return err
+		}
+	}
+	return w.Flush()
+}
