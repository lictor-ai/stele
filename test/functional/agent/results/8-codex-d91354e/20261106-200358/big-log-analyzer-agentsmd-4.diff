index 0000000..ad97713
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,75 @@
+// Package stats aggregates parsed access log records into a report.
+package stats
+
+import (
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// Report contains request counts, latency percentiles, and hourly server errors.
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50           float64        `json:"p50_ms"`
+	P95           float64        `json:"p95_ms"`
+	P99           float64        `json:"p99_ms"`
+	ErrorsPerHour map[string]int `json:"errors_per_hour"`
+}
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Build creates a report from valid records and a malformed line count.
+func Build(records []logparse.Record, malformed, top int) Report {
+	counts := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	latencies := make([]float64, 0, len(records))
+	for _, r := range records {
+		counts[r.Path]++
+		classes[string(rune('0'+r.Status/100))+"xx"]++
+		latencies = append(latencies, float64(r.Duration)/float64(time.Millisecond))
+		if r.Status >= 500 && r.Status < 600 {
+			hours[r.Time.Format("2006-01-02T15:00:00Z07:00")]++
+		}
+	}
+	paths := make([]PathCount, 0, len(counts))
+	for p, n := range counts {
+		paths = append(paths, PathCount{p, n})
+	}
+	sort.Slice(paths, func(i, j int) bool {
+		if paths[i].Count == paths[j].Count {
+			return paths[i].Path < paths[j].Path
+		}
+		return paths[i].Count > paths[j].Count
+	})
+	if top < 0 {
+		top = 0
+	}
+	if len(paths) > top {
+		paths = paths[:top]
+	}
+	sort.Float64s(latencies)
+	return Report{Total: len(records), Malformed: malformed, TopPaths: paths, StatusClasses: classes, P50: percentile(latencies, .50), P95: percentile(latencies, .95), P99: percentile(latencies, .99), ErrorsPerHour: hours}
+}
+
+func percentile(sorted []float64, p float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	i := int(float64(len(sorted)) * p)
+	if float64(i) < float64(len(sorted))*p {
+		i++
+	}
+	if i < 1 {
+		i = 1
+	}
+	return sorted[i-1]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
