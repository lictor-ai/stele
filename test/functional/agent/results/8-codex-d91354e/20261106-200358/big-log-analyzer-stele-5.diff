@@ -0,0 +1,50 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	cases := []struct {
+		name     string
+		args     []string
+		contents string
+		contains string
+		wantErr  bool
+	}{
+		{name: "text report counts malformed", args: []string{"-top=1", "access.log"}, contents: "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /x?q=1 HTTP/1.1\" 500 10 \"-\" \"agent\" 0.01\ninvalid\n", contains: "Malformed lines: 1"},
+		{name: "json report", args: []string{"-json", "access.log"}, contents: "", contains: `"total_requests": 0`},
+		{name: "unknown flag", args: []string{"-bad"}, wantErr: true},
+		{name: "missing file", args: []string{"absent.log"}, wantErr: true},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			directory := t.TempDir()
+			path := filepath.Join(directory, "access.log")
+			if err := os.WriteFile(path, []byte(test.contents), 0600); err != nil {
+				t.Fatal(err)
+			}
+			args := append([]string(nil), test.args...)
+			for index, argument := range args {
+				if argument == "access.log" {
+					args[index] = path
+				}
+			}
+			if test.name == "missing file" {
+				args[0] = filepath.Join(directory, "missing.log")
+			}
+			var stdout, stderr bytes.Buffer
+			err := run(args, &stdout, &stderr)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("run(%v) error = %v, want error %v", args, err, test.wantErr)
+			}
+			if !test.wantErr && !strings.Contains(stdout.String(), test.contains) {
+				t.Errorf("run(%v) output = %q, want it to contain %q", args, stdout.String(), test.contains)
+			}
+		})
+	}
+}
diff --git a/internal/logparse/parse.go b/internal/logparse/parse.go
