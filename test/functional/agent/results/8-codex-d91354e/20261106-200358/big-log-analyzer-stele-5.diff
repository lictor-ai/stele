index 0000000..368a2ad
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,88 @@
+// Package stats aggregates parsed access log requests into a report.
+package stats
+
+import (
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount is a path and its request count.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains summary statistics for a set of requests.
+type Report struct {
+	TotalRequests   int            `json:"total_requests"`
+	MalformedLines  int            `json:"malformed_lines"`
+	TopPaths        []PathCount    `json:"top_paths"`
+	StatusClasses   map[string]int `json:"status_classes"`
+	P50Milliseconds float64        `json:"p50_milliseconds"`
+	P95Milliseconds float64        `json:"p95_milliseconds"`
+	P99Milliseconds float64        `json:"p99_milliseconds"`
+	ErrorsPerHour   []HourCount    `json:"errors_per_hour"`
+}
+
+// HourCount is the number of server errors in one timestamp hour.
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// Build creates a report from valid requests and malformed line count.
+func Build(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	paths := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	durations := make([]time.Duration, 0, len(requests))
+	for _, request := range requests {
+		paths[request.Path]++
+		class := request.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			classes[key]++
+		}
+		if class == 5 {
+			hour := request.Timestamp.Format("2006-01-02T15:00:00Z07:00")
+			hours[hour]++
+		}
+		durations = append(durations, request.Duration)
+	}
+	pathCounts := make([]PathCount, 0, len(paths))
+	for path, count := range paths {
+		pathCounts = append(pathCounts, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(pathCounts, func(i, j int) bool {
+		if pathCounts[i].Count == pathCounts[j].Count {
+			return pathCounts[i].Path < pathCounts[j].Path
+		}
+		return pathCounts[i].Count > pathCounts[j].Count
+	})
+	if len(pathCounts) > top {
+		pathCounts = pathCounts[:top]
+	}
+	hourCounts := make([]HourCount, 0, len(hours))
+	for hour, count := range hours {
+		hourCounts = append(hourCounts, HourCount{Hour: hour, Count: count})
+	}
+	sort.Slice(hourCounts, func(i, j int) bool { return hourCounts[i].Hour < hourCounts[j].Hour })
+	sort.Slice(durations, func(i, j int) bool { return durations[i] < durations[j] })
+	return Report{
+		TotalRequests: len(requests), MalformedLines: malformed, TopPaths: pathCounts, StatusClasses: classes,
+		P50Milliseconds: percentile(durations, .50), P95Milliseconds: percentile(durations, .95), P99Milliseconds: percentile(durations, .99), ErrorsPerHour: hourCounts,
+	}
+}
+
+func percentile(values []time.Duration, p float64) float64 {
+	if len(values) == 0 {
+		return 0
+	}
+	index := int(float64(len(values))*p+.999999999) - 1
+	return float64(values[index]) / float64(time.Millisecond)
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..c8b2035
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,53 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestBuild(t *testing.T) {
+	instant, err := time.Parse(time.RFC3339, "2026-10-10T13:55:36Z")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name         string
+		requests     []logparse.Request
+		malformed    int
+		top          int
+		wantTotal    int
+		wantTopCount int
+		wantP50      float64
+		wantP95      float64
+		want5xx      int
+	}{
+		{name: "empty input", malformed: 2, top: 10},
+		{name: "single request", requests: []logparse.Request{{Path: "/one", Status: 200, Duration: 50 * time.Millisecond, Timestamp: instant}}, top: 10, wantTotal: 1, wantTopCount: 1, wantP50: 50, wantP95: 50},
+		{name: "percentile boundaries and top limit", requests: []logparse.Request{
+			{Path: "/b", Status: 500, Duration: 10 * time.Millisecond, Timestamp: instant},
+			{Path: "/a", Status: 302, Duration: 20 * time.Millisecond, Timestamp: instant},
+			{Path: "/a", Status: 404, Duration: 30 * time.Millisecond, Timestamp: instant},
+			{Path: "/c", Status: 201, Duration: 40 * time.Millisecond, Timestamp: instant},
+		}, top: 2, wantTotal: 4, wantTopCount: 2, wantP50: 20, wantP95: 40, want5xx: 1},
+		{name: "zero top", requests: []logparse.Request{{Path: "/a", Status: 503, Duration: time.Millisecond, Timestamp: instant}}, top: 0, wantTotal: 1, wantP50: 1, wantP95: 1, want5xx: 1},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			got := Build(test.requests, test.malformed, test.top)
+			if got.TotalRequests != test.wantTotal || got.MalformedLines != test.malformed {
+				t.Errorf("Build total/malformed = %d/%d, want %d/%d", got.TotalRequests, got.MalformedLines, test.wantTotal, test.malformed)
+			}
+			if len(got.TopPaths) != test.wantTopCount {
+				t.Errorf("Build top paths count = %d, want %d", len(got.TopPaths), test.wantTopCount)
+			}
+			if got.P50Milliseconds != test.wantP50 || got.P95Milliseconds != test.wantP95 {
+				t.Errorf("Build p50/p95 = %v/%v, want %v/%v", got.P50Milliseconds, got.P95Milliseconds, test.wantP50, test.wantP95)
+			}
+			if got.StatusClasses["5xx"] != test.want5xx {
+				t.Errorf("Build 5xx = %d, want %d", got.StatusClasses["5xx"], test.want5xx)
+			}
+		})
+	}
+}
