index 0000000..d9bd465
--- /dev/null
+++ b/internal/logparse/parse_test.go
@@ -0,0 +1,36 @@
+package logparse
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name      string
+		line      string
+		wantPath  string
+		wantCode  int
+		wantTime  time.Duration
+		wantError bool
+	}{
+		{name: "valid with query", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, wantPath: "/api/items", wantCode: 200, wantTime: 42 * time.Millisecond},
+		{name: "empty", line: "", wantError: true},
+		{name: "missing request time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "agent"`, wantError: true},
+		{name: "bad status", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" nope 1 "-" "agent" 0.1`, wantError: true},
+		{name: "bad duration", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "agent" -0.1`, wantError: true},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := Parse(test.line)
+			if (err != nil) != test.wantError {
+				t.Fatalf("Parse(%q) error = %v, want error %v", test.line, err, test.wantError)
+			}
+			if err == nil {
+				if got.Path != test.wantPath || got.Status != test.wantCode || got.Duration != test.wantTime {
+					t.Errorf("Parse(%q) = {path:%q status:%d duration:%s}, want {path:%q status:%d duration:%s}", test.line, got.Path, got.Status, got.Duration, test.wantPath, test.wantCode, test.wantTime)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
