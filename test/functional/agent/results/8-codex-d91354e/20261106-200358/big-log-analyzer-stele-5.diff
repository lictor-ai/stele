+++ b/cmd/loga/main.go
@@ -0,0 +1,138 @@
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		var flagErr *flagError
+		if errors.As(err, &flagErr) {
+			os.Exit(2)
+		}
+		os.Exit(1)
+	}
+}
+
+type flagError struct{ err error }
+
+func (e *flagError) Error() string { return e.err.Error() }
+func (e *flagError) Unwrap() error { return e.err }
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("loga", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	top := flags.Int("top", 10, "number of paths to show")
+	jsonOutput := flags.Bool("json", false, "write JSON report")
+	if err := flags.Parse(args); err != nil {
+		return &flagError{err: err}
+	}
+	if *top < 0 {
+		return &flagError{err: fmt.Errorf("-top must be non-negative")}
+	}
+	inputs := flags.Args()
+	var requests []logparse.Request
+	malformed := 0
+	consume := func(name string, reader io.Reader) error {
+		buffer := make([]byte, 64*1024)
+		pending := ""
+		for {
+			n, readErr := reader.Read(buffer)
+			pending += string(buffer[:n])
+			for {
+				index := strings.IndexByte(pending, '\n')
+				if index < 0 {
+					break
+				}
+				line := strings.TrimSuffix(pending[:index], "\r")
+				pending = pending[index+1:]
+				request, parseErr := logparse.Parse(line)
+				if parseErr != nil {
+					malformed++
+					continue
+				}
+				requests = append(requests, request)
+			}
+			if readErr != nil {
+				if readErr != io.EOF {
+					return fmt.Errorf("read %s: %w", name, readErr)
+				}
+				break
+			}
+		}
+		if pending != "" {
+			request, parseErr := logparse.Parse(strings.TrimSuffix(pending, "\r"))
+			if parseErr != nil {
+				malformed++
+			} else {
+				requests = append(requests, request)
+			}
+		}
+		return nil
+	}
+	if len(inputs) == 0 {
+		if err := consume("stdin", os.Stdin); err != nil {
+			return err
+		}
+	} else {
+		for _, name := range inputs {
+			file, err := os.Open(name)
+			if err != nil {
+				return fmt.Errorf("open %s: %w", name, err)
+			}
+			readErr := consume(name, file)
+			closeErr := file.Close()
+			if readErr != nil {
+				return readErr
+			}
+			if closeErr != nil {
+				return fmt.Errorf("close %s: %w", name, closeErr)
+			}
+		}
+	}
+	report := stats.Build(requests, malformed, *top)
+	if *jsonOutput {
+		encoder := json.NewEncoder(stdout)
+		encoder.SetIndent("", "  ")
+		return encoder.Encode(report)
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(writer io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(writer, "Total requests: %d\nMalformed lines: %d\n\nTop paths\n", report.TotalRequests, report.MalformedLines); err != nil {
+		return err
+	}
+	for _, path := range report.TopPaths {
+		if _, err := fmt.Fprintf(writer, "%s %d\n", path.Path, path.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(writer, "\nStatus classes"); err != nil {
+		return err
+	}
+	for _, class := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(writer, "%s %d\n", class, report.StatusClasses[class]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(writer, "\nRequest time (ms)\np50 %.3f\np95 %.3f\np99 %.3f\n\n5xx per hour\n", report.P50Milliseconds, report.P95Milliseconds, report.P99Milliseconds); err != nil {
+		return err
+	}
+	for _, hour := range report.ErrorsPerHour {
+		if _, err := fmt.Fprintf(writer, "%s %d\n", hour.Hour, hour.Count); err != nil {
+			return err
+		}
+	}
+	return nil
+}
