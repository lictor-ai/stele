index 0000000..5922a27
--- /dev/null
+++ b/internal/logparse/parse.go
@@ -0,0 +1,89 @@
+// Package logparse parses nginx combined access log lines with a request time field.
+package logparse
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is one successfully parsed access log entry.
+type Request struct {
+	Path      string
+	Status    int
+	Duration  time.Duration
+	Timestamp time.Time
+}
+
+// Parse parses one nginx combined access log line with request time appended.
+func Parse(line string) (Request, error) {
+	var request Request
+	fields := splitFields(line)
+	if len(fields) != 10 {
+		return request, fmt.Errorf("expected 10 fields, got %d", len(fields))
+	}
+	timestamp, err := time.Parse("02/Jan/2006:15:04:05 -0700", fields[3])
+	if err != nil {
+		return request, fmt.Errorf("parse timestamp %q: %w", fields[3], err)
+	}
+	parts := strings.Fields(fields[4])
+	if len(parts) != 3 {
+		return request, fmt.Errorf("parse request %q: expected method, path, and protocol", fields[4])
+	}
+	status, err := strconv.Atoi(fields[5])
+	if err != nil {
+		return request, fmt.Errorf("parse status %q: %w", fields[5], err)
+	}
+	seconds, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || seconds < 0 {
+		if err == nil {
+			err = fmt.Errorf("duration is negative")
+		}
+		return request, fmt.Errorf("parse request time %q: %w", fields[9], err)
+	}
+	path := parts[1]
+	if parsed, err := url.ParseRequestURI(path); err == nil && parsed.Path != "" {
+		path = parsed.Path
+	} else if index := strings.IndexByte(path, '?'); index >= 0 {
+		path = path[:index]
+	}
+	request = Request{Path: path, Status: status, Duration: time.Duration(seconds * float64(time.Second)), Timestamp: timestamp}
+	return request, nil
+}
+
+func splitFields(line string) []string {
+	fields := make([]string, 0, 13)
+	for index := 0; index < len(line); {
+		for index < len(line) && line[index] == ' ' {
+			index++
+		}
+		if index == len(line) {
+			break
+		}
+		if line[index] == '"' || line[index] == '[' {
+			closing := byte('"')
+			if line[index] == '[' {
+				closing = ']'
+			}
+			index++
+			start := index
+			for index < len(line) && line[index] != closing {
+				index++
+			}
+			if index == len(line) {
+				return nil
+			}
+			fields = append(fields, line[start:index])
+			index++
+			continue
+		}
+		start := index
+		for index < len(line) && line[index] != ' ' {
+			index++
+		}
+		fields = append(fields, line[start:index])
+	}
+	return fields
+}
diff --git a/internal/logparse/parse_test.go b/internal/logparse/parse_test.go
