+	}
+	inv := Invoice{ID: id, Customer: customer, Region: options.Region, Lines: lines, TotalCents: total, IssuedAt: options.Clock.Now()}
+	rate, ok := options.TaxRates[options.Region]
+	if options.Region != "" && !ok {
+		return Invoice{}, fmt.Errorf("billing: no tax rate for region %q", options.Region)
+	}
+	if rate < 0 || rate > 10000 {
+		return Invoice{}, fmt.Errorf("billing: invalid tax rate for region %q", options.Region)
+	}
