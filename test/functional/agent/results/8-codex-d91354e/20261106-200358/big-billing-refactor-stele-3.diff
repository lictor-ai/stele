+func TestDiscounts(t *testing.T) {
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	expired := now.Add(-time.Second)
+	cases := []struct {
+		name     string
+		discount Discount
+		book     *DiscountBook
+		want     int64
+		wantErr  bool
+	}{
+		{name: "percentage rounds half away", discount: Discount{Code: "HALF", PercentBPS: 5000}, book: NewDiscountBook(), want: 51},
+		{name: "fixed amount floors at total", discount: Discount{Code: "BIG", AmountCents: 1000}, book: NewDiscountBook(), want: 101},
+		{name: "expired", discount: Discount{Code: "OLD", AmountCents: 1, ExpiresAt: &expired}, book: NewDiscountBook(), wantErr: true},
+		{name: "reused", discount: Discount{Code: "ONCE", AmountCents: 1}, book: usedBook(t, now, "ONCE"), wantErr: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inv, err := ComputeWithOptions("inv", "customer", []Line{{Quantity: 1, UnitCents: 101}}, Options{
+				Clock: clock.Fixed{T: now}, Discount: &tc.discount, DiscountBook: tc.book,
+			})
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("ComputeWithOptions error = %v, wantErr %v", err, tc.wantErr)
+			}
+			if err == nil && inv.DiscountCents != tc.want {
