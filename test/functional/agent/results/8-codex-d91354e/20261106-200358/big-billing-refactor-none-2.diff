--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,26 @@
+package billing
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+	"time"
+)
+
+// WriteCSV writes invoices in a stable CSV format. Monetary amounts are cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	if err := cw.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand total"}); err != nil {
+		return err
+	}
+	for _, inv := range invoices {
+		record := []string{inv.ID, inv.Customer, inv.Region, inv.IssuedAt.Format(time.RFC3339),
+			strconv.FormatInt(inv.TotalCents, 10), strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10), strconv.FormatInt(inv.GrandTotalCents, 10)}
+		if err := cw.Write(record); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
