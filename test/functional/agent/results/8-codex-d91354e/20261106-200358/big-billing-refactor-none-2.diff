+// DiscountType identifies how a discount code is calculated.
+type DiscountType string
+
+const (
+	Percentage  DiscountType = "percentage"
+	FixedAmount DiscountType = "fixed"
+)
+
+// DiscountCode can be applied once to each customer. Percentage discounts use
+// whole percentage points; fractional cents are rounded to the nearest cent.
+// FixedAmountCents is used for fixed discounts.
+type DiscountCode struct {
+	Code             string
+	Type             DiscountType
+	Percentage       int64
+	FixedAmountCents int64
+	ExpiresAt        *time.Time
+
+	mu     sync.Mutex
+	usedBy map[string]bool
+}
+
+// ComputeOptions controls optional invoice discounts and regional tax. TaxRates
+// maps a region to basis points (100 basis points = 1%).
+type ComputeOptions struct {
+	Region   string
+	Discount *DiscountCode
+	TaxRates map[string]int64
+}
+
+// ComputeWithOptions builds an invoice with an optional discount and tax.
+func ComputeWithOptions(id, customer string, lines []Line, options ComputeOptions) (Invoice, error) {
 	if customer == "" {
-		panic("billing: no customer")
+		return Invoice{}, fmt.Errorf("billing: no customer")
+	}
+	total := lineTotal(lines)
+	if total < 0 {
+		total = 0
 	}
+	var discount int64
+	if options.Discount != nil {
+		var err error
+		discount, err = options.Discount.apply(customer, total, time.Now())
+		if err != nil {
+			return Invoice{}, err
+		}
+	}
+	if discount > total {
+		discount = total
+	}
+	base := total - discount
+	rate := options.TaxRates[options.Region]
+	tax := (base*rate + 5000) / 10000
+	return Invoice{ID: id, Customer: customer, Region: options.Region, Lines: lines, TotalCents: total,
+		DiscountCents: discount, TaxCents: tax, GrandTotalCents: base + tax, IssuedAt: time.Now()}, nil
+}
+
+func (d *DiscountCode) apply(customer string, total int64, now time.Time) (int64, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.Code == "" {
+		return 0, fmt.Errorf("billing: discount code is empty")
+	}
+	if d.ExpiresAt != nil && now.After(*d.ExpiresAt) {
+		return 0, fmt.Errorf("billing: discount code %q has expired", d.Code)
+	}
+	if d.usedBy == nil {
+		d.usedBy = make(map[string]bool)
+	}
+	if d.usedBy[customer] {
+		return 0, fmt.Errorf("billing: discount code %q already used by customer", d.Code)
+	}
+	var amount int64
+	switch d.Type {
+	case Percentage:
+		if d.Percentage < 0 || d.Percentage > 100 {
+			return 0, fmt.Errorf("billing: invalid discount percentage")
+		}
+		amount = (total*d.Percentage + 50) / 100
+	case FixedAmount:
+		if d.FixedAmountCents < 0 {
+			return 0, fmt.Errorf("billing: invalid fixed discount")
+		}
+		amount = d.FixedAmountCents
+	default:
+		return 0, fmt.Errorf("billing: invalid discount type")
+	}
+	if amount > total {
+		amount = total
+	}
+	d.usedBy[customer] = true
+	return amount, nil
+}
+
+func lineTotal(lines []Line) int64 {
 	var total int64
 	for _, l := range lines {
 		total += int64(l.Quantity) * l.UnitCents
 	}
+	return total
+}
+
+// Compute builds an invoice for a customer.
+func Compute(id, customer string, lines []Line) Invoice {
+	if customer == "" {
