diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..e300ddc
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,152 @@
+// Package todo provides concurrent in-memory TODO storage.
+package todo
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"sync"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task with creation and update timestamps.
+type Todo struct {
+	ID        string `json:"id"`
+	Title     string `json:"title"`
+	Done      bool   `json:"done"`
+	CreatedAt string `json:"created_at"`
+	UpdatedAt string `json:"updated_at"`
+}
+
+// Store holds todos safely for concurrent use.
+type Store struct {
+	mu    sync.RWMutex
+	items map[string]Todo
+	order map[string]uint64
+	next  uint64
+	clock clock.Clock
+}
+
+// NewStore creates an empty store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	if c == nil {
+		c = clock.Real{}
+	}
+	return &Store{items: make(map[string]Todo), order: make(map[string]uint64), clock: c}
+}
+
+// Create adds a todo with the supplied title.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	title = strings.TrimSpace(title)
+	if title == "" || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now().UTC().Format("2006-01-02T15:04:05.999999999Z07:00")
+	item := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[item.ID] = item
+	s.next++
+	s.order[item.ID] = s.next
+	s.mu.Unlock()
+	return item, nil
+}
+
+// Get returns a todo by identifier.
+func (s *Store) Get(ctx context.Context, key string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	item, ok := s.items[key]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return item, nil
+}
+
+// Update changes the title and/or done state of a todo.
+func (s *Store) Update(ctx context.Context, key string, title *string, done *bool) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	if title == nil && done == nil {
+		return Todo{}, ErrInvalid
+	}
+	normalized := ""
+	if title != nil {
+		normalized = strings.TrimSpace(*title)
+		if normalized == "" || len([]rune(normalized)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.items[key]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		item.Title = normalized
+	}
+	if done != nil {
+		item.Done = *done
+	}
+	item.UpdatedAt = s.clock.Now().UTC().Format("2006-01-02T15:04:05.999999999Z07:00")
+	s.items[key] = item
+	return item, nil
+}
+
+// Delete removes a todo by identifier.
+func (s *Store) Delete(ctx context.Context, key string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[key]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, key)
+	delete(s.order, key)
+	return nil
+}
+
+// List returns todos newest first, with optional state filtering and pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if limit < 0 || offset < 0 {
+		return nil, ErrInvalid
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.items))
+	orders := make(map[string]uint64, len(s.items))
+	for _, item := range s.items {
+		if done == nil || item.Done == *done {
+			items = append(items, item)
+			orders[item.ID] = s.order[item.ID]
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt == items[j].CreatedAt {
+			return orders[items[i].ID] > orders[items[j].ID]
+		}
+		return items[i].CreatedAt > items[j].CreatedAt
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if limit >= 0 && limit < len(items) {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..276ea51
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,123 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name    string
+		title   string
+		wantErr error
+	}{
+		{name: "valid", title: " write report "},
+		{name: "empty", title: "  ", wantErr: ErrInvalid},
+		{name: "too long", title: string(make([]rune, 201)), wantErr: ErrInvalid},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			store := NewStore(clock.Fixed{T: time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)})
+			item, err := store.Create(context.Background(), tc.title)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.title, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				return
+			}
+			if item.Title != "write report" || item.ID == "" || item.CreatedAt != item.UpdatedAt {
+				t.Fatalf("Create(%q) = %+v, want normalized title and timestamps", tc.title, item)
+			}
+			updated, err := store.Update(context.Background(), item.ID, nil, boolPointer(true))
+			if err != nil || !updated.Done {
+				t.Fatalf("Update(%q, done=true) = %+v, %v, want done", item.ID, updated, err)
+			}
+			got, err := store.Get(context.Background(), item.ID)
+			if err != nil || got.Done != true {
+				t.Fatalf("Get(%q) = %+v, %v, want done=true", item.ID, got, err)
+			}
+			if err := store.Delete(context.Background(), item.ID); err != nil {
+				t.Fatalf("Delete(%q) error = %v, want nil", item.ID, err)
+			}
+			if _, err := store.Get(context.Background(), item.ID); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Get(%q) after delete error = %v, want ErrNotFound", item.ID, err)
+			}
+		})
+	}
+}
+
+func TestStoreList(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)})
+	first, _ := store.Create(context.Background(), "first")
+	second, _ := store.Create(context.Background(), "second")
+	_, _ = store.Update(context.Background(), first.ID, nil, boolPointer(true))
+	filter := true
+	cases := []struct {
+		name          string
+		filter        *bool
+		limit, offset int
+		want          []string
+		wantErr       error
+	}{
+		{name: "newest first", limit: 10, want: []string{second.ID, first.ID}},
+		{name: "filtered", filter: &filter, limit: 10, want: []string{first.ID}},
+		{name: "pagination", limit: 1, offset: 1, want: []string{first.ID}},
+		{name: "past end", limit: 2, offset: 3, want: []string{}},
+		{name: "negative offset", limit: 1, offset: -1, wantErr: ErrInvalid},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := store.List(context.Background(), tc.filter, tc.limit, tc.offset)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("List(done, %d, %d) error = %v, want %v", tc.limit, tc.offset, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				return
+			}
+			if len(got) != len(tc.want) {
+				t.Fatalf("List(done, %d, %d) returned %d items, want %d", tc.limit, tc.offset, len(got), len(tc.want))
+			}
+			for index, item := range got {
+				if item.ID != tc.want[index] {
+					t.Errorf("List item %d ID = %q, want %q", index, item.ID, tc.want[index])
+				}
+			}
+		})
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Real{})
+	const workers = 12
+	const each = 30
+	var group sync.WaitGroup
+	group.Add(workers)
+	for worker := 0; worker < workers; worker++ {
+		go func(worker int) {
+			defer group.Done()
+			for n := 0; n < each; n++ {
+				item, err := store.Create(context.Background(), fmt.Sprintf("task %d %d", worker, n))
+				if err != nil {
+					t.Errorf("Create(task %d %d) error = %v, want nil", worker, n, err)
+					return
+				}
+				if _, err := store.Get(context.Background(), item.ID); err != nil {
+					t.Errorf("Get(%q) error = %v, want nil", item.ID, err)
+				}
+			}
+		}(worker)
+	}
+	group.Wait()
+	items, err := store.List(context.Background(), nil, workers*each, 0)
+	if err != nil || len(items) != workers*each {
+		t.Fatalf("List(all) returned %d items, %v, want %d items", len(items), err, workers*each)
+	}
+}
