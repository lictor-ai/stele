@@ -0,0 +1,84 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	cases := []struct {
+		name, method, path, body string
+		want                     int
+		wantErr                  bool
+	}{
+		{"create", http.MethodPost, "/todos", `{"title":"write"}`, http.StatusCreated, false},
+		{"empty title", http.MethodPost, "/todos", `{"title":"  "}`, http.StatusBadRequest, true},
+		{"unknown field", http.MethodPost, "/todos", `{"title":"write","extra":true}`, http.StatusBadRequest, true},
+		{"bad JSON", http.MethodPost, "/todos", `{`, http.StatusBadRequest, true},
+		{"list", http.MethodGet, "/todos", "", http.StatusOK, false},
+		{"bad done", http.MethodGet, "/todos?done=maybe", "", http.StatusBadRequest, true},
+		{"bad limit", http.MethodGet, "/todos?limit=101", "", http.StatusBadRequest, true},
+		{"bad offset", http.MethodGet, "/todos?offset=-1", "", http.StatusBadRequest, true},
+		{"missing get", http.MethodGet, "/todos/missing", "", http.StatusNotFound, true},
+		{"missing patch", http.MethodPatch, "/todos/missing", `{"done":true}`, http.StatusNotFound, true},
+		{"empty patch", http.MethodPatch, "/todos/missing", `{}`, http.StatusBadRequest, true},
+		{"missing delete", http.MethodDelete, "/todos/missing", "", http.StatusNotFound, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			handler := NewTodoHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+			handler.ServeHTTP(recorder, request)
+			if recorder.Code != tc.want {
+				t.Errorf("%s %s status = %d, want %d", tc.method, tc.path, recorder.Code, tc.want)
+			}
+			if tc.wantErr {
+				var payload map[string]string
+				if err := json.Unmarshal(recorder.Body.Bytes(), &payload); err != nil || payload["error"] == "" {
+					t.Errorf("%s %s body = %q, want JSON error body", tc.method, tc.path, recorder.Body.String())
+				}
+			}
+		})
+	}
+}
+
+func TestTodoRouteFlow(t *testing.T) {
+	handler := NewTodoHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+	call := func(method, path, body string) *httptest.ResponseRecorder {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest(method, path, strings.NewReader(body)))
+		return recorder
+	}
+	created := call(http.MethodPost, "/todos", `{"title":" first "}`)
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name, method, path, body string
+		want                     int
+	}{
+		{"get", http.MethodGet, "/todos/" + item.ID, "", http.StatusOK},
+		{"patch title", http.MethodPatch, "/todos/" + item.ID, `{"title":"updated"}`, http.StatusOK},
+		{"patch done", http.MethodPatch, "/todos/" + item.ID, `{"done":true}`, http.StatusOK},
+		{"filter", http.MethodGet, "/todos?done=true&limit=1&offset=0", "", http.StatusOK},
+		{"delete", http.MethodDelete, "/todos/" + item.ID, "", http.StatusNoContent},
+		{"get after delete", http.MethodGet, "/todos/" + item.ID, "", http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := call(tc.method, tc.path, tc.body)
+			if got.Code != tc.want {
+				t.Errorf("%s %s status = %d, want %d", tc.method, tc.path, got.Code, tc.want)
+			}
+		})
+	}
+}
