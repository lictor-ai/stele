@@ -0,0 +1,188 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// TodoStore describes the storage operations used by the HTTP handler.
+type TodoStore interface {
+	Create(ctx context.Context, title string) (todo.Todo, error)
+	Get(ctx context.Context, identifier string) (todo.Todo, error)
+	Update(ctx context.Context, identifier string, title *string, done *bool) (todo.Todo, error)
+	Delete(ctx context.Context, identifier string) error
+	List(ctx context.Context, done *bool, limit, offset int) ([]todo.Todo, error)
+}
+
+// NewTodoHandler creates an HTTP handler for todo routes.
+func NewTodoHandler(store TodoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", func(w http.ResponseWriter, r *http.Request) { createTodo(w, r, store) })
+	mux.HandleFunc("GET /todos", func(w http.ResponseWriter, r *http.Request) { listTodos(w, r, store) })
+	mux.HandleFunc("GET /todos/{id}", func(w http.ResponseWriter, r *http.Request) { getTodo(w, r, store) })
+	mux.HandleFunc("PATCH /todos/{id}", func(w http.ResponseWriter, r *http.Request) { patchTodo(w, r, store) })
+	mux.HandleFunc("DELETE /todos/{id}", func(w http.ResponseWriter, r *http.Request) { deleteTodo(w, r, store) })
+	return mux
+}
+
+type createRequest struct {
+	Title string `json:"title"`
+}
+type patchRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, target any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+func createTodo(w http.ResponseWriter, r *http.Request, store TodoStore) {
+	var request createRequest
+	if err := decodeBody(w, r, &request); err != nil {
+		Error(w, http.StatusBadRequest, "send a valid JSON todo")
+		return
+	}
+	if strings.TrimSpace(request.Title) == "" || len([]rune(strings.TrimSpace(request.Title))) > 200 {
+		Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+		return
+	}
+	item, err := store.Create(r.Context(), request.Title)
+	if err != nil {
+		if errors.Is(err, todo.ErrInvalid) {
+			Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+			return
+		}
+		log.Error("create todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not create todo")
+		return
+	}
+	JSON(w, http.StatusCreated, item)
+}
+
+func listTodos(w http.ResponseWriter, r *http.Request, store TodoStore) {
+	query := r.URL.Query()
+	var done *bool
+	if values, ok := query["done"]; ok {
+		if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+		parsed := values[0] == "true"
+		done = &parsed
+	}
+	limit := 20
+	if values, ok := query["limit"]; ok {
+		if len(values) != 1 {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		parsed, err := strconv.Atoi(values[0])
+		if err != nil || parsed < 1 || parsed > 100 {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		limit = parsed
+	}
+	offset := 0
+	if values, ok := query["offset"]; ok {
+		if len(values) != 1 {
+			Error(w, http.StatusBadRequest, "offset must be zero or greater")
+			return
+		}
+		parsed, err := strconv.Atoi(values[0])
+		if err != nil || parsed < 0 {
+			Error(w, http.StatusBadRequest, "offset must be zero or greater")
+			return
+		}
+		offset = parsed
+	}
+	items, err := store.List(r.Context(), done, limit, offset)
+	if err != nil {
+		log.Error("list todos", "err", err)
+		Error(w, http.StatusInternalServerError, "could not list todos")
+		return
+	}
+	JSON(w, http.StatusOK, items)
+}
+
+func getTodo(w http.ResponseWriter, r *http.Request, store TodoStore) {
+	item, err := store.Get(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		log.Error("get todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not get todo")
+		return
+	}
+	JSON(w, http.StatusOK, item)
+}
+
+func patchTodo(w http.ResponseWriter, r *http.Request, store TodoStore) {
+	var request patchRequest
+	if err := decodeBody(w, r, &request); err != nil {
+		Error(w, http.StatusBadRequest, "send a valid JSON update")
+		return
+	}
+	if request.Title == nil && request.Done == nil {
+		Error(w, http.StatusBadRequest, "provide title or done")
+		return
+	}
+	if request.Title != nil && (strings.TrimSpace(*request.Title) == "" || len([]rune(strings.TrimSpace(*request.Title))) > 200) {
+		Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+		return
+	}
+	item, err := store.Update(r.Context(), r.PathValue("id"), request.Title, request.Done)
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if errors.Is(err, todo.ErrInvalid) {
+		Error(w, http.StatusBadRequest, "provide a valid title or done value")
+		return
+	}
+	if err != nil {
+		log.Error("update todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not update todo")
+		return
+	}
+	JSON(w, http.StatusOK, item)
+}
+
+func deleteTodo(w http.ResponseWriter, r *http.Request, store TodoStore) {
+	err := store.Delete(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		log.Error("delete todo", "err", err)
+		Error(w, http.StatusInternalServerError, "could not delete todo")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
