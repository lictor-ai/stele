index 0000000..5196b9d
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,141 @@
+// Package todo provides concurrent in-memory todo storage.
+package todo
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task and its timestamps.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store holds todos. mu guards todos.
+type Store struct {
+	mu    sync.RWMutex
+	todos map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates an empty store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{todos: make(map[string]Todo), clock: c}
+}
+
+// Create adds a todo with a generated identifier.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("create todo: %w", err)
+	}
+	title = strings.TrimSpace(title)
+	if title == "" || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now()
+	item := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.todos[item.ID] = item
+	s.mu.Unlock()
+	return item, nil
+}
+
+// Get returns a todo by identifier.
+func (s *Store) Get(ctx context.Context, identifier string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("get todo: %w", err)
+	}
+	s.mu.RLock()
+	item, ok := s.todos[identifier]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return item, nil
+}
+
+// Update changes the supplied title and/or done value.
+func (s *Store) Update(ctx context.Context, identifier string, title *string, done *bool) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("update todo: %w", err)
+	}
+	if title == nil && done == nil {
+		return Todo{}, ErrInvalid
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.todos[identifier]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		clean := strings.TrimSpace(*title)
+		if clean == "" || len([]rune(clean)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+		item.Title = clean
+	}
+	if done != nil {
+		item.Done = *done
+	}
+	item.UpdatedAt = s.clock.Now()
+	s.todos[identifier] = item
+	return item, nil
+}
+
+// Delete removes a todo by identifier.
+func (s *Store) Delete(ctx context.Context, identifier string) error {
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("delete todo: %w", err)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.todos[identifier]; !ok {
+		return ErrNotFound
+	}
+	delete(s.todos, identifier)
+	return nil
+}
+
+// List returns todos newest first with an optional done filter and pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("list todos: %w", err)
+	}
+	if limit < 0 || offset < 0 {
+		return nil, ErrInvalid
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.todos))
+	for _, item := range s.todos {
+		if done == nil || item.Done == *done {
+			items = append(items, item)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if limit > 0 && len(items) > limit {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..0e96bee
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,112 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name    string
+		title   string
+		wantErr error
+	}{
+		{name: "valid", title: "  write docs  "}, {name: "empty", title: "  ", wantErr: ErrInvalid}, {name: "too long", title: string(make([]byte, 201)), wantErr: ErrInvalid},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			store := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			item, err := store.Create(context.Background(), tc.title)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.title, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				return
+			}
+			if item.Title != "write docs" || item.ID == "" || !item.CreatedAt.Equal(item.UpdatedAt) {
+				t.Errorf("Create(%q) = %+v, want trimmed title and initialized timestamps", tc.title, item)
+			}
+			got, err := store.Get(context.Background(), item.ID)
+			if err != nil || got.ID != item.ID {
+				t.Errorf("Get(%q) = %+v, %v, want created todo", item.ID, got, err)
+			}
+			title := "review code"
+			done := true
+			updated, err := store.Update(context.Background(), item.ID, &title, &done)
+			if err != nil || updated.Title != title || !updated.Done {
+				t.Errorf("Update(%q) = %+v, %v, want updated title and done", item.ID, updated, err)
+			}
+			if _, err := store.Update(context.Background(), item.ID, nil, nil); !errors.Is(err, ErrInvalid) {
+				t.Errorf("Update(%q, nil, nil) error = %v, want %v", item.ID, err, ErrInvalid)
+			}
+			if err := store.Delete(context.Background(), item.ID); err != nil {
+				t.Errorf("Delete(%q) error = %v, want nil", item.ID, err)
+			}
+			if _, err := store.Get(context.Background(), item.ID); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Get(%q) error = %v, want %v", item.ID, err, ErrNotFound)
+			}
+		})
+	}
+}
+
+func TestStoreList(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	for _, title := range []string{"first", "second", "third"} {
+		if _, err := store.Create(context.Background(), title); err != nil {
+			t.Fatal(err)
+		}
+	}
+	filter := false
+	cases := []struct {
+		name                string
+		done                *bool
+		limit, offset, want int
+	}{{"all", nil, 20, 0, 3}, {"filter", &filter, 20, 0, 3}, {"page", nil, 1, 1, 1}, {"past end", nil, 2, 5, 0}, {"negative", nil, -1, 0, -1}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := store.List(context.Background(), tc.done, tc.limit, tc.offset)
+			if tc.want < 0 {
+				if !errors.Is(err, ErrInvalid) {
+					t.Errorf("List() error = %v, want %v", err, ErrInvalid)
+				}
+				return
+			}
+			if err != nil || len(got) != tc.want {
+				t.Errorf("List() = %d items, %v, want %d", len(got), err, tc.want)
+			}
+			if tc.name == "all" && len(got) > 1 && got[0].ID < got[1].ID {
+				t.Errorf("List() order = %q before %q, want newest first", got[0].ID, got[1].ID)
+			}
+		})
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Now()})
+	const workers = 32
+	var group sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		group.Add(1)
