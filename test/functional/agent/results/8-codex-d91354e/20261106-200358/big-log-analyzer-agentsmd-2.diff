diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..c23ddb2
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,113 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+type flagError struct{ err error }
+
+func (e flagError) Error() string { return e.err.Error() }
+func (e flagError) Unwrap() error { return e.err }
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		var badFlags flagError
+		if errors.As(err, &badFlags) {
+			os.Exit(2)
+		}
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("loga", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	topN := flags.Int("top", 10, "number of paths to show")
+	jsonOutput := flags.Bool("json", false, "write JSON report")
+	if err := flags.Parse(args); err != nil {
+		return flagError{err: err}
+	}
+	if *topN < 0 {
+		return flagError{err: fmt.Errorf("-top must be non-negative")}
+	}
+	files := flags.Args()
+	requests := make([]logparse.Request, 0)
+	malformed := 0
+	if len(files) == 0 {
+		if err := readLog(os.Stdin, &requests, &malformed); err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+	} else {
+		for _, name := range files {
+			file, err := os.Open(name)
+			if err != nil {
+				return fmt.Errorf("open %s: %w", name, err)
+			}
+			err = readLog(file, &requests, &malformed)
+			closeErr := file.Close()
+			if err != nil {
+				return fmt.Errorf("read %s: %w", name, err)
+			}
+			if closeErr != nil {
+				return fmt.Errorf("close %s: %w", name, closeErr)
+			}
+		}
+	}
+	report := stats.Build(requests, malformed, *topN)
+	if *jsonOutput {
+		return json.NewEncoder(stdout).Encode(report)
+	}
+	return writeText(stdout, report)
+}
+
+func readLog(reader io.Reader, requests *[]logparse.Request, malformed *int) error {
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+	for scanner.Scan() {
+		request, err := logparse.ParseLine(scanner.Text())
+		if err != nil {
+			*malformed++
+			continue
+		}
+		*requests = append(*requests, request)
+	}
+	return scanner.Err()
+}
+
+func writeText(w io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", report.TotalRequests, report.MalformedLines); err != nil {
+		return err
+	}
+	for _, path := range report.TopPaths {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", path.Path, path.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(w, "\nStatus classes\nCLASS\tCOUNT"); err != nil {
+		return err
+	}
+	for _, class := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", class, report.StatusClasses[class]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(w, "\nRequest time (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n\n5xx errors per hour\nHOUR\tCOUNT\n", report.P50Millis, report.P95Millis, report.P99Millis); err != nil {
+		return err
+	}
+	for _, hour := range report.ErrorsPerHour {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", hour.Hour, hour.Count); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..f572f15
