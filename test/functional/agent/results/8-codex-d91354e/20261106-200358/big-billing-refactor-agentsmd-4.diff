+func TestComputeWithDiscount(t *testing.T) {
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	expiry := now.Add(time.Hour)
+	cases := []struct {
+		name      string
+		code      *DiscountCode
+		customer  string
+		amount    int64
+		want      int64
+		wantError bool
+	}{
+		{name: "expiry", code: &DiscountCode{Code: "OLD", Kind: FixedDiscount, AmountCents: 20, ExpiresAt: timePtr(now.Add(-time.Second))}, customer: "a", amount: 100, wantError: true},
+		{name: "reuse", code: &DiscountCode{Code: "ONCE", Kind: FixedDiscount, AmountCents: 20, ExpiresAt: &expiry, UsedCustomers: map[string]bool{"a": true}}, customer: "a", amount: 100, wantError: true},
+		{name: "floor at zero", code: &DiscountCode{Code: "BIG", Kind: FixedDiscount, AmountCents: 200}, customer: "b", amount: 100, want: 100},
+		{name: "percentage rounds half away", code: &DiscountCode{Code: "HALF", Kind: PercentageDiscount, PercentBPS: 5000}, customer: "c", amount: 5, want: 3},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inv, err := ComputeWithOptions("i", tc.customer, []Line{{Quantity: 1, UnitCents: tc.amount}}, ComputeOptions{IssuedAt: now, Discount: tc.code})
+			if (err != nil) != tc.wantError {
+				t.Fatalf("ComputeWithOptions() error = %v, wantError %v", err, tc.wantError)
+			}
+			if err == nil && inv.DiscountCents != tc.want {
+				t.Errorf("ComputeWithOptions() discount = %d, want %d", inv.DiscountCents, tc.want)
+			}
+		})
+	}
+}
