+	var output bytes.Buffer
+	err := WriteCSV(&output, []Invoice{{ID: "i1", Customer: "Acme, Inc", Region: "FR", IssuedAt: issued, TotalCents: 1000, DiscountCents: 100, TaxCents: 180, GrandTotalCents: 1080}})
