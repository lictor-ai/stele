@@ -0,0 +1,32 @@
+package billing
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+)
+
+// WriteCSV writes invoices as CSV with monetary values in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total_cents", "discount_cents", "tax_cents", "grand_total_cents"}); err != nil {
+		return err
+	}
+	for _, invoice := range invoices {
+		record := []string{
+			invoice.ID,
+			invoice.Customer,
+			invoice.Region,
+			invoice.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(invoice.TotalCents, 10),
+			strconv.FormatInt(invoice.DiscountCents, 10),
+			strconv.FormatInt(invoice.TaxCents, 10),
+			strconv.FormatInt(invoice.GrandTotalCents, 10),
+		}
+		if err := writer.Write(record); err != nil {
+			return err
+		}
+	}
+	writer.Flush()
+	return writer.Error()
+}
