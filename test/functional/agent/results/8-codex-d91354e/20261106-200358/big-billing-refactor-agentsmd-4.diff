+// ComputeWithOptions builds an invoice with optional discount and regional tax.
+func ComputeWithOptions(id, customer string, lines []Line, options ComputeOptions) (Invoice, error) {
+	rate, ok := options.TaxRates[options.Region]
+	if options.Region != "" && !ok {
+		return Invoice{}, fmt.Errorf("billing: no tax rate for region %q", options.Region)
+	}
+	if rate < 0 || rate > 10000 {
+		return Invoice{}, fmt.Errorf("billing: invalid tax rate for region %q", options.Region)
 	}
 	var total int64
-	for _, l := range lines {
-		total += int64(l.Quantity) * l.UnitCents
+	for _, line := range lines {
+		total += int64(line.Quantity) * line.UnitCents
+	}
+	inv := Invoice{ID: id, Customer: customer, Region: options.Region, Lines: append([]Line(nil), lines...), TotalCents: total, IssuedAt: options.IssuedAt}
+	if options.Discount != nil {
+		discount, err := redeemDiscount(options.Discount, customer, total, options.IssuedAt)
+		if err != nil {
+			return Invoice{}, err
+		}
+		inv.DiscountCents = discount
+	}
+	net := total - inv.DiscountCents
+	if net < 0 {
+		net = 0
+	}
+	inv.TaxCents = roundBasisPoints(net, rate)
+	inv.GrandTotalCents = net + inv.TaxCents
+	return inv, nil
+}
+
+func redeemDiscount(code *DiscountCode, customer string, total int64, now time.Time) (int64, error) {
+	code.mu.Lock()
+	defer code.mu.Unlock()
+	if code.ExpiresAt != nil && now.After(*code.ExpiresAt) {
+		return 0, fmt.Errorf("billing: discount code %q has expired", code.Code)
+	}
+	if code.UsedCustomers == nil {
+		code.UsedCustomers = make(map[string]bool)
+	}
+	if code.UsedCustomers[customer] {
+		return 0, fmt.Errorf("billing: discount code %q already used by customer", code.Code)
+	}
+	var discount int64
+	switch code.Kind {
+	case PercentageDiscount:
+		if code.PercentBPS < 0 || code.PercentBPS > 10000 {
+			return 0, fmt.Errorf("billing: invalid percentage discount")
+		}
+		discount = roundBasisPoints(total, code.PercentBPS)
+	case FixedDiscount:
+		if code.AmountCents < 0 {
+			return 0, fmt.Errorf("billing: invalid fixed discount")
+		}
+		discount = code.AmountCents
+	default:
+		return 0, fmt.Errorf("billing: invalid discount kind %q", code.Kind)
+	}
+	if discount > total {
+		discount = total
+	}
+	code.UsedCustomers[customer] = true
+	return discount, nil
+}
+
+func roundBasisPoints(amount, basisPoints int64) int64 {
+	product := amount * basisPoints
+	if product >= 0 {
+		return (product + 5000) / 10000
 	}
-	fmt.Printf("computed invoice %s for %s: %d\n", id, customer, total)
-	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, IssuedAt: time.Now()}
