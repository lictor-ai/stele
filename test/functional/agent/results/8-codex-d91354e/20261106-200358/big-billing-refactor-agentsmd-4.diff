+		t.Fatalf("WriteCSV() error = %v, want nil", err)
+	}
+	records, err := csv.NewReader(strings.NewReader(output.String())).ReadAll()
+	if err != nil {
+		t.Fatalf("ReadAll() error = %v, want nil", err)
+	}
+	want := [][]string{{"id", "customer", "region", "issued_at", "total_cents", "discount_cents", "tax_cents", "grand_total_cents"}, {"i1", "Acme, Inc", "FR", "2026-02-03T04:05:06+01:00", "1000", "100", "180", "1080"}}
+	if len(records) != len(want) {
+		t.Fatalf("CSV records = %v, want %v", records, want)
+	}
+	for i := range want {
+		if strings.Join(records[i], "|") != strings.Join(want[i], "|") {
+			t.Errorf("CSV record %d = %v, want %v", i, records[i], want[i])
+		}
+	}
+}
