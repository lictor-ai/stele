+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+)
+
+// ExportCSV writes invoices to w in CSV format, with monetary values in cents.
+func ExportCSV(w io.Writer, invoices []Invoice) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return fmt.Errorf("write invoice CSV header: %w", err)
+	}
+	for _, inv := range invoices {
+		record := []string{
+			inv.ID,
+			inv.Customer,
+			inv.Region,
+			inv.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := writer.Write(record); err != nil {
+			return fmt.Errorf("write invoice %q to CSV: %w", inv.ID, err)
+		}
+	}
+	writer.Flush()
+	if err := writer.Error(); err != nil {
+		return fmt.Errorf("flush invoice CSV: %w", err)
+	}
+	return nil
+}
