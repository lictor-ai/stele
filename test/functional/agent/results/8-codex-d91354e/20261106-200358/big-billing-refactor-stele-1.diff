+// DiscountKind identifies how a discount code reduces an invoice.
+type DiscountKind string
+
+const (
+	// DiscountPercentage applies a rate in basis points.
+	DiscountPercentage DiscountKind = "percentage"
+	// DiscountFixed applies a fixed amount in cents.
+	DiscountFixed DiscountKind = "fixed"
+)
+
+// DiscountCode describes a percentage or fixed amount discount.
+type DiscountCode struct {
+	Code       string       `json:"code"`
+	Kind       DiscountKind `json:"kind"`
+	Value      int64        `json:"value"`
+	ExpiresAt  *time.Time   `json:"expires_at,omitempty"`
+}
+
+// Calculator computes invoices with caller-provided tax rates and clock.
+type Calculator struct {
+	mu       sync.RWMutex
+	rates    map[string]int64
+	clock    clock.Clock
+	usedCode map[string]map[string]struct{}
+}
+
+// NewCalculator creates a calculator. Tax rates are basis points by region.
+func NewCalculator(taxRates map[string]int64, c clock.Clock) *Calculator {
+	rates := make(map[string]int64, len(taxRates))
+	for region, rate := range taxRates {
+		rates[region] = rate
+	}
+	if c == nil {
+		c = clock.Real{}
+	}
+	return &Calculator{rates: rates, clock: c, usedCode: make(map[string]map[string]struct{})}
+}
+
+// ComputeInvoice computes totals, applies an optional discount, and records its use.
+func (c *Calculator) ComputeInvoice(id, customer, region string, lines []Line, discount *DiscountCode) (Invoice, error) {
+	if customer == "" {
+		return Invoice{}, fmt.Errorf("customer is required")
+	}
+	rate, ok := c.rates[region]
+	if !ok {
+		return Invoice{}, fmt.Errorf("unknown tax region %q", region)
+	}
+	if rate < 0 || rate > 10000 {
+		return Invoice{}, fmt.Errorf("tax rate for region %q must be between 0 and 10000 basis points", region)
+	}
+	var total int64
+	for _, line := range lines {
+		if line.Quantity < 0 || line.UnitCents < 0 {
+			return Invoice{}, fmt.Errorf("invoice line %q has a negative quantity or price", line.SKU)
+		}
+		amount := int64(line.Quantity) * line.UnitCents
+		if line.Quantity != 0 && amount/int64(line.Quantity) != line.UnitCents || total > int64(^uint64(0)>>1)-amount {
+			return Invoice{}, fmt.Errorf("invoice total overflows cents")
+		}
+		total += amount
+	}
+	issuedAt := c.clock.Now()
+	inv := Invoice{ID: id, Customer: customer, Region: region, Lines: lines, TotalCents: total, IssuedAt: issuedAt}
+	if discount != nil {
+		if discount.Code == "" {
+			return Invoice{}, fmt.Errorf("discount code is required")
+		}
+		if discount.ExpiresAt != nil && !issuedAt.Before(*discount.ExpiresAt) {
+			return Invoice{}, fmt.Errorf("discount code %q has expired", discount.Code)
+		}
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		if customers := c.usedCode[discount.Code]; customers != nil {
+			if _, exists := customers[customer]; exists {
+				return Invoice{}, fmt.Errorf("discount code %q was already used by customer %q", discount.Code, customer)
+			}
+		}
+		discountCents, err := discountAmount(total, *discount)
+		if err != nil {
+			return Invoice{}, err
+		}
+		inv.DiscountCents = discountCents
+		customers := c.usedCode[discount.Code]
+		if customers == nil {
+			customers = make(map[string]struct{})
+			c.usedCode[discount.Code] = customers
+		}
+		customers[customer] = struct{}{}
+	}
+	taxable := total - inv.DiscountCents
+	inv.TaxCents = roundBasisPoints(taxable, rate)
+	inv.GrandTotalCents = taxable + inv.TaxCents
+	return inv, nil
+}
+
+func discountAmount(total int64, discount DiscountCode) (int64, error) {
+	switch discount.Kind {
+	case DiscountFixed:
+		if discount.Value < 0 {
+			return 0, fmt.Errorf("discount code %q has a negative amount", discount.Code)
+		}
+		if discount.Value > total {
+			return total, nil
+		}
+		return discount.Value, nil
+	case DiscountPercentage:
+		if discount.Value < 0 || discount.Value > 10000 {
+			return 0, fmt.Errorf("discount code %q percentage must be between 0 and 10000 basis points", discount.Code)
+		}
+		return roundBasisPoints(total, discount.Value), nil
+	default:
+		return 0, fmt.Errorf("discount code %q has unknown kind %q", discount.Code, discount.Kind)
+	}
+}
+
+func roundBasisPoints(amount, rate int64) int64 {
+	whole := amount / 10000 * rate
+	part := (amount%10000*rate + 5000) / 10000
+	return whole + part
 }
 
