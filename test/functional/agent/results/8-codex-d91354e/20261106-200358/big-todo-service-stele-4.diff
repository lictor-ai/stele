+package api
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	cases := []struct {
+		name, method, path, body string
+		status                   int
+		wantError                bool
+	}{
+		{name: "create", method: http.MethodPost, path: "/todos", body: `{"title":"write"}`, status: http.StatusCreated},
+		{name: "create empty title", method: http.MethodPost, path: "/todos", body: `{"title":"  "}`, status: http.StatusBadRequest, wantError: true},
+		{name: "create too long", method: http.MethodPost, path: "/todos", body: `{"title":"` + strings.Repeat("a", 201) + `"}`, status: http.StatusBadRequest, wantError: true},
+		{name: "create unknown field", method: http.MethodPost, path: "/todos", body: `{"title":"x","other":1}`, status: http.StatusBadRequest, wantError: true},
+		{name: "create malformed", method: http.MethodPost, path: "/todos", body: `{`, status: http.StatusBadRequest, wantError: true},
+		{name: "list", method: http.MethodGet, path: "/todos", status: http.StatusOK},
+		{name: "list filter", method: http.MethodGet, path: "/todos?done=true&limit=2&offset=0", status: http.StatusOK},
+		{name: "list invalid done", method: http.MethodGet, path: "/todos?done=maybe", status: http.StatusBadRequest, wantError: true},
+		{name: "list invalid limit", method: http.MethodGet, path: "/todos?limit=101", status: http.StatusBadRequest, wantError: true},
+		{name: "list invalid offset", method: http.MethodGet, path: "/todos?offset=-1", status: http.StatusBadRequest, wantError: true},
+		{name: "get missing", method: http.MethodGet, path: "/todos/missing", status: http.StatusNotFound, wantError: true},
+		{name: "patch missing", method: http.MethodPatch, path: "/todos/missing", body: `{"done":true}`, status: http.StatusNotFound, wantError: true},
+		{name: "patch empty", method: http.MethodPatch, path: "/todos/missing", body: `{}`, status: http.StatusBadRequest, wantError: true},
+		{name: "delete missing", method: http.MethodDelete, path: "/todos/missing", status: http.StatusNotFound, wantError: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			handler := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+			req := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+			rec := httptest.NewRecorder()
+			handler.ServeHTTP(rec, req)
+			if rec.Code != tc.status {
+				t.Errorf("%s %s status = %d, want %d", tc.method, tc.path, rec.Code, tc.status)
+			}
+			if tc.wantError {
+				var payload map[string]string
+				if err := json.Unmarshal(rec.Body.Bytes(), &payload); err != nil || payload["error"] == "" {
+					t.Errorf("%s %s error body = %q, %v; want JSON error", tc.method, tc.path, rec.Body.String(), err)
+				}
+			}
+		})
+	}
+}
+
+func TestTodoRouteLifecycle(t *testing.T) {
+	store := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	handler := NewHandler(store)
+	cases := []struct {
+		name, method, path, body string
+		status                   int
+	}{
+		{name: "create", method: http.MethodPost, path: "/todos", body: `{"title":"write"}`, status: http.StatusCreated},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			handler.ServeHTTP(rec, httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body)))
+			if rec.Code != tc.status {
+				t.Fatalf("%s status = %d, want %d", tc.name, rec.Code, tc.status)
+			}
+		})
+	}
+	items, err := store.List(context.Background(), nil, 1, 0)
+	if err != nil || len(items) != 1 {
+		t.Fatalf("List after create returned %v, %v; want one todo", items, err)
+	}
+	id := items[0].ID
+	steps := []struct {
+		name, method, body string
+		status             int
+	}{
+		{name: "get", method: http.MethodGet, status: http.StatusOK},
+		{name: "patch", method: http.MethodPatch, body: `{"done":true}`, status: http.StatusOK},
+		{name: "delete", method: http.MethodDelete, status: http.StatusNoContent},
+	}
+	for _, step := range steps {
+		t.Run(step.name, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			handler.ServeHTTP(rec, httptest.NewRequest(step.method, "/todos/"+id, strings.NewReader(step.body)))
+			if rec.Code != step.status {
+				t.Errorf("%s status = %d, want %d", step.name, rec.Code, step.status)
+			}
+		})
+	}
+}
