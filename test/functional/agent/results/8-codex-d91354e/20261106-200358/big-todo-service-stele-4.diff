@@ -0,0 +1,61 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("server", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	addr := flags.String("addr", ":8080", "listen address")
+	if err := flags.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	if flags.NArg() != 0 {
+		return fmt.Errorf("unexpected arguments: %v", flags.Args())
+	}
+	_ = stdout
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	server := &http.Server{Addr: *addr, Handler: api.NewHandler(todo.NewStore(clock.Real{})), ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second, WriteTimeout: 15 * time.Second, IdleTimeout: 60 * time.Second}
+	serveErr := make(chan error, 1)
+	go func() { serveErr <- server.ListenAndServe() }()
+	select {
+	case err := <-serveErr:
+		if !errors.Is(err, http.ErrServerClosed) {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	case <-ctx.Done():
+		shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := server.Shutdown(shutdownCtx); err != nil {
+			return fmt.Errorf("shut down HTTP server: %w", err)
+		}
+		err := <-serveErr
+		if !errors.Is(err, http.ErrServerClosed) {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..7145ee9
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,194 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// TodoStore describes the operations used by the HTTP API.
+type TodoStore interface {
+	Create(ctx context.Context, title string) (todo.Todo, error)
+	Get(ctx context.Context, id string) (todo.Todo, error)
+	Update(ctx context.Context, id string, update todo.Update) (todo.Todo, error)
+	Delete(ctx context.Context, id string) error
+	List(ctx context.Context, done *bool, limit, offset int) ([]todo.Todo, error)
+}
+
+// NewHandler returns the HTTP handler for the todo API.
+func NewHandler(store TodoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", createTodo(store))
+	mux.HandleFunc("GET /todos", listTodos(store))
+	mux.HandleFunc("GET /todos/{id}", getTodo(store))
+	mux.HandleFunc("PATCH /todos/{id}", patchTodo(store))
+	mux.HandleFunc("DELETE /todos/{id}", deleteTodo(store))
+	return mux
+}
+
+type createRequest struct {
+	Title string `json:"title"`
+}
+type patchRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, dst any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(dst); err != nil {
+		Error(w, http.StatusBadRequest, "request body must be valid JSON with supported fields")
+		return false
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		Error(w, http.StatusBadRequest, "request body must contain one JSON object")
+		return false
+	}
+	return true
+}
+
+func createTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var req createRequest
+		if !decodeBody(w, r, &req) {
+			return
+		}
+		if strings.TrimSpace(req.Title) == "" || len([]rune(strings.TrimSpace(req.Title))) > 200 {
+			Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+			return
+		}
+		created, err := store.Create(r.Context(), req.Title)
+		if err != nil {
+			log.Error("create todo", "err", err)
+			Error(w, http.StatusBadRequest, "provide a title with 1 to 200 characters")
+			return
+		}
+		JSON(w, http.StatusCreated, created)
+	}
+}
+
+func listTodos(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		query := r.URL.Query()
+		var done *bool
+		if values, ok := query["done"]; ok {
+			if len(values) != 1 {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			value, err := strconv.ParseBool(values[0])
+			if err != nil {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			done = &value
+		}
+		limit := 20
+		if values, ok := query["limit"]; ok {
+			if len(values) != 1 {
+				Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+				return
+			}
+			value, err := strconv.Atoi(values[0])
+			if err != nil || value < 1 || value > 100 {
+				Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+				return
+			}
+			limit = value
+		}
+		offset := 0
+		if values, ok := query["offset"]; ok {
+			if len(values) != 1 {
+				Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+				return
+			}
+			value, err := strconv.Atoi(values[0])
+			if err != nil || value < 0 {
+				Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+				return
+			}
+			offset = value
+		}
+		items, err := store.List(r.Context(), done, limit, offset)
+		if err != nil {
+			log.Error("list todos", "err", err)
+			Error(w, http.StatusBadRequest, "check the list filters and pagination")
+			return
+		}
+		JSON(w, http.StatusOK, items)
+	}
+}
+
+func getTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		item, err := store.Get(r.Context(), r.PathValue("id"))
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo was not found")
+			return
+		}
+		if err != nil {
+			log.Error("get todo", "err", err)
+			Error(w, http.StatusInternalServerError, "try again later")
+			return
+		}
+		JSON(w, http.StatusOK, item)
+	}
+}
+
+func patchTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var req patchRequest
+		if !decodeBody(w, r, &req) {
+			return
+		}
+		if req.Title == nil && req.Done == nil {
+			Error(w, http.StatusBadRequest, "provide title and/or done")
+			return
+		}
+		if req.Title != nil && (strings.TrimSpace(*req.Title) == "" || len([]rune(strings.TrimSpace(*req.Title))) > 200) {
+			Error(w, http.StatusBadRequest, "title must contain 1 to 200 characters")
+			return
+		}
+		item, err := store.Update(r.Context(), r.PathValue("id"), todo.Update{Title: req.Title, Done: req.Done})
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo was not found")
+			return
+		}
+		if errors.Is(err, todo.ErrInvalid) {
+			Error(w, http.StatusBadRequest, "provide title and/or done")
+			return
+		}
+		if err != nil {
+			log.Error("update todo", "err", err)
+			Error(w, http.StatusInternalServerError, "try again later")
+			return
+		}
+		JSON(w, http.StatusOK, item)
+	}
+}
+
+func deleteTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		err := store.Delete(r.Context(), r.PathValue("id"))
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo was not found")
+			return
+		}
+		if err != nil {
+			log.Error("delete todo", "err", err)
+			Error(w, http.StatusInternalServerError, "try again later")
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
