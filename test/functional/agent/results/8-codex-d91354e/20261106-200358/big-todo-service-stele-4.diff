@@ -0,0 +1,150 @@
+// Package todo provides concurrent in-memory todo storage.
+package todo
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task tracked by the service.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store holds todos safely for concurrent access. The mutex guards todos.
+type Store struct {
+	mu    sync.RWMutex
+	todos map[string]Todo
+	clock clock.Clock
+}
+
+// Update contains optional todo fields to change.
+type Update struct {
+	Title *string
+	Done  *bool
+}
+
+// NewStore creates a store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{todos: make(map[string]Todo), clock: c}
+}
+
+// Create adds a todo with a trimmed title.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("create todo: %w", err)
+	}
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.todos[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns a todo by ID.
+func (s *Store) Get(ctx context.Context, id string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("get todo: %w", err)
+	}
+	s.mu.RLock()
+	t, ok := s.todos[id]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes a todo title and/or completion state.
+func (s *Store) Update(ctx context.Context, id string, update Update) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("update todo: %w", err)
+	}
+	if update.Title == nil && update.Done == nil {
+		return Todo{}, ErrInvalid
+	}
+	if update.Title != nil {
+		trimmed := strings.TrimSpace(*update.Title)
+		if len([]rune(trimmed)) < 1 || len([]rune(trimmed)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+		update.Title = &trimmed
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.todos[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if update.Title != nil {
+		t.Title = *update.Title
+	}
+	if update.Done != nil {
+		t.Done = *update.Done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.todos[id] = t
+	return t, nil
+}
+
+// Delete removes a todo by ID.
+func (s *Store) Delete(ctx context.Context, id string) error {
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("delete todo: %w", err)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.todos[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.todos, id)
+	return nil
+}
+
+// List returns todos newest first, optionally filtered and paginated.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("list todos: %w", err)
+	}
+	if limit < 1 || offset < 0 {
+		return nil, ErrInvalid
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.todos))
+	for _, t := range s.todos {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if len(items) > limit {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
new file mode 100644
index 0000000..d68a664
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,128 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name string
+		run  func(t *testing.T, store *Store)
+	}{
+		{name: "create get update delete and missing", run: func(t *testing.T, store *Store) {
+			ctx := context.Background()
+			created, err := store.Create(ctx, " task ")
+			if err != nil {
+				t.Fatalf("Create returned %v, want nil", err)
+			}
+			if created.Title != "task" {
+				t.Errorf("Create title = %q, want task", created.Title)
+			}
+			got, err := store.Get(ctx, created.ID)
+			if err != nil || got.ID != created.ID {
+				t.Fatalf("Get returned (%v, %v), want created todo", got, err)
+			}
+			title := "updated"
+			done := true
+			changed, err := store.Update(ctx, created.ID, Update{Title: &title, Done: &done})
+			if err != nil || changed.Title != title || !changed.Done {
+				t.Fatalf("Update returned (%v, %v), want updated todo", changed, err)
+			}
+			if err := store.Delete(ctx, created.ID); err != nil {
+				t.Errorf("Delete returned %v, want nil", err)
+			}
+			if _, err := store.Get(ctx, created.ID); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Get deleted todo error = %v, want ErrNotFound", err)
+			}
+		}},
+		{name: "invalid create and update", run: func(t *testing.T, store *Store) {
+			for _, title := range []string{"", "  ", strings.Repeat("a", 201)} {
+				if _, err := store.Create(context.Background(), title); !errors.Is(err, ErrInvalid) {
+					t.Errorf("Create(%q) error = %v, want ErrInvalid", title, err)
+				}
+			}
+			if _, err := store.Update(context.Background(), "missing", Update{}); !errors.Is(err, ErrInvalid) {
+				t.Errorf("Update with no fields error = %v, want ErrInvalid", err)
+			}
+		}},
+		{name: "list filter ordering and pagination", run: func(t *testing.T, store *Store) {
+			ctx := context.Background()
+			first, _ := store.Create(ctx, "first")
+			second, _ := store.Create(ctx, "second")
+			done := true
+			_, err := store.Update(ctx, first.ID, Update{Done: &done})
+			if err != nil {
+				t.Fatal(err)
+			}
+			filter := true
+			items, err := store.List(ctx, &filter, 1, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(items) != 1 || items[0].ID != first.ID {
+				t.Errorf("List filtered page = %v, want first todo", items)
+			}
+			items, err = store.List(ctx, nil, 1, 0)
+			if err != nil || len(items) != 1 || items[0].ID != second.ID {
+				t.Errorf("List newest page = %v, %v; want second todo", items, err)
+			}
+			empty, err := store.List(ctx, nil, 2, 9)
+			if err != nil || len(empty) != 0 {
+				t.Errorf("List out of range = %v, %v, want empty", empty, err)
+			}
+		}},
+		{name: "invalid page", run: func(t *testing.T, store *Store) {
+			if _, err := store.List(context.Background(), nil, 0, 0); !errors.Is(err, ErrInvalid) {
+				t.Errorf("List limit zero error = %v, want ErrInvalid", err)
+			}
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			store := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			tc.run(t, store)
+		})
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	const workers = 32
+	var wg sync.WaitGroup
+	ids := make(chan string, workers)
+	for range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			item, err := store.Create(context.Background(), "parallel")
+			if err != nil {
+				t.Errorf("Create returned %v, want nil", err)
+				return
+			}
+			ids <- item.ID
+			if _, err := store.Get(context.Background(), item.ID); err != nil {
+				t.Errorf("Get returned %v, want nil", err)
+			}
+		}()
+	}
+	wg.Wait()
+	close(ids)
+	seen := make(map[string]bool)
+	for id := range ids {
+		if seen[id] {
+			t.Errorf("Create returned duplicate ID %q", id)
+		}
+		seen[id] = true
+	}
+	items, err := store.List(context.Background(), nil, workers, 0)
+	if err != nil || len(items) != workers {
+		t.Errorf("List returned %d items, %v; want %d items", len(items), err, workers)
+	}
+}
