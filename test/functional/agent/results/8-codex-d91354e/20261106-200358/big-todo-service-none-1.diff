@@ -0,0 +1,31 @@
+package main
+
+import (
+	"context"
+	"flag"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	addr := flag.String("addr", ":8080", "HTTP listen address")
+	flag.Parse()
+	server := &http.Server{Addr: *addr, Handler: api.New(todo.NewStore(nil)), ReadHeaderTimeout: 5 * time.Second}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	go func() {
+		<-ctx.Done()
+		shutdown, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		_ = server.Shutdown(shutdown)
+	}()
+	if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+		panic(err)
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..8d4928e
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,175 @@
+package api
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/todo"
+)
+
+// Handler serves the TODO JSON API.
+type Handler struct{ store *todo.Store }
+
+func New(store *todo.Store) http.Handler { return &Handler{store: store} }
+
+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	path := strings.Trim(r.URL.Path, "/")
+	if path == "todos" {
+		switch r.Method {
+		case http.MethodPost:
+			h.create(w, r)
+		case http.MethodGet:
+			h.list(w, r)
+		default:
+			methodNotAllowed(w)
+		}
+		return
+	}
+	if strings.HasPrefix(path, "todos/") {
+		id := strings.TrimPrefix(path, "todos/")
+		if id == "" || strings.Contains(id, "/") {
+			Error(w, http.StatusNotFound, "not found")
+			return
+		}
+		switch r.Method {
+		case http.MethodGet:
+			h.get(w, id)
+		case http.MethodPatch:
+			h.update(w, r, id)
+		case http.MethodDelete:
+			h.delete(w, id)
+		default:
+			methodNotAllowed(w)
+		}
+		return
+	}
+	Error(w, http.StatusNotFound, "not found")
+}
+
+func methodNotAllowed(w http.ResponseWriter) {
+	Error(w, http.StatusMethodNotAllowed, "method not allowed")
+}
+
+func decode(w http.ResponseWriter, r *http.Request, dst any) bool {
+	d := json.NewDecoder(r.Body)
+	if err := d.Decode(dst); err != nil {
+		Error(w, 400, "invalid JSON body")
+		return false
+	}
+	var extra any
+	if err := d.Decode(&extra); err != io.EOF {
+		Error(w, 400, "request body must contain one JSON value")
+		return false
+	}
+	return true
+}
+func validTitle(v string) bool { n := len([]rune(strings.TrimSpace(v))); return n >= 1 && n <= 200 }
+
+func (h *Handler) create(w http.ResponseWriter, r *http.Request) {
+	var in struct {
+		Title string `json:"title"`
+	}
+	if !decode(w, r, &in) {
+		return
+	}
+	if !validTitle(in.Title) {
+		Error(w, 400, "title must be 1 to 200 characters")
+		return
+	}
+	JSON(w, 201, h.store.Create(in.Title))
+}
+func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	var done *bool
+	if values, ok := q["done"]; ok {
+		if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+			Error(w, 400, "done must be true or false")
+			return
+		}
+		v := values[0] == "true"
+		done = &v
+	}
+	limit := 20
+	offset := 0
+	var err error
+	if values, ok := q["limit"]; ok {
+		if len(values) != 1 {
+			Error(w, 400, "invalid limit")
+			return
+		}
+		limit, err = strconv.Atoi(values[0])
+		if err != nil || limit < 1 || limit > 100 {
+			Error(w, 400, "limit must be between 1 and 100")
+			return
+		}
+	}
+	if values, ok := q["offset"]; ok {
+		if len(values) != 1 {
+			Error(w, 400, "invalid offset")
+			return
+		}
+		offset, err = strconv.Atoi(values[0])
+		if err != nil || offset < 0 {
+			Error(w, 400, "offset must be a non-negative integer")
+			return
+		}
+	}
+	JSON(w, 200, h.store.List(done, limit, offset))
+}
+func (h *Handler) get(w http.ResponseWriter, id string) {
+	t, ok := h.store.Get(id)
+	if !ok {
+		Error(w, 404, "todo not found")
+		return
+	}
+	JSON(w, 200, t)
+}
+func (h *Handler) update(w http.ResponseWriter, r *http.Request, id string) {
+	var in map[string]json.RawMessage
+	if !decode(w, r, &in) {
+		return
+	}
+	if len(in) == 0 {
+		Error(w, 400, "at least one field is required")
+		return
+	}
+	var title *string
+	var done *bool
+	for key, raw := range in {
+		switch key {
+		case "title":
+			var v string
+			if err := json.Unmarshal(raw, &v); err != nil || !validTitle(v) {
+				Error(w, 400, "title must be a string of 1 to 200 characters")
+				return
+			}
+			title = &v
+		case "done":
+			var v bool
+			if err := json.Unmarshal(raw, &v); err != nil {
+				Error(w, 400, "done must be a boolean")
+				return
+			}
+			done = &v
+		default:
+			Error(w, 400, "unknown field: "+key)
+			return
+		}
+	}
+	t, err := h.store.Update(id, title, done)
+	if err != nil {
+		Error(w, 404, "todo not found")
+		return
+	}
+	JSON(w, 200, t)
+}
+func (h *Handler) delete(w http.ResponseWriter, id string) {
+	if !h.store.Delete(id) {
+		Error(w, 404, "todo not found")
+		return
+	}
+	w.WriteHeader(204)
+}
