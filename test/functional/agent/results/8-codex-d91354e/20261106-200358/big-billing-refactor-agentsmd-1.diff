@@ -0,0 +1,14 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrInvalidDiscount indicates an unsupported or malformed discount.
+	ErrInvalidDiscount = errors.New("invalid discount")
+	// ErrDiscountExpired indicates that a discount has expired.
+	ErrDiscountExpired = errors.New("discount expired")
+	// ErrDiscountUsed indicates that this customer already redeemed the code.
+	ErrDiscountUsed = errors.New("discount already used by customer")
+	// ErrMissingClock indicates that pricing options lack a clock.
+	ErrMissingClock = errors.New("billing clock is required")
+)
