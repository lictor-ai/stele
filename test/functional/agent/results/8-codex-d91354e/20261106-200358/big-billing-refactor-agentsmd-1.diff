--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,26 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+)
+
+// ExportCSV writes invoices with monetary values represented in cents.
+func ExportCSV(w io.Writer, invoices []Invoice) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return fmt.Errorf("write invoice CSV header: %w", err)
+	}
+	for _, inv := range invoices {
+		record := []string{inv.ID, inv.Customer, inv.Region, inv.IssuedAt.Format("2006-01-02T15:04:05Z07:00"), fmt.Sprint(inv.TotalCents), fmt.Sprint(inv.DiscountCents), fmt.Sprint(inv.TaxCents), fmt.Sprint(inv.GrandTotalCents)}
+		if err := writer.Write(record); err != nil {
+			return fmt.Errorf("write invoice %s to CSV: %w", inv.ID, err)
+		}
+	}
+	writer.Flush()
+	if err := writer.Error(); err != nil {
+		return fmt.Errorf("flush invoice CSV: %w", err)
+	}
+	return nil
+}
