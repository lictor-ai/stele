@@ -0,0 +1,76 @@
+package billing
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestDiscounts(t *testing.T) {
+	now := time.Date(2026, time.January, 2, 3, 4, 5, 0, time.UTC)
+	cases := []struct {
+		name    string
+		code    DiscountCode
+		want    int64
+		wantErr error
+	}{
+		{name: "expired", code: DiscountCode{Code: "OLD", Kind: FixedDiscount, Value: 50, ExpiresAt: timePtr(now.Add(-time.Second))}, wantErr: ErrDiscountExpired},
+		{name: "floor at zero", code: DiscountCode{Code: "BIG", Kind: FixedDiscount, Value: 500}, want: 101},
+		{name: "percent half rounds up", code: DiscountCode{Code: "HALF", Kind: PercentageDiscount, Value: 5000}, want: 51},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			book := NewDiscountBook()
+			opts := Options{Clock: clock.Fixed{T: now}, Discount: &tc.code, DiscountBook: book}
+			inv, err := ComputeWithOptions("i", "c", []Line{{Quantity: 1, UnitCents: 101}}, opts)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("ComputeWithOptions error = %v, want %v", err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if inv.DiscountCents != tc.want {
+				t.Errorf("discount = %d, want %d", inv.DiscountCents, tc.want)
+			}
+			_, err = ComputeWithOptions("i2", "c", nil, opts)
+			if !errors.Is(err, ErrDiscountUsed) {
+				t.Errorf("second redemption error = %v, want %v", err, ErrDiscountUsed)
+			}
+		})
+	}
+}
+
+func TestTaxAfterDiscount(t *testing.T) {
+	now := time.Date(2026, time.January, 2, 0, 0, 0, 0, time.UTC)
+	code := DiscountCode{Code: "SAVE", Kind: FixedDiscount, Value: 100}
+	opts := Options{Clock: clock.Fixed{T: now}, Region: "FR", TaxRates: map[string]int64{"FR": 2000}, Discount: &code, DiscountBook: NewDiscountBook()}
+	inv, err := ComputeWithOptions("i", "c", []Line{{Quantity: 1, UnitCents: 1000}}, opts)
+	if err != nil {
+		t.Fatalf("ComputeWithOptions() error = %v", err)
+	}
+	if inv.TaxCents != 180 || inv.GrandTotalCents != 1080 {
+		t.Errorf("tax/total = %d/%d, want 180/1080", inv.TaxCents, inv.GrandTotalCents)
+	}
+}
+
+func TestExportCSV(t *testing.T) {
+	issued := time.Date(2026, time.March, 4, 5, 6, 7, 0, time.FixedZone("CET", 3600))
+	var out bytes.Buffer
+	err := ExportCSV(&out, []Invoice{{ID: "i1", Customer: "acme", Region: "DE", IssuedAt: issued, TotalCents: 1000, DiscountCents: 100, TaxCents: 171, GrandTotalCents: 1071}})
+	if err != nil {
+		t.Fatalf("ExportCSV() error = %v", err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\ni1,acme,DE,2026-03-04T05:06:07+01:00,1000,100,171,1071\n"
+	if got := out.String(); got != want {
+		t.Errorf("ExportCSV() = %q, want %q", got, want)
+	}
+	if !strings.Contains(out.String(), issued.Format(time.RFC3339)) {
+		t.Errorf("CSV timestamp does not use RFC 3339: %q", out.String())
+	}
+}
+
+func timePtr(value time.Time) *time.Time { return &value }
