index 0000000..72a31dc
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,97 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() { os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)) }
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	asJSON := fs.Bool("json", false, "print JSON report")
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	if *top < 0 {
+		fmt.Fprintln(stderr, "-top must be non-negative")
+		return 2
+	}
+	var c stats.Collector
+	files := fs.Args()
+	if len(files) == 0 {
+		if err := consume(stdin, &c); err != nil {
+			fmt.Fprintf(stderr, "loga: stdin: %v\n", err)
+			return 1
+		}
+	} else {
+		for _, name := range files {
+			f, err := os.Open(name)
+			if err != nil {
+				fmt.Fprintf(stderr, "loga: %s: %v\n", name, err)
+				return 1
+			}
+			readErr := consume(f, &c)
+			closeErr := f.Close()
+			if readErr != nil {
+				fmt.Fprintf(stderr, "loga: %s: %v\n", name, readErr)
+				return 1
+			}
+			if closeErr != nil {
+				fmt.Fprintf(stderr, "loga: %s: %v\n", name, closeErr)
+				return 1
+			}
+		}
+	}
+	r := c.Report(*top)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(r); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+		return 0
+	}
+	printText(stdout, r)
+	return 0
+}
+
+func consume(src io.Reader, c *stats.Collector) error {
+	s := bufio.NewScanner(src)
+	s.Buffer(make([]byte, 64*1024), 4*1024*1024)
+	for s.Scan() {
+		e, err := logparse.Parse(s.Text())
+		if err != nil {
+			c.AddMalformed()
+		} else {
+			c.Add(e)
+		}
+	}
+	return s.Err()
+}
+
+func printText(w io.Writer, r stats.Report) {
+	fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", r.Total, r.Malformed)
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(w, "%s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintln(w, "\nStatus classes\nCLASS\tCOUNT")
+	for _, k := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		fmt.Fprintf(w, "%s\t%d\n", k, r.StatusClasses[k])
+	}
+	fmt.Fprintf(w, "\nRequest time (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n", r.P50Millis, r.P95Millis, r.P99Millis)
+	fmt.Fprintln(w, "\n5xx errors per hour\nHOUR\tCOUNT")
+	for _, h := range r.ErrorsPerHour {
+		fmt.Fprintf(w, "%s\t%d\n", h.Hour, h.Count)
+	}
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
