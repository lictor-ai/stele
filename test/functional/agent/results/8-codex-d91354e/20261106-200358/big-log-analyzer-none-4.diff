diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..7df1745
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,102 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() { os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)) }
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	asJSON := fs.Bool("json", false, "print JSON report")
+	if err := fs.Parse(args); err != nil || *top < 0 {
+		if err == nil {
+			fmt.Fprintln(stderr, "-top must not be negative")
+		}
+		return 2
+	}
+	var requests []logparse.Request
+	malformed := 0
+	consume := func(r io.Reader) error {
+		s := bufio.NewScanner(r)
+		s.Buffer(make([]byte, 64*1024), 16*1024*1024)
+		for s.Scan() {
+			req, err := logparse.ParseLine(s.Text())
+			if err != nil {
+				malformed++
+				continue
+			}
+			requests = append(requests, req)
+		}
+		return s.Err()
+	}
+	files := fs.Args()
+	if len(files) == 0 {
+		if err := consume(stdin); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+	} else {
+		for _, name := range files {
+			f, err := os.Open(name)
+			if err != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, err)
+				return 1
+			}
+			err = consume(f)
+			closeErr := f.Close()
+			if err != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, err)
+				return 1
+			}
+			if closeErr != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, closeErr)
+				return 1
+			}
+		}
+	}
+	report := stats.Build(requests, malformed, *top)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(report); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+		return 0
+	}
+	printText(stdout, report)
+	return 0
+}
+
+func printText(w io.Writer, r stats.Report) {
+	fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", r.TotalRequests, r.MalformedLines)
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(w, "%s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintf(w, "\nStatus class\tCOUNT\n")
+	for _, c := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		fmt.Fprintf(w, "%s\t%d\n", c, r.StatusClasses[c])
+	}
+	fmt.Fprintf(w, "\nRequest time (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n\n5xx per hour (UTC)\nHOUR\tCOUNT\n", r.P50MS, r.P95MS, r.P99MS)
+	hours := make([]string, 0, len(r.FiveXXPerHour))
+	for h := range r.FiveXXPerHour {
+		hours = append(hours, h)
+	}
+	sort.Strings(hours)
+	for _, h := range hours {
+		fmt.Fprintf(w, "%s\t%d\n", strings.TrimSpace(h), r.FiveXXPerHour[h])
+	}
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
