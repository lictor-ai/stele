+++ b/internal/todo/todo_test.go
@@ -0,0 +1,69 @@
+package todo
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestStoreCRUDAndList(t *testing.T) {
+	s := NewStore()
+	a := s.Create(" first ")
+	b := s.Create("second")
+	if a.Title != "first" {
+		t.Fatalf("title = %q", a.Title)
+	}
+	if got, err := s.Get(a.ID); err != nil || got.ID != a.ID {
+		t.Fatalf("Get = %#v, %v", got, err)
+	}
+	done := true
+	updated, err := s.Update(a.ID, nil, &done)
+	if err != nil || !updated.Done {
+		t.Fatalf("Update = %#v, %v", updated, err)
+	}
+	all := s.List(nil, 1, 0)
+	if len(all) != 1 || all[0].ID != b.ID {
+		t.Fatalf("newest-first List = %#v", all)
+	}
+	filtered := s.List(&done, 20, 0)
+	if len(filtered) != 1 || filtered[0].ID != a.ID {
+		t.Fatalf("filtered List = %#v", filtered)
+	}
+	if len(s.List(nil, 20, 50)) != 0 {
+		t.Fatal("offset beyond results should be empty")
+	}
+	if err := s.Delete(b.ID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Get(b.ID); err != ErrNotFound {
+		t.Fatalf("Get after Delete error = %v", err)
+	}
+	if err := s.Delete(b.ID); err != ErrNotFound {
+		t.Fatalf("Delete missing error = %v", err)
+	}
+}
+
+func TestConcurrentStoreUse(t *testing.T) {
+	s := NewStore()
+	const workers, each = 12, 40
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for n := 0; n < each; n++ {
+				x := s.Create("work")
+				d := n%2 == 0
+				_, _ = s.Update(x.ID, nil, &d)
+				_, _ = s.Get(x.ID)
+				_ = s.List(nil, 10, 0)
+				if err := s.Delete(x.ID); err != nil {
+					t.Errorf("Delete: %v", err)
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if got := s.List(nil, 100, 0); len(got) != 0 {
+		t.Fatalf("remaining items = %d", len(got))
+	}
+}
