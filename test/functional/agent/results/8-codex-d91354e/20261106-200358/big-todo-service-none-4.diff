+package main
+
+import (
+	"context"
+	"flag"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	addr := flag.String("addr", ":8080", "HTTP listen address")
+	flag.Parse()
+
+	srv := &http.Server{Addr: *addr, Handler: api.New(todo.NewStore())}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	go func() {
+		<-ctx.Done()
+		shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		_ = srv.Shutdown(shutdownCtx)
+	}()
+	if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+		panic(err)
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..7bd5dd4
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,151 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/todo"
+)
+
+// Handler serves the TODO JSON API.
+type Handler struct{ store *todo.Store }
+
+// New creates an API handler backed by store.
+func New(store *todo.Store) http.Handler { return &Handler{store: store} }
+
+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	if r.URL.Path == "/todos" {
+		switch r.Method {
+		case http.MethodPost:
+			h.create(w, r)
+		case http.MethodGet:
+			h.list(w, r)
+		default:
+			w.Header().Set("Allow", "GET, POST")
+			Error(w, http.StatusMethodNotAllowed, "method not allowed")
+		}
+		return
+	}
+	if strings.HasPrefix(r.URL.Path, "/todos/") {
+		id := strings.TrimPrefix(r.URL.Path, "/todos/")
+		if id == "" || strings.Contains(id, "/") {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		switch r.Method {
+		case http.MethodGet:
+			h.get(w, id)
+		case http.MethodPatch:
+			h.update(w, r, id)
+		case http.MethodDelete:
+			h.delete(w, id)
+		default:
+			w.Header().Set("Allow", "GET, PATCH, DELETE")
+			Error(w, http.StatusMethodNotAllowed, "method not allowed")
+		}
+		return
+	}
+	Error(w, http.StatusNotFound, "not found")
+}
+
+func decode(r *http.Request, dst any) error {
+	dec := json.NewDecoder(r.Body)
+	if err := dec.Decode(dst); err != nil {
+		return err
+	}
+	var extra any
+	if err := dec.Decode(&extra); err != io.EOF {
+		return errors.New("body must contain one JSON object")
+	}
+	return nil
+}
+
+func validTitle(title string) bool {
+	n := len([]rune(strings.TrimSpace(title)))
+	return n >= 1 && n <= 200
+}
+
+func (h *Handler) create(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Title *string `json:"title"`
+	}
+	if err := decode(r, &body); err != nil || body.Title == nil || !validTitle(*body.Title) {
+		Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+		return
+	}
+	JSON(w, http.StatusCreated, h.store.Create(*body.Title))
+}
+
+func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	var done *bool
+	if vals, ok := q["done"]; ok {
+		if len(vals) != 1 || (vals[0] != "true" && vals[0] != "false") {
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+		v := vals[0] == "true"
+		done = &v
+	}
+	limit := 20
+	if vals, ok := q["limit"]; ok {
+		v, err := strconv.Atoi(single(vals))
+		if err != nil || v < 1 || v > 100 {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		limit = v
+	}
+	offset := 0
+	if vals, ok := q["offset"]; ok {
+		v, err := strconv.Atoi(single(vals))
+		if err != nil || v < 0 {
+			Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+			return
+		}
+		offset = v
+	}
+	JSON(w, http.StatusOK, h.store.List(done, limit, offset))
+}
+
+func single(v []string) string {
+	if len(v) != 1 {
+		return ""
+	}
+	return v[0]
+}
+func (h *Handler) get(w http.ResponseWriter, id string) {
+	t, err := h.store.Get(id)
+	if err != nil {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+func (h *Handler) update(w http.ResponseWriter, r *http.Request, id string) {
+	var body struct {
+		Title *string `json:"title"`
+		Done  *bool   `json:"done"`
+	}
+	if err := decode(r, &body); err != nil || (body.Title == nil && body.Done == nil) || (body.Title != nil && !validTitle(*body.Title)) {
+		Error(w, http.StatusBadRequest, "provide a valid title and/or done value")
+		return
+	}
+	t, err := h.store.Update(id, body.Title, body.Done)
+	if err != nil {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+func (h *Handler) delete(w http.ResponseWriter, id string) {
+	if err := h.store.Delete(id); err != nil {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..7efeafc
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,98 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/todo"
+)
+
+func request(h http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func TestTodoRoutes(t *testing.T) {
+	h := New(todo.NewStore())
+	created := request(h, http.MethodPost, "/todos", `{"title":"  alpha  "}`)
+	if created.Code != http.StatusCreated {
+		t.Fatalf("POST status = %d: %s", created.Code, created.Body)
+	}
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil {
+		t.Fatal(err)
+	}
+	if item.Title != "alpha" || item.ID == "" {
+		t.Fatalf("created todo = %#v", item)
+	}
+
+	if got := request(h, http.MethodPost, "/todos", `{"title":"   "}`).Code; got != http.StatusBadRequest {
+		t.Fatalf("invalid POST status = %d", got)
+	}
+	if got := request(h, http.MethodPost, "/todos", `{`).Code; got != http.StatusBadRequest {
+		t.Fatalf("malformed POST status = %d", got)
+	}
+	if got := request(h, http.MethodPost, "/todos", `{"title":"`+strings.Repeat("x", 201)+`"}`).Code; got != http.StatusBadRequest {
+		t.Fatalf("long POST status = %d", got)
+	}
+
+	got := request(h, http.MethodGet, "/todos/"+item.ID, "")
+	if got.Code != http.StatusOK {
+		t.Fatalf("GET item status = %d", got.Code)
+	}
+	patch := request(h, http.MethodPatch, "/todos/"+item.ID, `{"done":true,"title":" beta "}`)
+	if patch.Code != http.StatusOK {
+		t.Fatalf("PATCH status = %d: %s", patch.Code, patch.Body)
+	}
+	var changed todo.Todo
+	if err := json.Unmarshal(patch.Body.Bytes(), &changed); err != nil {
+		t.Fatal(err)
+	}
+	if changed.Title != "beta" || !changed.Done {
+		t.Fatalf("patched todo = %#v", changed)
+	}
+	if got := request(h, http.MethodPatch, "/todos/"+item.ID, `{}`).Code; got != http.StatusBadRequest {
+		t.Fatalf("empty PATCH status = %d", got)
+	}
+	if got := request(h, http.MethodPatch, "/todos/"+item.ID, `{"title":"  "}`).Code; got != http.StatusBadRequest {
+		t.Fatalf("invalid PATCH status = %d", got)
+	}
+
+	for _, path := range []string{"/todos", "/todos?done=yes", "/todos?limit=0", "/todos?limit=101", "/todos?limit=abc", "/todos?offset=-1"} {
+		resp := request(h, http.MethodGet, path, "")
+		if path == "/todos" {
+			if resp.Code != http.StatusOK {
+				t.Fatalf("list status = %d", resp.Code)
+			}
+			continue
+		}
+		if resp.Code != http.StatusBadRequest || !strings.Contains(resp.Header().Get("Content-Type"), "application/json") {
+			t.Fatalf("bad list query %q: %d %s", path, resp.Code, resp.Body)
+		}
+	}
+	if got := request(h, http.MethodGet, "/todos?done=true&limit=1&offset=0", "").Code; got != http.StatusOK {
+		t.Fatalf("filtered list status = %d", got)
+	}
+
+	if got := request(h, http.MethodGet, "/todos/missing", ""); got.Code != http.StatusNotFound || !strings.Contains(got.Body.String(), `"error"`) {
+		t.Fatalf("missing GET = %d %s", got.Code, got.Body)
+	}
+	deleted := request(h, http.MethodDelete, "/todos/"+item.ID, "")
+	if deleted.Code != http.StatusNoContent {
+		t.Fatalf("DELETE status = %d", deleted.Code)
+	}
+	if got := request(h, http.MethodDelete, "/todos/"+item.ID, ""); got.Code != http.StatusNotFound || !strings.Contains(got.Body.String(), `"error"`) {
+		t.Fatalf("missing DELETE = %d %s", got.Code, got.Body)
+	}
+	if got := request(h, http.MethodPatch, "/todos/missing", `{"done":false}`); got.Code != http.StatusNotFound {
+		t.Fatalf("missing PATCH status = %d", got.Code)
+	}
+	if got := request(h, http.MethodPut, "/todos", "{}"); got.Code != http.StatusMethodNotAllowed {
+		t.Fatalf("unsupported method status = %d", got.Code)
+	}
+}
diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..02bcab5
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,116 @@
+// Package todo provides a concurrency-safe in-memory TODO store.
+package todo
+
+import (
+	"errors"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// ErrNotFound indicates that a TODO does not exist.
+var ErrNotFound = errors.New("todo not found")
+
+// Todo is a task tracked by the service.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store keeps TODOs in memory and is safe for concurrent use.
+type Store struct {
+	mu    sync.RWMutex
+	items map[string]Todo
+	now   func() time.Time
+	newID func() string
+}
+
+// NewStore constructs a store using the system clock and random IDs.
+func NewStore() *Store {
+	return &Store{items: make(map[string]Todo), now: func() time.Time { return clock.Real{}.Now() }, newID: id.New}
+}
+
+// Create adds a TODO with a trimmed title.
+func (s *Store) Create(title string) Todo {
+	title = strings.TrimSpace(title)
+	now := s.now()
+	t := Todo{ID: s.newID(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[t.ID] = t
+	s.mu.Unlock()
+	return t
+}
+
+// Get returns the TODO with id.
+func (s *Store) Get(id string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the supplied fields. Nil fields are left unchanged.
+func (s *Store) Update(id string, title *string, done *bool) (Todo, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		t.Title = strings.TrimSpace(*title)
+	}
+	if done != nil {
+		t.Done = *done
+	}
+	t.UpdatedAt = s.now()
+	s.items[id] = t
+	return t, nil
+}
+
+// Delete removes a TODO.
+func (s *Store) Delete(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, id)
+	return nil
+}
+
+// List returns matching TODOs newest first. done nil disables filtering.
+func (s *Store) List(done *bool, limit, offset int) []Todo {
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.items))
+	for _, t := range s.items {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}
+	}
+	items = items[offset:]
+	if limit >= 0 && limit < len(items) {
+		items = items[:limit]
+	}
+	return items
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
