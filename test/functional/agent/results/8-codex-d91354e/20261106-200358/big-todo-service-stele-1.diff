+++ b/internal/todo/todo.go
@@ -0,0 +1,18 @@
+package todo
+
+import "time"
+
+// Todo is a task with creation and update timestamps.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Changes contains the fields to change on a todo.
+type Changes struct {
+	Title *string
+	Done  *bool
+}
