+package todo
+
+import "errors"
+
+var (
+	// ErrNotFound indicates that a todo does not exist.
+	ErrNotFound = errors.New("todo not found")
+	// ErrInvalid identifies invalid todo data or pagination.
+	ErrInvalid = errors.New("invalid todo input")
