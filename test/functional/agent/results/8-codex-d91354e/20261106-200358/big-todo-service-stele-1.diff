diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..0bc5f5a
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,118 @@
+package todo
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Store holds todos safely for concurrent use.
+type Store struct {
+	// mu guards items.
+	mu    sync.RWMutex
+	items map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates a store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{items: make(map[string]Todo), clock: c}
+}
+
+// Create validates and stores a todo with title.
+func (s *Store) Create(title string) (Todo, error) {
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, fmt.Errorf("%w: title must contain 1 to 200 characters", ErrInvalid)
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns the todo with id.
+func (s *Store) Get(id string) (Todo, error) {
+	s.mu.RLock()
+	t, ok := s.items[id]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the supplied title and/or done state.
+func (s *Store) Update(id string, changes Changes) (Todo, error) {
+	if changes.Title == nil && changes.Done == nil {
+		return Todo{}, fmt.Errorf("%w: at least one field is required", ErrInvalid)
+	}
+	title := ""
+	if changes.Title != nil {
+		title = strings.TrimSpace(*changes.Title)
+		if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+			return Todo{}, fmt.Errorf("%w: title must contain 1 to 200 characters", ErrInvalid)
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if changes.Title != nil {
+		t.Title = title
+	}
+	if changes.Done != nil {
+		t.Done = *changes.Done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.items[id] = t
+	return t, nil
+}
+
+// Delete removes the todo with id.
+func (s *Store) Delete(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, id)
+	return nil
+}
+
+// List returns todos newest first, optionally filtered by done, with pagination.
+func (s *Store) List(done *bool, limit, offset int) ([]Todo, error) {
+	if limit < 1 || limit > 100 || offset < 0 {
+		return nil, fmt.Errorf("%w: limit must be 1 to 100 and offset non-negative", ErrInvalid)
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.items))
+	for _, t := range s.items {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if len(items) > limit {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..518ab7e
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,111 @@
+package todo
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)})
+	cases := []struct {
+		name  string
+		title string
+		valid bool
+	}{{"trim title", "  write tests  ", true}, {"empty title", "   ", false}, {"too long", string(make([]rune, 201)), false}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := store.Create(tc.title)
+			if tc.valid && err != nil {
+				t.Fatalf("Create(%q) error = %v, want nil", tc.title, err)
+			}
+			if !tc.valid && !errors.Is(err, ErrInvalid) {
+				t.Fatalf("Create(%q) error = %v, want ErrInvalid", tc.title, err)
+			}
+			if tc.valid && got.Title != "write tests" {
+				t.Errorf("Create(%q) title = %q, want %q", tc.title, got.Title, "write tests")
+			}
+		})
+	}
+	todo, err := store.Create("first")
+	if err != nil {
+		t.Fatalf("Create(%q) error = %v, want nil", "first", err)
+	}
+	done := true
+	title := "changed"
+	updated, err := store.Update(todo.ID, Changes{Title: &title, Done: &done})
+	if err != nil || updated.Title != title || !updated.Done {
+		t.Fatalf("Update(%q) = %+v, %v, want changed and done", todo.ID, updated, err)
+	}
+	if _, err := store.Update(todo.ID, Changes{}); !errors.Is(err, ErrInvalid) {
+		t.Errorf("Update(%q, empty) error = %v, want ErrInvalid", todo.ID, err)
+	}
+	listed, err := store.List(&done, 1, 0)
+	if err != nil || len(listed) != 1 || listed[0].ID != todo.ID {
+		t.Fatalf("List(done=true) = %v, %v, want updated todo", listed, err)
+	}
+	if err := store.Delete(todo.ID); err != nil {
+		t.Fatalf("Delete(%q) error = %v, want nil", todo.ID, err)
+	}
+	if _, err := store.Get(todo.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(%q) error = %v, want ErrNotFound", todo.ID, err)
+	}
+}
+
+func TestStorePaginationAndMissing(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Now()})
+	for _, title := range []string{"one", "two", "three"} {
+		if _, err := store.Create(title); err != nil {
+			t.Fatalf("Create(%q) error = %v, want nil", title, err)
+		}
+	}
+	cases := []struct {
+		name   string
+		limit  int
+		offset int
+		want   int
+		bad    bool
+	}{{"first page", 2, 0, 2, false}, {"past end", 2, 9, 0, false}, {"bad limit", 0, 0, 0, true}, {"bad offset", 2, -1, 0, true}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := store.List(nil, tc.limit, tc.offset)
+			if tc.bad && !errors.Is(err, ErrInvalid) {
+				t.Errorf("List(nil, %d, %d) error = %v, want ErrInvalid", tc.limit, tc.offset, err)
+			}
+			if !tc.bad && (err != nil || len(got) != tc.want) {
+				t.Errorf("List(nil, %d, %d) = %d items, %v, want %d", tc.limit, tc.offset, len(got), err, tc.want)
+			}
+		})
+	}
+	if err := store.Delete("missing"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Delete(missing) error = %v, want ErrNotFound", err)
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Now()})
+	const workers = 32
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			item, err := store.Create(fmt.Sprintf("item %d", i))
+			if err != nil {
+				t.Errorf("Create(item %d) error = %v, want nil", i, err)
+				return
+			}
+			if _, err := store.Get(item.ID); err != nil {
+				t.Errorf("Get(%q) error = %v, want nil", item.ID, err)
+			}
+			if _, err := store.List(nil, 100, 0); err != nil {
+				t.Errorf("List(nil, 100, 0) error = %v, want nil", err)
+			}
+		}(i)
+	}
+	wg.Wait()
+}
