@@ -0,0 +1,61 @@
+package main
+
+import (
+	"context"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("server", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	addr := flags.String("addr", ":8080", "listen address")
+	if err := flags.Parse(args); err != nil {
+		return err
+	}
+	store := todo.NewStore(clock.Real{})
+	server := &http.Server{
+		Addr: *addr, Handler: api.NewHandler(store),
+		ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second,
+		WriteTimeout: 15 * time.Second, IdleTimeout: 60 * time.Second,
+	}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	errCh := make(chan error, 1)
+	go func() { errCh <- server.ListenAndServe() }()
+	select {
+	case <-ctx.Done():
+		shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := server.Shutdown(shutdownCtx); err != nil {
+			return fmt.Errorf("shut down server: %w", err)
+		}
+		err := <-errCh
+		if err != nil && err != http.ErrServerClosed {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	case err := <-errCh:
+		if err != nil && err != http.ErrServerClosed {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..6431641
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,155 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// NewHandler returns the HTTP handler for the todo service.
+func NewHandler(store *todo.Store) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", createTodo(store))
+	mux.HandleFunc("GET /todos", listTodos(store))
+	mux.HandleFunc("GET /todos/{id}", getTodo(store))
+	mux.HandleFunc("PATCH /todos/{id}", updateTodo(store))
+	mux.HandleFunc("DELETE /todos/{id}", deleteTodo(store))
+	return mux
+}
+
+func createTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title string `json:"title"`
+		}
+		if !decodeBody(w, r, &body) {
+			return
+		}
+		t, err := store.Create(body.Title)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusCreated, t)
+	}
+}
+
+func listTodos(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		q := r.URL.Query()
+		var done *bool
+		if values, ok := q["done"]; ok {
+			if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			value := values[0] == "true"
+			done = &value
+		}
+		limit, err := queryInt(q, "limit", 20)
+		if err != nil || limit < 1 || limit > 100 {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		offset, err := queryInt(q, "offset", 0)
+		if err != nil || offset < 0 {
+			Error(w, http.StatusBadRequest, "offset must be zero or greater")
+			return
+		}
+		items, err := store.List(done, limit, offset)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, items)
+	}
+}
+
+func getTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		t, err := store.Get(r.PathValue("id"))
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func updateTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title *string `json:"title"`
+			Done  *bool   `json:"done"`
+		}
+		if !decodeBody(w, r, &body) {
+			return
+		}
+		t, err := store.Update(r.PathValue("id"), todo.Changes{Title: body.Title, Done: body.Done})
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func deleteTodo(store *todo.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if err := store.Delete(r.PathValue("id")); err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, dst any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(dst); err != nil {
+		Error(w, http.StatusBadRequest, "request body must be valid JSON")
+		return false
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		Error(w, http.StatusBadRequest, "request body must contain one JSON object")
+		return false
+	}
+	return true
+}
+
+func queryInt(q map[string][]string, key string, fallback int) (int, error) {
+	values, ok := q[key]
+	if !ok {
+		return fallback, nil
+	}
+	if len(values) != 1 || strings.TrimSpace(values[0]) == "" {
+		return 0, strconv.ErrSyntax
+	}
+	value, err := strconv.Atoi(values[0])
+	if err != nil {
+		return 0, err
+	}
+	return value, nil
+}
+
+func writeStoreError(w http.ResponseWriter, err error) {
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if errors.Is(err, todo.ErrInvalid) {
+		Error(w, http.StatusBadRequest, "invalid todo data")
+		return
+	}
+	log.Error("todo request failed", "err", err)
+	Error(w, http.StatusInternalServerError, "request failed; try again")
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..9de4240
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,74 @@
+package api
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	store := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 2, 3, 4, 5, 0, time.UTC)})
+	handler := NewHandler(store)
+	created := request(handler, http.MethodPost, "/todos", `{"title":"  first  "}`)
+	if created.Code != http.StatusCreated {
+		t.Fatalf("POST /todos status = %d, want %d", created.Code, http.StatusCreated)
+	}
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil {
+		t.Fatalf("decode POST /todos response error = %v, want nil", err)
+	}
+	cases := []struct {
+		name   string
+		method string
+		path   string
+		body   string
+		status int
+	}{{"list", http.MethodGet, "/todos", "", http.StatusOK}, {"filter", http.MethodGet, "/todos?done=false&limit=1&offset=0", "", http.StatusOK}, {"get", http.MethodGet, "/todos/" + item.ID, "", http.StatusOK}, {"patch", http.MethodPatch, "/todos/" + item.ID, `{"done":true}`, http.StatusOK}, {"delete", http.MethodDelete, "/todos/" + item.ID, "", http.StatusNoContent}, {"missing get", http.MethodGet, "/todos/missing", "", http.StatusNotFound}, {"missing patch", http.MethodPatch, "/todos/missing", `{"done":true}`, http.StatusNotFound}, {"missing delete", http.MethodDelete, "/todos/missing", "", http.StatusNotFound}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := request(handler, tc.method, tc.path, tc.body)
+			if got.Code != tc.status {
+				t.Errorf("%s %s status = %d, want %d", tc.method, tc.path, got.Code, tc.status)
+			}
+			if tc.status == http.StatusNotFound && !strings.Contains(got.Body.String(), `"error"`) {
+				t.Errorf("%s %s body = %q, want JSON error", tc.method, tc.path, got.Body.String())
+			}
+		})
+	}
+}
+
+func TestTodoRouteErrors(t *testing.T) {
+	handler := NewHandler(todo.NewStore(clock.Fixed{T: time.Now()}))
+	large := `{"title":"` + strings.Repeat("a", 1<<20) + `"}`
+	cases := []struct {
+		name   string
+		method string
+		path   string
+		body   string
+	}{{"bad json", http.MethodPost, "/todos", "{"}, {"unknown field", http.MethodPost, "/todos", `{"title":"x","other":1}`}, {"missing title", http.MethodPost, "/todos", `{}`}, {"blank title", http.MethodPost, "/todos", `{"title":"  "}`}, {"long title", http.MethodPost, "/todos", fmt.Sprintf(`{"title":%q}`, strings.Repeat("x", 201))}, {"oversized", http.MethodPost, "/todos", large}, {"empty patch", http.MethodPatch, "/todos/id", `{}`}, {"bad filter", http.MethodGet, "/todos?done=yes", ""}, {"bad limit", http.MethodGet, "/todos?limit=101", ""}, {"bad integer", http.MethodGet, "/todos?offset=no", ""}, {"negative offset", http.MethodGet, "/todos?offset=-1", ""}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := request(handler, tc.method, tc.path, tc.body)
+			if got.Code != http.StatusBadRequest {
+				t.Errorf("%s %s status = %d, want %d", tc.method, tc.path, got.Code, http.StatusBadRequest)
+			}
+			if !strings.Contains(got.Header().Get("Content-Type"), "application/json") || !strings.Contains(got.Body.String(), `"error"`) {
+				t.Errorf("%s %s response = %q with content type %q, want JSON error", tc.method, tc.path, got.Body.String(), got.Header().Get("Content-Type"))
+			}
+		})
+	}
+}
+
+func request(handler http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	recorder := httptest.NewRecorder()
+	req := httptest.NewRequest(method, path, strings.NewReader(body))
+	handler.ServeHTTP(recorder, req)
+	return recorder
+}
