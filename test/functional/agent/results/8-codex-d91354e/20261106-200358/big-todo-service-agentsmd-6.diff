index 0000000..e146279
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,140 @@
+// Package todo provides concurrent in-memory TODO storage.
+package todo
+
+import (
+	"context"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task tracked by the service.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store keeps TODOs in memory. Its mutex guards items.
+type Store struct {
+	mu    sync.RWMutex
+	items map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates a store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{items: make(map[string]Todo), clock: c}
+}
+
+// Create validates and stores a TODO.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalidTitle
+	}
+	now := s.clock.Now().UTC()
+	item := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[item.ID] = item
+	s.mu.Unlock()
+	return item, nil
+}
+
+// Get returns a TODO by ID.
+func (s *Store) Get(ctx context.Context, itemID string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	item, ok := s.items[itemID]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return item, nil
+}
+
+// Update changes the supplied title and/or done value.
+func (s *Store) Update(ctx context.Context, itemID string, title *string, done *bool) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	if title != nil {
+		trimmed := strings.TrimSpace(*title)
+		if len([]rune(trimmed)) < 1 || len([]rune(trimmed)) > 200 {
+			return Todo{}, ErrInvalidTitle
+		}
+		title = &trimmed
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.items[itemID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if title != nil {
+		item.Title = *title
+	}
+	if done != nil {
+		item.Done = *done
+	}
+	item.UpdatedAt = s.clock.Now().UTC()
+	s.items[itemID] = item
+	return item, nil
+}
+
+// Delete removes a TODO by ID.
+func (s *Store) Delete(ctx context.Context, itemID string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[itemID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, itemID)
+	return nil
+}
+
+// List returns matching TODOs newest first, with offset and limit pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.items))
+	for _, item := range s.items {
+		if done == nil || item.Done == *done {
+			items = append(items, item)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset < 0 {
+		offset = 0
+	}
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if limit >= 0 && limit < len(items) {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..70ba82f
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,105 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	tests := []struct {
+		name string
+		run  func(*testing.T, *Store)
+	}{
+		{name: "create get update delete", run: func(t *testing.T, store *Store) {
+			ctx := context.Background()
+			item, err := store.Create(ctx, "  write tests  ")
+			if err != nil {
+				t.Fatalf("Create() error = %v", err)
+			}
+			if item.Title != "write tests" {
+				t.Errorf("Create().Title = %q, want %q", item.Title, "write tests")
+			}
+			got, err := store.Get(ctx, item.ID)
+			if err != nil || got.ID != item.ID {
+				t.Errorf("Get(%q) = %+v, %v, want created item", item.ID, got, err)
+			}
+			title, done := "ship", true
+			updated, err := store.Update(ctx, item.ID, &title, &done)
+			if err != nil || updated.Title != title || !updated.Done {
+				t.Errorf("Update() = %+v, %v, want title %q and done", updated, err, title)
+			}
+			if err := store.Delete(ctx, item.ID); err != nil {
+				t.Errorf("Delete(%q) error = %v", item.ID, err)
+			}
+			if _, err := store.Get(ctx, item.ID); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Get(deleted ID) error = %v, want ErrNotFound", err)
+			}
+		}},
+		{name: "invalid title", run: func(t *testing.T, store *Store) {
+			for _, title := range []string{"", " \t ", string(make([]rune, 201))} {
+				if _, err := store.Create(context.Background(), title); !errors.Is(err, ErrInvalidTitle) {
+					t.Errorf("Create(%q) error = %v, want ErrInvalidTitle", title, err)
+				}
+			}
+		}},
+		{name: "list filtering and pagination", run: func(t *testing.T, store *Store) {
+			ctx := context.Background()
+			first, _ := store.Create(ctx, "first")
+			second, _ := store.Create(ctx, "second")
+			third, _ := store.Create(ctx, "third")
+			flag := true
+			_, _ = store.Update(ctx, second.ID, nil, &flag)
+			all, err := store.List(ctx, nil, 2, 0)
+			if err != nil || len(all) != 2 {
+				t.Errorf("List(nil, 2, 0) = %+v, %v, want two items", all, err)
+			}
+			filtered, err := store.List(ctx, &flag, 20, 0)
+			if err != nil || len(filtered) != 1 || filtered[0].ID != second.ID {
+				t.Errorf("List(done=true) = %+v, %v, want second", filtered, err)
+			}
+			if all[0].ID < all[1].ID {
+				t.Errorf("List(nil, 2, 0) IDs = %q, %q, want deterministic descending tie order", all[0].ID, all[1].ID)
+			}
+			_, _ = first, third
+		}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) { test.run(t, NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})) })
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	const workers = 64
+	var group sync.WaitGroup
+	group.Add(workers)
+	for i := 0; i < workers; i++ {
+		go func(n int) {
+			defer group.Done()
+			ctx := context.Background()
+			item, err := store.Create(ctx, fmt.Sprintf("task %d", n))
+			if err != nil {
+				t.Errorf("Create() error = %v", err)
+				return
+			}
+			done := n%2 == 0
+			if _, err := store.Update(ctx, item.ID, nil, &done); err != nil {
+				t.Errorf("Update(%q) error = %v", item.ID, err)
+			}
+			if _, err := store.Get(ctx, item.ID); err != nil {
+				t.Errorf("Get(%q) error = %v", item.ID, err)
+			}
+		}(i)
+	}
+	group.Wait()
+	items, err := store.List(context.Background(), nil, 100, 0)
+	if err != nil || len(items) != workers {
+		t.Errorf("List() returned %d items, %v; want %d items", len(items), err, workers)
+	}
+}
