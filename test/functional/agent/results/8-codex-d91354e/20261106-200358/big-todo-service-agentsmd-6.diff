@@ -0,0 +1,58 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("server", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	addr := flags.String("addr", ":8080", "HTTP listen address")
+	if err := flags.Parse(args); err != nil {
+		return err
+	}
+	if flags.NArg() != 0 {
+		return fmt.Errorf("unexpected arguments")
+	}
+
+	server := &http.Server{Addr: *addr, Handler: api.NewDefaultHandler(), ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second, WriteTimeout: 10 * time.Second, IdleTimeout: 60 * time.Second}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	serveErr := make(chan error, 1)
+	go func() { serveErr <- server.ListenAndServe() }()
+	select {
+	case <-ctx.Done():
+		shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := server.Shutdown(shutdownCtx); err != nil {
+			return fmt.Errorf("shutdown server: %w", err)
+		}
+		if err := <-serveErr; !errors.Is(err, http.ErrServerClosed) {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	case err := <-serveErr:
+		if errors.Is(err, http.ErrServerClosed) {
+			return nil
+		}
+		return fmt.Errorf("serve HTTP: %w", err)
+	}
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..4a46575
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,197 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// TodoStore is the storage contract used by the HTTP API.
+type TodoStore interface {
+	Create(context.Context, string) (todo.Todo, error)
+	Get(context.Context, string) (todo.Todo, error)
+	Update(context.Context, string, *string, *bool) (todo.Todo, error)
+	Delete(context.Context, string) error
+	List(context.Context, *bool, int, int) ([]todo.Todo, error)
+}
+
+// NewHandler creates the TODO HTTP API handler.
+func NewHandler(store TodoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", createTodo(store))
+	mux.HandleFunc("GET /todos", listTodos(store))
+	mux.HandleFunc("GET /todos/{id}", getTodo(store))
+	mux.HandleFunc("PATCH /todos/{id}", patchTodo(store))
+	mux.HandleFunc("DELETE /todos/{id}", deleteTodo(store))
+	return mux
+}
+
+func createTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title string `json:"title"`
+		}
+		if err := decodeBody(w, r, &body); err != nil {
+			Error(w, http.StatusBadRequest, "invalid request body")
+			return
+		}
+		if len([]rune(strings.TrimSpace(body.Title))) < 1 || len([]rune(strings.TrimSpace(body.Title))) > 200 {
+			Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+			return
+		}
+		item, err := store.Create(r.Context(), body.Title)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusCreated, item)
+	}
+}
+
+func listTodos(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		query := r.URL.Query()
+		var done *bool
+		if values, ok := query["done"]; ok {
+			if len(values) != 1 {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			value, err := strconv.ParseBool(values[0])
+			if err != nil {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			done = &value
+		}
+		limit := 20
+		if value := query.Get("limit"); value != "" {
+			parsed, err := strconv.Atoi(value)
+			if err != nil || parsed < 1 || parsed > 100 {
+				Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+				return
+			}
+			limit = parsed
+		}
+		offset := 0
+		if value := query.Get("offset"); value != "" {
+			parsed, err := strconv.Atoi(value)
+			if err != nil || parsed < 0 {
+				Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+				return
+			}
+			offset = parsed
+		}
+		items, err := store.List(r.Context(), done, limit, offset)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, items)
+	}
+}
+
+func getTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		item, err := store.Get(r.Context(), r.PathValue("id"))
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, item)
+	}
+}
+
+func patchTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]json.RawMessage
+		if err := decodeBody(w, r, &body); err != nil || body == nil || len(body) == 0 {
+			Error(w, http.StatusBadRequest, "invalid request body")
+			return
+		}
+		for key := range body {
+			if key != "title" && key != "done" {
+				Error(w, http.StatusBadRequest, "unknown field")
+				return
+			}
+		}
+		var title *string
+		if raw, ok := body["title"]; ok {
+			var value string
+			if err := json.Unmarshal(raw, &value); err != nil {
+				Error(w, http.StatusBadRequest, "title must be a string")
+				return
+			}
+			value = strings.TrimSpace(value)
+			if len([]rune(value)) < 1 || len([]rune(value)) > 200 {
+				Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+				return
+			}
+			title = &value
+		}
+		var done *bool
+		if raw, ok := body["done"]; ok {
+			var value bool
+			if err := json.Unmarshal(raw, &value); err != nil {
+				Error(w, http.StatusBadRequest, "done must be a boolean")
+				return
+			}
+			done = &value
+		}
+		item, err := store.Update(r.Context(), r.PathValue("id"), title, done)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, item)
+	}
+}
+
+func deleteTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if err := store.Delete(r.Context(), r.PathValue("id")); err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, dst any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(dst); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		return fmt.Errorf("trailing JSON data")
+	}
+	return nil
+}
+
+func writeStoreError(w http.ResponseWriter, err error) {
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if errors.Is(err, todo.ErrInvalidTitle) {
+		Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+		return
+	}
+	log.Error("todo request failed", "err", err)
+	Error(w, http.StatusInternalServerError, "request could not be completed")
+}
+
+// NewDefaultHandler creates the API with an in-memory store and real clock.
+func NewDefaultHandler() http.Handler { return NewHandler(todo.NewStore(clock.Real{})) }
