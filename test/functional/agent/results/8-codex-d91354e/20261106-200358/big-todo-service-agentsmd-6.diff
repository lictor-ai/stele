+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	tests := []struct {
+		name, method, path, body string
+		want                     int
+	}{
+		{name: "create", method: http.MethodPost, path: "/todos", body: `{"title":"  call home  "}`, want: http.StatusCreated},
+		{name: "create missing title", method: http.MethodPost, path: "/todos", body: `{}`, want: http.StatusBadRequest},
+		{name: "create blank title", method: http.MethodPost, path: "/todos", body: `{"title":"  "}`, want: http.StatusBadRequest},
+		{name: "create long title", method: http.MethodPost, path: "/todos", body: `{"title":"` + strings.Repeat("x", 201) + `"}`, want: http.StatusBadRequest},
+		{name: "create malformed body", method: http.MethodPost, path: "/todos", body: `{`, want: http.StatusBadRequest},
+		{name: "create unknown field", method: http.MethodPost, path: "/todos", body: `{"title":"ok","other":1}`, want: http.StatusBadRequest},
+		{name: "list default", method: http.MethodGet, path: "/todos", want: http.StatusOK},
+		{name: "list done filter", method: http.MethodGet, path: "/todos?done=true&limit=1&offset=0", want: http.StatusOK},
+		{name: "list invalid done", method: http.MethodGet, path: "/todos?done=yes", want: http.StatusBadRequest},
+		{name: "list invalid limit", method: http.MethodGet, path: "/todos?limit=101", want: http.StatusBadRequest},
+		{name: "list invalid offset", method: http.MethodGet, path: "/todos?offset=-1", want: http.StatusBadRequest},
+		{name: "get absent", method: http.MethodGet, path: "/todos/missing", want: http.StatusNotFound},
+		{name: "patch absent", method: http.MethodPatch, path: "/todos/missing", body: `{"done":true}`, want: http.StatusNotFound},
+		{name: "patch empty", method: http.MethodPatch, path: "/todos/missing", body: `{}`, want: http.StatusBadRequest},
+		{name: "patch bad title", method: http.MethodPatch, path: "/todos/missing", body: `{"title":" "}`, want: http.StatusBadRequest},
+		{name: "patch wrong done type", method: http.MethodPatch, path: "/todos/missing", body: `{"done":"yes"}`, want: http.StatusBadRequest},
+		{name: "patch unknown field", method: http.MethodPatch, path: "/todos/missing", body: `{"other":1}`, want: http.StatusBadRequest},
+		{name: "delete absent", method: http.MethodDelete, path: "/todos/missing", want: http.StatusNotFound},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			handler := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(test.method, test.path, strings.NewReader(test.body))
+			handler.ServeHTTP(recorder, request)
+			if recorder.Code != test.want {
+				t.Errorf("%s %s returned %d, want %d; body %s", test.method, test.path, recorder.Code, test.want, recorder.Body.String())
+			}
+			if test.want == http.StatusBadRequest || test.want == http.StatusNotFound {
+				var envelope map[string]string
+				if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil || envelope["error"] == "" {
+					t.Errorf("%s %s body = %q, want JSON error envelope", test.method, test.path, recorder.Body.String())
+				}
+			}
+		})
+	}
+}
+
+func TestTodoRouteLifecycle(t *testing.T) {
+	handler := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+	do := func(method, path, body string) *httptest.ResponseRecorder {
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, httptest.NewRequest(method, path, strings.NewReader(body)))
+		return recorder
+	}
+	created := do(http.MethodPost, "/todos", `{"title":"read"}`)
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil {
+		t.Fatalf("decode create response: %v", err)
+	}
+	got := do(http.MethodGet, "/todos/"+item.ID, "")
+	if got.Code != http.StatusOK {
+		t.Fatalf("GET /todos/{id} returned %d, want %d", got.Code, http.StatusOK)
+	}
+	patched := do(http.MethodPatch, "/todos/"+item.ID, `{"done":true,"title":"read now"}`)
+	if patched.Code != http.StatusOK {
+		t.Fatalf("PATCH /todos/{id} returned %d, want %d", patched.Code, http.StatusOK)
+	}
+	list := do(http.MethodGet, "/todos?done=true", "")
+	if list.Code != http.StatusOK || !strings.Contains(list.Body.String(), `"title":"read now"`) {
+		t.Errorf("GET /todos?done=true returned %d %s, want updated item", list.Code, list.Body.String())
+	}
+	deleted := do(http.MethodDelete, "/todos/"+item.ID, "")
+	if deleted.Code != http.StatusNoContent {
+		t.Errorf("DELETE /todos/{id} returned %d, want %d", deleted.Code, http.StatusNoContent)
+	}
+	if deleted.Body.Len() != 0 {
+		t.Errorf("DELETE response body = %q, want empty", deleted.Body.String())
+	}
+}
