+func NewDiscountBook(codes ...DiscountCode) *DiscountBook {
+	b := &DiscountBook{codes: make(map[string]DiscountCode), used: make(map[string]map[string]bool)}
+	for _, c := range codes {
+		if c.Code != "" && validDiscount(c) {
+			b.codes[c.Code] = c
+		}
+	}
+	return b
+}
+
+func validDiscount(c DiscountCode) bool {
+	return (c.Percent > 0 && c.Percent <= 100 && c.AmountCents == 0) || (c.AmountCents > 0 && c.Percent == 0)
+}
