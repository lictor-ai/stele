+}
+
+// DiscountBook stores codes and atomically tracks their use per customer.
+type DiscountBook struct {
+	mu    sync.Mutex
+	codes map[string]DiscountCode
+	used  map[string]map[string]bool
+}
+
+// NewDiscountBook creates a book containing codes. Invalid/duplicate codes
