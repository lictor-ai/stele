+func TestDiscountExpiryReuseFloorAndRounding(t *testing.T) {
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	expires := now.Add(-time.Second)
+	book := NewDiscountBook(
+		DiscountCode{Code: "expired", AmountCents: 100, ExpiresAt: &expires},
+		DiscountCode{Code: "fixed", AmountCents: 1000},
+		DiscountCode{Code: "half", Percent: 50},
+		DiscountCode{Code: "round", Percent: 50},
+	)
+	lines := []Line{{Quantity: 1, UnitCents: 101}}
+	calc := func(customer, code string) Invoice {
+		return Compute("i", customer, lines, Options{DiscountCode: code, Discounts: book, Now: now})
+	}
+	if got := calc("a", "expired").DiscountCents; got != 0 {
+		t.Fatalf("expired discount=%d", got)
+	}
+	if got := calc("a", "fixed").DiscountCents; got != 101 {
+		t.Fatalf("floor discount=%d, want 101", got)
+	}
+	if got := calc("a", "fixed").DiscountCents; got != 0 {
+		t.Fatalf("reused discount=%d, want 0", got)
+	}
+	if got := calc("b", "fixed").DiscountCents; got != 101 {
+		t.Fatalf("per-customer discount=%d, want 101", got)
+	}
+	if got := calc("c", "round").DiscountCents; got != 51 {
+		t.Fatalf("rounded discount=%d, want 51", got)
+	}
+}
