+
+func (b *DiscountBook) apply(code, customer string, total int64, now time.Time) int64 {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	c, ok := b.codes[code]
+	if !ok || (c.ExpiresAt != nil && now.After(*c.ExpiresAt)) {
+		return 0
+	}
+	if b.used[code] != nil && b.used[code][customer] {
+		return 0
+	}
+	amount := c.AmountCents
+	if c.Percent > 0 {
+		amount = (total*c.Percent + 50) / 100
+	}
+	if amount > total {
+		amount = total
+	}
+	if amount < 0 {
+		amount = 0
+	}
