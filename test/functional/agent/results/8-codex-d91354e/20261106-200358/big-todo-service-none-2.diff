@@ -0,0 +1,34 @@
+package main
+
+import (
+	"context"
+	"flag"
+	"log"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	addr := flag.String("addr", ":8080", "HTTP listen address")
+	flag.Parse()
+	srv := &http.Server{Addr: *addr, Handler: api.NewHandler(todo.NewStore()), ReadHeaderTimeout: 5 * time.Second}
+	done := make(chan os.Signal, 1)
+	signal.Notify(done, os.Interrupt, syscall.SIGTERM)
+	go func() {
+		<-done
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := srv.Shutdown(ctx); err != nil {
+			log.Printf("graceful shutdown: %v", err)
+		}
+	}()
+	if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+		log.Fatal(err)
+	}
+}
diff --git a/internal/api/api.go b/internal/api/api.go
new file mode 100644
index 0000000..d31f755
--- /dev/null
+++ b/internal/api/api.go
@@ -0,0 +1,198 @@
+// Package api implements the todo JSON HTTP API.
+package api
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/todo"
+)
+
+// TodoStore is the storage interface used by the HTTP API.
+type TodoStore interface {
+	Create(string) todo.Todo
+	Get(string) (todo.Todo, bool)
+	Update(string, *string, *bool) (todo.Todo, bool)
+	Delete(string) bool
+	List(*bool, int, int) []todo.Todo
+}
+
+// NewHandler returns an HTTP handler serving the todo routes.
+func NewHandler(store TodoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/todos", func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case http.MethodPost:
+			create(w, r, store)
+		case http.MethodGet:
+			list(w, r, store)
+		default:
+			methodNotAllowed(w)
+		}
+	})
+	mux.HandleFunc("/todos/", func(w http.ResponseWriter, r *http.Request) {
+		id := strings.TrimPrefix(r.URL.Path, "/todos/")
+		if id == "" || strings.Contains(id, "/") {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		switch r.Method {
+		case http.MethodGet:
+			get(w, id, store)
+		case http.MethodPatch:
+			update(w, r, id, store)
+		case http.MethodDelete:
+			remove(w, id, store)
+		default:
+			methodNotAllowed(w)
+		}
+	})
+	return mux
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, dst any) bool {
+	dec := json.NewDecoder(http.MaxBytesReader(w, r.Body, 1<<20))
+	if err := dec.Decode(dst); err != nil {
+		Error(w, http.StatusBadRequest, "invalid JSON body")
+		return false
+	}
+	var extra any
+	if err := dec.Decode(&extra); err != io.EOF {
+		Error(w, http.StatusBadRequest, "invalid JSON body")
+		return false
+	}
+	return true
+}
+func validTitle(s string) (string, bool) {
+	s = strings.TrimSpace(s)
+	return s, len([]rune(s)) >= 1 && len([]rune(s)) <= 200
+}
+func create(w http.ResponseWriter, r *http.Request, s TodoStore) {
+	var body struct {
+		Title *string `json:"title"`
+	}
+	if !decodeBody(w, r, &body) {
+		return
+	}
+	if body.Title == nil {
+		Error(w, 400, "title is required")
+		return
+	}
+	title, ok := validTitle(*body.Title)
+	if !ok {
+		Error(w, 400, "title must be 1 to 200 characters")
+		return
+	}
+	JSON(w, http.StatusCreated, s.Create(title))
+}
+func list(w http.ResponseWriter, r *http.Request, s TodoStore) {
+	q := r.URL.Query()
+	var done *bool
+	if values, ok := q["done"]; ok {
+		if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+			Error(w, 400, "done must be true or false")
+			return
+		}
+		v := values[0] == "true"
+		done = &v
+	}
+	limit := 20
+	if values, ok := q["limit"]; ok {
+		n, err := parseNonnegative(values)
+		if err != nil || n < 1 || n > 100 {
+			Error(w, 400, "limit must be between 1 and 100")
+			return
+		}
+		limit = n
+	}
+	offset := 0
+	if values, ok := q["offset"]; ok {
+		n, err := parseNonnegative(values)
+		if err != nil {
+			Error(w, 400, "offset must be a non-negative integer")
+			return
+		}
+		offset = n
+	}
+	JSON(w, http.StatusOK, s.List(done, limit, offset))
+}
+func parseNonnegative(values []string) (int, error) {
+	if len(values) != 1 {
+		return 0, strconv.ErrSyntax
+	}
+	n, err := strconv.Atoi(values[0])
+	if err != nil || n < 0 {
+		return 0, strconv.ErrSyntax
+	}
+	return n, nil
+}
+func get(w http.ResponseWriter, id string, s TodoStore) {
+	t, ok := s.Get(id)
+	if !ok {
+		Error(w, 404, "todo not found")
+		return
+	}
+	JSON(w, 200, t)
+}
+func update(w http.ResponseWriter, r *http.Request, id string, s TodoStore) {
+	var body map[string]json.RawMessage
+	if !decodeBody(w, r, &body) {
+		return
+	}
+	if len(body) == 0 {
+		Error(w, 400, "at least one of title or done is required")
+		return
+	}
+	var title *string
+	if raw, ok := body["title"]; ok {
+		var v string
+		if err := json.Unmarshal(raw, &v); err != nil {
+			Error(w, 400, "title must be a string")
+			return
+		}
+		v, valid := validTitle(v)
+		if !valid {
+			Error(w, 400, "title must be 1 to 200 characters")
+			return
+		}
+		title = &v
+	}
+	var done *bool
+	if raw, ok := body["done"]; ok {
+		var v bool
+		if err := json.Unmarshal(raw, &v); err != nil {
+			Error(w, 400, "done must be a boolean")
+			return
+		}
+		done = &v
+	}
+	if title == nil && done == nil {
+		Error(w, 400, "at least one of title or done is required")
+		return
+	}
+	for key := range body {
+		if key != "title" && key != "done" {
+			Error(w, 400, "unknown field: "+key)
+			return
+		}
+	}
+	t, ok := s.Update(id, title, done)
+	if !ok {
+		Error(w, 404, "todo not found")
+		return
+	}
+	JSON(w, 200, t)
+}
+func remove(w http.ResponseWriter, id string, s TodoStore) {
+	if !s.Delete(id) {
+		Error(w, 404, "todo not found")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+func methodNotAllowed(w http.ResponseWriter) {
+	Error(w, http.StatusMethodNotAllowed, "method not allowed")
+}
