index 0000000..b6c9b72
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,71 @@
+package todo
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreCRUDAndList(t *testing.T) {
+	now := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	s := NewStoreWithClock(clock.Fixed{T: now})
+	a := s.Create(" alpha ")
+	b := s.Create("beta")
+	if a.Title != "alpha" || a.CreatedAt != now {
+		t.Fatalf("unexpected create: %+v", a)
+	}
+	done := true
+	title := " changed "
+	b, ok := s.Update(b.ID, &title, &done)
+	if !ok || b.Title != "changed" || !b.Done {
+		t.Fatalf("unexpected update: %+v, %v", b, ok)
+	}
+	f := true
+	got := s.List(&f, 10, 0)
+	if len(got) != 1 || got[0].ID != b.ID {
+		t.Fatalf("filtered list = %+v", got)
+	}
+	got = s.List(nil, 1, 1)
+	if len(got) != 1 || got[0].ID != a.ID {
+		t.Fatalf("pagination = %+v", got)
+	}
+	if _, ok := s.Get("missing"); ok {
+		t.Fatal("found missing todo")
+	}
+	if !s.Delete(a.ID) || s.Delete(a.ID) {
+		t.Fatal("delete existence result incorrect")
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore()
+	const workers, each = 12, 40
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			for j := 0; j < each; j++ {
+				item := s.Create(fmt.Sprintf("%d-%d", worker, j))
+				done := j%2 == 0
+				if _, ok := s.Get(item.ID); !ok {
+					t.Errorf("missing created item")
+				}
+				if _, ok := s.Update(item.ID, nil, &done); !ok {
+					t.Errorf("failed update")
+				}
+				if j%3 == 0 {
+					s.Delete(item.ID)
+				}
+				_ = s.List(nil, 10, 0)
+			}
+		}(i)
+	}
+	wg.Wait()
+	if got := len(s.List(nil, workers*each, 0)); got == 0 {
+		t.Fatal("all concurrent items disappeared")
+	}
+}
