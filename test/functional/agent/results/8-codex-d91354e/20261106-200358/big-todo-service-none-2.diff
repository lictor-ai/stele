+++ b/internal/api/api_test.go
@@ -0,0 +1,113 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/todo"
+)
+
+func request(h http.Handler, method, path, body string) *httptest.ResponseRecorder {
+	r := httptest.NewRequest(method, path, strings.NewReader(body))
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+func decodeTodo(t *testing.T, w *httptest.ResponseRecorder) todo.Todo {
+	t.Helper()
+	var v todo.Todo
+	if err := json.Unmarshal(w.Body.Bytes(), &v); err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+
+func TestRoutes(t *testing.T) {
+	s := todo.NewStore()
+	h := NewHandler(s)
+	created := request(h, "POST", "/todos", `{"title":"  first  "}`)
+	if created.Code != 201 {
+		t.Fatalf("POST status %d: %s", created.Code, created.Body)
+	}
+	a := decodeTodo(t, created)
+	if a.Title != "first" || a.ID == "" || a.CreatedAt.IsZero() {
+		t.Fatalf("bad created todo: %+v", a)
+	}
+	if w := request(h, "POST", "/todos", `{"title":""}`); w.Code != 400 {
+		t.Fatalf("blank title: %d", w.Code)
+	}
+	if w := request(h, "POST", "/todos", `not json`); w.Code != 400 {
+		t.Fatalf("malformed body: %d", w.Code)
+	}
+	if w := request(h, "POST", "/todos", `{}`); w.Code != 400 {
+		t.Fatalf("missing title: %d", w.Code)
+	}
+	if w := request(h, "POST", "/todos", `{"title":"`+strings.Repeat("x", 201)+`"}`); w.Code != 400 {
+		t.Fatalf("long title: %d", w.Code)
+	}
+
+	createdB := request(h, "POST", "/todos", `{"title":"second"}`)
+	b := decodeTodo(t, createdB)
+	if w := request(h, "GET", "/todos/"+a.ID, ""); w.Code != 200 || decodeTodo(t, w).ID != a.ID {
+		t.Fatalf("GET item failed: %d", w.Code)
+	}
+	if w := request(h, "GET", "/todos/nope", ""); w.Code != 404 {
+		t.Fatalf("missing GET: %d", w.Code)
+	}
+
+	updated := request(h, "PATCH", "/todos/"+a.ID, `{"done":true,"title":" revised "}`)
+	if updated.Code != 200 {
+		t.Fatalf("PATCH status %d: %s", updated.Code, updated.Body)
+	}
+	a = decodeTodo(t, updated)
+	if !a.Done || a.Title != "revised" {
+		t.Fatalf("bad update: %+v", a)
+	}
+	for _, body := range []string{`{}`, `{"title":" "}`, `{"done":"yes"}`, `{"unknown":1}`, `[]`, `bad`} {
+		if w := request(h, "PATCH", "/todos/"+a.ID, body); w.Code != 400 {
+			t.Errorf("PATCH %s status %d", body, w.Code)
+		}
+	}
+	if w := request(h, "PATCH", "/todos/nope", `{"done":true}`); w.Code != 404 {
+		t.Fatalf("missing PATCH: %d", w.Code)
+	}
+
+	if w := request(h, "GET", "/todos?done=true", ""); w.Code != 200 || !strings.Contains(w.Body.String(), a.ID) || strings.Contains(w.Body.String(), b.ID) {
+		t.Fatalf("done filter: %d %s", w.Code, w.Body)
+	}
+	if w := request(h, "GET", "/todos?limit=1&offset=1", ""); w.Code != 200 {
+		t.Fatalf("pagination: %d", w.Code)
+	}
+	if w := request(h, "GET", "/todos?done=maybe", ""); w.Code != 400 {
+		t.Fatalf("invalid done: %d", w.Code)
+	}
+	for _, q := range []string{"limit=0", "limit=101", "limit=abc", "offset=-1", "offset=x"} {
+		if w := request(h, "GET", "/todos?"+q, ""); w.Code != 400 {
+			t.Errorf("invalid query %s status %d", q, w.Code)
+		}
+	}
+
+	if w := request(h, "DELETE", "/todos/"+a.ID, ""); w.Code != 204 || w.Body.Len() != 0 {
+		t.Fatalf("DELETE status/body %d %q", w.Code, w.Body.String())
+	}
+	if w := request(h, "DELETE", "/todos/"+a.ID, ""); w.Code != 404 {
+		t.Fatalf("missing DELETE: %d", w.Code)
+	}
+	if w := request(h, "PUT", "/todos", `{}`); w.Code != 405 {
+		t.Fatalf("method status: %d", w.Code)
+	}
+}
+
+func TestErrorsAreJSON(t *testing.T) {
+	w := request(NewHandler(todo.NewStore()), "POST", "/todos", `{}`)
+	if w.Header().Get("Content-Type") != "application/json" {
+		t.Fatalf("content type %q", w.Header().Get("Content-Type"))
+	}
+	var body map[string]string
+	if err := json.Unmarshal(w.Body.Bytes(), &body); err != nil || body["error"] == "" {
+		t.Fatalf("error body %q", w.Body.String())
+	}
+}
diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..08dfefd
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,117 @@
+// Package todo provides a concurrent in-memory store for todos.
+package todo
+
+import (
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task tracked by the service.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store is a concurrency-safe in-memory todo store.
+type Store struct {
+	mu    sync.RWMutex
+	items map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore returns an empty store using the system clock.
+func NewStore() *Store { return NewStoreWithClock(clock.Real{}) }
+
+// NewStoreWithClock returns an empty store using c.
+func NewStoreWithClock(c clock.Clock) *Store {
+	if c == nil {
+		c = clock.Real{}
+	}
+	return &Store{items: make(map[string]Todo), clock: c}
+}
+
+// Create stores a new todo with a trimmed title.
+func (s *Store) Create(title string) Todo {
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: strings.TrimSpace(title), CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[t.ID] = t
+	s.mu.Unlock()
+	return t
+}
+
+// Get returns the todo with id, if it exists.
+func (s *Store) Get(id string) (Todo, bool) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[id]
+	return t, ok
+}
+
+// Update changes the provided fields and refreshes UpdatedAt. A nil field is unchanged.
+func (s *Store) Update(id string, title *string, done *bool) (Todo, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, false
+	}
+	if title != nil {
+		t.Title = strings.TrimSpace(*title)
+	}
+	if done != nil {
+		t.Done = *done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.items[id] = t
+	return t, true
+}
+
+// Delete removes id and reports whether it existed.
+func (s *Store) Delete(id string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[id]; !ok {
+		return false
+	}
+	delete(s.items, id)
+	return true
+}
+
+// List returns matching todos newest first, applying limit and offset.
+// A nil done filter includes both completed and incomplete todos.
+func (s *Store) List(done *bool, limit, offset int) []Todo {
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.items))
+	for _, t := range s.items {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset < 0 {
+		offset = 0
+	}
+	if offset >= len(items) {
+		return []Todo{}
+	}
+	items = items[offset:]
+	if limit >= 0 && limit < len(items) {
+		items = items[:limit]
+	}
+	return items
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
