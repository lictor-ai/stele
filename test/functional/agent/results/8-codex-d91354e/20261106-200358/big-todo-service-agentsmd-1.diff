index 0000000..0af4416
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,162 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/todo"
+)
+
+type todoStore interface {
+	Create(string) (todo.Todo, error)
+	Get(string) (todo.Todo, error)
+	Update(string, todo.Update) (todo.Todo, error)
+	Delete(string) error
+	List(*bool, int, int) []todo.Todo
+}
+
+// NewHandler creates the TODO HTTP API.
+func NewHandler(store todoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", createTodo(store))
+	mux.HandleFunc("GET /todos", listTodos(store))
+	mux.HandleFunc("GET /todos/{id}", getTodo(store))
+	mux.HandleFunc("PATCH /todos/{id}", updateTodo(store))
+	mux.HandleFunc("DELETE /todos/{id}", deleteTodo(store))
+	return mux
+}
+
+func createTodo(store todoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title string `json:"title"`
+		}
+		if err := decodeBody(w, r, &body); err != nil || strings.TrimSpace(body.Title) == "" || len([]rune(strings.TrimSpace(body.Title))) > 200 {
+			Error(w, http.StatusBadRequest, "title must be between 1 and 200 characters")
+			return
+		}
+		t, err := store.Create(body.Title)
+		if err != nil {
+			Error(w, http.StatusBadRequest, "invalid todo")
+			return
+		}
+		JSON(w, http.StatusCreated, t)
+	}
+}
+
+func listTodos(store todoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var done *bool
+		if v := r.URL.Query().Get("done"); v != "" {
+			if v != "true" && v != "false" {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			parsed, err := strconv.ParseBool(v)
+			if err != nil {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			done = &parsed
+		}
+		limit := 20
+		if v := r.URL.Query().Get("limit"); v != "" {
+			n, err := strconv.Atoi(v)
+			if err != nil || n < 1 || n > 100 {
+				Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+				return
+			}
+			limit = n
+		}
+		offset := 0
+		if v := r.URL.Query().Get("offset"); v != "" {
+			n, err := strconv.Atoi(v)
+			if err != nil || n < 0 {
+				Error(w, http.StatusBadRequest, "offset must be a non-negative integer")
+				return
+			}
+			offset = n
+		}
+		JSON(w, http.StatusOK, store.List(done, limit, offset))
+	}
+}
+
+func getTodo(store todoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		t, err := store.Get(r.PathValue("id"))
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func updateTodo(store todoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]json.RawMessage
+		if err := decodeBody(w, r, &body); err != nil {
+			Error(w, http.StatusBadRequest, "invalid JSON body")
+			return
+		}
+		var update todo.Update
+		for key, raw := range body {
+			switch key {
+			case "title":
+				var value string
+				if err := json.Unmarshal(raw, &value); err != nil {
+					Error(w, http.StatusBadRequest, "title must be a string")
+					return
+				}
+				update.Title = &value
+			case "done":
+				var value bool
+				if err := json.Unmarshal(raw, &value); err != nil {
+					Error(w, http.StatusBadRequest, "done must be a boolean")
+					return
+				}
+				update.Done = &value
+			default:
+				Error(w, http.StatusBadRequest, "unknown field")
+				return
+			}
+		}
+		t, err := store.Update(r.PathValue("id"), update)
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		if err != nil {
+			Error(w, http.StatusBadRequest, "provide a valid title and/or done value")
+			return
+		}
+		JSON(w, http.StatusOK, t)
+	}
+}
+
+func deleteTodo(store todoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if err := store.Delete(r.PathValue("id")); errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, v any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if err := d.Decode(v); err != nil {
+		return err
+	}
+	if err := d.Decode(&struct{}{}); err != io.EOF {
+		return errors.New("request body must contain one JSON value")
+	}
+	return nil
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..84822fb
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,83 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	store := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	handler := NewHandler(store)
+	cases := []struct {
+		name, method, path, body string
+		status                   int
+	}{
+		{"create", http.MethodPost, "/todos", `{"title":" task "}`, http.StatusCreated},
+		{"create missing title", http.MethodPost, "/todos", `{}`, http.StatusBadRequest},
+		{"create unknown field", http.MethodPost, "/todos", `{"title":"x","extra":1}`, http.StatusBadRequest},
+		{"list", http.MethodGet, "/todos", "", http.StatusOK},
+		{"list done filter", http.MethodGet, "/todos?done=maybe", "", http.StatusBadRequest},
+		{"list invalid limit", http.MethodGet, "/todos?limit=101", "", http.StatusBadRequest},
+		{"list invalid offset", http.MethodGet, "/todos?offset=-1", "", http.StatusBadRequest},
+		{"get missing", http.MethodGet, "/todos/missing", "", http.StatusNotFound},
+		{"patch missing", http.MethodPatch, "/todos/missing", `{"done":true}`, http.StatusNotFound},
+		{"patch empty", http.MethodPatch, "/todos/missing", `{}`, http.StatusBadRequest},
+		{"delete missing", http.MethodDelete, "/todos/missing", "", http.StatusNotFound},
+	}
+	createdID := ""
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			path := tc.path
+			if tc.name == "get missing" || tc.name == "patch missing" || tc.name == "delete missing" {
+				path = strings.Replace(path, "missing", "absent", 1)
+			}
+			req := httptest.NewRequest(tc.method, path, strings.NewReader(tc.body))
+			rec := httptest.NewRecorder()
+			handler.ServeHTTP(rec, req)
+			if rec.Code != tc.status {
+				t.Fatalf("%s %s status = %d, want %d; body %s", tc.method, path, rec.Code, tc.status, rec.Body.String())
+			}
+			if tc.status == http.StatusBadRequest || tc.status == http.StatusNotFound {
+				var envelope map[string]string
+				if err := json.Unmarshal(rec.Body.Bytes(), &envelope); err != nil || envelope["error"] == "" {
+					t.Errorf("error response body = %q, want JSON error envelope", rec.Body.String())
+				}
+			}
+			if tc.name == "create" {
+				var got todo.Todo
+				if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
+					t.Fatalf("decode create response: %v", err)
+				}
+				createdID = got.ID
+			}
+		})
+	}
+	for _, tc := range []struct {
+		name, method, path, body string
+		status                   int
+	}{
+		{"get", http.MethodGet, "/todos/" + createdID, "", http.StatusOK},
+		{"patch", http.MethodPatch, "/todos/" + createdID, `{"title":"updated","done":true}`, http.StatusOK},
+		{"patch invalid title", http.MethodPatch, "/todos/" + createdID, `{"title":" "}`, http.StatusBadRequest},
+		{"patch unknown field", http.MethodPatch, "/todos/" + createdID, `{"other":1}`, http.StatusBadRequest},
+		{"list pagination", http.MethodGet, "/todos?done=true&limit=1&offset=0", "", http.StatusOK},
+		{"delete", http.MethodDelete, "/todos/" + createdID, "", http.StatusNoContent},
+		{"get deleted", http.MethodGet, "/todos/" + createdID, "", http.StatusNotFound},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			req := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+			rec := httptest.NewRecorder()
+			handler.ServeHTTP(rec, req)
+			if rec.Code != tc.status {
+				t.Errorf("%s %s status = %d, want %d; body %s", tc.method, tc.path, rec.Code, tc.status, rec.Body.String())
+			}
+		})
+	}
+}
