diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..a884839
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,133 @@
+// Package todo provides concurrent in-memory TODO storage.
+package todo
+
+import (
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a stored task.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Update contains optional fields to change on a TODO.
+type Update struct {
+	Title *string
+	Done  *bool
+}
+
+// Store holds TODOs in memory. mu guards todos.
+type Store struct {
+	mu    sync.RWMutex
+	todos map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates an empty store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{todos: make(map[string]Todo), clock: c}
+}
+
+// Create adds a TODO with a validated, trimmed title.
+func (s *Store) Create(title string) (Todo, error) {
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.todos[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns a TODO by ID.
+func (s *Store) Get(id string) (Todo, error) {
+	s.mu.RLock()
+	t, ok := s.todos[id]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the provided title and/or done fields.
+func (s *Store) Update(id string, update Update) (Todo, error) {
+	if update.Title == nil && update.Done == nil {
+		return Todo{}, ErrInvalid
+	}
+	var title string
+	if update.Title != nil {
+		title = strings.TrimSpace(*update.Title)
+		if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.todos[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if update.Title != nil {
+		t.Title = title
+	}
+	if update.Done != nil {
+		t.Done = *update.Done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.todos[id] = t
+	return t, nil
+}
+
+// Delete removes a TODO by ID.
+func (s *Store) Delete(id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.todos[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.todos, id)
+	return nil
+}
+
+// List returns TODOs newest first with optional filtering and pagination.
+func (s *Store) List(done *bool, limit, offset int) []Todo {
+	if offset < 0 {
+		offset = 0
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.todos))
+	for _, t := range s.todos {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}
+	}
+	items = items[offset:]
+	if limit >= 0 && limit < len(items) {
+		items = items[:limit]
+	}
+	return items
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..8a16d95
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,106 @@
+package todo
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name  string
+		title string
+		valid bool
+	}{{"trim title", "  task  ", true}, {"empty", "  ", false}, {"too long", string(make([]rune, 201)), false}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			got, err := s.Create(tc.title)
+			if tc.valid && err != nil {
+				t.Fatalf("Create(%q) error = %v, want nil", tc.title, err)
+			}
+			if !tc.valid && !errors.Is(err, ErrInvalid) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.title, err, ErrInvalid)
+			}
+			if tc.valid {
+				if got.Title != "task" {
+					t.Errorf("Create(%q).Title = %q, want %q", tc.title, got.Title, "task")
+				}
+				found, err := s.Get(got.ID)
+				if err != nil || found.ID != got.ID {
+					t.Errorf("Get(%q) = (%v, %v), want created todo", got.ID, found, err)
+				}
+				done := true
+				found, err = s.Update(got.ID, Update{Done: &done})
+				if err != nil || !found.Done {
+					t.Errorf("Update(%q) = (%v, %v), want done", got.ID, found, err)
+				}
+				if err := s.Delete(got.ID); err != nil {
+					t.Errorf("Delete(%q) error = %v, want nil", got.ID, err)
+				}
+				if _, err := s.Get(got.ID); !errors.Is(err, ErrNotFound) {
+					t.Errorf("Get(deleted %q) error = %v, want %v", got.ID, err, ErrNotFound)
+				}
+			}
+		})
+	}
+}
+
+func TestStoreList(t *testing.T) {
+	s := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	first, _ := s.Create("first")
+	done := true
+	second, _ := s.Create("second")
+	_, _ = s.Update(second.ID, Update{Done: &done})
+	cases := []struct {
+		name                string
+		filter              *bool
+		limit, offset, want int
+	}{
+		{"all", nil, 20, 0, 2}, {"done", &done, 20, 0, 1}, {"offset", nil, 1, 1, 1}, {"past end", nil, 2, 9, 0},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := s.List(tc.filter, tc.limit, tc.offset)
+			if len(got) != tc.want {
+				t.Fatalf("List(%v, %d, %d) length = %d, want %d", tc.filter, tc.limit, tc.offset, len(got), tc.want)
+			}
+			if tc.name == "all" && got[0].ID != second.ID {
+				t.Errorf("List newest ID = %q, want %q", got[0].ID, second.ID)
+			}
+			if tc.name == "offset" && got[0].ID != first.ID {
+				t.Errorf("List offset ID = %q, want %q", got[0].ID, first.ID)
+			}
+		})
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore(clock.Real{})
+	var wg sync.WaitGroup
+	for i := 0; i < 100; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			task, err := s.Create("task")
+			if err != nil {
+				t.Errorf("Create(%d) error = %v, want nil", i, err)
+				return
+			}
+			if _, err := s.Get(task.ID); err != nil {
+				t.Errorf("Get(%q) error = %v, want nil", task.ID, err)
+			}
+			s.List(nil, 20, 0)
+			if err := s.Delete(task.ID); err != nil {
+				t.Errorf("Delete(%q) error = %v, want nil", task.ID, err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	if got := len(s.List(nil, 100, 0)); got != 0 {
+		t.Errorf("List after concurrent deletes length = %d, want 0", got)
+	}
+}
