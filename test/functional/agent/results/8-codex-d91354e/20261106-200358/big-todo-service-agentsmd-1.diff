+package todo
+
+import "errors"
+
+var (
+	// ErrNotFound means the requested TODO does not exist.
+	ErrNotFound = errors.New("todo not found")
+	// ErrInvalid means a TODO title or update is invalid.
+	ErrInvalid = errors.New("invalid todo")
