+++ b/internal/billing/pricing_test.go
@@ -0,0 +1,48 @@
+package billing
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestPriceDiscountCases(t *testing.T) {
+	now := time.Date(2026, 1, 2, 0, 0, 0, 0, time.UTC)
+	expired := now.Add(-time.Second)
+	cases := []struct {
+		name string
+		total int64
+		code *DiscountCode
+		wantDiscount int64
+		wantErr error
+	}{
+		{name: "expired", total: 1000, code: &DiscountCode{AmountCents: 100, ExpiresAt: &expired}, wantErr: ErrDiscountExpired},
+		{name: "reuse", total: 1000, code: &DiscountCode{AmountCents: 100, UsedBy: map[string]bool{"acme": true}}, wantErr: ErrDiscountUsed},
+		{name: "floor at zero", total: 50, code: &DiscountCode{AmountCents: 100}, wantDiscount: 50},
+		{name: "percent rounds half up", total: 150, code: &DiscountCode{PercentBPS: 1000}, wantDiscount: 15},
+		{name: "fraction rounds up", total: 1, code: &DiscountCode{PercentBPS: 5000}, wantDiscount: 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inv := Invoice{Customer: "acme", Region: "FR", TotalCents: tc.total}
+			err := Price(&inv, tc.code, now, map[string]int64{"FR": 0})
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Price() error = %v, want %v", err, tc.wantErr)
+			}
+			if err == nil && inv.DiscountCents != tc.wantDiscount {
+				t.Errorf("Price() discount = %d, want %d", inv.DiscountCents, tc.wantDiscount)
+			}
+		})
+	}
+}
+
+func TestPriceTaxAfterDiscount(t *testing.T) {
+	inv := Invoice{Customer: "acme", Region: "DE", TotalCents: 1000}
+	code := &DiscountCode{AmountCents: 100}
+	if err := Price(&inv, code, time.Time{}, map[string]int64{"DE": 1900}); err != nil {
+		t.Fatalf("Price() error = %v, want nil", err)
+	}
+	if inv.DiscountCents != 100 || inv.TaxCents != 171 || inv.GrandTotalCents != 1071 {
+		t.Errorf("Price() totals = discount %d, tax %d, grand total %d; want 100, 171, 1071", inv.DiscountCents, inv.TaxCents, inv.GrandTotalCents)
+	}
+}
