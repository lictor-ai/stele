@@ -0,0 +1,21 @@
+package billing
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWriteCSV(t *testing.T) {
+	issued := time.Date(2026, 3, 4, 5, 6, 7, 0, time.UTC)
+	inv := Invoice{ID: "i1", Customer: "acme", Region: "US-CA", IssuedAt: issued, TotalCents: 1200, DiscountCents: 200, TaxCents: 100, GrandTotalCents: 1100}
+	var out strings.Builder
+	if err := WriteCSV(context.Background(), &out, []Invoice{inv}); err != nil {
+		t.Fatalf("WriteCSV() error = %v, want nil", err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\ni1,acme,US-CA,2026-03-04T05:06:07Z,1200,200,100,1100\n"
+	if out.String() != want {
+		t.Errorf("WriteCSV() = %q, want %q", out.String(), want)
+	}
+}
diff --git a/internal/billing/pricing.go b/internal/billing/pricing.go
