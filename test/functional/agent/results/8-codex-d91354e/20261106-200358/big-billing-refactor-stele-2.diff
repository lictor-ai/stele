index 0000000..211bad3
--- /dev/null
+++ b/internal/billing/pricing.go
@@ -0,0 +1,69 @@
+package billing
+
+import (
+	"fmt"
+	"time"
+)
+
+// DiscountCode describes a percentage or fixed amount discount.
+type DiscountCode struct {
+	PercentBPS  int64
+	AmountCents int64
+	ExpiresAt   *time.Time
+	UsedBy      map[string]bool
+}
+
+// Price applies one optional discount and region tax to an invoice.
+func Price(inv *Invoice, code *DiscountCode, now time.Time, taxRates map[string]int64) error {
+	if inv == nil {
+		return fmt.Errorf("price invoice: %w", ErrInvalidDiscount)
+	}
+	rate, ok := taxRates[inv.Region]
+	if !ok || rate < 0 {
+		return fmt.Errorf("tax region %q: %w", inv.Region, ErrUnknownRegion)
+	}
+	discount := int64(0)
+	if code != nil {
+		if (code.PercentBPS > 0) == (code.AmountCents > 0) || code.PercentBPS < 0 || code.AmountCents < 0 || code.PercentBPS > 10000 {
+			return fmt.Errorf("discount code: %w", ErrInvalidDiscount)
+		}
+		if code.ExpiresAt != nil && now.After(*code.ExpiresAt) {
+			return fmt.Errorf("discount code: %w", ErrDiscountExpired)
+		}
+		if code.UsedBy != nil && code.UsedBy[inv.Customer] {
+			return fmt.Errorf("customer %q: %w", inv.Customer, ErrDiscountUsed)
+		}
+		if code.PercentBPS > 0 {
+			discount = roundBasisPoints(inv.TotalCents, code.PercentBPS)
+		} else {
+			discount = code.AmountCents
+		}
+		if discount > inv.TotalCents {
+			discount = inv.TotalCents
+		}
+	}
+	if discount < 0 {
+		discount = 0
+	}
+	postDiscount := inv.TotalCents - discount
+	tax := roundBasisPoints(postDiscount, rate)
+	inv.DiscountCents = discount
+	inv.TaxCents = tax
+	inv.GrandTotalCents = postDiscount + tax
+	if code != nil {
+		if code.UsedBy == nil {
+			code.UsedBy = make(map[string]bool)
+		}
+		code.UsedBy[inv.Customer] = true
+	}
+	return nil
+}
+
+func roundBasisPoints(amount, bps int64) int64 {
+	product := amount * bps
+	if product >= 0 {
+		return (product + 5000) / 10000
+	}
+	return (product - 5000) / 10000
+}
+
