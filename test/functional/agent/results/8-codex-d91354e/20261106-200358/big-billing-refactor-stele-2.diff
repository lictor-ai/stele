diff --git a/internal/billing/export.go b/internal/billing/export.go
new file mode 100644
index 0000000..0b81f17
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,38 @@
+package billing
+
+import (
+	"context"
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+)
+
+// WriteCSV writes invoices as CSV, with all monetary values in cents.
+func WriteCSV(ctx context.Context, w io.Writer, invoices []Invoice) error {
+	if w == nil {
+		return fmt.Errorf("write invoice CSV: nil writer")
+	}
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return fmt.Errorf("write invoice CSV header: %w", err)
+	}
+	for _, inv := range invoices {
+		if err := ctx.Err(); err != nil {
+			return fmt.Errorf("write invoice CSV: %w", err)
+		}
+		record := []string{
+			inv.ID, inv.Customer, inv.Region, inv.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(inv.TotalCents, 10), strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10), strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := writer.Write(record); err != nil {
+			return fmt.Errorf("write invoice %q to CSV: %w", inv.ID, err)
+		}
+	}
+	writer.Flush()
+	if err := writer.Error(); err != nil {
+		return fmt.Errorf("flush invoice CSV: %w", err)
+	}
+	return nil
+}
