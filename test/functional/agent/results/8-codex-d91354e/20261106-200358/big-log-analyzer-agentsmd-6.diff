index 0000000..5f7db2b
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,50 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	line := `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042` + "\n"
+	cases := []struct {
+		name    string
+		args    []string
+		input   string
+		want    string
+		wantErr bool
+	}{
+		{name: "stdin text", input: line + "bad\n", want: "Total requests: 1"},
+		{name: "stdin json", args: []string{"-json"}, input: line, want: `"total_requests": 1`},
+		{name: "bad flag", args: []string{"-top=-1"}, wantErr: true},
+		{name: "unreadable file", args: []string{filepath.Join(t.TempDir(), "missing.log")}, wantErr: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			old := os.Stdin
+			if tc.input != "" {
+				file := filepath.Join(t.TempDir(), "input.log")
+				if err := os.WriteFile(file, []byte(tc.input), 0600); err != nil {
+					t.Fatal(err)
+				}
+				f, err := os.Open(file)
+				if err != nil {
+					t.Fatal(err)
+				}
+				os.Stdin = f
+				t.Cleanup(func() { os.Stdin = old; _ = f.Close() })
+			}
+			var out, stderr bytes.Buffer
+			err := run(tc.args, &out, &stderr)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("run(%v) error = %v, wantErr %v", tc.args, err, tc.wantErr)
+			}
+			if tc.want != "" && !strings.Contains(out.String(), tc.want) {
+				t.Errorf("run output = %q, want containing %q", out.String(), tc.want)
+			}
+		})
+	}
+}
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
