index 0000000..76585d5
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,81 @@
+// Package logparse parses nginx combined access log records with a trailing request time.
+package logparse
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Entry is one parsed access log record.
+type Entry struct {
+	Path        string
+	Status      int
+	RequestTime float64
+	Time        time.Time
+}
+
+// Parse parses one combined access log line with a trailing duration in seconds.
+func Parse(line string) (Entry, error) {
+	var entry Entry
+	fields, err := splitFields(line)
+	if err != nil || len(fields) != 10 {
+		return entry, fmt.Errorf("invalid combined access log line")
+	}
+	stamp := strings.Trim(fields[3], "[]")
+	entry.Time, err = time.Parse("02/Jan/2006:15:04:05 -0700", stamp)
+	if err != nil {
+		return Entry{}, fmt.Errorf("invalid timestamp")
+	}
+	request := strings.Fields(strings.Trim(fields[4], `"`))
+	if len(request) != 3 {
+		return Entry{}, fmt.Errorf("invalid request")
+	}
+	entry.Path = strings.SplitN(request[1], "?", 2)[0]
+	entry.Status, err = strconv.Atoi(fields[5])
+	if err != nil || entry.Status < 100 || entry.Status > 599 {
+		return Entry{}, fmt.Errorf("invalid status")
+	}
+	entry.RequestTime, err = strconv.ParseFloat(fields[9], 64)
+	if err != nil || entry.RequestTime < 0 || math.IsNaN(entry.RequestTime) || math.IsInf(entry.RequestTime, 0) {
+		return Entry{}, fmt.Errorf("invalid request time")
+	}
+	return entry, nil
+}
+
+func splitFields(line string) ([]string, error) {
+	var fields []string
+	for i := 0; i < len(line); {
+		for i < len(line) && line[i] == ' ' {
+			i++
+		}
+		if i == len(line) {
+			break
+		}
+		if line[i] == '"' || line[i] == '[' {
+			end := byte('"')
+			if line[i] == '[' {
+				end = ']'
+			}
+			start := i
+			i++
+			for i < len(line) && line[i] != end {
+				i++
+			}
+			if i == len(line) {
+				return nil, fmt.Errorf("unterminated field")
+			}
+			i++
+			fields = append(fields, line[start:i])
+		} else {
+			start := i
+			for i < len(line) && line[i] != ' ' {
+				i++
+			}
+			fields = append(fields, line[start:i])
+		}
+	}
+	return fields, nil
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
