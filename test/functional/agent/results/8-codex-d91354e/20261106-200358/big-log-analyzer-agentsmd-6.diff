--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,31 @@
+package logparse
+
+import "testing"
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, line string
+		wantPath   string
+		wantStatus int
+		wantBad    bool
+	}{
+		{name: "valid query removed", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, wantPath: "/api/items", wantStatus: 200},
+		{name: "empty", line: "", wantBad: true},
+		{name: "bad timestamp", line: `203.0.113.9 - - [bad] "GET / HTTP/1.1" 200 12 "-" "agent" 0.1`, wantBad: true},
+		{name: "bad status", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" nope 12 "-" "agent" 0.1`, wantBad: true},
+		{name: "bad duration", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 12 "-" "agent" nope`, wantBad: true},
+		{name: "non-finite duration", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 12 "-" "agent" NaN`, wantBad: true},
+		{name: "malformed request", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "bad" 200 12 "-" "agent" 0.1`, wantBad: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if (err != nil) != tc.wantBad {
+				t.Fatalf("Parse(%q) error = %v, wantBad %v", tc.line, err, tc.wantBad)
+			}
+			if err == nil && (got.Path != tc.wantPath || got.Status != tc.wantStatus) {
+				t.Errorf("Parse(%q) = path %q status %d, want path %q status %d", tc.line, got.Path, got.Status, tc.wantPath, tc.wantStatus)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..23e38d7
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,77 @@
+// Package stats aggregates parsed access log records into a report.
+package stats
+
+import (
+	"math"
+	"sort"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount records the request count for a path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains aggregate access log statistics.
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50MS         float64        `json:"p50_ms"`
+	P95MS         float64        `json:"p95_ms"`
+	P99MS         float64        `json:"p99_ms"`
+	ErrorsPerHour map[string]int `json:"errors_per_hour"`
+}
+
+// Calculate builds a report from records, malformed line count, and top path limit.
+func Calculate(entries []logparse.Entry, malformed, top int) Report {
+	counts := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	times := make([]float64, 0, len(entries))
+	for _, e := range entries {
+		counts[e.Path]++
+		class := e.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			classes[key]++
+		}
+		if class == 5 {
+			hours[e.Time.Format("2006-01-02T15:00:00-07:00")]++
+		}
+		times = append(times, e.RequestTime*1000)
+	}
+	paths := make([]PathCount, 0, len(counts))
+	for path, count := range counts {
+		paths = append(paths, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(paths, func(i, j int) bool {
+		if paths[i].Count != paths[j].Count {
+			return paths[i].Count > paths[j].Count
+		}
+		return paths[i].Path < paths[j].Path
+	})
+	if top < 0 {
+		top = 0
+	}
+	if top < len(paths) {
+		paths = paths[:top]
+	}
+	sort.Float64s(times)
+	return Report{Total: len(entries), Malformed: malformed, TopPaths: paths, StatusClasses: classes,
+		P50MS: percentile(times, .50), P95MS: percentile(times, .95), P99MS: percentile(times, .99), ErrorsPerHour: hours}
+}
+
+func percentile(values []float64, p float64) float64 {
+	if len(values) == 0 {
+		return 0
+	}
+	index := int(math.Ceil(p*float64(len(values)))) - 1
+	if index < 0 {
+		index = 0
+	}
+	return values[index]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..5fea1b9
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,42 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestCalculate(t *testing.T) {
+	base, _ := time.Parse(time.RFC3339, "2026-10-10T13:00:00Z")
+	cases := []struct {
+		name                      string
+		entries                   []logparse.Entry
+		malformed, top            int
+		wantTotal                 int
+		wantP50, wantP95, wantP99 float64
+		wantPaths                 int
+		want5xx                   int
+	}{
+		{name: "empty", malformed: 2, top: 10, wantTotal: 0},
+		{name: "single", entries: []logparse.Entry{{Path: "/a", Status: 200, RequestTime: .042, Time: base}}, top: 10, wantTotal: 1, wantP50: 42, wantP95: 42, wantP99: 42, wantPaths: 1},
+		{name: "percentile edges and top", entries: []logparse.Entry{{Path: "/b", Status: 500, RequestTime: .01, Time: base}, {Path: "/a", Status: 404, RequestTime: .02, Time: base}, {Path: "/a", Status: 503, RequestTime: .03, Time: base}, {Path: "/c", Status: 302, RequestTime: .04, Time: base}}, malformed: 1, top: 2, wantTotal: 4, wantP50: 20, wantP95: 40, wantP99: 40, wantPaths: 2, want5xx: 2},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Calculate(tc.entries, tc.malformed, tc.top)
+			if got.Total != tc.wantTotal {
+				t.Errorf("Calculate total = %d, want %d", got.Total, tc.wantTotal)
+			}
+			if got.P50MS != tc.wantP50 || got.P95MS != tc.wantP95 || got.P99MS != tc.wantP99 {
+				t.Errorf("Calculate percentiles = %.3f/%.3f/%.3f, want %.3f/%.3f/%.3f", got.P50MS, got.P95MS, got.P99MS, tc.wantP50, tc.wantP95, tc.wantP99)
+			}
+			if len(got.TopPaths) != tc.wantPaths {
+				t.Errorf("Calculate top paths = %d, want %d", len(got.TopPaths), tc.wantPaths)
+			}
+			if got.StatusClasses["5xx"] != tc.want5xx {
+				t.Errorf("Calculate 5xx = %d, want %d", got.StatusClasses["5xx"], tc.want5xx)
+			}
+		})
+	}
+}
