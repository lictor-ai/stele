index 0000000..27614c9
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,124 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		var flagErr *flagError
+		if errors.As(err, &flagErr) {
+			os.Exit(2)
+		}
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+type flagError struct{ err error }
+
+func (e *flagError) Error() string { return e.err.Error() }
+func (e *flagError) Unwrap() error { return e.err }
+
+func run(args []string, stdout, stderr io.Writer) error {
+	set := flag.NewFlagSet("loga", flag.ContinueOnError)
+	set.SetOutput(stderr)
+	top := set.Int("top", 10, "number of paths to show")
+	jsonOutput := set.Bool("json", false, "write report as JSON")
+	if err := set.Parse(args); err != nil {
+		return &flagError{err: err}
+	}
+	if *top < 0 {
+		return &flagError{err: fmt.Errorf("-top must not be negative")}
+	}
+	files := set.Args()
+	var readers []io.Reader
+	var closers []io.Closer
+	if len(files) == 0 {
+		readers = append(readers, os.Stdin)
+	} else {
+		for _, name := range files {
+			f, err := os.Open(name)
+			if err != nil {
+				for _, c := range closers {
+					_ = c.Close()
+				}
+				return fmt.Errorf("open %s: %w", name, err)
+			}
+			readers = append(readers, f)
+			closers = append(closers, f)
+		}
+	}
+	defer func() {
+		for _, c := range closers {
+			_ = c.Close()
+		}
+	}()
+	entries := make([]logparse.Entry, 0)
+	malformed := 0
+	for _, reader := range readers {
+		scanner := bufio.NewScanner(reader)
+		scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for scanner.Scan() {
+			entry, err := logparse.Parse(scanner.Text())
+			if err != nil {
+				malformed++
+				continue
+			}
+			entries = append(entries, entry)
+		}
+		if err := scanner.Err(); err != nil {
+			return fmt.Errorf("read log: %w", err)
+		}
+	}
+	report := stats.Calculate(entries, malformed, *top)
+	if *jsonOutput {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		return enc.Encode(report)
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(w io.Writer, r stats.Report) error {
+	if _, err := fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\n", r.Total, r.Malformed); err != nil {
+		return err
+	}
+	for _, p := range r.TopPaths {
+		if _, err := fmt.Fprintf(w, "%-40s %d\n", p.Path, p.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(w, "\nStatus classes"); err != nil {
+		return err
+	}
+	for _, k := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(w, "%s %d\n", k, r.StatusClasses[k]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(w, "\nRequest time (ms)\np50 %.3f\np95 %.3f\np99 %.3f\n\n5xx per hour\n", r.P50MS, r.P95MS, r.P99MS); err != nil {
+		return err
+	}
+	hours := make([]string, 0, len(r.ErrorsPerHour))
+	for hour := range r.ErrorsPerHour {
+		hours = append(hours, hour)
+	}
+	sort.Strings(hours)
+	for _, hour := range hours {
+		if _, err := fmt.Fprintf(w, "%s %d\n", hour, r.ErrorsPerHour[hour]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
