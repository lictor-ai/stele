+// ErrMalformedLine indicates that a line is not a valid extended combined log entry.
+var ErrMalformedLine = errors.New("malformed access log line")
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..65ee322
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,54 @@
+// Package logparse parses nginx access logs in extended combined format.
+package logparse
+
+import (
+	"fmt"
+	"math"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+var linePattern = regexp.MustCompile(`^\S+\s+\S+\s+\S+\s+\[([^]]+)\]\s+"([^"]*)"\s+(\d{3})\s+(\S+)\s+"[^"]*"\s+"[^"]*"\s+(\S+)\s*$`)
+
+// Request is one parsed access log request.
+type Request struct {
+	Time     time.Time
+	Path     string
+	Status   int
+	Duration time.Duration
+}
+
+// ParseLine parses one extended combined access log line.
+func ParseLine(line string) (Request, error) {
+	parts := linePattern.FindStringSubmatch(strings.TrimSpace(line))
+	if parts == nil {
+		return Request{}, ErrMalformedLine
+	}
+	requestFields := strings.Fields(parts[2])
+	if len(requestFields) != 3 || requestFields[1] == "" {
+		return Request{}, ErrMalformedLine
+	}
+	when, err := time.Parse("02/Jan/2006:15:04:05 -0700", parts[1])
+	if err != nil {
+		return Request{}, fmt.Errorf("parse request time: %w", ErrMalformedLine)
+	}
+	status, err := strconv.Atoi(parts[3])
+	if err != nil {
+		return Request{}, fmt.Errorf("parse status %q: %w", parts[3], ErrMalformedLine)
+	}
+	seconds, err := strconv.ParseFloat(parts[5], 64)
+	if err != nil || seconds < 0 || math.IsNaN(seconds) || math.IsInf(seconds, 0) || seconds > float64(math.MaxInt64)/float64(time.Second) {
+		return Request{}, fmt.Errorf("parse request duration %q: %w", parts[5], ErrMalformedLine)
+	}
+	duration := time.Duration(seconds * float64(time.Second))
+	path := requestFields[1]
+	if parsed, err := url.ParseRequestURI(path); err == nil && parsed.Path != "" {
+		path = parsed.Path
+	} else if index := strings.IndexByte(path, '?'); index >= 0 {
+		path = path[:index]
+	}
+	return Request{Time: when, Path: path, Status: status, Duration: duration}, nil
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
