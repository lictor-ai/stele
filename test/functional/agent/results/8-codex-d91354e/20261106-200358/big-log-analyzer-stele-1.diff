@@ -0,0 +1,48 @@
+package logparse
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestParseLine(t *testing.T) {
+	cases := []struct {
+		name       string
+		line       string
+		wantPath   string
+		wantStatus int
+		wantTime   time.Time
+		wantDur    time.Duration
+		wantErr    bool
+	}{
+		{
+			name:     "valid request removes query",
+			line:     `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`,
+			wantPath: "/api/items", wantStatus: 200,
+			wantTime: time.Date(2026, time.October, 10, 13, 55, 36, 0, time.UTC), wantDur: 42 * time.Millisecond,
+		},
+		{name: "empty line", line: "", wantErr: true},
+		{name: "missing request time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 5 "-" "agent"`, wantErr: true},
+		{name: "invalid status", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" abc 5 "-" "agent" 0.1`, wantErr: true},
+		{name: "invalid duration", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 5 "-" "agent" NaN`, wantErr: true},
+		{name: "negative duration", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 5 "-" "agent" -0.1`, wantErr: true},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := ParseLine(test.line)
+			if test.wantErr {
+				if !errors.Is(err, ErrMalformedLine) {
+					t.Errorf("ParseLine(%q) error = %v, want %v", test.line, err, ErrMalformedLine)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("ParseLine(%q) error = %v, want nil", test.line, err)
+			}
+			if got.Path != test.wantPath || got.Status != test.wantStatus || !got.Time.Equal(test.wantTime) || got.Duration != test.wantDur {
+				t.Errorf("ParseLine(%q) = %+v, want path %q, status %d, time %v, duration %v", test.line, got, test.wantPath, test.wantStatus, test.wantTime, test.wantDur)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
