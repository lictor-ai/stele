+++ b/internal/stats/stats_test.go
@@ -0,0 +1,68 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestAnalyze(t *testing.T) {
+	timeOne := time.Date(2026, time.October, 10, 13, 12, 0, 0, time.FixedZone("offset", 2*60*60))
+	cases := []struct {
+		name      string
+		requests  []logparse.Request
+		malformed int
+		top       int
+		wantTotal int
+		wantPaths []PathCount
+		wantP50   float64
+		wantP95   float64
+		wantP99   float64
+		want5xx   int
+	}{
+		{name: "empty input", requests: []logparse.Request{}, top: 10, wantTotal: 0},
+		{name: "single request", requests: []logparse.Request{{Path: "/one", Status: 200, Duration: 17 * time.Millisecond}}, top: 10, wantTotal: 1, wantPaths: []PathCount{{Path: "/one", Count: 1}}, wantP50: 17, wantP95: 17, wantP99: 17},
+		{
+			name: "percentile edges and hourly UTC aggregation", malformed: 1, top: 2,
+			requests: []logparse.Request{
+				{Time: timeOne, Path: "/b", Status: 500, Duration: 1 * time.Millisecond},
+				{Time: timeOne, Path: "/a", Status: 404, Duration: 2 * time.Millisecond},
+				{Time: timeOne, Path: "/a", Status: 503, Duration: 3 * time.Millisecond},
+				{Time: timeOne, Path: "/c", Status: 302, Duration: 4 * time.Millisecond},
+				{Time: timeOne, Path: "/d", Status: 201, Duration: 100 * time.Millisecond},
+			},
+			wantTotal: 5, wantPaths: []PathCount{{Path: "/a", Count: 2}, {Path: "/b", Count: 1}},
+			wantP50: 3, wantP95: 100, wantP99: 100, want5xx: 2,
+		},
+		{name: "zero top", requests: []logparse.Request{{Path: "/one", Status: 200}}, top: 0, wantTotal: 1},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			got := Analyze(test.requests, test.malformed, test.top)
+			if got.TotalRequests != test.wantTotal || got.MalformedLines != test.malformed {
+				t.Errorf("Analyze(...) totals = (%d, %d), want (%d, %d)", got.TotalRequests, got.MalformedLines, test.wantTotal, test.malformed)
+			}
+			if len(got.TopPaths) != len(test.wantPaths) {
+				t.Fatalf("Analyze(...) top paths = %v, want %v", got.TopPaths, test.wantPaths)
+			}
+			for index, want := range test.wantPaths {
+				if got.TopPaths[index] != want {
+					t.Errorf("Analyze(...) top path %d = %+v, want %+v", index, got.TopPaths[index], want)
+				}
+			}
+			if got.P50Millis != test.wantP50 || got.P95Millis != test.wantP95 || got.P99Millis != test.wantP99 {
+				t.Errorf("Analyze(...) percentiles = (%v, %v, %v), want (%v, %v, %v)", got.P50Millis, got.P95Millis, got.P99Millis, test.wantP50, test.wantP95, test.wantP99)
+			}
+			if test.name == "percentile edges and hourly UTC aggregation" && (got.StatusClasses["2xx"] != 1 || got.StatusClasses["3xx"] != 1 || got.StatusClasses["4xx"] != 1 || got.StatusClasses["5xx"] != test.want5xx) {
+				t.Errorf("Analyze(...) status classes = %v, want 2xx 1, 3xx 1, 4xx 1, 5xx %d", got.StatusClasses, test.want5xx)
+			}
+			if test.want5xx == 0 && len(got.FiveXXPerHour) != 0 {
+				t.Errorf("Analyze(...) hourly errors = %v, want none", got.FiveXXPerHour)
+			}
+			if test.want5xx > 0 && (len(got.FiveXXPerHour) != 1 || got.FiveXXPerHour[0].Count != test.want5xx || got.FiveXXPerHour[0].Hour != "2026-10-10T11:00Z") {
+				t.Errorf("Analyze(...) hourly errors = %v, want 2026-10-10T11:00Z count %d", got.FiveXXPerHour, test.want5xx)
+			}
+		})
+	}
+}
