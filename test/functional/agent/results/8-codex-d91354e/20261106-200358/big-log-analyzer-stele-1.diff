@@ -0,0 +1,54 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	line := `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 500 512 "-" "curl/8.0" 0.042`
+	cases := []struct {
+		name     string
+		args     []string
+		input    string
+		wantCode int
+		wantText string
+		wantJSON bool
+	}{
+		{name: "text report counts malformed", input: line + "\nnot a log\n", wantText: "Total requests: 1\nMalformed lines: 1\n"},
+		{name: "json report", args: []string{"-json", "-top", "1"}, input: line + "\n", wantJSON: true},
+		{name: "bad flag", args: []string{"-unknown"}, wantCode: 2},
+		{name: "negative top", args: []string{"-top", "-1"}, wantCode: 2},
+		{name: "unreadable file", args: []string{filepath.Join(t.TempDir(), "missing.log")}, wantCode: 1},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			err := run(test.args, &stdout, &stderr, bytes.NewBufferString(test.input))
+			if test.wantCode == 0 && err != nil {
+				t.Fatalf("run(%v) error = %v, want nil", test.args, err)
+			}
+			if test.wantCode != 0 {
+				var coded commandError
+				if !errors.As(err, &coded) || coded.code != test.wantCode {
+					t.Fatalf("run(%v) error = %v, want exit code %d", test.args, err, test.wantCode)
+				}
+				return
+			}
+			if test.wantJSON {
+				var report map[string]any
+				if err := json.Unmarshal(stdout.Bytes(), &report); err != nil {
+					t.Fatalf("JSON output %q failed to decode: %v", stdout.String(), err)
+				}
+				if report["total_requests"] != float64(1) || report["malformed_lines"] != float64(0) {
+					t.Errorf("JSON report totals = (%v, %v), want (1, 0)", report["total_requests"], report["malformed_lines"])
+				}
+			} else if !bytes.HasPrefix(stdout.Bytes(), []byte(test.wantText)) {
+				t.Errorf("run(%v) output = %q, want prefix %q", test.args, stdout.String(), test.wantText)
+			}
+		})
+	}
+}
