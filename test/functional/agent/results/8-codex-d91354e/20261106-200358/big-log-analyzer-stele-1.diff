index 0000000..124e4bf
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,93 @@
+// Package stats aggregates parsed access log requests.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount records the number of requests for a path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// HourCount records 5xx errors for one UTC hour.
+type HourCount struct {
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// Report contains the aggregate log analysis.
+type Report struct {
+	TotalRequests  int            `json:"total_requests"`
+	MalformedLines int            `json:"malformed_lines"`
+	TopPaths       []PathCount    `json:"top_paths"`
+	StatusClasses  map[string]int `json:"status_classes"`
+	P50Millis      float64        `json:"p50_millis"`
+	P95Millis      float64        `json:"p95_millis"`
+	P99Millis      float64        `json:"p99_millis"`
+	FiveXXPerHour  []HourCount    `json:"five_xx_per_hour"`
+}
+
+// Analyze builds a report from requests and the number of skipped malformed lines.
+func Analyze(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	counts := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	durations := make([]time.Duration, 0, len(requests))
+	for _, request := range requests {
+		counts[request.Path]++
+		class := request.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			classes[key]++
+		}
+		if request.Status >= 500 && request.Status < 600 {
+			hours[request.Time.UTC().Format("2006-01-02T15:00Z")]++
+		}
+		durations = append(durations, request.Duration)
+	}
+	paths := make([]PathCount, 0, len(counts))
+	for path, count := range counts {
+		paths = append(paths, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(paths, func(i, j int) bool {
+		if paths[i].Count == paths[j].Count {
+			return paths[i].Path < paths[j].Path
+		}
+		return paths[i].Count > paths[j].Count
+	})
+	if len(paths) > top {
+		paths = paths[:top]
+	}
+	hourCounts := make([]HourCount, 0, len(hours))
+	for hour, count := range hours {
+		hourCounts = append(hourCounts, HourCount{Hour: hour, Count: count})
+	}
+	sort.Slice(hourCounts, func(i, j int) bool { return hourCounts[i].Hour < hourCounts[j].Hour })
+	sort.Slice(durations, func(i, j int) bool { return durations[i] < durations[j] })
+	return Report{
+		TotalRequests: len(requests), MalformedLines: malformed, TopPaths: paths,
+		StatusClasses: classes, P50Millis: percentileMillis(durations, 0.50),
+		P95Millis: percentileMillis(durations, 0.95), P99Millis: percentileMillis(durations, 0.99),
+		FiveXXPerHour: hourCounts,
+	}
+}
+
+func percentileMillis(values []time.Duration, percentile float64) float64 {
+	if len(values) == 0 {
+		return 0
+	}
+	index := int(math.Ceil(percentile*float64(len(values)))) - 1
+	if index < 0 {
+		index = 0
+	}
+	return float64(values[index]) / float64(time.Millisecond)
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..6ab8def
