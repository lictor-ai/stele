diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..60a449b
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,142 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+type commandError struct {
+	code int
+	err  error
+}
+
+func (e commandError) Error() string { return e.err.Error() }
+func (e commandError) Unwrap() error { return e.err }
+
+func run(args []string, stdout, stderr io.Writer, stdin io.Reader) error {
+	flags := flag.NewFlagSet("loga", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	top := flags.Int("top", 10, "number of paths to show")
+	jsonOutput := flags.Bool("json", false, "write JSON output")
+	if err := flags.Parse(args); err != nil {
+		return commandError{code: 2, err: err}
+	}
+	if *top < 0 {
+		err := fmt.Errorf("-top must be non-negative")
+		fmt.Fprintln(stderr, err)
+		return commandError{code: 2, err: err}
+	}
+	var requests []logparse.Request
+	malformed := 0
+	files := flags.Args()
+	if len(files) == 0 {
+		if err := readLog(stdin, "stdin", &requests, &malformed); err != nil {
+			return commandError{code: 1, err: err}
+		}
+	} else {
+		for _, name := range files {
+			file, err := os.Open(name)
+			if err != nil {
+				return commandError{code: 1, err: fmt.Errorf("open %s: %w", name, err)}
+			}
+			readErr := readLog(file, name, &requests, &malformed)
+			closeErr := file.Close()
+			if readErr != nil {
+				return commandError{code: 1, err: readErr}
+			}
+			if closeErr != nil {
+				return commandError{code: 1, err: fmt.Errorf("close %s: %w", name, closeErr)}
+			}
+		}
+	}
+	report := stats.Analyze(requests, malformed, *top)
+	if *jsonOutput {
+		encoder := json.NewEncoder(stdout)
+		encoder.SetIndent("", "  ")
+		if err := encoder.Encode(report); err != nil {
+			return commandError{code: 1, err: fmt.Errorf("write JSON report: %w", err)}
+		}
+		return nil
+	}
+	return writeText(stdout, report)
+}
+
+func readLog(reader io.Reader, name string, requests *[]logparse.Request, malformed *int) error {
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+	for scanner.Scan() {
+		request, err := logparse.ParseLine(scanner.Text())
+		if err != nil {
+			if errors.Is(err, logparse.ErrMalformedLine) {
+				*malformed++
+				continue
+			}
+			return fmt.Errorf("parse %s: %w", name, err)
+		}
+		*requests = append(*requests, request)
+	}
+	if err := scanner.Err(); err != nil {
+		return fmt.Errorf("read %s: %w", name, err)
+	}
+	return nil
+}
+
+func writeText(writer io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(writer, "Total requests: %d\nMalformed lines: %d\n", report.TotalRequests, report.MalformedLines); err != nil {
+		return commandError{code: 1, err: err}
+	}
+	if _, err := fmt.Fprintln(writer, "Top paths:"); err != nil {
+		return commandError{code: 1, err: err}
+	}
+	for _, item := range report.TopPaths {
+		if _, err := fmt.Fprintf(writer, "  %s %d\n", item.Path, item.Count); err != nil {
+			return commandError{code: 1, err: err}
+		}
+	}
+	if _, err := fmt.Fprintln(writer, "Status classes:"); err != nil {
+		return commandError{code: 1, err: err}
+	}
+	for _, class := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(writer, "  %s %d\n", class, report.StatusClasses[class]); err != nil {
+			return commandError{code: 1, err: err}
+		}
+	}
+	if _, err := fmt.Fprintf(writer, "Request time (ms): p50 %.3f p95 %.3f p99 %.3f\n", report.P50Millis, report.P95Millis, report.P99Millis); err != nil {
+		return commandError{code: 1, err: err}
+	}
+	if _, err := fmt.Fprintln(writer, "5xx per hour:"); err != nil {
+		return commandError{code: 1, err: err}
+	}
+	for _, item := range report.FiveXXPerHour {
+		if _, err := fmt.Fprintf(writer, "  %s %d\n", item.Hour, item.Count); err != nil {
+			return commandError{code: 1, err: err}
+		}
+	}
+	return nil
+}
+
+func main() {
+	err := run(os.Args[1:], os.Stdout, os.Stderr, os.Stdin)
+	if err == nil {
+		return
+	}
+	var coded commandError
+	if errors.As(err, &coded) {
+		if coded.code == 2 {
+			os.Exit(2)
+		}
+		fmt.Fprintln(os.Stderr, strings.TrimSpace(coded.Error()))
+		os.Exit(coded.code)
+	}
+	fmt.Fprintln(os.Stderr, err)
+	os.Exit(1)
+}
