+++ b/internal/todo/todo_test.go
@@ -0,0 +1,61 @@
+package todo
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestCRUDAndList(t *testing.T) {
+	base := time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)
+	n := 0
+	s := NewStoreWith(clock.Fixed{T: base}, func() string { n++; return fmt.Sprint(n) })
+	a := s.Create("first")
+	b := s.Create("second")
+	done := true
+	updated, ok := s.Update(a.ID, nil, &done)
+	if !ok || !updated.Done {
+		t.Fatal("update failed")
+	}
+	if got := s.List(Filter{Done: &done, Limit: 1}); len(got) != 1 || got[0].ID != a.ID {
+		t.Fatalf("filtered list: %#v", got)
+	}
+	if got := s.List(Filter{Limit: 1}); len(got) != 1 || got[0].ID != b.ID {
+		t.Fatalf("newest first: %#v", got)
+	}
+	if got := s.List(Filter{Offset: 2}); len(got) != 0 {
+		t.Fatalf("offset past end: %#v", got)
+	}
+	if _, ok := s.Get(b.ID); !ok {
+		t.Fatal("get failed")
+	}
+	if !s.Delete(a.ID) || s.Delete(a.ID) {
+		t.Fatal("delete semantics incorrect")
+	}
+	if _, ok := s.Get(a.ID); ok {
+		t.Fatal("deleted todo remains")
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	s := NewStore()
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				x := s.Create(fmt.Sprintf("%d-%d", i, j))
+				s.Get(x.ID)
+				d := true
+				s.Update(x.ID, nil, &d)
+				s.List(Filter{Limit: 5})
+				s.Delete(x.ID)
+			}
+		}(i)
+	}
+	wg.Wait()
+}
