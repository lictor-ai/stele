index 0000000..ec24c8d
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,131 @@
+// Package todo provides concurrent in-memory TODO storage.
+package todo
+
+import (
+	"context"
+	"sort"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task with timestamps managed by Store.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store holds TODO records safely across concurrent callers.
+type Store struct {
+	mu    sync.RWMutex // guards items
+	items map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates an empty store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{items: make(map[string]Todo), clock: c}
+}
+
+// UpdateInput contains optional fields to update. Nil means unchanged.
+type UpdateInput struct {
+	Title *string
+	Done  *bool
+}
+
+// Create stores a new TODO with its title and returns it.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns the TODO with id.
+func (s *Store) Get(ctx context.Context, id string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.RLock()
+	t, ok := s.items[id]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the supplied fields of a TODO.
+func (s *Store) Update(ctx context.Context, id string, input UpdateInput) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[id]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if input.Title != nil {
+		t.Title = *input.Title
+	}
+	if input.Done != nil {
+		t.Done = *input.Done
+	}
+	t.UpdatedAt = s.clock.Now()
+	s.items[id] = t
+	return t, nil
+}
+
+// Delete removes a TODO.
+func (s *Store) Delete(ctx context.Context, id string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[id]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, id)
+	return nil
+}
+
+// List returns TODOs newest first, with an optional done filter and pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.items))
+	for _, t := range s.items {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if limit < len(items) {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
new file mode 100644
index 0000000..0dda7a9
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,110 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name string
+		run  func(*testing.T)
+	}{
+		{name: "create get update delete and missing", run: func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			created, err := s.Create(context.Background(), "Task")
+			if err != nil {
+				t.Fatalf("Create() error = %v", err)
+			}
+			got, err := s.Get(context.Background(), created.ID)
+			if err != nil || got.Title != "Task" {
+				t.Fatalf("Get() = %+v, %v; want Task", got, err)
+			}
+			title, done := "Renamed", true
+			got, err = s.Update(context.Background(), created.ID, UpdateInput{Title: &title, Done: &done})
+			if err != nil || got.Title != title || !got.Done {
+				t.Fatalf("Update() = %+v, %v", got, err)
+			}
+			if err := s.Delete(context.Background(), created.ID); err != nil {
+				t.Fatalf("Delete() error = %v", err)
+			}
+			if _, err := s.Get(context.Background(), created.ID); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Get(missing) error = %v, want ErrNotFound", err)
+			}
+			if err := s.Delete(context.Background(), created.ID); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Delete(missing) error = %v, want ErrNotFound", err)
+			}
+		}},
+		{name: "list filter and pagination", run: func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			for i := 0; i < 4; i++ {
+				if _, err := s.Create(context.Background(), fmt.Sprint(i)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			done := true
+			if _, err := s.Update(context.Background(), "", UpdateInput{}); !errors.Is(err, ErrNotFound) {
+				t.Fatal(err)
+			}
+			all, err := s.List(context.Background(), nil, 2, 1)
+			if err != nil || len(all) != 2 {
+				t.Fatalf("List() = %d, %v; want 2", len(all), err)
+			}
+			if all[0].ID <= all[1].ID {
+				t.Errorf("List() IDs = %q, %q; want newest first", all[0].ID, all[1].ID)
+			}
+			items, err := s.List(context.Background(), &done, 20, 0)
+			if err != nil || len(items) != 0 {
+				t.Errorf("List(done) = %d, %v; want empty", len(items), err)
+			}
+			items, err = s.List(context.Background(), nil, 20, 100)
+			if err != nil || len(items) != 0 {
+				t.Errorf("List(offset) = %d, %v; want empty", len(items), err)
+			}
+		}},
+		{name: "cancelled context", run: func(t *testing.T) {
+			s := NewStore(clock.Real{})
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			if _, err := s.List(ctx, nil, 10, 0); !errors.Is(err, context.Canceled) {
+				t.Errorf("List(cancelled) error = %v, want context.Canceled", err)
+			}
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, tc.run)
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore(clock.Real{})
+	const workers = 24
+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			ctx := context.Background()
+			item, err := s.Create(ctx, fmt.Sprintf("task-%d", i))
+			if err != nil {
+				return
+			}
+			_, _ = s.Get(ctx, item.ID)
+			done := true
+			_, _ = s.Update(ctx, item.ID, UpdateInput{Done: &done})
+			_, _ = s.List(ctx, nil, 100, 0)
+			_ = s.Delete(ctx, item.ID)
+		}(i)
+	}
+	wg.Wait()
+	items, err := s.List(context.Background(), nil, 100, 0)
+	if err != nil || len(items) != 0 {
+		t.Errorf("List() after concurrent operations = %d, %v; want empty", len(items), err)
+	}
