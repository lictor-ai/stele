+func TestDiscounts(t *testing.T) {
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	tests := []struct {
+		name    string
+		code    DiscountCode
+		want    int64
+		wantErr error
+	}{
+		{name: "fixed amount floors at zero", code: DiscountCode{Code: "FIX", AmountCents: 900}, want: 1},
+		{name: "percentage rounds half away", code: DiscountCode{Code: "HALF", Percent: 5000}, want: 1},
+		{name: "expired", code: DiscountCode{Code: "OLD", AmountCents: 1, ExpiresAt: timePointer(now.Add(-time.Second))}, wantErr: ErrDiscountExpired},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			inv, err := ComputeWithOptions("i", "c", []Line{{Quantity: 1, UnitCents: 1}}, Options{Discount: &tc.code, Now: now})
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("ComputeWithOptions error = %v, want %v", err, tc.wantErr)
+			}
+			if err == nil && inv.DiscountCents != tc.want {
+				t.Errorf("discount = %d, want %d", inv.DiscountCents, tc.want)
+			}
+		})
+	}
+	code := DiscountCode{Code: "ONCE", AmountCents: 1}
+	if _, err := ComputeWithOptions("i1", "c", []Line{{Quantity: 1, UnitCents: 1}}, Options{Discount: &code, Now: now}); err != nil {
+		t.Fatalf("first use error = %v, want nil", err)
+	}
+	if _, err := ComputeWithOptions("i2", "c", []Line{{Quantity: 1, UnitCents: 1}}, Options{Discount: &code, Now: now}); !errors.Is(err, ErrDiscountUsed) {
+		t.Errorf("second use error = %v, want %v", err, ErrDiscountUsed)
+	}
+}
+
+func TestTaxAndCSV(t *testing.T) {
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	code := DiscountCode{Code: "SAVE", AmountCents: 100}
+	inv, err := ComputeWithOptions("inv,1", "acme", []Line{{Quantity: 1, UnitCents: 1000}}, Options{Region: "FR", TaxRates: map[string]int64{"FR": 2000}, Discount: &code, Now: now})
+	if err != nil {
+		t.Fatalf("ComputeWithOptions error = %v, want nil", err)
+	}
+	if inv.TaxCents != 180 || inv.GrandTotalCents != 1080 {
+		t.Errorf("tax/total = %d/%d, want 180/1080", inv.TaxCents, inv.GrandTotalCents)
+	}
+	var output bytes.Buffer
+	if err := ExportCSV(&output, []Invoice{inv}); err != nil {
+		t.Fatalf("ExportCSV error = %v, want nil", err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\n\"inv,1\",acme,FR,2026-01-02T03:04:05Z,1000,100,180,1080\n"
+	if output.String() != want {
+		t.Errorf("ExportCSV output = %q, want %q", output.String(), want)
+	}
+}
+
+func timePointer(value time.Time) *time.Time { return &value }
