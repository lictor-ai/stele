+// ComputeWithOptions builds an invoice with an optional discount and regional tax.
+func ComputeWithOptions(id, customer string, lines []Line, options Options) (Invoice, error) {
+	if customer == "" || options.Now.IsZero() {
+		return Invoice{}, fmt.Errorf("%w: customer and issue time are required", ErrInvalidInput)
 	}
 	var total int64
-	for _, l := range lines {
-		total += int64(l.Quantity) * l.UnitCents
+	for _, line := range lines {
+		if line.Quantity < 0 || line.UnitCents < 0 {
+			return Invoice{}, fmt.Errorf("%w: negative quantity or unit price", ErrInvalidInput)
+		}
+		lineTotal := int64(line.Quantity) * line.UnitCents
+		if line.Quantity != 0 && lineTotal/int64(line.Quantity) != line.UnitCents || total > int64(^uint64(0)>>1)-lineTotal {
+			return Invoice{}, fmt.Errorf("%w: invoice total overflow", ErrInvalidInput)
+		}
+		total += lineTotal
+	}
+	inv := Invoice{ID: id, Customer: customer, Lines: append([]Line(nil), lines...), Region: options.Region, TotalCents: total, GrandTotalCents: total, IssuedAt: options.Now}
+	if options.Discount != nil {
+		discount := options.Discount
+		if discount.Code == "" || (discount.Percent > 0) == (discount.AmountCents > 0) || discount.Percent < 0 || discount.Percent > 10000 || discount.AmountCents < 0 {
+			return Invoice{}, fmt.Errorf("%w: discount must specify a valid percentage or amount", ErrInvalidInput)
+		}
+		if discount.ExpiresAt != nil && options.Now.After(*discount.ExpiresAt) {
+			return Invoice{}, ErrDiscountExpired
+		}
+		if discount.UsedByCustomer[customer] {
+			return Invoice{}, ErrDiscountUsed
+		}
+		if discount.Percent > 0 {
+			inv.DiscountCents = percentage(total, discount.Percent)
+		} else {
+			inv.DiscountCents = discount.AmountCents
+			if inv.DiscountCents > total {
+				inv.DiscountCents = total
+			}
+		}
+	}
+	net := total - inv.DiscountCents
+	if options.Region != "" {
+		rate, ok := options.TaxRates[options.Region]
+		if !ok || rate < 0 {
+			return Invoice{}, fmt.Errorf("%w: missing or invalid tax rate for region %q", ErrInvalidInput, options.Region)
+		}
+		inv.TaxCents = percentage(net, rate)
 	}
-	fmt.Printf("computed invoice %s for %s: %d\n", id, customer, total)
-	return Invoice{ID: id, Customer: customer, Lines: lines, TotalCents: total, IssuedAt: time.Now()}
+	if net > int64(^uint64(0)>>1)-inv.TaxCents {
+		return Invoice{}, fmt.Errorf("%w: grand total overflow", ErrInvalidInput)
+	}
+	inv.GrandTotalCents = net + inv.TaxCents
+	if options.Discount != nil {
+		if options.Discount.UsedByCustomer == nil {
+			options.Discount.UsedByCustomer = make(map[string]bool)
+		}
+		options.Discount.UsedByCustomer[customer] = true
+	}
+	return inv, nil
+}
+
+func percentage(value, basisPoints int64) int64 {
+	product := new(big.Int).Mul(big.NewInt(value), big.NewInt(basisPoints))
+	product.Add(product, big.NewInt(5000))
+	product.Quo(product, big.NewInt(10000))
+	return product.Int64()
 }
 
