+++ b/internal/billing/tax.go
@@ -0,0 +1,45 @@
+package billing
+
+import (
+	"errors"
+	"fmt"
+)
+
+var (
+	// ErrUnknownRegion indicates that no tax rate exists for an invoice region.
+	ErrUnknownRegion = errors.New("unknown tax region")
+	// ErrInvalidTaxRate indicates that a tax rate is outside the supported range.
+	ErrInvalidTaxRate = errors.New("invalid tax rate")
+)
+
+// ApplyTax sets the invoice region and computes tax using rates in basis points.
+func ApplyTax(inv *Invoice, region string, rates map[string]int64) error {
+	if inv == nil || region == "" {
+		return fmt.Errorf("apply tax: %w", ErrUnknownRegion)
+	}
+	rate, ok := rates[region]
+	if !ok {
+		return fmt.Errorf("apply tax for region %q: %w", region, ErrUnknownRegion)
+	}
+	if rate < 0 || rate > 100000 {
+		return fmt.Errorf("apply tax for region %q: %w", region, ErrInvalidTaxRate)
+	}
+	taxable := inv.TotalCents - inv.DiscountCents
+	if taxable < 0 {
+		taxable = 0
+	}
+	inv.Region = region
+	inv.TaxCents = roundedTax(taxable, rate)
+	inv.GrandTotalCents = taxable + inv.TaxCents
+	return nil
+}
+
+func roundedTax(amount, bps int64) int64 {
+	if amount == 0 || bps == 0 {
+		return 0
+	}
+	whole := (amount / 10000) * bps
+	remainder := (amount % 10000) * bps
+	return whole + (remainder+5000)/10000
+}
+
