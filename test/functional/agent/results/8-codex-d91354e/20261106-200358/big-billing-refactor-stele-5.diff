index 0000000..b6dc465
--- /dev/null
+++ b/internal/billing/tax.go
@@ -0,0 +1,41 @@
+package billing
+
+import (
+	"fmt"
+	"math"
+)
+
+// ApplyTax sets an invoice's region, tax, and grand total from rates in basis points.
+func ApplyTax(invoice Invoice, region string, rates map[string]int64) (Invoice, error) {
+	rate, ok := rates[region]
+	if !ok || rate < 0 {
+		return Invoice{}, fmt.Errorf("tax rate for region %q: %w", region, ErrInvalidTaxRate)
+	}
+	base := invoice.TotalCents - invoice.DiscountCents
+	if base < 0 {
+		base = 0
+	}
+	tax, err := roundBasisPoints(base, rate)
+	if err != nil {
+		return Invoice{}, fmt.Errorf("compute tax for region %q: %w", region, err)
+	}
+	if tax > math.MaxInt64-base {
+		return Invoice{}, fmt.Errorf("compute grand total: %w", ErrInvalidTaxRate)
+	}
+	invoice.Region = region
+	invoice.TaxCents = tax
+	invoice.GrandTotalCents = base + tax
+	return invoice, nil
+}
+
+func roundBasisPoints(amount, rate int64) (int64, error) {
+	if amount < 0 || rate < 0 || amount != 0 && rate > math.MaxInt64/amount {
+		return 0, ErrInvalidTaxRate
+	}
+	product := amount * rate
+	quotient, remainder := product/10000, product%10000
+	if remainder >= 5000 {
+		quotient++
+	}
+	return quotient, nil
+}
