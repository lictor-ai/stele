new file mode 100644
index 0000000..44aacf3
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,36 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+)
+
+// WriteCSV writes invoices as CSV with monetary values represented in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return fmt.Errorf("write invoice CSV header: %w", err)
+	}
+	for _, invoice := range invoices {
+		row := []string{
+			invoice.ID,
+			invoice.Customer,
+			invoice.Region,
+			invoice.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(invoice.TotalCents, 10),
+			strconv.FormatInt(invoice.DiscountCents, 10),
+			strconv.FormatInt(invoice.TaxCents, 10),
+			strconv.FormatInt(invoice.GrandTotalCents, 10),
+		}
+		if err := writer.Write(row); err != nil {
+			return fmt.Errorf("write invoice %q to CSV: %w", invoice.ID, err)
+		}
+	}
+	writer.Flush()
+	if err := writer.Error(); err != nil {
+		return fmt.Errorf("flush invoice CSV: %w", err)
+	}
+	return nil
+}
diff --git a/internal/billing/features_test.go b/internal/billing/features_test.go
new file mode 100644
index 0000000..7971b88
--- /dev/null
+++ b/internal/billing/features_test.go
@@ -0,0 +1,88 @@
+package billing
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestApplyDiscount(t *testing.T) {
+	expiry := time.Date(2030, 1, 2, 0, 0, 0, 0, time.UTC)
+	cases := []struct {
+		name    string
+		code    *DiscountCode
+		now     time.Time
+		wantDiscount int64
+		wantTotal    int64
+		wantErr       error
+	}{
+		{name: "percentage rounds half up", code: &DiscountCode{Code: "half", PercentBPS: 5000}, now: expiry.Add(-time.Hour), wantDiscount: 2, wantTotal: 1},
+		{name: "fixed discount floors at zero", code: &DiscountCode{Code: "large", AmountCents: 20}, now: expiry.Add(-time.Hour), wantDiscount: 3, wantTotal: 0},
+		{name: "expired", code: &DiscountCode{Code: "old", AmountCents: 1, ExpiresAt: &expiry}, now: expiry, wantErr: ErrDiscountExpired},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inv := Invoice{Customer: "acme", TotalCents: 3, GrandTotalCents: 3}
+			got, err := ApplyDiscount(inv, tc.code, tc.now)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("ApplyDiscount() error = %v, want %v", err, tc.wantErr)
+			}
+			if err == nil && got.DiscountCents != tc.wantDiscount {
+				t.Errorf("ApplyDiscount() discount = %d, want %d", got.DiscountCents, tc.wantDiscount)
+			}
+			if err == nil && got.GrandTotalCents != tc.wantTotal {
+				t.Errorf("ApplyDiscount() grand total = %d, want %d", got.GrandTotalCents, tc.wantTotal)
+			}
+		})
+	}
+}
+
+func TestDiscountReuse(t *testing.T) {
+	code := &DiscountCode{Code: "once", AmountCents: 1}
+	base := Invoice{Customer: "acme", TotalCents: 10}
+	if _, err := ApplyDiscount(base, code, time.Time{}); err != nil {
+		t.Fatalf("ApplyDiscount() first error = %v, want nil", err)
+	}
+	if _, err := ApplyDiscount(base, code, time.Time{}); !errors.Is(err, ErrDiscountUsed) {
+		t.Errorf("ApplyDiscount() reuse error = %v, want %v", err, ErrDiscountUsed)
+	}
+}
+
+func TestApplyTax(t *testing.T) {
+	cases := []struct {
+		name      string
+		inv       Invoice
+		rate      int64
+		wantTax   int64
+		wantTotal int64
+	}{
+		{name: "tax after discount", inv: Invoice{TotalCents: 1000, DiscountCents: 200}, rate: 1000, wantTax: 80, wantTotal: 880},
+		{name: "rounds half up", inv: Invoice{TotalCents: 5}, rate: 1000, wantTax: 1, wantTotal: 6},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := ApplyTax(tc.inv, "FR", map[string]int64{"FR": tc.rate})
+			if err != nil {
+				t.Fatalf("ApplyTax() error = %v, want nil", err)
+			}
+			if got.TaxCents != tc.wantTax || got.GrandTotalCents != tc.wantTotal || got.Region != "FR" {
+				t.Errorf("ApplyTax() = tax %d, total %d, region %q; want tax %d, total %d, region FR", got.TaxCents, got.GrandTotalCents, got.Region, tc.wantTax, tc.wantTotal)
+			}
+		})
+	}
+}
+
+func TestWriteCSV(t *testing.T) {
+	var out bytes.Buffer
+	issued := time.Date(2025, 3, 4, 5, 6, 7, 0, time.UTC)
+	err := WriteCSV(&out, []Invoice{{ID: "i1", Customer: "acme", Region: "FR", IssuedAt: issued, TotalCents: 1000, DiscountCents: 100, TaxCents: 180, GrandTotalCents: 1080}})
+	if err != nil {
+		t.Fatalf("WriteCSV() error = %v, want nil", err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\ni1,acme,FR,2025-03-04T05:06:07Z,1000,100,180,1080\n"
+	if strings.TrimSpace(out.String()) != strings.TrimSpace(want) {
+		t.Errorf("WriteCSV() = %q, want %q", out.String(), want)
+	}
+}
