index 0000000..98c82d7
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,69 @@
+package billing
+
+import (
+	"fmt"
+	"math"
+	"sync"
+	"time"
+)
+
+// DiscountCode describes a percentage or fixed amount discount.
+type DiscountCode struct {
+	Code        string
+	PercentBPS  int64
+	AmountCents int64
+	ExpiresAt   *time.Time
+
+	mu     sync.RWMutex // guards usedBy.
+	usedBy map[string]bool
+}
+
+// ApplyDiscount applies a code once per customer and floors the invoice total at zero.
+func ApplyDiscount(invoice Invoice, code *DiscountCode, now time.Time) (Invoice, error) {
+	if code == nil || code.Code == "" || (code.PercentBPS > 0) == (code.AmountCents > 0) || code.PercentBPS < 0 || code.PercentBPS > 10000 || code.AmountCents < 0 {
+		return Invoice{}, ErrInvalidDiscount
+	}
+	if invoice.DiscountCode != "" {
+		return Invoice{}, ErrInvalidDiscount
+	}
+	if code.ExpiresAt != nil && !now.Before(*code.ExpiresAt) {
+		return Invoice{}, ErrDiscountExpired
+	}
+	code.mu.RLock()
+	used := code.usedBy[invoice.Customer]
+	code.mu.RUnlock()
+	if used {
+		return Invoice{}, ErrDiscountUsed
+	}
+	code.mu.Lock()
+	defer code.mu.Unlock()
+	if code.usedBy == nil {
+		code.usedBy = make(map[string]bool)
+	}
+	if code.usedBy[invoice.Customer] {
+		return Invoice{}, ErrDiscountUsed
+	}
+	base := invoice.TotalCents - invoice.DiscountCents
+	if base < 0 {
+		base = 0
+	}
+	discount := code.AmountCents
+	if code.PercentBPS > 0 {
+		var err error
+		discount, err = roundBasisPoints(base, code.PercentBPS)
+		if err != nil {
+			return Invoice{}, fmt.Errorf("compute discount %q: %w", code.Code, err)
+		}
+	}
+	if discount > base {
+		discount = base
+	}
+	if invoice.DiscountCents > math.MaxInt64-discount {
+		return Invoice{}, ErrInvalidDiscount
+	}
+	invoice.DiscountCents += discount
+	invoice.DiscountCode = code.Code
+	invoice.GrandTotalCents = base - discount + invoice.TaxCents
+	code.usedBy[invoice.Customer] = true
+	return invoice, nil
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
new file mode 100644
index 0000000..4ab5b6a
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,14 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrInvalidDiscount reports a malformed or already-applied discount.
+	ErrInvalidDiscount = errors.New("invalid discount code")
+	// ErrDiscountExpired reports a code whose expiry time has passed.
+	ErrDiscountExpired = errors.New("discount code expired")
+	// ErrDiscountUsed reports a code already used by the invoice customer.
+	ErrDiscountUsed    = errors.New("discount code already used by customer")
+	// ErrInvalidTaxRate reports a missing, invalid, or overflowing tax rate.
+	ErrInvalidTaxRate  = errors.New("invalid tax rate")
+)
