--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,66 @@
+package logparse
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is one parsed nginx access log entry.
+type Request struct {
+	Path     string
+	Status   int
+	Duration time.Duration
+	Time     time.Time
+}
+
+// Parse parses one combined-format access log line with a trailing request time in seconds.
+func Parse(line string) (Request, error) {
+	firstQuote := strings.IndexByte(line, '"')
+	if firstQuote < 0 {
+		return Request{}, fmt.Errorf("missing request field")
+	}
+	closeRequest := strings.IndexByte(line[firstQuote+1:], '"')
+	if closeRequest < 0 {
+		return Request{}, fmt.Errorf("unterminated request field")
+	}
+	closeRequest += firstQuote + 1
+	prefix := strings.Fields(line[:firstQuote])
+	if len(prefix) < 4 {
+		return Request{}, fmt.Errorf("missing timestamp")
+	}
+	stamp := strings.TrimPrefix(prefix[3], "[")
+	if !strings.HasPrefix(prefix[3], "[") {
+		return Request{}, fmt.Errorf("invalid timestamp field")
+	}
+	timestamp, err := time.Parse("02/Jan/2006:15:04:05", stamp)
+	if err != nil {
+		return Request{}, fmt.Errorf("parse timestamp: %w", err)
+	}
+	requestFields := strings.Fields(line[firstQuote+1 : closeRequest])
+	if len(requestFields) < 2 {
+		return Request{}, fmt.Errorf("invalid request field")
+	}
+	path := strings.SplitN(requestFields[1], "?", 2)[0]
+	rest := strings.Fields(line[closeRequest+1:])
+	if len(rest) < 5 {
+		return Request{}, fmt.Errorf("missing status or request time")
+	}
+	status, err := strconv.Atoi(rest[0])
+	if err != nil || status < 100 || status > 599 {
+		return Request{}, fmt.Errorf("invalid status %q", rest[0])
+	}
+	seconds, err := strconv.ParseFloat(rest[len(rest)-1], 64)
+	if err != nil || seconds < 0 {
+		return Request{}, fmt.Errorf("invalid request time %q", rest[len(rest)-1])
+	}
+	duration := time.Duration(seconds * float64(time.Second))
+	zone := strings.TrimSuffix(prefix[4], "]")
+	offset, err := time.Parse("-0700", zone)
+	if err != nil {
+		return Request{}, fmt.Errorf("parse timezone: %w", err)
+	}
+	timestamp = time.Date(timestamp.Year(), timestamp.Month(), timestamp.Day(), timestamp.Hour(), timestamp.Minute(), timestamp.Second(), 0, offset.Location())
+	return Request{Path: path, Status: status, Duration: duration, Time: timestamp}, nil
+}
