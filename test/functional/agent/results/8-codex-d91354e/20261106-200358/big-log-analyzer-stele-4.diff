index 0000000..cacea5a
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,123 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		var flagErr *flagError
+		if errors.As(err, &flagErr) {
+			os.Exit(2)
+		}
+		os.Exit(1)
+	}
+}
+
+type flagError struct{ err error }
+
+func (e *flagError) Error() string { return e.err.Error() }
+func (e *flagError) Unwrap() error { return e.err }
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("loga", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	top := flags.Int("top", 10, "number of paths to show")
+	jsonOutput := flags.Bool("json", false, "write the report as JSON")
+	if err := flags.Parse(args); err != nil {
+		return &flagError{err: err}
+	}
+	if *top < 0 {
+		return &flagError{err: fmt.Errorf("-top must be non-negative")}
+	}
+	requests := make([]logparse.Request, 0)
+	malformed := 0
+	read := func(name string, source io.Reader) error {
+		scanner := bufio.NewScanner(source)
+		for scanner.Scan() {
+			request, err := logparse.Parse(scanner.Text())
+			if err != nil {
+				malformed++
+				continue
+			}
+			requests = append(requests, request)
+		}
+		if err := scanner.Err(); err != nil {
+			return fmt.Errorf("read %s: %w", name, err)
+		}
+		return nil
+	}
+	files := flags.Args()
+	if len(files) == 0 {
+		if err := read("stdin", os.Stdin); err != nil {
+			return err
+		}
+	} else {
+		for _, name := range files {
+			file, err := os.Open(name)
+			if err != nil {
+				return fmt.Errorf("open %s: %w", name, err)
+			}
+			err = read(name, file)
+			closeErr := file.Close()
+			if err != nil {
+				return err
+			}
+			if closeErr != nil {
+				return fmt.Errorf("close %s: %w", name, closeErr)
+			}
+		}
+	}
+	report := stats.Analyze(requests, malformed, *top)
+	if *jsonOutput {
+		encoder := json.NewEncoder(stdout)
+		encoder.SetIndent("", "  ")
+		return encoder.Encode(report)
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(out io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(out, "Total requests: %d\nMalformed lines: %d\n\nTop paths\n", report.Total, report.Malformed); err != nil {
+		return err
+	}
+	for _, item := range report.TopPaths {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", item.Path, item.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(out, "\nStatus classes"); err != nil {
+		return err
+	}
+	for _, key := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", key, report.StatusClasses[key]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(out, "\nRequest time (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n\n5xx per hour\n", report.P50Millis, report.P95Millis, report.P99Millis); err != nil {
+		return err
+	}
+	hours := make([]string, 0, len(report.FiveXXPerHour))
+	for hour := range report.FiveXXPerHour {
+		hours = append(hours, hour)
+	}
+	sort.Strings(hours)
+	for _, hour := range hours {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", strings.Replace(hour, "T", " ", 1), report.FiveXXPerHour[hour]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
