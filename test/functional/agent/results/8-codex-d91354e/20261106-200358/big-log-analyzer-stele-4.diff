index 0000000..0fd9ec9
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,74 @@
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount records the number of requests for a path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains the aggregate log analysis.
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50Millis     float64        `json:"p50_ms"`
+	P95Millis     float64        `json:"p95_ms"`
+	P99Millis     float64        `json:"p99_ms"`
+	FiveXXPerHour map[string]int `json:"5xx_per_hour"`
+}
+
+// Analyze computes a report from parsed requests and a malformed-line count.
+func Analyze(requests []logparse.Request, malformed, top int) Report {
+	counts := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	durations := make([]float64, 0, len(requests))
+	for _, request := range requests {
+		counts[request.Path]++
+		class := request.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			classes[key]++
+		}
+		if class == 5 {
+			hours[request.Time.Format("2006-01-02T15:00:00Z07:00")]++
+		}
+		durations = append(durations, float64(request.Duration)/float64(time.Millisecond))
+	}
+	sort.Float64s(durations)
+	paths := make([]PathCount, 0, len(counts))
+	for path, count := range counts {
+		paths = append(paths, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(paths, func(i, j int) bool {
+		if paths[i].Count == paths[j].Count {
+			return paths[i].Path < paths[j].Path
+		}
+		return paths[i].Count > paths[j].Count
+	})
+	if top < 0 {
+		top = 0
+	}
+	if top < len(paths) {
+		paths = paths[:top]
+	}
+	return Report{Total: len(requests), Malformed: malformed, TopPaths: paths, StatusClasses: classes,
+		P50Millis: percentile(durations, .50), P95Millis: percentile(durations, .95), P99Millis: percentile(durations, .99), FiveXXPerHour: hours}
+}
+
+func percentile(sorted []float64, p float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	index := int(math.Ceil(float64(len(sorted))*p)) - 1
+	return sorted[index]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..02d104c
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,47 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestAnalyze(t *testing.T) {
+	base := time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC)
+	cases := []struct {
+		name                      string
+		requests                  []logparse.Request
+		top                       int
+		wantTotal                 int
+		wantP50, wantP95, wantP99 float64
+		wantTop                   []PathCount
+		want5xx                   int
+	}{
+		{"empty", nil, 10, 0, 0, 0, 0, []PathCount{}, 0},
+		{"single", []logparse.Request{{Path: "/one", Status: 500, Duration: 25 * time.Millisecond, Time: base}}, 10, 1, 25, 25, 25, []PathCount{{"/one", 1}}, 1},
+		{"percentiles and top limit", []logparse.Request{{Path: "/b", Status: 200, Duration: 10 * time.Millisecond, Time: base}, {Path: "/a", Status: 404, Duration: 20 * time.Millisecond, Time: base}, {Path: "/b", Status: 503, Duration: 30 * time.Millisecond, Time: base}}, 1, 3, 20, 30, 30, []PathCount{{"/b", 2}}, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Analyze(tc.requests, 0, tc.top)
+			if got.Total != tc.wantTotal {
+				t.Errorf("Analyze().Total = %d, want %d", got.Total, tc.wantTotal)
+			}
+			if got.P50Millis != tc.wantP50 || got.P95Millis != tc.wantP95 || got.P99Millis != tc.wantP99 {
+				t.Errorf("Analyze() percentiles = %v/%v/%v, want %v/%v/%v", got.P50Millis, got.P95Millis, got.P99Millis, tc.wantP50, tc.wantP95, tc.wantP99)
+			}
+			if len(got.TopPaths) != len(tc.wantTop) {
+				t.Fatalf("Analyze().TopPaths length = %d, want %d", len(got.TopPaths), len(tc.wantTop))
+			}
+			for i, want := range tc.wantTop {
+				if got.TopPaths[i] != want {
+					t.Errorf("Analyze().TopPaths[%d] = %+v, want %+v", i, got.TopPaths[i], want)
+				}
+			}
+			if got.FiveXXPerHour[base.Format("2006-01-02T15:00:00Z07:00")] != tc.want5xx {
+				t.Errorf("Analyze().FiveXXPerHour = %v, want hourly count %d", got.FiveXXPerHour, tc.want5xx)
+			}
+		})
+	}
+}
