@@ -0,0 +1,43 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	cases := []struct {
+		name    string
+		args    []string
+		want    string
+		wantErr bool
+	}{
+		{"text report", []string{"-top=1"}, "Total requests: 1", false},
+		{"json report", []string{"-json"}, `"total_requests": 1`, false},
+		{"bad flag", []string{"-unknown"}, "", true},
+		{"missing file", []string{"missing.log"}, "", true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if tc.name != "bad flag" && tc.name != "missing file" {
+				path := filepath.Join(t.TempDir(), "access.log")
+				contents := "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /api/items?id=3 HTTP/1.1\" 200 512 \"-\" \"curl/8.0\" 0.042\nmalformed\n"
+				if err := os.WriteFile(path, []byte(contents), 0600); err != nil {
+					t.Fatalf("WriteFile(%q) error = %v", path, err)
+				}
+				tc.args = append(tc.args, path)
+			}
+			var stdout, stderr bytes.Buffer
+			err := run(tc.args, &stdout, &stderr)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("run(%v) error = %v, wantErr %v", tc.args, err, tc.wantErr)
+			}
+			if tc.want != "" && !strings.Contains(stdout.String(), tc.want) {
+				t.Errorf("run(%v) output = %q, want substring %q", tc.args, stdout.String(), tc.want)
+			}
+		})
+	}
+}
