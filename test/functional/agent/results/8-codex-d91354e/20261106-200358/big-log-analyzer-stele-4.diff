+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,41 @@
+package logparse
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, line   string
+		wantPath     string
+		wantStatus   int
+		wantDuration time.Duration
+		wantErr      bool
+	}{
+		{"combined request", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, "/api/items", 200, 42 * time.Millisecond, false},
+		{"empty", "", "", 0, 0, true},
+		{"missing time", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "agent"`, "", 0, 0, true},
+		{"bad status", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" nope 1 "-" "agent" 0.1`, "", 0, 0, true},
+		{"bad timestamp", `203.0.113.9 - - [bad +0000] "GET / HTTP/1.1" 200 1 "-" "agent" 0.1`, "", 0, 0, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("Parse(%q) error = %v, wantErr %v", tc.line, err, tc.wantErr)
+			}
+			if err == nil {
+				if got.Path != tc.wantPath {
+					t.Errorf("Parse(%q).Path = %q, want %q", tc.line, got.Path, tc.wantPath)
+				}
+				if got.Status != tc.wantStatus {
+					t.Errorf("Parse(%q).Status = %d, want %d", tc.line, got.Status, tc.wantStatus)
+				}
+				if got.Duration != tc.wantDuration {
+					t.Errorf("Parse(%q).Duration = %v, want %v", tc.line, got.Duration, tc.wantDuration)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
