+	var output bytes.Buffer
+	err := ExportCSV(&output, []Invoice{{ID: "inv1", Customer: "acme, inc", Region: "FR", IssuedAt: issuedAt, TotalCents: 1200, DiscountCents: 100, TaxCents: 220, GrandTotalCents: 1320}})
+	if err != nil {
+		t.Fatalf("ExportCSV() error = %v, want nil", err)
