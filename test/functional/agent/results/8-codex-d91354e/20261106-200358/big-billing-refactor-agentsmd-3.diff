new file mode 100644
index 0000000..3f28bcd
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,36 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+)
+
+// ExportCSV writes invoice totals and identifying fields as CSV.
+func ExportCSV(writer io.Writer, invoices []Invoice) error {
+	csvWriter := csv.NewWriter(writer)
+	if err := csvWriter.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return fmt.Errorf("write invoice CSV header: %w", err)
+	}
+	for _, invoice := range invoices {
+		record := []string{
+			invoice.ID,
+			invoice.Customer,
+			invoice.Region,
+			invoice.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(invoice.TotalCents, 10),
+			strconv.FormatInt(invoice.DiscountCents, 10),
+			strconv.FormatInt(invoice.TaxCents, 10),
+			strconv.FormatInt(invoice.GrandTotalCents, 10),
+		}
+		if err := csvWriter.Write(record); err != nil {
+			return fmt.Errorf("write invoice CSV record: %w", err)
+		}
+	}
+	csvWriter.Flush()
+	if err := csvWriter.Error(); err != nil {
+		return fmt.Errorf("flush invoice CSV: %w", err)
+	}
+	return nil
+}
