+func TestDiscounts(t *testing.T) {
+	now := time.Date(2026, 11, 6, 12, 0, 0, 0, time.UTC)
+	expired := now.Add(-time.Second)
+	cases := []struct {
+		name     string
+		code     DiscountCode
+		usage    *DiscountUsage
+		customer string
+		total    int64
+		want     int64
+		wantErr  error
+	}{
+		{name: "fixed floor", code: DiscountCode{Code: "SAVE", Kind: DiscountFixed, Value: 90}, usage: NewDiscountUsage(), total: 50, want: 50},
+		{name: "percentage rounds half away", code: DiscountCode{Code: "HALF", Kind: DiscountPercent, Value: 1000}, usage: NewDiscountUsage(), total: 5, want: 1},
+		{name: "expired", code: DiscountCode{Code: "OLD", Kind: DiscountFixed, Value: 1, ExpiresAt: &expired}, usage: NewDiscountUsage(), total: 10, wantErr: ErrDiscountExpired},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inv, err := ComputeWithOptions("inv", "customer", []Line{{Quantity: 1, UnitCents: tc.total}}, Options{Clock: clock.Fixed{T: now}, Discount: &tc.code, DiscountUsage: tc.usage})
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("ComputeWithOptions() error = %v, want %v", err, tc.wantErr)
+			}
+			if err == nil && inv.DiscountCents != tc.want {
+				t.Errorf("ComputeWithOptions() discount = %d, want %d", inv.DiscountCents, tc.want)
+			}
+		})
+	}
+	usage := NewDiscountUsage()
+	code := DiscountCode{Code: "ONCE", Kind: DiscountFixed, Value: 1}
+	options := Options{Clock: clock.Fixed{T: now}, Discount: &code, DiscountUsage: usage}
+	if _, err := ComputeWithOptions("one", "customer", []Line{{Quantity: 1, UnitCents: 10}}, options); err != nil {
+		t.Fatalf("first ComputeWithOptions() error = %v, want nil", err)
+	}
+	if _, err := ComputeWithOptions("two", "customer", []Line{{Quantity: 1, UnitCents: 10}}, options); !errors.Is(err, ErrDiscountUsed) {
+		t.Errorf("second ComputeWithOptions() error = %v, want %v", err, ErrDiscountUsed)
+	}
+}
