index 0000000..ca00b7c
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,20 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrNoCustomer indicates that an invoice has no customer.
+	ErrNoCustomer = errors.New("billing: no customer")
+	// ErrNoClock indicates that computation has no clock dependency.
+	ErrNoClock = errors.New("billing: no clock")
+	// ErrInvalidLine indicates that an invoice line has a negative quantity or price.
+	ErrInvalidLine = errors.New("billing: invalid line")
+	// ErrInvalidDiscount indicates that a discount code is malformed.
+	ErrInvalidDiscount = errors.New("billing: invalid discount")
+	// ErrDiscountExpired indicates that a discount code has expired.
+	ErrDiscountExpired = errors.New("billing: discount expired")
+	// ErrDiscountUsed indicates that a customer already used this code.
+	ErrDiscountUsed = errors.New("billing: discount already used")
+	// ErrInvalidTaxRate indicates that a regional tax rate is negative.
+	ErrInvalidTaxRate = errors.New("billing: invalid tax rate")
+)
