new file mode 100644
index 0000000..9f6c754
--- /dev/null
+++ b/cmd/server/main.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	_ = stdout
+	flags := flag.NewFlagSet("server", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	addr := flags.String("addr", ":8080", "HTTP listen address")
+	if err := flags.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	if flags.NArg() != 0 {
+		return fmt.Errorf("unexpected arguments: %v", flags.Args())
+	}
+
+	store := todo.NewStore(clock.Real{})
+	server := &http.Server{
+		Addr:              *addr,
+		Handler:           api.NewHandler(store),
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       10 * time.Second,
+		WriteTimeout:      15 * time.Second,
+		IdleTimeout:       60 * time.Second,
+	}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	serveErr := make(chan error, 1)
+	go func() { serveErr <- server.ListenAndServe() }()
+	select {
+	case err := <-serveErr:
+		if !errors.Is(err, http.ErrServerClosed) {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	case <-ctx.Done():
+	}
+
+	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := server.Shutdown(shutdownCtx); err != nil {
+		return fmt.Errorf("shut down HTTP server: %w", err)
+	}
+	if err := <-serveErr; err != nil && !errors.Is(err, http.ErrServerClosed) {
+		return fmt.Errorf("serve HTTP: %w", err)
+	}
+	return nil
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..e4850ba
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,171 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+type todoStore interface {
+	Create(context.Context, string) (todo.Todo, error)
+	Get(context.Context, string) (todo.Todo, error)
+	Update(context.Context, string, *string, *bool) (todo.Todo, error)
+	Delete(context.Context, string) error
+	List(context.Context, *bool, int, int) ([]todo.Todo, error)
+}
+
+// NewHandler registers the todo API routes on a method-aware mux.
+func NewHandler(store todoStore) http.Handler {
+	mux := http.NewServeMux()
+	h := handler{store: store}
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return mux
+}
+
+type handler struct{ store todoStore }
+
+func (h handler) create(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Title string `json:"title"`
+	}
+	if !decodeBody(w, r, &body) || len([]rune(strings.TrimSpace(body.Title))) < 1 || len([]rune(strings.TrimSpace(body.Title))) > 200 {
+		Error(w, http.StatusBadRequest, "provide a title between 1 and 200 characters")
+		return
+	}
+	t, err := h.store.Create(r.Context(), body.Title)
+	if err != nil {
+		log.Error("create todo", "err", err)
+		Error(w, http.StatusBadRequest, "provide a valid todo")
+		return
+	}
+	JSON(w, http.StatusCreated, t)
+}
+
+func (h handler) list(w http.ResponseWriter, r *http.Request) {
+	query := r.URL.Query()
+	var done *bool
+	if values, ok := query["done"]; ok {
+		if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+		value := values[0] == "true"
+		done = &value
+	}
+	limit := 20
+	if values, ok := query["limit"]; ok {
+		parsed, err := parseQueryInt(values, "limit")
+		if err != nil || parsed < 1 || parsed > 100 {
+			Error(w, http.StatusBadRequest, "limit must be between 1 and 100")
+			return
+		}
+		limit = parsed
+	}
+	offset := 0
+	if values, ok := query["offset"]; ok {
+		parsed, err := parseQueryInt(values, "offset")
+		if err != nil || parsed < 0 {
+			Error(w, http.StatusBadRequest, "offset must be zero or greater")
+			return
+		}
+		offset = parsed
+	}
+	items, err := h.store.List(r.Context(), done, limit, offset)
+	if err != nil {
+		log.Error("list todos", "err", err)
+		Error(w, http.StatusBadRequest, "provide valid list parameters")
+		return
+	}
+	JSON(w, http.StatusOK, items)
+}
+
+func (h handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.Context(), r.PathValue("id"))
+	if err != nil {
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		log.Error("get todo", "err", err)
+		Error(w, http.StatusBadRequest, "could not get todo")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h handler) update(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Title *string `json:"title"`
+		Done  *bool   `json:"done"`
+	}
+	if !decodeBody(w, r, &body) || (body.Title == nil && body.Done == nil) {
+		Error(w, http.StatusBadRequest, "provide title and/or done")
+		return
+	}
+	t, err := h.store.Update(r.Context(), r.PathValue("id"), body.Title, body.Done)
+	if err != nil {
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		if errors.Is(err, todo.ErrInvalid) {
+			Error(w, http.StatusBadRequest, "provide a valid title")
+			return
+		}
+		log.Error("update todo", "err", err)
+		Error(w, http.StatusBadRequest, "could not update todo")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h handler) delete(w http.ResponseWriter, r *http.Request) {
+	err := h.store.Delete(r.Context(), r.PathValue("id"))
+	if err != nil {
+		if errors.Is(err, todo.ErrNotFound) {
+			Error(w, http.StatusNotFound, "todo not found")
+			return
+		}
+		log.Error("delete todo", "err", err)
+		Error(w, http.StatusBadRequest, "could not delete todo")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, target any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return false
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return false
+	}
+	return true
+}
+
+func parseQueryInt(values []string, name string) (int, error) {
+	if len(values) != 1 {
+		return 0, fmt.Errorf("%s must appear once", name)
+	}
+	value, err := strconv.Atoi(values[0])
+	if err != nil {
+		return 0, fmt.Errorf("invalid %s %q: %w", name, values[0], err)
+	}
+	return value, nil
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..06c2ed5
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,130 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	store := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	handler := NewHandler(store)
+	cases := []struct {
+		name   string
+		method string
+		path   string
+		body   string
+		status int
+	}{
+		{name: "create", method: http.MethodPost, path: "/todos", body: `{"title":"  buy milk "}`, status: http.StatusCreated},
+		{name: "reject empty title", method: http.MethodPost, path: "/todos", body: `{"title":"  "}`, status: http.StatusBadRequest},
+		{name: "reject missing title", method: http.MethodPost, path: "/todos", body: `{}`, status: http.StatusBadRequest},
+		{name: "reject unknown field", method: http.MethodPost, path: "/todos", body: `{"title":"ok","other":1}`, status: http.StatusBadRequest},
+		{name: "reject malformed JSON", method: http.MethodPost, path: "/todos", body: `{`, status: http.StatusBadRequest},
+		{name: "list", method: http.MethodGet, path: "/todos?limit=1&offset=0", status: http.StatusOK},
+		{name: "list done filter", method: http.MethodGet, path: "/todos?done=false", status: http.StatusOK},
+		{name: "invalid done", method: http.MethodGet, path: "/todos?done=yes", status: http.StatusBadRequest},
+		{name: "invalid limit", method: http.MethodGet, path: "/todos?limit=101", status: http.StatusBadRequest},
+		{name: "invalid limit input", method: http.MethodGet, path: "/todos?limit=no", status: http.StatusBadRequest},
+		{name: "invalid offset", method: http.MethodGet, path: "/todos?offset=-1", status: http.StatusBadRequest},
+		{name: "get missing", method: http.MethodGet, path: "/todos/missing", status: http.StatusNotFound},
+		{name: "update missing", method: http.MethodPatch, path: "/todos/missing", body: `{"done":true}`, status: http.StatusNotFound},
+		{name: "update missing fields", method: http.MethodPatch, path: "/todos/missing", body: `{}`, status: http.StatusBadRequest},
+		{name: "delete missing", method: http.MethodDelete, path: "/todos/missing", status: http.StatusNotFound},
+	}
+	var createdID string
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(tc.method, tc.path, strings.NewReader(tc.body))
+			handler.ServeHTTP(recorder, request)
+			if recorder.Code != tc.status {
+				t.Errorf("%s %s status = %d, want %d; body=%s", tc.method, tc.path, recorder.Code, tc.status, recorder.Body.String())
+			}
+			if tc.status == http.StatusBadRequest || tc.status == http.StatusNotFound {
+				var envelope map[string]string
+				if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil || envelope["error"] == "" {
+					t.Errorf("%s %s error body = %q, %v, want JSON error envelope", tc.method, tc.path, recorder.Body.String(), err)
+				}
+			}
+			if tc.name == "create" {
+				var got todo.Todo
+				if err := json.Unmarshal(recorder.Body.Bytes(), &got); err != nil {
+					t.Fatalf("create response decode error = %v, want nil", err)
+				}
+				createdID = got.ID
+				if got.Title != "buy milk" || createdID == "" || got.CreatedAt.IsZero() || got.UpdatedAt.IsZero() {
+					t.Errorf("create response = %+v, want trimmed todo with timestamps", got)
+				}
+			}
+		})
+	}
+
+	for _, tc := range []struct {
+		name   string
+		method string
+		body   string
+		status int
+	}{
+		{name: "get", method: http.MethodGet, status: http.StatusOK},
+		{name: "patch title and done", method: http.MethodPatch, body: `{"title":"updated","done":true}`, status: http.StatusOK},
+		{name: "patch invalid title", method: http.MethodPatch, body: `{"title":" "}`, status: http.StatusBadRequest},
+		{name: "patch unknown field", method: http.MethodPatch, body: `{"done":false,"unknown":true}`, status: http.StatusBadRequest},
+		{name: "delete", method: http.MethodDelete, status: http.StatusNoContent},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			request := httptest.NewRequest(tc.method, "/todos/"+createdID, strings.NewReader(tc.body))
+			recorder := httptest.NewRecorder()
+			handler.ServeHTTP(recorder, request)
+			if recorder.Code != tc.status {
+				t.Errorf("%s /todos/{id} status = %d, want %d; body=%s", tc.method, recorder.Code, tc.status, recorder.Body.String())
+			}
+			if tc.name == "patch title and done" {
+				var got todo.Todo
+				if err := json.Unmarshal(recorder.Body.Bytes(), &got); err != nil || got.Title != "updated" || !got.Done {
+					t.Errorf("PATCH response = %+v, decode error %v, want updated done todo", got, err)
+				}
+			}
+			if tc.status == http.StatusBadRequest {
+				if !bytes.Contains(recorder.Body.Bytes(), []byte(`"error"`)) {
+					t.Errorf("PATCH error body = %q, want JSON error envelope", recorder.Body.String())
+				}
+			}
+			if tc.status == http.StatusNoContent && recorder.Body.Len() != 0 {
+				t.Errorf("DELETE response body = %q, want empty body", recorder.Body.String())
+			}
+		})
+	}
+	if _, err := store.Get(context.Background(), createdID); err == nil {
+		t.Errorf("Get(%q) after DELETE error = nil, want not found", createdID)
+	}
+}
+
+func TestTodoBodySizeLimit(t *testing.T) {
+	handler := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+	body := `{"title":"` + strings.Repeat("a", 1<<20) + `"}`
+	request := httptest.NewRequest(http.MethodPost, "/todos", strings.NewReader(body))
+	recorder := httptest.NewRecorder()
+	handler.ServeHTTP(recorder, request)
+	if recorder.Code != http.StatusBadRequest {
+		t.Errorf("POST oversized body status = %d, want %d", recorder.Code, http.StatusBadRequest)
+	}
+}
+
+func TestTodoWrongMethod(t *testing.T) {
+	handler := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+	request := httptest.NewRequest(http.MethodPut, "/todos", bytes.NewBufferString(`{}`))
+	recorder := httptest.NewRecorder()
+	handler.ServeHTTP(recorder, request)
+	if recorder.Code != http.StatusMethodNotAllowed {
+		t.Errorf("PUT /todos status = %d, want %d", recorder.Code, http.StatusMethodNotAllowed)
+	}
+}
