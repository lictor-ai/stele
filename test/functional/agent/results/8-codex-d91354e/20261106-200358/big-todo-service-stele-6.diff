diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..347724d
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,147 @@
+// Package todo provides concurrent in-memory todo storage.
+package todo
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a task and its creation and update times.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store holds todos in memory. The mutex guards todos.
+type Store struct {
+	mu    sync.RWMutex
+	todos map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates an empty store that uses c for timestamps.
+func NewStore(c clock.Clock) *Store {
+	return &Store{todos: make(map[string]Todo), clock: c}
+}
+
+// Create adds a todo with the given title.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("create todo: %w", err)
+	}
+	title = strings.TrimSpace(title)
+	if len([]rune(title)) < 1 || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.todos[t.ID] = t
+	s.mu.Unlock()
+	return t, nil
+}
+
+// Get returns a todo by id.
+func (s *Store) Get(ctx context.Context, id string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("get todo: %w", err)
+	}
+	s.mu.RLock()
+	t, ok := s.todos[id]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Update changes the provided title and/or done value.
+func (s *Store) Update(ctx context.Context, id string, title *string, done *bool) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("update todo: %w", err)
+	}
+	if title == nil && done == nil {
+		return Todo{}, ErrInvalid
+	}
+	newTitle := ""
+	if title != nil {
+		newTitle = strings.TrimSpace(*title)
+		if len([]rune(newTitle)) < 1 || len([]rune(newTitle)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+	}
+	s.mu.Lock()
+	t, ok := s.todos[id]
+	if ok {
+		if title != nil {
+			t.Title = newTitle
+		}
+		if done != nil {
+			t.Done = *done
+		}
+		t.UpdatedAt = s.clock.Now()
+		s.todos[id] = t
+	}
+	s.mu.Unlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return t, nil
+}
+
+// Delete removes a todo by id.
+func (s *Store) Delete(ctx context.Context, id string) error {
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("delete todo: %w", err)
+	}
+	s.mu.Lock()
+	_, ok := s.todos[id]
+	delete(s.todos, id)
+	s.mu.Unlock()
+	if !ok {
+		return ErrNotFound
+	}
+	return nil
+}
+
+// List returns todos newest first with optional done filtering and pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("list todos: %w", err)
+	}
+	if limit < 1 || offset < 0 {
+		return nil, ErrInvalid
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.todos))
+	for _, t := range s.todos {
+		if done == nil || t.Done == *done {
+			items = append(items, t)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt.Equal(items[j].CreatedAt) {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt.After(items[j].CreatedAt)
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if len(items) > limit {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..ddfd0fa
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,143 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+type incrementClock struct {
+	mu sync.RWMutex
+	t  time.Time
+}
+
+func (c *incrementClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.t = c.t.Add(time.Second)
+	return c.t
+}
+
+func TestStoreOperations(t *testing.T) {
+	store := NewStore(&incrementClock{t: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	ctx := context.Background()
+	cases := []struct {
+		name  string
+		title string
+		valid bool
+	}{
+		{name: "trim title", title: "  first  ", valid: true},
+		{name: "empty title", title: "   ", valid: false},
+		{name: "too long", title: string(make([]byte, 201)), valid: false},
+	}
+	created := make([]Todo, 0, 2)
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := store.Create(ctx, tc.title)
+			if !tc.valid {
+				if !errors.Is(err, ErrInvalid) {
+					t.Errorf("Create(%q) error = %v, want %v", tc.title, err, ErrInvalid)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Create(%q) error = %v, want nil", tc.title, err)
+			}
+			created = append(created, got)
+		})
+	}
+	if len(created) != 1 || created[0].Title != "first" || created[0].ID == "" {
+		t.Fatalf("created todos = %+v, want one trimmed todo with an id", created)
+	}
+	first := created[0]
+	done := true
+	updated, err := store.Update(ctx, first.ID, nil, &done)
+	if err != nil || !updated.Done || !updated.UpdatedAt.After(first.UpdatedAt) {
+		t.Errorf("Update(%q) = %+v, %v, want done todo with newer timestamp", first.ID, updated, err)
+	}
+	second, err := store.Create(ctx, "second")
+	if err != nil {
+		t.Fatalf("Create(second) error = %v, want nil", err)
+	}
+	filtered, err := store.List(ctx, &done, 1, 0)
+	if err != nil || len(filtered) != 1 || filtered[0].ID != first.ID {
+		t.Errorf("List(done=true, limit=1) = %+v, %v, want updated todo", filtered, err)
+	}
+	page, err := store.List(ctx, nil, 1, 1)
+	if err != nil || len(page) != 1 || page[0].ID != first.ID {
+		t.Errorf("List(limit=1, offset=1) = %+v, %v, want older todo", page, err)
+	}
+	if got, err := store.Get(ctx, second.ID); err != nil || got.Title != "second" {
+		t.Errorf("Get(%q) = %+v, %v, want second todo", second.ID, got, err)
+	}
+	if err := store.Delete(ctx, second.ID); err != nil {
+		t.Errorf("Delete(%q) error = %v, want nil", second.ID, err)
+	}
+	if _, err := store.Get(ctx, second.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(deleted id) error = %v, want %v", err, ErrNotFound)
+	}
+	if _, err := store.Update(ctx, first.ID, nil, nil); !errors.Is(err, ErrInvalid) {
+		t.Errorf("Update(with no fields) error = %v, want %v", err, ErrInvalid)
+	}
+	if err := store.Delete(ctx, "missing"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Delete(missing) error = %v, want %v", err, ErrNotFound)
+	}
+	if _, err := store.List(ctx, nil, 0, 0); !errors.Is(err, ErrInvalid) {
+		t.Errorf("List(limit=0) error = %v, want %v", err, ErrInvalid)
+	}
+	if _, err := store.List(ctx, nil, 1, -1); !errors.Is(err, ErrInvalid) {
+		t.Errorf("List(offset=-1) error = %v, want %v", err, ErrInvalid)
+	}
+	if _, err := store.List(ctx, nil, 1, 20); err != nil {
+		t.Errorf("List(offset past end) error = %v, want nil", err)
+	}
+	if _, err := store.Get(ctx, "missing"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(missing) error = %v, want %v", err, ErrNotFound)
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+	ctx := context.Background()
+	const workers = 32
+	var wg sync.WaitGroup
+	errs := make(chan error, workers)
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func(index int) {
+			defer wg.Done()
+			task, err := store.Create(ctx, fmt.Sprintf("task %d", index))
+			if err != nil {
+				errs <- fmt.Errorf("Create(%d): %w", index, err)
+				return
+			}
+			if _, err := store.Get(ctx, task.ID); err != nil {
+				errs <- fmt.Errorf("Get(%q): %w", task.ID, err)
+			}
+			done := true
+			if _, err := store.Update(ctx, task.ID, nil, &done); err != nil {
+				errs <- fmt.Errorf("Update(%q): %w", task.ID, err)
+			}
+			if _, err := store.List(ctx, &done, 10, 0); err != nil {
+				errs <- fmt.Errorf("List: %w", err)
+			}
+			if err := store.Delete(ctx, task.ID); err != nil {
+				errs <- fmt.Errorf("Delete(%q): %w", task.ID, err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		t.Errorf("concurrent store operation error = %v, want nil", err)
+	}
+	items, err := store.List(ctx, nil, 100, 0)
+	if err != nil || len(items) != 0 {
+		t.Errorf("List after concurrent deletes = %d items, %v, want zero items", len(items), err)
+	}
+}
