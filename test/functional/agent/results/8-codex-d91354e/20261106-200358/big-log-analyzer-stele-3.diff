index 0000000..73a55e9
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,80 @@
+// Package stats aggregates parsed access log requests.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount pairs a request path with its count.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains the complete log summary.
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50MS         float64        `json:"p50_ms"`
+	P95MS         float64        `json:"p95_ms"`
+	P99MS         float64        `json:"p99_ms"`
+	ErrorsPerHour map[string]int `json:"errors_per_hour"`
+}
+
+// Aggregate builds a report from requests and the malformed line count.
+func Aggregate(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	paths := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	durations := make([]float64, 0, len(requests))
+	for _, request := range requests {
+		paths[request.Path]++
+		class := request.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			classes[key]++
+		}
+		durations = append(durations, request.Seconds*1000)
+		if class == 5 {
+			hours[request.Time.Format("2006-01-02T15:00:00Z07:00")]++
+		}
+	}
+	pathCounts := make([]PathCount, 0, len(paths))
+	for path, count := range paths {
+		pathCounts = append(pathCounts, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(pathCounts, func(i, j int) bool {
+		if pathCounts[i].Count == pathCounts[j].Count {
+			return pathCounts[i].Path < pathCounts[j].Path
+		}
+		return pathCounts[i].Count > pathCounts[j].Count
+	})
+	if len(pathCounts) > top {
+		pathCounts = pathCounts[:top]
+	}
+	sort.Float64s(durations)
+	return Report{Total: len(requests), Malformed: malformed, TopPaths: pathCounts, StatusClasses: classes, P50MS: percentile(durations, .50), P95MS: percentile(durations, .95), P99MS: percentile(durations, .99), ErrorsPerHour: hours}
+}
+
+func percentile(values []float64, p float64) float64 {
+	if len(values) == 0 {
+		return 0
+	}
+	index := int(math.Ceil(p*float64(len(values)))) - 1
+	if index < 0 {
+		index = 0
+	}
+	return values[index]
+}
+
+// HourKey returns the UTC hour key used for hourly error counts.
+func HourKey(t time.Time) string { return t.Format("2006-01-02T15:00:00Z07:00") }
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..d3e4444
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,39 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestAggregate(t *testing.T) {
+	timeA := time.Date(2026, 10, 10, 13, 10, 0, 0, time.UTC)
+	cases := []struct {
+		name                                                   string
+		requests                                               []logparse.Request
+		malformed, top                                         int
+		wantTotal, wantTop, wantP50, wantP95, wantP99, want5xx int
+	}{
+		{"empty", nil, 0, 10, 0, 0, 0, 0, 0, 0},
+		{"single", []logparse.Request{{Path: "/one", Status: 200, Seconds: .25, Time: timeA}}, 2, 10, 1, 1, 250, 250, 250, 0},
+		{"percentile edges and top limit", []logparse.Request{{Path: "/b", Status: 200, Seconds: 1, Time: timeA}, {Path: "/a", Status: 500, Seconds: 2, Time: timeA}, {Path: "/a", Status: 404, Seconds: 3, Time: timeA}, {Path: "/c", Status: 301, Seconds: 4, Time: timeA}}, 1, 2, 4, 2, 2000, 4000, 4000, 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Aggregate(tc.requests, tc.malformed, tc.top)
+			if got.Total != tc.wantTotal || got.Malformed != tc.malformed {
+				t.Errorf("Aggregate totals = (%d,%d), want (%d,%d)", got.Total, got.Malformed, tc.wantTotal, tc.malformed)
+			}
+			if len(got.TopPaths) != tc.wantTop {
+				t.Errorf("Aggregate top path count = %d, want %d", len(got.TopPaths), tc.wantTop)
+			}
+			if got.P50MS != float64(tc.wantP50) || got.P95MS != float64(tc.wantP95) || got.P99MS != float64(tc.wantP99) {
+				t.Errorf("Aggregate percentiles = (%v,%v,%v), want (%d,%d,%d)", got.P50MS, got.P95MS, got.P99MS, tc.wantP50, tc.wantP95, tc.wantP99)
+			}
+			if got.StatusClasses["5xx"] != tc.want5xx {
+				t.Errorf("Aggregate 5xx = %d, want %d", got.StatusClasses["5xx"], tc.want5xx)
+			}
+		})
+	}
+}
