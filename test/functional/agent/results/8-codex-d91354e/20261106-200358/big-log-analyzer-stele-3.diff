@@ -0,0 +1,43 @@
+package main
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "access.log")
+	contents := "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /api/items?id=3 HTTP/1.1\" 500 512 \"-\" \"curl/8.0\" 0.042\ninvalid line\n"
+	if err := os.WriteFile(path, []byte(contents), 0600); err != nil {
+		t.Fatalf("WriteFile(%q) error = %v", path, err)
+	}
+	cases := []struct {
+		name         string
+		args         []string
+		wantContains []string
+		wantError    bool
+	}{
+		{"text report", []string{"-top", "1", path}, []string{"Total requests: 1", "Malformed lines: 1", "/api/items", "5xx\t1"}, false},
+		{"json report", []string{"-json", path}, []string{`"total_requests":1`, `"malformed_lines":1`, `"path":"/api/items"`}, false},
+		{"bad flag", []string{"-unknown"}, nil, true},
+		{"missing file", []string{filepath.Join(dir, "missing")}, nil, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			err := run(tc.args, &stdout, &stderr)
+			if (err != nil) != tc.wantError {
+				t.Fatalf("run(%v) error = %v, want error %t", tc.args, err, tc.wantError)
+			}
+			for _, want := range tc.wantContains {
+				if !strings.Contains(stdout.String(), want) {
+					t.Errorf("run(%v) output %q does not contain %q", tc.args, stdout.String(), want)
+				}
+			}
+		})
+	}
+}
diff --git a/internal/logparse/parse.go b/internal/logparse/parse.go
new file mode 100644
index 0000000..1082d4a
--- /dev/null
+++ b/internal/logparse/parse.go
@@ -0,0 +1,94 @@
+// Package logparse parses nginx combined access log records with request times.
+package logparse
+
+import (
+	"fmt"
+	"math"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is one parsed access log record.
+type Request struct {
+	Path    string
+	Status  int
+	Seconds float64
+	Time    time.Time
+}
+
+// Parse parses one combined-format access log line with a trailing duration in seconds.
+func Parse(line string) (Request, error) {
+	var out Request
+	fields, tokenErr := splitFields(line)
+	if tokenErr != nil {
+		return out, tokenErr
+	}
+	if len(fields) < 10 {
+		return out, fmt.Errorf("parse access log: expected at least 10 fields, got %d", len(fields))
+	}
+	stamp := strings.Trim(fields[3], "[]")
+	parsedTime, err := time.Parse("02/Jan/2006:15:04:05 -0700", stamp)
+	if err != nil {
+		return out, fmt.Errorf("parse request time %q: %w", stamp, err)
+	}
+	requestParts := strings.Fields(strings.Trim(fields[4], "\""))
+	if len(requestParts) != 3 {
+		return out, fmt.Errorf("parse request: malformed quoted request")
+	}
+	target := requestParts[1]
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return out, fmt.Errorf("parse status %q: invalid status", fields[5])
+	}
+	duration, err := strconv.ParseFloat(fields[len(fields)-1], 64)
+	if err != nil || duration < 0 || math.IsNaN(duration) || math.IsInf(duration, 0) {
+		return out, fmt.Errorf("parse request time %q: invalid duration", fields[len(fields)-1])
+	}
+	path := target
+	if parsed, err := url.ParseRequestURI(target); err == nil && parsed.Path != "" {
+		path = parsed.Path
+	}
+	if i := strings.IndexByte(path, '?'); i >= 0 {
+		path = path[:i]
+	}
+	if path == "" {
+		path = "/"
+	}
+	out = Request{Path: path, Status: status, Seconds: duration, Time: parsedTime}
+	return out, nil
+}
+
+func splitFields(line string) ([]string, error) {
+	var fields []string
+	for i := 0; i < len(line); {
+		for i < len(line) && (line[i] == ' ' || line[i] == '\t') {
+			i++
+		}
+		if i == len(line) {
+			break
+		}
+		start := i
+		if line[i] == '"' || line[i] == '[' {
+			end := byte('"')
+			if line[i] == '[' {
+				end = ']'
+			}
+			i++
+			for i < len(line) && line[i] != end {
+				i++
+			}
+			if i == len(line) {
+				return nil, fmt.Errorf("parse access log: unterminated quoted field")
+			}
+			i++
+		} else {
+			for i < len(line) && line[i] != ' ' && line[i] != '\t' {
+				i++
+			}
+		}
+		fields = append(fields, line[start:i])
+	}
+	return fields, nil
+}
diff --git a/internal/logparse/parse_test.go b/internal/logparse/parse_test.go
new file mode 100644
index 0000000..5ce6624
--- /dev/null
+++ b/internal/logparse/parse_test.go
@@ -0,0 +1,32 @@
+package logparse
+
+import "testing"
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, line  string
+		wantPath    string
+		wantStatus  int
+		wantSeconds float64
+		wantErr     bool
+	}{
+		{"valid with query and spaced agent", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl agent/8.0 test" 0.042`, "/api/items", 200, .042, false},
+		{"empty", "", "", 0, 0, true},
+		{"missing duration", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "agent"`, "", 0, 0, true},
+		{"bad date", `203.0.113.9 - - [bad] "GET / HTTP/1.1" 200 1 "-" "agent" 0.1`, "", 0, 0, true},
+		{"bad status", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" nope 1 "-" "agent" 0.1`, "", 0, 0, true},
+		{"bad duration", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "agent" NaN`, "", 0, 0, true},
+		{"unterminated field", `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 200 1 "-" "agent" 0.1`, "", 0, 0, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("Parse(%q) error = %v, want error %t", tc.line, err, tc.wantErr)
+			}
+			if err == nil && (got.Path != tc.wantPath || got.Status != tc.wantStatus || got.Seconds != tc.wantSeconds) {
+				t.Errorf("Parse(%q) = %+v, want path=%q status=%d seconds=%v", tc.line, got, tc.wantPath, tc.wantStatus, tc.wantSeconds)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
