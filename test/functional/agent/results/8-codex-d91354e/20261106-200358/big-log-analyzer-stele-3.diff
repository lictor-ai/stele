diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..4cbaacf
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,119 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		var flags *flagError
+		if errors.As(err, &flags) {
+			os.Exit(2)
+		}
+		os.Exit(1)
+	}
+}
+
+func readLog(reader io.Reader, requests *[]logparse.Request, malformed *int) error {
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+	for scanner.Scan() {
+		request, err := logparse.Parse(scanner.Text())
+		if err != nil {
+			*malformed++
+			continue
+		}
+		*requests = append(*requests, request)
+	}
+	return scanner.Err()
+}
+
+func writeText(w io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", report.Total, report.Malformed); err != nil {
+		return err
+	}
+	for _, path := range report.TopPaths {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", path.Path, path.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(w, "\nStatus classes\nCLASS\tCOUNT"); err != nil {
+		return err
+	}
+	for _, class := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", class, report.StatusClasses[class]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(w, "\nRequest time (ms)\nP50\t%.3f\nP95\t%.3f\nP99\t%.3f\n\n5xx per hour\nHOUR\tCOUNT\n", report.P50MS, report.P95MS, report.P99MS); err != nil {
+		return err
+	}
+	hours := make([]string, 0, len(report.ErrorsPerHour))
+	for hour := range report.ErrorsPerHour {
+		hours = append(hours, hour)
+	}
+	sort.Strings(hours)
+	for _, hour := range hours {
+		if _, err := fmt.Fprintf(w, "%s\t%d\n", hour, report.ErrorsPerHour[hour]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+type flagError struct{ err error }
+
+func (e *flagError) Error() string { return e.err.Error() }
+func (e *flagError) Unwrap() error { return e.err }
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("loga", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	top := flags.Int("top", 10, "number of paths to show")
+	jsonOutput := flags.Bool("json", false, "write JSON report")
+	if err := flags.Parse(args); err != nil {
+		return &flagError{err: err}
+	}
+	if *top < 0 {
+		return &flagError{err: fmt.Errorf("-top must be non-negative")}
+	}
+	requests := make([]logparse.Request, 0)
+	malformed := 0
+	paths := flags.Args()
+	if len(paths) == 0 {
+		if err := readLog(os.Stdin, &requests, &malformed); err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+	} else {
+		for _, path := range paths {
+			file, err := os.Open(path)
+			if err != nil {
+				return fmt.Errorf("open %s: %w", path, err)
+			}
+			readErr := readLog(file, &requests, &malformed)
+			closeErr := file.Close()
+			if readErr != nil {
+				return fmt.Errorf("read %s: %w", path, readErr)
+			}
+			if closeErr != nil {
+				return fmt.Errorf("close %s: %w", path, closeErr)
+			}
+		}
+	}
+	report := stats.Aggregate(requests, malformed, *top)
+	if *jsonOutput {
+		return json.NewEncoder(stdout).Encode(report)
+	}
+	return writeText(stdout, report)
+}
