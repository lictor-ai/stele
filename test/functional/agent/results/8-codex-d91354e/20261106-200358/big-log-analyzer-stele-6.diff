index 0000000..4ea2e43
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,98 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+var errBadFlags = errors.New("bad flags")
+var errInput = errors.New("input error")
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		if errors.Is(err, errBadFlags) {
+			os.Exit(2)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("loga", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	top := flags.Int("top", 10, "number of paths to show")
+	jsonOutput := flags.Bool("json", false, "write JSON report")
+	if err := flags.Parse(args); err != nil {
+		return fmt.Errorf("%w: %w", errBadFlags, err)
+	}
+	if *top < 0 {
+		return fmt.Errorf("%w: -top must not be negative", errBadFlags)
+	}
+	var requests []logparse.Request
+	malformed := 0
+	paths := flags.Args()
+	if len(paths) == 0 {
+		parsed, bad, err := logparse.Parse(context.Background(), os.Stdin)
+		if err != nil {
+			return fmt.Errorf("%w: read stdin: %w", errInput, err)
+		}
+		requests, malformed = parsed, bad
+	} else {
+		for _, path := range paths {
+			file, err := os.Open(path)
+			if err != nil {
+				return fmt.Errorf("%w: open %s: %w", errInput, path, err)
+			}
+			parsed, bad, readErr := logparse.Parse(context.Background(), file)
+			closeErr := file.Close()
+			if readErr != nil {
+				return fmt.Errorf("%w: read %s: %w", errInput, path, readErr)
+			}
+			if closeErr != nil {
+				return fmt.Errorf("%w: close %s: %w", errInput, path, closeErr)
+			}
+			requests = append(requests, parsed...)
+			malformed += bad
+		}
+	}
+	report, err := stats.Build(requests, malformed, *top)
+	if err != nil {
+		return err
+	}
+	if *jsonOutput {
+		if err := json.NewEncoder(stdout).Encode(report); err != nil {
+			return fmt.Errorf("write JSON report: %w", err)
+		}
+		return nil
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(out io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(out, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", report.TotalRequests, report.MalformedLines); err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	for _, item := range report.TopPaths {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", item.Path, item.Count); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+	}
+	if _, err := fmt.Fprintf(out, "\nStatus classes\nCLASS\tCOUNT\n2xx\t%d\n3xx\t%d\n4xx\t%d\n5xx\t%d\n\nLatency (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n\n5xx per hour\nHOUR\tCOUNT\n", report.StatusClasses["2xx"], report.StatusClasses["3xx"], report.StatusClasses["4xx"], report.StatusClasses["5xx"], report.P50Milliseconds, report.P95Milliseconds, report.P99Milliseconds); err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	for hour, count := range report.FiveXXPerHour {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", hour, count); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..a329fa6
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,75 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/stats"
+)
+
+func TestRun(t *testing.T) {
+	cases := []struct {
+		name     string
+		args     []string
+		wantErr  error
+		wantJSON bool
+	}{
+		{name: "bad flag", args: []string{"-unknown"}, wantErr: errBadFlags},
+		{name: "negative top", args: []string{"-top", "-1"}, wantErr: errBadFlags},
+		{name: "missing file", args: []string{"missing.log"}, wantErr: errInput},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			err := run(tc.args, &stdout, &stderr)
+			if !errors.Is(err, tc.wantErr) {
+				t.Errorf("run(%v) error = %v, want %v", tc.args, err, tc.wantErr)
+			}
+		})
+	}
+	t.Run("JSON file report", func(t *testing.T) {
+		path := filepath.Join(t.TempDir(), "access.log")
+		line := "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /api/items?id=3 HTTP/1.1\" 503 512 \"-\" \"curl/8.0\" 0.042\n"
+		if err := os.WriteFile(path, []byte(line+"bad line\n"), 0600); err != nil {
+			t.Fatalf("WriteFile(%q) error = %v", path, err)
+		}
+		var stdout, stderr bytes.Buffer
+		if err := run([]string{"-json", path}, &stdout, &stderr); err != nil {
+			t.Fatalf("run(-json %q) error = %v, want nil", path, err)
+		}
+		var got stats.Report
+		if err := json.Unmarshal(stdout.Bytes(), &got); err != nil {
+			t.Fatalf("Unmarshal(%q) error = %v", stdout.String(), err)
+		}
+		if got.TotalRequests != 1 || got.MalformedLines != 1 || len(got.TopPaths) != 1 || got.TopPaths[0].Path != "/api/items" || got.StatusClasses["5xx"] != 1 {
+			t.Errorf("run() report = %+v, want one parsed 5xx request and one malformed line", got)
+		}
+	})
+	t.Run("text stdin report", func(t *testing.T) {
+		previous := os.Stdin
+		reader, writer, err := os.Pipe()
+		if err != nil {
+			t.Fatalf("Pipe() error = %v", err)
+		}
+		if _, err := writer.WriteString("203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET / HTTP/1.1\" 200 1 \"-\" \"curl\" 0.001\n"); err != nil {
+			t.Fatalf("WriteString() error = %v", err)
+		}
+		if err := writer.Close(); err != nil {
+			t.Fatalf("Close() error = %v", err)
+		}
+		os.Stdin = reader
+		t.Cleanup(func() { os.Stdin = previous; reader.Close() })
+		var stdout, stderr bytes.Buffer
+		if err := run(nil, &stdout, &stderr); err != nil {
+			t.Fatalf("run(stdin) error = %v, want nil", err)
+		}
+		if !strings.Contains(stdout.String(), "Total requests: 1") || !strings.Contains(stdout.String(), "p50\t1.000") {
+			t.Errorf("run(stdin) output = %q, want text report", stdout.String())
+		}
+	})
+}
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..72d9d6d
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,104 @@
+// Package logparse parses nginx combined access log records with request times.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is one parsed nginx access log record.
+type Request struct {
+	Path            string
+	Status          int
+	Time            time.Time
+	DurationSeconds float64
+}
+
+// Parse reads log records, returning valid requests and the number of malformed lines.
+func Parse(ctx context.Context, input interface{ Read([]byte) (int, error) }) ([]Request, int, error) {
+	scanner := bufio.NewScanner(input)
+	scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+	requests := make([]Request, 0)
+	malformed := 0
+	for scanner.Scan() {
+		if err := ctx.Err(); err != nil {
+			return nil, malformed, fmt.Errorf("read access logs: %w", err)
+		}
+		req, err := parseLine(scanner.Text())
+		if err != nil {
+			malformed++
+			continue
+		}
+		requests = append(requests, req)
+	}
+	if err := scanner.Err(); err != nil {
+		return nil, malformed, fmt.Errorf("read access logs: %w", err)
+	}
+	return requests, malformed, nil
+}
+
+func parseLine(line string) (Request, error) {
+	fields, err := fields(line)
+	if err != nil || len(fields) != 10 {
+		return Request{}, fmt.Errorf("invalid combined log record")
+	}
+	if len(fields[3]) < 2 || fields[3][0] != '[' || fields[3][len(fields[3])-1] != ']' {
+		return Request{}, fmt.Errorf("invalid timestamp")
+	}
+	stamp, err := time.Parse("02/Jan/2006:15:04:05 -0700", fields[3][1:len(fields[3])-1])
+	if err != nil {
+		return Request{}, fmt.Errorf("invalid timestamp: %w", err)
+	}
+	request := strings.Trim(fields[4], "\"")
+	parts := strings.Fields(request)
+	if len(parts) != 3 || !strings.HasPrefix(parts[1], "/") {
+		return Request{}, fmt.Errorf("invalid request")
+	}
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return Request{}, fmt.Errorf("invalid status")
+	}
+	duration, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || duration < 0 {
+		return Request{}, fmt.Errorf("invalid request time")
+	}
+	path := strings.SplitN(parts[1], "?", 2)[0]
+	return Request{Path: path, Status: status, Time: stamp, DurationSeconds: duration}, nil
+}
+
+func fields(line string) ([]string, error) {
+	var out []string
+	for i := 0; i < len(line); {
+		for i < len(line) && line[i] == ' ' {
+			i++
+		}
+		if i == len(line) {
+			break
+		}
+		start := i
+		if line[i] == '"' || line[i] == '[' {
+			end := byte('"')
+			if line[i] == '[' {
+				end = ']'
+			}
+			i++
+			for i < len(line) && line[i] != end {
+				i++
+			}
+			if i == len(line) {
+				return nil, fmt.Errorf("unterminated field")
+			}
+			i++
+		} else {
+			for i < len(line) && line[i] != ' ' {
+				i++
+			}
+		}
+		out = append(out, line[start:i])
+	}
+	return out, nil
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
