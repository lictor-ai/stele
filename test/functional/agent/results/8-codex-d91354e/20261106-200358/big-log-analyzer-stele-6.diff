index 0000000..e626555
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,37 @@
+package logparse
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, input string
+		requests    int
+		malformed   int
+	}{
+		{name: "empty"},
+		{name: "single", input: "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /api/items?id=3 HTTP/1.1\" 200 512 \"-\" \"curl/8.0\" 0.042", requests: 1},
+		{name: "malformed skipped", input: "bad line\n203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /ok HTTP/1.1\" 200 512 \"-\" \"curl/8.0\" 0.042", requests: 1, malformed: 1},
+		{name: "invalid request time", input: "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET / HTTP/1.1\" 200 10 \"-\" \"curl\" -1", malformed: 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, malformed, err := Parse(context.Background(), strings.NewReader(tc.input))
+			if err != nil {
+				t.Fatalf("Parse() error = %v, want nil", err)
+			}
+			if len(got) != tc.requests {
+				t.Errorf("Parse() requests = %d, want %d", len(got), tc.requests)
+			}
+			if malformed != tc.malformed {
+				t.Errorf("Parse() malformed = %d, want %d", malformed, tc.malformed)
+			}
+			if tc.name == "single" && (got[0].Path != "/api/items" || got[0].Status != 200 || got[0].DurationSeconds != .042) {
+				t.Errorf("Parse() request = %+v, want path /api/items, status 200, time 0.042", got[0])
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..4336863
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,73 @@
+// Package stats builds reports from parsed access log requests.
+package stats
+
+import (
+	"fmt"
+	"sort"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount holds the request count for a path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains request totals, status classes, latency percentiles, and hourly errors.
+type Report struct {
+	TotalRequests   int            `json:"total_requests"`
+	MalformedLines  int            `json:"malformed_lines"`
+	TopPaths        []PathCount    `json:"top_paths"`
+	StatusClasses   map[string]int `json:"status_classes"`
+	P50Milliseconds float64        `json:"p50_ms"`
+	P95Milliseconds float64        `json:"p95_ms"`
+	P99Milliseconds float64        `json:"p99_ms"`
+	FiveXXPerHour   map[string]int `json:"five_xx_per_hour"`
+}
+
+// Build creates a report and limits the path ranking to top paths.
+func Build(requests []logparse.Request, malformed, top int) (Report, error) {
+	if top < 0 {
+		return Report{}, fmt.Errorf("top must not be negative")
+	}
+	report := Report{TotalRequests: len(requests), MalformedLines: malformed, TopPaths: make([]PathCount, 0), StatusClasses: map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}, FiveXXPerHour: make(map[string]int)}
+	counts := make(map[string]int)
+	latencies := make([]float64, 0, len(requests))
+	for _, request := range requests {
+		counts[request.Path]++
+		latencies = append(latencies, request.DurationSeconds*1000)
+		class := request.Status / 100
+		if class >= 2 && class <= 5 {
+			report.StatusClasses[fmt.Sprintf("%dxx", class)]++
+		}
+		if class == 5 {
+			report.FiveXXPerHour[request.Time.Format("2006-01-02T15:00:00Z07:00")]++
+		}
+	}
+	for path, count := range counts {
+		report.TopPaths = append(report.TopPaths, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(report.TopPaths, func(i, j int) bool {
+		if report.TopPaths[i].Count == report.TopPaths[j].Count {
+			return report.TopPaths[i].Path < report.TopPaths[j].Path
+		}
+		return report.TopPaths[i].Count > report.TopPaths[j].Count
+	})
+	if len(report.TopPaths) > top {
+		report.TopPaths = report.TopPaths[:top]
+	}
+	sort.Float64s(latencies)
+	report.P50Milliseconds = percentile(latencies, 50)
+	report.P95Milliseconds = percentile(latencies, 95)
+	report.P99Milliseconds = percentile(latencies, 99)
+	return report, nil
+}
+
+func percentile(sorted []float64, p int) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	index := (p*len(sorted)+99)/100 - 1
+	return sorted[index]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..e6533ef
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,58 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestBuild(t *testing.T) {
+	at := func(hour int) time.Time { return time.Date(2026, 10, 10, hour, 0, 0, 0, time.UTC) }
+	cases := []struct {
+		name                      string
+		requests                  []logparse.Request
+		malformed                 int
+		top                       int
+		wantTotal, wantPaths      int
+		wantP50, wantP95, wantP99 float64
+		want5xx                   int
+	}{
+		{name: "empty", top: 10},
+		{name: "single", requests: []logparse.Request{{Path: "/one", Status: 200, Time: at(13), DurationSeconds: .042}}, malformed: 2, top: 10, wantTotal: 1, wantPaths: 1, wantP50: 42, wantP95: 42, wantP99: 42},
+		{name: "percentile upper rank", requests: []logparse.Request{{Path: "/a", Status: 500, Time: at(13), DurationSeconds: .01}, {Path: "/b", Status: 404, Time: at(13), DurationSeconds: .02}, {Path: "/a", Status: 200, Time: at(14), DurationSeconds: .03}, {Path: "/c", Status: 302, Time: at(13), DurationSeconds: .04}}, top: 2, wantTotal: 4, wantPaths: 2, wantP50: 20, wantP95: 40, wantP99: 40, want5xx: 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Build(tc.requests, tc.malformed, tc.top)
+			if err != nil {
+				t.Fatalf("Build() error = %v, want nil", err)
+			}
+			if got.TotalRequests != tc.wantTotal {
+				t.Errorf("Build() total = %d, want %d", got.TotalRequests, tc.wantTotal)
+			}
+			if len(got.TopPaths) != tc.wantPaths {
+				t.Errorf("Build() paths = %d, want %d", len(got.TopPaths), tc.wantPaths)
+			}
+			if got.P50Milliseconds != tc.wantP50 || got.P95Milliseconds != tc.wantP95 || got.P99Milliseconds != tc.wantP99 {
+				t.Errorf("Build() percentiles = %.1f/%.1f/%.1f, want %.1f/%.1f/%.1f", got.P50Milliseconds, got.P95Milliseconds, got.P99Milliseconds, tc.wantP50, tc.wantP95, tc.wantP99)
+			}
+			if got.StatusClasses["2xx"]+got.StatusClasses["3xx"]+got.StatusClasses["4xx"]+got.StatusClasses["5xx"] != tc.wantTotal {
+				t.Errorf("Build() status classes = %v, want total %d", got.StatusClasses, tc.wantTotal)
+			}
+			total5xx := 0
+			for _, count := range got.FiveXXPerHour {
+				total5xx += count
+			}
+			if total5xx != tc.want5xx {
+				t.Errorf("Build() 5xx hourly total = %d, want %d", total5xx, tc.want5xx)
+			}
+		})
+	}
+}
+
+func TestBuildRejectsNegativeTop(t *testing.T) {
+	if _, err := Build(nil, 0, -1); err == nil {
+		t.Error("Build(nil, 0, -1) error = nil, want error")
+	}
+}
