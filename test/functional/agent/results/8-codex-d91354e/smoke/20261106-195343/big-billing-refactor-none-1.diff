+func TestDiscountExpiryReuseFloorAndRounding(t *testing.T) {
+	nowExpired := time.Now().Add(-time.Hour)
+	expired := &DiscountCode{Code: "old", AmountCents: 50, ExpiresAt: &nowExpired}
+	inv := ComputeWithOptions("1", "alice", []Line{{Quantity: 1, UnitCents: 100}}, Options{Discount: expired})
+	if inv.DiscountCents != 0 {
+		t.Fatalf("expired discount = %d", inv.DiscountCents)
+	}
+
+	code := &DiscountCode{Code: "once", AmountCents: 500}
+	first := ComputeWithOptions("2", "alice", []Line{{Quantity: 1, UnitCents: 100}}, Options{Discount: code})
+	second := ComputeWithOptions("3", "alice", []Line{{Quantity: 1, UnitCents: 100}}, Options{Discount: code})
+	if first.DiscountCents != 100 || first.GrandTotalCents != 0 {
+		t.Fatalf("discount floor: %+v", first)
+	}
+	if second.DiscountCents != 0 {
+		t.Fatalf("reused code discount = %d", second.DiscountCents)
+	}
+
+	percent := &DiscountCode{Code: "round", Percent: 25}
+	rounded := ComputeWithOptions("4", "bob", []Line{{Quantity: 1, UnitCents: 102}}, Options{Discount: percent})
+	if rounded.DiscountCents != 26 {
+		t.Fatalf("rounded percent discount = %d, want 26", rounded.DiscountCents)
+	}
+}
