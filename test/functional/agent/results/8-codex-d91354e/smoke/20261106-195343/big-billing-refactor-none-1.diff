--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,27 @@
+package billing
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+)
+
+// ExportCSV writes invoices with all monetary values represented in cents.
+func ExportCSV(w io.Writer, invoices []Invoice) error {
+	c := csv.NewWriter(w)
+	if err := c.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand total"}); err != nil {
+		return err
+	}
+	for _, inv := range invoices {
+		err := c.Write([]string{
+			inv.ID, inv.Customer, inv.Region, inv.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(inv.TotalCents, 10), strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10), strconv.FormatInt(inv.GrandTotalCents, 10),
+		})
+		if err != nil {
+			return err
+		}
+	}
+	c.Flush()
+	return c.Error()
+}
