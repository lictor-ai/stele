+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,30 @@
+package logparse
+
+import "testing"
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name, line string
+		valid      bool
+		path       string
+		status     int
+	}{
+		{name: "valid query", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, valid: true, path: "/api/items", status: 200},
+		{name: "empty", line: "", valid: false},
+		{name: "bad timestamp", line: `x - - [bad] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`, valid: false},
+		{name: "bad status", line: `x - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" nope 1 "-" "ua" 0.1`, valid: false},
+		{name: "bad duration", line: `x - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" -1`, valid: false},
+		{name: "missing field", line: `x - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200`, valid: false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Parse(tc.line)
+			if (err == nil) != tc.valid {
+				t.Fatalf("Parse(%q) error = %v, valid = %v", tc.line, err, tc.valid)
+			}
+			if tc.valid && (got.Path != tc.path || got.Status != tc.status) {
+				t.Errorf("Parse(%q) = path %q status %d, want %q %d", tc.line, got.Path, got.Status, tc.path, tc.status)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
