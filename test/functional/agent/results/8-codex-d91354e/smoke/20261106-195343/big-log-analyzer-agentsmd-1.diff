index 0000000..7cececa
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,77 @@
+// Package stats aggregates parsed access log requests.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount reports the request count for a path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains the complete analysis result.
+type Report struct {
+	Total         int            `json:"total_requests"`
+	Malformed     int            `json:"malformed_lines"`
+	TopPaths      []PathCount    `json:"top_paths"`
+	StatusClasses map[string]int `json:"status_classes"`
+	P50           float64        `json:"p50_ms"`
+	P95           float64        `json:"p95_ms"`
+	P99           float64        `json:"p99_ms"`
+	ErrorsPerHour map[string]int `json:"5xx_per_hour"`
+}
+
+// Analyze builds a report from requests and a malformed line count.
+func Analyze(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	paths := make(map[string]int)
+	classes := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	durations := make([]float64, 0, len(requests))
+	for _, req := range requests {
+		paths[req.Path]++
+		class := req.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			classes[key]++
+		}
+		if class == 5 {
+			hours[req.Time.Format("2006-01-02T15:00:00Z07:00")]++
+		}
+		durations = append(durations, float64(req.Duration)/float64(time.Millisecond))
+	}
+	counts := make([]PathCount, 0, len(paths))
+	for path, count := range paths {
+		counts = append(counts, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(counts, func(i, j int) bool {
+		if counts[i].Count == counts[j].Count {
+			return counts[i].Path < counts[j].Path
+		}
+		return counts[i].Count > counts[j].Count
+	})
+	if len(counts) > top {
+		counts = counts[:top]
+	}
+	sort.Float64s(durations)
+	return Report{Total: len(requests), Malformed: malformed, TopPaths: counts, StatusClasses: classes, P50: percentile(durations, .50), P95: percentile(durations, .95), P99: percentile(durations, .99), ErrorsPerHour: hours}
+}
+
+func percentile(sorted []float64, p float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	index := int(math.Ceil(float64(len(sorted))*p)) - 1
+	if index < 0 {
+		index = 0
+	}
+	return sorted[index]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..8fc0a79
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,40 @@
+package stats
+
+import (
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestAnalyze(t *testing.T) {
+	cases := []struct {
+		name          string
+		requests      []logparse.Request
+		top           int
+		total         int
+		p50, p95, p99 float64
+		path          string
+	}{
+		{name: "empty", top: 10},
+		{name: "single", requests: []logparse.Request{{Path: "/a", Status: 503, Duration: 42 * time.Millisecond, Time: time.Date(2026, 10, 10, 13, 20, 0, 0, time.UTC)}}, top: 10, total: 1, p50: 42, p95: 42, p99: 42, path: "/a"},
+		{name: "percentiles and limit", requests: []logparse.Request{{Path: "/b", Status: 200, Duration: 10 * time.Millisecond}, {Path: "/a", Status: 404, Duration: 20 * time.Millisecond}, {Path: "/a", Status: 200, Duration: 30 * time.Millisecond}, {Path: "/c", Status: 500, Duration: 40 * time.Millisecond}}, top: 2, total: 4, p50: 20, p95: 40, p99: 40, path: "/a"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := Analyze(tc.requests, 3, tc.top)
+			if got.Total != tc.total || got.Malformed != 3 {
+				t.Errorf("Analyze total/malformed = %d/%d, want %d/3", got.Total, got.Malformed, tc.total)
+			}
+			if got.P50 != tc.p50 || got.P95 != tc.p95 || got.P99 != tc.p99 {
+				t.Errorf("Analyze percentiles = %.0f/%.0f/%.0f, want %.0f/%.0f/%.0f", got.P50, got.P95, got.P99, tc.p50, tc.p95, tc.p99)
+			}
+			if tc.path != "" && (len(got.TopPaths) == 0 || got.TopPaths[0].Path != tc.path) {
+				t.Errorf("Analyze top paths = %v, first path want %q", got.TopPaths, tc.path)
+			}
+			if tc.total == 1 && got.ErrorsPerHour["2026-10-10T13:00:00Z"] != 1 {
+				t.Errorf("Analyze 5xx hours = %v, want one at hour", got.ErrorsPerHour)
+			}
+		})
+	}
+}
