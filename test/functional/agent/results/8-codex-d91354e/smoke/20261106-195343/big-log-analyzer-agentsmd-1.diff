index 0000000..21cc8ee
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,118 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr); err != nil {
+		var flagErr flagError
+		if errors.As(err, &flagErr) {
+			os.Exit(2)
+		}
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+type flagError struct{ err error }
+
+func (e flagError) Error() string { return e.err.Error() }
+func (e flagError) Unwrap() error { return e.err }
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	jsonOutput := fs.Bool("json", false, "write JSON report")
+	if err := fs.Parse(args); err != nil {
+		return flagError{err: err}
+	}
+	if *top < 0 {
+		return flagError{err: fmt.Errorf("-top must be non-negative")}
+	}
+	files := fs.Args()
+	var requests []logparse.Request
+	malformed := 0
+	consume := func(reader io.Reader) error {
+		scanner := bufio.NewScanner(reader)
+		scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+		for scanner.Scan() {
+			req, err := logparse.Parse(scanner.Text())
+			if err != nil {
+				malformed++
+				continue
+			}
+			requests = append(requests, req)
+		}
+		return scanner.Err()
+	}
+	if len(files) == 0 {
+		if err := consume(stdin); err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+	} else {
+		for _, name := range files {
+			file, err := os.Open(name)
+			if err != nil {
+				return fmt.Errorf("read %s: %w", name, err)
+			}
+			readErr := consume(file)
+			err = file.Close()
+			if readErr != nil {
+				return fmt.Errorf("read %s: %w", name, readErr)
+			}
+			if err != nil {
+				return fmt.Errorf("close %s: %w", name, err)
+			}
+		}
+	}
+	report := stats.Analyze(requests, malformed, *top)
+	if *jsonOutput {
+		return json.NewEncoder(stdout).Encode(report)
+	}
+	return writeText(stdout, report)
+}
+
+func writeText(out io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(out, "Total requests: %d\nMalformed lines: %d\n\nTop paths\nPATH\tCOUNT\n", report.Total, report.Malformed); err != nil {
+		return err
+	}
+	for _, item := range report.TopPaths {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", item.Path, item.Count); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintln(out, "\nStatus classes"); err != nil {
+		return err
+	}
+	for _, key := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", key, report.StatusClasses[key]); err != nil {
+			return err
+		}
+	}
+	if _, err := fmt.Fprintf(out, "\nRequest time (ms)\np50\t%.3f\np95\t%.3f\np99\t%.3f\n\n5xx per hour\nHOUR\tCOUNT\n", report.P50, report.P95, report.P99); err != nil {
+		return err
+	}
+	hours := make([]string, 0, len(report.ErrorsPerHour))
+	for hour := range report.ErrorsPerHour {
+		hours = append(hours, hour)
+	}
+	sort.Strings(hours)
+	for _, hour := range hours {
+		if _, err := fmt.Fprintf(out, "%s\t%d\n", hour, report.ErrorsPerHour[hour]); err != nil {
+			return err
+		}
+	}
+	return nil
+}
