index 0000000..66ed9ad
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,86 @@
+// Package logparse parses nginx combined access log records with a request time.
+package logparse
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request is one parsed access log record.
+type Request struct {
+	Path     string
+	Status   int
+	Duration time.Duration
+	Time     time.Time
+}
+
+// Parse parses one combined access log line with a trailing duration in seconds.
+func Parse(line string) (Request, error) {
+	var out Request
+	fields, err := split(line)
+	if err != nil || len(fields) != 10 {
+		return out, fmt.Errorf("invalid combined log record")
+	}
+	stamp := strings.Trim(fields[3], "[]")
+	tm, err := time.Parse("02/Jan/2006:15:04:05 -0700", stamp)
+	if err != nil {
+		return out, fmt.Errorf("invalid timestamp")
+	}
+	request := strings.Trim(fields[4], "\"")
+	parts := strings.Fields(request)
+	if len(parts) != 3 {
+		return out, fmt.Errorf("invalid request")
+	}
+	path := parts[1]
+	if i := strings.IndexByte(path, '?'); i >= 0 {
+		path = path[:i]
+	}
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return out, fmt.Errorf("invalid status")
+	}
+	seconds, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || seconds < 0 {
+		return out, fmt.Errorf("invalid request time")
+	}
+	out = Request{Path: path, Status: status, Duration: time.Duration(seconds * float64(time.Second)), Time: tm}
+	return out, nil
+}
+
+func split(line string) ([]string, error) {
+	var fields []string
+	for i := 0; i < len(line); {
+		for i < len(line) && line[i] == ' ' {
+			i++
+		}
+		if i == len(line) {
+			break
+		}
+		start := i
+		if line[i] == '"' || line[i] == '[' {
+			end := byte('"')
+			if line[i] == '[' {
+				end = ']'
+			}
+			i++
+			for i < len(line) && line[i] != end {
+				if line[i] == '\\' && end == '"' && i+1 < len(line) {
+					i++
+				}
+				i++
+			}
+			if i == len(line) {
+				return nil, fmt.Errorf("unterminated field")
+			}
+			i++
+		} else {
+			for i < len(line) && line[i] != ' ' {
+				i++
+			}
+		}
+		fields = append(fields, line[start:i])
+	}
+	return fields, nil
+}
