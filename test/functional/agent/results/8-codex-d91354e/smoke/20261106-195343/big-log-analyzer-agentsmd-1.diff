@@ -0,0 +1,39 @@
+package main
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	cases := []struct {
+		name     string
+		args     []string
+		input    string
+		want     string
+		badFlags bool
+	}{
+		{name: "text with malformed", input: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042` + "\ninvalid\n", want: "Total requests: 1\nMalformed lines: 1"},
+		{name: "json", args: []string{"-json"}, input: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, want: `"total_requests":1`},
+		{name: "bad flags", args: []string{"-top=-1"}, badFlags: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var out, stderr bytes.Buffer
+			err := run(tc.args, strings.NewReader(tc.input), &out, &stderr)
+			if tc.badFlags {
+				if err == nil {
+					t.Fatal("run() error = nil, want bad flag error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("run() error = %v, want nil", err)
+			}
+			if !strings.Contains(out.String(), tc.want) {
+				t.Errorf("run() output = %q, want it to contain %q", out.String(), tc.want)
+			}
+		})
+	}
+}
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
