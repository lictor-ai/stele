index 0000000..f45eb2b
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,114 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) int {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of paths to show")
+	asJSON := fs.Bool("json", false, "print JSON report")
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	if *top < 0 {
+		fmt.Fprintln(stderr, "-top must not be negative")
+		return 2
+	}
+	files := fs.Args()
+	if len(files) == 0 {
+		files = []string{"-"}
+	}
+	var reqs []logparse.Request
+	malformed := 0
+	for _, name := range files {
+		var rd io.Reader = stdin
+		var f *os.File
+		if name != "-" {
+			var err error
+			f, err = os.Open(name)
+			if err != nil {
+				fmt.Fprintf(stderr, "%s: %v\n", name, err)
+				return 1
+			}
+			rd = f
+		}
+		reader := bufio.NewReader(rd)
+		var err error
+		for {
+			line, readErr := reader.ReadString('\n')
+			if len(line) > 0 {
+				q, parseErr := logparse.Parse(line)
+				if parseErr != nil {
+					malformed++
+				} else {
+					reqs = append(reqs, q)
+				}
+			}
+			if readErr == io.EOF {
+				break
+			}
+			if readErr != nil {
+				err = readErr
+				break
+			}
+		}
+		if f != nil {
+			if closeErr := f.Close(); err == nil {
+				err = closeErr
+			}
+		}
+		if err != nil {
+			fmt.Fprintf(stderr, "%s: %v\n", name, err)
+			return 1
+		}
+	}
+	r := stats.Aggregate(reqs, malformed, *top)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(r); err != nil {
+			fmt.Fprintln(stderr, err)
+			return 1
+		}
+		return 0
+	}
+	printText(stdout, r)
+	return 0
+}
+
+func printText(w io.Writer, r stats.Report) {
+	fmt.Fprintf(w, "Total requests: %d\nMalformed lines: %d\n\nTop paths\n%-40s %s\n", r.Total, r.Malformed, "PATH", "COUNT")
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(w, "%-40s %d\n", p.Path, p.Count)
+	}
+	fmt.Fprintln(w, "\nStatus classes")
+	for _, k := range []string{"2xx", "3xx", "4xx", "5xx"} {
+		fmt.Fprintf(w, "%s %d\n", k, r.StatusClasses[k])
+	}
+	fmt.Fprintf(w, "\nRequest time (ms)\np50 %.3f\np95 %.3f\np99 %.3f\n\n5xx errors per hour\n", r.P50MS, r.P95MS, r.P99MS)
+	for _, k := range sortedKeys(r.ErrorsPerHour) {
+		fmt.Fprintf(w, "%s %d\n", k, r.ErrorsPerHour[k])
+	}
+}
+
+func sortedKeys(m map[string]int) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func main() { os.Exit(run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr)) }
