+++ b/internal/stats/stats_test.go
@@ -0,0 +1,31 @@
+package stats
+
+import (
+	"example.com/app/internal/logparse"
+	"testing"
+	"time"
+)
+
+func TestEmpty(t *testing.T) {
+	r := Aggregate(nil, 3, 10)
+	if r.Total != 0 || r.Malformed != 3 || r.P50MS != 0 || len(r.TopPaths) != 0 {
+		t.Fatalf("%+v", r)
+	}
+}
+func TestSingleAndTop(t *testing.T) {
+	q := logparse.Request{Path: "/x", Status: 503, Duration: .25, Timestamp: time.Date(2026, 10, 10, 13, 22, 0, 0, time.UTC)}
+	r := Aggregate([]logparse.Request{q}, 0, 1)
+	if r.Total != 1 || r.P50MS != 250 || r.P95MS != 250 || r.P99MS != 250 || r.StatusClasses["5xx"] != 1 || r.ErrorsPerHour["2026-10-10T13:00:00Z"] != 1 {
+		t.Fatalf("%+v", r)
+	}
+}
+func TestPercentileNearestRank(t *testing.T) {
+	qs := make([]logparse.Request, 100)
+	for i := range qs {
+		qs[i] = logparse.Request{Path: "/", Status: 200, Duration: float64(i+1) / 1000}
+	}
+	r := Aggregate(qs, 0, 0)
+	if r.P50MS != 50 || r.P95MS != 95 || r.P99MS != 99 {
+		t.Fatalf("percentiles: %v %v %v", r.P50MS, r.P95MS, r.P99MS)
+	}
+}
