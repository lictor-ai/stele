+++ b/internal/todo/store_test.go
@@ -0,0 +1,103 @@
+package todo
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct{ name string }{{name: "create update filter delete"}}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			ctx := context.Background()
+			created, err := s.Create(ctx, "first")
+			if err != nil {
+				t.Fatalf("Create() error = %v", err)
+			}
+			if created.ID == "" || created.Title != "first" || created.Done {
+				t.Fatalf("Create() = %+v, want initialized todo", created)
+			}
+			title, done := "changed", true
+			updated, err := s.Update(ctx, created.ID, &title, &done)
+			if err != nil {
+				t.Fatalf("Update() error = %v", err)
+			}
+			if updated.Title != title || updated.Done != done {
+				t.Errorf("Update() = %+v, want title %q and done %t", updated, title, done)
+			}
+			items, err := s.List(ctx, Filter{Done: &done, Limit: 1})
+			if err != nil {
+				t.Fatalf("List() error = %v", err)
+			}
+			if len(items) != 1 || items[0].ID != created.ID {
+				t.Errorf("List() = %+v, want updated todo", items)
+			}
+			if err := s.Delete(ctx, created.ID); err != nil {
+				t.Fatalf("Delete() error = %v", err)
+			}
+			if _, err := s.Get(ctx, created.ID); err != ErrNotFound {
+				t.Errorf("Get(deleted) error = %v, want %v", err, ErrNotFound)
+			}
+		})
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore(clock.Fixed{T: time.Unix(1, 0)})
+	const workers = 40
+	var wg sync.WaitGroup
+	ids := make(chan string, workers)
+	for i := 0; i < workers; i++ {
+		wg.Add(1)
+		go func(n int) {
+			defer wg.Done()
+			item, err := s.Create(context.Background(), "task")
+			if err != nil {
+				t.Errorf("Create() error = %v", err)
+				return
+			}
+			ids <- item.ID
+			if _, err := s.Get(context.Background(), item.ID); err != nil {
+				t.Errorf("Get(%q) error = %v", item.ID, err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(ids)
+	items, err := s.List(context.Background(), Filter{Limit: workers})
+	if err != nil {
+		t.Fatalf("List() error = %v", err)
+	}
+	if len(items) != workers {
+		t.Fatalf("List() returned %d todos, want %d", len(items), workers)
+	}
+	for id := range ids {
+		if _, err := s.Get(context.Background(), id); err != nil {
+			t.Errorf("Get(%q) error = %v, want nil", id, err)
+		}
+	}
+}
+
+func TestStoreMissingAndInvalid(t *testing.T) {
+	cases := []struct {
+		name      string
+		operation func(*Store) error
+		want      error
+	}{
+		{name: "missing get", operation: func(s *Store) error { _, err := s.Get(context.Background(), "missing"); return err }, want: ErrNotFound},
+		{name: "missing delete", operation: func(s *Store) error { return s.Delete(context.Background(), "missing") }, want: ErrNotFound},
+		{name: "empty update", operation: func(s *Store) error { _, err := s.Update(context.Background(), "missing", nil, nil); return err }, want: ErrInvalid},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := tc.operation(NewStore(clock.Fixed{})); err != tc.want {
+				t.Errorf("operation() error = %v, want %v", err, tc.want)
+			}
+		})
+	}
+}
