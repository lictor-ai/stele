+package api
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	h := NewHandler(todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}))
+	cases := []struct {
+		name, method, path, body string
+		want                     int
+		check                    func(*testing.T, *httptest.ResponseRecorder)
+	}{
+		{name: "create", method: http.MethodPost, path: "/todos", body: `{"title":"  task  "}`, want: http.StatusCreated, check: func(t *testing.T, r *httptest.ResponseRecorder) {
+			var v todo.Todo
+			if err := json.Unmarshal(r.Body.Bytes(), &v); err != nil {
+				t.Fatal(err)
+			}
+			if v.Title != "task" || v.ID == "" {
+				t.Errorf("POST /todos = %+v, want created task", v)
+			}
+		}},
+		{name: "create invalid title", method: http.MethodPost, path: "/todos", body: `{"title":"   "}`, want: http.StatusBadRequest},
+		{name: "create unknown field", method: http.MethodPost, path: "/todos", body: `{"title":"x","extra":1}`, want: http.StatusBadRequest},
+		{name: "create malformed", method: http.MethodPost, path: "/todos", body: `{`, want: http.StatusBadRequest},
+		{name: "list default", method: http.MethodGet, path: "/todos", want: http.StatusOK},
+		{name: "list bad done", method: http.MethodGet, path: "/todos?done=no", want: http.StatusBadRequest},
+		{name: "list bad limit", method: http.MethodGet, path: "/todos?limit=101", want: http.StatusBadRequest},
+		{name: "list bad offset", method: http.MethodGet, path: "/todos?offset=-1", want: http.StatusBadRequest},
+		{name: "get missing", method: http.MethodGet, path: "/todos/missing", want: http.StatusNotFound},
+		{name: "patch missing", method: http.MethodPatch, path: "/todos/missing", body: `{"done":true}`, want: http.StatusNotFound},
+		{name: "patch empty", method: http.MethodPatch, path: "/todos/missing", body: `{}`, want: http.StatusBadRequest},
+		{name: "patch invalid field", method: http.MethodPatch, path: "/todos/missing", body: `{"extra":1}`, want: http.StatusBadRequest},
+		{name: "delete missing", method: http.MethodDelete, path: "/todos/missing", want: http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			req := httptest.NewRequest(tc.method, tc.path, bytes.NewBufferString(tc.body))
+			rec := httptest.NewRecorder()
+			h.ServeHTTP(rec, req)
+			if rec.Code != tc.want {
+				t.Errorf("%s %s status = %d, want %d; body %s", tc.method, tc.path, rec.Code, tc.want, rec.Body.String())
+			}
+			if tc.want >= 400 && rec.Header().Get("Content-Type") != "application/json" {
+				t.Errorf("error content type = %q, want application/json", rec.Header().Get("Content-Type"))
+			}
+			if tc.check != nil {
+				tc.check(t, rec)
+			}
+		})
+	}
+}
+
+func TestTodoRouteLifecycle(t *testing.T) {
+	h := NewHandler(todo.NewStore(clock.Fixed{T: time.Unix(1, 0)}))
+	call := func(method, path, body string) *httptest.ResponseRecorder {
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, httptest.NewRequest(method, path, bytes.NewBufferString(body)))
+		return rec
+	}
+	created := call(http.MethodPost, "/todos", `{"title":"task"}`)
+	var item todo.Todo
+	if err := json.Unmarshal(created.Body.Bytes(), &item); err != nil {
+		t.Fatal(err)
+	}
+	got := call(http.MethodGet, "/todos/"+item.ID, "")
+	if got.Code != http.StatusOK {
+		t.Fatalf("GET /todos/{id} status = %d, want %d", got.Code, http.StatusOK)
+	}
+	patched := call(http.MethodPatch, "/todos/"+item.ID, `{"done":true}`)
+	if patched.Code != http.StatusOK {
+		t.Fatalf("PATCH /todos/{id} status = %d, want %d", patched.Code, http.StatusOK)
+	}
+	filtered := call(http.MethodGet, "/todos?done=true&limit=1&offset=0", "")
+	if filtered.Code != http.StatusOK || !bytes.Contains(filtered.Body.Bytes(), []byte(item.ID)) {
+		t.Errorf("GET filtered todos = %d %s, want item %s", filtered.Code, filtered.Body.String(), item.ID)
+	}
+	del := call(http.MethodDelete, "/todos/"+item.ID, "")
+	if del.Code != http.StatusNoContent {
+		t.Errorf("DELETE /todos/{id} status = %d, want %d", del.Code, http.StatusNoContent)
+	}
+	if after := call(http.MethodGet, "/todos/"+item.ID, ""); after.Code != http.StatusNotFound {
+		t.Errorf("GET deleted todo status = %d, want %d", after.Code, http.StatusNotFound)
+	}
+}
