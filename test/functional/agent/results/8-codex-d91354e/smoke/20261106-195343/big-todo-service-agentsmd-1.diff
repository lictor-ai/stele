@@ -0,0 +1,198 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"example.com/app/internal/todo"
+)
+
+// TodoStore is the storage interface used by the HTTP API.
+type TodoStore interface {
+	Create(context.Context, string) (todo.Todo, error)
+	Get(context.Context, string) (todo.Todo, error)
+	Update(context.Context, string, *string, *bool) (todo.Todo, error)
+	Delete(context.Context, string) error
+	List(context.Context, todo.Filter) ([]todo.Todo, error)
+}
+
+// Handler serves the todo JSON API.
+type Handler struct{ store TodoStore }
+
+// NewHandler creates the API handler.
+func NewHandler(store TodoStore) http.Handler {
+	h := &Handler{store: store}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return mux
+}
+
+func decode(w http.ResponseWriter, r *http.Request, dst any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if err := d.Decode(dst); err != nil {
+		Error(w, http.StatusBadRequest, "invalid JSON request")
+		return false
+	}
+	var extra any
+	if err := d.Decode(&extra); err != io.EOF {
+		Error(w, http.StatusBadRequest, "request must contain one JSON value")
+		return false
+	}
+	return true
+}
+
+func validTitle(v string) (string, bool) {
+	v = strings.TrimSpace(v)
+	return v, len([]rune(v)) >= 1 && len([]rune(v)) <= 200
+}
+
+func (h *Handler) create(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		Title string `json:"title"`
+	}
+	if !decode(w, r, &req) {
+		return
+	}
+	title, ok := validTitle(req.Title)
+	if !ok {
+		Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+		return
+	}
+	t, err := h.store.Create(r.Context(), title)
+	if err != nil {
+		Error(w, http.StatusInternalServerError, "could not create todo")
+		return
+	}
+	JSON(w, http.StatusCreated, t)
+}
+
+func (h *Handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	f := todo.Filter{Limit: 20, Offset: 0}
+	if v, ok := q["done"]; ok {
+		if len(v) != 1 {
+			Error(w, http.StatusBadRequest, "invalid done filter")
+			return
+		}
+		b, err := strconv.ParseBool(v[0])
+		if err != nil {
+			Error(w, http.StatusBadRequest, "invalid done filter")
+			return
+		}
+		f.Done = &b
+	}
+	for key, dst := range map[string]*int{"limit": &f.Limit, "offset": &f.Offset} {
+		if v, ok := q[key]; ok {
+			if len(v) != 1 {
+				Error(w, http.StatusBadRequest, "invalid pagination")
+				return
+			}
+			n, err := strconv.Atoi(v[0])
+			if err != nil {
+				Error(w, http.StatusBadRequest, "invalid pagination")
+				return
+			}
+			*dst = n
+		}
+	}
+	if f.Limit < 1 || f.Limit > 100 || f.Offset < 0 {
+		Error(w, http.StatusBadRequest, "limit must be 1 to 100 and offset must be non-negative")
+		return
+	}
+	items, err := h.store.List(r.Context(), f)
+	if err != nil {
+		Error(w, http.StatusInternalServerError, "could not list todos")
+		return
+	}
+	JSON(w, http.StatusOK, items)
+}
+
+func (h *Handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		Error(w, http.StatusInternalServerError, "could not get todo")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *Handler) update(w http.ResponseWriter, r *http.Request) {
+	var req map[string]json.RawMessage
+	if !decode(w, r, &req) {
+		return
+	}
+	if len(req) == 0 {
+		Error(w, http.StatusBadRequest, "provide title and/or done")
+		return
+	}
+	for k := range req {
+		if k != "title" && k != "done" {
+			Error(w, http.StatusBadRequest, "unknown field")
+			return
+		}
+	}
+	var title *string
+	var done *bool
+	if raw, ok := req["title"]; ok {
+		var v string
+		if err := json.Unmarshal(raw, &v); err != nil {
+			Error(w, http.StatusBadRequest, "title must be a string")
+			return
+		}
+		cleaned, valid := validTitle(v)
+		if !valid {
+			Error(w, http.StatusBadRequest, "title must be 1 to 200 characters")
+			return
+		}
+		title = &cleaned
+	}
+	if raw, ok := req["done"]; ok {
+		var v bool
+		if err := json.Unmarshal(raw, &v); err != nil {
+			Error(w, http.StatusBadRequest, "done must be a boolean")
+			return
+		}
+		done = &v
+	}
+	t, err := h.store.Update(r.Context(), r.PathValue("id"), title, done)
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		Error(w, http.StatusInternalServerError, "could not update todo")
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *Handler) delete(w http.ResponseWriter, r *http.Request) {
+	err := h.store.Delete(r.Context(), r.PathValue("id"))
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	if err != nil {
+		Error(w, http.StatusInternalServerError, "could not delete todo")
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+var _ = fmt.Sprintf
