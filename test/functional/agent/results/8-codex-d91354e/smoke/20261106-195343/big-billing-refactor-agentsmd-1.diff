diff --git a/internal/billing/errors.go b/internal/billing/errors.go
new file mode 100644
index 0000000..a4c2ec2
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,22 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrNoCustomer indicates that an invoice has no customer.
+	ErrNoCustomer = errors.New("billing: no customer")
+	// ErrInvalidLine indicates that an invoice line has a negative value.
+	ErrInvalidLine = errors.New("billing: invalid invoice line")
+	// ErrAmountOverflow indicates that an invoice amount exceeds int64.
+	ErrAmountOverflow = errors.New("billing: amount overflow")
+	// ErrInvalidDiscount indicates that a discount code has invalid terms.
+	ErrInvalidDiscount = errors.New("billing: invalid discount")
+	// ErrDiscountExpired indicates that a discount code has expired.
+	ErrDiscountExpired = errors.New("billing: discount expired")
+	// ErrDiscountReused indicates that a customer already used the discount code.
+	ErrDiscountReused = errors.New("billing: discount already used by customer")
+	// ErrUnknownRegion indicates that no tax rate exists for the invoice region.
+	ErrUnknownRegion = errors.New("billing: unknown tax region")
+	// ErrInvalidTaxRate indicates that a tax rate is outside 0 to 100 percent.
+	ErrInvalidTaxRate = errors.New("billing: invalid tax rate")
+)
diff --git a/internal/billing/export.go b/internal/billing/export.go
new file mode 100644
index 0000000..157ccca
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,32 @@
+package billing
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+)
+
+// ExportCSV writes invoices with amounts expressed in cents to w.
+func ExportCSV(w io.Writer, invoices []Invoice) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return err
+	}
+	for _, invoice := range invoices {
+		record := []string{
+			invoice.ID,
+			invoice.Customer,
+			invoice.Region,
+			invoice.IssuedAt.Format("2006-01-02T15:04:05Z07:00"),
+			strconv.FormatInt(invoice.TotalCents, 10),
+			strconv.FormatInt(invoice.DiscountCents, 10),
+			strconv.FormatInt(invoice.TaxCents, 10),
+			strconv.FormatInt(invoice.GrandTotalCents, 10),
+		}
+		if err := writer.Write(record); err != nil {
+			return err
+		}
+	}
+	writer.Flush()
+	return writer.Error()
+}
