+
+func roundBPS(amount, rate int64) int64 {
+	// Split before multiplying to keep the intermediate value within int64.
+	whole := amount / 10_000 * rate
+	remainder := amount % 10_000 * rate
+	return whole + remainder/10_000 + boolInt(remainder%10_000 >= 5_000)
+}
+
+func boolInt(value bool) int64 {
