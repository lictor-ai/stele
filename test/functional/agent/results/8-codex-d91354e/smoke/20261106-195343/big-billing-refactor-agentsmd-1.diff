+func TestDiscount(t *testing.T) {
+	now := time.Date(2025, time.January, 2, 3, 4, 5, 0, time.UTC)
+	expired := now
+	cases := []struct {
+		name      string
+		code      *DiscountCode
+		customer  string
+		wantOff   int64
+		wantError error
+	}{
+		{name: "percent rounds half away", code: &DiscountCode{Code: "HALF", PercentBPS: 5000}, customer: "a", wantOff: 1},
+		{name: "fixed discount floors at zero", code: &DiscountCode{Code: "BIG", AmountCents: 999}, customer: "a", wantOff: 1},
+		{name: "expired", code: &DiscountCode{Code: "OLD", AmountCents: 1, ExpiresAt: &expired}, customer: "a", wantError: ErrDiscountExpired},
+		{name: "reuse", code: &DiscountCode{Code: "ONCE", AmountCents: 1, UsedBy: map[string]bool{"a": true}}, customer: "a", wantError: ErrDiscountReused},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inv, err := ComputeWithOptions("i", tc.customer, []Line{{Quantity: 1, UnitCents: 1}}, Options{Discount: tc.code, Clock: clock.Fixed{T: now}})
+			if !errors.Is(err, tc.wantError) {
+				t.Fatalf("ComputeWithOptions() error = %v, want %v", err, tc.wantError)
+			}
+			if err == nil && inv.DiscountCents != tc.wantOff {
+				t.Errorf("DiscountCents = %d, want %d", inv.DiscountCents, tc.wantOff)
+			}
+		})
+	}
+}
