+	inv := Invoice{ID: "i1", Customer: "Acme, Inc.", Region: "US-CA", IssuedAt: issued, TotalCents: 1000, DiscountCents: 100, TaxCents: 72, GrandTotalCents: 972}
+	var output bytes.Buffer
+	if err := ExportCSV(&output, []Invoice{inv}); err != nil {
+		t.Fatalf("ExportCSV() error = %v, want nil", err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\ni1,\"Acme, Inc.\",US-CA,2025-01-02T03:04:05Z,1000,100,72,972\n"
+	if got := output.String(); got != want {
