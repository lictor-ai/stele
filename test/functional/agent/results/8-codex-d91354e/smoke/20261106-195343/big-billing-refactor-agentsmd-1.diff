+func validateDiscount(code *DiscountCode) error {
+	if code.Code == "" || code.PercentBPS < 0 || code.AmountCents < 0 ||
+		(code.PercentBPS == 0) == (code.AmountCents == 0) || code.PercentBPS > 10_000 {
+		return ErrInvalidDiscount
+	}
