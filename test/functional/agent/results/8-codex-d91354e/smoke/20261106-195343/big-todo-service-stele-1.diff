+++ b/cmd/server/main.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("server", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	addr := flags.String("addr", ":8080", "listen address")
+	if err := flags.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+	if flags.NArg() != 0 {
+		return fmt.Errorf("unexpected arguments: %v", flags.Args())
+	}
+	_ = stdout
+	store := todo.NewStore(clock.Real{})
+	server := &http.Server{
+		Addr: *addr, Handler: api.NewTodoHandler(store),
+		ReadHeaderTimeout: 5 * time.Second, ReadTimeout: 10 * time.Second,
+		WriteTimeout: 10 * time.Second, IdleTimeout: 60 * time.Second,
+	}
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+	serveErr := make(chan error, 1)
+	go func() { serveErr <- server.ListenAndServe() }()
+	select {
+	case err := <-serveErr:
+		if !errors.Is(err, http.ErrServerClosed) {
+			return fmt.Errorf("serve HTTP: %w", err)
+		}
+		return nil
+	case <-ctx.Done():
+	}
+	shutdownCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	if err := server.Shutdown(shutdownCtx); err != nil {
+		return fmt.Errorf("shut down HTTP server: %w", err)
+	}
+	if err := <-serveErr; !errors.Is(err, http.ErrServerClosed) {
+		return fmt.Errorf("serve HTTP: %w", err)
+	}
+	return nil
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..02c0eb0
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,189 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+// TodoStore defines the storage operations used by the HTTP handler.
+type TodoStore interface {
+	Create(context.Context, string) (todo.Todo, error)
+	Get(context.Context, string) (todo.Todo, error)
+	Update(context.Context, string, todo.Changes) (todo.Todo, error)
+	Delete(context.Context, string) error
+	List(context.Context, *bool, int, int) ([]todo.Todo, error)
+}
+
+// NewTodoHandler creates the todo HTTP handler.
+func NewTodoHandler(store TodoStore) http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", createTodo(store))
+	mux.HandleFunc("GET /todos", listTodos(store))
+	mux.HandleFunc("GET /todos/{id}", getTodo(store))
+	mux.HandleFunc("PATCH /todos/{id}", updateTodo(store))
+	mux.HandleFunc("DELETE /todos/{id}", deleteTodo(store))
+	return mux
+}
+
+func createTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body struct {
+			Title string `json:"title"`
+		}
+		if err := decodeBody(w, r, &body); err != nil || strings.TrimSpace(body.Title) == "" || utf8.RuneCountInString(strings.TrimSpace(body.Title)) > 200 {
+			Error(w, http.StatusBadRequest, "provide a title from 1 to 200 characters")
+			return
+		}
+		item, err := store.Create(r.Context(), body.Title)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusCreated, item)
+	}
+}
+
+func listTodos(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		query := r.URL.Query()
+		var done *bool
+		if values, ok := query["done"]; ok {
+			if len(values) != 1 || (values[0] != "true" && values[0] != "false") {
+				Error(w, http.StatusBadRequest, "done must be true or false")
+				return
+			}
+			value := values[0] == "true"
+			done = &value
+		}
+		limit, err := queryInt(query, "limit", 20)
+		if err != nil || limit < 1 || limit > 100 {
+			Error(w, http.StatusBadRequest, "limit must be from 1 to 100")
+			return
+		}
+		offset, err := queryInt(query, "offset", 0)
+		if err != nil || offset < 0 {
+			Error(w, http.StatusBadRequest, "offset must be zero or greater")
+			return
+		}
+		items, err := store.List(r.Context(), done, limit, offset)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, items)
+	}
+}
+
+func getTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		item, err := store.Get(r.Context(), r.PathValue("id"))
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, item)
+	}
+}
+
+func updateTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]json.RawMessage
+		if err := decodeBody(w, r, &body); err != nil || len(body) == 0 {
+			Error(w, http.StatusBadRequest, "provide title and/or done")
+			return
+		}
+		var changes todo.Changes
+		for key, raw := range body {
+			switch key {
+			case "title":
+				var value string
+				if err := json.Unmarshal(raw, &value); err != nil {
+					Error(w, http.StatusBadRequest, "title must be a string")
+					return
+				}
+				changes.Title = &value
+			case "done":
+				var value bool
+				if err := json.Unmarshal(raw, &value); err != nil {
+					Error(w, http.StatusBadRequest, "done must be a boolean")
+					return
+				}
+				changes.Done = &value
+			default:
+				Error(w, http.StatusBadRequest, "unknown update field")
+				return
+			}
+		}
+		if changes.Title != nil && (strings.TrimSpace(*changes.Title) == "" || utf8.RuneCountInString(strings.TrimSpace(*changes.Title)) > 200) {
+			Error(w, http.StatusBadRequest, "provide a title from 1 to 200 characters")
+			return
+		}
+		item, err := store.Update(r.Context(), r.PathValue("id"), changes)
+		if err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		JSON(w, http.StatusOK, item)
+	}
+}
+
+func deleteTodo(store TodoStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if err := store.Delete(r.Context(), r.PathValue("id")); err != nil {
+			writeStoreError(w, err)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
+
+func decodeBody(w http.ResponseWriter, r *http.Request, target any) error {
+	r.Body = http.MaxBytesReader(w, r.Body, 1<<20)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return fmt.Errorf("decode request: %w", err)
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return fmt.Errorf("decode request trailing data: %w", err)
+	}
+	return nil
+}
+
+func queryInt(query map[string][]string, name string, fallback int) (int, error) {
+	values, ok := query[name]
+	if !ok {
+		return fallback, nil
+	}
+	if len(values) != 1 {
+		return 0, fmt.Errorf("invalid %s: multiple values", name)
+	}
+	value, err := strconv.Atoi(values[0])
+	if err != nil {
+		return 0, fmt.Errorf("invalid %s: %w", name, err)
+	}
+	return value, nil
+}
+
+func writeStoreError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, todo.ErrNotFound):
+		Error(w, http.StatusNotFound, "todo not found")
+	case errors.Is(err, todo.ErrInvalid):
+		Error(w, http.StatusBadRequest, "invalid todo")
+	default:
+		log.Error("todo request failed", "err", err)
+		Error(w, http.StatusInternalServerError, "could not complete todo request")
+	}
+}
