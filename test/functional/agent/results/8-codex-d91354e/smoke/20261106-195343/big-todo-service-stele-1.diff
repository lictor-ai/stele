@@ -0,0 +1,75 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func TestTodoRoutes(t *testing.T) {
+	cases := []struct {
+		name   string
+		method string
+		path   string
+		body   string
+		status int
+	}{
+		{name: "create", method: http.MethodPost, path: "/todos", body: `{"title":" buy milk "}`, status: http.StatusCreated},
+		{name: "create empty title", method: http.MethodPost, path: "/todos", body: `{"title":"  "}`, status: http.StatusBadRequest},
+		{name: "create long title", method: http.MethodPost, path: "/todos", body: `{"title":"` + strings.Repeat("x", 201) + `"}`, status: http.StatusBadRequest},
+		{name: "create malformed json", method: http.MethodPost, path: "/todos", body: `{`, status: http.StatusBadRequest},
+		{name: "create unknown field", method: http.MethodPost, path: "/todos", body: `{"title":"a","other":1}`, status: http.StatusBadRequest},
+		{name: "list", method: http.MethodGet, path: "/todos", status: http.StatusOK},
+		{name: "list filtered and paginated", method: http.MethodGet, path: "/todos?done=false&limit=1&offset=0", status: http.StatusOK},
+		{name: "list invalid done", method: http.MethodGet, path: "/todos?done=yes", status: http.StatusBadRequest},
+		{name: "list invalid limit", method: http.MethodGet, path: "/todos?limit=101", status: http.StatusBadRequest},
+		{name: "list invalid offset", method: http.MethodGet, path: "/todos?offset=-1", status: http.StatusBadRequest},
+		{name: "get", method: http.MethodGet, path: "ITEM", status: http.StatusOK},
+		{name: "get missing", method: http.MethodGet, path: "/todos/missing", status: http.StatusNotFound},
+		{name: "update fields", method: http.MethodPatch, path: "ITEM", body: `{"title":"updated","done":true}`, status: http.StatusOK},
+		{name: "update title only", method: http.MethodPatch, path: "ITEM", body: `{"title":"updated"}`, status: http.StatusOK},
+		{name: "update done only", method: http.MethodPatch, path: "ITEM", body: `{"done":true}`, status: http.StatusOK},
+		{name: "update empty", method: http.MethodPatch, path: "ITEM", body: `{}`, status: http.StatusBadRequest},
+		{name: "update invalid title", method: http.MethodPatch, path: "ITEM", body: `{"title":" "}`, status: http.StatusBadRequest},
+		{name: "update unknown field", method: http.MethodPatch, path: "ITEM", body: `{"other":true}`, status: http.StatusBadRequest},
+		{name: "update malformed", method: http.MethodPatch, path: "ITEM", body: `{`, status: http.StatusBadRequest},
+		{name: "update missing", method: http.MethodPatch, path: "/todos/missing", body: `{"done":true}`, status: http.StatusNotFound},
+		{name: "delete", method: http.MethodDelete, path: "ITEM", status: http.StatusNoContent},
+		{name: "delete missing", method: http.MethodDelete, path: "/todos/missing", status: http.StatusNotFound},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			store := todo.NewStore(clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)})
+			item, err := store.Create(context.Background(), "seed")
+			if err != nil {
+				t.Fatal(err)
+			}
+			path := tc.path
+			if path == "ITEM" {
+				path = "/todos/" + item.ID
+			}
+			recorder := httptest.NewRecorder()
+			request := httptest.NewRequest(tc.method, path, strings.NewReader(tc.body))
+			NewTodoHandler(store).ServeHTTP(recorder, request)
+			if recorder.Code != tc.status {
+				t.Fatalf("%s %s returned %d, want %d: %s", tc.method, path, recorder.Code, tc.status, recorder.Body.String())
+			}
+			if tc.status == http.StatusBadRequest || tc.status == http.StatusNotFound {
+				var envelope map[string]string
+				if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil || envelope["error"] == "" {
+					t.Errorf("error response = %q, %v; want JSON error envelope", recorder.Body.String(), err)
+				}
+			}
+			if tc.status == http.StatusNoContent && recorder.Body.Len() != 0 {
+				t.Errorf("DELETE body = %q, want empty", recorder.Body.String())
+			}
+		})
+	}
+}
