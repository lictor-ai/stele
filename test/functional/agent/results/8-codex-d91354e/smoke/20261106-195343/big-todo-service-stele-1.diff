diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..8803419
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,148 @@
+package todo
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is an item in the todo list.
+type Todo struct {
+	ID        string `json:"id"`
+	Title     string `json:"title"`
+	Done      bool   `json:"done"`
+	CreatedAt string `json:"created_at"`
+	UpdatedAt string `json:"updated_at"`
+}
+
+// Changes contains fields to update. Nil fields are left unchanged.
+type Changes struct {
+	Title *string
+	Done  *bool
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	mu    sync.RWMutex // guards todos
+	todos map[string]Todo
+	clock clock.Clock
+}
+
+// NewStore creates an empty store using the supplied clock.
+func NewStore(c clock.Clock) *Store {
+	return &Store{todos: make(map[string]Todo), clock: c}
+}
+
+// Create adds a todo with a generated identifier.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("create todo: %w", err)
+	}
+	title = strings.TrimSpace(title)
+	if title == "" || len([]rune(title)) > 200 {
+		return Todo{}, ErrInvalid
+	}
+	now := s.clock.Now().UTC().Format("2006-01-02T15:04:05.999999999Z07:00")
+	item := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.todos[item.ID] = item
+	s.mu.Unlock()
+	return item, nil
+}
+
+// Get returns the todo with the given identifier.
+func (s *Store) Get(ctx context.Context, identifier string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("get todo: %w", err)
+	}
+	s.mu.RLock()
+	item, ok := s.todos[identifier]
+	s.mu.RUnlock()
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return item, nil
+}
+
+// Update changes the supplied title and/or done fields.
+func (s *Store) Update(ctx context.Context, identifier string, changes Changes) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("update todo: %w", err)
+	}
+	if changes.Title == nil && changes.Done == nil {
+		return Todo{}, ErrInvalid
+	}
+	if changes.Title != nil {
+		value := strings.TrimSpace(*changes.Title)
+		if value == "" || len([]rune(value)) > 200 {
+			return Todo{}, ErrInvalid
+		}
+		changes.Title = &value
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.todos[identifier]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if changes.Title != nil {
+		item.Title = *changes.Title
+	}
+	if changes.Done != nil {
+		item.Done = *changes.Done
+	}
+	item.UpdatedAt = s.clock.Now().UTC().Format("2006-01-02T15:04:05.999999999Z07:00")
+	s.todos[identifier] = item
+	return item, nil
+}
+
+// Delete removes the todo with the given identifier.
+func (s *Store) Delete(ctx context.Context, identifier string) error {
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("delete todo: %w", err)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.todos[identifier]; !ok {
+		return ErrNotFound
+	}
+	delete(s.todos, identifier)
+	return nil
+}
+
+// List returns todos newest first with an optional done filter and pagination.
+func (s *Store) List(ctx context.Context, done *bool, limit, offset int) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("list todos: %w", err)
+	}
+	if limit < 1 || offset < 0 {
+		return nil, ErrInvalid
+	}
+	s.mu.RLock()
+	items := make([]Todo, 0, len(s.todos))
+	for _, item := range s.todos {
+		if done == nil || item.Done == *done {
+			items = append(items, item)
+		}
+	}
+	s.mu.RUnlock()
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].CreatedAt == items[j].CreatedAt {
+			return items[i].ID > items[j].ID
+		}
+		return items[i].CreatedAt > items[j].CreatedAt
+	})
+	if offset >= len(items) {
+		return []Todo{}, nil
+	}
+	items = items[offset:]
+	if len(items) > limit {
+		items = items[:limit]
+	}
+	return items, nil
+}
diff --git a/internal/todo/store_test.go b/internal/todo/store_test.go
new file mode 100644
index 0000000..4580d43
--- /dev/null
+++ b/internal/todo/store_test.go
@@ -0,0 +1,130 @@
+package todo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+type steppingClock struct {
+	n atomic.Int64
+}
+
+func (c *steppingClock) Now() time.Time {
+	return time.Unix(c.n.Add(1), 0).UTC()
+}
+
+func TestStoreOperations(t *testing.T) {
+	cases := []struct {
+		name string
+		fn   func(*testing.T, *Store)
+	}{
+		{name: "create get update delete and missing", fn: func(t *testing.T, store *Store) {
+			ctx := context.Background()
+			item, err := store.Create(ctx, "  call home  ")
+			if err != nil || item.Title != "call home" || item.ID == "" || item.CreatedAt != item.UpdatedAt {
+				t.Fatalf("Create() = %+v, %v; want trimmed todo", item, err)
+			}
+			got, err := store.Get(ctx, item.ID)
+			if err != nil || got.ID != item.ID {
+				t.Fatalf("Get(%q) = %+v, %v; want created todo", item.ID, got, err)
+			}
+			title, done := "new title", true
+			got, err = store.Update(ctx, item.ID, Changes{Title: &title, Done: &done})
+			if err != nil || got.Title != title || !got.Done {
+				t.Fatalf("Update() = %+v, %v; want changed fields", got, err)
+			}
+			if err := store.Delete(ctx, item.ID); err != nil {
+				t.Fatalf("Delete(%q) = %v, want nil", item.ID, err)
+			}
+			if _, err := store.Get(ctx, item.ID); !errors.Is(err, ErrNotFound) {
+				t.Errorf("Get(%q) error = %v, want ErrNotFound", item.ID, err)
+			}
+		}},
+		{name: "invalid values", fn: func(t *testing.T, store *Store) {
+			for _, title := range []string{"", "  ", string(make([]byte, 201))} {
+				if _, err := store.Create(context.Background(), title); !errors.Is(err, ErrInvalid) {
+					t.Errorf("Create(%q) error = %v, want ErrInvalid", title, err)
+				}
+			}
+			if _, err := store.Update(context.Background(), "x", Changes{}); !errors.Is(err, ErrInvalid) {
+				t.Errorf("Update() error = %v, want ErrInvalid", err)
+			}
+		}},
+		{name: "list filter and pagination", fn: func(t *testing.T, store *Store) {
+			ctx := context.Background()
+			first, _ := store.Create(ctx, "first")
+			second, _ := store.Create(ctx, "second")
+			third, _ := store.Create(ctx, "third")
+			done := true
+			if _, err := store.Update(ctx, second.ID, Changes{Done: &done}); err != nil {
+				t.Fatal(err)
+			}
+			items, err := store.List(ctx, nil, 2, 0)
+			if err != nil || len(items) != 2 || items[0].ID != third.ID || items[1].ID != second.ID {
+				t.Errorf("List(nil, 2, 0) = %+v, %v; want newest two", items, err)
+			}
+			items, err = store.List(ctx, &done, 10, 0)
+			if err != nil || len(items) != 1 || items[0].ID != second.ID {
+				t.Errorf("List(done, 10, 0) = %+v, %v; want second only", items, err)
+			}
+			items, err = store.List(ctx, nil, 10, 3)
+			if err != nil || len(items) != 0 {
+				t.Errorf("List(nil, 10, 3) = %+v, %v; want empty page", items, err)
+			}
+			_ = first
+		}},
+		{name: "cancelled context", fn: func(t *testing.T, store *Store) {
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			if _, err := store.List(ctx, nil, 1, 0); err == nil {
+				t.Error("List(cancelled) error = nil, want context error")
+			}
+		}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var c clock.Clock = clock.Fixed{T: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}
+			if tc.name == "list filter and pagination" {
+				c = &steppingClock{}
+			}
+			tc.fn(t, NewStore(c))
+		})
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	store := NewStore(clock.Real{})
+	const count = 100
+	var wg sync.WaitGroup
+	ids := make(chan string, count)
+	for i := range count {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			item, err := store.Create(context.Background(), fmt.Sprintf("item %d", i))
+			if err != nil {
+				t.Errorf("Create(%d) error = %v, want nil", i, err)
+				return
+			}
+			ids <- item.ID
+		}(i)
+	}
+	wg.Wait()
+	close(ids)
+	for identifier := range ids {
+		if _, err := store.Get(context.Background(), identifier); err != nil {
+			t.Errorf("Get(%q) error = %v, want nil", identifier, err)
+		}
+	}
+	items, err := store.List(context.Background(), nil, 100, 0)
+	if err != nil || len(items) != count {
+		t.Errorf("List() returned %d items, %v; want %d", len(items), err, count)
+	}
+}
