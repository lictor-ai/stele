index 0000000..21f00c6
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,41 @@
+package logparse
+
+import (
+	"testing"
+	"time"
+)
+
+func TestParse(t *testing.T) {
+	cases := []struct {
+		name     string
+		line     string
+		wantErr  bool
+		path     string
+		status   int
+		duration float64
+	}{
+		{name: "valid with query", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`, path: "/api/items", status: 200, duration: .042},
+		{name: "empty", line: "", wantErr: true},
+		{name: "missing fields", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1"`, wantErr: true},
+		{name: "bad timestamp", line: `203.0.113.9 - - [bad] "GET / HTTP/1.1" 200 512 "-" "agent" 0.1`, wantErr: true},
+		{name: "bad status", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" nope 512 "-" "agent" 0.1`, wantErr: true},
+		{name: "negative time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "agent" -0.1`, wantErr: true},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := Parse(test.line)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("Parse(%q) error = %v, want error %v", test.line, err, test.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if got.Path != test.path || got.Status != test.status || got.RequestTime != test.duration {
+				t.Errorf("Parse(%q) = %+v, want path %q, status %d, duration %v", test.line, got, test.path, test.status, test.duration)
+			}
+			if !got.RequestedAt.Equal(time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC)) {
+				t.Errorf("Parse(%q) timestamp = %v, want 2026-10-10 13:55:36 UTC", test.line, got.RequestedAt)
+			}
+		})
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..3d4c83c
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,83 @@
+// Package stats aggregates parsed access log requests into a report.
+package stats
+
+import (
+	"example.com/app/internal/logparse"
+	"math"
+	"sort"
+)
+
+// PathCount holds a path and its request count.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// Report contains the complete log analysis.
+type Report struct {
+	TotalRequests   int            `json:"total_requests"`
+	MalformedLines  int            `json:"malformed_lines"`
+	TopPaths        []PathCount    `json:"top_paths"`
+	StatusClasses   map[string]int `json:"status_classes"`
+	P50Milliseconds float64        `json:"p50_milliseconds"`
+	P95Milliseconds float64        `json:"p95_milliseconds"`
+	P99Milliseconds float64        `json:"p99_milliseconds"`
+	FiveXXPerHour   map[string]int `json:"five_xx_per_hour"`
+}
+
+// Analyze builds a report from valid requests and a malformed line count.
+func Analyze(requests []logparse.Request, malformed, top int) Report {
+	if top < 0 {
+		top = 0
+	}
+	pathCounts := make(map[string]int)
+	status := map[string]int{"2xx": 0, "3xx": 0, "4xx": 0, "5xx": 0}
+	hours := make(map[string]int)
+	durations := make([]float64, 0, len(requests))
+	for _, request := range requests {
+		pathCounts[request.Path]++
+		class := request.Status / 100
+		if class >= 2 && class <= 5 {
+			key := string(rune('0'+class)) + "xx"
+			status[key]++
+		}
+		if class == 5 {
+			hour := request.RequestedAt.Format("2006-01-02T15:00:00Z07:00")
+			hours[hour]++
+		}
+		durations = append(durations, request.RequestTime*1000)
+	}
+	paths := make([]PathCount, 0, len(pathCounts))
+	for path, count := range pathCounts {
+		paths = append(paths, PathCount{Path: path, Count: count})
+	}
+	sort.Slice(paths, func(i, j int) bool {
+		if paths[i].Count == paths[j].Count {
+			return paths[i].Path < paths[j].Path
+		}
+		return paths[i].Count > paths[j].Count
+	})
+	if len(paths) > top {
+		paths = paths[:top]
+	}
+	sort.Float64s(durations)
+	return Report{
+		TotalRequests: len(requests), MalformedLines: malformed, TopPaths: paths,
+		StatusClasses: status, P50Milliseconds: percentile(durations, .50),
+		P95Milliseconds: percentile(durations, .95), P99Milliseconds: percentile(durations, .99),
+		FiveXXPerHour: hours,
+	}
+}
+
+func percentile(sorted []float64, fraction float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	position := fraction * float64(len(sorted)-1)
+	lower := int(math.Floor(position))
+	upper := int(math.Ceil(position))
+	if lower == upper {
+		return sorted[lower]
+	}
+	return sorted[lower] + (sorted[upper]-sorted[lower])*(position-float64(lower))
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..49c93dd
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,52 @@
+package stats
+
+import (
+	"math"
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestAnalyze(t *testing.T) {
+	when := time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC)
+	cases := []struct {
+		name      string
+		requests  []logparse.Request
+		malformed int
+		top       int
+		wantTotal int
+		wantPaths []PathCount
+		wantP50   float64
+		wantP95   float64
+		wantP99   float64
+		want5xx   int
+	}{
+		{name: "empty input", top: 10, wantPaths: []PathCount{}},
+		{name: "single request", requests: []logparse.Request{{Path: "/one", Status: 201, RequestTime: .025, RequestedAt: when}}, top: 10, wantTotal: 1, wantPaths: []PathCount{{Path: "/one", Count: 1}}, wantP50: 25, wantP95: 25, wantP99: 25},
+		{name: "limits and interpolation", requests: []logparse.Request{{Path: "/b", Status: 500, RequestTime: .01, RequestedAt: when}, {Path: "/a", Status: 404, RequestTime: .02, RequestedAt: when}, {Path: "/b", Status: 302, RequestTime: .03, RequestedAt: when}, {Path: "/c", Status: 200, RequestTime: .04, RequestedAt: when}}, malformed: 2, top: 2, wantTotal: 4, wantPaths: []PathCount{{Path: "/b", Count: 2}, {Path: "/a", Count: 1}}, wantP50: 25, wantP95: 38.5, wantP99: 39.7, want5xx: 1},
+		{name: "zero top", requests: []logparse.Request{{Path: "/one", Status: 500, RequestedAt: when}}, top: 0, wantTotal: 1, wantPaths: []PathCount{}, want5xx: 1},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			got := Analyze(test.requests, test.malformed, test.top)
+			if got.TotalRequests != test.wantTotal || got.MalformedLines != test.malformed {
+				t.Errorf("Analyze totals = (%d, %d), want (%d, %d)", got.TotalRequests, got.MalformedLines, test.wantTotal, test.malformed)
+			}
+			if len(got.TopPaths) != len(test.wantPaths) {
+				t.Fatalf("Analyze top paths = %v, want %v", got.TopPaths, test.wantPaths)
+			}
+			for i := range test.wantPaths {
+				if got.TopPaths[i] != test.wantPaths[i] {
+					t.Errorf("Analyze top path %d = %v, want %v", i, got.TopPaths[i], test.wantPaths[i])
+				}
+			}
+			if math.Abs(got.P50Milliseconds-test.wantP50) > 1e-9 || math.Abs(got.P95Milliseconds-test.wantP95) > 1e-9 || math.Abs(got.P99Milliseconds-test.wantP99) > 1e-9 {
+				t.Errorf("Analyze percentiles = (%v, %v, %v), want (%v, %v, %v)", got.P50Milliseconds, got.P95Milliseconds, got.P99Milliseconds, test.wantP50, test.wantP95, test.wantP99)
+			}
+			if got.StatusClasses["5xx"] != test.want5xx || len(got.FiveXXPerHour) != test.want5xx {
+				t.Errorf("Analyze 5xx = %d across %d hours, want %d", got.StatusClasses["5xx"], len(got.FiveXXPerHour), test.want5xx)
+			}
+		})
+	}
+}
