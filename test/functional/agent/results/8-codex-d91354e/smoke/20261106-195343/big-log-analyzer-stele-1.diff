index 0000000..79d5201
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,47 @@
+package main
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRun(t *testing.T) {
+	cases := []struct {
+		name       string
+		args       func(string) []string
+		wantErr    bool
+		wantFlag   bool
+		wantOutput string
+	}{
+		{name: "text report skips malformed line", args: func(path string) []string { return []string{path} }, wantOutput: "Total requests: 1\nMalformed lines: 1"},
+		{name: "json report", args: func(path string) []string { return []string{"-json", path} }, wantOutput: `"total_requests":1`},
+		{name: "bad flag", args: func(path string) []string { return []string{"-unknown"} }, wantErr: true, wantFlag: true},
+		{name: "bad top limit", args: func(path string) []string { return []string{"-top=-1"} }, wantErr: true, wantFlag: true},
+		{name: "missing file", args: func(path string) []string { return []string{path + ".missing"} }, wantErr: true},
+	}
+	for _, test := range cases {
+		t.Run(test.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "access.log")
+			contents := "203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] \"GET /items?id=3 HTTP/1.1\" 500 512 \"-\" \"curl/8.0\" 0.042\ninvalid\n"
+			if err := os.WriteFile(path, []byte(contents), 0600); err != nil {
+				t.Fatalf("WriteFile(%q) error = %v, want nil", path, err)
+			}
+			var stdout, stderr bytes.Buffer
+			err := run(test.args(path), &stdout, &stderr)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("run(%v) error = %v, want error %v", test.args(path), err, test.wantErr)
+			}
+			var flagErr flagError
+			if errors.As(err, &flagErr) != test.wantFlag {
+				t.Errorf("run(%v) flag error = %v, want %v", test.args(path), errors.As(err, &flagErr), test.wantFlag)
+			}
+			if !strings.Contains(stdout.String(), test.wantOutput) {
+				t.Errorf("run(%v) output = %q, want it to contain %q", test.args(path), stdout.String(), test.wantOutput)
+			}
+		})
+	}
+}
diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..8cd4a70
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,102 @@
+// Package logparse parses nginx combined access log entries with a request time.
+package logparse
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Request holds the fields used by the analyzer from one access log entry.
+type Request struct {
+	Path        string
+	Status      int
+	RequestTime float64
+	RequestedAt time.Time
+}
+
+// Parse parses one nginx combined access log entry with request time appended.
+func Parse(line string) (Request, error) {
+	fields, err := tokenize(line)
+	if err != nil {
+		return Request{}, err
+	}
+	if len(fields) != 10 {
+		return Request{}, fmt.Errorf("expected 10 fields, got %d", len(fields))
+	}
+	requestedAt, err := time.Parse("02/Jan/2006:15:04:05 -0700", fields[3])
+	if err != nil {
+		return Request{}, fmt.Errorf("parse request timestamp %q: %w", fields[3], err)
+	}
+	requestParts := strings.Fields(fields[4])
+	if len(requestParts) != 3 {
+		return Request{}, fmt.Errorf("invalid request field %q", fields[4])
+	}
+	path := requestParts[1]
+	if path == "" {
+		return Request{}, fmt.Errorf("request path is empty")
+	}
+	if query := strings.IndexByte(path, '?'); query >= 0 {
+		path = path[:query]
+	}
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return Request{}, fmt.Errorf("invalid status %q", fields[5])
+	}
+	if _, err := strconv.ParseInt(fields[6], 10, 64); err != nil {
+		return Request{}, fmt.Errorf("invalid response size %q: %w", fields[6], err)
+	}
+	requestTime, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || requestTime < 0 || math.IsNaN(requestTime) || math.IsInf(requestTime, 0) {
+		return Request{}, fmt.Errorf("invalid request time %q", fields[9])
+	}
+	return Request{Path: path, Status: status, RequestTime: requestTime, RequestedAt: requestedAt}, nil
+}
+
+func tokenize(line string) ([]string, error) {
+	fields := make([]string, 0, 10)
+	for i := 0; i < len(line); {
+		for i < len(line) && line[i] == ' ' {
+			i++
+		}
+		if i == len(line) {
+			break
+		}
+		start := i
+		switch line[i] {
+		case '[':
+			i++
+			for i < len(line) && line[i] != ']' {
+				i++
+			}
+			if i == len(line) {
+				return nil, fmt.Errorf("unterminated timestamp field")
+			}
+			fields = append(fields, line[start+1:i])
+			i++
+		case '"':
+			i++
+			var value strings.Builder
+			for i < len(line) && line[i] != '"' {
+				if line[i] == '\\' && i+1 < len(line) {
+					i++
+				}
+				value.WriteByte(line[i])
+				i++
+			}
+			if i == len(line) {
+				return nil, fmt.Errorf("unterminated quoted field")
+			}
+			fields = append(fields, value.String())
+			i++
+		default:
+			for i < len(line) && line[i] != ' ' {
+				i++
+			}
+			fields = append(fields, line[start:i])
+		}
+	}
+	return fields, nil
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
