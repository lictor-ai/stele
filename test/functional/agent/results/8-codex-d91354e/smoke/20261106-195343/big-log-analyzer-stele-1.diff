diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..dab3a63
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,122 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+type flagError struct{ err error }
+
+func (e flagError) Error() string { return e.err.Error() }
+func (e flagError) Unwrap() error { return e.err }
+
+func main() {
+	if err := run(os.Args[1:], os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		var badFlags flagError
+		if errors.As(err, &badFlags) {
+			os.Exit(2)
+		}
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stdout, stderr io.Writer) error {
+	flags := flag.NewFlagSet("loga", flag.ContinueOnError)
+	flags.SetOutput(stderr)
+	top := flags.Int("top", 10, "number of paths to show")
+	jsonOutput := flags.Bool("json", false, "write the report as JSON")
+	if err := flags.Parse(args); err != nil {
+		return flagError{err: err}
+	}
+	if *top < 0 {
+		return flagError{err: fmt.Errorf("-top must be non-negative")}
+	}
+	requests := make([]logparse.Request, 0)
+	malformed := 0
+	files := flags.Args()
+	if len(files) == 0 {
+		if err := consume("stdin", os.Stdin, &requests, &malformed); err != nil {
+			return err
+		}
+	} else {
+		for _, name := range files {
+			file, err := os.Open(name)
+			if err != nil {
+				return fmt.Errorf("open %s: %w", name, err)
+			}
+			consumeErr := consume(name, file, &requests, &malformed)
+			closeErr := file.Close()
+			if consumeErr != nil {
+				return consumeErr
+			}
+			if closeErr != nil {
+				return fmt.Errorf("close %s: %w", name, closeErr)
+			}
+		}
+	}
+	report := stats.Analyze(requests, malformed, *top)
+	if *jsonOutput {
+		return writeJSON(stdout, report)
+	}
+	return writeText(stdout, report)
+}
+
+func consume(name string, input io.Reader, requests *[]logparse.Request, malformed *int) error {
+	scanner := bufio.NewScanner(input)
+	scanner.Buffer(make([]byte, 64*1024), 4*1024*1024)
+	for scanner.Scan() {
+		request, err := logparse.Parse(scanner.Text())
+		if err != nil {
+			*malformed++
+			continue
+		}
+		*requests = append(*requests, request)
+	}
+	if err := scanner.Err(); err != nil {
+		return fmt.Errorf("read %s: %w", name, err)
+	}
+	return nil
+}
+
+func writeJSON(output io.Writer, report stats.Report) error {
+	if err := json.NewEncoder(output).Encode(report); err != nil {
+		return fmt.Errorf("write JSON report: %w", err)
+	}
+	return nil
+}
+
+func writeText(output io.Writer, report stats.Report) error {
+	if _, err := fmt.Fprintf(output, "Total requests: %d\nMalformed lines: %d\n\nTop paths\n", report.TotalRequests, report.MalformedLines); err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	for _, path := range report.TopPaths {
+		if _, err := fmt.Fprintf(output, "%7d  %s\n", path.Count, path.Path); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+	}
+	if _, err := fmt.Fprintf(output, "\nStatus classes\n2xx: %d\n3xx: %d\n4xx: %d\n5xx: %d\n\nRequest time (ms)\np50: %.3f\np95: %.3f\np99: %.3f\n\n5xx per hour\n", report.StatusClasses["2xx"], report.StatusClasses["3xx"], report.StatusClasses["4xx"], report.StatusClasses["5xx"], report.P50Milliseconds, report.P95Milliseconds, report.P99Milliseconds); err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	hours := make([]string, 0, len(report.FiveXXPerHour))
+	for hour := range report.FiveXXPerHour {
+		hours = append(hours, hour)
+	}
+	sort.Strings(hours)
+	for _, hour := range hours {
+		count := report.FiveXXPerHour[hour]
+		if _, err := fmt.Fprintf(output, "%s: %d\n", hour, count); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
