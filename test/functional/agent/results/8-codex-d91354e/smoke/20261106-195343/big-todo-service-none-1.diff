@@ -0,0 +1,59 @@
+package todo
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestStoreCRUDAndList(t *testing.T) {
+	s := NewStore()
+	a := s.Create("first")
+	b := s.Create("second")
+	if got, ok := s.Get(a.ID); !ok || got.Title != "first" {
+		t.Fatalf("Get = %#v, %v", got, ok)
+	}
+	done := true
+	updated, ok := s.Update(a.ID, Changes{Done: &done})
+	if !ok || !updated.Done {
+		t.Fatalf("Update = %#v, %v", updated, ok)
+	}
+	items := s.List(&done, 10, 0)
+	if len(items) != 1 || items[0].ID != a.ID {
+		t.Fatalf("filtered List = %#v", items)
+	}
+	items = s.List(nil, 1, 1)
+	if len(items) != 1 || items[0].ID != a.ID {
+		t.Fatalf("paginated List = %#v (b=%s)", items, b.ID)
+	}
+	if !s.Delete(a.ID) || s.Delete(a.ID) {
+		t.Fatal("Delete did not report existence")
+	}
+	if _, ok := s.Update("absent", Changes{}); ok {
+		t.Fatal("updated absent TODO")
+	}
+}
+
+func TestStoreConcurrentUse(t *testing.T) {
+	s := NewStore()
+	const workers, each = 12, 80
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			for i := 0; i < each; i++ {
+				x := s.Create(fmt.Sprintf("%d-%d", w, i))
+				s.Get(x.ID)
+				v := i%2 == 0
+				s.Update(x.ID, Changes{Done: &v})
+				s.List(nil, 5, 0)
+				s.Delete(x.ID)
+			}
+		}(w)
+	}
+	wg.Wait()
+	if got := s.List(nil, 100, 0); len(got) != 0 {
+		t.Fatalf("remaining items = %d", len(got))
+	}
+}
