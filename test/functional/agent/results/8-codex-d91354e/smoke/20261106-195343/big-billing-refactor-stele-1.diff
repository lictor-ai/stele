+func TestDiscounts(t *testing.T) {
+	now := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	cases := []struct {
+		name    string
+		total   int64
+		code    DiscountCode
+		want    int64
+		wantErr bool
+	}{
+		{name: "expiry", total: 1000, code: DiscountCode{Code: "old", AmountCents: 100, ExpiresAt: &now}, wantErr: true},
+		{name: "floor", total: 50, code: DiscountCode{Code: "large", AmountCents: 100}, want: 50},
+		{name: "percentage rounding", total: 101, code: DiscountCode{Code: "pct", PercentBPS: 5000}, want: 51},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			usage := NewDiscountUsage()
+			inv, err := ComputeWithOptions("i", "c", []Line{{Quantity: 1, UnitCents: tc.total}}, Options{Discount: &tc.code, Usage: usage, IssuedAt: now, TaxRates: map[string]int64{}})
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("ComputeWithOptions() error = %v, wantErr %v", err, tc.wantErr)
+			}
+			if err == nil && inv.DiscountCents != tc.want {
+				t.Errorf("discount = %d, want %d", inv.DiscountCents, tc.want)
+			}
+		})
+	}
+	t.Run("reuse", func(t *testing.T) {
+		usage := NewDiscountUsage()
+		code := DiscountCode{Code: "once", AmountCents: 10}
+		for i := 0; i < 2; i++ {
+			_, err := ComputeWithOptions("i", "c", []Line{{Quantity: 1, UnitCents: 100}}, Options{Discount: &code, Usage: usage, IssuedAt: now})
+			if (i == 0 && err != nil) || (i == 1 && err == nil) {
+				t.Errorf("attempt %d error = %v, unexpected", i+1, err)
+			}
+		}
+	})
+}
