--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,27 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+)
+
+// ExportCSV writes invoices in the billing CSV format.
+func ExportCSV(w io.Writer, invoices []Invoice) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}); err != nil {
+		return fmt.Errorf("write invoice CSV header: %w", err)
+	}
+	for _, invoice := range invoices {
+		row := []string{invoice.ID, invoice.Customer, invoice.Region, invoice.IssuedAt.Format("2006-01-02T15:04:05Z07:00"), strconv.FormatInt(invoice.TotalCents, 10), strconv.FormatInt(invoice.DiscountCents, 10), strconv.FormatInt(invoice.TaxCents, 10), strconv.FormatInt(invoice.GrandTotalCents, 10)}
+		if err := writer.Write(row); err != nil {
+			return fmt.Errorf("write invoice %q to CSV: %w", invoice.ID, err)
+		}
+	}
+	writer.Flush()
+	if err := writer.Error(); err != nil {
+		return fmt.Errorf("flush invoice CSV: %w", err)
+	}
+	return nil
+}
