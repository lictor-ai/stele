+func TestTaxAndExport(t *testing.T) {
+	issued := time.Date(2026, 2, 3, 4, 5, 6, 0, time.UTC)
+	code := DiscountCode{Code: "d", AmountCents: 100}
+	inv, err := ComputeWithOptions("inv", "customer", []Line{{Quantity: 1, UnitCents: 1000}}, Options{Region: "FR", TaxRates: map[string]int64{"FR": 2000}, Discount: &code, Usage: NewDiscountUsage(), IssuedAt: issued})
+	if err != nil {
+		t.Fatalf("ComputeWithOptions() error = %v", err)
+	}
+	if inv.TaxCents != 180 || inv.GrandTotalCents != 1080 {
+		t.Errorf("tax/grand total = %d/%d, want 180/1080", inv.TaxCents, inv.GrandTotalCents)
+	}
+	var out bytes.Buffer
+	if err := ExportCSV(&out, []Invoice{inv}); err != nil {
+		t.Fatalf("ExportCSV() error = %v", err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\ninv,customer,FR,2026-02-03T04:05:06Z,1000,100,180,1080\n"
+	if strings.TrimSpace(out.String()) != strings.TrimSpace(want) {
+		t.Errorf("ExportCSV() = %q, want %q", out.String(), want)
+	}
+}
