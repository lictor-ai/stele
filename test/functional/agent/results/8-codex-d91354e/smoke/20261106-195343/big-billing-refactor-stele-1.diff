+
+// DiscountCode describes a percentage or fixed amount discount.
+type DiscountCode struct {
+	Code        string
+	PercentBPS  int64
+	AmountCents int64
+	ExpiresAt   *time.Time
+}
+
+// DiscountUsage tracks customer use of discount codes.
+type DiscountUsage struct {
+	mu   sync.Mutex
+	used map[string]map[string]bool
+}
+
+// Options supplies caller-owned regional tax and discount data.
+type Options struct {
+	Region   string
+	TaxRates map[string]int64
+	Discount *DiscountCode
+	Usage    *DiscountUsage
+	IssuedAt time.Time
+}
+
+// NewDiscountUsage creates an empty discount usage tracker.
+func NewDiscountUsage() *DiscountUsage { return &DiscountUsage{used: make(map[string]map[string]bool)} }
+
+// ComputeWithOptions builds an invoice with optional discount and regional tax.
+func ComputeWithOptions(id, customer string, lines []Line, opts Options) (Invoice, error) {
+	var total int64
+	for _, line := range lines {
+		if line.Quantity < 0 || line.UnitCents < 0 {
+			return Invoice{}, fmt.Errorf("invalid invoice line %q", line.SKU)
+		}
+		product := int64(line.Quantity) * line.UnitCents
+		if line.Quantity != 0 && product/int64(line.Quantity) != line.UnitCents || total > math.MaxInt64-product {
+			return Invoice{}, fmt.Errorf("invoice total overflows")
+		}
+		total += product
+	}
+	var discount int64
+	if opts.Discount != nil {
+		code := opts.Discount
+		if code.Code == "" || code.PercentBPS < 0 || code.AmountCents < 0 || (code.PercentBPS > 0 && code.AmountCents > 0) || code.PercentBPS > 10000 {
+			return Invoice{}, fmt.Errorf("invalid discount code")
+		}
+		if code.ExpiresAt != nil && !opts.IssuedAt.Before(*code.ExpiresAt) {
+			return Invoice{}, fmt.Errorf("discount code %q has expired", code.Code)
+		}
+		if opts.Usage == nil {
+			return Invoice{}, fmt.Errorf("discount usage tracker is required")
+		}
+		discount = code.AmountCents
+		if code.PercentBPS > 0 {
+			discount = (total*code.PercentBPS + 5000) / 10000
+		}
+		if discount > total {
+			discount = total
+		}
+		opts.Usage.mu.Lock()
+		if opts.Usage.used == nil {
+			opts.Usage.used = make(map[string]map[string]bool)
+		}
+		customers := opts.Usage.used[code.Code]
+		if customers == nil {
+			customers = make(map[string]bool)
+			opts.Usage.used[code.Code] = customers
+		}
+		if customers[customer] {
+			opts.Usage.mu.Unlock()
+			return Invoice{}, fmt.Errorf("discount code %q already used by customer", code.Code)
+		}
+		customers[customer] = true
+		opts.Usage.mu.Unlock()
+	}
+	rate := opts.TaxRates[opts.Region]
+	if rate < 0 {
+		return Invoice{}, fmt.Errorf("invalid tax rate for region %q", opts.Region)
+	}
+	base := total - discount
+	tax := (base*rate + 5000) / 10000
+	return Invoice{ID: id, Customer: customer, Region: opts.Region, Lines: lines, TotalCents: total, DiscountCents: discount, TaxCents: tax, GrandTotalCents: base + tax, IssuedAt: opts.IssuedAt}, nil
 }
 
