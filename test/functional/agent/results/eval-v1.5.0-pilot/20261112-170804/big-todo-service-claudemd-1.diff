+package main
+
+import (
+	"context"
+	"io"
+	"testing"
+)
+
+func TestRunFlagErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		args []string
+	}{
+		{"unknown flag", []string{"-nope"}},
+		{"bad address", []string{"-addr", "not an address"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := run(tc.args, io.Discard, io.Discard); err == nil {
+				t.Errorf("run(%q) = nil, want error", tc.args)
+			}
+		})
+	}
+}
+
+func TestServeStopsOnCancel(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := serve(ctx, "127.0.0.1:0"); err != nil {
+		t.Errorf("serve(cancelled ctx) = %v, want nil", err)
+	}
+}
diff --git a/internal/api/handler.go b/internal/api/handler.go
new file mode 100644
index 0000000..8c67467
--- /dev/null
+++ b/internal/api/handler.go
@@ -0,0 +1,161 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strconv"
+
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const (
+	maxBodyBytes = 1 << 20
+	defaultLimit = 20
+	maxLimit     = 100
+)
+
+type handler struct {
+	store *todo.Store
+}
+
+// NewHandler returns the HTTP handler for the todo API, backed by store.
+func NewHandler(store *todo.Store) http.Handler {
+	h := &handler{store: store}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return mux
+}
+
+type createRequest struct {
+	Title string `json:"title"`
+}
+
+type updateRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+// decode reads one JSON object from the body into v. On failure it writes the
+// error response and returns false.
+func decode(w http.ResponseWriter, r *http.Request, v any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, maxBodyBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	err := dec.Decode(v)
+	if err == nil {
+		if _, err2 := dec.Token(); err2 != io.EOF {
+			err = errors.New("trailing data")
+		}
+	}
+	if err != nil {
+		var tooBig *http.MaxBytesError
+		if errors.As(err, &tooBig) {
+			Error(w, http.StatusRequestEntityTooLarge, "request body too large")
+			return false
+		}
+		Error(w, http.StatusBadRequest, "request body must be a single valid JSON object with known fields")
+		return false
+	}
+	return true
+}
+
+func (h *handler) fail(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, todo.ErrNotFound):
+		Error(w, http.StatusNotFound, "todo not found")
+	case errors.Is(err, todo.ErrInvalidTitle):
+		Error(w, http.StatusBadRequest, "title must be 1 to 200 characters after trimming")
+	default:
+		log.Error("todo store", "err", err)
+		Error(w, http.StatusInternalServerError, "internal error, try again later")
+	}
+}
+
+func (h *handler) create(w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	if !decode(w, r, &req) {
+		return
+	}
+	item, err := h.store.Create(req.Title)
+	if err != nil {
+		h.fail(w, err)
+		return
+	}
+	JSON(w, http.StatusCreated, item)
+}
+
+func (h *handler) get(w http.ResponseWriter, r *http.Request) {
+	item, err := h.store.Get(r.PathValue("id"))
+	if err != nil {
+		h.fail(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, item)
+}
+
+func (h *handler) update(w http.ResponseWriter, r *http.Request) {
+	var req updateRequest
+	if !decode(w, r, &req) {
+		return
+	}
+	if req.Title == nil && req.Done == nil {
+		Error(w, http.StatusBadRequest, "provide title and/or done")
+		return
+	}
+	item, err := h.store.Update(r.PathValue("id"), todo.Update{Title: req.Title, Done: req.Done})
+	if err != nil {
+		h.fail(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, item)
+}
+
+func (h *handler) delete(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.PathValue("id")); err != nil {
+		h.fail(w, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func (h *handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	opts := todo.ListOptions{Limit: defaultLimit}
+	if v := q.Get("done"); v != "" {
+		switch v {
+		case "true":
+			t := true
+			opts.Done = &t
+		case "false":
+			f := false
+			opts.Done = &f
+		default:
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+	}
+	if v := q.Get("limit"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 1 || n > maxLimit {
+			Error(w, http.StatusBadRequest, "limit must be an integer from 1 to 100")
+			return
+		}
+		opts.Limit = n
+	}
+	if v := q.Get("offset"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be an integer of 0 or more")
+			return
+		}
+		opts.Offset = n
+	}
+	JSON(w, http.StatusOK, h.store.List(opts))
+}
diff --git a/internal/api/handler_test.go b/internal/api/handler_test.go
new file mode 100644
index 0000000..85103ac
