+++ b/internal/api/handler_test.go
@@ -0,0 +1,280 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func newTestHandler() http.Handler {
+	clk := clock.Fixed{T: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)}
+	return NewHandler(todo.NewStore(clk))
+}
+
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	var r *http.Request
+	if body == "" {
+		r = httptest.NewRequest(method, target, nil)
+	} else {
+		r = httptest.NewRequest(method, target, strings.NewReader(body))
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func create(t *testing.T, h http.Handler, title string) todo.Todo {
+	t.Helper()
+	b, _ := json.Marshal(map[string]string{"title": title})
+	w := do(h, "POST", "/todos", string(b))
+	if w.Code != http.StatusCreated {
+		t.Fatalf("POST /todos = %d, want %d", w.Code, http.StatusCreated)
+	}
+	var item todo.Todo
+	if err := json.Unmarshal(w.Body.Bytes(), &item); err != nil {
+		t.Fatalf("decode created todo %q: %v", w.Body.String(), err)
+	}
+	return item
+}
+
+func wantError(t *testing.T, w *httptest.ResponseRecorder, status int) {
+	t.Helper()
+	if w.Code != status {
+		t.Fatalf("status = %d, want %d (body %q)", w.Code, status, w.Body.String())
+	}
+	if ct := w.Header().Get("Content-Type"); ct != "application/json" {
+		t.Errorf("Content-Type = %q, want application/json", ct)
+	}
+	var e map[string]string
+	if err := json.Unmarshal(w.Body.Bytes(), &e); err != nil || e["error"] == "" {
+		t.Errorf("body = %q, want {\"error\": \"...\"}", w.Body.String())
+	}
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name   string
+		body   string
+		status int
+	}{
+		{"ok", `{"title":"buy milk"}`, http.StatusCreated},
+		{"trimmed", `{"title":"  x  "}`, http.StatusCreated},
+		{"max length", `{"title":"` + strings.Repeat("a", 200) + `"}`, http.StatusCreated},
+		{"too long", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest},
+		{"blank", `{"title":"   "}`, http.StatusBadRequest},
+		{"missing title", `{}`, http.StatusBadRequest},
+		{"unknown field", `{"title":"a","extra":1}`, http.StatusBadRequest},
+		{"wrong type", `{"title":5}`, http.StatusBadRequest},
+		{"not json", `nope`, http.StatusBadRequest},
+		{"trailing data", `{"title":"a"} {"title":"b"}`, http.StatusBadRequest},
+		{"empty body", ``, http.StatusBadRequest},
+		{"too large", `{"title":"` + strings.Repeat("a", 2<<20) + `"}`, http.StatusRequestEntityTooLarge},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(newTestHandler(), "POST", "/todos", tc.body)
+			if tc.status != http.StatusCreated {
+				wantError(t, w, tc.status)
+				return
+			}
+			if w.Code != tc.status {
+				t.Fatalf("POST /todos = %d, want %d", w.Code, tc.status)
+			}
+			var raw map[string]any
+			if err := json.Unmarshal(w.Body.Bytes(), &raw); err != nil {
+				t.Fatalf("decode %q: %v", w.Body.String(), err)
+			}
+			for _, k := range []string{"id", "title", "done", "created_at", "updated_at"} {
+				if _, ok := raw[k]; !ok {
+					t.Errorf("POST /todos body %q lacks field %q", w.Body.String(), k)
+				}
+			}
+			if raw["done"] != false {
+				t.Errorf("done = %v, want false", raw["done"])
+			}
+		})
+	}
+}
+
+func TestGet(t *testing.T) {
+	h := newTestHandler()
+	item := create(t, h, "a")
+	tests := []struct {
+		name   string
+		path   string
+		status int
+	}{
+		{"existing", "/todos/" + item.ID, http.StatusOK},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "GET", tc.path, "")
+			if tc.status != http.StatusOK {
+				wantError(t, w, tc.status)
+				return
+			}
+			var got todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil || got != item {
+				t.Errorf("GET %s = %q (err %v), want %+v", tc.path, w.Body.String(), err, item)
+			}
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		idSuffix  string
+		body      string
+		status    int
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title", "", `{"title":" new "}`, http.StatusOK, "new", false},
+		{"done", "", `{"done":true}`, http.StatusOK, "old", true},
+		{"both", "", `{"title":"n","done":true}`, http.StatusOK, "n", true},
+		{"empty object", "", `{}`, http.StatusBadRequest, "", false},
+		{"blank title", "", `{"title":" "}`, http.StatusBadRequest, "", false},
+		{"too long title", "", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, "", false},
+		{"wrong type", "", `{"done":"yes"}`, http.StatusBadRequest, "", false},
+		{"unknown field", "", `{"id":"x"}`, http.StatusBadRequest, "", false},
+		{"not json", "", `{`, http.StatusBadRequest, "", false},
+		{"missing id", "missing", `{"done":true}`, http.StatusNotFound, "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h := newTestHandler()
+			item := create(t, h, "old")
+			id := item.ID
+			if tc.idSuffix != "" {
+				id = tc.idSuffix
+			}
+			w := do(h, "PATCH", "/todos/"+id, tc.body)
+			if tc.status != http.StatusOK {
+				wantError(t, w, tc.status)
+				return
+			}
+			var got todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatalf("decode %q: %v", w.Body.String(), err)
+			}
+			if got.ID != item.ID || got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("PATCH %s %s = %+v, want title %q done %v", id, tc.body, got, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	h := newTestHandler()
+	item := create(t, h, "a")
+	tests := []struct {
+		name   string
+		path   string
+		status int
+	}{
+		{"existing", "/todos/" + item.ID, http.StatusNoContent},
+		{"again", "/todos/" + item.ID, http.StatusNotFound},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "DELETE", tc.path, "")
+			if tc.status == http.StatusNoContent {
+				if w.Code != tc.status || w.Body.Len() != 0 {
+					t.Errorf("DELETE %s = %d %q, want %d and empty body", tc.path, w.Code, w.Body.String(), tc.status)
+				}
+				return
+			}
+			wantError(t, w, tc.status)
+		})
+	}
+	if w := do(h, "GET", "/todos/"+item.ID, ""); w.Code != http.StatusNotFound {
+		t.Errorf("GET after delete = %d, want %d", w.Code, http.StatusNotFound)
+	}
+}
+
+func TestList(t *testing.T) {
+	h := newTestHandler()
+	var ids []string
+	for i := 0; i < 25; i++ {
+		ids = append(ids, create(t, h, "t").ID)
+	}
+	// Mark the oldest three done.
+	for _, id := range ids[:3] {
+		do(h, "PATCH", "/todos/"+id, `{"done":true}`)
+	}
+	tests := []struct {
+		name    string
+		query   string
+		status  int
+		wantLen int
+		wantID  string // id of the first item, when set
+	}{
+		{"default limit", "", http.StatusOK, 20, ids[24]},
+		{"limit", "?limit=5", http.StatusOK, 5, ids[24]},
+		{"max limit", "?limit=100", http.StatusOK, 25, ids[24]},
+		{"offset", "?offset=20", http.StatusOK, 5, ids[4]},
+		{"offset past end", "?offset=100", http.StatusOK, 0, ""},
+		{"done true", "?done=true", http.StatusOK, 3, ids[2]},
+		{"done false", "?done=false&limit=2", http.StatusOK, 2, ids[24]},
+		{"limit zero", "?limit=0", http.StatusBadRequest, 0, ""},
+		{"limit too big", "?limit=101", http.StatusBadRequest, 0, ""},
+		{"limit not number", "?limit=abc", http.StatusBadRequest, 0, ""},
+		{"negative offset", "?offset=-1", http.StatusBadRequest, 0, ""},
+		{"offset not number", "?offset=x", http.StatusBadRequest, 0, ""},
+		{"bad done", "?done=maybe", http.StatusBadRequest, 0, ""},
+		{"done 1 rejected", "?done=1", http.StatusBadRequest, 0, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, "GET", "/todos"+tc.query, "")
+			if tc.status != http.StatusOK {
+				wantError(t, w, tc.status)
+				return
+			}
+			if w.Code != http.StatusOK {
+				t.Fatalf("GET /todos%s = %d, want 200", tc.query, w.Code)
+			}
+			var got []todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatalf("decode %q: %v", w.Body.String(), err)
+			}
+			if len(got) != tc.wantLen {
+				t.Fatalf("GET /todos%s returned %d items, want %d", tc.query, len(got), tc.wantLen)
+			}
+			if tc.wantID != "" && got[0].ID != tc.wantID {
+				t.Errorf("GET /todos%s first id = %s, want %s", tc.query, got[0].ID, tc.wantID)
+			}
+		})
+	}
+	if w := do(newTestHandler(), "GET", "/todos", ""); strings.TrimSpace(w.Body.String()) != "[]" {
+		t.Errorf("GET /todos on empty store = %q, want []", w.Body.String())
+	}
+}
+
+func TestRouting(t *testing.T) {
+	h := newTestHandler()
+	tests := []struct {
+		name, method, path string
+		status             int
+	}{
+		{"unknown path", "GET", "/nope", http.StatusNotFound},
+		{"wrong method on collection", "DELETE", "/todos", http.StatusMethodNotAllowed},
+		{"wrong method on item", "PUT", "/todos/abc", http.StatusMethodNotAllowed},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if w := do(h, tc.method, tc.path, ""); w.Code != tc.status {
+				t.Errorf("%s %s = %d, want %d", tc.method, tc.path, w.Code, tc.status)
+			}
+		})
+	}
+}
