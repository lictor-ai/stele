+package todo
+
+import "errors"
+
+// ErrNotFound is returned when no item has the requested id.
+var ErrNotFound = errors.New("todo not found")
+
+// ErrInvalidTitle is returned when a title is empty after trimming or longer than MaxTitleLen characters.
+var ErrInvalidTitle = errors.New("invalid title")
diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..c36f5ac
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,160 @@
+// Package todo holds the Todo type and an in-memory store for it.
+package todo
+
+import (
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// MaxTitleLen is the longest allowed title, in characters.
+const MaxTitleLen = 200
+
+// Todo is one item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Update describes a partial change. A nil field is left as it is.
+type Update struct {
+	Title *string
+	Done  *bool
+}
+
+// ListOptions selects and pages the items List returns.
+type ListOptions struct {
+	// Done keeps only items with this done state when not nil.
+	Done *bool
+	// Limit is the most items to return. Zero or less means no limit.
+	Limit int
+	// Offset is the number of matching items to skip.
+	Offset int
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	mu    sync.RWMutex     // guards items and order
+	items map[string]*Todo // by id
+	order []string         // ids, oldest first
+}
+
+// NewStore returns an empty Store that reads time from clk.
+func NewStore(clk clock.Clock) *Store {
+	return &Store{clock: clk, items: make(map[string]*Todo)}
+}
+
+// ValidateTitle trims title and checks its length. It returns the trimmed
+// title, or ErrInvalidTitle.
+func ValidateTitle(title string) (string, error) {
+	t := strings.TrimSpace(title)
+	if n := utf8.RuneCountInString(t); n < 1 || n > MaxTitleLen {
+		return "", ErrInvalidTitle
+	}
+	return t, nil
+}
+
+// Create adds a new, not done item with the given title.
+func (s *Store) Create(title string) (Todo, error) {
+	t, err := ValidateTitle(title)
+	if err != nil {
+		return Todo{}, err
+	}
+	now := s.clock.Now()
+	item := &Todo{ID: id.New(), Title: t, CreatedAt: now, UpdatedAt: now}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.items[item.ID] = item
+	s.order = append(s.order, item.ID)
+	return *item, nil
+}
+
+// Get returns the item with the given id, or ErrNotFound.
+func (s *Store) Get(itemID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	item, ok := s.items[itemID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	return *item, nil
+}
+
+// Update applies u to the item with the given id and returns the result.
+// It returns ErrNotFound or ErrInvalidTitle without changing anything.
+func (s *Store) Update(itemID string, u Update) (Todo, error) {
+	var title string
+	if u.Title != nil {
+		t, err := ValidateTitle(*u.Title)
+		if err != nil {
+			return Todo{}, err
+		}
+		title = t
+	}
+	now := s.clock.Now()
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.items[itemID]
+	if !ok {
+		return Todo{}, ErrNotFound
+	}
+	if u.Title != nil {
+		item.Title = title
+	}
+	if u.Done != nil {
+		item.Done = *u.Done
+	}
+	item.UpdatedAt = now
+	return *item, nil
+}
+
+// Delete removes the item with the given id, or returns ErrNotFound.
+func (s *Store) Delete(itemID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[itemID]; !ok {
+		return ErrNotFound
+	}
+	delete(s.items, itemID)
+	for i, v := range s.order {
+		if v == itemID {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns matching items, newest first, after applying the offset and limit.
+func (s *Store) List(opts ListOptions) []Todo {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	skip := max(opts.Offset, 0)
+	for i := len(s.order) - 1; i >= 0; i-- {
+		item := s.items[s.order[i]]
+		if opts.Done != nil && item.Done != *opts.Done {
+			continue
+		}
+		if skip > 0 {
+			skip--
+			continue
+		}
+		if opts.Limit > 0 && len(out) >= opts.Limit {
+			break
+		}
+		out = append(out, *item)
+	}
+	return out
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
new file mode 100644
index 0000000..97d9363
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,242 @@
+package todo
+
+import (
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var epoch = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newTestStore() *Store { return NewStore(clock.Fixed{T: epoch}) }
+
+func ptr[T any](v T) *T { return &v }
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name      string
+		title     string
+		wantTitle string
+		wantErr   error
+	}{
+		{"plain", "buy milk", "buy milk", nil},
+		{"trimmed", "  buy milk \n", "buy milk", nil},
+		{"empty", "", "", ErrInvalidTitle},
+		{"blank", " \t ", "", ErrInvalidTitle},
+		{"max length", strings.Repeat("a", 200), strings.Repeat("a", 200), nil},
+		{"too long", strings.Repeat("a", 201), "", ErrInvalidTitle},
+		{"multibyte max", strings.Repeat("é", 200), strings.Repeat("é", 200), nil},
+		{"multibyte too long", strings.Repeat("é", 201), "", ErrInvalidTitle},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := newTestStore().Create(tc.title)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.name, err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if got.Title != tc.wantTitle || got.Done || got.ID == "" ||
+				!got.CreatedAt.Equal(epoch) || !got.UpdatedAt.Equal(epoch) {
+				t.Errorf("Create(%q) = %+v, want title %q, not done, id set, times %v", tc.name, got, tc.wantTitle, epoch)
+			}
+		})
+	}
+}
+
+func TestGet(t *testing.T) {
+	s := newTestStore()
+	created, _ := s.Create("a")
+	tests := []struct {
+		name    string
+		id      string
+		wantErr error
+	}{
+		{"existing", created.ID, nil},
+		{"missing", "nope", ErrNotFound},
+		{"empty id", "", ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.Get(tc.id)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Get(%q) error = %v, want %v", tc.id, err, tc.wantErr)
+			}
+			if err == nil && got != created {
+				t.Errorf("Get(%q) = %+v, want %+v", tc.id, got, created)
+			}
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	later := epoch.Add(time.Hour)
+	tests := []struct {
+		name      string
+		useID     string
+		upd       Update
+		wantTitle string
+		wantDone  bool
+		wantErr   error
+	}{
+		{"title only", "", Update{Title: ptr(" new ")}, "new", false, nil},
+		{"done only", "", Update{Done: ptr(true)}, "old", true, nil},
+		{"both", "", Update{Title: ptr("x"), Done: ptr(true)}, "x", true, nil},
+		{"empty title", "", Update{Title: ptr("  ")}, "", false, ErrInvalidTitle},
+		{"too long title", "", Update{Title: ptr(strings.Repeat("a", 201))}, "", false, ErrInvalidTitle},
+		{"missing id", "nope", Update{Done: ptr(true)}, "", false, ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			item, _ := s.Create("old")
+			s.clock = clock.Fixed{T: later}
+			id := item.ID
+			if tc.useID != "" {
+				id = tc.useID
+			}
+			got, err := s.Update(id, tc.upd)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Update(%q, %+v) error = %v, want %v", id, tc.upd, err, tc.wantErr)
+			}
+			if err != nil {
+				if tc.wantErr == ErrInvalidTitle {
+					after, _ := s.Get(item.ID)
+					if after != item {
+						t.Errorf("failed Update changed item to %+v, want %+v", after, item)
+					}
+				}
+				return
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%q, %+v) = %+v, want title %q done %v", id, tc.upd, got, tc.wantTitle, tc.wantDone)
+			}
+			if !got.CreatedAt.Equal(epoch) || !got.UpdatedAt.Equal(later) {
+				t.Errorf("Update(%q, %+v) times = %v, %v, want %v, %v", id, tc.upd, got.CreatedAt, got.UpdatedAt, epoch, later)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	s := newTestStore()
+	item, _ := s.Create("a")
+	tests := []struct {
+		name    string
+		id      string
+		wantErr error
+	}{
+		{"existing", item.ID, nil},
+		{"again", item.ID, ErrNotFound},
+		{"missing", "nope", ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := s.Delete(tc.id); !errors.Is(err, tc.wantErr) {
+				t.Errorf("Delete(%q) = %v, want %v", tc.id, err, tc.wantErr)
+			}
+		})
+	}
+	if got := s.List(ListOptions{}); len(got) != 0 {
+		t.Errorf("List after delete = %d items, want 0", len(got))
+	}
+}
+
+func titles(items []Todo) []string {
+	out := make([]string, len(items))
+	for i, it := range items {
+		out[i] = it.Title
+	}
+	return out
+}
+
+func equal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestList(t *testing.T) {
+	s := newTestStore()
+	// Created in order c0..c4; c1 and c3 are done. All share one fixed time,
+	// so newest-first must come from insertion order.
+	for i, name := range []string{"c0", "c1", "c2", "c3", "c4"} {
+		item, _ := s.Create(name)
+		if i == 1 || i == 3 {
+			s.Update(item.ID, Update{Done: ptr(true)})
+		}
+	}
+	tests := []struct {
+		name string
+		opts ListOptions
+		want []string
+	}{
+		{"all newest first", ListOptions{}, []string{"c4", "c3", "c2", "c1", "c0"}},
+		{"done", ListOptions{Done: ptr(true)}, []string{"c3", "c1"}},
+		{"not done", ListOptions{Done: ptr(false)}, []string{"c4", "c2", "c0"}},
+		{"limit", ListOptions{Limit: 2}, []string{"c4", "c3"}},
+		{"offset", ListOptions{Offset: 3}, []string{"c1", "c0"}},
+		{"limit and offset", ListOptions{Limit: 2, Offset: 1}, []string{"c3", "c2"}},
+		{"filter with paging", ListOptions{Done: ptr(false), Limit: 1, Offset: 1}, []string{"c2"}},
+		{"offset past end", ListOptions{Offset: 10}, []string{}},
+		{"negative offset", ListOptions{Offset: -1, Limit: 1}, []string{"c4"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := titles(s.List(tc.opts))
+			if !equal(got, tc.want) {
+				t.Errorf("List(%+v) = %v, want %v", tc.opts, got, tc.want)
+			}
+		})
+	}
+	if got := newTestStore().List(ListOptions{}); got == nil || len(got) != 0 {
+		t.Errorf("List on empty store = %#v, want empty non-nil slice", got)
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	const workers, perWorker = 16, 50
+	s := newTestStore()
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < perWorker; i++ {
+				item, err := s.Create("x")
+				if err != nil {
+					t.Errorf("Create = %v, want nil", err)
+					return
+				}
+				if _, err := s.Update(item.ID, Update{Done: ptr(true)}); err != nil {
+					t.Errorf("Update(%q) = %v, want nil", item.ID, err)
+				}
+				s.List(ListOptions{Limit: 10})
+				if _, err := s.Get(item.ID); err != nil {
+					t.Errorf("Get(%q) = %v, want nil", item.ID, err)
+				}
+				if i%2 == 0 {
+					if err := s.Delete(item.ID); err != nil {
+						t.Errorf("Delete(%q) = %v, want nil", item.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	want := workers * perWorker / 2
+	if got := len(s.List(ListOptions{})); got != want {
+		t.Errorf("List after concurrent use = %d items, want %d", got, want)
+	}
+}
