 # platform
 
 Services live in services/.
+
+## Health checks
+
+`GET /health` on the api service pings the database. It answers `200` with
+the body `ok` when the ping succeeds, and `503` when it fails.
diff --git a/services/api/health.go b/services/api/health.go
new file mode 100644
index 0000000..1d05aad
--- /dev/null
+++ b/services/api/health.go
@@ -0,0 +1,19 @@
+package main
+
+import "net/http"
+
+// healthHandler answers 200 "ok" when the database responds to a ping,
+// and 503 otherwise.
+func healthHandler(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", http.MethodGet)
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+	if err := conn.Ping(r.Context()); err != nil {
+		http.Error(w, "database unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	w.WriteHeader(http.StatusOK)
+	_, _ = w.Write([]byte("ok"))
+}
