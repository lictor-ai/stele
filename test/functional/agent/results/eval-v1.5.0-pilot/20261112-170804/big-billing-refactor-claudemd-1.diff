@@ -0,0 +1,16 @@
+package billing
+
+import "fmt"
+
+// TaxTable maps a region such as "FR" or "US-CA" to a tax rate in basis
+// points (20% = 2000).
+type TaxTable map[string]int64
+
+// tax returns the tax in cents on a taxable amount for a region.
+func (t TaxTable) tax(region string, taxable int64) (int64, error) {
+	rate, ok := t[region]
+	if !ok {
+		return 0, fmt.Errorf("region %q: %w", region, ErrUnknownRegion)
+	}
+	return mulBasisPoints(taxable, rate), nil
+}
