+"""Locate and parse the ~/.toolrc config file."""
+
+import logging
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+CONFIG_NAME = ".toolrc"
+
+
+def find_config() -> Path | None:
+    """Return the path to .toolrc in the user home directory, if it exists."""
+    path = Path.home() / CONFIG_NAME
+    return path if path.is_file() else None
+
+
+def parse_config(path: Path) -> dict[str, str]:
+    """Parse key=value lines, ignoring blanks and # comments."""
+    values: dict[str, str] = {}
+    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        key, sep, value = line.partition("=")
+        if not sep or not key.strip():
+            logger.warning("%s:%d: ignoring malformed line: %r", path, lineno, raw)
+            continue
+        values[key.strip()] = value.strip()
+    return values
+
+
+def load_config() -> dict[str, str]:
+    """Load the config from the home directory; empty if there is none."""
+    path = find_config()
+    if path is None:
+        logger.debug("No %s found in home directory", CONFIG_NAME)
+        return {}
+    return parse_config(path)
