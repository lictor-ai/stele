+package stats
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestPercentile(t *testing.T) {
+	hundred := make([]float64, 100)
+	for i := range hundred {
+		hundred[i] = float64(i + 1)
+	}
+	tests := []struct {
+		name    string
+		in      []float64
+		p       float64
+		want    float64
+		wantErr error
+	}{
+		{"empty", nil, 50, 0, ErrNoData},
+		{"single p0", []float64{7}, 0, 7, nil},
+		{"single p50", []float64{7}, 50, 7, nil},
+		{"single p100", []float64{7}, 100, 7, nil},
+		{"two p50", []float64{1, 2}, 50, 1, nil},
+		{"two p51", []float64{1, 2}, 51, 2, nil},
+		{"hundred p50", hundred, 50, 50, nil},
+		{"hundred p95", hundred, 95, 95, nil},
+		{"hundred p99", hundred, 99, 99, nil},
+		{"hundred p100", hundred, 100, 100, nil},
+		{"hundred p0", hundred, 0, 1, nil},
+		{"twenty p95", hundred[:20], 95, 19, nil},
+		{"negative p", hundred, -1, 0, ErrBadPercentile},
+		{"p over 100", hundred, 100.5, 0, ErrBadPercentile},
+		{"nan p", hundred, nan(), 0, ErrBadPercentile},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Percentile(tt.in, tt.p)
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Percentile(%s, %v) error = %v, want %v", tt.name, tt.p, err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("Percentile(%s, %v) = %v, want %v", tt.name, tt.p, got, tt.want)
+			}
+		})
+	}
+}
+
+func nan() float64 {
+	var zero float64
+	return zero / zero
+}
+
+func entry(path string, status int, ms int, ts time.Time) logparse.Entry {
+	return logparse.Entry{Path: path, Status: status, RequestTime: time.Duration(ms) * time.Millisecond, Time: ts}
+}
+
+func TestReportEmpty(t *testing.T) {
+	r := NewCollector().Report(0, 10)
+	if r.TotalRequests != 0 || len(r.TopPaths) != 0 || len(r.Errors5xxHour) != 0 || r.RequestTimeMS != (Percentiles{}) {
+		t.Errorf("Report() on empty = %+v, want zero report", r)
+	}
+	if r.TopPaths == nil || r.Errors5xxHour == nil {
+		t.Errorf("Report() on empty has nil slices, want empty so JSON prints []")
+	}
+}
+
+func TestReportSingle(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/a", 200, 42, time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)))
+	r := c.Report(0, 10)
+	want := Percentiles{42, 42, 42}
+	if r.TotalRequests != 1 || r.StatusClasses.S2xx != 1 || r.RequestTimeMS != want {
+		t.Errorf("Report() = %+v, want 1 request, one 2xx, percentiles %v", r, want)
+	}
+}
+
+func TestReport(t *testing.T) {
+	h := func(hour, min int) time.Time { return time.Date(2026, 10, 10, hour, min, 0, 0, time.UTC) }
+	c := NewCollector()
+	for _, e := range []logparse.Entry{
+		entry("/b", 200, 10, h(1, 5)),
+		entry("/b", 301, 20, h(1, 6)),
+		entry("/a", 404, 30, h(1, 7)),
+		entry("/a", 500, 40, h(1, 8)),
+		entry("/c", 503, 50, h(1, 59)),
+		entry("/c", 502, 60, h(3, 0)),
+		entry("/b", 200, 70, h(3, 1)),
+		entry("/d", 99, 80, h(3, 2)), // outside any class
+	} {
+		c.Add(e)
+	}
+	r := c.Report(4, 3)
+	if r.TotalRequests != 8 || r.Malformed != 4 {
+		t.Errorf("totals = %d/%d, want 8/4", r.TotalRequests, r.Malformed)
+	}
+	if want := (StatusClasses{2, 1, 1, 3}); r.StatusClasses != want {
+		t.Errorf("StatusClasses = %+v, want %+v", r.StatusClasses, want)
+	}
+	// ties on count 2 are ordered by path: /a, /c
+	if want := []PathCount{{"/b", 3}, {"/a", 2}, {"/c", 2}}; !slices.Equal(r.TopPaths, want) {
+		t.Errorf("TopPaths = %v, want %v", r.TopPaths, want)
+	}
+	if want := []HourCount{{"2026-10-10T01:00:00Z", 2}, {"2026-10-10T03:00:00Z", 1}}; !slices.Equal(r.Errors5xxHour, want) {
+		t.Errorf("Errors5xxHour = %v, want %v", r.Errors5xxHour, want)
+	}
+	if want := (Percentiles{40, 80, 80}); r.RequestTimeMS != want {
+		t.Errorf("RequestTimeMS = %+v, want %+v", r.RequestTimeMS, want)
+	}
+}
+
+func TestReportTopN(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/a", 200, 1, time.Time{}))
+	c.Add(entry("/b", 200, 1, time.Time{}))
+	tests := []struct {
+		topN int
+		want int
+	}{{-1, 0}, {0, 0}, {1, 1}, {2, 2}, {100, 2}}
+	for _, tt := range tests {
+		t.Run(fmt.Sprint(tt.topN), func(t *testing.T) {
+			if got := len(c.Report(0, tt.topN).TopPaths); got != tt.want {
+				t.Errorf("len(Report(0, %d).TopPaths) = %d, want %d", tt.topN, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestReportTimezoneHour(t *testing.T) {
+	zone := time.FixedZone("x", 2*3600)
+	c := NewCollector()
+	c.Add(entry("/a", 500, 1, time.Date(2026, 10, 10, 0, 30, 0, 0, zone)))
+	got := c.Report(0, 1).Errors5xxHour
+	if want := []HourCount{{"2026-10-09T22:00:00Z", 1}}; !slices.Equal(got, want) {
+		t.Errorf("Errors5xxHour = %v, want %v", got, want)
+	}
+}
+
+func TestWrite(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/a", 500, 12, time.Date(2026, 10, 10, 1, 0, 0, 0, time.UTC)))
+	r := c.Report(2, 5)
+
+	var text bytes.Buffer
+	if err := r.WriteText(&text); err != nil {
+		t.Fatalf("WriteText() error = %v", err)
+	}
+	for _, want := range []string{"Total requests:   1", "Malformed lines:  2", "/a", "p99  12.000", "2026-10-10T01:00:00Z  1"} {
+		if !strings.Contains(text.String(), want) {
+			t.Errorf("WriteText() output missing %q:\n%s", want, text.String())
+		}
+	}
+
+	var js bytes.Buffer
+	if err := r.WriteJSON(&js); err != nil {
+		t.Fatalf("WriteJSON() error = %v", err)
+	}
+	var back map[string]any
+	if err := json.Unmarshal(js.Bytes(), &back); err != nil {
+		t.Fatalf("WriteJSON() output is not JSON: %v", err)
+	}
+	for _, key := range []string{"total_requests", "malformed_lines", "top_paths", "status_classes", "request_time_ms", "errors_5xx_per_hour"} {
+		if _, ok := back[key]; !ok {
+			t.Errorf("WriteJSON() output missing key %q", key)
+		}
+	}
+}
+
+type failWriter struct{}
+
+func (failWriter) Write([]byte) (int, error) { return 0, errors.New("disk full") }
+
+func TestWriteError(t *testing.T) {
+	r := NewCollector().Report(0, 1)
+	if err := r.WriteText(failWriter{}); err == nil {
+		t.Error("WriteText(failing writer) error = nil, want error")
+	}
+	if err := r.WriteJSON(failWriter{}); err == nil {
+		t.Error("WriteJSON(failing writer) error = nil, want error")
+	}
+}
