+package stats
+
+import "errors"
+
+// ErrNoData is returned when a statistic is asked of an empty sample.
+var ErrNoData = errors.New("no data")
+
+// ErrBadPercentile is returned for a percentile outside 0..100.
+var ErrBadPercentile = errors.New("percentile out of range")
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..2621188
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,183 @@
+// Package stats computes summary statistics over parsed log entries.
+package stats
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// hourLayout formats the start of an hour in UTC.
+const hourLayout = "2006-01-02T15:00:00Z"
+
+// PathCount is a path and how many requests it received.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// HourCount is the number of 5xx responses in one hour.
+type HourCount struct {
+	// Hour is the start of the hour in UTC, RFC 3339.
+	Hour  string `json:"hour"`
+	Count int    `json:"count"`
+}
+
+// StatusClasses counts requests per status class.
+type StatusClasses struct {
+	S2xx int `json:"2xx"`
+	S3xx int `json:"3xx"`
+	S4xx int `json:"4xx"`
+	S5xx int `json:"5xx"`
+}
+
+// Percentiles holds request-time percentiles in milliseconds.
+type Percentiles struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// Report is the summary of a log.
+type Report struct {
+	TotalRequests int           `json:"total_requests"`
+	Malformed     int           `json:"malformed_lines"`
+	TopPaths      []PathCount   `json:"top_paths"`
+	StatusClasses StatusClasses `json:"status_classes"`
+	RequestTimeMS Percentiles   `json:"request_time_ms"`
+	Errors5xxHour []HourCount   `json:"errors_5xx_per_hour"`
+}
+
+// Collector accumulates entries. The zero value is not usable; call
+// NewCollector. It is not safe for concurrent use.
+type Collector struct {
+	total     int
+	paths     map[string]int
+	classes   StatusClasses
+	times     []float64
+	errorHour map[string]int
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{paths: map[string]int{}, errorHour: map[string]int{}}
+}
+
+// Add records one entry.
+func (c *Collector) Add(e logparse.Entry) {
+	c.total++
+	c.paths[e.Path]++
+	switch {
+	case e.Status >= 200 && e.Status < 300:
+		c.classes.S2xx++
+	case e.Status >= 300 && e.Status < 400:
+		c.classes.S3xx++
+	case e.Status >= 400 && e.Status < 500:
+		c.classes.S4xx++
+	case e.Status >= 500 && e.Status < 600:
+		c.classes.S5xx++
+		c.errorHour[e.Time.UTC().Format(hourLayout)]++
+	}
+	c.times = append(c.times, float64(e.RequestTime)/float64(time.Millisecond))
+}
+
+// Report builds the report. malformed is the count of skipped lines and topN
+// the number of paths to list; a topN below zero is treated as zero. Paths
+// with equal counts are ordered alphabetically.
+func (c *Collector) Report(malformed, topN int) Report {
+	r := Report{
+		TotalRequests: c.total,
+		Malformed:     malformed,
+		TopPaths:      []PathCount{},
+		StatusClasses: c.classes,
+		Errors5xxHour: []HourCount{},
+	}
+	for p, n := range c.paths {
+		r.TopPaths = append(r.TopPaths, PathCount{Path: p, Count: n})
+	}
+	sort.Slice(r.TopPaths, func(i, j int) bool {
+		a, b := r.TopPaths[i], r.TopPaths[j]
+		if a.Count != b.Count {
+			return a.Count > b.Count
+		}
+		return a.Path < b.Path
+	})
+	if topN < 0 {
+		topN = 0
+	}
+	if len(r.TopPaths) > topN {
+		r.TopPaths = r.TopPaths[:topN]
+	}
+	for h, n := range c.errorHour {
+		r.Errors5xxHour = append(r.Errors5xxHour, HourCount{Hour: h, Count: n})
+	}
+	sort.Slice(r.Errors5xxHour, func(i, j int) bool { return r.Errors5xxHour[i].Hour < r.Errors5xxHour[j].Hour })
+
+	sorted := append([]float64(nil), c.times...)
+	sort.Float64s(sorted)
+	// An empty sample leaves the percentiles at zero.
+	r.RequestTimeMS.P50, _ = Percentile(sorted, 50)
+	r.RequestTimeMS.P95, _ = Percentile(sorted, 95)
+	r.RequestTimeMS.P99, _ = Percentile(sorted, 99)
+	return r
+}
+
+// Percentile returns the p-th percentile (0..100) of an ascending sample using
+// the nearest-rank method. It returns ErrNoData for an empty sample and
+// ErrBadPercentile if p is outside 0..100 or not a number.
+func Percentile(sorted []float64, p float64) (float64, error) {
+	if math.IsNaN(p) || p < 0 || p > 100 {
+		return 0, fmt.Errorf("percentile %v: %w", p, ErrBadPercentile)
+	}
+	if len(sorted) == 0 {
+		return 0, fmt.Errorf("percentile %v: %w", p, ErrNoData)
+	}
+	rank := int(math.Ceil(p * float64(len(sorted)) / 100))
+	if rank < 1 {
+		rank = 1
+	}
+	return sorted[rank-1], nil
+}
+
+// WriteJSON writes the report as indented JSON.
+func (r Report) WriteJSON(w io.Writer) error {
+	enc := json.NewEncoder(w)
+	enc.SetIndent("", "  ")
+	if err := enc.Encode(r); err != nil {
+		return fmt.Errorf("write json report: %w", err)
+	}
+	return nil
+}
+
+// WriteText writes the report as a plain-text table.
+func (r Report) WriteText(w io.Writer) error {
+	var err error
+	p := func(format string, args ...any) {
+		if err == nil {
+			_, err = fmt.Fprintf(w, format, args...)
+		}
+	}
+	p("Total requests:   %d\n", r.TotalRequests)
+	p("Malformed lines:  %d\n\n", r.Malformed)
+	p("Top paths\n")
+	for _, pc := range r.TopPaths {
+		p("  %8d  %s\n", pc.Count, pc.Path)
+	}
+	p("\nStatus classes\n")
+	p("  2xx  %d\n  3xx  %d\n  4xx  %d\n  5xx  %d\n", r.StatusClasses.S2xx, r.StatusClasses.S3xx, r.StatusClasses.S4xx, r.StatusClasses.S5xx)
+	p("\nRequest time (ms)\n")
+	p("  p50  %.3f\n  p95  %.3f\n  p99  %.3f\n", r.RequestTimeMS.P50, r.RequestTimeMS.P95, r.RequestTimeMS.P99)
+	p("\n5xx errors per hour (UTC)\n")
+	for _, h := range r.Errors5xxHour {
+		p("  %s  %d\n", h.Hour, h.Count)
+	}
+	if err != nil {
+		return fmt.Errorf("write text report: %w", err)
+	}
+	return nil
+}
