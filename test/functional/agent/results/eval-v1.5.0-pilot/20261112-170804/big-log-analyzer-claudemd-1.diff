index 0000000..3f97cad
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,146 @@
+// Package logparse parses nginx access logs in the combined format with the
+// request time appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// timeLayout is the nginx $time_local layout.
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+var lineRE = regexp.MustCompile(
+	`^(\S+) \S+ \S+ \[([^\]]+)\] "([^"]*)" (\d{3}) (\d+|-) "[^"]*" "[^"]*" (\d+(?:\.\d+)?)$`)
+
+// Entry is one parsed request.
+type Entry struct {
+	// Remote is the client address.
+	Remote string
+	// Time is when the request was received.
+	Time time.Time
+	// Method is the HTTP method.
+	Method string
+	// Path is the request path with the query string and fragment removed.
+	Path string
+	// Status is the HTTP status code.
+	Status int
+	// Bytes is the response body size; 0 when the log has "-".
+	Bytes int64
+	// RequestTime is how long the request took.
+	RequestTime time.Duration
+}
+
+// Parse parses one log line. It returns an error wrapping ErrMalformed if the
+// line does not match the format.
+func Parse(line string) (Entry, error) {
+	m := lineRE.FindStringSubmatch(strings.TrimRight(line, "\r\n"))
+	if m == nil {
+		return Entry{}, fmt.Errorf("parse %q: %w", truncate(line), ErrMalformed)
+	}
+	ts, err := time.Parse(timeLayout, m[2])
+	if err != nil {
+		return Entry{}, fmt.Errorf("parse time %q: %w", m[2], ErrMalformed)
+	}
+	parts := strings.Split(m[3], " ")
+	if len(parts) != 3 || parts[0] == "" || parts[1] == "" || !strings.HasPrefix(parts[2], "HTTP/") {
+		return Entry{}, fmt.Errorf("parse request %q: %w", m[3], ErrMalformed)
+	}
+	status, err := strconv.Atoi(m[4])
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, fmt.Errorf("parse status %q: %w", m[4], ErrMalformed)
+	}
+	var size int64
+	if m[5] != "-" {
+		size, err = strconv.ParseInt(m[5], 10, 64)
+		if err != nil {
+			return Entry{}, fmt.Errorf("parse size %q: %w", m[5], ErrMalformed)
+		}
+	}
+	secs, err := strconv.ParseFloat(m[6], 64)
+	if err != nil || secs > 1e9 {
+		return Entry{}, fmt.Errorf("parse request time %q: %w", m[6], ErrMalformed)
+	}
+	return Entry{
+		Remote:      m[1],
+		Time:        ts,
+		Method:      parts[0],
+		Path:        stripQuery(parts[1]),
+		Status:      status,
+		Bytes:       size,
+		RequestTime: time.Duration(secs*float64(time.Second) + 0.5),
+	}, nil
+}
+
+func stripQuery(target string) string {
+	if i := strings.IndexAny(target, "?#"); i >= 0 {
+		return target[:i]
+	}
+	return target
+}
+
+func truncate(s string) string {
+	const limit = 80
+	if len(s) > limit {
+		return s[:limit] + "..."
+	}
+	return s
+}
+
+// maxLine is the longest line that is parsed; longer lines are malformed.
+const maxLine = 64 * 1024
+
+// Read parses every line of r and calls fn for each valid entry. It returns
+// the number of malformed lines, which are skipped. Blank lines are ignored.
+// It stops with ctx's error if ctx is cancelled, or with the error from r.
+func Read(ctx context.Context, r io.Reader, fn func(Entry)) (malformed int, err error) {
+	br := bufio.NewReaderSize(r, 64*1024)
+	for {
+		if err := ctx.Err(); err != nil {
+			return malformed, err
+		}
+		line, tooLong, rerr := readLine(br)
+		if rerr != nil && !errors.Is(rerr, io.EOF) {
+			return malformed, fmt.Errorf("read log: %w", rerr)
+		}
+		if tooLong {
+			malformed++
+		} else if strings.TrimSpace(line) != "" {
+			if e, perr := Parse(line); perr != nil {
+				malformed++
+			} else {
+				fn(e)
+			}
+		}
+		if rerr != nil {
+			return malformed, nil
+		}
+	}
+}
+
+// readLine reads one line, discarding anything past maxLine. At end of input
+// it returns io.EOF together with any final unterminated line.
+func readLine(br *bufio.Reader) (line string, tooLong bool, err error) {
+	var sb strings.Builder
+	for {
+		chunk, isPrefix, err := br.ReadLine()
+		if err != nil {
+			return sb.String(), tooLong, err
+		}
+		if sb.Len()+len(chunk) > maxLine {
+			tooLong = true
+		} else if !tooLong {
+			sb.Write(chunk)
+		}
+		if !isPrefix {
+			return sb.String(), tooLong, nil
+		}
+	}
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..d554e81
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,110 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+const good = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	utc := func(h, m, s int) time.Time { return time.Date(2026, 10, 10, h, m, s, 0, time.UTC) }
+	tests := []struct {
+		name    string
+		line    string
+		want    Entry
+		wantErr bool
+	}{
+		{"valid", good, Entry{"203.0.113.9", utc(13, 55, 36), "GET", "/api/items", 200, 512, 42 * time.Millisecond}, false},
+		{"crlf", good + "\r\n", Entry{"203.0.113.9", utc(13, 55, 36), "GET", "/api/items", 200, 512, 42 * time.Millisecond}, false},
+		{"dash size and zone", `1.2.3.4 - bob [10/Oct/2026:13:55:36 +0200] "POST /x HTTP/2.0" 304 - "http://r/" "ua with space" 1`,
+			Entry{"1.2.3.4", utc(11, 55, 36), "POST", "/x", 304, 0, time.Second}, false},
+		{"bare query", `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /?a=1 HTTP/1.1" 200 1 "-" "-" 0.5`,
+			Entry{"1.2.3.4", utc(13, 55, 36), "GET", "/", 200, 1, 500 * time.Millisecond}, false},
+		{"empty", "", Entry{}, true},
+		{"garbage", "hello world", Entry{}, true},
+		{"missing request time", strings.TrimSuffix(good, " 0.042"), Entry{}, true},
+		{"negative request time", strings.Replace(good, "0.042", "-0.042", 1), Entry{}, true},
+		{"bad day", strings.Replace(good, "10/Oct/2026", "32/Oct/2026", 1), Entry{}, true},
+		{"bad month", strings.Replace(good, "Oct", "Foo", 1), Entry{}, true},
+		{"status out of range", strings.Replace(good, " 200 ", " 999 ", 1), Entry{}, true},
+		{"status letters", strings.Replace(good, " 200 ", " abc ", 1), Entry{}, true},
+		{"no request line", strings.Replace(good, `"GET /api/items?id=3 HTTP/1.1"`, `"-"`, 1), Entry{}, true},
+		{"short request line", strings.Replace(good, `GET /api/items?id=3 HTTP/1.1`, `GET /api`, 1), Entry{}, true},
+		{"huge size", strings.Replace(good, " 512 ", " 99999999999999999999 ", 1), Entry{}, true},
+		{"huge request time", strings.Replace(good, "0.042", "99999999999999", 1), Entry{}, true},
+		{"trailing junk", good + " extra", Entry{}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Parse(tt.line)
+			if tt.wantErr {
+				if !errors.Is(err, ErrMalformed) {
+					t.Fatalf("Parse(%q) error = %v, want ErrMalformed", tt.line, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v, want nil", tt.line, err)
+			}
+			if got.Remote != tt.want.Remote || !got.Time.Equal(tt.want.Time) || got.Method != tt.want.Method ||
+				got.Path != tt.want.Path || got.Status != tt.want.Status || got.Bytes != tt.want.Bytes ||
+				got.RequestTime != tt.want.RequestTime {
+				t.Errorf("Parse(%q) = %+v, want %+v", tt.line, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRead(t *testing.T) {
+	long := strings.Repeat("a", 200*1024)
+	tests := []struct {
+		name          string
+		in            string
+		wantEntries   int
+		wantMalformed int
+	}{
+		{"empty input", "", 0, 0},
+		{"only blank lines", "\n\n  \n", 0, 0},
+		{"single request", good + "\n", 1, 0},
+		{"no trailing newline", good, 1, 0},
+		{"mixed", good + "\nbroken\n" + good + "\n\n", 2, 1},
+		{"all malformed", "a\nb\nc", 0, 3},
+		{"overlong line", long + "\n" + good + "\n", 1, 1},
+		{"overlong final line", good + "\n" + long, 1, 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			n := 0
+			bad, err := Read(context.Background(), strings.NewReader(tt.in), func(Entry) { n++ })
+			if err != nil {
+				t.Fatalf("Read(%q) error = %v, want nil", tt.name, err)
+			}
+			if n != tt.wantEntries || bad != tt.wantMalformed {
+				t.Errorf("Read(%q) = %d entries, %d malformed, want %d, %d", tt.name, n, bad, tt.wantEntries, tt.wantMalformed)
+			}
+		})
+	}
+}
+
+func TestReadCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := Read(ctx, strings.NewReader(good+"\n"), func(Entry) {})
+	if !errors.Is(err, context.Canceled) {
+		t.Errorf("Read(cancelled ctx) error = %v, want context.Canceled", err)
+	}
+}
+
+type failReader struct{}
+
+func (failReader) Read([]byte) (int, error) { return 0, errors.New("boom") }
+
+func TestReadError(t *testing.T) {
+	if _, err := Read(context.Background(), failReader{}, func(Entry) {}); err == nil {
+		t.Error("Read(failing reader) error = nil, want error")
+	}
+}
