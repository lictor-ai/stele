diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..93913b0
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,98 @@
+// Command loga summarises nginx access logs.
+//
+// Usage:
+//
+//	loga [-top N] [-json] [file ...]
+//
+// With no files it reads standard input. It exits 0 on success, 1 if a file
+// cannot be read and 2 on bad flags.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// usageError marks a problem with the command line, which exits with 2.
+type usageError struct{ err error }
+
+func (e usageError) Error() string { return e.err.Error() }
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	stop()
+	if err == nil || errors.Is(err, flag.ErrHelp) {
+		return
+	}
+	fmt.Fprintln(os.Stderr, "loga:", err)
+	var ue usageError
+	if errors.As(err, &ue) {
+		os.Exit(2)
+	}
+	os.Exit(1)
+}
+
+func run(ctx context.Context, args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of top paths to show")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return err
+		}
+		return usageError{err}
+	}
+	if *top < 0 {
+		return usageError{fmt.Errorf("-top must not be negative, got %d", *top)}
+	}
+
+	col := stats.NewCollector()
+	malformed := 0
+	add := func(e logparse.Entry) { col.Add(e) }
+
+	if fs.NArg() == 0 {
+		n, err := logparse.Read(ctx, stdin, add)
+		if err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+		malformed += n
+	}
+	for _, name := range fs.Args() {
+		n, err := readFile(ctx, name, add)
+		if err != nil {
+			return err
+		}
+		malformed += n
+	}
+
+	report := col.Report(malformed, *top)
+	if *asJSON {
+		return report.WriteJSON(stdout)
+	}
+	return report.WriteText(stdout)
+}
+
+func readFile(ctx context.Context, name string, fn func(logparse.Entry)) (int, error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return 0, fmt.Errorf("open log: %w", err)
+	}
+	defer f.Close()
+	n, err := logparse.Read(ctx, f, fn)
+	if err != nil {
+		return n, fmt.Errorf("read %s: %w", name, err)
+	}
+	return n, nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..ab92b77
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,117 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/app/internal/stats"
+)
+
+const logA = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 500 10 "-" "curl/8.0" 0.100
+not a log line
+`
+
+const logB = `198.51.100.1 - - [10/Oct/2026:14:01:00 +0000] "POST /login HTTP/1.1" 302 0 "-" "ua" 0.010
+`
+
+func writeFile(t *testing.T, name, content string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), name)
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+	return p
+}
+
+func TestRun(t *testing.T) {
+	a := writeFile(t, "a.log", logA)
+	b := writeFile(t, "b.log", logB)
+	missing := filepath.Join(t.TempDir(), "nope.log")
+
+	tests := []struct {
+		name       string
+		args       []string
+		stdin      string
+		wantUsage  bool
+		wantErr    bool
+		wantStdout []string
+	}{
+		{"stdin text", nil, logA, false, false, []string{"Total requests:   2", "Malformed lines:  1", "/api/items", "5xx  1", "2026-10-10T13:00:00Z  1"}},
+		{"file", []string{a}, "", false, false, []string{"Total requests:   2"}},
+		{"two files", []string{a, b}, "", false, false, []string{"Total requests:   3", "/login", "3xx  1"}},
+		{"empty stdin", nil, "", false, false, []string{"Total requests:   0", "p50  0.000"}},
+		{"top 1", []string{"-top", "1", a, b}, "", false, false, []string{"/api/items"}},
+		{"missing file", []string{missing}, "", false, true, nil},
+		{"bad flag", []string{"-nope"}, "", true, true, nil},
+		{"negative top", []string{"-top", "-1"}, "", true, true, nil},
+		{"non-numeric top", []string{"-top", "x"}, "", true, true, nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(context.Background(), tt.args, strings.NewReader(tt.stdin), &out, &errOut)
+			var ue usageError
+			if gotUsage := errors.As(err, &ue); gotUsage != tt.wantUsage {
+				t.Fatalf("run(%v) usage error = %v, want %v (err %v)", tt.args, gotUsage, tt.wantUsage, err)
+			}
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("run(%v) error = %v, want error %v", tt.args, err, tt.wantErr)
+			}
+			for _, want := range tt.wantStdout {
+				if !strings.Contains(out.String(), want) {
+					t.Errorf("run(%v) stdout missing %q:\n%s", tt.args, want, out.String())
+				}
+			}
+		})
+	}
+}
+
+func TestRunTopLimitsPaths(t *testing.T) {
+	var out bytes.Buffer
+	err := run(context.Background(), []string{"-top", "1"}, strings.NewReader(logA+logB), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run() error = %v", err)
+	}
+	if strings.Contains(out.String(), "/login") {
+		t.Errorf("run(-top 1) listed /login, want only the top path:\n%s", out.String())
+	}
+}
+
+func TestRunJSON(t *testing.T) {
+	var out bytes.Buffer
+	err := run(context.Background(), []string{"-json"}, strings.NewReader(logA+logB), &out, &bytes.Buffer{})
+	if err != nil {
+		t.Fatalf("run(-json) error = %v", err)
+	}
+	var r stats.Report
+	if err := json.Unmarshal(out.Bytes(), &r); err != nil {
+		t.Fatalf("run(-json) output is not a report: %v\n%s", err, out.String())
+	}
+	if r.TotalRequests != 3 || r.Malformed != 1 || r.StatusClasses.S5xx != 1 || r.StatusClasses.S3xx != 1 {
+		t.Errorf("run(-json) report = %+v, want 3 requests, 1 malformed, one 5xx, one 3xx", r)
+	}
+	if len(r.TopPaths) != 2 || r.TopPaths[0].Path != "/api/items" || r.TopPaths[0].Count != 2 {
+		t.Errorf("run(-json) TopPaths = %v, want /api/items first with 2", r.TopPaths)
+	}
+	if r.RequestTimeMS.P50 != 42 || r.RequestTimeMS.P99 != 100 {
+		t.Errorf("run(-json) RequestTimeMS = %+v, want p50 42 and p99 100", r.RequestTimeMS)
+	}
+}
+
+func TestRunHelp(t *testing.T) {
+	err := run(context.Background(), []string{"-h"}, strings.NewReader(""), &bytes.Buffer{}, &bytes.Buffer{})
+	if err == nil {
+		t.Error("run(-h) error = nil, want flag.ErrHelp")
+	}
+	var ue usageError
+	if errors.As(err, &ue) {
+		t.Errorf("run(-h) returned a usage error, want help to exit 0")
+	}
+}
