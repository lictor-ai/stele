+
+func newTestStore() *Store {
+	return NewStore(clock.Fixed{T: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)})
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name    string
+		title   string
+		want    string
+		wantErr error
+	}{
+		{"plain", "buy milk", "buy milk", nil},
+		{"trimmed", "  buy milk \n", "buy milk", nil},
+		{"empty", "", "", ErrInvalidTitle},
+		{"blank", "   ", "", ErrInvalidTitle},
+		{"max length", strings.Repeat("a", 200), strings.Repeat("a", 200), nil},
+		{"too long", strings.Repeat("a", 201), "", ErrInvalidTitle},
+		{"unicode counts characters", strings.Repeat("é", 200), strings.Repeat("é", 200), nil},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			got, err := s.Create(tc.title)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Create(%q) error = %v, want %v", tc.title, err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if got.Title != tc.want || got.Done || got.ID == "" {
+				t.Errorf("Create(%q) = %+v, want title %q, not done, with id", tc.title, got, tc.want)
+			}
+			if !got.CreatedAt.Equal(got.UpdatedAt) || got.CreatedAt.IsZero() {
+				t.Errorf("Create(%q) times = %v, %v, want equal and set", tc.title, got.CreatedAt, got.UpdatedAt)
+			}
+		})
+	}
+}
+
+func TestGetUpdateDelete(t *testing.T) {
+	s := newTestStore()
+	c, err := s.Create("one")
+	if err != nil {
+		t.Fatal(err)
+	}
+	title, done := "two", true
+	empty := " "
+
+	tests := []struct {
+		name    string
+		id      string
+		u       Update
+		want    Todo
+		wantErr error
+	}{
+		{"title only", c.ID, Update{Title: &title}, Todo{Title: "two"}, nil},
+		{"done only", c.ID, Update{Done: &done}, Todo{Title: "two", Done: true}, nil},
+		{"both", c.ID, Update{Title: &title, Done: &done}, Todo{Title: "two", Done: true}, nil},
+		{"no change", c.ID, Update{}, Todo{Title: "two", Done: true}, nil},
+		{"bad title", c.ID, Update{Title: &empty}, Todo{}, ErrInvalidTitle},
+		{"missing", "nope", Update{Done: &done}, Todo{}, ErrNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.Update(tc.id, tc.u)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Update(%q) error = %v, want %v", tc.id, err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if got.Title != tc.want.Title || got.Done != tc.want.Done || got.ID != c.ID {
+				t.Errorf("Update(%q) = %+v, want title %q done %v", tc.id, got, tc.want.Title, tc.want.Done)
+			}
+			g, err := s.Get(c.ID)
+			if err != nil || g.Title != got.Title || g.Done != got.Done {
+				t.Errorf("Get(%q) = %+v, %v, want %+v", c.ID, g, err, got)
+			}
+		})
+	}
+
+	if _, err := s.Get("nope"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(nope) error = %v, want ErrNotFound", err)
+	}
+	if err := s.Delete(c.ID); err != nil {
+		t.Errorf("Delete(%q) = %v, want nil", c.ID, err)
+	}
+	if err := s.Delete(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Delete(%q) again = %v, want ErrNotFound", c.ID, err)
+	}
+	if _, err := s.Get(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(%q) after delete error = %v, want ErrNotFound", c.ID, err)
+	}
+}
+
+func titles(ts []Todo) string {
+	var names []string
+	for _, t := range ts {
+		names = append(names, t.Title)
+	}
+	return strings.Join(names, ",")
+}
+
+func TestList(t *testing.T) {
+	s := newTestStore()
+	yes, no := true, false
+	for i := 0; i < 5; i++ {
+		c, err := s.Create(fmt.Sprintf("t%d", i))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%2 == 0 {
+			if _, err := s.Update(c.ID, Update{Done: &yes}); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	tests := []struct {
+		name string
+		opts ListOptions
+		want string
+	}{
+		{"all newest first", ListOptions{}, "t4,t3,t2,t1,t0"},
+		{"done", ListOptions{Done: &yes}, "t4,t2,t0"},
+		{"not done", ListOptions{Done: &no}, "t3,t1"},
+		{"limit", ListOptions{Limit: 2}, "t4,t3"},
+		{"offset", ListOptions{Offset: 3}, "t1,t0"},
+		{"limit and offset", ListOptions{Limit: 2, Offset: 1}, "t3,t2"},
+		{"filter with paging", ListOptions{Done: &yes, Limit: 1, Offset: 1}, "t2"},
+		{"offset past end", ListOptions{Offset: 10}, ""},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := titles(s.List(tc.opts)); got != tc.want {
+				t.Errorf("List(%+v) = %q, want %q", tc.opts, got, tc.want)
+			}
+		})
+	}
+	if got := newTestStore().List(ListOptions{}); got == nil || len(got) != 0 {
+		t.Errorf("List on empty store = %v, want empty non-nil slice", got)
+	}
+}
+
+func TestConcurrent(t *testing.T) {
+	s := newTestStore()
+	const workers, per = 8, 50
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			done := true
+			for i := 0; i < per; i++ {
+				c, err := s.Create("x")
+				if err != nil {
+					t.Errorf("Create = %v", err)
+					return
+				}
+				if _, err := s.Update(c.ID, Update{Done: &done}); err != nil {
+					t.Errorf("Update(%q) = %v", c.ID, err)
+				}
+				s.List(ListOptions{Limit: 10})
+				if _, err := s.Get(c.ID); err != nil {
+					t.Errorf("Get(%q) = %v", c.ID, err)
+				}
+				if i%2 == 0 {
+					if err := s.Delete(c.ID); err != nil {
+						t.Errorf("Delete(%q) = %v", c.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if got, want := len(s.List(ListOptions{})), workers*per/2; got != want {
+		t.Errorf("List count = %d, want %d", got, want)
+	}
+}
