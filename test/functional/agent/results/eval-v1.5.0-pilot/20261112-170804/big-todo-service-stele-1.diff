--- /dev/null
+++ b/internal/todo/errors.go
@@ -0,0 +1,11 @@
+package todo
+
+import "errors"
+
+// Errors returned by the Store.
+var (
+	// ErrNotFound means no todo has the requested id.
+	ErrNotFound = errors.New("todo not found")
+	// ErrInvalidTitle means the title is empty or too long after trimming.
+	ErrInvalidTitle = errors.New("title must be 1 to 200 characters")
+)
diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..313cea1
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,160 @@
+// Package todo holds the Todo type and an in-memory Store.
+package todo
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// MaxTitleLen is the longest allowed title, in characters.
+const MaxTitleLen = 200
+
+// Todo is a single task.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Update describes a partial change. Nil fields are left alone.
+type Update struct {
+	Title *string
+	Done  *bool
+}
+
+// ListOptions selects which todos List returns.
+type ListOptions struct {
+	// Done, when not nil, keeps only todos with this done value.
+	Done *bool
+	// Limit is the maximum number of results. Zero or less means no limit.
+	Limit int
+	// Offset is the number of matching todos to skip.
+	Offset int
+}
+
+// Store keeps todos in memory. It is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards items.
+	mu sync.RWMutex
+	// items holds todos in creation order, oldest first.
+	items []*Todo
+}
+
+// NewStore returns an empty Store that takes time from c.
+func NewStore(c clock.Clock) *Store {
+	return &Store{clock: c}
+}
+
+func cleanTitle(title string) (string, error) {
+	t := strings.TrimSpace(title)
+	if n := utf8.RuneCountInString(t); n < 1 || n > MaxTitleLen {
+		return "", fmt.Errorf("title of %d characters: %w", n, ErrInvalidTitle)
+	}
+	return t, nil
+}
+
+// Create adds a todo with the given title.
+func (s *Store) Create(title string) (Todo, error) {
+	t, err := cleanTitle(title)
+	if err != nil {
+		return Todo{}, err
+	}
+	now := s.clock.Now()
+	item := &Todo{ID: id.New(), Title: t, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	s.items = append(s.items, item)
+	s.mu.Unlock()
+	return *item, nil
+}
+
+func (s *Store) find(todoID string) int {
+	for i, it := range s.items {
+		if it.ID == todoID {
+			return i
+		}
+	}
+	return -1
+}
+
+// Get returns the todo with the given id.
+func (s *Store) Get(todoID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	i := s.find(todoID)
+	if i < 0 {
+		return Todo{}, fmt.Errorf("get todo %s: %w", todoID, ErrNotFound)
+	}
+	return *s.items[i], nil
+}
+
+// Update applies u to the todo with the given id and returns the result.
+func (s *Store) Update(todoID string, u Update) (Todo, error) {
+	var title string
+	if u.Title != nil {
+		t, err := cleanTitle(*u.Title)
+		if err != nil {
+			return Todo{}, err
+		}
+		title = t
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	i := s.find(todoID)
+	if i < 0 {
+		return Todo{}, fmt.Errorf("update todo %s: %w", todoID, ErrNotFound)
+	}
+	it := s.items[i]
+	if u.Title != nil {
+		it.Title = title
+	}
+	if u.Done != nil {
+		it.Done = *u.Done
+	}
+	it.UpdatedAt = s.clock.Now()
+	return *it, nil
+}
+
+// Delete removes the todo with the given id.
+func (s *Store) Delete(todoID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	i := s.find(todoID)
+	if i < 0 {
+		return fmt.Errorf("delete todo %s: %w", todoID, ErrNotFound)
+	}
+	s.items = append(s.items[:i], s.items[i+1:]...)
+	return nil
+}
+
+// List returns todos newest first, filtered and paginated by opts.
+func (s *Store) List(opts ListOptions) []Todo {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	skip := opts.Offset
+	for i := len(s.items) - 1; i >= 0; i-- {
+		it := s.items[i]
+		if opts.Done != nil && it.Done != *opts.Done {
+			continue
+		}
+		if skip > 0 {
+			skip--
+			continue
+		}
+		if opts.Limit > 0 && len(out) >= opts.Limit {
+			break
+		}
+		out = append(out, *it)
+	}
+	return out
+}
