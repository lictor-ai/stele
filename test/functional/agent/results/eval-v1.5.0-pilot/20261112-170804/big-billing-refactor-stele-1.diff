index 0000000..5f25d79
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,101 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// DiscountKind says how a discount's value is read.
+type DiscountKind string
+
+// Discount kinds.
+const (
+	// DiscountPercent means Value is a percentage in basis points (1% = 100).
+	DiscountPercent DiscountKind = "percent"
+	// DiscountFixed means Value is an amount in cents.
+	DiscountFixed DiscountKind = "fixed"
+)
+
+// Discount is a discount code. A zero ExpiresAt means it never expires.
+type Discount struct {
+	Code      string       `json:"code"`
+	Kind      DiscountKind `json:"kind"`
+	Value     int64        `json:"value"`
+	ExpiresAt time.Time    `json:"expires_at"`
+}
+
+// validate checks the discount is well formed.
+func (d Discount) validate() error {
+	if d.Code == "" {
+		return fmt.Errorf("%w: empty code", ErrInvalidDiscount)
+	}
+	switch d.Kind {
+	case DiscountPercent:
+		if d.Value < 0 || d.Value > 10000 {
+			return fmt.Errorf("%w: code %s: percent %d bp outside 0..10000", ErrInvalidDiscount, d.Code, d.Value)
+		}
+	case DiscountFixed:
+		if d.Value < 0 {
+			return fmt.Errorf("%w: code %s: negative amount %d", ErrInvalidDiscount, d.Code, d.Value)
+		}
+	default:
+		return fmt.Errorf("%w: code %s: unknown kind %q", ErrInvalidDiscount, d.Code, d.Kind)
+	}
+	return nil
+}
+
+// amount returns the discount in cents for a total, never more than the total.
+func (d Discount) amount(total int64) int64 {
+	var off int64
+	if d.Kind == DiscountPercent {
+		off = roundDiv(total*d.Value, 10000)
+	} else {
+		off = d.Value
+	}
+	return min(max(off, 0), max(total, 0))
+}
+
+// Usage records which customers have used which discount codes. It is safe for
+// concurrent use.
+type Usage struct {
+	mu   sync.RWMutex        // guards used
+	used map[string]struct{} // keys are code + NUL + customer
+}
+
+// NewUsage returns an empty Usage.
+func NewUsage() *Usage {
+	return &Usage{used: make(map[string]struct{})}
+}
+
+// Used reports whether the customer has already used the code.
+func (u *Usage) Used(code, customer string) bool {
+	u.mu.RLock()
+	defer u.mu.RUnlock()
+	_, ok := u.used[usageKey(code, customer)]
+	return ok
+}
+
+// claim records the use and reports false if it was already recorded.
+func (u *Usage) claim(code, customer string) bool {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	k := usageKey(code, customer)
+	if _, ok := u.used[k]; ok {
+		return false
+	}
+	u.used[k] = struct{}{}
+	return true
+}
+
+func usageKey(code, customer string) string {
+	return code + "\x00" + customer
+}
+
+// roundDiv divides n by d (d > 0), rounding half away from zero.
+func roundDiv(n, d int64) int64 {
+	if n < 0 {
+		return -((-n + d/2) / d)
+	}
+	return (n + d/2) / d
+}
