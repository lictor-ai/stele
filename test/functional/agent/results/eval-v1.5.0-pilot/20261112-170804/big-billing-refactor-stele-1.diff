@@ -0,0 +1,19 @@
+package billing
+
+import "errors"
+
+// Errors returned by the billing package.
+var (
+	// ErrNoCustomer means an invoice was requested without a customer.
+	ErrNoCustomer = errors.New("billing: no customer")
+	// ErrInvalidLine means an invoice line has a negative quantity or price.
+	ErrInvalidLine = errors.New("billing: invalid line")
+	// ErrInvalidDiscount means a discount code is malformed.
+	ErrInvalidDiscount = errors.New("billing: invalid discount")
+	// ErrDiscountExpired means a discount code is past its expiry time.
+	ErrDiscountExpired = errors.New("billing: discount expired")
+	// ErrDiscountUsed means the customer already used the discount code.
+	ErrDiscountUsed = errors.New("billing: discount already used by customer")
+	// ErrUnknownRegion means the tax table has no rate for the region.
+	ErrUnknownRegion = errors.New("billing: unknown region")
+)
