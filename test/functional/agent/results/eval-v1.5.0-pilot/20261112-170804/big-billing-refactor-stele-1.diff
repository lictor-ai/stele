@@ -0,0 +1,16 @@
+package billing
+
+import "fmt"
+
+// TaxTable maps a region such as "FR" or "US-CA" to a tax rate in basis points
+// (1% = 100).
+type TaxTable map[string]int64
+
+// Tax returns the tax in cents on a taxable amount for a region.
+func (t TaxTable) Tax(region string, taxable int64) (int64, error) {
+	rate, ok := t[region]
+	if !ok {
+		return 0, fmt.Errorf("%w: %q", ErrUnknownRegion, region)
+	}
+	return roundDiv(taxable*rate, 10000), nil
+}
