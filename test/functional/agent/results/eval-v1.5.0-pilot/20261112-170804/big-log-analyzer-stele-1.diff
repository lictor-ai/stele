diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..b167ed8
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,105 @@
+// Command loga analyzes nginx access logs.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// usageError marks a problem with the command line, which exits with code 2.
+type usageError struct{ err error }
+
+func (u usageError) Error() string { return u.err.Error() }
+func (u usageError) Unwrap() error { return u.err }
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	stop()
+	if err == nil {
+		return
+	}
+	var ue usageError
+	if errors.As(err, &ue) {
+		os.Exit(2)
+	}
+	fmt.Fprintln(os.Stderr, "loga:", err)
+	os.Exit(1)
+}
+
+func run(ctx context.Context, args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: loga [-top N] [-json] [file ...]")
+		fs.PrintDefaults()
+	}
+	top := fs.Int("top", 10, "number of paths to list")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return usageError{err}
+	}
+	if *top < 0 {
+		err := fmt.Errorf("invalid -top %d: must not be negative", *top)
+		fmt.Fprintln(stderr, "loga:", err)
+		return usageError{err}
+	}
+
+	c := stats.NewCollector()
+	if fs.NArg() == 0 {
+		if err := scan(ctx, stdin, c); err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+	}
+	for _, name := range fs.Args() {
+		if err := scanFile(ctx, name, c); err != nil {
+			return err
+		}
+	}
+
+	report := c.Report(*top)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(report); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+		return nil
+	}
+	return report.WriteText(stdout)
+}
+
+func scanFile(ctx context.Context, name string, c *stats.Collector) (err error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return fmt.Errorf("open log: %w", err)
+	}
+	defer func() {
+		if cerr := f.Close(); err == nil && cerr != nil {
+			err = fmt.Errorf("close %s: %w", name, cerr)
+		}
+	}()
+	if err := scan(ctx, f, c); err != nil {
+		return fmt.Errorf("%s: %w", name, err)
+	}
+	return nil
+}
+
+func scan(ctx context.Context, r io.Reader, c *stats.Collector) error {
+	malformed, err := logparse.Scan(ctx, r, c.Add)
+	c.AddMalformed(malformed)
+	return err
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..8e150ad
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,146 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const logData = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 500 12 "-" "curl/8.0" 0.100
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "GET /home HTTP/1.1" 404 12 "-" "curl/8.0" 0.010
+not a log line
+`
+
+func writeLog(t *testing.T, content string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "access.log")
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+	return p
+}
+
+func TestRun(t *testing.T) {
+	good := writeLog(t, logData)
+	empty := writeLog(t, "")
+	missing := filepath.Join(t.TempDir(), "nope.log")
+
+	tests := []struct {
+		name      string
+		args      []string
+		stdin     string
+		wantUsage bool
+		wantErr   bool
+		wantOut   []string
+		wantNot   []string
+	}{
+		{
+			name: "file text report", args: []string{good},
+			wantOut: []string{"Total requests:  3", "Malformed lines: 1", "/api/items", "2xx  1", "5xx  1", "2026-10-10T13:00:00Z  1"},
+			wantNot: []string{"id=3"},
+		},
+		{
+			name: "stdin", args: nil, stdin: logData,
+			wantOut: []string{"Total requests:  3"},
+		},
+		{
+			name: "two files add up", args: []string{good, good},
+			wantOut: []string{"Total requests:  6", "Malformed lines: 2"},
+		},
+		{
+			name: "top limits paths", args: []string{"-top", "1", good},
+			wantOut: []string{"/api/items"}, wantNot: []string{"/home"},
+		},
+		{
+			name: "top zero", args: []string{"-top=0", good},
+			wantNot: []string{"/api/items"},
+		},
+		{name: "empty file", args: []string{empty}, wantOut: []string{"Total requests:  0"}},
+		{name: "empty stdin", args: nil, stdin: "", wantOut: []string{"Total requests:  0"}},
+		{name: "missing file", args: []string{missing}, wantErr: true},
+		{name: "missing second file", args: []string{good, missing}, wantErr: true},
+		{name: "unknown flag", args: []string{"-bogus"}, wantUsage: true, wantErr: true},
+		{name: "negative top", args: []string{"-top", "-1", good}, wantUsage: true, wantErr: true},
+		{name: "top not a number", args: []string{"-top", "x"}, wantUsage: true, wantErr: true},
+		{name: "help", args: []string{"-h"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var out, errOut bytes.Buffer
+			err := run(context.Background(), tc.args, strings.NewReader(tc.stdin), &out, &errOut)
+			var ue usageError
+			if gotUsage := errors.As(err, &ue); gotUsage != tc.wantUsage {
+				t.Errorf("run(%v) usage error = %v, want %v (err %v)", tc.args, gotUsage, tc.wantUsage, err)
+			}
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("run(%v) error = %v, want error %v", tc.args, err, tc.wantErr)
+			}
+			for _, w := range tc.wantOut {
+				if !strings.Contains(out.String(), w) {
+					t.Errorf("run(%v) output %q lacks %q", tc.args, out.String(), w)
+				}
+			}
+			for _, w := range tc.wantNot {
+				if strings.Contains(out.String(), w) {
+					t.Errorf("run(%v) output %q contains %q, want it absent", tc.args, out.String(), w)
+				}
+			}
+		})
+	}
+}
+
+func TestRunJSON(t *testing.T) {
+	var out, errOut bytes.Buffer
+	err := run(context.Background(), []string{"-json", writeLog(t, logData)}, strings.NewReader(""), &out, &errOut)
+	if err != nil {
+		t.Fatalf("run -json error = %v", err)
+	}
+	var got struct {
+		Total     int `json:"total_requests"`
+		Malformed int `json:"malformed_lines"`
+		Top       []struct {
+			Path  string `json:"path"`
+			Count int    `json:"count"`
+		} `json:"top_paths"`
+		Classes map[string]int     `json:"status_classes"`
+		Times   map[string]float64 `json:"request_time_ms"`
+		Hours   []struct {
+			Hour   string `json:"hour"`
+			Errors int    `json:"errors"`
+		} `json:"server_errors_per_hour"`
+	}
+	if err := json.Unmarshal(out.Bytes(), &got); err != nil {
+		t.Fatalf("output %q is not valid JSON: %v", out.String(), err)
+	}
+	if got.Total != 3 || got.Malformed != 1 {
+		t.Errorf("totals = %d/%d, want 3/1", got.Total, got.Malformed)
+	}
+	if len(got.Top) != 2 || got.Top[0].Path != "/api/items" || got.Top[0].Count != 2 {
+		t.Errorf("top_paths = %+v, want /api/items first with 2", got.Top)
+	}
+	if got.Classes["2xx"] != 1 || got.Classes["4xx"] != 1 || got.Classes["5xx"] != 1 || got.Classes["3xx"] != 0 {
+		t.Errorf("status_classes = %v, want one each of 2xx 4xx 5xx", got.Classes)
+	}
+	if got.Times["p50"] != 42 || got.Times["p99"] != 100 {
+		t.Errorf("request_time_ms = %v, want p50 42 and p99 100", got.Times)
+	}
+	if len(got.Hours) != 1 || got.Hours[0].Hour != "2026-10-10T13:00:00Z" || got.Hours[0].Errors != 1 {
+		t.Errorf("server_errors_per_hour = %+v, want one entry for 13:00", got.Hours)
+	}
+}
+
+func TestRunCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var out, errOut bytes.Buffer
+	err := run(ctx, nil, strings.NewReader(logData), &out, &errOut)
+	if !errors.Is(err, context.Canceled) {
+		t.Errorf("run with cancelled context error = %v, want context.Canceled", err)
+	}
+}
