--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,151 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+const goodLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParseLine(t *testing.T) {
+	tests := []struct {
+		name string
+		line string
+		want Entry
+	}{
+		{
+			name: "query string removed",
+			line: goodLine,
+			want: Entry{
+				RemoteAddr: "203.0.113.9", Time: time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC),
+				Method: "GET", Path: "/api/items", Proto: "HTTP/1.1", Status: 200, Bytes: 512,
+				Referer: "-", UserAgent: "curl/8.0", RequestTime: 42 * time.Millisecond,
+			},
+		},
+		{
+			name: "dash bytes and zero time",
+			line: `10.0.0.1 - bob [01/Jan/2027:00:00:00 +0200] "POST /x HTTP/2.0" 304 - "http://r/" "UA with spaces" 0`,
+			want: Entry{
+				RemoteAddr: "10.0.0.1", Time: time.Date(2027, 1, 1, 0, 0, 0, 0, time.FixedZone("", 7200)),
+				Method: "POST", Path: "/x", Proto: "HTTP/2.0", Status: 304, Bytes: 0,
+				Referer: "http://r/", UserAgent: "UA with spaces", RequestTime: 0,
+			},
+		},
+		{
+			name: "escaped quote in user agent",
+			line: `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "a \"b\" c" 1.5`,
+			want: Entry{
+				RemoteAddr: "1.1.1.1", Time: time.Date(2026, 10, 10, 13, 55, 36, 0, time.UTC),
+				Method: "GET", Path: "/", Proto: "HTTP/1.1", Status: 200, Bytes: 1,
+				Referer: "-", UserAgent: `a "b" c`, RequestTime: 1500 * time.Millisecond,
+			},
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := ParseLine(tc.line)
+			if err != nil {
+				t.Fatalf("ParseLine(%q) error = %v", tc.line, err)
+			}
+			if !got.Time.Equal(tc.want.Time) {
+				t.Errorf("ParseLine(%q).Time = %v, want %v", tc.line, got.Time, tc.want.Time)
+			}
+			got.Time, tc.want.Time = time.Time{}, time.Time{}
+			if got != tc.want {
+				t.Errorf("ParseLine(%q) = %+v, want %+v", tc.line, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestParseLineMalformed(t *testing.T) {
+	tests := []struct {
+		name string
+		line string
+	}{
+		{"empty", ""},
+		{"garbage", "hello world"},
+		{"missing request time", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua"`},
+		{"extra field", goodLine + " extra"},
+		{"bad time", `1.1.1.1 - - [yesterday] "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`},
+		{"unterminated bracket", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`},
+		{"unterminated quote", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 200 1 "-" "ua 0.1`},
+		{"text after quote", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1"x 200 1 "-" "ua" 0.1`},
+		{"request without protocol", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET /" 200 1 "-" "ua" 0.1`},
+		{"dash request", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "-" 408 0 "-" "-" 0.1`},
+		{"status not a number", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" abc 1 "-" "ua" 0.1`},
+		{"status out of range", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 999 1 "-" "ua" 0.1`},
+		{"negative bytes", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 -5 "-" "ua" 0.1`},
+		{"request time not a number", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" fast`},
+		{"negative request time", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" -0.1`},
+		{"NaN request time", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" NaN`},
+		{"huge request time", `1.1.1.1 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 1 "-" "ua" 1e300`},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := ParseLine(tc.line)
+			if !errors.Is(err, ErrMalformed) {
+				t.Errorf("ParseLine(%q) error = %v, want ErrMalformed", tc.line, err)
+			}
+		})
+	}
+}
+
+func TestScan(t *testing.T) {
+	tests := []struct {
+		name          string
+		input         string
+		wantPaths     []string
+		wantMalformed int
+	}{
+		{"empty input", "", nil, 0},
+		{"only blank lines", "\n  \n\r\n", nil, 0},
+		{"single request", goodLine + "\n", []string{"/api/items"}, 0},
+		{"no trailing newline", goodLine, []string{"/api/items"}, 0},
+		{"crlf", goodLine + "\r\n", []string{"/api/items"}, 0},
+		{"mixed", goodLine + "\nnot a log line\n\n" + goodLine + "\nanother bad one\n", []string{"/api/items", "/api/items"}, 2},
+		{"all malformed", "a\nb\nc\n", nil, 3},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var paths []string
+			malformed, err := Scan(context.Background(), strings.NewReader(tc.input), func(e Entry) {
+				paths = append(paths, e.Path)
+			})
+			if err != nil {
+				t.Fatalf("Scan(%q) error = %v", tc.input, err)
+			}
+			if malformed != tc.wantMalformed {
+				t.Errorf("Scan(%q) malformed = %d, want %d", tc.input, malformed, tc.wantMalformed)
+			}
+			if len(paths) != len(tc.wantPaths) {
+				t.Fatalf("Scan(%q) paths = %v, want %v", tc.input, paths, tc.wantPaths)
+			}
+			for i := range paths {
+				if paths[i] != tc.wantPaths[i] {
+					t.Errorf("Scan(%q) paths[%d] = %q, want %q", tc.input, i, paths[i], tc.wantPaths[i])
+				}
+			}
+		})
+	}
+}
+
+func TestScanCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := Scan(ctx, strings.NewReader(goodLine+"\n"), func(Entry) {})
+	if !errors.Is(err, context.Canceled) {
+		t.Errorf("Scan with cancelled ctx error = %v, want context.Canceled", err)
+	}
+}
+
+func TestScanLineTooLong(t *testing.T) {
+	long := strings.Repeat("a", maxLineBytes+10)
+	_, err := Scan(context.Background(), strings.NewReader(long), func(Entry) {})
+	if err == nil {
+		t.Error("Scan(too long line) error = nil, want error")
+	}
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..f2459f4
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,153 @@
+// Package stats aggregates parsed requests into a report.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+)
+
+// Request is the part of a log entry the statistics need.
+type Request struct {
+	Path     string
+	Status   int
+	Duration time.Duration
+	Time     time.Time
+}
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// HourCount is the number of 5xx responses in one hour.
+type HourCount struct {
+	Hour  time.Time `json:"hour"`
+	Count int       `json:"count"`
+}
+
+// Latency holds request time percentiles in milliseconds.
+type Latency struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// StatusClasses counts requests per status class.
+type StatusClasses struct {
+	C2xx int `json:"2xx"`
+	C3xx int `json:"3xx"`
+	C4xx int `json:"4xx"`
+	C5xx int `json:"5xx"`
+}
+
+// Report is the result of a Collector.
+type Report struct {
+	TotalRequests  int           `json:"total_requests"`
+	MalformedLines int           `json:"malformed_lines"`
+	TopPaths       []PathCount   `json:"top_paths"`
+	StatusClasses  StatusClasses `json:"status_classes"`
+	LatencyMS      Latency       `json:"latency_ms"`
+	Errors5xxHour  []HourCount   `json:"errors_5xx_per_hour"`
+}
+
+// Collector accumulates requests. It is not safe for concurrent use.
+type Collector struct {
+	total     int
+	paths     map[string]int
+	classes   StatusClasses
+	durations []time.Duration
+	hours     map[time.Time]int
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{paths: map[string]int{}, hours: map[time.Time]int{}}
+}
+
+// Add records one request.
+func (c *Collector) Add(r Request) {
+	c.total++
+	c.paths[r.Path]++
+	c.durations = append(c.durations, r.Duration)
+	switch {
+	case r.Status >= 200 && r.Status < 300:
+		c.classes.C2xx++
+	case r.Status >= 300 && r.Status < 400:
+		c.classes.C3xx++
+	case r.Status >= 400 && r.Status < 500:
+		c.classes.C4xx++
+	case r.Status >= 500 && r.Status < 600:
+		c.classes.C5xx++
+		c.hours[r.Time.UTC().Truncate(time.Hour)]++
+	}
+}
+
+// Report builds the report for the requests added so far. It keeps at most
+// top paths, most requested first, ties broken by path. A top below 1 gives
+// no paths. malformed is the count of skipped lines to include.
+func (c *Collector) Report(top, malformed int) Report {
+	rep := Report{
+		TotalRequests:  c.total,
+		MalformedLines: malformed,
+		TopPaths:       topPaths(c.paths, top),
+		StatusClasses:  c.classes,
+		Errors5xxHour:  make([]HourCount, 0, len(c.hours)),
+	}
+	sorted := make([]time.Duration, len(c.durations))
+	copy(sorted, c.durations)
+	sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+	rep.LatencyMS = Latency{
+		P50: Percentile(sorted, 50),
+		P95: Percentile(sorted, 95),
+		P99: Percentile(sorted, 99),
+	}
+	for h, n := range c.hours {
+		rep.Errors5xxHour = append(rep.Errors5xxHour, HourCount{Hour: h, Count: n})
+	}
+	sort.Slice(rep.Errors5xxHour, func(i, j int) bool {
+		return rep.Errors5xxHour[i].Hour.Before(rep.Errors5xxHour[j].Hour)
+	})
+	return rep
+}
+
+func topPaths(counts map[string]int, top int) []PathCount {
+	out := make([]PathCount, 0, len(counts))
+	for p, n := range counts {
+		out = append(out, PathCount{Path: p, Count: n})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Count != out[j].Count {
+			return out[i].Count > out[j].Count
+		}
+		return out[i].Path < out[j].Path
+	})
+	if top < 0 {
+		top = 0
+	}
+	if len(out) > top {
+		out = out[:top]
+	}
+	return out
+}
+
+// Percentile returns the p-th percentile (nearest rank method) of sorted, in
+// milliseconds. sorted must be in ascending order. It returns 0 for empty
+// input. p is clamped to the range 0 to 100.
+func Percentile(sorted []time.Duration, p float64) float64 {
+	if len(sorted) == 0 {
+		return 0
+	}
+	if math.IsNaN(p) || p < 0 {
+		p = 0
+	}
+	if p > 100 {
+		p = 100
+	}
+	rank := int(math.Ceil(p / 100 * float64(len(sorted))))
+	if rank < 1 {
+		rank = 1
+	}
+	return float64(sorted[rank-1]) / float64(time.Millisecond)
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..ce19879
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,162 @@
+package stats
+
+import (
+	"testing"
+	"time"
+)
+
+func ms(n int) time.Duration { return time.Duration(n) * time.Millisecond }
+
+func durations(n int) []time.Duration {
+	out := make([]time.Duration, n)
+	for i := range out {
+		out[i] = ms(i + 1)
+	}
+	return out
+}
+
+func TestPercentile(t *testing.T) {
+	tests := []struct {
+		name   string
+		sorted []time.Duration
+		p      float64
+		want   float64
+	}{
+		{"empty", nil, 50, 0},
+		{"single p0", []time.Duration{ms(7)}, 0, 7},
+		{"single p50", []time.Duration{ms(7)}, 50, 7},
+		{"single p99", []time.Duration{ms(7)}, 99, 7},
+		{"single p100", []time.Duration{ms(7)}, 100, 7},
+		{"two p50", []time.Duration{ms(1), ms(9)}, 50, 1},
+		{"two p51", []time.Duration{ms(1), ms(9)}, 51, 9},
+		{"hundred p50", durations(100), 50, 50},
+		{"hundred p95", durations(100), 95, 95},
+		{"hundred p99", durations(100), 99, 99},
+		{"hundred p100", durations(100), 100, 100},
+		{"ten p95 rounds up", durations(10), 95, 10},
+		{"below zero clamps", durations(10), -5, 1},
+		{"above hundred clamps", durations(10), 500, 10},
+		{"fractional ms", []time.Duration{42 * time.Millisecond, 1500 * time.Microsecond}, 0, 42},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := Percentile(tc.sorted, tc.p); got != tc.want {
+				t.Errorf("Percentile(%v, %v) = %v, want %v", tc.sorted, tc.p, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestReportEmpty(t *testing.T) {
+	rep := NewCollector().Report(10, 0)
+	if rep.TotalRequests != 0 || len(rep.TopPaths) != 0 || len(rep.Errors5xxHour) != 0 {
+		t.Errorf("empty Report = %+v, want zero values", rep)
+	}
+	if rep.LatencyMS != (Latency{}) {
+		t.Errorf("empty Report latency = %+v, want zeros", rep.LatencyMS)
+	}
+	if rep.Errors5xxHour == nil {
+		t.Error("empty Report Errors5xxHour = nil, want empty slice")
+	}
+}
+
+func TestReportSingleRequest(t *testing.T) {
+	c := NewCollector()
+	c.Add(Request{Path: "/a", Status: 200, Duration: ms(42), Time: time.Date(2026, 10, 10, 13, 55, 0, 0, time.UTC)})
+	rep := c.Report(10, 3)
+	if rep.TotalRequests != 1 || rep.MalformedLines != 3 {
+		t.Errorf("Report total/malformed = %d/%d, want 1/3", rep.TotalRequests, rep.MalformedLines)
+	}
+	want := Latency{P50: 42, P95: 42, P99: 42}
+	if rep.LatencyMS != want {
+		t.Errorf("Report latency = %+v, want %+v", rep.LatencyMS, want)
+	}
+	if rep.StatusClasses.C2xx != 1 {
+		t.Errorf("Report 2xx = %d, want 1", rep.StatusClasses.C2xx)
+	}
+}
+
+func TestReportTopPaths(t *testing.T) {
+	add := func(c *Collector, path string, n int) {
+		for range n {
+			c.Add(Request{Path: path, Status: 200})
+		}
+	}
+	tests := []struct {
+		name string
+		top  int
+		want []PathCount
+	}{
+		{"top 2", 2, []PathCount{{"/b", 3}, {"/a", 2}}},
+		{"top larger than paths", 10, []PathCount{{"/b", 3}, {"/a", 2}, {"/c", 2}, {"/d", 1}}},
+		{"top zero", 0, []PathCount{}},
+		{"top negative", -1, []PathCount{}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			c := NewCollector()
+			add(c, "/d", 1)
+			add(c, "/c", 2)
+			add(c, "/a", 2)
+			add(c, "/b", 3)
+			got := c.Report(tc.top, 0).TopPaths
+			if len(got) != len(tc.want) {
+				t.Fatalf("Report(%d).TopPaths = %v, want %v", tc.top, got, tc.want)
+			}
+			for i := range got {
+				if got[i] != tc.want[i] {
+					t.Errorf("Report(%d).TopPaths[%d] = %v, want %v", tc.top, i, got[i], tc.want[i])
+				}
+			}
+		})
+	}
+}
+
+func TestReportStatusAndHours(t *testing.T) {
+	h13 := time.Date(2026, 10, 10, 13, 10, 0, 0, time.UTC)
+	h14 := time.Date(2026, 10, 10, 14, 59, 59, 0, time.UTC)
+	plus2 := time.Date(2026, 10, 10, 16, 5, 0, 0, time.FixedZone("", 7200)) // 14:05 UTC
+	c := NewCollector()
+	for _, r := range []Request{
+		{Status: 200}, {Status: 204}, {Status: 301}, {Status: 404}, {Status: 499},
+		{Status: 500, Time: h14}, {Status: 503, Time: h13}, {Status: 502, Time: h13}, {Status: 500, Time: plus2},
+		{Status: 99}, {Status: 600},
+	} {
+		c.Add(r)
+	}
+	rep := c.Report(1, 0)
+	want := StatusClasses{C2xx: 2, C3xx: 1, C4xx: 2, C5xx: 4}
+	if rep.StatusClasses != want {
+		t.Errorf("StatusClasses = %+v, want %+v", rep.StatusClasses, want)
+	}
+	if rep.TotalRequests != 11 {
+		t.Errorf("TotalRequests = %d, want 11", rep.TotalRequests)
+	}
+	wantHours := []HourCount{
+		{Hour: time.Date(2026, 10, 10, 13, 0, 0, 0, time.UTC), Count: 2},
+		{Hour: time.Date(2026, 10, 10, 14, 0, 0, 0, time.UTC), Count: 2},
+	}
+	if len(rep.Errors5xxHour) != len(wantHours) {
+		t.Fatalf("Errors5xxHour = %v, want %v", rep.Errors5xxHour, wantHours)
+	}
+	for i, w := range wantHours {
+		g := rep.Errors5xxHour[i]
+		if !g.Hour.Equal(w.Hour) || g.Count != w.Count {
+			t.Errorf("Errors5xxHour[%d] = %v, want %v", i, g, w)
+		}
+	}
+}
+
+func TestReportDoesNotReorderCollector(t *testing.T) {
+	c := NewCollector()
+	for _, n := range []int{30, 10, 20} {
+		c.Add(Request{Path: "/", Status: 200, Duration: ms(n)})
+	}
+	c.Report(1, 0)
+	if c.durations[0] != ms(30) {
+		t.Errorf("Report reordered collected durations: %v", c.durations)
+	}
+	if got := c.Report(1, 0).LatencyMS.P50; got != 20 {
+		t.Errorf("P50 = %v, want 20", got)
+	}
+}
