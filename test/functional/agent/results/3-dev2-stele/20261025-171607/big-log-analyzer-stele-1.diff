diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..f33cc93
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,145 @@
+// Command loga reads nginx access logs and prints a summary report.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+	"text/tabwriter"
+	"time"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+const (
+	exitFailure = 1
+	exitUsage   = 2
+)
+
+// usageError marks a bad command line, which exits with code 2.
+type usageError struct{ err error }
+
+func (e usageError) Error() string { return e.err.Error() }
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := runContext(ctx, os.Args[1:], os.Stdin, os.Stdout, os.Stderr)
+	stop()
+	if err != nil {
+		os.Exit(exitCode(err))
+	}
+}
+
+// exitCode maps an error from run to a process exit code.
+func exitCode(err error) int {
+	var ue usageError
+	if errors.As(err, &ue) {
+		return exitUsage
+	}
+	return exitFailure
+}
+
+// runContext executes the command. It reads stdin when no files are named.
+func runContext(ctx context.Context, args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	top := fs.Int("top", 10, "number of top paths to show")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return usageError{err}
+	}
+	if *top < 0 {
+		err := fmt.Errorf("invalid -top %d: must not be negative", *top)
+		fmt.Fprintln(stderr, err)
+		return usageError{err}
+	}
+
+	col := stats.NewCollector()
+	malformed := 0
+	add := func(e logparse.Entry) {
+		col.Add(stats.Request{Path: e.Path, Status: e.Status, Duration: e.RequestTime, Time: e.Time})
+	}
+
+	if fs.NArg() == 0 {
+		n, err := logparse.Scan(ctx, stdin, add)
+		if err != nil {
+			fmt.Fprintln(stderr, "loga:", err)
+			return fmt.Errorf("read stdin: %w", err)
+		}
+		malformed += n
+	}
+	for _, name := range fs.Args() {
+		n, err := scanFile(ctx, name, add)
+		if err != nil {
+			fmt.Fprintln(stderr, "loga:", err)
+			return err
+		}
+		malformed += n
+	}
+
+	rep := col.Report(*top, malformed)
+	if *asJSON {
+		enc := json.NewEncoder(stdout)
+		enc.SetIndent("", "  ")
+		if err := enc.Encode(rep); err != nil {
+			return fmt.Errorf("write report: %w", err)
+		}
+		return nil
+	}
+	return writeText(stdout, rep)
+}
+
+func scanFile(ctx context.Context, name string, fn func(logparse.Entry)) (int, error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return 0, fmt.Errorf("open log: %w", err)
+	}
+	defer f.Close()
+	n, err := logparse.Scan(ctx, f, fn)
+	if err != nil {
+		return n, fmt.Errorf("read %s: %w", name, err)
+	}
+	return n, nil
+}
+
+func writeText(w io.Writer, rep stats.Report) error {
+	tw := tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+	fmt.Fprintf(tw, "Total requests:\t%d\n", rep.TotalRequests)
+	fmt.Fprintf(tw, "Malformed lines:\t%d\n", rep.MalformedLines)
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "Top paths:")
+	for _, p := range rep.TopPaths {
+		fmt.Fprintf(tw, "  %s\t%d\n", p.Path, p.Count)
+	}
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "Status classes:")
+	fmt.Fprintf(tw, "  2xx\t%d\n", rep.StatusClasses.C2xx)
+	fmt.Fprintf(tw, "  3xx\t%d\n", rep.StatusClasses.C3xx)
+	fmt.Fprintf(tw, "  4xx\t%d\n", rep.StatusClasses.C4xx)
+	fmt.Fprintf(tw, "  5xx\t%d\n", rep.StatusClasses.C5xx)
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "Request time (ms):")
+	fmt.Fprintf(tw, "  p50\t%.3f\n", rep.LatencyMS.P50)
+	fmt.Fprintf(tw, "  p95\t%.3f\n", rep.LatencyMS.P95)
+	fmt.Fprintf(tw, "  p99\t%.3f\n", rep.LatencyMS.P99)
+	fmt.Fprintln(tw)
+	fmt.Fprintln(tw, "5xx errors per hour (UTC):")
+	for _, h := range rep.Errors5xxHour {
+		fmt.Fprintf(tw, "  %s\t%d\n", h.Hour.UTC().Format(time.RFC3339), h.Count)
+	}
+	if err := tw.Flush(); err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	return nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..93182e6
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,133 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const logData = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 200 512 "-" "curl/8.0" 0.100
+203.0.113.9 - - [10/Oct/2026:13:57:00 +0000] "GET /health HTTP/1.1" 500 10 "-" "curl/8.0" 0.200
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "POST /login HTTP/1.1" 503 10 "-" "curl/8.0" 0.300
+203.0.113.9 - - [10/Oct/2026:14:02:00 +0000] "GET /missing HTTP/1.1" 404 10 "-" "curl/8.0" 0.010
+this line is broken
+`
+
+func TestRun(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "access.log")
+	if err := os.WriteFile(file, []byte(logData), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	missing := filepath.Join(dir, "missing.log")
+
+	tests := []struct {
+		name       string
+		args       []string
+		stdin      string
+		wantCode   int
+		wantStdout []string
+	}{
+		{
+			name:     "text from file",
+			args:     []string{file},
+			wantCode: 0,
+			wantStdout: []string{
+				"Total requests:", "5", "Malformed lines:", "/api/items", "2xx", "5xx",
+				"p50", "p95", "p99", "2026-10-10T13:00:00Z", "2026-10-10T14:00:00Z",
+			},
+		},
+		{
+			name:       "text from stdin",
+			args:       nil,
+			stdin:      logData,
+			wantCode:   0,
+			wantStdout: []string{"Total requests:", "/api/items"},
+		},
+		{name: "empty stdin", args: nil, stdin: "", wantCode: 0, wantStdout: []string{"Total requests:"}},
+		{name: "missing file", args: []string{missing}, wantCode: 1},
+		{name: "good then missing file", args: []string{file, missing}, wantCode: 1},
+		{name: "unknown flag", args: []string{"-bogus"}, wantCode: 2},
+		{name: "bad top value", args: []string{"-top", "abc"}, wantCode: 2},
+		{name: "negative top", args: []string{"-top", "-1"}, wantCode: 2},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			err := runContext(context.Background(), tc.args, strings.NewReader(tc.stdin), &stdout, &stderr)
+			got := 0
+			if err != nil {
+				got = exitCode(err)
+			}
+			if got != tc.wantCode {
+				t.Fatalf("run(%v) exit = %d (err %v), want %d", tc.args, got, err, tc.wantCode)
+			}
+			for _, s := range tc.wantStdout {
+				if !strings.Contains(stdout.String(), s) {
+					t.Errorf("run(%v) stdout missing %q:\n%s", tc.args, s, stdout.String())
+				}
+			}
+			if tc.wantCode != 0 && stderr.Len() == 0 {
+				t.Errorf("run(%v) wrote nothing to stderr on failure", tc.args)
+			}
+		})
+	}
+}
+
+func TestRunJSON(t *testing.T) {
+	var stdout, stderr bytes.Buffer
+	args := []string{"-json", "-top", "2"}
+	if err := runContext(context.Background(), args, strings.NewReader(logData), &stdout, &stderr); err != nil {
+		t.Fatalf("run(%v) error = %v", args, err)
+	}
+	var rep struct {
+		TotalRequests  int `json:"total_requests"`
+		MalformedLines int `json:"malformed_lines"`
+		TopPaths       []struct {
+			Path  string `json:"path"`
+			Count int    `json:"count"`
+		} `json:"top_paths"`
+		StatusClasses map[string]int     `json:"status_classes"`
+		LatencyMS     map[string]float64 `json:"latency_ms"`
+		Errors        []struct {
+			Hour  string `json:"hour"`
+			Count int    `json:"count"`
+		} `json:"errors_5xx_per_hour"`
+	}
+	if err := json.Unmarshal(stdout.Bytes(), &rep); err != nil {
+		t.Fatalf("run(%v) output is not JSON: %v\n%s", args, err, stdout.String())
+	}
+	if rep.TotalRequests != 5 || rep.MalformedLines != 1 {
+		t.Errorf("total/malformed = %d/%d, want 5/1", rep.TotalRequests, rep.MalformedLines)
+	}
+	if len(rep.TopPaths) != 2 || rep.TopPaths[0].Path != "/api/items" || rep.TopPaths[0].Count != 2 {
+		t.Errorf("top_paths = %+v, want 2 entries led by /api/items x2", rep.TopPaths)
+	}
+	wantClasses := map[string]int{"2xx": 2, "3xx": 0, "4xx": 1, "5xx": 2}
+	for k, v := range wantClasses {
+		if rep.StatusClasses[k] != v {
+			t.Errorf("status_classes[%s] = %d, want %d", k, rep.StatusClasses[k], v)
+		}
+	}
+	if rep.LatencyMS["p50"] != 100 || rep.LatencyMS["p99"] != 300 {
+		t.Errorf("latency_ms = %v, want p50 100 and p99 300", rep.LatencyMS)
+	}
+	if len(rep.Errors) != 2 || rep.Errors[0].Hour != "2026-10-10T13:00:00Z" || rep.Errors[0].Count != 1 {
+		t.Errorf("errors_5xx_per_hour = %+v, want one error in each of 13:00 and 14:00", rep.Errors)
+	}
+}
+
+func TestRunCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var stdout, stderr bytes.Buffer
+	err := runContext(ctx, nil, strings.NewReader(logData), &stdout, &stderr)
+	if err == nil || exitCode(err) != 1 {
+		t.Errorf("run with cancelled ctx error = %v, want exit 1", err)
+	}
+}
