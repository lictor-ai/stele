diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..a02c287
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,174 @@
+// Package logparse parses nginx "combined" access log lines with the request
+// time appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// TimeLayout is the layout of the bracketed timestamp field.
+const TimeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// maxLineBytes is the longest line Scan accepts.
+const maxLineBytes = 1 << 20
+
+// Entry is one parsed log line.
+type Entry struct {
+	RemoteAddr string
+	Time       time.Time
+	Method     string
+	// Path is the request target with the query string removed.
+	Path        string
+	Proto       string
+	Status      int
+	Bytes       int64
+	Referer     string
+	UserAgent   string
+	RequestTime time.Duration
+}
+
+// ParseLine parses one log line. It returns an error wrapping ErrMalformed
+// if the line does not match the format.
+func ParseLine(line string) (Entry, error) {
+	fields, err := split(line)
+	if err != nil {
+		return Entry{}, err
+	}
+	if len(fields) != 10 {
+		return Entry{}, fmt.Errorf("%w: want 10 fields, got %d", ErrMalformed, len(fields))
+	}
+
+	var e Entry
+	e.RemoteAddr = fields[0]
+
+	e.Time, err = time.Parse(TimeLayout, fields[3])
+	if err != nil {
+		return Entry{}, fmt.Errorf("%w: time %q: %w", ErrMalformed, fields[3], err)
+	}
+
+	req := strings.Fields(fields[4])
+	if len(req) != 3 {
+		return Entry{}, fmt.Errorf("%w: request %q", ErrMalformed, fields[4])
+	}
+	e.Method, e.Proto = req[0], req[2]
+	e.Path = req[1]
+	if i := strings.IndexByte(e.Path, '?'); i >= 0 {
+		e.Path = e.Path[:i]
+	}
+	if e.Path == "" {
+		return Entry{}, fmt.Errorf("%w: empty path in request %q", ErrMalformed, fields[4])
+	}
+
+	e.Status, err = strconv.Atoi(fields[5])
+	if err != nil || e.Status < 100 || e.Status > 599 {
+		return Entry{}, fmt.Errorf("%w: status %q", ErrMalformed, fields[5])
+	}
+
+	if fields[6] != "-" {
+		e.Bytes, err = strconv.ParseInt(fields[6], 10, 64)
+		if err != nil || e.Bytes < 0 {
+			return Entry{}, fmt.Errorf("%w: bytes %q", ErrMalformed, fields[6])
+		}
+	}
+
+	e.Referer, e.UserAgent = fields[7], fields[8]
+
+	secs, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || math.IsNaN(secs) || math.IsInf(secs, 0) || secs < 0 || secs > float64(math.MaxInt64)/float64(time.Second) {
+		return Entry{}, fmt.Errorf("%w: request time %q", ErrMalformed, fields[9])
+	}
+	e.RequestTime = time.Duration(math.Round(secs * float64(time.Second)))
+	return e, nil
+}
+
+// split breaks a line into space separated fields. A field may be wrapped in
+// double quotes (with backslash escapes) or square brackets; the wrapping is
+// removed.
+func split(line string) ([]string, error) {
+	var fields []string
+	i := 0
+	for i < len(line) {
+		switch line[i] {
+		case ' ':
+			i++
+		case '"':
+			var sb strings.Builder
+			i++
+			closed := false
+			for i < len(line) {
+				c := line[i]
+				if c == '\\' && i+1 < len(line) {
+					sb.WriteByte(line[i+1])
+					i += 2
+					continue
+				}
+				i++
+				if c == '"' {
+					closed = true
+					break
+				}
+				sb.WriteByte(c)
+			}
+			if !closed {
+				return nil, fmt.Errorf("%w: unterminated quote", ErrMalformed)
+			}
+			if i < len(line) && line[i] != ' ' {
+				return nil, fmt.Errorf("%w: text after closing quote", ErrMalformed)
+			}
+			fields = append(fields, sb.String())
+		case '[':
+			end := strings.IndexByte(line[i:], ']')
+			if end < 0 {
+				return nil, fmt.Errorf("%w: unterminated bracket", ErrMalformed)
+			}
+			fields = append(fields, line[i+1:i+end])
+			i += end + 1
+			if i < len(line) && line[i] != ' ' {
+				return nil, fmt.Errorf("%w: text after closing bracket", ErrMalformed)
+			}
+		default:
+			start := i
+			for i < len(line) && line[i] != ' ' {
+				i++
+			}
+			fields = append(fields, line[start:i])
+		}
+	}
+	// The format has remote_addr, ident and user before the bracketed time, so
+	// the time is field 3. Fields 1 and 2 are kept only to keep indexes stable.
+	return fields, nil
+}
+
+// Scan reads r line by line, calling fn for each valid entry. Blank lines are
+// ignored. It returns the number of malformed lines, which are skipped. It
+// stops early with the context's error if ctx is cancelled.
+func Scan(ctx context.Context, r io.Reader, fn func(Entry)) (malformed int, err error) {
+	sc := bufio.NewScanner(r)
+	sc.Buffer(make([]byte, 0, 64*1024), maxLineBytes)
+	for sc.Scan() {
+		if err := ctx.Err(); err != nil {
+			return malformed, fmt.Errorf("scan log: %w", err)
+		}
+		line := strings.TrimRight(sc.Text(), "\r")
+		if strings.TrimSpace(line) == "" {
+			continue
+		}
+		e, perr := ParseLine(line)
+		if perr != nil {
+			malformed++
+			continue
+		}
+		fn(e)
+	}
+	if err := sc.Err(); err != nil {
+		return malformed, fmt.Errorf("scan log: %w", err)
+	}
+	return malformed, nil
+}
