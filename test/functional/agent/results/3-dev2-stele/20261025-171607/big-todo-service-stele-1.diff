diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..6cc375a
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,126 @@
+// Package todo holds the Todo type and an in-memory store for it.
+package todo
+
+import (
+	"fmt"
+	"sort"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a single item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards items and seq.
+	mu    sync.RWMutex
+	items map[string]*entry
+	seq   uint64
+}
+
+// entry pairs a todo with its insertion order, which breaks ties between
+// todos created at the same instant.
+type entry struct {
+	todo Todo
+	seq  uint64
+}
+
+// NewStore returns an empty Store that reads time from c.
+func NewStore(c clock.Clock) *Store {
+	return &Store{clock: c, items: make(map[string]*entry)}
+}
+
+// Create adds a todo with the given title and returns it.
+func (s *Store) Create(title string) Todo {
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.seq++
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.items[t.ID] = &entry{todo: t, seq: s.seq}
+	return t
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(todoID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	e, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, fmt.Errorf("get todo %s: %w", todoID, ErrNotFound)
+	}
+	return e.todo, nil
+}
+
+// Update changes the title and/or done flag of a todo. A nil argument leaves
+// that field as it is. It returns ErrNotFound if the id is unknown.
+func (s *Store) Update(todoID string, title *string, done *bool) (Todo, error) {
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, fmt.Errorf("update todo %s: %w", todoID, ErrNotFound)
+	}
+	if title != nil {
+		e.todo.Title = *title
+	}
+	if done != nil {
+		e.todo.Done = *done
+	}
+	e.todo.UpdatedAt = now
+	return e.todo, nil
+}
+
+// Delete removes a todo, or returns ErrNotFound if the id is unknown.
+func (s *Store) Delete(todoID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[todoID]; !ok {
+		return fmt.Errorf("delete todo %s: %w", todoID, ErrNotFound)
+	}
+	delete(s.items, todoID)
+	return nil
+}
+
+// List returns todos newest first. If done is non-nil only todos with that
+// done value are returned. Offset skips that many matches; a limit of zero or
+// less means no limit.
+func (s *Store) List(done *bool, limit, offset int) []Todo {
+	s.mu.RLock()
+	matched := make([]*entry, 0, len(s.items))
+	for _, e := range s.items {
+		if done == nil || e.todo.Done == *done {
+			matched = append(matched, e)
+		}
+	}
+	sort.Slice(matched, func(i, j int) bool { return matched[i].seq > matched[j].seq })
+	if offset < 0 {
+		offset = 0
+	}
+	if offset > len(matched) {
+		offset = len(matched)
+	}
+	matched = matched[offset:]
+	if limit > 0 && limit < len(matched) {
+		matched = matched[:limit]
+	}
+	out := make([]Todo, len(matched))
+	for i, e := range matched {
+		out[i] = e.todo
+	}
+	s.mu.RUnlock()
+	return out
+}
