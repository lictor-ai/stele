+package todo
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var fixedTime = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newTestStore() *Store { return NewStore(clock.Fixed{T: fixedTime}) }
+
+func TestCreateGet(t *testing.T) {
+	s := newTestStore()
+	c := s.Create("buy milk")
+	if c.ID == "" || c.Title != "buy milk" || c.Done {
+		t.Errorf("Create = %+v, want id set, title %q, not done", c, "buy milk")
+	}
+	if !c.CreatedAt.Equal(fixedTime) || !c.UpdatedAt.Equal(fixedTime) {
+		t.Errorf("Create times = %v/%v, want %v", c.CreatedAt, c.UpdatedAt, fixedTime)
+	}
+	got, err := s.Get(c.ID)
+	if err != nil || got != c {
+		t.Errorf("Get(%q) = %+v, %v, want %+v, nil", c.ID, got, err, c)
+	}
+	if _, err := s.Get("nope"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(nope) error = %v, want ErrNotFound", err)
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	newTitle := "new"
+	yes := true
+	tests := []struct {
+		name      string
+		title     *string
+		done      *bool
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title only", &newTitle, nil, "new", false},
+		{"done only", nil, &yes, "old", true},
+		{"both", &newTitle, &yes, "new", true},
+		{"neither", nil, nil, "old", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			c := s.Create("old")
+			got, err := s.Update(c.ID, tc.title, tc.done)
+			if err != nil {
+				t.Fatalf("Update() error = %v", err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update() = %q/%v, want %q/%v", got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+	t.Run("missing", func(t *testing.T) {
+		if _, err := newTestStore().Update("nope", nil, nil); !errors.Is(err, ErrNotFound) {
+			t.Errorf("Update(nope) error = %v, want ErrNotFound", err)
+		}
+	})
+}
+
+func TestDelete(t *testing.T) {
+	s := newTestStore()
+	c := s.Create("x")
+	if err := s.Delete(c.ID); err != nil {
+		t.Fatalf("Delete(%q) = %v, want nil", c.ID, err)
+	}
+	if err := s.Delete(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("second Delete(%q) = %v, want ErrNotFound", c.ID, err)
+	}
+	if _, err := s.Get(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get after Delete error = %v, want ErrNotFound", err)
+	}
+}
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func equal(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func TestList(t *testing.T) {
+	s := newTestStore()
+	var ids []string
+	for i := 0; i < 5; i++ {
+		ids = append(ids, s.Create(fmt.Sprintf("t%d", i)).ID)
+	}
+	yes, no := true, false
+	for _, i := range []int{1, 3} {
+		if _, err := s.Update(ids[i], nil, &yes); err != nil {
+			t.Fatal(err)
+		}
+	}
+	tests := []struct {
+		name          string
+		done          *bool
+		limit, offset int
+		want          []string
+	}{
+		{"all newest first", nil, 0, 0, []string{"t4", "t3", "t2", "t1", "t0"}},
+		{"done", &yes, 0, 0, []string{"t3", "t1"}},
+		{"not done", &no, 0, 0, []string{"t4", "t2", "t0"}},
+		{"limit", nil, 2, 0, []string{"t4", "t3"}},
+		{"offset", nil, 0, 3, []string{"t1", "t0"}},
+		{"limit and offset", nil, 2, 1, []string{"t3", "t2"}},
+		{"offset past end", nil, 10, 9, []string{}},
+		{"negative offset", nil, 1, -4, []string{"t4"}},
+		{"filter with page", &no, 1, 1, []string{"t2"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got := titles(s.List(tc.done, tc.limit, tc.offset))
+			if !equal(got, tc.want) {
+				t.Errorf("List(%v, %d, %d) = %v, want %v", tc.done, tc.limit, tc.offset, got, tc.want)
+			}
+		})
+	}
+	t.Run("empty store", func(t *testing.T) {
+		if got := newTestStore().List(nil, 10, 0); len(got) != 0 {
+			t.Errorf("List on empty store = %v, want none", got)
+		}
+	})
+}
+
+func TestConcurrentUse(t *testing.T) {
+	s := newTestStore()
+	const workers, per = 16, 50
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			yes := true
+			for i := 0; i < per; i++ {
+				c := s.Create("c")
+				if _, err := s.Update(c.ID, nil, &yes); err != nil {
+					t.Errorf("Update(%q) = %v", c.ID, err)
+				}
+				if _, err := s.Get(c.ID); err != nil {
+					t.Errorf("Get(%q) = %v", c.ID, err)
+				}
+				s.List(&yes, 10, 0)
+				if i%2 == 0 {
+					if err := s.Delete(c.ID); err != nil {
+						t.Errorf("Delete(%q) = %v", c.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if got, want := len(s.List(nil, 0, 0)), workers*per/2; got != want {
+		t.Errorf("List count = %d, want %d", got, want)
+	}
+}
