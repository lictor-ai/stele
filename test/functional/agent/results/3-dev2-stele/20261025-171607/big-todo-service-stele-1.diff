diff --git a/cmd/server/main.go b/cmd/server/main.go
new file mode 100644
index 0000000..db274ef
--- /dev/null
+++ b/cmd/server/main.go
@@ -0,0 +1,68 @@
+// Command server serves the todo API over HTTP.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"example.com/app/internal/api"
+	"example.com/app/internal/clock"
+)
+
+const shutdownTimeout = 10 * time.Second
+
+func main() {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	err := run(ctx, os.Args[1:], os.Stdout, os.Stderr)
+	stop()
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "server:", err)
+		os.Exit(1)
+	}
+}
+
+func run(ctx context.Context, args []string, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("server", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	addr := fs.String("addr", ":8080", "address to listen on")
+	if err := fs.Parse(args); err != nil {
+		return fmt.Errorf("parse flags: %w", err)
+	}
+
+	srv := &http.Server{
+		Addr:              *addr,
+		Handler:           api.NewDefaultHandler(clock.Real{}),
+		ReadHeaderTimeout: 5 * time.Second,
+		ReadTimeout:       10 * time.Second,
+		WriteTimeout:      10 * time.Second,
+		IdleTimeout:       60 * time.Second,
+	}
+
+	errc := make(chan error, 1)
+	go func() { errc <- srv.ListenAndServe() }()
+	fmt.Fprintln(stdout, "listening on", *addr)
+
+	select {
+	case err := <-errc:
+		return fmt.Errorf("serve %s: %w", *addr, err)
+	case <-ctx.Done():
+	}
+
+	shutCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
+	defer cancel()
+	if err := srv.Shutdown(shutCtx); err != nil {
+		return fmt.Errorf("shut down: %w", err)
+	}
+	if err := <-errc; err != nil && !errors.Is(err, http.ErrServerClosed) {
+		return fmt.Errorf("serve %s: %w", *addr, err)
+	}
+	return nil
+}
diff --git a/internal/api/todos.go b/internal/api/todos.go
new file mode 100644
index 0000000..f9d3aaa
--- /dev/null
+++ b/internal/api/todos.go
@@ -0,0 +1,190 @@
+package api
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/log"
+	"example.com/app/internal/todo"
+)
+
+const (
+	maxBodyBytes = 1 << 20
+	maxTitleLen  = 200
+	defaultLimit = 20
+	maxLimit     = 100
+)
+
+type handler struct {
+	store *todo.Store
+}
+
+// NewHandler returns the HTTP handler for the todo API, backed by store.
+func NewHandler(store *todo.Store) http.Handler {
+	h := &handler{store: store}
+	mux := http.NewServeMux()
+	mux.HandleFunc("POST /todos", h.create)
+	mux.HandleFunc("GET /todos", h.list)
+	mux.HandleFunc("GET /todos/{id}", h.get)
+	mux.HandleFunc("PATCH /todos/{id}", h.update)
+	mux.HandleFunc("DELETE /todos/{id}", h.delete)
+	return mux
+}
+
+// NewDefaultHandler returns the todo API handler on a fresh in-memory store
+// that reads time from c.
+func NewDefaultHandler(c clock.Clock) http.Handler {
+	return NewHandler(todo.NewStore(c))
+}
+
+type createRequest struct {
+	Title string `json:"title"`
+}
+
+type updateRequest struct {
+	Title *string `json:"title"`
+	Done  *bool   `json:"done"`
+}
+
+type listResponse struct {
+	Todos []todo.Todo `json:"todos"`
+}
+
+// decodeBody reads a size-limited JSON body into v, rejecting unknown fields.
+// On failure it writes the error response and returns false.
+func decodeBody(w http.ResponseWriter, r *http.Request, v any) bool {
+	r.Body = http.MaxBytesReader(w, r.Body, maxBodyBytes)
+	dec := json.NewDecoder(r.Body)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(v); err != nil {
+		var tooBig *http.MaxBytesError
+		if errors.As(err, &tooBig) {
+			Error(w, http.StatusRequestEntityTooLarge, "request body is too large; send at most 1 MiB")
+			return false
+		}
+		Error(w, http.StatusBadRequest, "request body must be a JSON object with known fields only")
+		return false
+	}
+	if dec.More() {
+		Error(w, http.StatusBadRequest, "request body must contain a single JSON object")
+		return false
+	}
+	return true
+}
+
+// cleanTitle trims a title and checks its length in characters.
+func cleanTitle(s string) (string, bool) {
+	t := strings.TrimSpace(s)
+	n := utf8.RuneCountInString(t)
+	return t, n >= 1 && n <= maxTitleLen
+}
+
+const badTitleMsg = "title must be 1 to 200 characters after trimming"
+
+func (h *handler) create(w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	if !decodeBody(w, r, &req) {
+		return
+	}
+	title, ok := cleanTitle(req.Title)
+	if !ok {
+		Error(w, http.StatusBadRequest, badTitleMsg)
+		return
+	}
+	JSON(w, http.StatusCreated, h.store.Create(title))
+}
+
+func (h *handler) list(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	var done *bool
+	if s := q.Get("done"); s != "" {
+		switch s {
+		case "true":
+			v := true
+			done = &v
+		case "false":
+			v := false
+			done = &v
+		default:
+			Error(w, http.StatusBadRequest, "done must be true or false")
+			return
+		}
+	}
+	limit := defaultLimit
+	if s := q.Get("limit"); s != "" {
+		n, err := strconv.Atoi(s)
+		if err != nil || n < 1 || n > maxLimit {
+			Error(w, http.StatusBadRequest, fmt.Sprintf("limit must be an integer from 1 to %d", maxLimit))
+			return
+		}
+		limit = n
+	}
+	offset := 0
+	if s := q.Get("offset"); s != "" {
+		n, err := strconv.Atoi(s)
+		if err != nil || n < 0 {
+			Error(w, http.StatusBadRequest, "offset must be an integer of 0 or more")
+			return
+		}
+		offset = n
+	}
+	JSON(w, http.StatusOK, listResponse{Todos: h.store.List(done, limit, offset)})
+}
+
+func (h *handler) get(w http.ResponseWriter, r *http.Request) {
+	t, err := h.store.Get(r.PathValue("id"))
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) update(w http.ResponseWriter, r *http.Request) {
+	var req updateRequest
+	if !decodeBody(w, r, &req) {
+		return
+	}
+	if req.Title == nil && req.Done == nil {
+		Error(w, http.StatusBadRequest, "send title, done or both")
+		return
+	}
+	if req.Title != nil {
+		title, ok := cleanTitle(*req.Title)
+		if !ok {
+			Error(w, http.StatusBadRequest, badTitleMsg)
+			return
+		}
+		req.Title = &title
+	}
+	t, err := h.store.Update(r.PathValue("id"), req.Title, req.Done)
+	if err != nil {
+		h.storeError(w, err)
+		return
+	}
+	JSON(w, http.StatusOK, t)
+}
+
+func (h *handler) delete(w http.ResponseWriter, r *http.Request) {
+	if err := h.store.Delete(r.PathValue("id")); err != nil {
+		h.storeError(w, err)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// storeError maps a store error to a response without leaking its text.
+func (h *handler) storeError(w http.ResponseWriter, err error) {
+	if errors.Is(err, todo.ErrNotFound) {
+		Error(w, http.StatusNotFound, "todo not found")
+		return
+	}
+	log.Error("todo store", "err", err)
+	Error(w, http.StatusInternalServerError, "something went wrong; try again later")
+}
diff --git a/internal/api/todos_test.go b/internal/api/todos_test.go
new file mode 100644
index 0000000..31c6a97
--- /dev/null
+++ b/internal/api/todos_test.go
@@ -0,0 +1,283 @@
+package api
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/todo"
+)
+
+func newTestHandler() http.Handler {
+	return NewDefaultHandler(clock.Fixed{T: time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)})
+}
+
+func do(h http.Handler, method, target, body string) *httptest.ResponseRecorder {
+	var r *http.Request
+	if body == "" {
+		r = httptest.NewRequest(method, target, nil)
+	} else {
+		r = httptest.NewRequest(method, target, strings.NewReader(body))
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+
+func mustCreate(t *testing.T, h http.Handler, title string) todo.Todo {
+	t.Helper()
+	w := do(h, http.MethodPost, "/todos", `{"title":"`+title+`"}`)
+	if w.Code != http.StatusCreated {
+		t.Fatalf("POST /todos = %d, want %d", w.Code, http.StatusCreated)
+	}
+	var td todo.Todo
+	if err := json.Unmarshal(w.Body.Bytes(), &td); err != nil {
+		t.Fatal(err)
+	}
+	return td
+}
+
+func errorBody(t *testing.T, w *httptest.ResponseRecorder) string {
+	t.Helper()
+	var e map[string]string
+	if err := json.Unmarshal(w.Body.Bytes(), &e); err != nil || e["error"] == "" {
+		t.Errorf("body = %q, want {\"error\": ...}", w.Body.String())
+	}
+	return e["error"]
+}
+
+func TestCreate(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+		want int
+	}{
+		{"ok", `{"title":"buy milk"}`, http.StatusCreated},
+		{"trimmed", `{"title":"  hi  "}`, http.StatusCreated},
+		{"200 chars", `{"title":"` + strings.Repeat("a", 200) + `"}`, http.StatusCreated},
+		{"200 multibyte chars", `{"title":"` + strings.Repeat("é", 200) + `"}`, http.StatusCreated},
+		{"201 chars", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest},
+		{"empty", `{"title":""}`, http.StatusBadRequest},
+		{"blank", `{"title":"   "}`, http.StatusBadRequest},
+		{"missing title", `{}`, http.StatusBadRequest},
+		{"wrong type", `{"title":5}`, http.StatusBadRequest},
+		{"unknown field", `{"title":"x","extra":1}`, http.StatusBadRequest},
+		{"bad json", `{`, http.StatusBadRequest},
+		{"trailing data", `{"title":"x"} {"title":"y"}`, http.StatusBadRequest},
+		{"no body", ``, http.StatusBadRequest},
+		{"too large", `{"title":"` + strings.Repeat("a", 2<<20) + `"}`, http.StatusRequestEntityTooLarge},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(newTestHandler(), http.MethodPost, "/todos", tc.body)
+			if w.Code != tc.want {
+				t.Fatalf("POST /todos %q = %d, want %d", tc.name, w.Code, tc.want)
+			}
+			if tc.want >= 400 {
+				errorBody(t, w)
+			}
+		})
+	}
+	t.Run("response fields", func(t *testing.T) {
+		td := mustCreate(t, newTestHandler(), "x")
+		if td.ID == "" || td.Title != "x" || td.Done || td.CreatedAt.IsZero() {
+			t.Errorf("created = %+v, want id, title x, not done, created_at set", td)
+		}
+	})
+	t.Run("title is trimmed", func(t *testing.T) {
+		w := do(newTestHandler(), http.MethodPost, "/todos", `{"title":"  hi  "}`)
+		var td todo.Todo
+		if err := json.Unmarshal(w.Body.Bytes(), &td); err != nil || td.Title != "hi" {
+			t.Errorf("title = %q (%v), want %q", td.Title, err, "hi")
+		}
+	})
+	t.Run("snake case keys", func(t *testing.T) {
+		w := do(newTestHandler(), http.MethodPost, "/todos", `{"title":"x"}`)
+		if !strings.Contains(w.Body.String(), `"created_at"`) || !strings.Contains(w.Body.String(), `"updated_at"`) {
+			t.Errorf("body = %s, want created_at and updated_at", w.Body.String())
+		}
+	})
+}
+
+func TestGet(t *testing.T) {
+	h := newTestHandler()
+	td := mustCreate(t, h, "x")
+	tests := []struct {
+		name string
+		path string
+		want int
+	}{
+		{"found", "/todos/" + td.ID, http.StatusOK},
+		{"missing", "/todos/nope", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, http.MethodGet, tc.path, "")
+			if w.Code != tc.want {
+				t.Fatalf("GET %s = %d, want %d", tc.path, w.Code, tc.want)
+			}
+			if tc.want == http.StatusNotFound {
+				errorBody(t, w)
+			}
+		})
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		id        string // empty means the created todo
+		body      string
+		want      int
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title", "", `{"title":" new "}`, http.StatusOK, "new", false},
+		{"done", "", `{"done":true}`, http.StatusOK, "old", true},
+		{"both", "", `{"title":"new","done":true}`, http.StatusOK, "new", true},
+		{"empty object", "", `{}`, http.StatusBadRequest, "", false},
+		{"blank title", "", `{"title":" "}`, http.StatusBadRequest, "", false},
+		{"long title", "", `{"title":"` + strings.Repeat("a", 201) + `"}`, http.StatusBadRequest, "", false},
+		{"wrong done type", "", `{"done":"yes"}`, http.StatusBadRequest, "", false},
+		{"unknown field", "", `{"id":"x"}`, http.StatusBadRequest, "", false},
+		{"bad json", "", `nope`, http.StatusBadRequest, "", false},
+		{"missing todo", "nope", `{"done":true}`, http.StatusNotFound, "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			h := newTestHandler()
+			td := mustCreate(t, h, "old")
+			id := tc.id
+			if id == "" {
+				id = td.ID
+			}
+			w := do(h, http.MethodPatch, "/todos/"+id, tc.body)
+			if w.Code != tc.want {
+				t.Fatalf("PATCH %s %s = %d, want %d", id, tc.body, w.Code, tc.want)
+			}
+			if tc.want != http.StatusOK {
+				errorBody(t, w)
+				return
+			}
+			var got todo.Todo
+			if err := json.Unmarshal(w.Body.Bytes(), &got); err != nil {
+				t.Fatal(err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("PATCH %s = %q/%v, want %q/%v", tc.body, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+		})
+	}
+}
+
+func TestDelete(t *testing.T) {
+	h := newTestHandler()
+	td := mustCreate(t, h, "x")
+	if w := do(h, http.MethodDelete, "/todos/"+td.ID, ""); w.Code != http.StatusNoContent || w.Body.Len() != 0 {
+		t.Errorf("DELETE = %d body %q, want 204 and empty body", w.Code, w.Body.String())
+	}
+	if w := do(h, http.MethodGet, "/todos/"+td.ID, ""); w.Code != http.StatusNotFound {
+		t.Errorf("GET after DELETE = %d, want %d", w.Code, http.StatusNotFound)
+	}
+	w := do(h, http.MethodDelete, "/todos/"+td.ID, "")
+	if w.Code != http.StatusNotFound {
+		t.Fatalf("second DELETE = %d, want %d", w.Code, http.StatusNotFound)
+	}
+	errorBody(t, w)
+}
+
+func TestList(t *testing.T) {
+	h := newTestHandler()
+	var ids []string
+	for _, title := range []string{"a", "b", "c", "d"} {
+		ids = append(ids, mustCreate(t, h, title).ID)
+	}
+	do(h, http.MethodPatch, "/todos/"+ids[0], `{"done":true}`)
+	do(h, http.MethodPatch, "/todos/"+ids[2], `{"done":true}`)
+
+	tests := []struct {
+		name  string
+		query string
+		want  string // titles joined, newest first
+		code  int
+	}{
+		{"default", "", "dcba", http.StatusOK},
+		{"done true", "?done=true", "ca", http.StatusOK},
+		{"done false", "?done=false", "db", http.StatusOK},
+		{"limit", "?limit=2", "dc", http.StatusOK},
+		{"offset", "?offset=3", "a", http.StatusOK},
+		{"limit and offset", "?limit=1&offset=1", "c", http.StatusOK},
+		{"offset past end", "?offset=99", "", http.StatusOK},
+		{"max limit", "?limit=100", "dcba", http.StatusOK},
+		{"bad done", "?done=maybe", "", http.StatusBadRequest},
+		{"limit zero", "?limit=0", "", http.StatusBadRequest},
+		{"limit too big", "?limit=101", "", http.StatusBadRequest},
+		{"limit not a number", "?limit=abc", "", http.StatusBadRequest},
+		{"negative offset", "?offset=-1", "", http.StatusBadRequest},
+		{"offset not a number", "?offset=x", "", http.StatusBadRequest},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			w := do(h, http.MethodGet, "/todos"+tc.query, "")
+			if w.Code != tc.code {
+				t.Fatalf("GET /todos%s = %d, want %d", tc.query, w.Code, tc.code)
+			}
+			if tc.code != http.StatusOK {
+				errorBody(t, w)
+				return
+			}
+			var resp struct {
+				Todos []todo.Todo `json:"todos"`
+			}
+			if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil {
+				t.Fatal(err)
+			}
+			if resp.Todos == nil {
+				t.Errorf("todos = null, want a JSON array")
+			}
+			var got strings.Builder
+			for _, td := range resp.Todos {
+				got.WriteString(td.Title)
+			}
+			if got.String() != tc.want {
+				t.Errorf("GET /todos%s titles = %q, want %q", tc.query, got.String(), tc.want)
+			}
+		})
+	}
+	t.Run("default limit is 20", func(t *testing.T) {
+		h := newTestHandler()
+		for i := 0; i < 25; i++ {
+			mustCreate(t, h, "x")
+		}
+		var resp struct {
+			Todos []todo.Todo `json:"todos"`
+		}
+		w := do(h, http.MethodGet, "/todos", "")
+		if err := json.Unmarshal(w.Body.Bytes(), &resp); err != nil || len(resp.Todos) != 20 {
+			t.Errorf("got %d todos (%v), want 20", len(resp.Todos), err)
+		}
+	})
+}
+
+func TestRouting(t *testing.T) {
+	h := newTestHandler()
+	tests := []struct {
+		method, path string
+		want         int
+	}{
+		{http.MethodPut, "/todos/abc", http.StatusMethodNotAllowed},
+		{http.MethodDelete, "/todos", http.StatusMethodNotAllowed},
+		{http.MethodGet, "/other", http.StatusNotFound},
+	}
+	for _, tc := range tests {
+		t.Run(tc.method+" "+tc.path, func(t *testing.T) {
+			if w := do(h, tc.method, tc.path, ""); w.Code != tc.want {
+				t.Errorf("%s %s = %d, want %d", tc.method, tc.path, w.Code, tc.want)
+			}
+		})
+	}
+}
