@@ -0,0 +1,22 @@
+package report
+
+import "testing"
+
+func TestTotal(t *testing.T) {
+	tests := []struct {
+		name  string
+		items []int
+		want  int
+	}{
+		{"nil", nil, 0},
+		{"one", []int{5}, 5},
+		{"many", []int{1, 2, 3, -1}, 5},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := Total(tt.items); got != tt.want {
+				t.Errorf("Total(%v) = %d, want %d", tt.items, got, tt.want)
+			}
+		})
+	}
+}
