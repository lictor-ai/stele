diff --git a/internal/billing/discount.go b/internal/billing/discount.go
new file mode 100644
index 0000000..f7d6b67
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,92 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// maxBasisPoints is 100% in basis points.
+const maxBasisPoints = 10000
+
+// DiscountCode is a code worth a percentage or a fixed amount off.
+// Exactly one of PercentBP and FixedCents must be set.
+type DiscountCode struct {
+	Code       string    `json:"code"`
+	PercentBP  int64     `json:"percent_bp"`
+	FixedCents int64     `json:"fixed_cents"`
+	ExpiresAt  time.Time `json:"expires_at"`
+}
+
+// Validate reports whether the code is well formed.
+func (d DiscountCode) Validate() error {
+	switch {
+	case d.Code == "":
+		return fmt.Errorf("code is empty: %w", ErrInvalidCode)
+	case d.PercentBP < 0 || d.PercentBP > maxBasisPoints:
+		return fmt.Errorf("code %s percent %d out of range: %w", d.Code, d.PercentBP, ErrInvalidCode)
+	case d.FixedCents < 0:
+		return fmt.Errorf("code %s fixed amount %d is negative: %w", d.Code, d.FixedCents, ErrInvalidCode)
+	case (d.PercentBP == 0) == (d.FixedCents == 0):
+		return fmt.Errorf("code %s must set exactly one of percent and fixed amount: %w", d.Code, ErrInvalidCode)
+	}
+	return nil
+}
+
+// Expired reports whether the code is expired at now. A zero ExpiresAt never expires.
+func (d DiscountCode) Expired(now time.Time) bool {
+	return !d.ExpiresAt.IsZero() && !now.Before(d.ExpiresAt)
+}
+
+// DiscountFor returns the discount in cents for a total, never more than the total.
+func (d DiscountCode) DiscountFor(totalCents int64) int64 {
+	if totalCents <= 0 {
+		return 0
+	}
+	off := d.FixedCents
+	if d.PercentBP > 0 {
+		off = mulBP(totalCents, d.PercentBP)
+	}
+	return min(off, totalCents)
+}
+
+// Redemptions records which customer used which code.
+// mu guards used.
+type Redemptions struct {
+	mu   sync.RWMutex
+	used map[string]struct{}
+}
+
+// NewRedemptions returns an empty Redemptions.
+func NewRedemptions() *Redemptions {
+	return &Redemptions{used: make(map[string]struct{})}
+}
+
+// Used reports whether the customer has used the code.
+func (r *Redemptions) Used(customer, code string) bool {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	_, ok := r.used[redemptionKey(customer, code)]
+	return ok
+}
+
+// claim marks the code used by the customer and reports false if it already was.
+func (r *Redemptions) claim(customer, code string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	k := redemptionKey(customer, code)
+	if _, ok := r.used[k]; ok {
+		return false
+	}
+	r.used[k] = struct{}{}
+	return true
+}
+
+func redemptionKey(customer, code string) string {
+	return fmt.Sprintf("%q/%q", customer, code)
+}
+
+// mulBP returns v * bp / 10000 for v >= 0, rounded half away from zero.
+func mulBP(v, bp int64) int64 {
+	return (v*bp + maxBasisPoints/2) / maxBasisPoints
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
new file mode 100644
index 0000000..18912b8
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,15 @@
+package billing
+
+import "errors"
+
+// Errors returned by discount and tax handling.
+var (
+	// ErrInvalidCode means a discount code is malformed.
+	ErrInvalidCode = errors.New("billing: invalid discount code")
+	// ErrCodeExpired means a discount code is past its expiry time.
+	ErrCodeExpired = errors.New("billing: discount code expired")
+	// ErrCodeUsed means the customer already used the discount code.
+	ErrCodeUsed = errors.New("billing: discount code already used by customer")
+	// ErrUnknownRegion means the tax table has no rate for the region.
+	ErrUnknownRegion = errors.New("billing: no tax rate for region")
+)
