new file mode 100644
index 0000000..ee650ab
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,37 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+)
+
+// WriteCSV writes invoices to w as CSV with a header row. Amounts are in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	header := []string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}
+	if err := cw.Write(header); err != nil {
+		return fmt.Errorf("write csv header: %w", err)
+	}
+	for _, inv := range invoices {
+		row := []string{
+			inv.ID,
+			inv.Customer,
+			inv.Region,
+			issuedAtString(inv.IssuedAt),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := cw.Write(row); err != nil {
+			return fmt.Errorf("write csv row for invoice %s: %w", inv.ID, err)
+		}
+	}
+	cw.Flush()
+	if err := cw.Error(); err != nil {
+		return fmt.Errorf("flush csv: %w", err)
+	}
+	return nil
+}
diff --git a/internal/billing/finalize_test.go b/internal/billing/finalize_test.go
new file mode 100644
index 0000000..b96efe4
--- /dev/null
+++ b/internal/billing/finalize_test.go
@@ -0,0 +1,180 @@
+package billing
+
+import (
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var testNow = time.Date(2026, 3, 1, 12, 0, 0, 0, time.UTC)
+
+func testInvoice(total int64) Invoice {
+	return Invoice{ID: "inv1", Customer: "acme", TotalCents: total, GrandTotalCents: total, IssuedAt: testNow}
+}
+
+func TestFinalizeDiscount(t *testing.T) {
+	taxes := TaxTable{"FR": 0}
+	tests := []struct {
+		name         string
+		total        int64
+		code         DiscountCode
+		wantDiscount int64
+		wantGrand    int64
+		wantErr      error
+	}{
+		{"percent", 1000, DiscountCode{Code: "P10", PercentBP: 1000}, 100, 900, nil},
+		{"percent rounds half up", 5, DiscountCode{Code: "P50", PercentBP: 5000}, 3, 2, nil},
+		{"percent rounds down below half", 1049, DiscountCode{Code: "P1", PercentBP: 100}, 10, 1039, nil},
+		{"fixed", 1000, DiscountCode{Code: "F250", FixedCents: 250}, 250, 750, nil},
+		{"fixed floors at zero", 100, DiscountCode{Code: "F500", FixedCents: 500}, 100, 0, nil},
+		{"full percent", 100, DiscountCode{Code: "ALL", PercentBP: 10000}, 100, 0, nil},
+		{"empty invoice", 0, DiscountCode{Code: "F5", FixedCents: 5}, 0, 0, nil},
+		{"not yet expired", 1000, DiscountCode{Code: "E", FixedCents: 100, ExpiresAt: testNow.Add(time.Second)}, 100, 900, nil},
+		{"expired", 1000, DiscountCode{Code: "E", FixedCents: 100, ExpiresAt: testNow.Add(-time.Second)}, 0, 0, ErrCodeExpired},
+		{"expires exactly now", 1000, DiscountCode{Code: "E", FixedCents: 100, ExpiresAt: testNow}, 0, 0, ErrCodeExpired},
+		{"no code value", 1000, DiscountCode{Code: "Z"}, 0, 0, ErrInvalidCode},
+		{"both values", 1000, DiscountCode{Code: "B", PercentBP: 100, FixedCents: 100}, 0, 0, ErrInvalidCode},
+		{"percent over 100", 1000, DiscountCode{Code: "O", PercentBP: 10001}, 0, 0, ErrInvalidCode},
+		{"negative fixed", 1000, DiscountCode{Code: "N", FixedCents: -1}, 0, 0, ErrInvalidCode},
+		{"empty code", 1000, DiscountCode{FixedCents: 1}, 0, 0, ErrInvalidCode},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			code := tt.code
+			got, err := Finalize(testInvoice(tt.total), "FR", &code, NewRedemptions(), taxes, clock.Fixed{T: testNow})
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Finalize(%d, %+v) error = %v, want %v", tt.total, tt.code, err, tt.wantErr)
+			}
+			if tt.wantErr != nil {
+				return
+			}
+			if got.DiscountCents != tt.wantDiscount || got.GrandTotalCents != tt.wantGrand {
+				t.Errorf("Finalize(%d, %+v) discount, grand = %d, %d, want %d, %d",
+					tt.total, tt.code, got.DiscountCents, got.GrandTotalCents, tt.wantDiscount, tt.wantGrand)
+			}
+		})
+	}
+}
+
+func TestFinalizeReuse(t *testing.T) {
+	taxes := TaxTable{"FR": 0}
+	clk := clock.Fixed{T: testNow}
+	used := NewRedemptions()
+	code := &DiscountCode{Code: "ONCE", FixedCents: 100}
+
+	if _, err := Finalize(testInvoice(1000), "FR", code, used, taxes, clk); err != nil {
+		t.Fatalf("first Finalize error = %v, want nil", err)
+	}
+	if !used.Used("acme", "ONCE") {
+		t.Errorf("Used(acme, ONCE) = false after first use, want true")
+	}
+	if _, err := Finalize(testInvoice(1000), "FR", code, used, taxes, clk); !errors.Is(err, ErrCodeUsed) {
+		t.Errorf("second Finalize error = %v, want %v", err, ErrCodeUsed)
+	}
+	other := testInvoice(1000)
+	other.Customer = "globex"
+	if _, err := Finalize(other, "FR", code, used, taxes, clk); err != nil {
+		t.Errorf("Finalize for another customer error = %v, want nil", err)
+	}
+}
+
+func TestFinalizeFailureDoesNotConsumeCode(t *testing.T) {
+	used := NewRedemptions()
+	code := &DiscountCode{Code: "ONCE", FixedCents: 100}
+	if _, err := Finalize(testInvoice(1000), "XX", code, used, TaxTable{"FR": 0}, clock.Fixed{T: testNow}); !errors.Is(err, ErrUnknownRegion) {
+		t.Fatalf("Finalize unknown region error = %v, want %v", err, ErrUnknownRegion)
+	}
+	if used.Used("acme", "ONCE") {
+		t.Errorf("Used(acme, ONCE) = true after failed Finalize, want false")
+	}
+}
+
+func TestFinalizeTax(t *testing.T) {
+	taxes := TaxTable{"FR": 2000, "DE": 1900, "US-CA": 725, "ZERO": 0, "NEG": -1}
+	tests := []struct {
+		name      string
+		total     int64
+		region    string
+		code      *DiscountCode
+		wantTax   int64
+		wantGrand int64
+		wantErr   error
+	}{
+		{"france", 1000, "FR", nil, 200, 1200, nil},
+		{"germany rounds", 1050, "DE", nil, 200, 1250, nil},
+		{"state rate rounds up", 1000, "US-CA", nil, 73, 1073, nil},
+		{"zero rate", 1000, "ZERO", nil, 0, 1000, nil},
+		{"tax on discounted total", 1000, "FR", &DiscountCode{Code: "H", PercentBP: 5000}, 100, 600, nil},
+		{"fully discounted has no tax", 100, "FR", &DiscountCode{Code: "F", FixedCents: 999}, 0, 0, nil},
+		{"unknown region", 1000, "XX", nil, 0, 0, ErrUnknownRegion},
+		{"empty region", 1000, "", nil, 0, 0, ErrUnknownRegion},
+		{"negative rate", 1000, "NEG", nil, 0, 0, ErrUnknownRegion},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Finalize(testInvoice(tt.total), tt.region, tt.code, NewRedemptions(), taxes, clock.Fixed{T: testNow})
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("Finalize(%d, %q) error = %v, want %v", tt.total, tt.region, err, tt.wantErr)
+			}
+			if tt.wantErr != nil {
+				return
+			}
+			if got.TaxCents != tt.wantTax || got.GrandTotalCents != tt.wantGrand || got.Region != tt.region {
+				t.Errorf("Finalize(%d, %q) tax, grand, region = %d, %d, %q, want %d, %d, %q",
+					tt.total, tt.region, got.TaxCents, got.GrandTotalCents, got.Region, tt.wantTax, tt.wantGrand, tt.region)
+			}
+		})
+	}
+}
+
+func TestComputeGrandTotal(t *testing.T) {
+	inv := Compute("inv1", "acme", []Line{{SKU: "a", Quantity: 2, UnitCents: 150}})
+	if inv.GrandTotalCents != 300 || inv.TaxCents != 0 || inv.DiscountCents != 0 {
+		t.Errorf("Compute grand, tax, discount = %d, %d, %d, want 300, 0, 0", inv.GrandTotalCents, inv.TaxCents, inv.DiscountCents)
+	}
+}
+
+func TestWriteCSV(t *testing.T) {
+	tests := []struct {
+		name string
+		in   []Invoice
+		want string
+	}{
+		{"empty", nil, "id,customer,region,issued_at,total,discount,tax,grand_total\n"},
+		{
+			"rows",
+			[]Invoice{
+				{ID: "a", Customer: "acme", Region: "FR", IssuedAt: testNow, TotalCents: 1000, DiscountCents: 100, TaxCents: 180, GrandTotalCents: 1080},
+				{ID: "b", Customer: "Doe, Jane", Region: "US-CA", IssuedAt: testNow.In(time.FixedZone("x", 3600)), TotalCents: 5, GrandTotalCents: 5},
+			},
+			"id,customer,region,issued_at,total,discount,tax,grand_total\n" +
+				"a,acme,FR,2026-03-01T12:00:00Z,1000,100,180,1080\n" +
+				"b,\"Doe, Jane\",US-CA,2026-03-01T12:00:00Z,5,0,0,5\n",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var sb strings.Builder
+			if err := WriteCSV(&sb, tt.in); err != nil {
+				t.Fatalf("WriteCSV error = %v, want nil", err)
+			}
+			if sb.String() != tt.want {
+				t.Errorf("WriteCSV = %q, want %q", sb.String(), tt.want)
+			}
+		})
+	}
+}
+
+type failWriter struct{}
+
+func (failWriter) Write([]byte) (int, error) { return 0, errors.New("disk full") }
+
+func TestWriteCSVWriteError(t *testing.T) {
+	err := WriteCSV(failWriter{}, []Invoice{{ID: "a"}})
+	if err == nil {
+		t.Errorf("WriteCSV(failing writer) error = nil, want error")
+	}
+}
diff --git a/internal/billing/tax.go b/internal/billing/tax.go
new file mode 100644
index 0000000..f594131
--- /dev/null
+++ b/internal/billing/tax.go
@@ -0,0 +1,61 @@
+package billing
+
+import (
+	"fmt"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// TaxTable maps a region such as "FR" or "US-CA" to a tax rate in basis points.
+type TaxTable map[string]int64
+
+// Rate returns the rate for a region in basis points.
+func (t TaxTable) Rate(region string) (int64, error) {
+	bp, ok := t[region]
+	if !ok {
+		return 0, fmt.Errorf("region %q: %w", region, ErrUnknownRegion)
+	}
+	if bp < 0 {
+		return 0, fmt.Errorf("region %q has negative rate %d: %w", region, bp, ErrUnknownRegion)
+	}
+	return bp, nil
+}
+
+// Finalize applies at most one discount code and the regional tax to inv.
+// The code, if not nil, is recorded in used only when everything succeeds.
+// The tax is computed on the total after discount.
+func Finalize(inv Invoice, region string, code *DiscountCode, used *Redemptions, taxes TaxTable, clk clock.Clock) (Invoice, error) {
+	rate, err := taxes.Rate(region)
+	if err != nil {
+		return inv, fmt.Errorf("finalize invoice %s: %w", inv.ID, err)
+	}
+	var discount int64
+	if code != nil {
+		if err := code.Validate(); err != nil {
+			return inv, fmt.Errorf("finalize invoice %s: %w", inv.ID, err)
+		}
+		if code.Expired(clk.Now()) {
+			return inv, fmt.Errorf("finalize invoice %s: code %s: %w", inv.ID, code.Code, ErrCodeExpired)
+		}
+		if used.Used(inv.Customer, code.Code) {
+			return inv, fmt.Errorf("finalize invoice %s: code %s: %w", inv.ID, code.Code, ErrCodeUsed)
+		}
+		discount = code.DiscountFor(inv.TotalCents)
+		if !used.claim(inv.Customer, code.Code) {
+			return inv, fmt.Errorf("finalize invoice %s: code %s: %w", inv.ID, code.Code, ErrCodeUsed)
+		}
+	}
+	net := max(inv.TotalCents-discount, 0)
+	tax := mulBP(net, rate)
+	inv.Region = region
+	inv.DiscountCents = discount
+	inv.TaxCents = tax
+	inv.GrandTotalCents = net + tax
+	return inv, nil
+}
+
+// issuedAtString formats t as RFC 3339 in UTC.
+func issuedAtString(t time.Time) string {
+	return t.UTC().Format(time.RFC3339)
+}
