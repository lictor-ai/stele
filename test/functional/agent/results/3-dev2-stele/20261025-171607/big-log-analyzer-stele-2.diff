diff --git a/internal/logparse/logparse.go b/internal/logparse/logparse.go
new file mode 100644
index 0000000..0b4c697
--- /dev/null
+++ b/internal/logparse/logparse.go
@@ -0,0 +1,196 @@
+// Package logparse parses nginx access logs in the combined format with the
+// request time in seconds appended as the last field.
+package logparse
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// MaxLineBytes is the longest line that is parsed. Longer lines are counted as
+// malformed.
+const MaxLineBytes = 1 << 20
+
+// timeLayout is the nginx $time_local layout.
+const timeLayout = "02/Jan/2006:15:04:05 -0700"
+
+// Entry is one parsed request.
+type Entry struct {
+	// Time is when the request was received.
+	Time time.Time
+	// Method is the HTTP method.
+	Method string
+	// Path is the request path with the query string removed.
+	Path string
+	// Status is the HTTP status code.
+	Status int
+	// RequestTimeMs is the request time in milliseconds.
+	RequestTimeMs float64
+}
+
+// Parse parses one log line. It returns an error wrapping ErrMalformed when
+// the line is not a valid record.
+func Parse(line string) (Entry, error) {
+	fields, err := split(line)
+	if err != nil {
+		return Entry{}, err
+	}
+	// remote_addr ident user [time] "request" status bytes "referer" "agent" time
+	if len(fields) != 10 {
+		return Entry{}, fmt.Errorf("%w: got %d fields, want 10", ErrMalformed, len(fields))
+	}
+
+	ts, err := time.Parse(timeLayout, fields[3])
+	if err != nil {
+		return Entry{}, fmt.Errorf("%w: bad time %q", ErrMalformed, fields[3])
+	}
+
+	req := strings.Split(fields[4], " ")
+	if len(req) != 3 || req[0] == "" || req[1] == "" {
+		return Entry{}, fmt.Errorf("%w: bad request %q", ErrMalformed, fields[4])
+	}
+
+	status, err := strconv.Atoi(fields[5])
+	if err != nil || status < 100 || status > 599 {
+		return Entry{}, fmt.Errorf("%w: bad status %q", ErrMalformed, fields[5])
+	}
+
+	if fields[6] != "-" {
+		if n, err := strconv.ParseInt(fields[6], 10, 64); err != nil || n < 0 {
+			return Entry{}, fmt.Errorf("%w: bad byte count %q", ErrMalformed, fields[6])
+		}
+	}
+
+	secs, err := strconv.ParseFloat(fields[9], 64)
+	if err != nil || math.IsNaN(secs) || math.IsInf(secs, 0) || secs < 0 {
+		return Entry{}, fmt.Errorf("%w: bad request time %q", ErrMalformed, fields[9])
+	}
+
+	return Entry{
+		Time:          ts,
+		Method:        req[0],
+		Path:          stripQuery(req[1]),
+		Status:        status,
+		RequestTimeMs: secs * 1000,
+	}, nil
+}
+
+// stripQuery removes the query string and fragment from a request target.
+func stripQuery(target string) string {
+	if i := strings.IndexAny(target, "?#"); i >= 0 {
+		target = target[:i]
+	}
+	return target
+}
+
+// split breaks a line into space separated fields. A field may be wrapped in
+// double quotes or square brackets, which are removed. Inside quotes a
+// backslash escapes the next character.
+func split(line string) ([]string, error) {
+	var fields []string
+	i := 0
+	for i < len(line) {
+		if line[i] == ' ' {
+			i++
+			continue
+		}
+		switch line[i] {
+		case '"':
+			var sb strings.Builder
+			i++
+			closed := false
+			for i < len(line) {
+				c := line[i]
+				if c == '\\' && i+1 < len(line) {
+					sb.WriteByte(line[i+1])
+					i += 2
+					continue
+				}
+				if c == '"' {
+					closed = true
+					i++
+					break
+				}
+				sb.WriteByte(c)
+				i++
+			}
+			if !closed {
+				return nil, fmt.Errorf("%w: unterminated quote", ErrMalformed)
+			}
+			fields = append(fields, sb.String())
+		case '[':
+			end := strings.IndexByte(line[i:], ']')
+			if end < 0 {
+				return nil, fmt.Errorf("%w: unterminated bracket", ErrMalformed)
+			}
+			fields = append(fields, line[i+1:i+end])
+			i += end + 1
+		default:
+			end := strings.IndexByte(line[i:], ' ')
+			if end < 0 {
+				end = len(line) - i
+			}
+			fields = append(fields, line[i:i+end])
+			i += end
+		}
+		if i < len(line) && line[i] != ' ' {
+			return nil, fmt.Errorf("%w: unexpected text after field", ErrMalformed)
+		}
+	}
+	return fields, nil
+}
+
+// Scan reads r line by line and calls handle for every valid entry. Blank
+// lines are ignored. It returns the number of malformed lines, which are
+// skipped. It stops early with the context error if ctx is cancelled, and
+// with the read error if r fails.
+func Scan(ctx context.Context, r io.Reader, handle func(Entry)) (int, error) {
+	br := bufio.NewReaderSize(r, 64*1024)
+	malformed := 0
+	var buf []byte
+	tooLong := false
+	for {
+		if err := ctx.Err(); err != nil {
+			return malformed, fmt.Errorf("scan log: %w", err)
+		}
+		chunk, isPrefix, err := br.ReadLine()
+		if err != nil {
+			if err == io.EOF {
+				return malformed, nil
+			}
+			return malformed, fmt.Errorf("scan log: %w", err)
+		}
+		if !tooLong {
+			if len(buf)+len(chunk) > MaxLineBytes {
+				tooLong = true
+				buf = buf[:0]
+			} else {
+				buf = append(buf, chunk...)
+			}
+		}
+		if isPrefix {
+			continue
+		}
+
+		switch {
+		case tooLong:
+			malformed++
+		case len(strings.TrimSpace(string(buf))) == 0:
+		default:
+			e, perr := Parse(string(buf))
+			if perr != nil {
+				malformed++
+			} else {
+				handle(e)
+			}
+		}
+		buf = buf[:0]
+		tooLong = false
+	}
+}
diff --git a/internal/logparse/logparse_test.go b/internal/logparse/logparse_test.go
new file mode 100644
index 0000000..3391c7b
--- /dev/null
+++ b/internal/logparse/logparse_test.go
@@ -0,0 +1,139 @@
+package logparse
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+const goodLine = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042`
+
+func TestParse(t *testing.T) {
+	tests := []struct {
+		name       string
+		line       string
+		wantPath   string
+		wantMethod string
+		wantStatus int
+		wantMs     float64
+		wantErr    bool
+	}{
+		{name: "good line", line: goodLine, wantPath: "/api/items", wantMethod: "GET", wantStatus: 200, wantMs: 42},
+		{name: "no query", line: `1.2.3.4 - bob [10/Oct/2026:13:55:36 +0000] "POST /login HTTP/1.1" 302 0 "-" "ua" 1.5`, wantPath: "/login", wantMethod: "POST", wantStatus: 302, wantMs: 1500},
+		{name: "dash bytes", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 304 - "-" "ua" 0.000`, wantPath: "/", wantMethod: "GET", wantStatus: 304, wantMs: 0},
+		{name: "escaped quote in agent", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /a HTTP/1.1" 200 1 "-" "a \"b\" c" 0.001`, wantPath: "/a", wantMethod: "GET", wantStatus: 200, wantMs: 1},
+		{name: "bracket in referer", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /a HTTP/1.1" 200 1 "http://x/[1]" "ua" 0.001`, wantPath: "/a", wantMethod: "GET", wantStatus: 200, wantMs: 1},
+		{name: "fragment removed", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET /a#top HTTP/1.1" 200 1 "-" "ua" 0.001`, wantPath: "/a", wantMethod: "GET", wantStatus: 200, wantMs: 1},
+		{name: "empty", line: "", wantErr: true},
+		{name: "garbage", line: "hello world", wantErr: true},
+		{name: "missing request time", line: `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1" 200 512 "-" "curl/8.0"`, wantErr: true},
+		{name: "extra field", line: goodLine + " extra", wantErr: true},
+		{name: "dash request time", line: strings.Replace(goodLine, "0.042", "-", 1), wantErr: true},
+		{name: "negative request time", line: strings.Replace(goodLine, "0.042", "-1", 1), wantErr: true},
+		{name: "nan request time", line: strings.Replace(goodLine, "0.042", "NaN", 1), wantErr: true},
+		{name: "bad status", line: strings.Replace(goodLine, " 200 ", " abc ", 1), wantErr: true},
+		{name: "status out of range", line: strings.Replace(goodLine, " 200 ", " 999 ", 1), wantErr: true},
+		{name: "bad bytes", line: strings.Replace(goodLine, " 512 ", " xx ", 1), wantErr: true},
+		{name: "bad time", line: strings.Replace(goodLine, "10/Oct/2026", "32/Foo/2026", 1), wantErr: true},
+		{name: "unterminated quote", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000] "GET / HTTP/1.1 200 1`, wantErr: true},
+		{name: "unterminated bracket", line: `1.2.3.4 - - [10/Oct/2026:13:55:36 +0000 "GET / HTTP/1.1" 200 1 "-" "ua" 0.1`, wantErr: true},
+		{name: "request without protocol", line: strings.Replace(goodLine, "GET /api/items?id=3 HTTP/1.1", "GET /x", 1), wantErr: true},
+		{name: "dash request", line: strings.Replace(goodLine, "GET /api/items?id=3 HTTP/1.1", "-", 1), wantErr: true},
+		{name: "text glued to quote", line: strings.Replace(goodLine, `"-" "curl/8.0"`, `"-"x "curl/8.0"`, 1), wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := Parse(tt.line)
+			if tt.wantErr {
+				if !errors.Is(err, ErrMalformed) {
+					t.Fatalf("Parse(%q) error = %v, want ErrMalformed", tt.line, err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v, want nil", tt.line, err)
+			}
+			if got.Path != tt.wantPath {
+				t.Errorf("Parse(%q).Path = %q, want %q", tt.line, got.Path, tt.wantPath)
+			}
+			if got.Method != tt.wantMethod {
+				t.Errorf("Parse(%q).Method = %q, want %q", tt.line, got.Method, tt.wantMethod)
+			}
+			if got.Status != tt.wantStatus {
+				t.Errorf("Parse(%q).Status = %d, want %d", tt.line, got.Status, tt.wantStatus)
+			}
+			if d := got.RequestTimeMs - tt.wantMs; d > 1e-9 || d < -1e-9 {
+				t.Errorf("Parse(%q).RequestTimeMs = %v, want %v", tt.line, got.RequestTimeMs, tt.wantMs)
+			}
+		})
+	}
+}
+
+func TestParseTime(t *testing.T) {
+	line := strings.Replace(goodLine, "+0000", "+0200", 1)
+	got, err := Parse(line)
+	if err != nil {
+		t.Fatalf("Parse(%q) error = %v", line, err)
+	}
+	want := time.Date(2026, time.October, 10, 11, 55, 36, 0, time.UTC)
+	if !got.Time.Equal(want) {
+		t.Errorf("Parse(%q).Time = %v, want %v", line, got.Time, want)
+	}
+}
+
+func TestScan(t *testing.T) {
+	long := strings.Repeat("x", MaxLineBytes+10)
+	tests := []struct {
+		name          string
+		input         string
+		wantEntries   int
+		wantMalformed int
+	}{
+		{name: "empty input", input: "", wantEntries: 0, wantMalformed: 0},
+		{name: "only blank lines", input: "\n\n  \n", wantEntries: 0, wantMalformed: 0},
+		{name: "single request", input: goodLine + "\n", wantEntries: 1},
+		{name: "no trailing newline", input: goodLine, wantEntries: 1},
+		{name: "crlf", input: goodLine + "\r\n" + goodLine + "\r\n", wantEntries: 2},
+		{name: "mixed", input: goodLine + "\nbroken\n\n" + goodLine + "\nalso broken\n", wantEntries: 2, wantMalformed: 2},
+		{name: "all malformed", input: "a\nb\nc\n", wantMalformed: 3},
+		{name: "overlong line", input: long + "\n" + goodLine + "\n", wantEntries: 1, wantMalformed: 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			entries := 0
+			malformed, err := Scan(context.Background(), strings.NewReader(tt.input), func(Entry) { entries++ })
+			if err != nil {
+				t.Fatalf("Scan() error = %v, want nil", err)
+			}
+			if entries != tt.wantEntries {
+				t.Errorf("Scan() entries = %d, want %d", entries, tt.wantEntries)
+			}
+			if malformed != tt.wantMalformed {
+				t.Errorf("Scan() malformed = %d, want %d", malformed, tt.wantMalformed)
+			}
+		})
+	}
+}
+
+func TestScanCancelled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := Scan(ctx, strings.NewReader(goodLine+"\n"), func(Entry) {})
+	if !errors.Is(err, context.Canceled) {
+		t.Errorf("Scan(cancelled ctx) error = %v, want context.Canceled", err)
+	}
+}
+
+type failingReader struct{ err error }
+
+func (f failingReader) Read([]byte) (int, error) { return 0, f.err }
+
+func TestScanReadError(t *testing.T) {
+	boom := errors.New("boom")
+	_, err := Scan(context.Background(), failingReader{boom}, func(Entry) {})
+	if !errors.Is(err, boom) {
+		t.Errorf("Scan(failing reader) error = %v, want boom", err)
+	}
+}
