+++ b/internal/stats/render.go
@@ -0,0 +1,54 @@
+package stats
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"text/tabwriter"
+	"time"
+)
+
+// WriteJSON writes the report to w as indented JSON.
+func WriteJSON(w io.Writer, r Report) error {
+	enc := json.NewEncoder(w)
+	enc.SetIndent("", "  ")
+	if err := enc.Encode(r); err != nil {
+		return fmt.Errorf("write json report: %w", err)
+	}
+	return nil
+}
+
+// WriteText writes the report to w as a plain text table.
+func WriteText(w io.Writer, r Report) error {
+	tw := tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
+	fmt.Fprintf(tw, "Total requests:\t%d\n", r.TotalRequests)
+	fmt.Fprintf(tw, "Malformed lines:\t%d\n", r.MalformedLines)
+
+	fmt.Fprintf(tw, "\nTOP PATHS\tREQUESTS\n")
+	if len(r.TopPaths) == 0 {
+		fmt.Fprintf(tw, "(none)\t\n")
+	}
+	for _, p := range r.TopPaths {
+		fmt.Fprintf(tw, "%s\t%d\n", p.Path, p.Count)
+	}
+
+	fmt.Fprintf(tw, "\nSTATUS CLASS\tREQUESTS\n")
+	fmt.Fprintf(tw, "2xx\t%d\n3xx\t%d\n4xx\t%d\n5xx\t%d\n",
+		r.StatusClasses.S2xx, r.StatusClasses.S3xx, r.StatusClasses.S4xx, r.StatusClasses.S5xx)
+
+	fmt.Fprintf(tw, "\nREQUEST TIME\tMS\n")
+	fmt.Fprintf(tw, "p50\t%.3f\np95\t%.3f\np99\t%.3f\n",
+		r.RequestTimeMs.P50, r.RequestTimeMs.P95, r.RequestTimeMs.P99)
+
+	fmt.Fprintf(tw, "\n5XX PER HOUR (UTC)\tERRORS\n")
+	if len(r.ServerErrorsHour) == 0 {
+		fmt.Fprintf(tw, "(none)\t\n")
+	}
+	for _, h := range r.ServerErrorsHour {
+		fmt.Fprintf(tw, "%s\t%d\n", h.Hour.UTC().Format(time.DateTime), h.Count)
+	}
+	if err := tw.Flush(); err != nil {
+		return fmt.Errorf("write text report: %w", err)
+	}
+	return nil
+}
diff --git a/internal/stats/stats.go b/internal/stats/stats.go
new file mode 100644
index 0000000..9661e6a
--- /dev/null
+++ b/internal/stats/stats.go
@@ -0,0 +1,154 @@
+// Package stats computes summary statistics over parsed access log entries.
+package stats
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+// PathCount is the number of requests for one path.
+type PathCount struct {
+	Path  string `json:"path"`
+	Count int    `json:"count"`
+}
+
+// StatusClasses counts requests per status class.
+type StatusClasses struct {
+	S2xx int `json:"2xx"`
+	S3xx int `json:"3xx"`
+	S4xx int `json:"4xx"`
+	S5xx int `json:"5xx"`
+}
+
+// Percentiles holds request time percentiles in milliseconds.
+type Percentiles struct {
+	P50 float64 `json:"p50"`
+	P95 float64 `json:"p95"`
+	P99 float64 `json:"p99"`
+}
+
+// HourlyErrors is the number of 5xx responses in one hour.
+type HourlyErrors struct {
+	// Hour is the start of the hour in UTC.
+	Hour  time.Time `json:"hour"`
+	Count int       `json:"count"`
+}
+
+// Report is the summary of a set of requests.
+type Report struct {
+	TotalRequests    int            `json:"total_requests"`
+	MalformedLines   int            `json:"malformed_lines"`
+	TopPaths         []PathCount    `json:"top_paths"`
+	StatusClasses    StatusClasses  `json:"status_classes"`
+	RequestTimeMs    Percentiles    `json:"request_time_ms"`
+	ServerErrorsHour []HourlyErrors `json:"server_errors_per_hour"`
+}
+
+// Collector accumulates entries and builds a Report. It is not safe for
+// concurrent use.
+type Collector struct {
+	total   int
+	paths   map[string]int
+	classes StatusClasses
+	times   []float64
+	errHour map[time.Time]int
+}
+
+// NewCollector returns an empty Collector.
+func NewCollector() *Collector {
+	return &Collector{
+		paths:   make(map[string]int),
+		errHour: make(map[time.Time]int),
+	}
+}
+
+// Add records one entry.
+func (c *Collector) Add(e logparse.Entry) {
+	c.total++
+	c.paths[e.Path]++
+	c.times = append(c.times, e.RequestTimeMs)
+	switch {
+	case e.Status >= 200 && e.Status < 300:
+		c.classes.S2xx++
+	case e.Status >= 300 && e.Status < 400:
+		c.classes.S3xx++
+	case e.Status >= 400 && e.Status < 500:
+		c.classes.S4xx++
+	case e.Status >= 500 && e.Status < 600:
+		c.classes.S5xx++
+		c.errHour[e.Time.UTC().Truncate(time.Hour)]++
+	}
+}
+
+// Report builds the report for everything added so far. malformed is the
+// number of skipped lines to include and top is how many paths to list; a top
+// of zero or less lists none.
+func (c *Collector) Report(malformed, top int) Report {
+	r := Report{
+		TotalRequests:    c.total,
+		MalformedLines:   malformed,
+		TopPaths:         topPaths(c.paths, top),
+		StatusClasses:    c.classes,
+		ServerErrorsHour: hourly(c.errHour),
+	}
+	sorted := append([]float64(nil), c.times...)
+	sort.Float64s(sorted)
+	r.RequestTimeMs = Percentiles{
+		P50: Percentile(sorted, 50),
+		P95: Percentile(sorted, 95),
+		P99: Percentile(sorted, 99),
+	}
+	return r
+}
+
+// topPaths returns up to n paths, most requested first, ties by path.
+func topPaths(counts map[string]int, n int) []PathCount {
+	all := make([]PathCount, 0, len(counts))
+	for p, c := range counts {
+		all = append(all, PathCount{Path: p, Count: c})
+	}
+	sort.Slice(all, func(i, j int) bool {
+		if all[i].Count != all[j].Count {
+			return all[i].Count > all[j].Count
+		}
+		return all[i].Path < all[j].Path
+	})
+	if n < 0 {
+		n = 0
+	}
+	if len(all) > n {
+		all = all[:n]
+	}
+	return all
+}
+
+// hourly returns the per hour counts in time order.
+func hourly(m map[time.Time]int) []HourlyErrors {
+	out := make([]HourlyErrors, 0, len(m))
+	for h, c := range m {
+		out = append(out, HourlyErrors{Hour: h, Count: c})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Hour.Before(out[j].Hour) })
+	return out
+}
+
+// Percentile returns the p-th percentile (0 to 100) of sorted values using the
+// nearest-rank method. It returns 0 for empty input. A p below 0 is treated as
+// 0 and a p above 100 as 100. The input must be sorted ascending.
+func Percentile(sorted []float64, p float64) float64 {
+	n := len(sorted)
+	if n == 0 || math.IsNaN(p) {
+		return 0
+	}
+	rank := int(math.Ceil(p * float64(n) / 100))
+	if rank < 1 {
+		rank = 1
+	}
+	if rank > n {
+		rank = n
+	}
+	return sorted[rank-1]
+}
diff --git a/internal/stats/stats_test.go b/internal/stats/stats_test.go
new file mode 100644
index 0000000..2037277
--- /dev/null
+++ b/internal/stats/stats_test.go
@@ -0,0 +1,173 @@
+package stats
+
+import (
+	"encoding/json"
+	"slices"
+	"testing"
+	"time"
+
+	"example.com/app/internal/logparse"
+)
+
+func TestPercentile(t *testing.T) {
+	hundred := make([]float64, 100)
+	for i := range hundred {
+		hundred[i] = float64(i + 1)
+	}
+	tests := []struct {
+		name   string
+		sorted []float64
+		p      float64
+		want   float64
+	}{
+		{name: "empty", sorted: nil, p: 50, want: 0},
+		{name: "single p50", sorted: []float64{7}, p: 50, want: 7},
+		{name: "single p99", sorted: []float64{7}, p: 99, want: 7},
+		{name: "single p0", sorted: []float64{7}, p: 0, want: 7},
+		{name: "two p50", sorted: []float64{1, 2}, p: 50, want: 1},
+		{name: "two p95", sorted: []float64{1, 2}, p: 95, want: 2},
+		{name: "hundred p50", sorted: hundred, p: 50, want: 50},
+		{name: "hundred p95", sorted: hundred, p: 95, want: 95},
+		{name: "hundred p99", sorted: hundred, p: 99, want: 99},
+		{name: "hundred p100", sorted: hundred, p: 100, want: 100},
+		{name: "negative p", sorted: hundred, p: -5, want: 1},
+		{name: "p above 100", sorted: hundred, p: 150, want: 100},
+		{name: "nan p", sorted: hundred, p: nan(), want: 0},
+		{name: "duplicates", sorted: []float64{5, 5, 5, 5}, p: 95, want: 5},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := Percentile(tt.sorted, tt.p); got != tt.want {
+				t.Errorf("Percentile(%v, %v) = %v, want %v", tt.sorted, tt.p, got, tt.want)
+			}
+		})
+	}
+}
+
+func nan() float64 {
+	z := 0.0
+	return z / z
+}
+
+func entry(path string, status int, ms float64, at time.Time) logparse.Entry {
+	return logparse.Entry{Time: at, Method: "GET", Path: path, Status: status, RequestTimeMs: ms}
+}
+
+var base = time.Date(2026, time.October, 10, 13, 0, 0, 0, time.UTC)
+
+func TestReportEmpty(t *testing.T) {
+	r := NewCollector().Report(0, 10)
+	if r.TotalRequests != 0 || r.MalformedLines != 0 {
+		t.Errorf("empty Report totals = %d/%d, want 0/0", r.TotalRequests, r.MalformedLines)
+	}
+	if len(r.TopPaths) != 0 || len(r.ServerErrorsHour) != 0 {
+		t.Errorf("empty Report lists = %v/%v, want empty", r.TopPaths, r.ServerErrorsHour)
+	}
+	if r.RequestTimeMs != (Percentiles{}) {
+		t.Errorf("empty Report percentiles = %+v, want zeros", r.RequestTimeMs)
+	}
+}
+
+func TestReportSingle(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/a", 200, 42, base))
+	r := c.Report(3, 10)
+	if r.TotalRequests != 1 || r.MalformedLines != 3 {
+		t.Errorf("Report totals = %d/%d, want 1/3", r.TotalRequests, r.MalformedLines)
+	}
+	want := Percentiles{P50: 42, P95: 42, P99: 42}
+	if r.RequestTimeMs != want {
+		t.Errorf("Report percentiles = %+v, want %+v", r.RequestTimeMs, want)
+	}
+	if r.StatusClasses != (StatusClasses{S2xx: 1}) {
+		t.Errorf("Report classes = %+v, want one 2xx", r.StatusClasses)
+	}
+}
+
+func TestReportTopPaths(t *testing.T) {
+	c := NewCollector()
+	for range 3 {
+		c.Add(entry("/b", 200, 1, base))
+	}
+	for range 3 {
+		c.Add(entry("/a", 200, 1, base))
+	}
+	c.Add(entry("/c", 200, 1, base))
+	tests := []struct {
+		name string
+		top  int
+		want []PathCount
+	}{
+		{name: "top 2 breaks ties by path", top: 2, want: []PathCount{{"/a", 3}, {"/b", 3}}},
+		{name: "top larger than paths", top: 10, want: []PathCount{{"/a", 3}, {"/b", 3}, {"/c", 1}}},
+		{name: "top zero", top: 0, want: []PathCount{}},
+		{name: "top negative", top: -1, want: []PathCount{}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := c.Report(0, tt.top).TopPaths
+			if !slices.Equal(got, tt.want) {
+				t.Errorf("Report(0, %d).TopPaths = %v, want %v", tt.top, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestReportClassesAndHours(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/", 100, 1, base))
+	c.Add(entry("/", 200, 1, base))
+	c.Add(entry("/", 301, 1, base))
+	c.Add(entry("/", 404, 1, base))
+	c.Add(entry("/", 500, 1, base.Add(10*time.Minute)))
+	c.Add(entry("/", 503, 1, base.Add(59*time.Minute)))
+	c.Add(entry("/", 502, 1, base.Add(3*time.Hour)))
+	// Same instant as base+3h but in another zone: must land in the same hour.
+	zone := time.FixedZone("x", 2*3600)
+	c.Add(entry("/", 500, 1, base.Add(3*time.Hour+5*time.Minute).In(zone)))
+
+	r := c.Report(0, 10)
+	if want := (StatusClasses{S2xx: 1, S3xx: 1, S4xx: 1, S5xx: 4}); r.StatusClasses != want {
+		t.Errorf("Report classes = %+v, want %+v", r.StatusClasses, want)
+	}
+	want := []HourlyErrors{{Hour: base, Count: 2}, {Hour: base.Add(3 * time.Hour), Count: 2}}
+	if len(r.ServerErrorsHour) != len(want) {
+		t.Fatalf("Report hourly = %v, want %v", r.ServerErrorsHour, want)
+	}
+	for i, w := range want {
+		g := r.ServerErrorsHour[i]
+		if !g.Hour.Equal(w.Hour) || g.Count != w.Count {
+			t.Errorf("Report hourly[%d] = %v, want %v", i, g, w)
+		}
+	}
+}
+
+func TestReportPercentiles(t *testing.T) {
+	c := NewCollector()
+	for i := 100; i >= 1; i-- { // added out of order
+		c.Add(entry("/", 200, float64(i), base))
+	}
+	got := c.Report(0, 1).RequestTimeMs
+	want := Percentiles{P50: 50, P95: 95, P99: 99}
+	if got != want {
+		t.Errorf("Report percentiles = %+v, want %+v", got, want)
+	}
+}
+
+func TestReportJSON(t *testing.T) {
+	c := NewCollector()
+	c.Add(entry("/a", 500, 5, base))
+	b, err := json.Marshal(c.Report(1, 5))
+	if err != nil {
+		t.Fatalf("Marshal error = %v", err)
+	}
+	var m map[string]any
+	if err := json.Unmarshal(b, &m); err != nil {
+		t.Fatalf("Unmarshal error = %v", err)
+	}
+	for _, k := range []string{"total_requests", "malformed_lines", "top_paths", "status_classes", "request_time_ms", "server_errors_per_hour"} {
+		if _, ok := m[k]; !ok {
+			t.Errorf("JSON missing key %q in %s", k, b)
+		}
+	}
+}
