diff --git a/cmd/loga/main.go b/cmd/loga/main.go
new file mode 100644
index 0000000..472721e
--- /dev/null
+++ b/cmd/loga/main.go
@@ -0,0 +1,99 @@
+// Command loga analyzes nginx access logs.
+package main
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"os/signal"
+	"syscall"
+
+	"example.com/app/internal/logparse"
+	"example.com/app/internal/stats"
+)
+
+// usageError marks a bad command line, which exits with code 2.
+type usageError struct{ err error }
+
+func (e usageError) Error() string { return e.err.Error() }
+func (e usageError) Unwrap() error { return e.err }
+
+func main() {
+	if err := run(os.Args[1:], os.Stdin, os.Stdout, os.Stderr); err != nil {
+		fmt.Fprintln(os.Stderr, "loga:", err)
+		os.Exit(exitCode(err))
+	}
+}
+
+// exitCode maps an error from run to a process exit code.
+func exitCode(err error) int {
+	var ue usageError
+	if errors.As(err, &ue) {
+		return 2
+	}
+	return 1
+}
+
+func run(args []string, stdin io.Reader, stdout, stderr io.Writer) error {
+	fs := flag.NewFlagSet("loga", flag.ContinueOnError)
+	fs.SetOutput(stderr)
+	fs.Usage = func() {
+		fmt.Fprintln(stderr, "usage: loga [-top N] [-json] [file ...]")
+		fs.PrintDefaults()
+	}
+	top := fs.Int("top", 10, "number of top paths to show")
+	asJSON := fs.Bool("json", false, "print the report as JSON")
+	if err := fs.Parse(args); err != nil {
+		if errors.Is(err, flag.ErrHelp) {
+			return nil
+		}
+		return usageError{err}
+	}
+	if *top < 0 {
+		return usageError{fmt.Errorf("-top must not be negative, got %d", *top)}
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	c := stats.NewCollector()
+	malformed := 0
+	if fs.NArg() == 0 {
+		n, err := logparse.Scan(ctx, stdin, c.Add)
+		if err != nil {
+			return fmt.Errorf("read stdin: %w", err)
+		}
+		malformed += n
+	}
+	for _, name := range fs.Args() {
+		n, err := scanFile(ctx, name, c)
+		if err != nil {
+			return err
+		}
+		malformed += n
+	}
+
+	report := c.Report(malformed, *top)
+	if *asJSON {
+		return stats.WriteJSON(stdout, report)
+	}
+	return stats.WriteText(stdout, report)
+}
+
+// scanFile adds every entry of the named file to c and returns the number of
+// malformed lines.
+func scanFile(ctx context.Context, name string, c *stats.Collector) (int, error) {
+	f, err := os.Open(name)
+	if err != nil {
+		return 0, fmt.Errorf("open log: %w", err)
+	}
+	defer f.Close()
+	n, err := logparse.Scan(ctx, f, c.Add)
+	if err != nil {
+		return n, fmt.Errorf("read %s: %w", name, err)
+	}
+	return n, nil
+}
diff --git a/cmd/loga/main_test.go b/cmd/loga/main_test.go
new file mode 100644
index 0000000..7310669
--- /dev/null
+++ b/cmd/loga/main_test.go
@@ -0,0 +1,155 @@
+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const logData = `203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /api/items?id=3 HTTP/1.1" 200 512 "-" "curl/8.0" 0.042
+203.0.113.9 - - [10/Oct/2026:13:56:00 +0000] "GET /api/items?id=4 HTTP/1.1" 500 10 "-" "curl/8.0" 0.100
+203.0.113.9 - - [10/Oct/2026:14:01:00 +0000] "GET /home HTTP/1.1" 503 10 "-" "curl/8.0" 0.200
+not a log line
+203.0.113.9 - - [10/Oct/2026:14:02:00 +0000] "GET /missing HTTP/1.1" 404 10 "-" "curl/8.0" 0.010
+`
+
+func writeLog(t *testing.T, content string) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "access.log")
+	if err := os.WriteFile(p, []byte(content), 0o600); err != nil {
+		t.Fatalf("write fixture: %v", err)
+	}
+	return p
+}
+
+type jsonReport struct {
+	TotalRequests  int `json:"total_requests"`
+	MalformedLines int `json:"malformed_lines"`
+	TopPaths       []struct {
+		Path  string `json:"path"`
+		Count int    `json:"count"`
+	} `json:"top_paths"`
+	StatusClasses map[string]int     `json:"status_classes"`
+	RequestTimeMs map[string]float64 `json:"request_time_ms"`
+	Errors        []struct {
+		Hour  string `json:"hour"`
+		Count int    `json:"count"`
+	} `json:"server_errors_per_hour"`
+}
+
+func TestRunJSON(t *testing.T) {
+	p := writeLog(t, logData)
+	var out, errb bytes.Buffer
+	if err := run([]string{"-json", "-top", "1", p}, strings.NewReader(""), &out, &errb); err != nil {
+		t.Fatalf("run(-json) error = %v", err)
+	}
+	var r jsonReport
+	if err := json.Unmarshal(out.Bytes(), &r); err != nil {
+		t.Fatalf("output is not JSON: %v\n%s", err, out.String())
+	}
+	if r.TotalRequests != 4 || r.MalformedLines != 1 {
+		t.Errorf("totals = %d/%d, want 4/1", r.TotalRequests, r.MalformedLines)
+	}
+	if len(r.TopPaths) != 1 || r.TopPaths[0].Path != "/api/items" || r.TopPaths[0].Count != 2 {
+		t.Errorf("top_paths = %+v, want one entry /api/items x2", r.TopPaths)
+	}
+	if r.StatusClasses["2xx"] != 1 || r.StatusClasses["4xx"] != 1 || r.StatusClasses["5xx"] != 2 {
+		t.Errorf("status_classes = %v, want 2xx=1 4xx=1 5xx=2", r.StatusClasses)
+	}
+	if r.RequestTimeMs["p50"] != 42 || r.RequestTimeMs["p99"] != 200 {
+		t.Errorf("request_time_ms = %v, want p50=42 p99=200", r.RequestTimeMs)
+	}
+	if len(r.Errors) != 2 || r.Errors[0].Count != 1 || r.Errors[1].Count != 1 {
+		t.Errorf("server_errors_per_hour = %+v, want two hours with one error", r.Errors)
+	}
+}
+
+func TestRunText(t *testing.T) {
+	p := writeLog(t, logData)
+	var out, errb bytes.Buffer
+	if err := run([]string{p}, strings.NewReader(""), &out, &errb); err != nil {
+		t.Fatalf("run() error = %v", err)
+	}
+	for _, want := range []string{"Total requests:", "Malformed lines:", "/api/items", "5xx", "p95", "2026-10-10 13:00:00"} {
+		if !strings.Contains(out.String(), want) {
+			t.Errorf("text report missing %q:\n%s", want, out.String())
+		}
+	}
+}
+
+func TestRunStdin(t *testing.T) {
+	var out, errb bytes.Buffer
+	if err := run([]string{"-json"}, strings.NewReader(logData), &out, &errb); err != nil {
+		t.Fatalf("run(stdin) error = %v", err)
+	}
+	var r jsonReport
+	if err := json.Unmarshal(out.Bytes(), &r); err != nil {
+		t.Fatalf("output is not JSON: %v", err)
+	}
+	if r.TotalRequests != 4 {
+		t.Errorf("stdin total_requests = %d, want 4", r.TotalRequests)
+	}
+}
+
+func TestRunMultipleFiles(t *testing.T) {
+	a, b := writeLog(t, logData), writeLog(t, logData)
+	var out, errb bytes.Buffer
+	if err := run([]string{"-json", a, b}, strings.NewReader(""), &out, &errb); err != nil {
+		t.Fatalf("run(two files) error = %v", err)
+	}
+	var r jsonReport
+	if err := json.Unmarshal(out.Bytes(), &r); err != nil {
+		t.Fatalf("output is not JSON: %v", err)
+	}
+	if r.TotalRequests != 8 || r.MalformedLines != 2 {
+		t.Errorf("totals = %d/%d, want 8/2", r.TotalRequests, r.MalformedLines)
+	}
+}
+
+func TestRunEmptyInput(t *testing.T) {
+	var out, errb bytes.Buffer
+	if err := run([]string{"-json"}, strings.NewReader(""), &out, &errb); err != nil {
+		t.Fatalf("run(empty) error = %v", err)
+	}
+	var r jsonReport
+	if err := json.Unmarshal(out.Bytes(), &r); err != nil {
+		t.Fatalf("output is not JSON: %v", err)
+	}
+	if r.TotalRequests != 0 || r.MalformedLines != 0 {
+		t.Errorf("empty totals = %d/%d, want 0/0", r.TotalRequests, r.MalformedLines)
+	}
+}
+
+func TestExitCodes(t *testing.T) {
+	good := writeLog(t, logData)
+	missing := filepath.Join(t.TempDir(), "nope.log")
+	tests := []struct {
+		name string
+		args []string
+		want int
+	}{
+		{name: "success", args: []string{good}, want: 0},
+		{name: "help", args: []string{"-h"}, want: 0},
+		{name: "unreadable file", args: []string{missing}, want: 1},
+		{name: "good then unreadable", args: []string{good, missing}, want: 1},
+		{name: "unknown flag", args: []string{"-bogus"}, want: 2},
+		{name: "bad top value", args: []string{"-top", "abc", good}, want: 2},
+		{name: "negative top", args: []string{"-top", "-1", good}, want: 2},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, errb bytes.Buffer
+			err := run(tt.args, strings.NewReader(""), &out, &errb)
+			got := 0
+			if err != nil {
+				got = exitCode(err)
+			}
+			if got != tt.want {
+				t.Errorf("run(%q) exit = %d (err %v), want %d", tt.args, got, err, tt.want)
+			}
+		})
+	}
+}
