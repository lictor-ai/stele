diff --git a/internal/todo/todo.go b/internal/todo/todo.go
new file mode 100644
index 0000000..24fb8ff
--- /dev/null
+++ b/internal/todo/todo.go
@@ -0,0 +1,135 @@
+// Package todo holds the Todo type and an in-memory Store.
+package todo
+
+import (
+	"fmt"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a single item on the list.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Update describes a change to a todo. Nil fields are left as they are.
+type Update struct {
+	Title *string
+	Done  *bool
+}
+
+// Filter selects todos for List. A nil Done matches every todo. A Limit of
+// zero or less means no limit.
+type Filter struct {
+	Done   *bool
+	Limit  int
+	Offset int
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards items and order.
+	mu    sync.RWMutex
+	items map[string]Todo
+	order []string // ids, oldest first
+}
+
+// NewStore returns an empty Store that reads time from c.
+func NewStore(c clock.Clock) *Store {
+	return &Store{clock: c, items: make(map[string]Todo)}
+}
+
+// Create adds a todo with the given title and returns it.
+func (s *Store) Create(title string) (Todo, error) {
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, dup := s.items[t.ID]; dup {
+		return Todo{}, fmt.Errorf("create todo: id %s already in use", t.ID)
+	}
+	s.items[t.ID] = t
+	s.order = append(s.order, t.ID)
+	return t, nil
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(todoID string) (Todo, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, fmt.Errorf("get todo %s: %w", todoID, ErrNotFound)
+	}
+	return t, nil
+}
+
+// Update applies u to the todo with the given id and returns the result, or
+// ErrNotFound.
+func (s *Store) Update(todoID string, u Update) (Todo, error) {
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, fmt.Errorf("update todo %s: %w", todoID, ErrNotFound)
+	}
+	if u.Title != nil {
+		t.Title = *u.Title
+	}
+	if u.Done != nil {
+		t.Done = *u.Done
+	}
+	t.UpdatedAt = now
+	s.items[todoID] = t
+	return t, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(todoID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[todoID]; !ok {
+		return fmt.Errorf("delete todo %s: %w", todoID, ErrNotFound)
+	}
+	delete(s.items, todoID)
+	for i, v := range s.order {
+		if v == todoID {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns todos matching f, newest first, after applying Offset and Limit.
+func (s *Store) List(f Filter) []Todo {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	skip := max(f.Offset, 0)
+	for i := len(s.order) - 1; i >= 0; i-- {
+		t := s.items[s.order[i]]
+		if f.Done != nil && t.Done != *f.Done {
+			continue
+		}
+		if skip > 0 {
+			skip--
+			continue
+		}
+		if f.Limit > 0 && len(out) >= f.Limit {
+			break
+		}
+		out = append(out, t)
+	}
+	return out
+}
diff --git a/internal/todo/todo_test.go b/internal/todo/todo_test.go
new file mode 100644
index 0000000..2057dde
--- /dev/null
+++ b/internal/todo/todo_test.go
@@ -0,0 +1,170 @@
+package todo
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var testTime = time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+
+func newTestStore() *Store { return NewStore(clock.Fixed{T: testTime}) }
+
+func TestCreateGet(t *testing.T) {
+	s := newTestStore()
+	created, err := s.Create("write tests")
+	if err != nil {
+		t.Fatalf("Create() error = %v", err)
+	}
+	if created.ID == "" || created.Title != "write tests" || created.Done {
+		t.Errorf("Create() = %+v, want id set, title %q, done false", created, "write tests")
+	}
+	if !created.CreatedAt.Equal(testTime) || !created.UpdatedAt.Equal(testTime) {
+		t.Errorf("Create() times = %v, %v, want %v", created.CreatedAt, created.UpdatedAt, testTime)
+	}
+	got, err := s.Get(created.ID)
+	if err != nil || got != created {
+		t.Errorf("Get(%q) = %+v, %v, want %+v", created.ID, got, err, created)
+	}
+	if _, err := s.Get("missing"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(missing) error = %v, want ErrNotFound", err)
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	title := "new"
+	done := true
+	empty := ""
+	tests := []struct {
+		name      string
+		upd       Update
+		wantTitle string
+		wantDone  bool
+	}{
+		{"nothing", Update{}, "old", false},
+		{"title only", Update{Title: &title}, "new", false},
+		{"done only", Update{Done: &done}, "old", true},
+		{"both", Update{Title: &title, Done: &done}, "new", true},
+		{"store does not validate", Update{Title: &empty}, "", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			c, _ := s.Create("old")
+			got, err := s.Update(c.ID, tc.upd)
+			if err != nil {
+				t.Fatalf("Update() error = %v", err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update(%+v) = title %q done %v, want %q %v", tc.upd, got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			again, _ := s.Get(c.ID)
+			if again != got {
+				t.Errorf("Get after Update = %+v, want %+v", again, got)
+			}
+		})
+	}
+	s := newTestStore()
+	if _, err := s.Update("missing", Update{Done: &done}); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Update(missing) error = %v, want ErrNotFound", err)
+	}
+}
+
+func TestDelete(t *testing.T) {
+	s := newTestStore()
+	c, _ := s.Create("x")
+	if err := s.Delete(c.ID); err != nil {
+		t.Fatalf("Delete(%q) error = %v", c.ID, err)
+	}
+	if _, err := s.Get(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get after Delete error = %v, want ErrNotFound", err)
+	}
+	if err := s.Delete(c.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("second Delete error = %v, want ErrNotFound", err)
+	}
+	if n := len(s.List(Filter{})); n != 0 {
+		t.Errorf("List after Delete has %d items, want 0", n)
+	}
+}
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func TestList(t *testing.T) {
+	yes, no := true, false
+	tests := []struct {
+		name string
+		f    Filter
+		want []string
+	}{
+		{"all newest first", Filter{}, []string{"e", "d", "c", "b", "a"}},
+		{"done only", Filter{Done: &yes}, []string{"d", "b"}},
+		{"not done", Filter{Done: &no}, []string{"e", "c", "a"}},
+		{"limit", Filter{Limit: 2}, []string{"e", "d"}},
+		{"offset", Filter{Offset: 3}, []string{"b", "a"}},
+		{"limit and offset", Filter{Limit: 2, Offset: 1}, []string{"d", "c"}},
+		{"filter with paging", Filter{Done: &no, Limit: 1, Offset: 1}, []string{"c"}},
+		{"offset past end", Filter{Offset: 10}, []string{}},
+		{"negative offset", Filter{Offset: -3, Limit: 1}, []string{"e"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := newTestStore()
+			yesV := true
+			for _, title := range []string{"a", "b", "c", "d", "e"} {
+				c, _ := s.Create(title)
+				if title == "b" || title == "d" {
+					s.Update(c.ID, Update{Done: &yesV})
+				}
+			}
+			got := titles(s.List(tc.f))
+			if fmt.Sprint(got) != fmt.Sprint(tc.want) {
+				t.Errorf("List(%+v) = %v, want %v", tc.f, got, tc.want)
+			}
+		})
+	}
+	if got := newTestStore().List(Filter{}); got == nil || len(got) != 0 {
+		t.Errorf("List on empty store = %v, want empty non-nil slice", got)
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	s := newTestStore()
+	const workers, per = 16, 50
+	var wg sync.WaitGroup
+	for w := range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			done := true
+			for i := range per {
+				c, err := s.Create(fmt.Sprintf("w%d-%d", w, i))
+				if err != nil {
+					t.Errorf("Create() error = %v", err)
+					return
+				}
+				s.Update(c.ID, Update{Done: &done})
+				s.Get(c.ID)
+				s.List(Filter{Limit: 10})
+				if i%2 == 0 {
+					if err := s.Delete(c.ID); err != nil {
+						t.Errorf("Delete(%q) error = %v", c.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if n := len(s.List(Filter{})); n != workers*per/2 {
+		t.Errorf("List has %d items, want %d", n, workers*per/2)
+	}
+}
