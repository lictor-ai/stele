@@ -0,0 +1,186 @@
+package billing
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+var testNow = time.Date(2025, 3, 1, 12, 0, 0, 0, time.UTC)
+
+func newTestCalc() *Calculator {
+	rates := map[string]int64{"FR": 2000, "DE": 1900, "US-CA": 725, "ZERO": 0}
+	return NewCalculator(clock.Fixed{T: testNow}, rates, NewRedemptions())
+}
+
+func TestBuildDiscount(t *testing.T) {
+	lines := []Line{{SKU: "a", Quantity: 1, UnitCents: 1000}}
+	cases := []struct {
+		name     string
+		lines    []Line
+		code     *DiscountCode
+		discount int64
+		grand    int64
+		wantErr  error
+	}{
+		{"no code", lines, nil, 0, 1000, nil},
+		{"percent", lines, &DiscountCode{Code: "P10", Kind: DiscountPercent, Value: 1000}, 100, 900, nil},
+		{"percent rounds half up", []Line{{SKU: "a", Quantity: 1, UnitCents: 105}}, &DiscountCode{Code: "P10", Kind: DiscountPercent, Value: 1000}, 11, 94, nil},
+		{"percent rounds down below half", []Line{{SKU: "a", Quantity: 1, UnitCents: 104}}, &DiscountCode{Code: "P10", Kind: DiscountPercent, Value: 1000}, 10, 94, nil},
+		{"fixed", lines, &DiscountCode{Code: "F250", Kind: DiscountFixed, Value: 250}, 250, 750, nil},
+		{"fixed floors at zero", lines, &DiscountCode{Code: "BIG", Kind: DiscountFixed, Value: 5000}, 1000, 0, nil},
+		{"full percent", lines, &DiscountCode{Code: "ALL", Kind: DiscountPercent, Value: 10000}, 1000, 0, nil},
+		{"empty invoice", nil, &DiscountCode{Code: "F", Kind: DiscountFixed, Value: 100}, 0, 0, nil},
+		{"not expired", lines, &DiscountCode{Code: "E", Kind: DiscountFixed, Value: 100, ExpiresAt: testNow.Add(time.Second)}, 100, 900, nil},
+		{"expired at instant", lines, &DiscountCode{Code: "E", Kind: DiscountFixed, Value: 100, ExpiresAt: testNow}, 0, 0, ErrCodeExpired},
+		{"expired earlier", lines, &DiscountCode{Code: "E", Kind: DiscountFixed, Value: 100, ExpiresAt: testNow.Add(-time.Hour)}, 0, 0, ErrCodeExpired},
+		{"empty code", lines, &DiscountCode{Kind: DiscountFixed, Value: 100}, 0, 0, ErrInvalidCode},
+		{"unknown kind", lines, &DiscountCode{Code: "X", Kind: "weird", Value: 1}, 0, 0, ErrInvalidCode},
+		{"percent over 100", lines, &DiscountCode{Code: "X", Kind: DiscountPercent, Value: 10001}, 0, 0, ErrInvalidCode},
+		{"negative fixed", lines, &DiscountCode{Code: "X", Kind: DiscountFixed, Value: -1}, 0, 0, ErrInvalidCode},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			inv, err := newTestCalc().Build("i1", "acme", "", tc.lines, tc.code)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Build error = %v, want %v", err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if inv.DiscountCents != tc.discount {
+				t.Errorf("Build discount = %d, want %d", inv.DiscountCents, tc.discount)
+			}
+			if inv.GrandTotalCents != tc.grand {
+				t.Errorf("Build grand total = %d, want %d", inv.GrandTotalCents, tc.grand)
+			}
+		})
+	}
+}
+
+func TestBuildCodeReuse(t *testing.T) {
+	calc := newTestCalc()
+	lines := []Line{{SKU: "a", Quantity: 1, UnitCents: 1000}}
+	code := &DiscountCode{Code: "ONCE", Kind: DiscountFixed, Value: 100}
+
+	steps := []struct {
+		name     string
+		customer string
+		wantErr  error
+	}{
+		{"first use", "acme", nil},
+		{"same customer again", "acme", ErrCodeUsed},
+		{"other customer", "globex", nil},
+	}
+	for _, s := range steps {
+		t.Run(s.name, func(t *testing.T) {
+			_, err := calc.Build("i", s.customer, "", lines, code)
+			if !errors.Is(err, s.wantErr) {
+				t.Errorf("Build(%q) error = %v, want %v", s.customer, err, s.wantErr)
+			}
+		})
+	}
+}
+
+func TestBuildFailureKeepsCode(t *testing.T) {
+	calc := newTestCalc()
+	lines := []Line{{SKU: "a", Quantity: 1, UnitCents: 1000}}
+	code := &DiscountCode{Code: "ONCE", Kind: DiscountFixed, Value: 100}
+	if _, err := calc.Build("i", "acme", "XX", lines, code); !errors.Is(err, ErrUnknownRegion) {
+		t.Fatalf("Build with unknown region error = %v, want %v", err, ErrUnknownRegion)
+	}
+	if _, err := calc.Build("i", "acme", "FR", lines, code); err != nil {
+		t.Errorf("Build after failed attempt error = %v, want nil", err)
+	}
+}
+
+func TestBuildTax(t *testing.T) {
+	cases := []struct {
+		name    string
+		region  string
+		cents   int64
+		code    *DiscountCode
+		tax     int64
+		grand   int64
+		wantErr error
+	}{
+		{"fr", "FR", 1000, nil, 200, 1200, nil},
+		{"state level", "US-CA", 1000, nil, 73, 1073, nil},
+		{"rounds down", "US-CA", 1006, nil, 73, 1079, nil},
+		{"no region", "", 1000, nil, 0, 1000, nil},
+		{"zero rate", "ZERO", 1000, nil, 0, 1000, nil},
+		{"tax after discount", "DE", 1000, &DiscountCode{Code: "H", Kind: DiscountPercent, Value: 5000}, 95, 595, nil},
+		{"fully discounted", "FR", 1000, &DiscountCode{Code: "H", Kind: DiscountFixed, Value: 2000}, 0, 0, nil},
+		{"unknown region", "JP", 1000, nil, 0, 0, ErrUnknownRegion},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			lines := []Line{{SKU: "a", Quantity: 1, UnitCents: tc.cents}}
+			inv, err := newTestCalc().Build("i1", "acme", tc.region, lines, tc.code)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("Build error = %v, want %v", err, tc.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if inv.TaxCents != tc.tax || inv.GrandTotalCents != tc.grand {
+				t.Errorf("Build(%q) tax, grand = %d, %d, want %d, %d", tc.region, inv.TaxCents, inv.GrandTotalCents, tc.tax, tc.grand)
+			}
+			if inv.Region != tc.region {
+				t.Errorf("Build region = %q, want %q", inv.Region, tc.region)
+			}
+		})
+	}
+}
+
+func TestBuildNoCustomer(t *testing.T) {
+	if _, err := newTestCalc().Build("i", "", "", nil, nil); !errors.Is(err, ErrNoCustomer) {
+		t.Errorf("Build with no customer error = %v, want %v", err, ErrNoCustomer)
+	}
+}
+
+func TestExportCSV(t *testing.T) {
+	cases := []struct {
+		name string
+		in   []Invoice
+		want string
+	}{
+		{"empty", nil, "id,customer,region,issued_at,total,discount,tax,grand_total\n"},
+		{
+			"rows",
+			[]Invoice{
+				{ID: "i1", Customer: "acme", Region: "FR", IssuedAt: testNow, TotalCents: 1000, DiscountCents: 100, TaxCents: 180, GrandTotalCents: 1080},
+				{ID: "i2", Customer: "Doe, Jane", Region: "", IssuedAt: testNow.In(time.FixedZone("x", 3600)), TotalCents: 5, GrandTotalCents: 5},
+			},
+			"id,customer,region,issued_at,total,discount,tax,grand_total\n" +
+				"i1,acme,FR,2025-03-01T12:00:00Z,1000,100,180,1080\n" +
+				"i2,\"Doe, Jane\",,2025-03-01T13:00:00+01:00,5,0,0,5\n",
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := ExportCSV(&buf, tc.in); err != nil {
+				t.Fatalf("ExportCSV error = %v", err)
+			}
+			if got := buf.String(); got != tc.want {
+				t.Errorf("ExportCSV = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+type failWriter struct{}
+
+func (failWriter) Write([]byte) (int, error) { return 0, errors.New("disk full") }
+
+func TestExportCSVWriteError(t *testing.T) {
+	invs := []Invoice{{ID: "i1", Customer: strings.Repeat("x", 10000)}}
+	if err := ExportCSV(failWriter{}, invs); err == nil {
+		t.Error("ExportCSV to failing writer = nil, want error")
+	}
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
new file mode 100644
index 0000000..3e3fd14
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,16 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrNoCustomer is returned when an invoice has no customer.
+	ErrNoCustomer = errors.New("billing: no customer")
+	// ErrInvalidCode is returned when a discount code is malformed.
+	ErrInvalidCode = errors.New("billing: invalid discount code")
+	// ErrCodeExpired is returned when a discount code is past its expiry.
+	ErrCodeExpired = errors.New("billing: discount code expired")
+	// ErrCodeUsed is returned when a customer has already used a code.
+	ErrCodeUsed = errors.New("billing: discount code already used by customer")
+	// ErrUnknownRegion is returned when the tax table has no rate for a region.
+	ErrUnknownRegion = errors.New("billing: no tax rate for region")
+)
