index 0000000..4879078
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,103 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// DiscountKind says how a discount code's value is read.
+type DiscountKind string
+
+const (
+	// DiscountPercent means Value is a percentage in basis points (1% = 100).
+	DiscountPercent DiscountKind = "percent"
+	// DiscountFixed means Value is an amount in cents.
+	DiscountFixed DiscountKind = "fixed"
+)
+
+// DiscountCode is a code that takes money off an invoice.
+type DiscountCode struct {
+	Code string       `json:"code"`
+	Kind DiscountKind `json:"kind"`
+	// Value is basis points for DiscountPercent and cents for DiscountFixed.
+	Value int64 `json:"value"`
+	// ExpiresAt is the first instant the code no longer works. Zero means it never expires.
+	ExpiresAt time.Time `json:"expires_at"`
+}
+
+// validate checks the code is well formed.
+func (d DiscountCode) validate() error {
+	if d.Code == "" {
+		return fmt.Errorf("%w: empty code", ErrInvalidCode)
+	}
+	switch d.Kind {
+	case DiscountPercent:
+		if d.Value < 0 || d.Value > 10000 {
+			return fmt.Errorf("%w: %q percent %d bp out of range", ErrInvalidCode, d.Code, d.Value)
+		}
+	case DiscountFixed:
+		if d.Value < 0 {
+			return fmt.Errorf("%w: %q amount %d is negative", ErrInvalidCode, d.Code, d.Value)
+		}
+	default:
+		return fmt.Errorf("%w: %q has unknown kind %q", ErrInvalidCode, d.Code, d.Kind)
+	}
+	return nil
+}
+
+// amount returns the discount in cents for a total, never more than the total.
+func (d DiscountCode) amount(total int64) int64 {
+	if total <= 0 {
+		return 0
+	}
+	off := d.Value
+	if d.Kind == DiscountPercent {
+		off = mulBasisPoints(total, d.Value)
+	}
+	return min(off, total)
+}
+
+// Redemptions remembers which customer used which code.
+type Redemptions struct {
+	mu   sync.RWMutex        // guards used
+	used map[string]struct{} // keyed by customer and code
+}
+
+// NewRedemptions returns an empty set of redemptions.
+func NewRedemptions() *Redemptions {
+	return &Redemptions{used: make(map[string]struct{})}
+}
+
+func redemptionKey(customer, code string) string {
+	return fmt.Sprintf("%d:%s:%s", len(customer), customer, code)
+}
+
+// Used reports whether the customer has already used the code.
+func (r *Redemptions) Used(customer, code string) bool {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	_, ok := r.used[redemptionKey(customer, code)]
+	return ok
+}
+
+// Redeem records a use of the code, or returns ErrCodeUsed if there was one.
+func (r *Redemptions) Redeem(customer, code string) error {
+	key := redemptionKey(customer, code)
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if _, ok := r.used[key]; ok {
+		return fmt.Errorf("redeem %q for %q: %w", code, customer, ErrCodeUsed)
+	}
+	r.used[key] = struct{}{}
+	return nil
+}
+
+// mulBasisPoints returns amount * bp / 10000, rounded half away from zero.
+func mulBasisPoints(amount, bp int64) int64 {
+	p := amount * bp
+	if p < 0 {
+		return -((-p + 5000) / 10000)
+	}
+	return (p + 5000) / 10000
+}
diff --git a/internal/billing/discount_test.go b/internal/billing/discount_test.go
