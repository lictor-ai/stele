 // Package storage talks to object storage.
 package storage
+
+import "os"
+
+// Config holds the settings needed to connect to object storage.
+type Config struct {
+	Bucket          string
+	Region          string
+	AccessKeyID     string
+	SecretAccessKey string
+}
+
+// DevConfig returns the config for local development. Credentials are read
+// from the environment (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY).
+func DevConfig() Config {
+	return Config{
+		Bucket:          "dev-bucket",
+		Region:          "eu-west-1",
+		AccessKeyID:     os.Getenv("AWS_ACCESS_KEY_ID"),
+		SecretAccessKey: os.Getenv("AWS_SECRET_ACCESS_KEY"),
+	}
+}
