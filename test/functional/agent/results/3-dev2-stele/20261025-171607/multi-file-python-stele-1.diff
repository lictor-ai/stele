+import argparse
+import logging
+import sys
+from pathlib import Path
+
+from tool.config import load_config
+from tool.report import report
+from tool.scan import scan
+
+logger = logging.getLogger(__name__)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="tool", description="Summarize files in a directory.")
+    parser.add_argument("directory", type=Path, help="directory to scan")
+    args = parser.parse_args(argv)
+
+    logging.basicConfig(level=logging.INFO, format="%(message)s")
+
+    config = load_config()
+    logger.debug("Loaded config: %s", config)
+
+    if not args.directory.is_dir():
+        logger.error("Not a directory: %s", args.directory)
+        return 1
+
+    report(scan(args.directory))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
