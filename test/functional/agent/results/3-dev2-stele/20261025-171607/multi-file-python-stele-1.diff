+from pathlib import Path
+
+
+def scan(directory: Path) -> list[tuple[Path, int]]:
+    """Recursively list files under directory with their sizes in bytes."""
+    results: list[tuple[Path, int]] = []
+    for path in directory.rglob("*"):
+        try:
+            if path.is_file():
+                results.append((path, path.stat().st_size))
+        except OSError:
+            continue
+    return results
