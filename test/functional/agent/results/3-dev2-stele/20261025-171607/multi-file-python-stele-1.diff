+import logging
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+TOP_N = 5
+
+
+def report(files: list[tuple[Path, int]]) -> None:
+    """Log file count, total size and the largest files."""
+    total = sum(size for _, size in files)
+    logger.info("Files: %d", len(files))
+    logger.info("Total size: %d bytes", total)
+    logger.info("Largest files:")
+    for path, size in sorted(files, key=lambda item: item[1], reverse=True)[:TOP_N]:
+        logger.info("  %10d  %s", size, path)
