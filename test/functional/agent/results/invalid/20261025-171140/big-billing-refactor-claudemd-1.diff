+++ b/internal/billing/tax.go
@@ -0,0 +1,16 @@
+package billing
+
+import "fmt"
+
+// TaxTable maps a region such as "FR" or "US-CA" to a tax rate in basis points.
+type TaxTable map[string]int64
+
+// Tax returns the tax in cents on amount for region, rounded half away from
+// zero.
+func (t TaxTable) Tax(region string, amount int64) (int64, error) {
+	bp, ok := t[region]
+	if !ok {
+		return 0, fmt.Errorf("region %q: %w", region, ErrUnknownRegion)
+	}
+	return mulBP(amount, bp), nil
+}
