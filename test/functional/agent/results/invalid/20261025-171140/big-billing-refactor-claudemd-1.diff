index 0000000..a8df014
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,102 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// CodeKind says how a discount code reduces a total.
+type CodeKind int
+
+const (
+	// Percent takes Value basis points off the total (100 = 1%).
+	Percent CodeKind = iota + 1
+	// Fixed takes Value cents off the total.
+	Fixed
+)
+
+// Code is a discount code.
+type Code struct {
+	Name string
+	Kind CodeKind
+	// Value is basis points for Percent and cents for Fixed.
+	Value int64
+	// ExpiresAt is the first instant the code no longer works. The zero
+	// time means the code never expires.
+	ExpiresAt time.Time
+}
+
+// validate checks the kind and value of the code.
+func (c Code) validate() error {
+	switch c.Kind {
+	case Percent:
+		if c.Value < 0 || c.Value > 10000 {
+			return fmt.Errorf("code %q: percent %d bp out of range 0..10000: %w", c.Name, c.Value, ErrInvalidCode)
+		}
+	case Fixed:
+		if c.Value < 0 {
+			return fmt.Errorf("code %q: negative amount %d: %w", c.Name, c.Value, ErrInvalidCode)
+		}
+	default:
+		return fmt.Errorf("code %q: unknown kind %d: %w", c.Name, c.Kind, ErrInvalidCode)
+	}
+	return nil
+}
+
+// Discount returns the cents taken off total. It never exceeds total and is
+// never negative. Percentages round half away from zero.
+func (c Code) Discount(total int64) int64 {
+	if total <= 0 {
+		return 0
+	}
+	var d int64
+	switch c.Kind {
+	case Percent:
+		d = mulBP(total, c.Value)
+	case Fixed:
+		d = c.Value
+	}
+	return min(max(d, 0), total)
+}
+
+// mulBP returns amount * bp / 10000, rounded half away from zero.
+func mulBP(amount, bp int64) int64 {
+	n := amount * bp
+	if n >= 0 {
+		return (n + 5000) / 10000
+	}
+	return -((-n + 5000) / 10000)
+}
+
+type usage struct{ customer, code string }
+
+// Redeemer records which customer used which code.
+type Redeemer struct {
+	mu   sync.Mutex // guards used
+	used map[usage]bool
+}
+
+// NewRedeemer returns an empty Redeemer.
+func NewRedeemer() *Redeemer {
+	return &Redeemer{used: make(map[usage]bool)}
+}
+
+// Redeem checks that code is valid at now and unused by customer, then marks
+// it used.
+func (r *Redeemer) Redeem(customer string, code Code, now time.Time) error {
+	if err := code.validate(); err != nil {
+		return err
+	}
+	if !code.ExpiresAt.IsZero() && !now.Before(code.ExpiresAt) {
+		return fmt.Errorf("code %q expired at %s: %w", code.Name, code.ExpiresAt.Format(time.RFC3339), ErrCodeExpired)
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	key := usage{customer, code.Name}
+	if r.used[key] {
+		return fmt.Errorf("code %q for customer %q: %w", code.Name, customer, ErrCodeUsed)
+	}
+	r.used[key] = true
+	return nil
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
