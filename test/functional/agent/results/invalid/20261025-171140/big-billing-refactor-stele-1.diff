index 0000000..402a2cd
--- /dev/null
+++ b/internal/billing/tax.go
@@ -0,0 +1,23 @@
+package billing
+
+import "fmt"
+
+// TaxRates maps a region such as "FR" or "US-CA" to a rate in basis points.
+type TaxRates map[string]int64
+
+// ApplyTax returns inv with tax for region, computed on the total after
+// discount. Call it after ApplyDiscount, so the discount is part of the base.
+func ApplyTax(inv Invoice, region string, rates TaxRates) (Invoice, error) {
+	rate, ok := rates[region]
+	if !ok {
+		return inv, fmt.Errorf("tax for invoice %s in region %q: %w", inv.ID, region, ErrUnknownRegion)
+	}
+	if rate < 0 {
+		return inv, fmt.Errorf("tax for invoice %s in region %q rate %d: %w", inv.ID, region, rate, ErrInvalidTaxRate)
+	}
+	taxable := inv.TotalCents - inv.DiscountCents
+	inv.Region = region
+	inv.TaxCents = roundBasisPoints(taxable, rate)
+	inv.GrandTotalCents = taxable + inv.TaxCents
+	return inv, nil
+}
diff --git a/internal/billing/tax_test.go b/internal/billing/tax_test.go
new file mode 100644
index 0000000..49aed4a
--- /dev/null
+++ b/internal/billing/tax_test.go
@@ -0,0 +1,51 @@
+package billing
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestApplyTax(t *testing.T) {
+	rates := TaxRates{"FR": 2000, "DE": 1900, "US-CA": 725, "ZERO": 0, "BAD": -1}
+
+	tests := []struct {
+		name      string
+		total     int64
+		discount  int64
+		region    string
+		wantTax   int64
+		wantGrand int64
+		wantErr   error
+	}{
+		{name: "fr", total: 1000, region: "FR", wantTax: 200, wantGrand: 1200},
+		{name: "on total after discount", total: 1000, discount: 500, region: "DE", wantTax: 95, wantGrand: 595},
+		{name: "rounds half up", total: 1000, region: "US-CA", wantTax: 73, wantGrand: 1073},
+		{name: "zero rate", total: 1000, region: "ZERO", wantTax: 0, wantGrand: 1000},
+		{name: "empty invoice", total: 0, region: "FR", wantTax: 0, wantGrand: 0},
+		{name: "fully discounted", total: 500, discount: 500, region: "FR", wantTax: 0, wantGrand: 0},
+		{name: "unknown region", total: 1000, region: "XX", wantErr: ErrUnknownRegion},
+		{name: "empty region", total: 1000, region: "", wantErr: ErrUnknownRegion},
+		{name: "negative rate", total: 1000, region: "BAD", wantErr: ErrInvalidTaxRate},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			inv := Invoice{ID: "i1", TotalCents: tc.total, DiscountCents: tc.discount}
+			got, err := ApplyTax(inv, tc.region, rates)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("ApplyTax(%q) error = %v, want %v", tc.region, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				return
+			}
+			if got.TaxCents != tc.wantTax {
+				t.Errorf("ApplyTax(%q) tax = %d, want %d", tc.region, got.TaxCents, tc.wantTax)
+			}
+			if got.GrandTotalCents != tc.wantGrand {
+				t.Errorf("ApplyTax(%q) grand total = %d, want %d", tc.region, got.GrandTotalCents, tc.wantGrand)
+			}
+			if got.Region != tc.region {
+				t.Errorf("ApplyTax(%q) region = %q", tc.region, got.Region)
+			}
+		})
+	}
+}
