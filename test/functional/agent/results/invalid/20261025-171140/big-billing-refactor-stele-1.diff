diff --git a/internal/billing/discount.go b/internal/billing/discount.go
new file mode 100644
index 0000000..78042a7
--- /dev/null
+++ b/internal/billing/discount.go
@@ -0,0 +1,99 @@
+package billing
+
+import (
+	"fmt"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// DiscountKind says how a discount value is read.
+type DiscountKind string
+
+const (
+	// DiscountPercent reads Value as basis points (1% = 100).
+	DiscountPercent DiscountKind = "percent"
+	// DiscountFixed reads Value as cents.
+	DiscountFixed DiscountKind = "fixed"
+)
+
+// Discount is a code that takes money off an invoice.
+type Discount struct {
+	Code      string
+	Kind      DiscountKind
+	Value     int64
+	ExpiresAt time.Time // zero means the code never expires
+}
+
+// Redemptions records which customers used which codes.
+type Redemptions struct {
+	mu   sync.RWMutex // guards used
+	used map[string]struct{}
+}
+
+// NewRedemptions returns an empty redemption record.
+func NewRedemptions() *Redemptions {
+	return &Redemptions{used: make(map[string]struct{})}
+}
+
+// Used reports whether the customer already used the code.
+func (r *Redemptions) Used(customer, code string) bool {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	_, ok := r.used[customer+"\x00"+code]
+	return ok
+}
+
+// claim marks the code used and reports false if it already was.
+func (r *Redemptions) claim(customer, code string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	k := customer + "\x00" + code
+	if _, ok := r.used[k]; ok {
+		return false
+	}
+	r.used[k] = struct{}{}
+	return true
+}
+
+// ApplyDiscount returns inv with the discount applied. It applies at most one
+// code per invoice, never takes the total below zero, and records the use so
+// the customer cannot use the code again.
+func ApplyDiscount(inv Invoice, d Discount, r *Redemptions, clk clock.Clock) (Invoice, error) {
+	if inv.DiscountCode != "" {
+		return inv, fmt.Errorf("apply code %q to invoice %s: %w", d.Code, inv.ID, ErrDiscountApplied)
+	}
+	if d.Code == "" || d.Value < 0 || (d.Kind != DiscountPercent && d.Kind != DiscountFixed) ||
+		(d.Kind == DiscountPercent && d.Value > 10000) {
+		return inv, fmt.Errorf("apply code %q to invoice %s: %w", d.Code, inv.ID, ErrDiscountInvalid)
+	}
+	if !d.ExpiresAt.IsZero() && !clk.Now().Before(d.ExpiresAt) {
+		return inv, fmt.Errorf("apply code %q to invoice %s: %w", d.Code, inv.ID, ErrDiscountExpired)
+	}
+
+	var amount int64
+	if d.Kind == DiscountPercent {
+		amount = roundBasisPoints(inv.TotalCents, d.Value)
+	} else {
+		amount = d.Value
+	}
+	amount = min(max(amount, 0), max(inv.TotalCents, 0))
+
+	if !r.claim(inv.Customer, d.Code) {
+		return inv, fmt.Errorf("apply code %q for customer %s: %w", d.Code, inv.Customer, ErrDiscountUsed)
+	}
+	inv.DiscountCode = d.Code
+	inv.DiscountCents = amount
+	inv.GrandTotalCents = inv.TotalCents - amount + inv.TaxCents
+	return inv, nil
+}
+
+// roundBasisPoints returns cents * bps / 10000, rounded half away from zero.
+func roundBasisPoints(cents, bps int64) int64 {
+	n := cents * bps
+	if n < 0 {
+		return -((-n + 5000) / 10000)
+	}
+	return (n + 5000) / 10000
+}
diff --git a/internal/billing/discount_test.go b/internal/billing/discount_test.go
new file mode 100644
index 0000000..8c96f65
--- /dev/null
+++ b/internal/billing/discount_test.go
@@ -0,0 +1,92 @@
+package billing
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+func TestApplyDiscount(t *testing.T) {
+	now := time.Date(2026, 1, 1, 12, 0, 0, 0, time.UTC)
+	clk := clock.Fixed{T: now}
+
+	tests := []struct {
+		name     string
+		total    int64
+		d        Discount
+		preUsed  bool
+		preCode  string
+		wantDisc int64
+		wantErr  error
+	}{
+		{name: "percent", total: 1000, d: Discount{Code: "P10", Kind: DiscountPercent, Value: 1000}, wantDisc: 100},
+		{name: "percent rounds half up", total: 105, d: Discount{Code: "P10", Kind: DiscountPercent, Value: 1000}, wantDisc: 11},
+		{name: "percent rounds down below half", total: 104, d: Discount{Code: "P10", Kind: DiscountPercent, Value: 1000}, wantDisc: 10},
+		{name: "fixed", total: 1000, d: Discount{Code: "F5", Kind: DiscountFixed, Value: 500}, wantDisc: 500},
+		{name: "fixed floors at zero", total: 300, d: Discount{Code: "F5", Kind: DiscountFixed, Value: 500}, wantDisc: 300},
+		{name: "percent over 100 invalid", total: 300, d: Discount{Code: "X", Kind: DiscountPercent, Value: 10001}, wantErr: ErrDiscountInvalid},
+		{name: "negative invalid", total: 300, d: Discount{Code: "X", Kind: DiscountFixed, Value: -1}, wantErr: ErrDiscountInvalid},
+		{name: "unknown kind invalid", total: 300, d: Discount{Code: "X", Kind: "odd", Value: 1}, wantErr: ErrDiscountInvalid},
+		{name: "empty total", total: 0, d: Discount{Code: "F5", Kind: DiscountFixed, Value: 500}, wantDisc: 0},
+		{name: "not yet expired", total: 1000, d: Discount{Code: "E", Kind: DiscountFixed, Value: 100, ExpiresAt: now.Add(time.Second)}, wantDisc: 100},
+		{name: "expired at the instant", total: 1000, d: Discount{Code: "E", Kind: DiscountFixed, Value: 100, ExpiresAt: now}, wantErr: ErrDiscountExpired},
+		{name: "expired", total: 1000, d: Discount{Code: "E", Kind: DiscountFixed, Value: 100, ExpiresAt: now.Add(-time.Hour)}, wantErr: ErrDiscountExpired},
+		{name: "already used", total: 1000, d: Discount{Code: "F5", Kind: DiscountFixed, Value: 500}, preUsed: true, wantErr: ErrDiscountUsed},
+		{name: "second code", total: 1000, d: Discount{Code: "F5", Kind: DiscountFixed, Value: 500}, preCode: "OTHER", wantErr: ErrDiscountApplied},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			r := NewRedemptions()
+			if tc.preUsed {
+				r.claim("acme", tc.d.Code)
+			}
+			inv := Invoice{ID: "i1", Customer: "acme", TotalCents: tc.total, GrandTotalCents: tc.total, DiscountCode: tc.preCode}
+			got, err := ApplyDiscount(inv, tc.d, r, clk)
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("ApplyDiscount(%+v) error = %v, want %v", tc.d, err, tc.wantErr)
+			}
+			if tc.wantErr != nil {
+				if got.DiscountCents != inv.DiscountCents {
+					t.Errorf("ApplyDiscount(%+v) changed discount to %d on error", tc.d, got.DiscountCents)
+				}
+				return
+			}
+			if got.DiscountCents != tc.wantDisc {
+				t.Errorf("ApplyDiscount(%+v) discount = %d, want %d", tc.d, got.DiscountCents, tc.wantDisc)
+			}
+			if want := tc.total - tc.wantDisc; got.GrandTotalCents != want {
+				t.Errorf("ApplyDiscount(%+v) grand total = %d, want %d", tc.d, got.GrandTotalCents, want)
+			}
+			if !r.Used("acme", tc.d.Code) {
+				t.Errorf("ApplyDiscount(%+v) did not record the use", tc.d)
+			}
+		})
+	}
+}
+
+func TestApplyDiscountReuse(t *testing.T) {
+	clk := clock.Fixed{T: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)}
+	d := Discount{Code: "F1", Kind: DiscountFixed, Value: 100}
+	r := NewRedemptions()
+
+	tests := []struct {
+		name     string
+		customer string
+		wantErr  error
+	}{
+		{name: "first use", customer: "acme"},
+		{name: "same customer again", customer: "acme", wantErr: ErrDiscountUsed},
+		{name: "other customer", customer: "globex"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			inv := Invoice{ID: "i", Customer: tc.customer, TotalCents: 500, GrandTotalCents: 500}
+			_, err := ApplyDiscount(inv, d, r, clk)
+			if !errors.Is(err, tc.wantErr) {
+				t.Errorf("ApplyDiscount(customer %q) error = %v, want %v", tc.customer, err, tc.wantErr)
+			}
+		})
+	}
+}
diff --git a/internal/billing/errors.go b/internal/billing/errors.go
new file mode 100644
index 0000000..3dc0fb6
--- /dev/null
+++ b/internal/billing/errors.go
@@ -0,0 +1,18 @@
+package billing
+
+import "errors"
+
+var (
+	// ErrDiscountExpired means the discount code is past its expiry time.
+	ErrDiscountExpired = errors.New("billing: discount code expired")
+	// ErrDiscountUsed means the customer already used the discount code.
+	ErrDiscountUsed = errors.New("billing: discount code already used by customer")
+	// ErrDiscountApplied means the invoice already has a discount code.
+	ErrDiscountApplied = errors.New("billing: invoice already has a discount code")
+	// ErrDiscountInvalid means the discount code has a bad kind or value.
+	ErrDiscountInvalid = errors.New("billing: invalid discount code")
+	// ErrUnknownRegion means the tax table has no rate for the region.
+	ErrUnknownRegion = errors.New("billing: unknown tax region")
+	// ErrInvalidTaxRate means a tax rate in the table is negative.
+	ErrInvalidTaxRate = errors.New("billing: invalid tax rate")
+)
