new file mode 100644
index 0000000..d14bcc5
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,39 @@
+package billing
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"strconv"
+	"time"
+)
+
+// WriteCSV writes the invoices to w as CSV with a header row. Amounts are in
+// cents and issued_at is RFC 3339.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	header := []string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}
+	if err := cw.Write(header); err != nil {
+		return fmt.Errorf("write csv header: %w", err)
+	}
+	for _, inv := range invoices {
+		rec := []string{
+			inv.ID,
+			inv.Customer,
+			inv.Region,
+			inv.IssuedAt.Format(time.RFC3339),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := cw.Write(rec); err != nil {
+			return fmt.Errorf("write csv row for invoice %s: %w", inv.ID, err)
+		}
+	}
+	cw.Flush()
+	if err := cw.Error(); err != nil {
+		return fmt.Errorf("flush csv: %w", err)
+	}
+	return nil
+}
diff --git a/internal/billing/export_test.go b/internal/billing/export_test.go
new file mode 100644
index 0000000..5006fd0
--- /dev/null
+++ b/internal/billing/export_test.go
@@ -0,0 +1,52 @@
+package billing
+
+import (
+	"bytes"
+	"errors"
+	"testing"
+	"time"
+)
+
+type failWriter struct{}
+
+func (failWriter) Write([]byte) (int, error) { return 0, errors.New("disk full") }
+
+func TestWriteCSV(t *testing.T) {
+	at := time.Date(2026, 3, 4, 5, 6, 7, 0, time.UTC)
+	const header = "id,customer,region,issued_at,total,discount,tax,grand_total\n"
+
+	tests := []struct {
+		name string
+		in   []Invoice
+		want string
+	}{
+		{name: "empty", in: nil, want: header},
+		{
+			name: "one",
+			in:   []Invoice{{ID: "i1", Customer: "acme", Region: "FR", IssuedAt: at, TotalCents: 1000, DiscountCents: 100, TaxCents: 180, GrandTotalCents: 1080}},
+			want: header + "i1,acme,FR,2026-03-04T05:06:07Z,1000,100,180,1080\n",
+		},
+		{
+			name: "quoting",
+			in:   []Invoice{{ID: "i2", Customer: `Acme, "Inc"`, IssuedAt: at}},
+			want: header + "i2,\"Acme, \"\"Inc\"\"\",,2026-03-04T05:06:07Z,0,0,0,0\n",
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var buf bytes.Buffer
+			if err := WriteCSV(&buf, tc.in); err != nil {
+				t.Fatalf("WriteCSV() error = %v", err)
+			}
+			if got := buf.String(); got != tc.want {
+				t.Errorf("WriteCSV() = %q, want %q", got, tc.want)
+			}
+		})
+	}
+
+	t.Run("writer error", func(t *testing.T) {
+		if err := WriteCSV(failWriter{}, []Invoice{{ID: "i1"}}); err == nil {
+			t.Error("WriteCSV(failing writer) = nil, want error")
+		}
+	})
+}
