index 0000000..f62f626
--- /dev/null
+++ b/internal/billing/export.go
@@ -0,0 +1,33 @@
+package billing
+
+import (
+	"encoding/csv"
+	"io"
+	"strconv"
+	"time"
+)
+
+var csvHeader = []string{"id", "customer", "region", "issued_at", "total", "discount", "tax", "grand_total"}
+
+// WriteCSV writes invoices as CSV with a header row. Amounts are in cents.
+func WriteCSV(w io.Writer, invoices []Invoice) error {
+	cw := csv.NewWriter(w)
+	if err := cw.Write(csvHeader); err != nil {
+		return err
+	}
+	for _, inv := range invoices {
+		rec := []string{
+			inv.ID, inv.Customer, inv.Region,
+			inv.IssuedAt.Format(time.RFC3339),
+			strconv.FormatInt(inv.TotalCents, 10),
+			strconv.FormatInt(inv.DiscountCents, 10),
+			strconv.FormatInt(inv.TaxCents, 10),
+			strconv.FormatInt(inv.GrandTotalCents, 10),
+		}
+		if err := cw.Write(rec); err != nil {
+			return err
+		}
+	}
+	cw.Flush()
+	return cw.Error()
+}
diff --git a/internal/billing/pricing.go b/internal/billing/pricing.go
new file mode 100644
index 0000000..d89ff39
--- /dev/null
+++ b/internal/billing/pricing.go
@@ -0,0 +1,146 @@
+package billing
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+)
+
+var (
+	ErrCodeExpired   = errors.New("billing: discount code expired")
+	ErrCodeUsed      = errors.New("billing: discount code already used by customer")
+	ErrInvalidCode   = errors.New("billing: invalid discount code")
+	ErrUnknownRegion = errors.New("billing: no tax rate for region")
+)
+
+// DiscountCode is either a percentage or a fixed amount off.
+// Exactly one of PercentBP (basis points, 1000 = 10%) or AmountCents must be set.
+type DiscountCode struct {
+	Code        string
+	PercentBP   int64
+	AmountCents int64
+	// ExpiresAt is the zero time for codes that never expire.
+	ExpiresAt time.Time
+}
+
+func (d DiscountCode) validate() error {
+	pct, amt := d.PercentBP, d.AmountCents
+	if d.Code == "" || pct < 0 || amt < 0 || (pct > 0) == (amt > 0) || pct > 10000 {
+		return fmt.Errorf("%w: %q", ErrInvalidCode, d.Code)
+	}
+	return nil
+}
+
+// amount returns the discount in cents for a total, never exceeding the total.
+// Percentages round half up.
+func (d DiscountCode) amount(total int64) int64 {
+	var off int64
+	if d.PercentBP > 0 {
+		off = (total*d.PercentBP + 5000) / 10000
+	} else {
+		off = d.AmountCents
+	}
+	if off > total {
+		off = total
+	}
+	if off < 0 {
+		off = 0
+	}
+	return off
+}
+
+// Redemptions records which customers have used which codes.
+// It is safe for concurrent use.
+type Redemptions struct {
+	mu   sync.Mutex
+	used map[string]map[string]bool // code -> customer -> used
+}
+
+// NewRedemptions returns an empty redemption record.
+func NewRedemptions() *Redemptions {
+	return &Redemptions{used: map[string]map[string]bool{}}
+}
+
+// Used reports whether the customer has already used the code.
+func (r *Redemptions) Used(code, customer string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.used[code][customer]
+}
+
+// claim marks the code as used, returning false if it already was.
+func (r *Redemptions) claim(code, customer string) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.used[code] == nil {
+		r.used[code] = map[string]bool{}
+	}
+	if r.used[code][customer] {
+		return false
+	}
+	r.used[code][customer] = true
+	return true
+}
+
+// TaxTable maps a region (e.g. "FR", "US-CA") to a rate in basis points (2000 = 20%).
+type TaxTable map[string]int64
+
+// Options configures ComputeWith.
+type Options struct {
+	Region string
+	// Taxes supplies rates by region. A non-empty Region missing from the
+	// table is an error; a nil table means no tax.
+	Taxes TaxTable
+	// Discount is an optional code to apply; it needs Redemptions and is
+	// checked against Now (the zero value means time.Now()).
+	Discount    *DiscountCode
+	Redemptions *Redemptions
+	Now         time.Time
+}
+
+// ComputeWith builds an invoice like Compute, applying at most one discount
+// code and regional tax (computed on the total after discount, rounded half up).
+// The code is only recorded as used by the customer when it is applied
+// and the invoice is successfully built.
+func ComputeWith(id, customer string, lines []Line, opt Options) (Invoice, error) {
+	inv := Compute(id, customer, lines)
+	now := opt.Now
+	if now.IsZero() {
+		now = inv.IssuedAt
+	} else {
+		inv.IssuedAt = now
+	}
+	inv.Region = opt.Region
+
+	var rate int64
+	if opt.Taxes != nil {
+		r, ok := opt.Taxes[opt.Region]
+		if !ok {
+			return Invoice{}, fmt.Errorf("%w: %q", ErrUnknownRegion, opt.Region)
+		}
+		rate = r
+	}
+
+	if d := opt.Discount; d != nil {
+		if err := d.validate(); err != nil {
+			return Invoice{}, err
+		}
+		if opt.Redemptions == nil {
+			return Invoice{}, fmt.Errorf("%w: no redemption record", ErrInvalidCode)
+		}
+		if !d.ExpiresAt.IsZero() && !now.Before(d.ExpiresAt) {
+			return Invoice{}, fmt.Errorf("%w: %q", ErrCodeExpired, d.Code)
+		}
+		if !opt.Redemptions.claim(d.Code, customer) {
+			return Invoice{}, fmt.Errorf("%w: %q", ErrCodeUsed, d.Code)
+		}
+		inv.DiscountCode = d.Code
+		inv.DiscountCents = d.amount(inv.TotalCents)
+	}
+
+	net := inv.TotalCents - inv.DiscountCents
+	inv.TaxCents = (net*rate + 5000) / 10000
+	inv.GrandTotalCents = net + inv.TaxCents
+	return inv, nil
+}
diff --git a/internal/billing/pricing_test.go b/internal/billing/pricing_test.go
new file mode 100644
index 0000000..dcaf87c
--- /dev/null
+++ b/internal/billing/pricing_test.go
@@ -0,0 +1,133 @@
+package billing
+
+import (
+	"bytes"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+)
+
+var testLines = []Line{{SKU: "a", Quantity: 1, UnitCents: 1000}}
+
+var t0 = time.Date(2026, 1, 1, 12, 0, 0, 0, time.UTC)
+
+func TestDiscountPercentRounding(t *testing.T) {
+	cases := []struct {
+		bp, total, want int64
+	}{
+		{1000, 1000, 100},
+		{1000, 1005, 101}, // 100.5 rounds up
+		{1000, 1004, 100},
+		{3333, 100, 33},
+		{10000, 777, 777},
+	}
+	for _, c := range cases {
+		got := DiscountCode{Code: "X", PercentBP: c.bp}.amount(c.total)
+		if got != c.want {
+			t.Errorf("%d bp of %d = %d, want %d", c.bp, c.total, got, c.want)
+		}
+	}
+}
+
+func TestDiscountFloorsAtZero(t *testing.T) {
+	inv, err := ComputeWith("i", "c", testLines, Options{
+		Discount: &DiscountCode{Code: "BIG", AmountCents: 5000}, Redemptions: NewRedemptions(), Now: t0,
+		Region: "FR", Taxes: TaxTable{"FR": 2000},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if inv.DiscountCents != 1000 || inv.GrandTotalCents != 0 || inv.TaxCents != 0 {
+		t.Errorf("got %+v", inv)
+	}
+}
+
+func TestDiscountExpiry(t *testing.T) {
+	d := &DiscountCode{Code: "E", AmountCents: 100, ExpiresAt: t0}
+	r := NewRedemptions()
+	_, err := ComputeWith("i", "c", testLines, Options{Discount: d, Redemptions: r, Now: t0})
+	if !errors.Is(err, ErrCodeExpired) {
+		t.Errorf("at expiry: err = %v", err)
+	}
+	if r.Used("E", "c") {
+		t.Error("expired code must not be recorded as used")
+	}
+	inv, err := ComputeWith("i", "c", testLines, Options{Discount: d, Redemptions: r, Now: t0.Add(-time.Second)})
+	if err != nil || inv.GrandTotalCents != 900 {
+		t.Errorf("before expiry: %+v, %v", inv, err)
+	}
+}
+
+func TestDiscountReuse(t *testing.T) {
+	d := &DiscountCode{Code: "ONCE", PercentBP: 1000}
+	r := NewRedemptions()
+	opt := func() Options { return Options{Discount: d, Redemptions: r, Now: t0} }
+	if _, err := ComputeWith("1", "alice", testLines, opt()); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ComputeWith("2", "alice", testLines, opt()); !errors.Is(err, ErrCodeUsed) {
+		t.Errorf("reuse: err = %v", err)
+	}
+	if _, err := ComputeWith("3", "bob", testLines, opt()); err != nil {
+		t.Errorf("other customer: %v", err)
+	}
+}
+
+func TestInvalidCodeAndRegion(t *testing.T) {
+	r := NewRedemptions()
+	both := &DiscountCode{Code: "B", PercentBP: 10, AmountCents: 10}
+	if _, err := ComputeWith("i", "c", testLines, Options{Discount: both, Redemptions: r}); !errors.Is(err, ErrInvalidCode) {
+		t.Errorf("err = %v", err)
+	}
+	if _, err := ComputeWith("i", "c", testLines, Options{Region: "XX", Taxes: TaxTable{"FR": 2000}}); !errors.Is(err, ErrUnknownRegion) {
+		t.Errorf("err = %v", err)
+	}
+	// An unknown region must not consume a code.
+	d := &DiscountCode{Code: "D", AmountCents: 1}
+	_, _ = ComputeWith("i", "c", testLines, Options{Region: "XX", Taxes: TaxTable{}, Discount: d, Redemptions: r})
+	if r.Used("D", "c") {
+		t.Error("code consumed despite error")
+	}
+}
+
+func TestTaxOnDiscountedTotal(t *testing.T) {
+	inv, err := ComputeWith("i", "c", testLines, Options{
+		Region: "US-CA", Taxes: TaxTable{"US-CA": 725},
+		Discount: &DiscountCode{Code: "T", PercentBP: 2500}, Redemptions: NewRedemptions(), Now: t0,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	// net 750; tax 750*7.25% = 54.375 -> 54
+	if inv.TotalCents != 1000 || inv.DiscountCents != 250 || inv.TaxCents != 54 || inv.GrandTotalCents != 804 {
+		t.Errorf("got %+v", inv)
+	}
+}
+
+func TestComputeUnchanged(t *testing.T) {
+	inv := Compute("i", "c", testLines)
+	if inv.GrandTotalCents != 1000 || inv.TaxCents != 0 {
+		t.Errorf("got %+v", inv)
+	}
+}
+
+func TestWriteCSV(t *testing.T) {
+	invs := []Invoice{{
+		ID: "i1", Customer: `Acme, "Inc"`, Region: "DE", IssuedAt: t0,
+		TotalCents: 1000, DiscountCents: 100, TaxCents: 171, GrandTotalCents: 1071,
+	}}
+	var b bytes.Buffer
+	if err := WriteCSV(&b, invs); err != nil {
+		t.Fatal(err)
+	}
+	want := "id,customer,region,issued_at,total,discount,tax,grand_total\n" +
+		"i1,\"Acme, \"\"Inc\"\"\",DE,2026-01-01T12:00:00Z,1000,100,171,1071\n"
+	if b.String() != want {
+		t.Errorf("got\n%s\nwant\n%s", b.String(), want)
+	}
+	b.Reset()
+	if err := WriteCSV(&b, nil); err != nil || strings.Count(b.String(), "\n") != 1 {
+		t.Errorf("empty: %q, %v", b.String(), err)
+	}
+}
