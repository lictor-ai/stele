+package todo
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"example.com/app/internal/clock"
+)
+
+// stepClock moves forward one second on every call.
+type stepClock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func (c *stepClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.t = c.t.Add(time.Second)
+	return c.t
+}
+
+func newTestStore() *Store {
+	return NewStore(&stepClock{t: time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)})
+}
+
+func ptr[T any](v T) *T { return &v }
+
+func titles(ts []Todo) []string {
+	out := make([]string, len(ts))
+	for i, t := range ts {
+		out[i] = t.Title
+	}
+	return out
+}
+
+func TestCreateGet(t *testing.T) {
+	ctx := context.Background()
+	at := time.Date(2026, 3, 4, 5, 6, 7, 0, time.UTC)
+	s := NewStore(clock.Fixed{T: at})
+	created, err := s.Create(ctx, "write tests")
+	if err != nil {
+		t.Fatalf("Create() error = %v", err)
+	}
+	if created.ID == "" || created.Title != "write tests" || created.Done {
+		t.Errorf("Create() = %+v, want id set, title %q, not done", created, "write tests")
+	}
+	if !created.CreatedAt.Equal(at) || !created.UpdatedAt.Equal(at) {
+		t.Errorf("Create() times = %v, %v, want %v", created.CreatedAt, created.UpdatedAt, at)
+	}
+	got, err := s.Get(ctx, created.ID)
+	if err != nil || got != created {
+		t.Errorf("Get(%q) = %+v, %v, want %+v", created.ID, got, err, created)
+	}
+	if _, err := s.Get(ctx, "missing"); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get(missing) error = %v, want ErrNotFound", err)
+	}
+}
+
+func TestUpdate(t *testing.T) {
+	tests := []struct {
+		name      string
+		update    Update
+		wantTitle string
+		wantDone  bool
+	}{
+		{"title only", Update{Title: ptr("new")}, "new", false},
+		{"done only", Update{Done: ptr(true)}, "old", true},
+		{"both", Update{Title: ptr("new"), Done: ptr(true)}, "new", true},
+		{"neither", Update{}, "old", false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			s := newTestStore()
+			orig, _ := s.Create(ctx, "old")
+			got, err := s.Update(ctx, orig.ID, tc.update)
+			if err != nil {
+				t.Fatalf("Update() error = %v", err)
+			}
+			if got.Title != tc.wantTitle || got.Done != tc.wantDone {
+				t.Errorf("Update() = %q/%v, want %q/%v", got.Title, got.Done, tc.wantTitle, tc.wantDone)
+			}
+			if !got.CreatedAt.Equal(orig.CreatedAt) || !got.UpdatedAt.After(orig.UpdatedAt) {
+				t.Errorf("Update() times = %v, %v, want created unchanged and updated later than %v",
+					got.CreatedAt, got.UpdatedAt, orig.UpdatedAt)
+			}
+		})
+	}
+	t.Run("missing", func(t *testing.T) {
+		if _, err := newTestStore().Update(context.Background(), "nope", Update{Done: ptr(true)}); !errors.Is(err, ErrNotFound) {
+			t.Errorf("Update(nope) error = %v, want ErrNotFound", err)
+		}
+	})
+}
+
+func TestDelete(t *testing.T) {
+	ctx := context.Background()
+	s := newTestStore()
+	a, _ := s.Create(ctx, "a")
+	if err := s.Delete(ctx, a.ID); err != nil {
+		t.Fatalf("Delete() error = %v", err)
+	}
+	if _, err := s.Get(ctx, a.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("Get after Delete error = %v, want ErrNotFound", err)
+	}
+	if err := s.Delete(ctx, a.ID); !errors.Is(err, ErrNotFound) {
+		t.Errorf("second Delete error = %v, want ErrNotFound", err)
+	}
+	list, _ := s.List(ctx, Filter{})
+	if len(list) != 0 {
+		t.Errorf("List after Delete = %v, want empty", titles(list))
+	}
+}
+
+func TestList(t *testing.T) {
+	ctx := context.Background()
+	s := newTestStore()
+	for i := 1; i <= 5; i++ {
+		td, _ := s.Create(ctx, fmt.Sprintf("t%d", i))
+		if i%2 == 0 {
+			s.Update(ctx, td.ID, Update{Done: ptr(true)})
+		}
+	}
+	tests := []struct {
+		name string
+		f    Filter
+		want []string
+	}{
+		{"all newest first", Filter{}, []string{"t5", "t4", "t3", "t2", "t1"}},
+		{"done", Filter{Done: ptr(true)}, []string{"t4", "t2"}},
+		{"not done", Filter{Done: ptr(false)}, []string{"t5", "t3", "t1"}},
+		{"limit", Filter{Limit: 2}, []string{"t5", "t4"}},
+		{"offset", Filter{Offset: 3}, []string{"t2", "t1"}},
+		{"limit and offset", Filter{Limit: 2, Offset: 1}, []string{"t4", "t3"}},
+		{"filter with paging", Filter{Done: ptr(false), Limit: 1, Offset: 1}, []string{"t3"}},
+		{"offset past end", Filter{Offset: 10}, []string{}},
+		{"negative offset", Filter{Offset: -1, Limit: 1}, []string{"t5"}},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := s.List(ctx, tc.f)
+			if err != nil {
+				t.Fatalf("List(%+v) error = %v", tc.f, err)
+			}
+			if got == nil {
+				t.Errorf("List(%+v) = nil, want non-nil slice", tc.f)
+			}
+			g := titles(got)
+			if len(g) != len(tc.want) {
+				t.Fatalf("List(%+v) = %v, want %v", tc.f, g, tc.want)
+			}
+			for i := range g {
+				if g[i] != tc.want[i] {
+					t.Fatalf("List(%+v) = %v, want %v", tc.f, g, tc.want)
+				}
+			}
+		})
+	}
+}
+
+func TestCancelledContext(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	s := newTestStore()
+	if _, err := s.Create(ctx, "x"); !errors.Is(err, context.Canceled) {
+		t.Errorf("Create(cancelled) error = %v, want context.Canceled", err)
+	}
+	if _, err := s.List(ctx, Filter{}); !errors.Is(err, context.Canceled) {
+		t.Errorf("List(cancelled) error = %v, want context.Canceled", err)
+	}
+}
+
+func TestConcurrentUse(t *testing.T) {
+	ctx := context.Background()
+	s := newTestStore()
+	const workers, perWorker = 8, 50
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < perWorker; i++ {
+				td, err := s.Create(ctx, "c")
+				if err != nil {
+					t.Errorf("Create() error = %v", err)
+					return
+				}
+				s.Update(ctx, td.ID, Update{Done: ptr(true)})
+				s.Get(ctx, td.ID)
+				s.List(ctx, Filter{Limit: 10})
+				if i%2 == 0 {
+					if err := s.Delete(ctx, td.ID); err != nil {
+						t.Errorf("Delete(%q) error = %v", td.ID, err)
+					}
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	got, _ := s.List(ctx, Filter{})
+	if want := workers * perWorker / 2; len(got) != want {
+		t.Errorf("List() returned %d todos, want %d", len(got), want)
+	}
+}
