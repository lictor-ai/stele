diff --git a/internal/todo/store.go b/internal/todo/store.go
new file mode 100644
index 0000000..3f0051f
--- /dev/null
+++ b/internal/todo/store.go
@@ -0,0 +1,149 @@
+// Package todo holds the Todo type and an in-memory store for it.
+package todo
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"time"
+
+	"example.com/app/internal/clock"
+	"example.com/app/internal/id"
+)
+
+// Todo is a single task.
+type Todo struct {
+	ID        string    `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+// Update describes a partial change. A nil field is left as it is.
+type Update struct {
+	Title *string
+	Done  *bool
+}
+
+// Filter selects and pages todos for List. A nil Done matches all todos.
+// A Limit of zero or less means no limit.
+type Filter struct {
+	Done   *bool
+	Limit  int
+	Offset int
+}
+
+// Store keeps todos in memory and is safe for concurrent use.
+type Store struct {
+	clock clock.Clock
+
+	// mu guards items and order.
+	mu    sync.RWMutex
+	items map[string]Todo
+	order []string // ids, oldest first
+}
+
+// NewStore returns an empty Store that stamps todos with c.
+func NewStore(c clock.Clock) *Store {
+	return &Store{clock: c, items: make(map[string]Todo)}
+}
+
+// Create adds a todo with the given title. The title is stored as given.
+func (s *Store) Create(ctx context.Context, title string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("create todo: %w", err)
+	}
+	now := s.clock.Now()
+	t := Todo{ID: id.New(), Title: title, CreatedAt: now, UpdatedAt: now}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.items[t.ID] = t
+	s.order = append(s.order, t.ID)
+	return t, nil
+}
+
+// Get returns the todo with the given id, or ErrNotFound.
+func (s *Store) Get(ctx context.Context, todoID string) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("get todo %s: %w", todoID, err)
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, fmt.Errorf("get todo %s: %w", todoID, ErrNotFound)
+	}
+	return t, nil
+}
+
+// Update applies u to the todo with the given id and returns the result,
+// or ErrNotFound.
+func (s *Store) Update(ctx context.Context, todoID string, u Update) (Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return Todo{}, fmt.Errorf("update todo %s: %w", todoID, err)
+	}
+	now := s.clock.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	t, ok := s.items[todoID]
+	if !ok {
+		return Todo{}, fmt.Errorf("update todo %s: %w", todoID, ErrNotFound)
+	}
+	if u.Title != nil {
+		t.Title = *u.Title
+	}
+	if u.Done != nil {
+		t.Done = *u.Done
+	}
+	t.UpdatedAt = now
+	s.items[todoID] = t
+	return t, nil
+}
+
+// Delete removes the todo with the given id, or returns ErrNotFound.
+func (s *Store) Delete(ctx context.Context, todoID string) error {
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("delete todo %s: %w", todoID, err)
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.items[todoID]; !ok {
+		return fmt.Errorf("delete todo %s: %w", todoID, ErrNotFound)
+	}
+	delete(s.items, todoID)
+	for i, v := range s.order {
+		if v == todoID {
+			s.order = append(s.order[:i], s.order[i+1:]...)
+			break
+		}
+	}
+	return nil
+}
+
+// List returns todos newest first, filtered and paged by f. It never returns
+// a nil slice.
+func (s *Store) List(ctx context.Context, f Filter) ([]Todo, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("list todos: %w", err)
+	}
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := []Todo{}
+	skip := max(f.Offset, 0)
+	for i := len(s.order) - 1; i >= 0; i-- {
+		t := s.items[s.order[i]]
+		if f.Done != nil && t.Done != *f.Done {
+			continue
+		}
+		if skip > 0 {
+			skip--
+			continue
+		}
+		if f.Limit > 0 && len(out) >= f.Limit {
+			break
+		}
+		out = append(out, t)
+	}
+	return out, nil
+}
